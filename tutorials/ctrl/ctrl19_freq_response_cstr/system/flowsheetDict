/*---------------------------------------------------------------------------*\
  ctrl19_freq_response_cstr
  =========================

  FREQUENCY RESPONSE of the same LTI mixing tank (tau = N/F = 240 s):
  the tracer feed oscillates sinusoidally at omega*tau = 1 -- again as a
  SUBSTITUTION against the carrier, so total flow never moves and the
  vessel is rigorously first order in the tracer.  The engine fits
  a + b sin + c cos over 4 cycles after discarding 5 (transient e^-t/tau
  through 5 periods = e^-31 -- gone), and reports amplitude, phase and
  the unexplained-variance residual.

  THE ANCHORS ARE THE FIRST-ORDER CLOSED FORMS (any process-control
  text; at omega*tau = 1 exactly):
      AR    = 1/sqrt(1 + (omega tau)^2) = 1/sqrt(2)   -> out amplitude
              = 2.0e-6 * 0.7071068 = 1.4142136e-6 kmol/s
      phase = -atan(omega tau) = -45 deg = -0.7853982 rad
  (the drive is sin(w(t-tStart)) with tStart 0, so the fitted phase IS
  the lag).  The measured amplitude lands within 1e-6 relative of the
  closed form and the fit residual is ~7e-15 (the vessel really is LTI);
  the phase carries a bias of EXACTLY omega*dt/2 = 0.00208 rad = 0.12 deg
  -- the half-sample lag of reading accepted states on a 1 s grid, the
  measurement system's own phase contribution, worth teaching in itself.
  The anchor band covers it and this header names it.
*/

units
(
    {
        name        reactor;
        type        dynamicCSTR;



        operation
        {
            UA           50.0;
            T_jacket     330.0 K;
        }

    }
);

controllers
(
    //  Tracer SUBSTITUTION at constant total flow: compB up by exactly
    //  what compA goes down, so F never moves and tau stays 240 s.
    //  Tracer SUBSTITUTION, sinusoidal: compB swings +-2e-6 kmol/s about a
    //  4e-6 mean, compA mirrors it about 4.6e-5 -- total F pinned at 5e-5.
    {
        name         TracerSine;
        type         Signal;
        actuator     { unit reactor;  inletField componentMolarFlow.compB; }
        signal
        {
            type       sinusoidal;
            mean       4.0e-6;        // kmol/s
            amplitude  2.0e-6;        // kmol/s
            frequency  6.6314559622e-04;   // Hz  (omega*tau = 1)
        }
    }

    {
        name         CarrierMirror;
        type         Signal;
        actuator     { unit reactor;  inletField componentMolarFlow.compA; }
        signal
        {
            type       sinusoidal;
            mean       4.6e-5;        // kmol/s
            amplitude  -2.0e-6;       // the exact mirror
            frequency  6.6314559622e-04;   // Hz
        }
    }

);
