/*---------------------------------------------------------------------------*\
  ctrl19_freq_response_cstr / system/controlDict

  FREQUENCY RESPONSE of the LTI mixing tank at omega*tau = 1.  The
  `frequencyResponse {}` block below is the experiment: a sin/cos fit of
  the outlet tracer after the transient is discarded, against the exact
  first-order closed forms (AR = 1/sqrt(2), phase = -45 deg).

  This banner used to be ctrl09_stream_disturbance's, copied with the
  case and never rewritten (found 2026-09-03).  Narrative and anchors:
  system/flowsheetDict header.  Run log: log.choupoCtrl.
\*---------------------------------------------------------------------------*/

application   choupoCtrl;
description   "Frequency response of the LTI mixing tank at omega*tau = 1: engine-fitted amplitude and phase against the exact first-order closed forms (AR = 1/sqrt(2), phase = -45 deg).";

verbosity     3;

startTime       0;        // s
endTime         13873;    // s  (9.2 periods: 5 discarded + 4 fitted + margin)
deltaT          1.0;      // s
writeInterval   10;       // s

//  The frequency-response experiment: sin/cos fit of the outlet tracer.
frequencyResponse
{
    unit           reactor;
    tracer         compB;
    reference      TracerSine;   // the frequency is READ from the drive --
                                 // one datum, one home (2026-08-23)
    discardCycles  5;
    fitCycles      4;
}
