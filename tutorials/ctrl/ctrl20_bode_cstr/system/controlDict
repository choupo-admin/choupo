/*---------------------------------------------------------------------------*\
  ctrl20_bode_cstr / system/controlDict

  THE BODE TABLE of the LTI mixing tank: system/outerDict sweeps the
  drive frequency and the `frequencyResponse {}` block below measures
  amplitude and phase at each point -- the sweep CSV is the Bode table.

  This banner used to be ctrl09_stream_disturbance's, copied with the
  case and never rewritten (found 2026-09-03).  Narrative and anchors:
  system/flowsheetDict header.  Run log: log.choupoCtrl.
\*---------------------------------------------------------------------------*/

application   choupoCtrl;
description   "Bode table of the LTI mixing tank: outer frequency sweep (one datum, lockstep mirror) over the engine frequency-response fit; anchors are the exact first-order closed forms at each point.";

verbosity     3;

startTime       0;        // s
endTime         27747;    // s  (9.2 periods of the SLOWEST point, wt = 0.5)
deltaT          1.0;      // s
writeInterval   10;       // s

//  The frequency-response experiment: sin/cos fit of the outlet tracer.
frequencyResponse
{
    unit           reactor;
    tracer         compB;
    reference      TracerSine;   // the frequency is READ from the drive --
                                 // one datum, one home (2026-08-23)
    discardCycles  5;
    fitCycles      4;
}
