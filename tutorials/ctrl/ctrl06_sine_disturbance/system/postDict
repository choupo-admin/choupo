/*---------------------------------------------------------------------------*\
/*---------------------------------------------------------------------------*\
  ctrl06_sine_disturbance / postDict -- the case's TWO figures
  (DEV.md 4c C487 slice 2; grammar: docs/design/a-post-processing-dictionary.md).

    response     "Does the reactor stay at its set point while the feed
                 temperature swings sinusoidally?"  PV and set point on the
                 left axis; the jacket T (TC1's MV) and the feed T (the Signal
                 FeedDist's MV, 320 K +/- 15 K, period 600 s) on the right.
    attenuation  "How much of the 15 K swing of the feed reaches the reactor?"
                 From 600 s, one period after the start-up has filled the
                 overview's axis (320 to 350 K), on a TIGHT left axis, 349.5 to
                 350.5 K.  Range read from this run's `trajectory` table of
                 TC1, 600 s on: PV runs from 349.700 K (t = 990 s) to 350.298 K
                 (t = 2490 s) around the 350 K set point; the jacket from
                 348.110 K (765 s) to 351.418 K (2865 s); the feed signal from
                 305.001 to 334.999 K (the 5 s write grid).
\*---------------------------------------------------------------------------*/

views
(
    {
        name    response;
        type    series;
        title   "Does the reactor stay at its set point while the feed temperature swings?";
        note    "The PID TC1 holds the reactor at 350 K by moving the jacket temperature while the feed temperature follows a sinusoid, 320 K plus or minus 15 K with a period of 600 s. After the first period the reactor temperature stays within a few tenths of a kelvin of the set point; the jacket swings to absorb the feed.";
        xAxis   { label "time"; unit "s"; scale linear; }
        yAxis   { label "reactor temperature"; unit "K"; scale linear; }
        yAxis2  { label "jacket and feed temperature"; unit "K"; scale linear; }
        series
        (
            { name SP; label "set point"; unitOp TC1; table trajectory; x t; y SP; style lines; }
            { name PV; label "reactor T (controlled)"; unitOp TC1; table trajectory; x t; y PV; style lines; }
            { name MV; label "jacket T (manipulated)"; unitOp TC1; table trajectory; x t; y MV; style lines; axis right; }
            { name Tin; label "feed T (sinusoidal disturbance)"; unitOp FeedDist; table trajectory; x t; y MV; style lines; axis right; }
        );
    }
    {
        name    attenuation;
        type    series;
        title   "How much of the 15 K swing of the feed reaches the reactor?";
        note    "From 600 s, on a tight axis: the feed temperature swings from 305 K to 335 K (plus or minus 15 K) and the reactor temperature only between 349.70 K and 350.30 K, plus or minus 0.30 K around the set point, 2 % of the feed swing. The jacket temperature does the work: it swings between 348.1 K and 351.4 K, plus or minus 1.7 K (values on the 5 s write grid).";
        xAxis   { label "time"; unit "s"; scale linear; min 600; max 3000; }
        yAxis   { label "reactor temperature"; unit "K"; scale linear; min 349.5; max 350.5; }
        yAxis2  { label "feed temperature"; unit "K"; scale linear; }
        series
        (
            { name SP; label "set point"; unitOp TC1; table trajectory; x t; y SP; style lines; }
            { name PV; label "reactor T (controlled)"; unitOp TC1; table trajectory; x t; y PV; style lines; }
            { name Tin; label "feed T (sinusoidal disturbance)"; unitOp FeedDist; table trajectory; x t; y MV; style lines; axis right; }
        );
    }
);
