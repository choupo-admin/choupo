/*---------------------------------------------------------------------------*\
  ctrl18_rtd_pulse_cstr / system/controlDict

  RESIDENCE-TIME DISTRIBUTION by pulse tracer on a pure mixing tank
  (tau = N/F = 240 s).  The `rtd {}` block below is the experiment: the
  outlet tracer moments on the accepted-step grid, against Levenspiel's
  closed-form anchors.

  This banner used to be ctrl09_stream_disturbance's, copied with the
  case and never rewritten (found 2026-09-03).  Narrative and anchors:
  system/flowsheetDict header.  Run log: log.choupoCtrl.
\*---------------------------------------------------------------------------*/

application   choupoCtrl;
description   "RTD by pulse tracer on a pure mixing tank: tracer substitution at constant flow, tau = N/F = 240 s; engine-measured moments against Levenspiel closed-form anchors.";

verbosity     3;

startTime       0;        // s
endTime         2600;     // s  (~10.4 tau past the pulse)
deltaT          1.0;      // s
writeInterval   10;       // s

//  The RTD experiment: outlet tracer moments on the accepted-step grid.
rtd
{
    unit    reactor;
    tracer  compB;
}
