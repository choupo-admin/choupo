/*---------------------------------------------------------------------------*\
  constant/reactions -- the PROCESSES of Mazzoleni et al. 2015, Table 1, for the
  CEN.PK113-7D prototroph (Table 4, fourth column), written as case-carried rate
  laws (`kinetics { type expression; }`, DEV.md 4c C67).

  UNITS.  Every component is a mass-unit pseudo-component (MW = 1 g/mol), so a
  concentration c[i] in kmol/m3 is the paper's concentration in g/l, a rate in
  kmol/m3/h is g/l/h, and a stoichiometric coefficient nu is a mass ratio.  The
  paper's rate laws are totals in g/h; dividing each by V gives the per-volume
  extent rate written here (V cancels inside every ratio, because [P], [G], [E],
  [I] and B/V are all concentrations).

  MASS.  The paper's efficiencies (eta_G = 0.86 and the rest) are the fraction of
  a flux that arrives in the next pool; the rest leaves the model.  Here that
  rest is the named component `lostMass` (CO2, water and the like), so every
  reaction below has coefficients that sum to zero and the run's mass balance
  closes.

  THE PARAMETERS are repeated in each law that uses them (a law reads only its
  own `parameters`); one generator wrote them from one table, so they cannot
  differ.  T1/T2/T4 = the paper's Tables 1, 2, 4.

  TWO READINGS the paper's text forces, both declared:
    * rho (secretion) is printed with the unit h^-1, but Secretion = rho (eta_RP
      Resp_P + eta_RE Resp_E + eta_FP Ferm) is a flux (g/h) times rho, so the
      balance is dimensionally consistent only if rho is a pure FRACTION of the
      carbon-metabolite production.  It is read as dimensionless.
    * the death switch d (0 while [P] <= tau, 1 above) is a step, and the
      expression grammar has no comparison; it is written as a linear ramp of
      width dw = 1e-3 g/l centred on tau (0.17 % of tau) -- NOT in the paper.
  NOT IN THIS RUN: the lag phase of Table 2 (its parameters l1..l3 are listed for
  the CBS 8066 column only), so lag = 1.
\*---------------------------------------------------------------------------*/

uptake
{
    //  Uptake (T1) = v_G [G]/(k_G + [G]) B (1 - [P]/[P]max)(1 - n_E) lag, lag = 1; G -> eta_G P, eta_G = 0.86 (T4; Eq 1, 2)
    stoichiometry
    (
        { component glucoseMass        ; nu -1; }
        { component glycolysisProducts ; nu +0.86; }
        { component lostMass           ; nu +0.14; }
    );
    kinetics
    {
        type    expression;
        source  "Mazzoleni et al., Microb. Cell Fact. 14 (2015) 109, doi:10.1186/s12934-015-0295-4 -- Table 1 (rate law), Table 2 (auxiliaries), Table 4 (CEN.PK113-7D column); the paper's numbers, nothing fitted here";
        basis   reactorVolume;
        rateOf  extent;
        parameters
        {
            vG     5.8       1/h      ;  // T4 v_G
            kG     0.27      kmol/m3  ;  // T4 k_G
            Pmax   1         kmol/m3  ;  // T4 [P]_MAX
            sigE   1.4       -        ;  // T4 sigma_E
            Emax   100       kmol/m3  ;  // T4 [E]_MAX
            sigI   1         -        ;  // T4 sigma_I
            Imax   1         kmol/m3  ;  // T4 [I]_MAX
            a      0.0002    -        ;  // T4 a
            binv   0.0333333333333 kmol/m3  ;  // T4 b = 30 l/g, entered as its reciprocal 1/30 g/l
            cinv   100       kmol/m3  ;  // T4 c = 0.01 l/g, entered as its reciprocal 100 g/l
        }
        definitions
        {
            Bc   "c[glycolysisProducts] + c[carbonMetabolites]";                 // B = P + C_M            (T2)
            Pc   "c[glycolysisProducts] * cinv / (Bc + c[reserves])";           // [P] = P / ((B + R) c)  (T2)
            nE   "sigE * c[ethanolMass] / Emax";                                 // n_E                    (T2)
            nI   "sigI * c[inhibitor] / Imax";                                   // n_I                    (T2)
            ge   "1 / (1 + a * exp(Pc / binv))";                                    // glucose effect         (T2)
            mo   "1 - ge";                                                       // metabolic overflow     (T2)
        }
        rate    "vG * c[glucoseMass] / (kG + c[glucoseMass]) * Bc * (1 - Pc / Pmax) * (1 - nE)";
    }
}

