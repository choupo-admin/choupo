secretion
{
    //  Secretion (T1) = rho (eta_RP Resp_P + eta_RE Resp_E + eta_FP Ferm), rho read as a fraction (header); C_M -> I (Eq 4, 6)
    stoichiometry
    (
        { component carbonMetabolites  ; nu -1; }
        { component inhibitor          ; nu +1; }
    );
    kinetics
    {
        type    expression;
        source  "Mazzoleni et al., Microb. Cell Fact. 14 (2015) 109, doi:10.1186/s12934-015-0295-4 -- Table 1 (rate law), Table 2 (auxiliaries), Table 4 (CEN.PK113-7D column); the paper's numbers, nothing fitted here";
        basis   reactorVolume;
        rateOf  extent;
        parameters
        {
            rho    0.01      -        ;  // T4 rho
            vRP    1         1/h      ;  // T4 v_RP
            kRP    0.24      kmol/m3  ;  // T4 k_RP
            vF     2.6       1/h      ;  // T4 v_F
            kF     0.14      kmol/m3  ;  // T4 k_F
            vRE    0.2       1/h      ;  // T4 v_RE
            kRE    0.15      kmol/m3  ;  // T4 k_RE
            sigE   1.4       -        ;  // T4 sigma_E
            Emax   100       kmol/m3  ;  // T4 [E]_MAX
            sigI   1         -        ;  // T4 sigma_I
            Imax   1         kmol/m3  ;  // T4 [I]_MAX
            a      0.0002    -        ;  // T4 a
            binv   0.0333333333333 kmol/m3  ;  // T4 b = 30 l/g, entered as its reciprocal 1/30 g/l
            cinv   100       kmol/m3  ;  // T4 c = 0.01 l/g, entered as its reciprocal 100 g/l
        }
        definitions
        {
            Bc   "c[glycolysisProducts] + c[carbonMetabolites]";                 // B = P + C_M            (T2)
            Pc   "c[glycolysisProducts] * cinv / (Bc + c[reserves])";           // [P] = P / ((B + R) c)  (T2)
            nE   "sigE * c[ethanolMass] / Emax";                                 // n_E                    (T2)
            nI   "sigI * c[inhibitor] / Imax";                                   // n_I                    (T2)
            ge   "1 / (1 + a * exp(Pc / binv))";                                    // glucose effect         (T2)
            mo   "1 - ge";                                                       // metabolic overflow     (T2)
        }
        rate    "rho * (0.8 * vRP * Pc / (kRP + Pc) * Bc * (1 - nE) * (1 - nI) * ge + 0.8 * vRE * c[ethanolMass] / (kRE + c[ethanolMass]) * Bc * (1 - nE) * (1 - nI) * ge + 0.2 * vF * Pc / (kF + Pc) * Bc * (1 - nE) * (1 - nI) * mo)";
    }
}

deathP
{
    //  Death_P (T1) = d delta P; P -> D (Eq 7)
    stoichiometry
    (
        { component glycolysisProducts ; nu -1; }
        { component deadCells          ; nu +1; }
    );
    kinetics
    {
        type    expression;
        source  "Mazzoleni et al., Microb. Cell Fact. 14 (2015) 109, doi:10.1186/s12934-015-0295-4 -- Table 1 (rate law), Table 2 (auxiliaries), Table 4 (CEN.PK113-7D column); the paper's numbers, nothing fitted here";
        basis   reactorVolume;
        rateOf  extent;
        parameters
        {
            delta  0.05      1/h      ;  // T4 delta
            tau    0.6       kmol/m3  ;  // T4 tau
            dw     0.001     kmol/m3  ;  // NOT in the paper: width of the smoothed death switch (header)
            a      0.0002    -        ;  // T4 a
            binv   0.0333333333333 kmol/m3  ;  // T4 b = 30 l/g, entered as its reciprocal 1/30 g/l
            cinv   100       kmol/m3  ;  // T4 c = 0.01 l/g, entered as its reciprocal 100 g/l
            sigE   1.4       -        ;  // T4 sigma_E
            Emax   100       kmol/m3  ;  // T4 [E]_MAX
            sigI   1         -        ;  // T4 sigma_I
            Imax   1         kmol/m3  ;  // T4 [I]_MAX
        }
        definitions
        {
            Bc   "c[glycolysisProducts] + c[carbonMetabolites]";                 // B = P + C_M            (T2)
            Pc   "c[glycolysisProducts] * cinv / (Bc + c[reserves])";           // [P] = P / ((B + R) c)  (T2)
            nE   "sigE * c[ethanolMass] / Emax";                                 // n_E                    (T2)
            nI   "sigI * c[inhibitor] / Imax";                                   // n_I                    (T2)
            ge   "1 / (1 + a * exp(Pc / binv))";                                    // glucose effect         (T2)
            mo   "1 - ge";                                                       // metabolic overflow     (T2)
            dsw  "max(0, min(1, (Pc - tau) / dw + 0.5))";                        // d: the death switch, smoothed (header)
        }
        rate    "delta * dsw * c[glycolysisProducts]";
    }
}

