/*---------------------------------------------------------------------------*\
  ctrl13_williams_otto_step  --  the paper's first experiment, reproduced.

  Section 3.2 / Figure 2 of arXiv:2004.07614: from the nominal steady
  state's basin (x0 = (10,1,0,0,0,0) klb, u*), step F_fB from 20 to
  21 klb/h at t* = 100 h and watch the product stream F_pP climb from its
  pre-step plateau ~3.90 klb/h to a new one ~4.4-4.5 klb/h while the
  reactor masses move to the Fig. 2 levels (m_B ~ 12, m_E ~ 21 klb).

  The golden pins BOTH plateaus off our own trajectory (F_pP_klbh at the
  last pre-step write and at t_end); the paper's figure is the external
  shape those numbers must sit on.  Everything else -- model, conventions,
  ledger posture -- is ctrl12's, one Schedule controller added.
\*---------------------------------------------------------------------------*/

application   choupoCtrl;
description   "Williams-Otto F_fB step 20->21 klb/h at t*=100 h (paper Fig. 2): F_pP climbs ~3.90 -> ~4.45 klb/h";

verbosity     3;

startTime       0;         // s
endTime         720000;    // s  (200 h, the paper's window)
deltaT          60;        // s
writeInterval   36000;     // s  (10 h)
