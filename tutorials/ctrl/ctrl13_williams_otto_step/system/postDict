views
(
    {
        name    response;
        type    series;
        title   "How do the product and waste rates answer a 5 % step in the feed of B?";
        note    "The plant settles at 3.90 klb/h of product and 1.22 klb/h of waste with F_fB at 20 klb/h; at 100 h F_fB steps to 21 klb/h (5 %). Product rises to 4.22 klb/h within 10 h and to 4.45 klb/h at 200 h, still creeping up; the waste rises faster in proportion, from 1.22 to 1.91 klb/h.";
        xAxis   { label "time"; unit "h"; scale linear; }
        yAxis   { label "production rate"; unit "klb/h"; scale linear; }
        yAxis2  { label "feed of B"; unit "kmol/s"; scale linear; }
        series
        (
            { name F_pP; label "product P rate"; unitOp plant; table trajectory; x t; y F_pP_klbh; style lines; }
            { name F_wG; label "waste G rate"; unitOp plant; table trajectory; x t; y F_wG_klbh; style lines; }
            { name F_fB; label "feed of B (stepped)"; unitOp FeedStep; table trajectory; x t; y MV; style lines; axis right; }
        );
    }
);
