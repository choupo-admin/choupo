/*---------------------------------------------------------------------------*\
  ctrl05_disturbance_transient / postDict -- the case's TWO figures
  (DEV.md 4c C487 slice 2; grammar: docs/design/a-post-processing-dictionary.md;
  the same two figures as ctrl02_disturbance_rejection, whose setup this is).

    response   "Does the controller hold the reactor at its set point when the
               feed temperature steps?"  PV (reactor T) and set point on the
               left axis; the jacket T (TC1's MV) and the feed T (the Schedule
               FeedDist's MV, 320 -> 305 K at 700 s -> 335 K at 1300 s) on the
               right axis.  The overview's axis spans the 30 K start-up.
    rejection  "How far does the reactor leave its set point when the feed
               steps, and how fast does it return?"  The same signals from
               600 s on a TIGHT left axis, 349.5 to 350.8 K, read from this run's
               `trajectory` table of TC1: PV runs from 349.655 K (the dip, t = 720 s) to 350.658 K (the peak, t = 1320 s), the set point 350 K; the axis 349.5 to 350.8 K.
\*---------------------------------------------------------------------------*/

views
(
    {
        name    response;
        type    series;
        title   "Does the controller hold the reactor at its set point?";
        note    "The PID TC1 holds the reactor at 350 K by moving the jacket temperature; the feed temperature steps down 15 K at 700 s and up 15 K at 1300 s. The jacket takes up each step and the reactor temperature stays on its set point. Each time written here is also a directory of the case, which can be scrubbed.";
        xAxis   { label "time"; unit "s"; scale linear; }
        yAxis   { label "reactor temperature"; unit "K"; scale linear; }
        yAxis2  { label "jacket and feed temperature"; unit "K"; scale linear; }
        series
        (
            { name SP; label "set point"; unitOp TC1; table trajectory; x t; y SP; style lines; }
            { name PV; label "reactor T (controlled)"; unitOp TC1; table trajectory; x t; y PV; style lines; }
            { name MV; label "jacket T (manipulated)"; unitOp TC1; table trajectory; x t; y MV; style lines; axis right; }
            { name Tin; label "feed T (disturbance)"; unitOp FeedDist; table trajectory; x t; y MV; style lines; axis right; }
        );
    }
    {
        name    rejection;
        type    series;
        title   "How far does the reactor leave its set point when the feed steps, and how fast does it return?";
        note    "From 600 s, on a tight axis: after the 15 K step down at 700 s the reactor temperature dips by about 0.35 K (349.655 K at 720 s) and is back within 0.04 K of the set point by 1000 s; after the 15 K step up at 1300 s it peaks about 0.66 K above it (350.658 K at 1320 s) and is back within 0.15 K by 1520 s (values on the 40 s write grid). The jacket temperature moves to absorb each step.";
        xAxis   { label "time"; unit "s"; scale linear; min 600; max 2000; }
        yAxis   { label "reactor temperature"; unit "K"; scale linear; min 349.5; max 350.8; }
        yAxis2  { label "jacket and feed temperature"; unit "K"; scale linear; }
        series
        (
            { name SP; label "set point"; unitOp TC1; table trajectory; x t; y SP; style lines; }
            { name PV; label "reactor T (controlled)"; unitOp TC1; table trajectory; x t; y PV; style lines; }
            { name MV; label "jacket T (manipulated)"; unitOp TC1; table trajectory; x t; y MV; style lines; axis right; }
            { name Tin; label "feed T (disturbance)"; unitOp FeedDist; table trajectory; x t; y MV; style lines; axis right; }
        );
    }
);
