application   choupoSemiContinuous;
description   "Open-loop CSTR START-UP transient with OpenFOAM-style real-time instant dirs: charged cold (320 K), no control, watch T(t) and the holdup approach the natural steady state by scrubbing 0/ 50/ 100/ ... s";

verbosity     3;

// ---- Time integration ----
startTime       0;        // s
endTime         1000;     // s
deltaT          1.0;      // s
writeInterval   50;       // s   (one time directory every 50 s -> 0/ 50/ ... 1000/)

// ---- solutionControl: OpenFOAM-style transient solution directories ----
//   The time directory IS the real physical time (seconds), with the
//   layout of 0/: `<t>/internalStates/reactor` holds the reactor HOLDUP
//   (mole inventory n_i [kmol], T [K]) and `<t>/feed`, `<t>/product` hold
//   the two streams at that instant (componentMolarFlows, T, P).  Open
//   `500/internalStates/reactor` to see the tank exactly as it was at
//   t = 500 s, on its way to steady state -- and rename `500/` to `0/` to
//   start the case from there.  Time directories are written by DEFAULT
//   (as OpenFOAM does); `write true;` below only says so, and `write
//   false;` turns them off.  trajectory.csv is written either way.
solutionControl
{
    write           true;
    flushEach       true;
}
