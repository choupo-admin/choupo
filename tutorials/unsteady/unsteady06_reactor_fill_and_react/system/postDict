/*---------------------------------------------------------------------------*\
  unsteady06_reactor_fill_and_react / postDict -- the case's TWO figures
  (DEV.md 4c C487 slice 2; grammar: docs/design/a-post-processing-dictionary.md).

    fill      "How fast does the reactor fill, and is it near the top of the
              vessel?"  The level (the unit's `level`, m) against time, 1500 s.
              Read from this run's table (100 s grid): 0.020 m (the heel) to
              0.7402 m at 1500 s, rising by 0.048 m per 100 s at the end; the
              volume goes from 3.93e-3 to 0.1453 m3.  The vessel's height is declared in
              the case (1.0 m) but the run does not publish it, so it is not
              drawn and the question is not about it.
    reaction  "How far has the reaction gone while it fills?"  The reactant and
              product amounts (kmol) on the left axis, the temperature (K) on
              the right: n_2Methyl1Propanol 0.0421 to 1.1511 kmol, n_2Butanol 0
              to 0.3910 kmol, T 300 K to 310.40 K.
\*---------------------------------------------------------------------------*/

views
(
    {
        name    fill;
        type    series;
        title   "How fast does the reactor fill?";
        note    "The reactor starts from a 0.02 m heel and fills with no outflow: 0.74 m at 1500 s, rising by 0.048 m per 100 s at the end.";
        xAxis   { label "time"; unit "s"; scale linear; }
        yAxis   { label "level"; unit "m"; scale linear; }
        series
        (
            { name level; label "level"; unitOp reactor; table trajectory; x t; y level; style lines; }
        );
    }
    {
        name    reaction;
        type    series;
        title   "How far has the reaction gone while the reactor fills?";
        note    "The isobutanol in the vessel grows from 0.042 kmol to 1.151 kmol as the feed outruns the reaction, the 2-butanol made grows from 0 to 0.391 kmol, and the exotherm warms the contents from 300 K to 310.4 K.";
        xAxis   { label "time"; unit "s"; scale linear; }
        yAxis   { label "amount in the vessel"; unit "kmol"; scale linear; }
        yAxis2  { label "reactor temperature"; unit "K"; scale linear; }
        series
        (
            { name reactant; label "isobutanol (reactant)"; unitOp reactor; table trajectory; x t; y n_2Methyl1Propanol; style lines; }
            { name product; label "2-butanol (product)"; unitOp reactor; table trajectory; x t; y n_2Butanol; style lines; }
            { name T; label "reactor T"; unitOp reactor; table trajectory; x t; y T; style lines; axis right; }
        );
    }
);
