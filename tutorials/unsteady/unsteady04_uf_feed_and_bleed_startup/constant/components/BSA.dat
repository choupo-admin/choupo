/*--------------------------------*- Choupo -*--------------------------------*\
  Bovine serum albumin (BSA) -- the retained solute of the UF witness
  membrane19_uf_gel_polarisation.  CASE-LOCAL: not in the standard catalogue.

  WHAT IS DERIVED, AND HOW.  MW and formula are computed from the amino-acid
  sequence of UniProtKB P02769 (ALBU_BOVIN, reviewed, sequence version 4;
  UniProt is CC BY 4.0): the MATURE chain, residues 25-607 (583 residues,
  after the 18-residue signal peptide and the 6-residue propeptide the entry
  annotates), as residues plus one water for the termini, minus two H for
  each of the 17 disulfide bonds the entry annotates (35 Cys: 34 bonded, the
  free Cys34), with IUPAC abridged atomic weights (C 12.011, H 1.008,
  N 14.007, O 15.999, S 32.06):  C2934 H4581 N781 O897 S39,  66 398.8 g/mol.
  Carried as a NEUTRAL solute with no charge: its net charge at the pH of a
  UF feed is real and is NOT modelled here.

  WHAT IS NOT HERE, said rather than filled in: no CAS number (none was
  verified), no liquid volume, no heat capacity, no formation enthalpy -- so
  a case carrying BSA publishes no first law, and says so.
\*-----------------------------------------------------------------------------*/

name           BSA;
formula        C2934H4581N781O897S39;
MW             66398.8;        // g/mol -- derived from the sequence, see header
role           nonvolatile;
dissociation   1;              // treated as a non-electrolyte, see header
reviewStatus   interim;

provenance
{
    MW
    {
        origin           derived;
        method           "sum of residue formulas of UniProtKB P02769 residues 25-607 + H2O - 17 x H2 (disulfides), IUPAC abridged atomic weights";
        citation         "UniProt Consortium, UniProtKB entry P02769 (ALBU_BOVIN), sequence version 4, https://rest.uniprot.org/uniprotkb/P02769 -- CC BY 4.0";
        note             "Fetched 2026-09-30.  The derivation is the header's; the formula is the same arithmetic.";
    }
}
