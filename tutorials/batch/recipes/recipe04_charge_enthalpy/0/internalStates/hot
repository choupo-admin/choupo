/*--------------------------------*- Choupo -*----------------------------------*\
  0/internalStates/hot -- the initial HOLDUP of 'hot', the SINGLE
  source of truth (an inline initial{} block in flowsheetDict is refused).
  The `holdup {}` block is the vessel's starting state: T, P, V and the
  inventory (totalMoles + molarComposition, or per species as
  holdupMolar).  Every <t>/internalStates/hot a run writes carries the
  same kind, so a time directory renamed 0/ starts the case from t.
\*-----------------------------------------------------------------------------*/

recordType  internalState;

unit        "hot";
equipment   batchAccumulator;

holdup
{
    T            340.0 K;
    P            1.013 bar;
    V            1.0e-4;           // m^3
    totalMoles   5.0e-4;           // kmol (0.5 mol ethanol)
    molarComposition  { ethanol 1.0;  water 0.0; }
}
