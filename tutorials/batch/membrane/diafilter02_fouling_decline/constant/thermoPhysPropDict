/*---------------------------------------------------------------------------*\
  thermoPhysPropDict (v2) -- the membrane units work on an aqueous liquid
  and never flash, so the liquid model is the whole declaration.  Ideal
  activity is DECLARED, not defaulted: at 0.02 kmol/m3 the salts are far
  enough apart that gamma = 1 is a defensible statement, and stating it
  is how a reader knows it was a choice.
\*---------------------------------------------------------------------------*/
recordType    thermophysicalPropertySystem;
schemaVersion 2;

components       ( water  NaCl  MgSO4 );

equilibrium
{
    formulation gammaPhi;
    liquid
    {
        activityModel ideal;
        standardState pureLiquid;
    }
    vapour
    {
        fugacityModel idealGas;
    }
}
