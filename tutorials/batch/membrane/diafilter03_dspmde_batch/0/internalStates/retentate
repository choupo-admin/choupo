/*---------------------------------------------------------------------------*\
  0/internalStates/retentate -- the initial HOLDUP of 'retentate', the
  retentate vessel's starting state and the SINGLE source of truth (an
  inline initial{} block in flowsheetDict is refused).

  The same charge as diafilter01: 10 litres of water carrying 0.02 kmol/m3
  of each salt (0.5551 kmol of water and 2.0e-4 kmol of each salt, so each
  salt is 3.6e-4 of the inventory).  Only the transport law and the mode
  differ, so what changes between the two runs is the membrane model and
  the operation, not the feed.
\*---------------------------------------------------------------------------*/

recordType  internalState;

unit        "retentate";
equipment   batchDiafilter;

holdup
{
    T            298.15 K;
    P            10 bar;
    V            0.010;                // m^3 (10 litres)
    totalMoles   0.5555;               // kmol
    molarComposition
    {
        water    0.99928;
        NaCl     0.00036;
        MgSO4    0.00036;
    }
}
