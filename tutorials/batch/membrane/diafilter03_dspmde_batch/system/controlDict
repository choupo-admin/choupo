/*---------------------------------------------------------------------------*\
  diafilter03_dspmde_batch / system/controlDict

  Batch CONCENTRATION on the DSPM-DE pore model: no make-up solvent, so
  the vessel shrinks and both salts concentrate behind the membrane.  The
  clock is set by the volume, not by the numerics: see the header of
  system/flowsheetDict for the volume reduction this endTime reaches.

  THE STEPPING IS DECLARED ADAPTIVE, and that is a choice with a reason.
  Without `timeStepping adaptive;` choupoBatch advances every vessel by
  its own fixed step, which for this unit is an explicit Euler step of
  deltaT -- a first-order answer.  The time-averaged rejection this case
  exists to publish is a ratio of two integrals, so it inherits that
  error; under the error-controlled Rosenbrock23 sweep the inventory, the
  permeated volume and the permeate-weighted integrals are advanced
  together to rtol 1e-6.  deltaT is then only the starting step.
\*---------------------------------------------------------------------------*/

application   choupoBatch;
description   "Batch NF concentration on the DSPM-DE pore model: the observed rejection per instant and the campaign's time-averaged rejection";

verbosity     3;

startTime       0;
endTime         140;       // s
deltaT          1;         // s   (the adaptive sweep's STARTING step)
writeInterval   5;         // s

timeStepping    adaptive;  // Rosenbrock23, error-controlled (rtol 1e-6)
