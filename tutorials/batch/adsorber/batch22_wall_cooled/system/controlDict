/*---------------------------------------------------------------------------*\
  batch22_wall_cooled / system/controlDict

  Time control for the A5-T1 adiabatic breakthrough.  The isothermal
  batch18 saturates by 4200 s; the ADIABATIC front breaks through MUCH
  earlier (t_50 ~ 806 s vs 3042: the warm bed holds less), and the
  THERMAL wave crawls (u_th = 7.96e-5 m/s, L/u_th ~ 6280 s).  The
  12000 s window shows the honest COUPLED story: outlet T rises to
  ~336 K (well below the announced 140 K BOUND -- the heat lags the
  front), then stays WARM long past L/u_th because the cooling
  upstream keeps re-adsorbing and shipping its heat downstream; the
  bed MEAN T decays (325.5 K at 6000 s -> 315.6 K at 12000 s) while
  c_out/c_in creeps toward 1 (0.823 at end).  Full cold saturation
  lies far beyond this window -- the case declares that instead of
  paying tens of simulated hours for the tail.

  timeStepping adaptive is REQUIRED in thermal mode (the fixed-step
  Gershgorin bound covers the isothermal rows only -- the engine
  refuses `fixed` here, by name).
\*---------------------------------------------------------------------------*/

application   choupoBatch;
description   "T2 wall-cooled CO2/He breakthrough (h=5 W/m2K, T_wall=298.15 K): the bed BETWEEN its limits -- t_50 bracketed by the adiabatic 806 s and isothermal 3036 s, Q_wall as a state row of the same ODE, wallHeat record read from the state";

verbosity     3;

// ---- Time integration ----
startTime       0;        // s
endTime         12000;    // s   (> L/u_th: the thermal wave must LEAVE)
deltaT          0.05;     // s   (unused: thermal requires adaptive)
writeInterval   100;      // s
timeStepping    adaptive; // Rosenbrock23 (REQUIRED in thermal mode)
