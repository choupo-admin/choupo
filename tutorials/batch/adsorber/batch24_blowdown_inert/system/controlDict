/*---------------------------------------------------------------------------*\
  batch24_blowdown_inert -- meta-control (P-swing WITNESS A)
\*---------------------------------------------------------------------------*/

application   choupoBatch;
description   "P-swing witness A: inert isothermal blowdown, n/n0 = P/P0";

verbosity     3;

startTime       0;
endTime         1200;     // s  (drain is over in seconds; the tail proves steady)
deltaT          0.05;     // s
writeInterval   100;      // s
timeStepping    adaptive;
timeSteppingControl
{
    rtol        1.0e-6;
    atol        1.0e-9;
    deltaT0     1.0e-3;
    deltaTmax   5.0;
    maxGrowth   2.0;
}
