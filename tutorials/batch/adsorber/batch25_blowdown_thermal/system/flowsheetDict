/*---------------------------------------------------------------------------*\
  batch25_blowdown_thermal  --  P-SWING WITNESS B: the cooling.

  The THERMAL half of a blowdown, isolated from adsorption so the only
  heat effect in frame is the expansion work itself (design note
  fixed-bed-thermal-a5.md, section 8/9 amended battery):

    * same inert pure-He ergun bed as witness A (batch24), but
      `energyBalance adiabatic;` -- each cell's internal energy
      U_j = eps c (h - RT) + rho_b cp_s (T - T0) is balanced in
      conservative finite-volume form (design note section 10);
    * at t = 200 s the recipe closes the feed valve (P2) and halves the
      outlet boundary (P1) -- the bed drains, and the gas that stays
      behind did the work of pushing the vented gas out: read through
      the chain rule, the eps R T dc_tot/dt term pulls T DOWN;
    * the solid heat capacity is a declared SYNTHETIC LOW value
      (9.2 J/(kg K), scope says so): the real ~920 of a zeolite pellet
      would thermally bury the gas-phase cooling under the solid's mass
      (dT ~ -0.03 K); at the teaching value the drop is visible
      (~ -3 K class).  Same honest-teaching-value discipline as the
      hxFluid of the pinch witness -- the physics on display is the
      GAS's, and the header says which knob made it visible.

  THE ANCHOR: T_min_final_K sits BELOW the declared 298.15 K by a
  visible margin -- a depressurising cell COOLS, which is exactly what
  the pre-widening cp-form could not show (the sabotage of the gate
  restores that form and this witness fails).  The material anchors
  stay witness A's business; this case pins the sign and visibility of
  the thermal effect.  AND ITS FIRST LAW: the campaign energy balance
  is claimed and closes to round-off (energy_closure_rel ~ 4e-10 of the
  2.3 J the blowdown moves, against ~200 J of gross hold-up energy),
  because the face enthalpy fluxes are shared by the two cells of each
  face and the vented gas leaves carrying exactly what crossed the outlet
  face.  Until 2026-11-09 the bed carried a temperature form that missed
  this first law by 7.9 % of the energy moved, at every step size, and the
  engine refused the claim by name (DEV.md 4c C258).
\*---------------------------------------------------------------------------*/

units
(
    {
        name bed;
        type fixedBedAdsorber;
        solver { samplingInterval 2.0; rtol 1e-6; }
        operation
        {
            adsorbent zeolite13X_A4; flowModel ergun;
            energyBalance adiabatic;
            solidHeatCapacity
            {
                value  [0 2 -2 -1 0] 9.2;   // J/(kg K)
                scope  "SYNTHETIC LOW teaching value (real zeolite ~920): exposes the gas-phase expansion cooling the solid's thermal mass would bury";
                source "declared teaching value, chosen for pedagogical visibility of the eps R T dc/dt term";
            }
            L 0.5 m; area 0.01 m2; eps 0.4; u 0.05 m/s;
            T 298.15 K; P 1 bar; P_out 1 bar;
            Dax [0 2 -1 0 0] 1e-4; nCells 25;
            feed { molarComposition { He 1.0; } }
            initial { molarComposition { He 1.0; } }
            kLDF
            {
                basis solidFilm;
                scope "INERT witness: the solid is deliberately frozen";
                source "declared (k = 0 -- transport-only, no adsorption)";
                k { CO2 [0 0 -1 0 0] 0.0; }
            }
        }
    }
);

recipe
(
    {
        time     200;
        action   setParameter;
        unit     bed;
        key      u;
        value    0.0;
    }
    {
        time     200;
        action   setParameter;
        unit     bed;
        key      P_out;
        value    50000;        // Pa = 0.5 bar
    }
);
