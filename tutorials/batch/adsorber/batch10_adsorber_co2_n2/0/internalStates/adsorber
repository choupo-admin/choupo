/*--------------------------------*- Choupo -*----------------------------------*\
  0/internalStates/adsorber -- the initial HOLDUP of 'adsorber', the SINGLE
  source of truth (an inline initial{} block in flowsheetDict is refused).
  The `holdup {}` block is the vessel's starting state: T, P, V and the
  inventory (totalMoles + molarComposition, or per species as
  holdupMolar).  Every <t>/internalStates/adsorber a run writes carries the
  same kind, so a time directory renamed 0/ starts the case from t.
\*-----------------------------------------------------------------------------*/

recordType  internalState;

unit        "adsorber";
equipment   batchAdsorber;

holdup
{
    T            298.15 K;
    V            0.01;             // m3 -- the GAS headspace volume
    totalMoles   0.002;            // kmol = 2 mol gas
    molarComposition { CO2 0.25;  N2 0.75; }   // 0.5 + 1.5 mol
}
