//  Ambient air drawn by the fluid-bed dryer's supply fan: 250 kmol/h of dry air (about 7 200 kg/h, 79/21 N2/O2 by mole)
//  carrying 3 kmol/h of water (about 38 % relative humidity at 25 C) --
//  AUTHOR-SET, at the flowsheet basis (README section 2: the basis is the
//  fluid bed's own drying rate).

componentMolarFlows
{
    N2                           197.5 kmol/h;
    O2                           52.5 kmol/h;
    water                        3.0 kmol/h;
}

T               298.15 K;
P               1.01325 bar;
phase           gas;
