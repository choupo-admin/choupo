    //  other taxable profit, a group's reading); the run announces the
    //  total (README section 6).  `taxOnLoss none;` is the stand-alone
    //  reading (no credit, no carry-forward).  DEV.md 4c C269 decision (2).
    depreciation        straightLine;
    depreciableLife     7;           // yr -- ASSUMED
    salvageFraction     0.0;
    //  THE YEAR'S FLOWS COME FROM THE BATCH PLAN (DEV.md 4c C99): every
    //  annual flow is the hourly flow x Q / r_P (the "equivalent hours").
    streamFactor        fromBatchPlan;
    siteFactor          0.50;
    contingencyFee      1.18;
    //  Non-particulate processing steps (Turton's operator count): the two
    //  air heaters.  The PARTICULATE steps are counted apart, below.
    N_np                2;
    particulateSteps
    {
        count   6;
        source  "the case's own count (DEV.md 4c C98, C110): granulation, fluid-bed drying, milling, final blending, tableting, coating -- packaging folded into its neighbour";
        reason  "Turton's P counts the processing steps that handle particulate solids; this plant's train is six of them.  With the crew below declared, P drives only the printed COMPARISON";
    }

    //  THE OPERATING CREW, DECLARED (DEV.md 4c C98 round 2).  The labour is
