    operatingCrew
    {
        areas
        (
            { area "dispensing";             operatorsPerShift 1; }
            { area "granulation and drying"; operatorsPerShift 2; }  // binder, high-shear granulator, fluid bed
            { area "milling and blending";   operatorsPerShift 1; }
