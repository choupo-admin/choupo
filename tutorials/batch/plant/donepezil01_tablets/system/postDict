/*---------------------------------------------------------------------------*\
  postDict -- batch plan, sizing, costing and economics of the donepezil
  tablet plant.

  WHAT IS SIZED (and so costed, and placed on the plot plan): the items for
  which the engine has a sizer and the costing a correlation --

    binderPrep              vessel       on the batch plan's volume (one lot of binder solution)
    coatingSuspensionPrep   vessel       on the batch plan's volume (one lot of suspension)
    fbdAirHeater            shellTubeHX  A = Q/(U LMTD) against LP steam (the fluid bed's air)
    coatingAirHeater        shellTubeHX  against LP steam (the coater's air)

  WHAT IS NOT SIZED, AND HOW IT REACHES THE CAPITAL ANYWAY.  The high-shear
  granulator, the fluid-bed dryer, the mill, the final blender, the tablet
  press, the coating pan and the packaging line are MASS-BALANCE
  PLACEHOLDERS (or, for the two dryers, a `solidDryer` with no sizer):
  Choupo has no cost correlation and no machine model for any of them, and
  it does not invent one; since DEV.md 4c C195 each is checked for FIT by a
  `ratedMachine` entry below (the lot's load over a rating the case
  declares).  Neither is the GMP BUILDING costed.  They enter the capital as
  DECLARED QUOTES (`costing { quotes ( ... ); }` below, DEV.md 4c C98): one
  price per item, each an AUTHOR-SET PLACEHOLDER said so on its own line,
  for the group to replace with a vendor's quotation.  NOT in the capital
  still: the warehouse and the offices/QC laboratory as quoted items (the
  economics' siteFactor term is Turton's estimate of such auxiliary
  facilities), the purified-water plant, dust collection, cleaning systems.

  EVERY DESIGN NUMBER BELOW IS AN AUTHOR-SET ASSUMPTION, said on its line,
  for the group to replace; none cites a source because none was read.
  MATERIAL SS316 everywhere (product contact); pressureDesign 2 bar
  (atmospheric tanks and air heaters); vessels with a fully radiographed
  joint, 1.5 mm corrosion allowance and L/D 1.5, declared so that no engine
  default is used silently.
\*---------------------------------------------------------------------------*/

//  ======================== THE BATCH PLAN (DEV.md 4c C99) ==================
//  The flowsheet is the MATERIAL BALANCE PER UNIT OF PRODUCT; this block
//  designs the BATCH PLANT on it (src/postProcessing/BatchPlanPass.H states
//  the method): each step's equipment is sized for ONE LOT from the
//  flowsheet's own stream masses, the lots a year follow from the
//  production, and the slowest step paces each train.  Declared ABOVE
//  `sizing` and `costing`: the two preparation tanks take their volume from
//  it and the machines' quotes scale with the sizes it derives.
//
//  TWO TRAINS, decoupled by the FINAL-BLEND store: the final blend is HELD
//  in closed bins (IBCs) for quality-control release before it is pressed,
//  so the granulation suite (dispensing to final blend) and the tableting
//  suite (compression, coating, packaging) each run their own campaigns.
//
//  ONE PRODUCT.  Only the 10 mg tablet is planned here.  The 5 mg tablet
//  (the same excipients, half the lactose, a white coat) would share both
//  trains in campaigns with a cleaning between products: that plan waits
//  for the multiproduct batch plan (DEV.md 4c C110, A2) -- README section 2a.
//
//  EVERY NUMBER BELOW IS AN AUTHOR-SET ASSUMPTION of the right order for a
//  commercial oral-solid-dose line, said so in each `source`, for the group
//  to replace with its own design basis (README section 2a).
batchPlan
{
    product   packagedTablets;

    production
    {
        perYear  43535 kg;      // of packaged tablets: 150 million of 10 mg at 0.29023 g
        source   "author-set assumption (DEV.md 4c C110), not a market study";
        reason   "150 million 10 mg tablets a year, one product on one line (README section 2); the market share the group can win is its own study";
    }

    //  The lot is counted, as an oral-solid-dose lot usually is, in kg of
    //  FINAL BLEND: 300 kg is about 1.07 million cores of 280 mg.
    lot
    {
        rule     declared;
        stream   finalBlend;
        mass     300 kg;
        source   "author-set assumption (DEV.md 4c C110), not a validated lot size";
        reason   "a commercial wet-granulation lot of a few hundred kg of blend, granulated and dried in one load; the lot is what QC releases, so its size is a regulatory as well as an equipment choice";
    }

    lowUtilisation  0.25;       // a stage below a quarter of its cycle is announced

    trains
    (
        {
            train           granulation;
            availableTime   3840 h;     // 2 shifts x 8 h x 5 days x 48 weeks
            lotsPerCampaign 8;
            changeover      24 h;       // a full clean of the suite and its line clearance
            source  "author-set assumption (DEV.md 4c C110)";
            reason  "a wet-granulation suite on two day shifts, a product campaign of eight lots between full cleans";
        }
        {
            train           tableting;
            availableTime   3840 h;     // 2 shifts x 8 h x 5 days x 48 weeks
            lotsPerCampaign 8;
            changeover      24 h;
            source  "author-set assumption (DEV.md 4c C110)";
            reason  "compression, coating and packaging on two day shifts, campaigns of eight lots between full cleans";
        }
    );

    //  THE CLEANING OF THE MACHINES (DEV.md 4c C210, E3).  The plan counts the
    //  cleans -- one after every lot of each instance the lot is split over, and
    //  one of every installed instance at each campaign changeover -- and the
    //  CASE declares the purified water of ONE clean of ONE instance and the
    //  fraction of it that leaves as effluent.  EVERY NUMBER IS AN AUTHOR-SET
    //  ASSUMPTION, round figures of the right order, to be replaced by the
    //  group's cleaning procedure (a rinse volume per wet-cleaned item).  The
    //  mill, the press and the packaging line are DRY-cleaned (vacuum and
    //  wipe-down): they carry no water and are not listed.  The purified-water
    //  demand of `cleanUtilities` reads these cleans (one ledger: the old lump
    //  `uses` entry `cleaning` is gone), and the effluent is published as a
    //  VOLUME in m3 a year (`kpis.cleaning`), its load is not computed.
    cleaning
    (
        { unit binderPrep;            waterPerLotClean 0.2 m3;  waterPerChangeover 0.5 m3;  effluentFraction 0.95;
          source "author-set assumption (DEV.md 4c C210, E3), to be replaced by the group's cleaning procedure";
          reason "a rinse of the binder tank and its transfer line after each lot; a full rinse at a changeover"; }
        { unit granulator;            waterPerLotClean 0.8 m3;  waterPerChangeover 2.0 m3;  effluentFraction 0.95;
          source "author-set assumption (DEV.md 4c C210, E3), to be replaced by the group's cleaning procedure";
          reason "the wet wash of the high-shear bowl, impeller and chopper after a lot; a full clean with detergent at a changeover"; }
        { unit fluidBedDryer;         waterPerLotClean 0.6 m3;  waterPerChangeover 1.5 m3;  effluentFraction 0.95;
          source "author-set assumption (DEV.md 4c C210, E3), to be replaced by the group's cleaning procedure";
          reason "the wash of the product bowl and the filter housing after a lot (the filter bags are dry-cleaned or changed); a full clean at a changeover"; }
        { unit finalBlender;          waterPerLotClean 0.2 m3;  waterPerChangeover 0.5 m3;  effluentFraction 0.95;
          source "author-set assumption (DEV.md 4c C210, E3), to be replaced by the group's cleaning procedure";
          reason "a rinse of the bin blender after the lubricated blend; a full clean at a changeover"; }
        { unit coatingSuspensionPrep; waterPerLotClean 0.3 m3;  waterPerChangeover 0.8 m3;  effluentFraction 0.95;
          source "author-set assumption (DEV.md 4c C210, E3), to be replaced by the group's cleaning procedure";
          reason "a rinse of the coating suspension tank and the spray lines after each lot; a full clean at a changeover"; }
        { unit coatingPan;            waterPerLotClean 0.9 m3;  waterPerChangeover 2.0 m3;  effluentFraction 0.95;
          source "author-set assumption (DEV.md 4c C210, E3), to be replaced by the group's cleaning procedure";
          reason "the wash of the perforated pan, the spray guns and the lines after a coated lot; a full clean at a changeover"; }
    );

    //  In RECIPE order; each stage feeds the next of its train unless it
    //  says otherwise.  `holds` names the stream whose flowsheet mass the
    //  stage handles per lot -- the mass is READ, never typed here.
    stages
    (
        //  ---- train granulation ----------------------------------------
        {
            stage  binderPreparation;  train granulation;  type batch;
            units  ( binderPrep );     holds binderSolution;
            bulkDensity  1020 kg/m3;   // a 10 wt % HPC solution in water
            fillFraction 0.8;
            chargeTime   0.5 h;  processTime 1 h;  cleanTime 1 h;
            dischargeTime throughFedStage;   // pumped into the granulator while it granulates
            source "author-set assumption (DEV.md 4c C110); the density is water's, rounded up for the polymer";
            reason "one tank of binder solution per lot, held until the granulator has taken it";
        }
        {
            stage  granulation;  train granulation;  type batch;
            units  ( granulator );  holds wetMass;
            bulkDensity  550 kg/m3;  fillFraction 0.6;   // a high-shear bowl at 60 % of its volume
            chargeTime 0.5 h;  processTime 0.5 h;  dischargeTime 0.25 h;  cleanTime 1.5 h;
            source "author-set assumption (DEV.md 4c C110), not a measured bulk density";
            reason "dry mixing, binder addition and wet massing in one load; discharged wet straight into the fluid-bed bowl";
        }
        {
            stage  drying;  train granulation;  type batch;
            units  ( fluidBedDryer fbdAirHeater );  holds wetMass;
            bulkDensity  550 kg/m3;  fillFraction 0.5;   // the bowl, with room for the bed to expand
            chargeTime 0.25 h;  processTime 1.5 h;  dischargeTime 0.5 h;  cleanTime 2 h;
            source "author-set assumption (DEV.md 4c C110); the 1.5 h is the drying time the flowsheet basis is built on (system/flowsheetDict)";
            reason "the wet mass dried in one load to its end-point moisture, then cooled with ambient air and discharged";
        }
        {
            stage  milling;  train granulation;  type semicontinuous;
            units  ( mill );  holds driedGranules;
            chargeTime 0.25 h;  operatingTime 2 h;  dischargeTime 0 h;  cleanTime 1 h;
            source "author-set assumption (DEV.md 4c C110)";
            reason "the dried granules sized through a screen mill into the blending bin";
        }
        {
            stage  finalBlending;  train granulation;  type batch;
            units  ( finalBlender );  holds finalBlend;
            bulkDensity  500 kg/m3;  fillFraction 0.6;
            chargeTime 0.5 h;  processTime 0.25 h;  dischargeTime 0.5 h;  cleanTime 1 h;
            source "author-set assumption (DEV.md 4c C110)";
            reason "the lubricant blended in for a few minutes in a bin blender; the bin is the lot's store until release";
        }

        //  ---- train tableting ----------------------------------------------
        {
            stage  compression;  train tableting;  type semicontinuous;
            units  ( tabletPress );  holds finalBlend;
            feeds  coating;
            chargeTime 1.5 h;  operatingTime 7 h;  dischargeTime 0 h;  cleanTime 1.5 h;
            source "author-set assumption (DEV.md 4c C110)";
            reason "a rotary press set up for the lot (tooling, weight and hardness checks) and run at about 150 000 tablets an hour";
        }
        {
            stage  suspensionPreparation;  train tableting;  type batch;
            units  ( coatingSuspensionPrep );  holds coatingSuspension;
            feeds  coating;
            bulkDensity  1050 kg/m3;  fillFraction 0.7;
            chargeTime 0.5 h;  processTime 1.5 h;  cleanTime 0.5 h;
            dischargeTime throughFedStage;   // sprayed onto the cores through the coating
            source "author-set assumption (DEV.md 4c C110); the density is of the order of a 12 wt % pigmented HPMC suspension";
            reason "the coating suspension is made for each lot and sprayed while the pan coats";
        }
        {
            stage  coating;  train tableting;  type batch;
            units  ( coatingPan coatingDryer coatingAirHeater );  holds tabletCores;
            bulkDensity  750 kg/m3;  fillFraction 0.65;   // tablet bed in a perforated pan
            chargeTime 0.5 h;  processTime 4 h;  dischargeTime 0.5 h;  cleanTime 1.5 h;
            source "author-set assumption (DEV.md 4c C110)";
            reason "one lot of cores coated in one pan load to a 3 % weight gain";
        }
        {
            stage  packaging;  train tableting;  type semicontinuous;
            units  ( packagingLine );  holds packagedTablets;
            chargeTime 1 h;  operatingTime 9 h;  dischargeTime 0 h;  cleanTime 1 h;
            source "author-set assumption (DEV.md 4c C110)";
            reason "a PVC/aluminium blister line (the reference product's pack, SmPC section 6.5) set up and cleared for each lot, run at about 120 000 tablets an hour";
        }
    );
}

sizing
{
    units
    (
        //  ---- the two air heaters: A = Q/(U LMTD), LMTD computed against
        //  the utility record; U is a gas-side film against condensing
        //  steam -- ASSUMED.
        { unitName fbdAirHeater;  type shellTubeHX;  material SS316;
          designRules { utility steamLP;  U 40;  pressureDesign 2; } }
        { unitName coatingAirHeater;  type shellTubeHX;  material SS316;
          designRules { utility steamLP;  U 40;  pressureDesign 2; } }

        //  ---- the two preparation tanks, sized by the BATCH PLAN ---------
        //  `volume fromBatchPlan;`: each holds one lot of its liquid, V = S B.
        { unitName binderPrep;  type vessel;  material SS316;
          designRules { volume fromBatchPlan;  L_over_D 1.5;  pressureDesign 2;
                        corrosionAllow 0.0015;  jointEfficiency 1.0; } }
        { unitName coatingSuspensionPrep;  type vessel;  material SS316;
          designRules { volume fromBatchPlan;  L_over_D 1.5;  pressureDesign 2;
                        corrosionAllow 0.0015;  jointEfficiency 1.0; } }

        //  ---- THE SOLID-DOSE MACHINES, RATED (DEV.md 4c C195) --------------
        //  Each machine the flowsheet carries as a mass-balance placeholder is
        //  checked against a DECLARED rating and the batch plan's lot:
        //  utilisation = load / (machines x rating).  EVERY rating below is
        //  an author-set assumption for the group to replace with a data
        //  sheet.  The item is not costed (the quote below carries the money)
        //  and not placed (its ROOM is what the plot plan places).
        { unitName granulator;  type ratedMachine;  material SS316;
          designRules
          {
              kind batchVolume;
              rating
              {
                       nominalVolume 1.2 m3;
                       maxFill 0.6;
                       source "author-set assumption (DEV.md 4c C195), not a vendor data sheet: a high-shear granulator bowl of about a cubic metre";
                       reason "the dry powders, the binder and the wet mass of one lot in one bowl";
              }
              shift { length 8 h;
                      source "README section 2a / the batch plan: the solid-dose suite runs two day shifts of 8 h (system/postDict, train availableTime)";
                      reason "a lot that cannot be finished inside the shift it starts in spans shifts, a staffing and GMP line-clearance question"; }
          } }
        { unitName fluidBedDryer;  type ratedMachine;  material SS316;
          designRules
          {
              kind batchVolume;
              rating
              {
                       nominalVolume 1.5 m3;
                       maxFill 0.5;
                       source "author-set assumption (DEV.md 4c C195), not a vendor data sheet: a fluid-bed product bowl; the largest fill leaves room for the bed to expand";
                       reason "the wet mass of one lot dried in one load";
              }
              shift { length 8 h;
                      source "README section 2a / the batch plan: the solid-dose suite runs two day shifts of 8 h (system/postDict, train availableTime)";
                      reason "a lot that cannot be finished inside the shift it starts in spans shifts, a staffing and GMP line-clearance question"; }
          } }
        { unitName mill;  type ratedMachine;  material SS316;
          designRules
          {
              kind massRate;
              rating
              {
                       capacity 500 kg/h;
                       source "author-set assumption (DEV.md 4c C195), not a vendor data sheet: a conical screen mill";
                       reason "the dried granules sized through a screen; replace with the mill's data sheet";
              }
              shift { length 8 h;
                      source "README section 2a / the batch plan: the solid-dose suite runs two day shifts of 8 h (system/postDict, train availableTime)";
                      reason "a lot that cannot be finished inside the shift it starts in spans shifts, a staffing and GMP line-clearance question"; }
          } }
        { unitName finalBlender;  type ratedMachine;  material SS316;
          designRules
          {
              kind batchVolume;
              rating
              {
                       nominalVolume 1.0 m3;
                       maxFill 0.7;
                       source "author-set assumption (DEV.md 4c C195), not a vendor data sheet: a bin blender and its bin";
                       reason "the 300 kg final-blend lot of the case in one bin";
              }
              shift { length 8 h;
                      source "README section 2a / the batch plan: the solid-dose suite runs two day shifts of 8 h (system/postDict, train availableTime)";
                      reason "a lot that cannot be finished inside the shift it starts in spans shifts, a staffing and GMP line-clearance question"; }
          } }
        { unitName tabletPress;  type ratedMachine;  material SS316;
          designRules
          {
              kind tabletPress;
              rating
              {
                       stations 55;
                       turretSpeed 60;
                       compressionsPerRevolution 1;
                       itemMass 0.28 g;
                       source "author-set assumption (DEV.md 4c C195), not a vendor data sheet: a rotary press, 55 stations at 60 rpm, single-sided, nameplate with no efficiency applied; the pressed core is the 280 mg of the case (README section 2)";
                       reason "a mid-size rotary press; replace with the press vendor's data sheet and tooling";
              }
              shift { length 8 h;
                      source "README section 2a / the batch plan: the solid-dose suite runs two day shifts of 8 h (system/postDict, train availableTime)";
                      reason "a lot that cannot be finished inside the shift it starts in spans shifts, a staffing and GMP line-clearance question"; }
          } }
        { unitName coatingPan;  type ratedMachine;  material SS316;
          designRules
          {
              kind batchVolume;
              rating
              {
                       nominalVolume 1.0 m3;
                       maxFill 0.65;
                       source "author-set assumption (DEV.md 4c C195), not a vendor data sheet: a perforated coating pan of about a cubic metre";
                       reason "one lot of cores in one pan load";
              }
              shift { length 8 h;
                      source "README section 2a / the batch plan: the solid-dose suite runs two day shifts of 8 h (system/postDict, train availableTime)";
                      reason "a lot that cannot be finished inside the shift it starts in spans shifts, a staffing and GMP line-clearance question"; }
          } }
        { unitName packagingLine;  type ratedMachine;  material SS316;
          designRules
          {
              kind packagingLine;
              rating
              {
                       packsPerMinute 100;
                       itemsPerPack 28;
                       itemMass 0.29023 g;
                       source "author-set assumption (DEV.md 4c C195), not a vendor data sheet: a blister line at 100 blisters of 28 tablets a minute; the packed tablet is the 0.29023 g of the case";
                       reason "a PVC/aluminium blister line at its nameplate speed; replace with the packaging vendor's data sheet";
              }
              shift { length 8 h;
                      source "README section 2a / the batch plan: the solid-dose suite runs two day shifts of 8 h (system/postDict, train availableTime)";
                      reason "a lot that cannot be finished inside the shift it starts in spans shifts, a staffing and GMP line-clearance question"; }
          } }
    );
}

//  ===================== THE CLEAN UTILITIES (DEV.md 4c C195) ==================
//  The air and the purified water of the building, sized from the building the
//  layout checked (system/layoutDict) and the batch plan above.  Run BEFORE the
//  costing, so the supply air of each grade is a priced item (`costing { quotes
//  ( { hvacGrade ...; valuePerSupplyAir ...; } ) }`, DEV.md 4c C210 E2); the
//  generator and the tank are not costed (the building and utilities quotes
//  carry them).  EVERY NUMBER IN
//  THIS BLOCK IS AN AUTHOR-SET ASSUMPTION for the group to replace; none is
//  from a standard's table (the published air-change tables are no-grant
//  documents and are not shipped).  The air is SENSIBLE only: no humidity, no
//  latent load, no room heat gain -- the run says so.
cleanUtilities
{
    hvac
    {
        air
        {
            density       1.2 kg/m3;
            heatCapacity  1006 J/kg/K;
            source "author-set assumption (DEV.md 4c C195): dry air near 20 degC, rounded";
            reason "the density and heat capacity that turn a volume flow into a heat duty";
        }
        //  Air changes per hour of each GRADE of the building, and why.
        changesPerHour
        (
            { grade D;    perHour 20;
              source "author-set assumption (DEV.md 4c C195), not from a standard's table";
              reason "an order of magnitude for a graded oral-solid-dose room; the group replaces it with the rate its own contamination and cleanliness argument supports"; }
            { grade CNC;  perHour 6;
              source "author-set assumption (DEV.md 4c C195), not from a standard's table";
              reason "an order of magnitude for a controlled-not-classified room (comfort and dust control); the group replaces it"; }
        );
        fan
        {
            pressureRise  1000 Pa;
            efficiency    0.6;
            source "author-set assumption (DEV.md 4c C195)";
            reason "filters (to the final HEPA), coils, silencers and ducting of an air-handling unit, lumped; the fan and drive efficiency of a medium centrifugal fan";
        }
        outdoor
        {
            winter  2 degC;
            summer  32 degC;
            source "author-set assumption (DEV.md 4c C195): no site is declared for this plant";
            reason "design temperatures of a temperate site; the group replaces them with its site's design values";
        }
        supply
        {
            temperature       20 degC;
            freshAirFraction  0.2;
            source "author-set assumption (DEV.md 4c C195)";
            reason "a recirculating air-handling unit takes a fifth of its flow fresh; a contained room with an open API would take 100 % fresh air, a question for the group";
        }
        //  The technical floor houses the air plant and the utilities: it is
        //  not served by it.
        unserved
        {
            rooms ( hvacPlant utilities electrical techLanding );
            source "system/layoutDict: the technical floor (AHUs, utilities, switchgear)";
            reason "plant rooms are not conditioned by the air plant they house";
        }
    }

    purifiedWater
    {
        fluid
        {
            density 998 kg/m3;
            source "author-set assumption (DEV.md 4c C195): water near 20 degC, rounded";
            reason "turns the water mass of the balance into a volume";
        }
        uses
        (
            { name binderWater;  stream granWater;  stage binderPreparation;  drawTime 0.5 h;  when start;
              source "the flowsheet stream granWater (the water of the 10 wt % HPC binder), read from the converged balance";
              reason "purified water is the granulating liquid"; }
            { name coatingSuspensionWater;  stream coatWater;  stage suspensionPreparation;  drawTime 0.5 h;  when start;
              source "the flowsheet stream coatWater (the water of the 12 wt % coating suspension), read from the converged balance";
              reason "purified water is the solvent of an aqueous film-coat suspension"; }
        );
        generator
        {
            margin  0.25;
            source "author-set assumption (DEV.md 4c C195)";
            reason "a quarter above the peak draw: demand growth and the loop's own return flow";
        }
        storage
        {
            holdTime  4 h;
            source "author-set assumption (DEV.md 4c C195)";
            reason "four hours of the peak draw without the generator: a shutdown or a sanitisation";
        }
    }
}

costing
{
    method    Turton;
    year      2026;
    cepci     820;        // a projection -- AUTHOR-SET (apalutamide01's)
    cepci2001 397;        // the correlations' own basis year
    usdToEur  0.92;

    //  THE DECLARED QUOTES (DEV.md 4c C98).  EVERY VALUE BELOW IS AN
    //  AUTHOR-SET PLACEHOLDER -- a round number of the right order chosen so
    //  that the solid-dose machines and their building are not ZERO in the
    //  capital -- and none is a vendor's price.  A group replaces each one
    //  with a dated quotation (vendor, reference, date in `source`).  THE
    //  MACHINES SCALE WITH THE BATCH PLAN (DEV.md 4c C99): each `value` is the
    //  price of ONE machine of its `referenceSize`, and the item costs
    //  units x value x (size / referenceSize)^0.6, a batch machine on the
    //  INSTALLED size and count its `ratedMachine` declares (C389), any other
    //  on the stage's size.  The building does not scale.  2026 money.
    quotes
    (
        //  THE HVAC, PRICED FROM THE SUPPLY AIR (DEV.md 4c C210, E2): the
        //  `cleanUtilities` pass above sizes the supply air of each grade; the
        //  case DECLARES an installed cost per m3/h of it.  BOTH VALUES ARE
        //  ASSUMED, author-set, and to be replaced by a quote -- no vendor
        //  price and no published table stands behind them.  For orientation
        //  ONLY (not a source): design reports of tablet plants carried HVAC
        //  as a lump of the order of 0.6 to 2.5 MEUR; the figure these two
        //  values give is in the README beside that range, and is not
        //  validated by it.  `kind facility;` as the building's, which carried the
        //  HVAC before (see the building quote below).
        { hvacGrade D;  valuePerSupplyAir 12;  currency EUR;  year 2026;
          basis installed;  kind facility;
          source "assumed, author-set, to be replaced by a quote (DEV.md 4c C210)";
          reason "air handling, ducting, terminal filters and controls per m3/h of supply air of a graded (D) oral-solid-dose room, a round figure"; }
        { hvacGrade CNC;  valuePerSupplyAir 5;  currency EUR;  year 2026;
          basis installed;  kind facility;
          source "assumed, author-set, to be replaced by a quote (DEV.md 4c C210)";
          reason "air handling and ducting per m3/h of supply air of a controlled-not-classified room (no terminal HEPA), a round figure"; }
