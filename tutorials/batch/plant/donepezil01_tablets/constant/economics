    { stream pegFeed;        price 5;      costYear 2026;
      provenance { origin "author-set assumption (DEV.md 4c C97), not a market price";
                   method "round figure (apalutamide01's)"; } }
    { stream talcFeed;       price 3;      costYear 2026;
      provenance { origin "author-set assumption (DEV.md 4c C97), not a market price";
                   method "round figure (apalutamide01's)"; } }
    { stream tio2Feed;       price 6;      costYear 2026;
      provenance { origin "author-set assumption (DEV.md 4c C97), not a market price";
                   method "round figure (apalutamide01's)"; } }
    { stream feOxFeed;       price 20;     costYear 2026;
      provenance { origin "author-set assumption (DEV.md 4c C97), not a market price";
                   method "round figure (apalutamide01's)"; } }
    { stream fbdAirIn;       price 0;      costYear 2026;
      provenance { origin "ambient air, free";
                   method "the fluid bed draws it from outside; its filtration and heating are counted elsewhere (the heater's steam)"; } }
    { stream coatingAirIn;   price 0;      costYear 2026;
      provenance { origin "ambient air, free";
                   method "the coater draws it from outside; its filtration and heating are counted elsewhere (the heater's steam)"; } }
);
