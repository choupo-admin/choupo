/*---------------------------------------------------------------------------*\
  constant/components/hydroxypropylCellulose.dat -- CASE-LOCAL record (donepezil01_tablets)

  Hydroxypropyl cellulose (hyprolose, HPC) -- the BINDER of the wet granulation.

  Listed among the core excipients of the UK Summary of Product Characteristics of ARICEPT 10 mg film coated
  tablets (Eisai Ltd, PL 10555/0007, emc, revised 13/12/2022), section 6.1 (as
  "hyprolose").  That a binder is in the core is the label's; that it is
  added as a SOLUTION in water to a high-shear granulator is this case's
  stated default (DEV.md 4c C110), not a fact read about the reference
  product.  HPC is a polydisperse substituted cellulose with no single
  molar mass and no single formula, so this record has no `formula` (the
  element balance lists it as refused, which is true) and a NOMINAL molar
  mass.  It is carried as a SOLID through the binder tank: nothing
  dissolves in this model.

  WHAT THIS RECORD IS FOR, AND WHAT IT IS NOT.  It carries what a SOLID that
  is only MOVED, MIXED, WETTED, DRIED and PRESSED needs in this plant: a
  molar mass, a particle density, a solid heat capacity and a formation
  datum to price it on.  It is never dissolved with a heat of solution,
  never melted, never reacted, never vaporised (`role nonvolatile`).  EVERY
  NUMBER BELOW EXCEPT THE MOLAR MASS OF A DEFINITE FORMULA IS AN AUTHOR-SET
  ASSUMPTION, said so in its provenance block, chosen to be of the right
  order for an organic (or mineral) powder and taken from no source --
  because none was read.  A citation invented for a round number would turn
  'unsourced' into 'falsely sourced'.
\*---------------------------------------------------------------------------*/

name        hydroxypropylCellulose;
role        nonvolatile;      // never enters the vapour; leaves every dryer as solid
MW          1000.0;   // kg/kmol -- a NOMINAL formula unit of 1 kg/mol, for bookkeeping

solid
{
    rho_p   1200.0;      // kg/m3, particle (skeletal) density -- ASSUMED
}

volatility
{
    class       nonvolatile;
    provenance  { citation "author-set: a powder handled in this plant at most at 333 K, whose vapour pressure there is taken as nil; no boiling or sublimation point was read"; status assumed; }
}

standardThermochemistry
{
    dHf_298         -1000000.0;   // J/mol -- PLACEHOLDER, see provenance
    s_298           1000.0;       // J/(mol K) -- PLACEHOLDER, see provenance
    referenceState  pureSolid;
}

solidHeatCapacity
{
    model         polynomial;
    coefficients  ( 1300.00 );   // J/(mol K) = 1.3 J/(g K) x the molar mass -- ASSUMED, constant
    Trange        ( 250  420 );
}

reviewStatus interim;      // author-set record, not read back by a curator

provenance
{
    dHf_298
    {
        origin   placeholder;
        method   "author-set round number, no source";
        uncertainty { status unquantified; reason "the formation enthalpy is a PLACEHOLDER: no reaction in this plant converts this component, so its formation enthalpy CANCELS in every unit and moves no duty and no residual.  It is here only because the energy report prices every stream on the formation surface.  Replace it with a measured or estimated datum before reusing this record in any case that reacts, dissolves with a heat of solution, or computes an exergy"; }
    }
    s_298
    {
        origin   placeholder;
        method   "author-set round number, no source";
        uncertainty { status unquantified; reason "no unit or report of this plant reads an entropy"; }
    }
    solidHeatCapacity
    {
        origin   assumed;
        method   "author-set specific heat of 1.3 J/(g K), constant, of the order of a dry powder near room temperature; no source read";
        uncertainty { status unquantified; reason "moves the sensible heat of this powder in the two dryers and in every adiabatic merge; replace it with a measured value"; }
    }
    rho_p
    {
        origin   assumed;
        method   "author-set true density, no source read";
        uncertainty { status unquantified; reason "no unit of this plant reads it (there is no spray dryer); kept so that the record is complete for a case that does -- replace it with a measured value before that"; }
    }
}

