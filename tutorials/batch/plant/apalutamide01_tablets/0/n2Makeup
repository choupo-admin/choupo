     componentMassFlows is the OVERALL material (all phases); a phases{} block, when present,
     is a decomposition that sums back to it exactly. ---*/

//  Nitrogen make-up to the drying-gas loop: 15 kg/h -- AUTHOR-SET.  With a 5 % purge the loop holds 15/0.05 = 300 kg/h of nitrogen at steady state.

componentMassFlows
{
    N2                           15 kg/h;
}

T               298.15 K;
P               1.0 bar;
phase           gas;
