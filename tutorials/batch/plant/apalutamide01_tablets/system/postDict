    (
        { unit tabletPress;  value 1000000;  currency EUR;  year 2026;
          basis installed;  kind equipment;
          scaling { referenceSize 100 kg/h;  exponent 0.6;
                    exponentSource "the six-tenths rule, a convention (Williams, Chemical Engineering 1947, cited by title only); applied to this machine as an author-set assumption"; }
          source "author-set placeholder (DEV.md 4c C98), not a quotation: the dossier found machine SIZES but no prices (docs/design/apalutamide-design-basis-dossier.md sections 4.3 and 6, question 5)";
          reason "a rotary tablet press installed in its suite, a round figure; replace with the press vendor's quotation for the chosen model and its tooling"; }
        { unit blender;  value 300000;  currency EUR;  year 2026;
          basis installed;  kind equipment;
          scaling { referenceSize 1 m3;  exponent 0.6;
                    exponentSource "the six-tenths rule, a convention (Williams, Chemical Engineering 1947, cited by title only); applied to this machine as an author-set assumption"; }
          source "author-set placeholder (DEV.md 4c C98), not a quotation: the dossier found machine SIZES but no prices (docs/design/apalutamide-design-basis-dossier.md sections 4.3 and 6, question 5)";
          reason "the intragranular bin blender and its bins, a round figure; replace with a vendor quotation"; }
        { unit rollerCompactor;  value 600000;  currency EUR;  year 2026;
          basis installed;  kind equipment;
          scaling { referenceSize 100 kg/h;  exponent 0.6;
                    exponentSource "the six-tenths rule, a convention (Williams, Chemical Engineering 1947, cited by title only); applied to this machine as an author-set assumption"; }
          source "author-set placeholder (DEV.md 4c C98), not a quotation: the dossier found machine SIZES but no prices (docs/design/apalutamide-design-basis-dossier.md sections 4.3 and 6, question 5)";
          reason "a roller compactor with its feeder, a round figure; replace with a vendor quotation"; }
        { unit mill;  value 150000;  currency EUR;  year 2026;
          basis installed;  kind equipment;
          scaling { referenceSize 100 kg/h;  exponent 0.6;
                    exponentSource "the six-tenths rule, a convention (Williams, Chemical Engineering 1947, cited by title only); applied to this machine as an author-set assumption"; }
          source "author-set placeholder (DEV.md 4c C98), not a quotation: the dossier found machine SIZES but no prices (docs/design/apalutamide-design-basis-dossier.md sections 4.3 and 6, question 5)";
          reason "the granulating mill AND the screen below it (the flowsheet's `screen` carries no quote of its own), a round figure; replace with a vendor quotation"; }
        { unit finalBlender;  value 300000;  currency EUR;  year 2026;
          basis installed;  kind equipment;
          scaling { referenceSize 1 m3;  exponent 0.6;
                    exponentSource "the six-tenths rule, a convention (Williams, Chemical Engineering 1947, cited by title only); applied to this machine as an author-set assumption"; }
          source "author-set placeholder (DEV.md 4c C98), not a quotation: the dossier found machine SIZES but no prices (docs/design/apalutamide-design-basis-dossier.md sections 4.3 and 6, question 5)";
          reason "the extragranular (final) blender, a round figure; replace with a vendor quotation"; }
        { unit coatingPan;  value 800000;  currency EUR;  year 2026;
          basis installed;  kind equipment;
          scaling { referenceSize 1 m3;  exponent 0.6;
                    exponentSource "the six-tenths rule, a convention (Williams, Chemical Engineering 1947, cited by title only); applied to this machine as an author-set assumption"; }
          source "author-set placeholder (DEV.md 4c C98), not a quotation: the dossier found machine SIZES but no prices (docs/design/apalutamide-design-basis-dossier.md sections 4.3 and 6, question 5)";
          reason "a perforated pan coater with its spray system and its air handling -- the flowsheet's `coatingDryer` is the drying half of the same machine and carries no quote of its own -- a round figure; replace with a vendor quotation"; }
        { unit packagingLine;  value 1500000;  currency EUR;  year 2026;
