economics
{
    method              discountedCashFlow;
    //  THE BUSINESS CASE (Vitor's ruling, DEV.md 4c C99 addendum): a GENERIC
    //  ENTRANT AT LOSS OF EXCLUSIVITY.  The 1:3 HPMCAS dispersion is claimed
    //  by an active Janssen patent family (US 12,303,493 B2, anticipated
    //  expiry 3 Dec 2035; the EU counterparts and SPCs NOT verified), so the
    //  plant is built to LAUNCH when exclusivity ends: year 0 of this cash
    //  flow is the end of construction = the launch, and the NPV is
    //  discounted to that year, not to today (dossier section 3.6).  The
    //  money is 2026 money throughout.
    projectLife         10;          // yr -- ASSUMED (a generic product's
                                     // market life is the groups' question)
    constructionPeriod  1;
    discountRate        0.10;        // ASSUMED
    taxRate             0.21;        // ASSUMED (a corporate rate, no country chosen)
    depreciation        straightLine;
    depreciableLife     7;           // yr -- ASSUMED
    salvageFraction     0.0;
    //  THE YEAR'S FLOWS COME FROM THE BATCH PLAN (DEV.md 4c C99).  The
    //  flowsheet is the material balance per unit of product, and the year
    //  is the plan's production Q: every annual flow is the hourly flow x
    //  Q / r_P (the "equivalent hours", printed by both passes).  The hours
    //  the trains actually RUN are in the batch plan, train by train.
    streamFactor        fromBatchPlan;
    siteFactor          0.50;
    contingencyFee      1.18;
    //  Non-particulate processing steps (Turton's operator count): the
    //  blower, the four exchangers.  The PARTICULATE steps are counted apart,
    //  in `particulateSteps` below (Turton's P, DEV.md 4c C98).
    N_np                5;
    particulateSteps
    {
        count   6;
        source  "the case's own count (DEV.md 4c C98): spray drying, blending, roller compaction, milling and screening, tableting, coating -- the final blend and packaging folded into their neighbours";
        reason  "Turton's P counts the processing steps that handle particulate solids; this plant's train is six of them.  P enters SQUARED (31.7 P^2): at P = 6 the formula staffs about 34 operators a shift.  With the crew below declared, P drives only the printed COMPARISON";
    }

    //  THE OPERATING CREW, DECLARED (DEV.md 4c C98 round 2).  The labour is
    //  priced from THIS crew, not from Turton's correlation, which is a
    //  regression over CONTINUOUS chemical plants: it grows with the number
    //  of processing steps (and with P squared), while a campaign
    //  drug-product suite is staffed ROOM BY ROOM -- one press operator runs
    //  one press whatever the plant around it.  The run prints the
    //  correlation beside this crew as a comparison.  EVERY NUMBER BELOW IS
    //  AN AUTHOR-SET ASSUMPTION: replace it with the group's own staffing
    //  plan (operators per room per shift, from the batch plan's hours, README
    //  section 2a).  The 4.5 positions per operator-per-shift the
    //  engine applies assumes round-the-clock cover; a line run on fewer
    //  shifts than that is the group's question.
    operatingCrew
    {
        areas
        (
            { area "solvent section";   operatorsPerShift 2; }  // solution prep, spray dryer, N2 loop, recovery
            { area "dispensing";        operatorsPerShift 1; }
            { area "dry granulation";   operatorsPerShift 2; }  // blending, roller compaction, milling, screening
            { area "compression";       operatorsPerShift 1; }  // the tablet press
            { area "coating";           operatorsPerShift 1; }
            { area "packaging";         operatorsPerShift 3; }
            { area "material handling"; operatorsPerShift 1; }  // containers, IPC samples, warehouse runs
        );
        source  "author-set assumption (DEV.md 4c C98 round 2), not a staffing study";
        reason  "a campaign oral-solid-dose suite is staffed per room and per running machine; the numbers are round figures of the right order for ONE line -- replace them with the group's staffing plan";
    }
    //  THE PRICE AT 2 COMPETITORS (the other end of Vitor's "2-4
    //  competitors"): the base case sells at the 4-competitor price, 4.0 EUR
    //  a tablet; the high end is 8.8 EUR a tablet, the originator's ex-factory
    //  price less the FDA's 54 % median cut at 2 generic producers
    //  (docs/design/apalutamide-design-basis-dossier.md sections 3.4 and 4.4).
    //  Both ends are per kg of `packagedTablets` (constant/economics says
    //  how).  The low end is the base itself: below 4 competitors' price is
    //  the "6+ competitors" floor, under 1 EUR, which the dossier gives only
    //  as a bound.  A SENSITIVITY, not an uncertainty analysis.
    sensitivity
    {
