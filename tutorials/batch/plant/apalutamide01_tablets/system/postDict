/*---------------------------------------------------------------------------*\
  postDict -- sizing, costing and economics of the apalutamide tablet plant.

  WHAT IS SIZED (and so costed, and placed on the plot plan): the equipment
  of the SOLUTION, SPRAY-DRYING AND SOLVENT-RECOVERY section, for which the
  engine has a sizer and the costing a correlation --

    SD                 sprayDryer   sized on its evaporation (Turton's key is
                                    the WATER evaporated; here it is acetone,
                                    whose latent heat per kg is about a fifth
                                    of water's -- the correlation is applied
                                    to a solvent it was not built for, said)
    blower             compressor   on its shaft power (1 kW: far below the
                                    correlation's range, announced on the run)
    gasHeater          shellTubeHX  A = Q/(U LMTD) against MP steam
    exhaustCooler      shellTubeHX  against cooling water
    solventCondenser   shellTubeHX  against ammonia refrigeration
    airHeater          shellTubeHX  against LP steam (the coating air)
    condensatePot      vessel       by vapour residence time
    solutionPrep       vessel       on the batch plan's volume (one lot of solution)
    coatingSuspensionPrep  vessel   on the batch plan's volume (one lot of suspension)
    acetoneTank / recoveredTank     storage, LINKED to their flowsheet units

  WHAT IS NOT SIZED, AND HOW IT REACHES THE CAPITAL ANYWAY.  The blenders,
  the roller compactor, the mill, the screen, the tablet press, the coating
  pan and the packaging line are MASS-BALANCE PLACEHOLDERS in the flowsheet
  (`mixer` / `splitter` / `solidDryer`): Choupo has no sizer and no cost
  correlation for any of them, and it does not invent one.  Neither is the GMP
  BUILDING -- clean rooms, HVAC -- which in a drug-product plant is usually
  the largest single capital item.  They enter the capital as DECLARED
  QUOTES (`costing { quotes ( ... ); }` below, DEV.md 4c C98): one price per
  item, each an AUTHOR-SET PLACEHOLDER said so on its own line, for the group
  to replace with a vendor's quotation.  NOT in the capital still: the
  warehouse and the offices/QC laboratory as quoted items (the economics'
  siteFactor term is Turton's estimate of such auxiliary facilities), vent
  treatment for the purge, dust collection, cleaning systems.  The README
  (section 6) says what is in and what is not.

  THE DESIGN BASIS is the sourced dossier docs/design/apalutamide-design-
  basis-dossier.md (DEV.md 4c C99 addendum, applied in C110 G1): the
  production, the lot and the machine rates below cite its sections; every
  number it could not find is still an AUTHOR-SET ASSUMPTION, said on its
  line, for the groups to replace.
  Rules followed: MATERIAL SS316 everywhere (product contact and an organic
  solvent; whether a non-contact item could be carbon steel is the groups'
  question); pressureDesign 2 bar (the loop runs at about 1.1 bar; a closed,
  INERTED dryer is not designed to contain a dust explosion -- that is what
  the nitrogen is for, and the README discusses it); vessels with a fully
  radiographed joint, 1.5 mm corrosion allowance and L/D 1.5, declared so
  that no engine default is used silently.
\*---------------------------------------------------------------------------*/

//  ======================== THE BATCH PLAN (DEV.md 4c C99) ==================
//  The flowsheet (system/flowsheetDict) is the MATERIAL BALANCE PER UNIT OF PRODUCT;
//  this block designs the BATCH PLANT on it (src/postProcessing/
//  BatchPlanPass.H states the method): each step's equipment is sized for
//  ONE LOT from the flowsheet's own stream masses, the lots a year follow
//  from the production, and the slowest step paces each train.  It is
//  declared ABOVE `sizing` and `costing`, because the two preparation tanks
//  take their volume from it and the solid-dose machines' quotes scale with
//  the sizes it derives.
//
//  TWO TRAINS, decoupled by the ASD store: the spray-dried dispersion is
//  HELD between the dryer and the blender (secondary drying and QC release,
//  neither modelled), so the dryer runs in CAMPAIGNS round the clock and the
//  solid-dose suite runs its own campaigns of lots on two shifts.
//
//  The production and the lot cite the design-basis dossier,
//  docs/design/apalutamide-design-basis-dossier.md ("the dossier"); every time, density and
//  fill the dossier does not give is an AUTHOR-SET ASSUMPTION of the right
//  order for a commercial oral-solid-dose line, said so in its `source`, for
//  the group to replace (README section 2a).
batchPlan
{
    product   packagedTablets;

    production
    {
        perYear  10156 kg;      // of packaged tablets: 14.0 million at 0.72546 g
        source   "docs/design/apalutamide-design-basis-dossier.md section 4.1 (derived from an estimate): 25 % of the European volume of section 3.3 (13.9 M patient-days a year = 55 M 60 mg tablets, from J&J's 2025 Erleada sales, a 53.3 % European share of International and a 75 EUR net price per patient-day)";
        reason   "a generic entrant to the European market at loss of exclusivity, the business case Vitor ruled (DEV.md 4c C99 addendum): 25 % share = 14.0 million 60 mg tablets sold a year (the dossier's 15 M is the capacity WITH a reject margin; the 1 % press rejects are in the flowsheet)";
    }

    //  The lot is counted, as an oral-solid-dose lot usually is, in kg of
    //  FINAL BLEND: 400 kg is about 571 000 tablets of 700 mg.
    lot
    {
        rule     declared;
        stream   finalBlend;
        mass     400 kg;
        source   "docs/design/apalutamide-design-basis-dossier.md section 4.3 (an estimate: the commercial batch sizes are redacted in every public document, section 1.3)";
        reason   "a 400 kg final-blend lot in a 1000-1200 L IBC blender; it carries 137 kg of dispersion, inside the dossier's 100-200 kg SDD lot (section 4.2); the lot is what QC releases, so its size is a regulatory as well as an equipment choice";
    }

    lowUtilisation  0.25;       // a stage below a quarter of its cycle is announced

    trains
    (
        {
            train           sprayDrying;
            availableTime   7920 h;     // 330 days x 24 h: the inerted loop runs round the clock
            lotsPerCampaign 7;          // the ASD of seven lots, about two weeks of drying
            changeover      48 h;       // shutdown, wash of the chamber and the loop, re-inerting
            source  "author-set assumption (DEV.md 4c C99)";
            reason  "a closed-loop solvent spray dryer is started up, inerted and run continuously for days; cleaning between campaigns, not between lots";
        }
        {
            train           solidDose;
            availableTime   3840 h;     // 2 shifts x 8 h x 5 days x 48 weeks
            lotsPerCampaign 6;
            changeover      24 h;       // a full clean of the suite and its line clearance
            source  "author-set assumption (DEV.md 4c C99)";
            reason  "a solid-dose suite on two day shifts, a product campaign of six lots between full cleans";
        }
    );

    //  In RECIPE order; each stage feeds the next of its train unless it
    //  says otherwise.  `holds` names the stream whose flowsheet mass the
    //  stage handles per lot -- the mass is READ, never typed here.
    stages
    (
        //  ---- train sprayDrying ----------------------------------------
        {
            stage  solutionPreparation;  train sprayDrying;  type batch;
            units  ( solutionPrep );     holds sprayFeed;
            bulkDensity  800 kg/m3;      // 5 wt % HPMCAS + API in acetone
            fillFraction 0.8;
            chargeTime   2 h;  processTime 2 h;  cleanTime 2 h;
            dischargeTime throughFedStage;   // the tank feeds the dryer for its whole run
            source "author-set assumption (DEV.md 4c C99); the solution density is the acetone record's, rounded up for the solids";
            reason "one tank of solution per lot, held while it feeds the dryer: it is therefore busy as long as the dryer runs (a second tank out of phase would free it -- README question)";
        }
        {
            stage  sprayDrying;  train sprayDrying;  type semicontinuous;
            units  ( SD n2Mix blower gasHeater exhaustCooler solventCondenser condensatePot purgeSplit );
            holds  asdPowder;
            chargeTime 0 h;  operatingTime fromFlowsheet;  dischargeTime 0 h;  cleanTime 0 h;
            source "the dryer's own rate, as the flowsheet models its hardware (system/flowsheetDict, unit SD)";
            reason "the dryer runs on through the lots of a campaign; it is cleaned at the campaign's changeover, not between lots";
        }

        //  ---- train solidDose --------------------------------------------
        {
            stage  blending;  train solidDose;  type batch;
            units  ( blender );  holds intraBlend;
            bulkDensity  450 kg/m3;  fillFraction 0.6;    // a bin blender at 60 % fill
            chargeTime 1 h;  processTime 0.5 h;  dischargeTime 0.5 h;  cleanTime 1 h;
            source "author-set assumption (DEV.md 4c C99), not a measured bulk density; the blender is the dossier's 1000-1200 L IBC (section 4.3), which this density and fill reproduce";
            reason "an intragranular blend in a bin blender; the bulk density is of the order of a cellulose-rich blend";
        }
        {
            stage  granulation;  train solidDose;  type semicontinuous;
            units  ( rollerCompactor mill screen );  holds ribbons;   // blend + fines
            chargeTime 0.5 h;  operatingTime 3 h;  dischargeTime 0 h;  cleanTime 1 h;
            source "docs/design/apalutamide-design-basis-dossier.md section 4.3: a production compactor rated 100-400 kg/h takes the 320 kg intragranular blend of a lot in about 1-3 h (Gerteis vendor maxima); 3 h, the slow end, is the case's choice";
            reason "a roller compactor with its mill and screen run through the lot; the throughput includes the fines it recycles";
        }
        {
            stage  finalBlending;  train solidDose;  type batch;
            units  ( finalBlender );  holds finalBlend;
            bulkDensity  500 kg/m3;  fillFraction 0.6;
            chargeTime 0.5 h;  processTime 0.25 h;  dischargeTime 0.5 h;  cleanTime 1 h;
            source "author-set assumption (DEV.md 4c C99)";
            reason "the extragranular disintegrant and the lubricant blended in for a few minutes";
        }
        {
            stage  compression;  train solidDose;  type semicontinuous;
            units  ( tabletPress );  holds finalBlend;
            feeds  coating;
            chargeTime 1.5 h;  operatingTime 4 h;  dischargeTime 0 h;  cleanTime 1 h;
            source "docs/design/apalutamide-design-basis-dossier.md section 4.3 (an estimate): a mid-size rotary press with D tooling for the 17 x 9 mm oblong runs 80 000-150 000 tablets an hour, so a lot takes 4-7 h; 4 h is the fast end; the set-up and clean times are author-set";
            reason "a rotary press set up for the lot (tooling, weight and hardness checks) and run at about 143 000 tablets an hour";
        }
        {
            stage  suspensionPreparation;  train solidDose;  type batch;
            units  ( coatingSuspensionPrep );  holds coatingSuspension;
            feeds  coating;
            bulkDensity  1150 kg/m3;  fillFraction 0.7;
            chargeTime 0.5 h;  processTime 1.5 h;  cleanTime 0.5 h;
            dischargeTime throughFedStage;   // sprayed onto the cores through the coating
            source "author-set assumption (DEV.md 4c C99); the density is of the order of a 20 wt % pigmented PVA suspension";
            reason "the coating suspension is made for each lot and sprayed while the pan coats";
        }
        {
            stage  coating;  train solidDose;  type batch;
            units  ( coatingPan coatingDryer );  holds tabletCores;
            bulkDensity  750 kg/m3;  fillFraction 0.65;   // tablet bed in a perforated pan
            chargeTime 0.5 h;  processTime 3 h;  dischargeTime 0.5 h;  cleanTime 1 h;
            source "author-set times (DEV.md 4c C99); the load is the dossier's: a perforated pan of 150-400 kg cores takes a 400 kg lot in one large load (section 4.3, an estimate)";
            reason "one lot of cores coated in one pan load to the patent's 3 % weight gain (PAT-HPMCAS Ex. 3.3)";
        }
        {
            stage  packaging;  train solidDose;  type semicontinuous;
            units  ( packagingLine );  holds packagedTablets;
            chargeTime 1 h;  operatingTime 8 h;  dischargeTime 0 h;  cleanTime 1 h;
            source "author-set assumption (DEV.md 4c C99): a packaging line's speed was NOT found (the dossier, section 4.3) -- ask a vendor";
            reason "a blister line (PVC-PCTFE/Al, wallets of 4 x 28, SmPC 6.5) set up and cleared for each lot, run at about 71 000 tablets an hour";
        }
    );
}

sizing
{
    units
    (
        //  ---- the spray dryer --------------------------------------------
        { unitName SD;  type sprayDryer;  material SS316;
          designRules { pressureDesign 2; } }

        //  ---- the loop blower ---------------------------------------------
        { unitName blower;  type compressor;  material SS316;
          designRules { pressureDesign 2; } }

        //  ---- the exchangers: A = Q/(U LMTD), LMTD computed against the
        //  utility record; every U is a gas-side film against condensing
        //  steam, water or a boiling refrigerant -- ASSUMED.
        { unitName gasHeater;  type shellTubeHX;  material SS316;
          designRules { utility steamMP;  U 40;  pressureDesign 2; } }
        { unitName exhaustCooler;  type shellTubeHX;  material SS316;
          designRules { utility coolingWater;  U 40;  pressureDesign 2; } }
        { unitName solventCondenser;  type shellTubeHX;  material SS316;
          designRules { utility refrigerationNH3;  U 60;  pressureDesign 2; } }
        { unitName airHeater;  type shellTubeHX;  material SS316;
          designRules { utility steamLP;  U 40;  pressureDesign 2; } }

        //  ---- the condensate pot: 10 s of the gas it parts the condensate
        //  from (V = Q_vapour x tau, ideal gas) -- ASSUMED; its liquid
        //  holdup is not in this basis, so the volume is a LOWER BOUND.
        { unitName condensatePot;  type vessel;  material SS316;
          designRules { residenceTime 10;  flowKey F_beta;  flowUnit kmol/s;
                        L_over_D 1.5;  pressureDesign 2;
                        corrosionAllow 0.0015;  jointEfficiency 1.0; } }

        //  ---- the two preparation tanks, sized by the BATCH PLAN ---------
        //  `volume fromBatchPlan;`: each holds one lot of its liquid, V = S B
        //  (the batch plan above: the lot, the flowsheet's masses, the
        //  declared density and fill), so the volume follows the run.
        { unitName solutionPrep;  type vessel;  material SS316;
          designRules { volume fromBatchPlan;  L_over_D 1.5;  pressureDesign 2;
                        corrosionAllow 0.0015;  jointEfficiency 1.0; } }
        { unitName coatingSuspensionPrep;  type vessel;  material SS316;
          designRules { volume fromBatchPlan;  L_over_D 1.5;  pressureDesign 2;
                        corrosionAllow 0.0015;  jointEfficiency 1.0; } }
    );

    //  ---- the two acetone tanks, LINKED to their storageTank units (the
    //  hold time has one home: system/flowsheetDict) -----------------------
    storage
    (
        { unit acetoneTank;    material SS316;  maxTankVolume 30000; }
        { unit recoveredTank;  material SS316;  maxTankVolume 30000; }
    );
}

costing
{
    method    Turton;
    year      2026;
    cepci     820;        // a projection -- AUTHOR-SET (greenAmmoniaPEQ's)
    cepci2001 397;        // the correlations' own basis year
    usdToEur  0.92;

    //  THE DECLARED QUOTES (DEV.md 4c C98).  EVERY VALUE BELOW IS AN
    //  AUTHOR-SET PLACEHOLDER -- a round number of the right order chosen so
    //  that the solid-dose train and its building are not ZERO in the
    //  capital -- and none is a vendor's price.  A group replaces each one
    //  with a dated quotation (vendor, reference, date in `source`) and says
    //  whether it is the installed price (`basis installed;`) or an
    //  ex-works price (`basis purchased;` with its own `bareModuleFactor`
    //  and `bareModuleFactorSource`).  THE MACHINES SCALE WITH THE BATCH
    //  PLAN (DEV.md 4c C99): each machine's `value` is the price of ONE
    //  machine of its `referenceSize` (a working volume for a batch stage, a
    //  throughput for a semicontinuous one), and the item costs
    //  units x value x (the stage's size per unit / referenceSize)^0.6 --
    //  so a larger lot buys larger machines.  The building does not scale.  All are in 2026 money, the costing
    //  year, so no index is applied.  `kind equipment;` is a machine: in the
    //  FCI it also drives the auxiliary-facilities estimate (siteFactor x
    //  base) like any module; `kind facility;` is the building, which does
    //  not (it IS a facility).
