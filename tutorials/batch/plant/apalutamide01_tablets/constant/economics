    { stream apiFeed;        price 7776;   costYear 2026;
      provenance { origin "docs/design/apalutamide-design-basis-dossier.md section 3.5: Pharmaoffer, Apalutamide API price and transactions, average recorded price over the 12 months to 31 May 2026, 8 452 USD/kg (an aggregator; small pre-generic lots)";
                   method "8 452 USD/kg x 0.92 EUR/USD (the case's usdToEur); a tonne-scale DMF-holder quotation was NOT found -- replace with one"; } }
