/*---------------------------------------------------------------------------*\
  thermoPhysPropDict (v2) -- one powder, pressed.

  Microcrystalline cellulose is the ONLY component: a `role nonvolatile;`
  case-local record in constant/components/ (it never enters a vapour).
  Nothing here asks a vapour-liquid question; the ideal formulation below is
  declared because a case declares its package, and it is never exercised.
\*---------------------------------------------------------------------------*/

recordType    thermophysicalPropertySystem;
schemaVersion 2;

components
(
    microcrystallineCellulose
);

equilibrium
{
    formulation gammaPhi;

    liquid
    {
        activityModel ideal;
        standardState pureLiquid;
    }

    vapour
    {
        fugacityModel idealGas;
    }
}

