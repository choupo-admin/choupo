/*---------------------------------------------------------------------------*\
  constant/components/microcrystallineCellulose.dat -- CASE-LOCAL record
  (tabletPress01_dwell_and_force), copied unchanged in its data from the
  record of tutorials/batch/plant/donepezil01_tablets.

  Microcrystalline cellulose (MCC): the placebo tablet of this case is
  pressed from it alone.  One mole of this record is one ANHYDROGLUCOSE
  repeat unit, C6H10O5.

  WHAT THIS RECORD IS FOR, AND WHAT IT IS NOT.  It carries what a solid that
  is only MOVED and PRESSED needs: a molar mass, a particle density, a solid
  heat capacity and a formation datum to price it on.  EVERY NUMBER BELOW
  EXCEPT THE MOLAR MASS OF A DEFINITE FORMULA IS AN AUTHOR-SET ASSUMPTION,
  said so in its provenance block, and taken from no source.  The press
  check does NOT read `rho_p`: its true density is declared in the press's
  own `compaction {}` block (system/postDict), with the source the
  compaction bench read it from.
\*---------------------------------------------------------------------------*/

name        microcrystallineCellulose;
formula     C6H10O5;
role        nonvolatile;      // never enters the vapour
MW          162.141;   // kg/kmol -- recomputed from the formula C6H10O5 with the standard atomic weights

solid
{
    rho_p   1550.0;      // kg/m3, particle (skeletal) density -- ASSUMED
}

volatility
{
    class       nonvolatile;
    provenance  { citation "author-set: a powder handled in this plant at most at 333 K, whose vapour pressure there is taken as nil; no boiling or sublimation point was read"; status assumed; }
}

standardThermochemistry
{
    dHf_298         -1000000.0;   // J/mol -- PLACEHOLDER, see provenance
    s_298           200.0;       // J/(mol K) -- PLACEHOLDER, see provenance
    referenceState  pureSolid;
}

solidHeatCapacity
{
    model         polynomial;
    coefficients  ( 210.78 );   // J/(mol K) = 1.3 J/(g K) x the molar mass -- ASSUMED, constant
    Trange        ( 250  420 );
}

reviewStatus interim;      // author-set record, not read back by a curator

provenance
{
    dHf_298
    {
        origin   placeholder;
        method   "author-set round number, no source";
        uncertainty { status unquantified; reason "the formation enthalpy is a PLACEHOLDER: no reaction in this plant converts this component, so its formation enthalpy CANCELS in every unit and moves no duty and no residual.  It is here only because the energy report prices every stream on the formation surface.  Replace it with a measured or estimated datum before reusing this record in any case that reacts, dissolves with a heat of solution, or computes an exergy"; }
    }
    s_298
    {
        origin   placeholder;
        method   "author-set round number, no source";
        uncertainty { status unquantified; reason "no unit or report of this plant reads an entropy"; }
    }
    solidHeatCapacity
    {
        origin   assumed;
        method   "author-set specific heat of 1.3 J/(g K), constant, of the order of a dry powder near room temperature; no source read";
        uncertainty { status unquantified; reason "no unit of this case heats or cools the powder; replace it with a measured value before reusing this record where one does"; }
    }
    rho_p
    {
        origin   assumed;
        method   "author-set true density, no source read";
        uncertainty { status unquantified; reason "no unit of this case reads it (the press check declares its own true density); kept so that the record is complete for a case that does -- replace it with a measured value before that"; }
    }
}

