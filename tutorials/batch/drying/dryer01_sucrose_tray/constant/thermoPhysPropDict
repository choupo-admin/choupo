/*---------------------------------------------------------------------------*\
  thermoPhysPropDict (v2) -- T1 ideal gamma-phi mixture.

  N2 is a component of this case even though not one mole of it sits in the
  tray: it is the DECLARED dry gas of the drying air (`air { carrier N2; }`),
  and the wet-bulb equation reads its humid heat and its molar mass from the
  catalogue.  Nothing here hardcodes "air".
\*---------------------------------------------------------------------------*/

recordType    thermophysicalPropertySystem;
schemaVersion 2;

components       ( water  sucrose  N2 );

equilibrium
{
    formulation gammaPhi;

    liquid
    {
        activityModel ideal;
        standardState pureLiquid;
    }

    vapour
    {
        fugacityModel idealGas;
    }
}
