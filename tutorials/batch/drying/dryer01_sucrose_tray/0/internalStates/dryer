/*--------------------------------*- Choupo -*----------------------------------*\
  0/internalStates/dryer -- the initial HOLDUP of 'dryer', the SINGLE
  source of truth (an inline initial{} block in flowsheetDict is refused).
  The `holdup {}` block is the vessel's starting state: T, P, V and the
  inventory (totalMoles + molarComposition, or per species as
  holdupMolar).  Every <t>/internalStates/dryer a run writes carries the
  same kind, so a time directory renamed 0/ starts the case from t.
\*-----------------------------------------------------------------------------*/

recordType  internalState;

unit        "dryer";
equipment   batchDryer;

holdup
{
    T            300.53 K;           // the tray is charged AT the wet
                                     // bulb of the declared air; the
                                     // unit does NOT integrate T (a
                                     // named gap, announced at run time)
    P            1.013 bar;          // the psychrometry is read here
    V            0.004;              // m3 -- the wet bed's bulk volume
                                     // (carried, not used by the model)
    totalMoles   0.039148458;        // kmol = 0.005842879 sucrose
                                     //      + 0.033305679 water
                                     // = 2.0 kg dry solid at X_0 = 0.30
    molarComposition  { sucrose 0.14924928;  water 0.85075072; }
}
