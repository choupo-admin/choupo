application   choupoBatch;
description   "The characteristic drying curve: one wet sucrose tray, one declared air, four falling-rate shapes -- linear, Phi^0.5, Phi^2 and a table";

verbosity     3;

// ---- Time integration ----
startTime       0;        // s
endTime         3000;     // s   (50 min: ~1030 s of constant rate, then
                          //      ~3.3 time constants of the falling-rate tail)
deltaT          2.0;      // s   (RK4 step; the falling-rate eigenvalue is
                          //      1/tau ~ 1/595 s, so this is far inside the
                          //      stability bound -- see the flowsheetDict header)
writeInterval   100;      // s
