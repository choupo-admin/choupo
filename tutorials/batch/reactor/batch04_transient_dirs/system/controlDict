application   choupoBatch;
description   "Adiabatic batch esterification with OpenFOAM-style REAL-TIME instant dirs: scrub 0/ 30/ 60/ ... s to watch conversion climb to ~0.22 while T rises only 320 -> 322 K (the runaway of the old exotherm is gone; replacement case planned)";

verbosity     3;

// ---- Time integration ----
startTime       0;        // s
endTime         600;      // s   (10 min)
deltaT          0.5;      // s
writeInterval   30;       // s   (one time directory every 30 s -> 0/ 30/ 60/ ... 600/)

// ---- solutionControl: OpenFOAM-style transient solution directories ----
//   The instant directory IS the real physical time (seconds), exactly like
//   an OpenFOAM transient case: `0/ 30/ 60/ ... 600/` appear at the case
//   root, each with the layout of 0/.  `<t>/internalStates/reactor` holds
//   the reactor's HOLDUP state at that instant --- mole inventory n_i
//   [kmol], T [K], V [m^3] + the per-unit extras (here the conversion).
//   Open `300/internalStates/reactor` and you see the reactor exactly as it
//   was at t = 300 s.  Time directories are written by DEFAULT (as OpenFOAM
//   does); `write false;` turns them off.  trajectory.csv is written either
//   way.
solutionControl
{
    write           true;
    flushEach       true;     // power-loss durable (fsync each instant)
}
