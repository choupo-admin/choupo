/*--------------------------------*- Choupo -*----------------------------------*\
  0/internalStates/dosingTank -- the initial HOLDUP of 'dosingTank': the
  5 mol of reactant B to be dosed, batch26's, held at T_p so that dosing
  into the isothermal reactor brings no sensible heat.
\*-----------------------------------------------------------------------------*/

recordType  internalState;

unit        "dosingTank";
equipment   batchAccumulator;

holdup
{
    T            330.0 K;          // T_p
    P            1.013 bar;
    V            0.00045;          // m^3 (5 mol x Vliq of B)
    totalMoles   0.005;            // kmol
    molarComposition  { reactantA 0.0;  reactantB 1.0;  productP 0.0;  solventS 0.0; }
}
