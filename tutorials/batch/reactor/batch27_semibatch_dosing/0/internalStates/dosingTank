/*--------------------------------*- Choupo -*----------------------------------*\
  0/internalStates/dosingTank -- the initial HOLDUP of 'dosingTank': the
  ethanol to be dosed, the other half of batch26's charge, held at T_p so
  that dosing brings no sensible heat.
\*-----------------------------------------------------------------------------*/

recordType  internalState;

unit        "dosingTank";
equipment   batchAccumulator;

holdup
{
    T            330.0 K;          // T_p
    P            1.013 bar;
    V            0.0005;           // m^3
    totalMoles   0.00925;          // kmol
    molarComposition  { ethanol 1.0;  aceticAcid 0.0;  ethylAcetate 0.0;  water 0.0; }
}
