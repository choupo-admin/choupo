/*--------------------------------*- Choupo -*----------------------------------*\
  0/internalStates/reactor -- the initial HOLDUP of 'reactor'.  Only the
  acetic acid is charged: half of batch26's 18.5 mol.  The other half,
  the ethanol, waits in the dosing tank.
\*-----------------------------------------------------------------------------*/

recordType  internalState;

unit        "reactor";
equipment   batchReactor;

holdup
{
    T            330.0 K;          // T_p
    P            1.013 bar;
    V            0.001;            // m^3 (held while dosing adds liquid; the rate is first order in ethanol, so V cancels from the extent rate)
    totalMoles   0.00925;          // kmol
    molarComposition  { ethanol 0.0;  aceticAcid 1.0;  ethylAcetate 0.0;  water 0.0; }
}
