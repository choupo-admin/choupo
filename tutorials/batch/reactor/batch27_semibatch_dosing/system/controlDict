/*---------------------------------------------------------------------------*\
  batch27_semibatch_dosing / system/controlDict

  WHAT THIS CASE IS: batch26's cooling failure on the SAME fictitious
  reaction, run semi-batch -- reactant B dosed in sixteen portions over
  four hours (DEV.md 4c C60).  The accumulation of unreacted B at the
  moment of failure is small, so T_cf stays low: the inherently safer remedy the
  thermal-safety methodology recommends.  A witness of the EduTool
  "Process safety" (gui/src/ui/methods/ProcessSafetyTool.tsx).

  WHAT IS MEASURED AND WHAT IS NOT: as batch26 -- the substances are
  fictitious and every property an author-set teaching assumption; nothing
  is, or could be, validated against a measured reactor.  Narrative:
  system/flowsheetDict header.
\*---------------------------------------------------------------------------*/

application   choupoBatch;
description   "Semi-batch (fictitious A + B -> P in solvent S): B dosed in 16 portions over 4 h at 330 K, the jacket fails after the last portion, the small accumulation keeps T_cf low";

verbosity     2;

// ---- Time integration ----
startTime       0;        // s
endTime         18000;    // s   (5 h: four of dosing, one to finish converting)
deltaT          0.5;      // s   (the same step as batch26)
writeInterval   50;       // s   (one trajectory row per 50 s)

//  No <t>/ time directories: the trajectory is what this case is read by,
//  and a restart from the middle of the scenario is not its question.
solutionControl
{
    write       false;
}
