/*---------------------------------------------------------------------------*\
  batch27_semibatch_dosing / system/controlDict

  WHAT THIS CASE IS: batch26's cooling failure on the SAME reaction, run
  semi-batch -- the ethanol dosed in sixteen portions over four hours
  (DEV.md 4c C60).  The accumulation of unreacted ethanol at the moment of
  failure is small, so the MTSR is low: the inherently safer remedy the
  thermal-safety methodology recommends.  A witness of the EduTool
  "Process safety" (gui/src/ui/methods/ProcessSafetyTool.tsx).

  WHAT IS MEASURED AND WHAT IS NOT: as batch26 -- the heat of reaction is
  the engine's; the kinetics are illustrative; nothing is validated
  against a measured reactor.  Narrative: system/flowsheetDict header.
\*---------------------------------------------------------------------------*/

application   choupoBatch;
description   "Semi-batch esterification: ethanol dosed in 16 portions over 4 h at 330 K, the jacket fails after the last portion, the small accumulation keeps the MTSR low";

verbosity     2;

// ---- Time integration ----
startTime       0;        // s
endTime         18000;    // s   (5 h: four of dosing, one to finish converting)
deltaT          0.5;      // s   (the same step as batch26)
writeInterval   50;       // s   (one trajectory row per 50 s)

//  No <t>/ time directories: the trajectory is what this case is read by,
//  and a restart from the middle of the scenario is not its question.
solutionControl
{
    write       false;
}
