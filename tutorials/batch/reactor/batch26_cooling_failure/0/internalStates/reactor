/*--------------------------------*- Choupo -*----------------------------------*\
  0/internalStates/reactor -- the initial HOLDUP of 'reactor', the SINGLE
  source of truth.  The whole batch is charged at t = 0, at T_p: 5 mol of
  reactant A, 5 mol of reactant B and 15 mol of the inert solvent S
  (2.25 kg; the fictitious records of constant/components/).
\*-----------------------------------------------------------------------------*/

recordType  internalState;

unit        "reactor";
equipment   batchReactor;

holdup
{
    T            330.0 K;          // T_p
    P            1.013 bar;
    V            0.0025;           // m^3 (sum of n Vliq; the rate is first order in B, so V cancels from the extent rate)
    totalMoles   0.025;            // kmol
    molarComposition  { reactantA 0.2;  reactantB 0.2;  productP 0.0;  solventS 0.6; }
}
