/*--------------------------------*- Choupo -*----------------------------------*\
  0/internalStates/cryst -- the initial HOLDUP of 'cryst', the SINGLE
  source of truth (an inline initial{} block in flowsheetDict is refused).
  The `holdup {}` block is the vessel's starting state: T, P, V and the
  inventory (totalMoles + molarComposition, or per species as
  holdupMolar).  Every <t>/internalStates/cryst a run writes carries the
  same kind, so a time directory renamed 0/ starts the case from t.
\*-----------------------------------------------------------------------------*/

recordType  internalState;

unit        "cryst";
equipment   batchCrystalliser;

holdup
{
    T            293.15 K;          // 20 C, held (isothermal)
    P            1.013 bar;
    V            1.3;               // m³ suspension volume
    totalMoles   31.40;            // kmol  (27.75 water + 3.652 sucrose)
    molarComposition  { water 0.8838;  sucrose 0.1162; }
}
