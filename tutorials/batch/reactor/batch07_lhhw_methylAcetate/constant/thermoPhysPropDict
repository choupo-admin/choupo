/*---------------------------------------------------------------------------*\
  thermoPhysPropDict (v2) -- T2 gamma-phi, UNIQUAC liquid.

  The activity model is NOT a free choice here.  A rate constant is meaningless
  without the activity model it was regressed with: Popken, Gotze & Gmehling
  fitted their kinetics on UNIQUAC activities, with the binary parameters they
  themselves regressed (Table 3, Delta u = a + b T + c T^2).  Three of the six
  pairs are in the standard catalogue under parameters/UNIQUAC/; the other three
  (aceticAcid-water, aceticAcid-methanol, methanol-water) are this case's own
  constant/parameters/UNIQUAC/, read from the same table, identical to
  cstr07's.  Until 2026-11-21 those three were DECHEMA values from another
  regression, so the rate law was evaluated on activities it was not fitted on.
\*---------------------------------------------------------------------------*/

recordType    thermophysicalPropertySystem;
schemaVersion 1;

components      ( methanol  aceticAcid  methylAcetate  water );

equilibrium
{
    formulation gammaPhi;

    liquid
    {
        activityModel { model UNIQUAC; }  // the authors' pairs (Popken Table 3)
        standardState pureLiquid;
    }

    vapour
    {
        fugacityModel idealGas;
    }
}
