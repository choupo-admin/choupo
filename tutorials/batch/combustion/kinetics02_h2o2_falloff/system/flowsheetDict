/*---------------------------------------------------------------------------*\
  kinetics02_h2o2_falloff -- the fall-off cell: a trace of H2O2 in N2 at
  1000 K and 30 bar, isothermal, followed as a first-order decay.

  The whole O Conaire 2004 H2/O2 mechanism (19 reactions, the same
  constant/reactions as ignition01_h2o2) is loaded, so everything the H2O2 and
  the OH it makes can do is in the model; the reaction under study is R15,
  H2O2 + M = 2 OH + M, a Troe fall-off.  The page that runs this case
  (EduTool `how-do-we-know-k`) rewrites T, P, the charge, the H2O2 and N2 mole
  fractions and the window; this file is the experiment at its defaults.

  THE JACOBIAN is the analytic one (the default; audited against a finite
  difference on a doubling schedule).  Until 2026-11-22 this case declared
  the finite-difference Jacobian: at the first Jacobian of a vessel holding H2O2
  alone, every radical at zero, the audit read d(n_HO2)/d(n_HO2) = -0.9618
  against -0.9665 and refused.  The analytic derivative was right; the audit's
  REFERENCE was biased -- a forward two-point difference of a rate quadratic
  in a species at zero (2 HO2, 2 OH) is off by k h, and with the audit's step
  larger than the trace parent itself the bias was O(1).  The audit now takes
  the second-order one-sided difference there (C468, Theory Guide
  sec:batch-analytic-jacobian).
\*---------------------------------------------------------------------------*/

units
(
    {
        name        bomb;
        type        batchReactor;

        operation
        {
            mode      isothermal;           // the cell is held at T
            energy    gasConstantV;         // closed fixed-V gas
        }


        solver
        {
            integrator  Rosenbrock23;       // L-stable stiff method
            verbosity   3;
        }

        reactions
        (
            R1_H_O2_O_OH  R2_O_H2_H_OH  R3_OH_H2_H_H2O
            R4_O_H2O_2OH  R5_H2_M_2H_M  R6_2O_M_O2_M
            R7_O_H_M_OH_M  R8_H_OH_M_H2O_M  R9_H_O2_M_HO2
            R10_HO2_H_H2_O2  R11_HO2_H_2OH  R12_HO2_O_OH_O2
            R13_HO2_OH_H2O_O2  R14a_2HO2_H2O2_O2  R14b_2HO2_H2O2_O2
            R15_H2O2_M_2OH  R16_H2O2_H_H2O_OH  R17_H2O2_H_H2_HO2
            R18_H2O2_O_OH_HO2  R19a_H2O2_OH_H2O_HO2  R19b_H2O2_OH_H2O_HO2
        );
    }
);
