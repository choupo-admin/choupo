/*--------------------------------*- Choupo -*-----------------------*\
  Component: Hydrogen cyanide  (HCN, CAS 74-90-8)

  Produced industrially by the Andrussow process (CH4 + NH3 + 3/2 O2 ->
  HCN + 3 H2O over Pt-Rh gauze).  Also a fuel-NOx side-product in
  combustion of N-bearing fuels (coal char).  Highly polar, strongly
  associated in the liquid phase.
  Sources: standardThermochemistry cross-checked vs NASA TM-4513
  (McBride-Gordon-Reno 1993); constants and idealGasHeatCapacity --
  individual literature values, primary re-citation pending (IST review).
\*---------------------------------------------------------------------------*/

name        HCN;
formula     HCN;
CAS         74-90-8;

MW          27.026;            // kg/kmol
Tc          456.65;             // K
Pc          53.90;              // bar
omega       0.388;              // [-]
Tb          298.85;             // K
HvapTb      25220;              // J/mol
Vliq        3.91e-5;            // m^3/mol
//  ANCHOR, never an input.  The engine DERIVES the Hildebrand
//  parameter from HvapTb and Vliq (the tree stores no derivative);
//  this is what ChemSep v8.3 computed independently, so the
//  derivation has something to be wrong against.
solubilityParameter 24810;   // Pa^0.5  [anchor, ChemSep v8.3, Artistic-2.0]


vaporPressure
{
    model         Antoine;
    // log10(Psat [bar]) = A - B / (T[K] + C)
    // CURATION FIT (2026-08-23): least-squares Antoine to the Perry 8e
    // 5-constant form over 260-330 K, max dev 0.05% (via the MIT-licensed
    // `chemicals` 1.5.2 data distribution; INTERIM pending primary review
    // (Vitor))
    coefficients  (4.65748   1330.447   -12.8);
    Trange        (260  330);
}


cosmo
{
    VT2005
    {
        model       COSMOSAC;
        variant     "2002";
        source      "VT-2005 sigma-profile database (Mullins et al., Ind. Eng. Chem. Res. 45 (2006) 4389; DFT-COSMO), file VT2005-0944-PROF.txt bundled in usnistgov/COSMOSAC; CAS 74-90-8";
        licence     externalRestricted;   // VT-2005: redistribution NOT confirmed -- values NOT shipped
        installed   false;                 // install your own copy: bin/choupo-import-cosmo (-> data/local/cosmo/VT2005/)
    }
}

reviewStatus   interim;
reviewReason   "idealGasHeatCapacity transcribed by machine from NASA/TP-2002-211556 and checked against the report itself, not yet read back against the page by a curator; the rest of this record is unchanged";
variationOf    HCN;
variationReason "the case carries the flame-range ideal-gas heat capacity (NASA-9, 200-6000 K, NASA/TP-2002-211556) that the combustion chemistry needs; the catalogue cubic stops at 1500 K.";

standardThermochemistry
{
    dHf_298    133082.460;   // J/mol  -- ideal gas; NASA/TP-2002-211556 appendix D, p. 127, entry HCN
    s_298      201.824;     // J/(mol·K) -- third-law absolute; Table B1, p. 21
}

idealGasHeatCapacity
{
    //  CASE-LOCAL OVERRIDE for flame temperatures (the catalogue Cp is a 250-1500 K process fit).
    //  NASA/TP-2002-211556 eq. (1), Cp/R = a1/T^2 + a2/T + a3 + a4 T + a5 T^2
    //  + a6 T^3 + a7 T^4; appendix D, p. 127, entry HCN, a1..a7 as printed.
    model    NASA9;
    Tlow     200;
    Tcommon  1000;
    Thigh    6000;
    low      ( 9.098286930e+04 -1.238657512e+03 8.721307870e+00 -6.528242940e-03 8.872700830e-06 -4.808886670e-09 9.317898500e-13 );
    high     ( 1.236889278e+06 -4.446732410e+03 9.738874850e+00 -5.855182640e-04 1.072791440e-07 -1.013313244e-11 3.348247980e-16 );
}

provenance
{
    dHf_298
    {
        origin        literature;
        method        "NASA/TP-2002-211556 appendix D, p. 127, entry HCN, record-line H(298.15) (elements reference, so = dHf)";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "Table B1 p. 21 prints 133.082 kJ/mol; the report's own sources: Hf: East,1993. Gurvich,1991 pt1 p226.";
    }
    s_298
    {
        origin        literature;
        method        "NASA/TP-2002-211556 Table B1, p. 21, entry HCN";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "appendix D's coefficients with b2 integrate to 201.824";
    }
    idealGasHeatCapacity
    {
        origin        literature;
        method        "NASA/TP-2002-211556 appendix D, p. 127, entry HCN, a1..a7 of the 200-1000 K and 1000-6000 K intervals, as printed";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "read by bin/curate/nasa_tp2002_to_choupo.py, which holds H and S at 298.15 K to the printed values";
    }
    source   "McBride, Zehe & Gordon, NASA Glenn Coefficients for Calculating Thermodynamic Properties of Individual Species, NASA/TP-2002-211556 (2002)";
    licence  publicDomain;    // US government work (NASA), 17 U.S.C. 105
}

