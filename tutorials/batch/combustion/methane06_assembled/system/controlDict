/*---------------------------------------------------------------------------*\
  methane06_assembled / controlDict
  + the ethane route (two CH3 recombine): the assembled mechanism.
\*---------------------------------------------------------------------------*/
application   choupoBatch;
description   "+ the ethane route (two CH3 recombine): the assembled mechanism (Petersen, Davidson & Hanson 1999, mixture 2, 1244 K, 114.4 atm)";
verbosity     3;

startTime       0.0;
endTime         1.2e-3;      // s
deltaT          2.0e-6;      // s (the integrator is adaptive; this is the write grid)
writeInterval   2.0e-6;      // s -- 600 state directories
