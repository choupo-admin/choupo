/*--------------------------------*- Choupo -*-----------------------*\
  Component: Acetylene  (C2H2, CAS 74-86-2)

  Triple bond C=C; the lightest endothermic hydrocarbon
  (dHf_298 = +228 kJ/mol).  Burns with a sooty oxy-acetylene flame
  near 3100 K --- the textbook high-T combustion species.
  Sources: ideal-gas formation properties (dHf_298, s_298) cross-checked
  against NASA TM-4513 (McBride-Gordon-Reno 1993); constants (Tc, Pc,
  omega, Tb, Antoine) are individual literature values -- primary
  re-citation pending (IST review).
\*---------------------------------------------------------------------------*/

name        acetylene;
formula     C2H2;
CAS         74-86-2;

MW          26.038;           // kg/kmol
Tc          308.30;            // K
Pc          61.40;             // bar
omega       0.190;             // [-]
Tb          188.40;            // K  (sublimation point at 1 atm; metastable liquid above 192 K)
HvapTb      16700;             // J/mol
Vliq        4.20e-5;           // m^3/mol
VliqT       188.40;      // K -- the anchor temperature of Vliq: NOT a liquid state (188.40 K is the 1 atm SUBLIMATION point, see Tb)
//  What the datum is, as far as anything in hand shows: batch vliq_datum_temperature
//  (evidence.tsv) carried a handbook liquid volume at 203.15 K down to 188.40 K with
//  Rackett and found the stored value within 0.3 % of it.  So 188.40 K is where the
//  engine's Rackett curve through this volume is anchored, an extrapolation below the
//  triple point, not a measured state.  The ThermoML archive holds NO liquid volume of
//  acetylene (searched by InChIKey, 2026-11-13: one solubility article only), so no
//  measurement in hand can place this volume on a temperature.  Kept, not changed:
//  removing it would make the engine read 42.0 cm³/mol AT 25 C (Tr 0.967), 620 kg/m³,
//  where the Rackett curve through this anchor gives 376 kg/m³.  What would settle
//  it: a measured saturated-liquid density of acetylene with its temperature.
//  ANCHOR, never an input.  The engine DERIVES the Hildebrand
//  parameter from HvapTb and Vliq (the tree stores no derivative);
//  this is what ChemSep v8.3 computed independently, so the
//  derivation has something to be wrong against.
solubilityParameter 7921;   // Pa^0.5  [anchor, ChemSep v8.3, Artistic-2.0]


vaporPressure
{
    model         Antoine;
    coefficients  (4.66248   909.79   -7.947);
    Trange        (192  308);
}


groups
{
    joback ( { group yneCH; count 2; } );
}

// Friendly-name aliases -- resolved to this file via the generated ALIASES index.
aliases ( ethyne C2H2 );

cosmo
{
    VT2005
    {
        model       COSMOSAC;
        variant     "2002";
        source      "VT-2005 sigma-profile database (Mullins et al., Ind. Eng. Chem. Res. 45 (2006) 4389; DFT-COSMO), file VT2005-0224-PROF.txt bundled in usnistgov/COSMOSAC; CAS 74-86-2";
        licence     externalRestricted;   // VT-2005: redistribution NOT confirmed -- values NOT shipped
        installed   false;                 // install your own copy: bin/choupo-import-cosmo (-> data/local/cosmo/VT2005/)
    }
}

reviewStatus   interim;
reviewReason   "idealGasHeatCapacity transcribed by machine from NASA/TP-2002-211556 and checked against the report itself, not yet read back against the page by a curator; the rest of this record is unchanged";
variationOf    acetylene;
variationReason "the case carries the flame-range ideal-gas heat capacity (NASA-9, 200-6000 K, NASA/TP-2002-211556) that the combustion chemistry needs; the catalogue cubic stops at 1500 K.";

standardThermochemistry
{
    dHf_298    228200.000;   // J/mol  -- ideal gas; NASA/TP-2002-211556 appendix D, p. 89, entry C2H2,acetylene
    s_298      200.916;     // J/(mol·K) -- third-law absolute; Table B1, p. 15
}

idealGasHeatCapacity
{
    //  CASE-LOCAL OVERRIDE for flame temperatures (the catalogue Cp is a 250-1500 K process fit).
    //  NASA/TP-2002-211556 eq. (1), Cp/R = a1/T^2 + a2/T + a3 + a4 T + a5 T^2
    //  + a6 T^3 + a7 T^4; appendix D, p. 89, entry C2H2,acetylene, a1..a7 as printed.
    model    NASA9;
    Tlow     200;
    Tcommon  1000;
    Thigh    6000;
    low      ( 1.598112089e+05 -2.216644118e+03 1.265707813e+01 -7.979651080e-03 8.054992750e-06 -2.433307673e-09 -7.529233180e-14 );
    high     ( 1.713847410e+06 -5.929106660e+03 1.236127943e+01 1.314186993e-04 -1.362764431e-07 2.712655786e-11 -1.302066204e-15 );
}

provenance
{
    dHf_298
    {
        origin        literature;
        method        "NASA/TP-2002-211556 appendix D, p. 89, entry C2H2,acetylene, record-line H(298.15) (elements reference, so = dHf)";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "Table B1 p. 15 prints 228.2 kJ/mol; the report's own sources: Hf:TRC(10/93) w-3040. Gurvich,1991 pt1 p47 pt2 p39.";
    }
    s_298
    {
        origin        literature;
        method        "NASA/TP-2002-211556 Table B1, p. 15, entry C2H2,acetylene";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "appendix D's coefficients with b2 integrate to 200.916";
    }
    idealGasHeatCapacity
    {
        origin        literature;
        method        "NASA/TP-2002-211556 appendix D, p. 89, entry C2H2,acetylene, a1..a7 of the 200-1000 K and 1000-6000 K intervals, as printed";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "read by bin/curate/nasa_tp2002_to_choupo.py, which holds H and S at 298.15 K to the printed values";
    }
    source   "McBride, Zehe & Gordon, NASA Glenn Coefficients for Calculating Thermodynamic Properties of Individual Species, NASA/TP-2002-211556 (2002)";
    licence  publicDomain;    // US government work (NASA), 17 U.S.C. 105
}

