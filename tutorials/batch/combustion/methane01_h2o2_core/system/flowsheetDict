/*---------------------------------------------------------------------------*\
  methane01_h2o2_core / flowsheetDict -- ONE adiabatic constant-volume vessel, the sets of constant/reactions.
  the H2/O2 core ALONE: methane is a spectator, nothing starts.
  Sets read: OConaire2004.
\*---------------------------------------------------------------------------*/
units
(
    {
        name        vessel;
        type        batchReactor;
        operation   { mode adiabatic; energy gasConstantV; }
        solver      { integrator Rosenbrock23; jacobian analytic; verbosity 3; }
        reactions
        (
            R1_H_O2_O_OH  R2_O_H2_H_OH  R3_OH_H2_H_H2O  R4_O_H2O_2OH  R5_H2_M_2H_M  R6_2O_M_O2_M
            R7_O_H_M_OH_M  R8_H_OH_M_H2O_M  R9_H_O2_M_HO2  R10_HO2_H_H2_O2  R11_HO2_H_2OH  R12_HO2_O_OH_O2
            R13_HO2_OH_H2O_O2  R14a_2HO2_H2O2_O2  R14b_2HO2_H2O2_O2  R15_H2O2_M_2OH  R16_H2O2_H_H2O_OH  R17_H2O2_H_H2_HO2
            R18_H2O2_O_OH_HO2  R19a_H2O2_OH_H2O_HO2  R19b_H2O2_OH_H2O_HO2
        );
    }
);
