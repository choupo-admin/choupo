/*--------------------------------*- Choupo -*-----------------------*\
  Component: Imidogen radical (chain carrier in NH3 oxidation; intermediate in thermal-NOx chemistry)
  Generated by bin/import_nasa.py from NASA-7 polynomial data
  (Burcat 2005 / JANAF).  No liquid phase at process conditions ---
  the entry is tagged `role nonvolatile;` so vapour-pressure routines
  never get called.  dHf_298 and s_298 from NASA-7 integration
  constants at T = 298.15 K.
\*---------------------------------------------------------------------------*/

name           NH;
formula        NH;
CAS            13774-92-0;

MW             15.0146;       // kg/kmol
role        nonvolatile;
tags           ( radical gasPhase combustion );

reviewStatus   interim;
reviewReason   "idealGasHeatCapacity transcribed by machine from NASA/TP-2002-211556 and checked against the report itself, not yet read back against the page by a curator; the rest of this record is unchanged";

standardThermochemistry
{
    dHf_298    356916.2396;            // J/mol  -- ideal-gas reference
    s_298      181.2234;           // J/(mol·K)  -- third-law absolute
}

idealGasHeatCapacity
{
    //  CASE-LOCAL OVERRIDE for flame temperatures: the catalogue's Cp is a
    //  process-range fit that does not reach them.
    //  NASA/TP-2002-211556 eq. (1), Cp/R = a1/T^2 + a2/T + a3 + a4 T + a5 T^2
    //  + a6 T^3 + a7 T^4; appendix D, p. 154, entry NH, a1..a7 as printed.
    //  The report's 6000-20000 K interval is not transcribed.
    model    NASA9;
    Tlow     200;
    Tcommon  1000;
    Thigh    6000;
    low      ( 1.359651320e+04 -1.900296604e+02 4.518496790e+00 -2.432776899e-03 2.377587464e-06 -2.592797084e-10 -2.659680792e-13 );
    high     ( 1.958141991e+06 -5.782861300e+03 9.335742020e+00 -2.292910311e-03 6.076092480e-07 -6.647942750e-11 2.384234783e-15 );
}

provenance
{
    idealGasHeatCapacity
    {
        origin        literature;
        method        "NASA/TP-2002-211556 appendix D, p. 154, entry NH, a1..a7 of the 200-1000 K and 1000-6000 K intervals, as printed";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "read by bin/curate/nasa_tp2002_to_choupo.py, which holds H and S at 298.15 K to the printed values";
    }
    source   "McBride, Zehe & Gordon, NASA Glenn Coefficients for Calculating Thermodynamic Properties of Individual Species, NASA/TP-2002-211556 (2002)";
    licence  publicDomain;    // US government work (NASA), 17 U.S.C. 105
}
