// [imported] origin "data/standards/components/H2O2.dat" (Choupo-2608 release) -- owned + sha256-verified by constant/propertyManifest
/*--------------------------------*- Choupo -*-----------------------*\
  Component: Hydrogen peroxide (oxidant; thermal decomposition product H2O2 -> 2 OH governs LT ignition delay)
  Ideal-gas formation data and heat capacity READ from
  NASA/TP-2002-211556 (McBride, Zehe & Gordon 2002, "NASA Glenn
  Coefficients for Calculating Thermodynamic Properties of Individual
  Species"), a US government work in the public domain: entry
  "H2O2", appendix D p. 131 (dHf_298 and the NASA-9 Cp coefficients,
  as printed) and Table B1 p. 21 (s_298).  The report's own sources
  for this species: Hf:Gurvich,1989 pt1 p127. Gurvich,1978 pt1 p121.
  Re-sourced 2026-11-01 (DEV.md 4c C170 item 4) by
  bin/curate/nasa_tp2002_to_choupo.py from the NonCommercial compilation
  this record was first generated from: the report's values
  agree with the old ones to within dHf 0.5 kJ/mol, s 0.02 J/(mol K)
  and Cp 2 % (the record's own old Trange), and replace them; not yet
  read back by a curator.
  Critical properties are individual literature values -- primary
  re-citation pending (IST review).
\*---------------------------------------------------------------------------*/

name        H2O2;
formula     H2O2;
CAS         7722-84-1;

MW          34.0147;       // kg/kmol
tags           ( radical gasPhase combustion );
reviewStatus   interim;
reviewReason   "transcribed by machine from NASA/TP-2002-211556 and checked against the report itself; not yet read back against the page by a curator";
Tc          730.15;         // K
Pc          220.0;         // bar
omega       0.358;      // [-]
Tb          423.35;         // K
HvapTb      51600;      // J/mol
Vliq        4e-05;       // m^3/mol

standardThermochemistry
{
    dHf_298    -135880.000;   // J/mol  -- ideal gas; NASA/TP-2002-211556 appendix D, p. 131, entry H2O2
    s_298      234.527;     // J/(mol·K) -- third-law absolute; Table B1, p. 21
}


vaporPressure
{
    model         Antoine;
    // log10(Psat [bar]) = A - B / (T[K] + C)
    // Landolt-Boernstein Antoine set, converted from ln/Pa to log10/bar (via
    // the MIT-licensed `chemicals` 1.5.2 data distribution; INTERIM pending
    // primary review (Vitor))
    coefficients  (5.09407   1886.760   -52.55);
    Trange        (330  446);
}

idealGasHeatCapacity
{
    //  NASA/TP-2002-211556 eq. (1), Cp/R = a1/T^2 + a2/T + a3 + a4 T + a5 T^2
    //  + a6 T^3 + a7 T^4; appendix D, p. 131, entry H2O2, a1..a7 as printed.
    model    NASA9;
    Tlow     200;
    Tcommon  1000;
    Thigh    6000;
    low      ( -9.279533580e+04 1.564748385e+03 -5.976460140e+00 3.270744520e-02 -3.932193260e-05 2.509255235e-08 -6.465045290e-12 );
    high     ( 1.489428027e+06 -5.170821780e+03 1.128204970e+01 -8.042397790e-05 -1.818383769e-08 6.947265590e-12 -4.827831900e-16 );
}

// Friendly-name aliases (resolved to this file via the generated ALIASES index).
aliases ( hydrogenPeroxide );

cosmo
{
    VT2005
    {
        model       COSMOSAC;
        variant     "2002";
        source      "VT-2005 sigma-profile database (Mullins et al., Ind. Eng. Chem. Res. 45 (2006) 4389; DFT-COSMO), file VT2005-1142-PROF.txt bundled in usnistgov/COSMOSAC; CAS 7722-84-1";
        licence     externalRestricted;   // VT-2005: redistribution NOT confirmed -- values NOT shipped
        installed   false;                 // install your own copy: bin/choupo-import-cosmo (-> data/local/cosmo/VT2005/)
    }
}

provenance
{
    dHf_298
    {
        origin        literature;
        method        "NASA/TP-2002-211556 appendix D, p. 131, entry H2O2, record-line H(298.15) (elements reference, so = dHf)";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "Table B1 p. 21 prints -135.88 kJ/mol; the report's own sources: Hf:Gurvich,1989 pt1 p127. Gurvich,1978 pt1 p121.";
    }
    s_298
    {
        origin        literature;
        method        "NASA/TP-2002-211556 Table B1, p. 21, entry H2O2";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "appendix D's coefficients with b2 integrate to 234.527";
    }
    idealGasHeatCapacity
    {
        origin        literature;
        method        "NASA/TP-2002-211556 appendix D, p. 131, entry H2O2, a1..a7 of the 200-1000 K and 1000-6000 K intervals, as printed";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "read by bin/curate/nasa_tp2002_to_choupo.py, which holds H and S at 298.15 K to the printed values";
    }
    source   "McBride, Zehe & Gordon, NASA Glenn Coefficients for Calculating Thermodynamic Properties of Individual Species, NASA/TP-2002-211556 (2002)";
    licence  publicDomain;    // US government work (NASA), 17 U.S.C. 105
}
