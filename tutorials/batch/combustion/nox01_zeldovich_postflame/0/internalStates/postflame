/*--------------------------------*- Choupo -*----------------------------------*\
  0/internalStates/postflame -- the initial HOLDUP of 'postflame', the SINGLE
  source of truth (an inline initial{} block in flowsheetDict is refused).
  The `holdup {}` block is the vessel's starting state: T, P, V and the
  inventory (totalMoles + molarComposition, or per species as
  holdupMolar).  Every <t>/internalStates/postflame a run writes carries the
  same kind, so a time directory renamed 0/ starts the case from t.
\*-----------------------------------------------------------------------------*/

recordType  internalState;

unit        "postflame";
equipment   batchReactor;

holdup
{
    T            2125.0 K;
    P            1.0 atm;
    V            0.001;
    totalMoles   5.7e-6;             // PV/RT at 2125 K, 1 atm
    // The BURNT-GAS EQUILIBRIUM pool at 2125 K/1 atm (computed with
    // this same thermo by a gibbsReactor over the 14 species; the
    // scratch case is reproduced in the README), with the nitrogen
    // species zeroed and their equilibrium NO share returned to
    // N2/O2 elementally (NO_eq/2 each).
    molarComposition
    {
        H2     0.000849;
        O2     0.056418;
        N2     0.656101;
        water  0.282572;
        H      0.000105;
        O      0.000380;
        OH     0.003571;
        HO2    0.0000028;
        H2O2   0.0000002;
        NO     0.0;
        N      0.0;
        N2O    0.0;
        NNH    0.0;
        NH     0.0;
    }
}
