/*--------------------------------*- Choupo -*-----------------------*\
  Component: Nitrogen dioxide  (NO2, CAS 10102-44-0)

  Combustion-NOx tail end (NO is the kinetic product of the Zeldovich
  chain; NO2 forms downstream by NO + O / NO + HO2).  The
  NO + 1/2 O2 <-> NO2 equilibrium peaks at low T --- a GibbsReactor
  cooled from 1500 K to 800 K traces the NO -> NO2 conversion neatly.
  Sources: ideal-gas formation enthalpy/entropy cross-checked against the
  NASA polynomial database (NASA TM-4513, public domain).  Critical
  constants are individual literature values -- primary re-citation
  pending (IST review).
\*---------------------------------------------------------------------------*/

name        NO2;
formula     NO2;
CAS         10102-44-0;

MW          46.006;            // kg/kmol
Tc          431.00;             // K
Pc          101.00;             // bar
omega       0.834;              // [-]   (very polar; dimerizes to N2O4)
Tb          294.30;             // K
HvapTb      14730;              // J/mol
Vliq        3.79e-5;            // m^3/mol
//  ANCHOR, never an input.  The engine DERIVES the Hildebrand
//  parameter from HvapTb and Vliq (the tree stores no derivative);
//  this is what ChemSep v8.3 computed independently, so the
//  derivation has something to be wrong against.
solubilityParameter 33390;   // Pa^0.5  [anchor, ChemSep v8.3, Artistic-2.0]


vaporPressure
{
    model         Antoine;
    coefficients  (4.04275   1099.500   -34.000);
    Trange        (250  294);
}

reviewStatus   interim;
reviewReason   "idealGasHeatCapacity transcribed by machine from NASA/TP-2002-211556 and checked against the report itself, not yet read back against the page by a curator; the rest of this record is unchanged";
variationOf    NO2;
variationReason "the case carries the flame-range ideal-gas heat capacity (NASA-9, 200-6000 K, NASA/TP-2002-211556) that the combustion chemistry needs; the catalogue cubic stops at 1500 K.";

standardThermochemistry
{
    dHf_298    34193.019;   // J/mol  -- ideal gas; NASA/TP-2002-211556 appendix D, p. 155, entry NO2
    s_298      240.171;     // J/(mol·K) -- third-law absolute; Table B1, p. 24
}

idealGasHeatCapacity
{
    //  CASE-LOCAL OVERRIDE for flame temperatures (the catalogue Cp is a 250-1500 K process fit).
    //  NASA/TP-2002-211556 eq. (1), Cp/R = a1/T^2 + a2/T + a3 + a4 T + a5 T^2
    //  + a6 T^3 + a7 T^4; appendix D, p. 155, entry NO2, a1..a7 as printed.
    model    NASA9;
    Tlow     200;
    Tcommon  1000;
    Thigh    6000;
    low      ( -5.642038780e+04 9.633085720e+02 -2.434510974e+00 1.927760886e-02 -1.874559328e-05 9.145497730e-09 -1.777647635e-12 );
    high     ( 7.213001570e+05 -3.832615200e+03 1.113963285e+01 -2.238062246e-03 6.547723430e-07 -7.611335900e-11 3.328361050e-15 );
}

provenance
{
    dHf_298
    {
        origin        literature;
        method        "NASA/TP-2002-211556 appendix D, p. 155, entry NO2, record-line H(298.15) (elements reference, so = dHf)";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "Table B1 p. 24 prints 34.193 kJ/mol; the report's own sources: Gurvich,1989 pt1 p332 pt2 p207.";
    }
    s_298
    {
        origin        literature;
        method        "NASA/TP-2002-211556 Table B1, p. 24, entry NO2";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "appendix D's coefficients with b2 integrate to 240.171";
    }
    idealGasHeatCapacity
    {
        origin        literature;
        method        "NASA/TP-2002-211556 appendix D, p. 155, entry NO2, a1..a7 of the 200-1000 K and 1000-6000 K intervals, as printed";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "read by bin/curate/nasa_tp2002_to_choupo.py, which holds H and S at 298.15 K to the printed values";
    }
    source   "McBride, Zehe & Gordon, NASA Glenn Coefficients for Calculating Thermodynamic Properties of Individual Species, NASA/TP-2002-211556 (2002)";
    licence  publicDomain;    // US government work (NASA), 17 U.S.C. 105
}

