/*---------------------------------------------------------------------------*\
  nox02_millerbowman_denox / postDict -- the REFERENCE DATA for the case's
  temperature-window figure (DEV.md 4c C477).

  The question the figure will answer: "In which temperature window does NH3
  remove NO?" -- final NOx [ppm] against vessel temperature [K], the 17
  vessels of the case, with the paper's own model curve and the Lyon & Hardy
  flow-reactor points over it.  This file declares only the two reference
  series (Fig. 57, p. 313, of Miller & Bowman 1989, digitised from the page
  image -- see each CSV's header and the README); the view itself waits for
  choupoBatch to publish a batch run's views.  Grammar:
  docs/design/a-post-processing-dictionary.md.
\*---------------------------------------------------------------------------*/

references
(
    {
        name      mbFig57Model;
        file      "constant/reference/mb1989_fig57_model.csv";
        role      reference;
        citation  "Miller & Bowman, Prog. Energy Combust. Sci. 15 (1989) 287-338, doi:10.1016/0360-1285(89)90017-8, Fig. 57 (p. 313): the authors' model curve (Appendix B), data set 1, digitised from the page image, +-3 ppm";
        units     { T_K "K"; NOx_ppm "ppm"; }
    }
    {
        name      lyonHardyDataSet1;
        file      "constant/reference/mb1989_fig57_lyonHardy.csv";
        role      experiment;
        citation  "Lyon & Hardy flow-reactor data, data set 1, as plotted in Fig. 57 (p. 313) of Miller & Bowman, Prog. Energy Combust. Sci. 15 (1989) 287-338, doi:10.1016/0360-1285(89)90017-8, digitised from the page image, +-3 ppm, +-5 K";
        units     { T_K "K"; NOx_ppm "ppm"; }
    }
);
