/*---------------------------------------------------------------------------*\
  methane07_sensitivity / flowsheetDict -- ONE adiabatic constant-volume vessel, the sets of constant/reactions.
  the assembled mechanism with the sensitivity of the ignition delay to every reaction.
  Sets read: OConaire2004, MillerBowman1989.
\*---------------------------------------------------------------------------*/
units
(
    {
        name        vessel;
        type        batchReactor;
        operation   { mode adiabatic; energy gasConstantV; }
        solver      { integrator Rosenbrock23; jacobian analytic; verbosity 3; }
        sensitivity
        {
            response    tauIgnition;    // time T first exceeds T0 + rise
            factor      1.1;            // k_j -> 1.1 k_j, one reaction at a time (forward and reverse)
            reactions   all;
            top         8;
        }
        reactions
        (
            R1_H_O2_O_OH  R2_O_H2_H_OH  R3_OH_H2_H_H2O  R4_O_H2O_2OH  R5_H2_M_2H_M  R6_2O_M_O2_M
            R7_O_H_M_OH_M  R8_H_OH_M_H2O_M  R9_H_O2_M_HO2  R10_HO2_H_H2_O2  R11_HO2_H_2OH  R12_HO2_O_OH_O2
            R13_HO2_OH_H2O_O2  R14a_2HO2_H2O2_O2  R14b_2HO2_H2O2_O2  R15_H2O2_M_2OH  R16_H2O2_H_H2O_OH  R17_H2O2_H_H2_HO2
            R18_H2O2_O_OH_HO2  R19a_H2O2_OH_H2O_HO2  R19b_H2O2_OH_H2O_HO2  A1  A2  A3
            A4  A5  A5a  A6  A7  A8
            A9  A11  A12  A13  A14  A16
            A18  A20  A22  A26  A42  A44
            A46  A47  A48  A49  A50  A51
            A52  A53  A54  A55  A56  A57
            A58  A59  A60  A61  A62  A63
            A64  A65  A66  A67  A68  A74
            A75
        );
    }
);
