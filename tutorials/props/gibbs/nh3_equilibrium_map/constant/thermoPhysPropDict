/*---------------------------------------------------------------------------*\
  thermoPhysPropDict (v2) -- T1 ideal gamma-phi mixture.
  Raoult DECLARED, not defaulted (gamma = 1 identically).
  Migrated mechanically from the v1 flat form (physics identical);
  v2 contract 2026-07-17.

  C256 (2026-11-09), MEASURED: N2, H2 and NH3 are priced above their critical
  temperatures in this run (Psat continued past Tc), but the Gibbs map is a
  one-gas-phase equilibrium over (T, P): no liquid is priced and no K is
  printed, so no printed number depends on that K.
\*---------------------------------------------------------------------------*/

recordType    thermophysicalPropertySystem;
schemaVersion 2;

components ( N2 H2 NH3 );

equilibrium
{
    formulation gammaPhi;

    liquid
    {
        activityModel ideal;
        standardState pureLiquid;
    }

    vapour
    {
        fugacityModel idealGas;
    }
}
