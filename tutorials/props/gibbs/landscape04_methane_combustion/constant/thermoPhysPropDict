/*---------------------------------------------------------------------------*\
  thermoPhysPropDict (v2) -- T1 ideal gamma-phi mixture, Raoult DECLARED,
  not defaulted (gamma = 1 identically), `fugacityModel idealGas`.

  IDEAL GAS ON PURPOSE.  The `gibbsMap` kernel is the element-potential
  method (src/unitOperations/reactor/gibbsMethod/ElementPotential.cpp), whose
  standard-state term is g_pure_ig(T + dT)/RT with NO fugacity coefficient,
  so this declaration is the one the map actually honours.  The EduTool
  `equilibrium-landscapes` that reads this case says so on its own page: a
  landscape drawn at 100 bar is the equilibrium SHAPE, never a real-gas
  prediction (the 200 bar SRK answer lives in gibbs10_ammonia_fugacity).
\*---------------------------------------------------------------------------*/

recordType    thermophysicalPropertySystem;
schemaVersion 2;

components ( CH4 O2 N2 CO CO2 water H2 );

equilibrium
{
    formulation gammaPhi;

    liquid
    {
        activityModel ideal;
        standardState pureLiquid;
    }

    vapour
    {
        fugacityModel idealGas;
    }
}
