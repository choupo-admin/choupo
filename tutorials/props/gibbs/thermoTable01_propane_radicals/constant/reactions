/*---------------------------------------------------------------------------*\
  Four elementary steps of propane pyrolysis, stoichiometry only --
  `reactionGibbs` prices each on the species' formation data.
\*---------------------------------------------------------------------------*/

primaryCH           // C3H8 -> n-C3H7 + H
{
    stoichiometry
    (
        { component propane;      nu -1; }
        { component C3H7_npropyl; nu  1; }
        { component H;            nu  1; }
    );
}

secondaryCH         // C3H8 -> i-C3H7 + H
{
    stoichiometry
    (
        { component propane;      nu -1; }
        { component C3H7_ipropyl; nu  1; }
        { component H;            nu  1; }
    );
}

betaScission        // n-C3H7 -> C2H4 + CH3
{
    stoichiometry
    (
        { component C3H7_npropyl; nu -1; }
        { component ethylene;     nu  1; }
        { component CH3;          nu  1; }
    );
}

isomerisation       // n-C3H7 -> i-C3H7
{
    stoichiometry
    (
        { component C3H7_npropyl; nu -1; }
        { component C3H7_ipropyl; nu  1; }
    );
}
