/*---------------------------------------------------------------------------*\
  The first witness of a DECLARED species table (Vitor's architecture
  decision of 2026-11-19).  The four radicals -- n-propyl, iso-propyl, H
  and CH3 -- are not components (a radical is NOT a component, DEV.md 4c
  C458, 2026-11-21); they are read from
  data/standards/thermoTables/NASA-TP-2002-211556/ because this system
  declares that table, each under the report's entry name (C3H7,n-propyl ->
  C3H7_npropyl).  propane and ethylene come from components/ -- a table
  never shadows a curated record.

  What the four reactions show, at 298.15 K, from the records' own dHf_298:
    primary C-H bond     propane -> C3H7_npropyl + H     dH = +423.199 kJ/mol
    secondary C-H bond   propane -> C3H7_ipropyl + H     dH = +415.999 kJ/mol
    beta-scission        C3H7_npropyl -> ethylene + CH3  dH =  +98.438 kJ/mol
    isomerisation        C3H7_npropyl -> C3H7_ipropyl    dH =   -7.200 kJ/mol
  (hand arithmetic on the printed formation enthalpies; the golden holds the
  engine to them).  The secondary bond is weaker by 7.2 kJ/mol, which is why
  a propane cracker makes iso-propyl radicals faster than n-propyl ones per
  hydrogen, and n-propyl's beta-scission is the step that yields ethylene.
  NOT validated against a measured bond energy: the numbers are the NASA
  report's, read through the engine.
\*---------------------------------------------------------------------------*/

recordType    thermophysicalPropertySystem;
schemaVersion 1;

components ( propane C3H7_npropyl C3H7_ipropyl H CH3 ethylene );

//  The species-table home this system may resolve a component from when
//  components/ has none of that name (data/standards/thermoTables/).
speciesTables ( NASA-TP-2002-211556 );

equilibrium
{
    formulation gammaPhi;
    liquid
    {
        activityModel ideal;
        standardState pureLiquid;
    }
    vapour
    {
        fugacityModel idealGas;
    }
}
