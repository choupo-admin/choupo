    { name acid_1p0; type speciate; analyticalTotals { Cl 0.001000 mol/kg; HCO3 $C_T; } totalsBasis stoichiometric; pH solve; temperature $T; diagSpecies ( CO2aq HCO3 CO3 ); output { file acid_1p0.csv; } }
