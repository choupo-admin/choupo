/*---------------------------------------------------------------------------*\
  The aqueous surface this bench compares FROM: Davies on the molality
  basis is the case default; half the operations OVERRIDE it per-op with
  `activityModel pitzerHMW;` -- the comparison IS the case, so the model
  name appears in the op (the experiment's subject), exactly the second
  legal home the three-places rule allows.
\*---------------------------------------------------------------------------*/
recordType    thermophysicalPropertySystem;
schemaVersion 2;
components ( water NaCl );
aqueousProperties
{
    activityCoefficients
    {
        model          Davies;
        referenceBasis aqueousMolality;
    }
}
