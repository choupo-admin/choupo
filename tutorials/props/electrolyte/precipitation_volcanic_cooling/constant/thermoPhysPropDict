/*---------------------------------------------------------------------------*\
  thermoPhysPropDict (v2) -- the aqueous activity surface of the volcanic
  water: ionic activities from Davies on the molality basis.  The analysis
  lives in the operations; species, reactions and minerals in the curated
  chemistry tree.
\*---------------------------------------------------------------------------*/

recordType    thermophysicalPropertySystem;
schemaVersion 2;

components ( water );

aqueousProperties
{
    activityCoefficients
    {
        model          Davies;
        referenceBasis aqueousMolality;
    }
}
