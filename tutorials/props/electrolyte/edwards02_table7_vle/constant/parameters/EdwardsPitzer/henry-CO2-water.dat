// [imported] origin "data/standards/parameters/EdwardsPitzer/henry-CO2-water.dat" (Choupo-2607 release) -- owned + sha256-verified by constant/propertyManifest
/*--------------------------------*- Choupo -*--------------------------------*\
  Henry's constant for CO2 in water -- the EDWARDS (1978) parameterisation.

  THIS IS NOT A REPLACEMENT for parameters/Henry/CO2-water.dat, which
  carries the Sander-Hxp-v1 parameterisation of the same physical pair.  The
  D2 identity contract (ADR 2026-07-26) makes a PARAMETERISATION the unit of
  identity: the two records coexist, each naming its own convention, and a
  case selects one.  Neither is "the" Henry constant for CO2.

  They are not interconvertible by a units factor alone.  Edwards' H is
  MOLAL (kg-atm/mol), referenced to the saturation pressure of water rather
  than 1 atm, and rides an UNSYMMETRIC gamma* from Eq 8 -- so it is only
  meaningful alongside `activityModel edwardsPitzer`.  Mixing it with a
  Davies or Sander calculation silently mismatches the standard state.

  Eq 13:  ln H = B1/T + B2 ln T + B3 T + B4     [kg-atm/mol], T in KELVIN.
  Eq 11 carries it to the system pressure (Krichevsky-Kasarnovsky) using the
  infinite-dilution partial molar volume of Table 2:
      32.4 (0 C), 34.0 (50 C), 38.3 (100 C), 45.6 (150 C)  cm3/mol
\*-----------------------------------------------------------------------------*/
solute      CO2;
solvent     water;

gasSpecies        CO2;
dissolvedSpecies  CO2;
convention        Edwards-Hkgatm-v1;

model       EdwardsEq13;
parameters
{
    B1  -6789.04;
    B2  -11.4519;
    B3  -0.010454;
    B4  94.4914;
}

Trange ( 273.15 523.15 );   // 0-250 degC, the paper's stated range

//  Table 2: infinite-dilution partial molar volume, for the Krichevsky-
//  Kasarnovsky pressure correction (Eq 11).  Parsed data, not a header
//  comment -- a field the engine cannot see is a comment (2026-08-05 rule).
//  Table 2 stops at 150 degC; beyond it Eq 11 rides the clamped end value,
//  inside the Trange-extrapolation announcement the consumer already makes.
vInfinity
{
    units  "cm3/mol";
    points
    (
        { T 273.15; value 32.4; }
        { T 323.15; value 34.0; }
        { T 373.15; value 38.3; }
        { T 423.15; value 45.6; }
    );
    source "Edwards, Maurer, Newman & Prausnitz, AIChE J. 24(6):966-976 (1978), Table 2";
}

source "Edwards, Maurer, Newman & Prausnitz, AIChE J. 24(6):966-976 (1978), Table 3";
