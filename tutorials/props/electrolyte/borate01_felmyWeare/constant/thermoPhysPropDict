/*---------------------------------------------------------------------------*\
  thermoPhysPropDict (v2) -- the aqueous activity SURFACE of the borate case:
  ionic activities from Pitzer-HMW on the molality basis, with the borate
  terms of Felmy & Weare (1986) (every record names its table and page).
\*---------------------------------------------------------------------------*/

recordType    thermophysicalPropertySystem;
schemaVersion 2;

components ( water );

aqueousProperties
{
    activityCoefficients
    {
        model          PitzerHMW;
        referenceBasis aqueousMolality;
    }
}
