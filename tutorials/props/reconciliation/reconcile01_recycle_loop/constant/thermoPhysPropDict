/*---------------------------------------------------------------------------*\
  thermoPhysPropDict (v2) -- a placeholder system, read by NOTHING here.

  choupoProps starts from a thermophysical system, and every operation is
  handed one.  The data reconciliation of this case is mass-balance
  algebra on measured flows: no property of any substance enters it.  The
  one-component ideal system below exists only because the binary needs a
  system to start; the dataReconciliation op never reads it.
\*---------------------------------------------------------------------------*/

recordType    thermophysicalPropertySystem;
schemaVersion 2;

components ( water );

equilibrium
{
    formulation gammaPhi;

    liquid
    {
        activityModel ideal;
        standardState pureLiquid;
    }

    vapour
    {
        fugacityModel idealGas;
    }
}
