/*---------------------------------------------------------------------------*\
  evidence01_methanol_water_points -- the thermophysical system.

  gamma-phi at low pressure, the FRAME every residual in this case is
  conditional on: ideal-gas vapour, the catalogue's own Antoine records for
  both pure components, and a liquid activity model each operation
  overrides for itself (ideal / UNIFAC / the catalogue NRTL pair, which
  auto-resolves by name from data/standards/parameters/NRTL/).
\*---------------------------------------------------------------------------*/

recordType    thermophysicalPropertySystem;
schemaVersion 2;

components       ( methanol  water );

equilibrium
{
    formulation gammaPhi;

    liquid
    {
        activityModel ideal;
        standardState pureLiquid;
    }

    vapour
    {
        fugacityModel idealGas;
    }
}
