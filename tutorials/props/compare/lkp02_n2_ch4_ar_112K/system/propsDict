experimental
(
    {
        name      miller1973_n2_ch4;
        component N2;
        kind      pxy;
        models    ( pxy_n2_ch4 );
        dataset   "constant/experiments/N2-CH4-miller1973-112K.dat";
        source    "Miller, Kidnay & Hiza, AIChE J. 19 (1973) 145, Table 2 (p. 147) -- measured, 112.00 K";
    }
    {
        name      miller1973_n2_ar;
        component N2;
        kind      pxy;
        models    ( pxy_n2_ar );
        dataset   "constant/experiments/N2-Ar-miller1973-112K.dat";
        source    "Miller, Kidnay & Hiza, AIChE J. 19 (1973) 145, Table 1 (p. 146) -- measured, 112.00 K";
    }
);
