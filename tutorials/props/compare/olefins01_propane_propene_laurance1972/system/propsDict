/*---------------------------------------------------------------------------*\
  olefins01_propane_propene_laurance1972 -- the C3 splitter's thermodynamics,
  held to measured VLE.  README.md carries the question, the band DECLARED
  BEFORE the first run, the table of results and what is NOT claimed.

  Each operation asks the engine at the liquid composition the experimenters
  tabulated (x = 0.1 ... 0.9 of propene, never a smooth curve between
  neighbours): P_bubble(T, x) and the incipient vapour y_eqT(T, x), once with
  SRK and once with Peng-Robinson (variant `pr`), kij = 0.  The relative
  volatility alpha = (y1/x1)/(y2/x2) is NOT a property of the bench; the gate
  bin/curate/check_olefin_vle.py recomputes it from the y of these runs and
  compares it with the paper's alpha point by point, against the declared band.
\*---------------------------------------------------------------------------*/

operations
(
    {
        name        pxy_srk_100F;
        type        propertyScan1D;
        vary        { variable x[propylene];  points ( 0.1000 0.2000 0.3000 0.4000 0.5000 0.6000 0.7000 0.8000 0.9000 ); }
        state       { T 310.9278 K;  P 15 bar;  composition { propylene 0.5;  propane 0.5; } }
        properties  ( P_bubble  y_eqT_propylene );
        output      { file pxy_srk_100F.csv; }
    }
