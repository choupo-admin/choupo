/*---------------------------------------------------------------------------*\
  compare_activity_etoh_water
  ===========================

  COMPARE 3 activity-coefficient models for γ_ethanol in an equimolar
  ethanol/water mixture, T = 280 K to 360 K, P = 1 bar (as all three ops
  below declare; this line said 1 atm, which is 1.01325 bar).

    * ideal  : γ = 1 always (Raoult's law assumption).
    * NRTL   : strong non-ideality, γ_ethanol > 1 (azeotrope behaviour).
    * Wilson : similar to NRTL for this binary, slightly different curve.

  Pedagogical point: a student studying ethanol/water VLE will see that
  "ideal" is a bad approximation here (γ_ethanol reaches 1.267 under NRTL
  and 1.377 under Wilson at 280 K, the coldest and most non-ideal end of
  this scan, against exactly 1 for ideal), 
  and that NRTL/Wilson give similar non-ideal corrections.  The choice
  between the two is then decided by which fits the project's
  experimental data better (workflow Mode B, see tutorials/props/README.md).

  Each op overrides the global activityModel block via `thermo {}`.  The
  three CSVs (gamma_ideal.csv, gamma_nrtl.csv, gamma_wilson.csv) are
  auto-overlaid by the GUI.
\*---------------------------------------------------------------------------*/

operations
(
    {
        name        g_ideal;
        type        propertyScan1D;
        vary        { variable T;  from 280 K;  to 360 K;  n 41; }
        state       { P 1 bar;  composition { ethanol 0.5;  water 0.5; } }
        thermo
        {
            equilibrium { liquid { activityModel { model ideal; } } }
        }
        properties  ( gamma_ethanol );
        output      { file gamma_ideal.csv; }
    }
    {
        name        g_nrtl;
        type        propertyScan1D;
        vary        { variable T;  from 280 K;  to 360 K;  n 41; }
        state       { P 1 bar;  composition { ethanol 0.5;  water 0.5; } }
        thermo
        {
            equilibrium { liquid { activityModel
            {
                model NRTL;
                binaryParameters
            {
                ethanol-water { }
            }
            } } }
        }
        properties  ( gamma_ethanol );
        output      { file gamma_nrtl.csv; }
    }
    {
        name        g_wilson;
        type        propertyScan1D;
        vary        { variable T;  from 280 K;  to 360 K;  n 41; }
        state       { P 1 bar;  composition { ethanol 0.5;  water 0.5; } }
        thermo
        {
            equilibrium { liquid { activityModel
            {
                model Wilson;
                binaryParameters
            {
                // A_ij / A_ji in J/mol (DECHEMA)
                ethanol-water { }
            }
            } } }
        }
        properties  ( gamma_ethanol );
        output      { file gamma_wilson.csv; }
    }
);

/*---------------------------------------------------------------------------*\
  THE VIEW THE LESSON OPENS ON (DEV.md 4c C443).

  The lesson: three activity models for ethanol in an equimolar ethanol-water mixture: ideal (gamma = 1), NRTL and Wilson; the ideal assumption is bad here and the two real models agree with each other far better than with it.

  The plot: gamma of ethanol against temperature, the three models as three curves on one axis.

  Declared over what the operations already publish; it computes nothing.
\*---------------------------------------------------------------------------*/

views
(
    {
        name    gamma_ethanol_three_models;
        type    series;
        title   "The ideal assumption against NRTL and Wilson: gamma of ethanol against temperature";
        xAxis   { label "temperature"; unit "K"; scale linear; }
        yAxis   { label "activity coefficient of ethanol"; unit "-"; scale linear; }
        note    "Equimolar ethanol-water at 1 bar from 280 K to 360 K. Ideal is gamma = 1 by definition; NRTL and Wilson are both well above it and close to each other, the gap widening at the cold end.";
        series
        (
            { name ideal;  label "ideal";  op g_ideal;  table scan; x T; y gamma_ethanol; style lines; }
            { name nrtl;   label "NRTL";   op g_nrtl;   table scan; x T; y gamma_ethanol; style lines; }
            { name wilson; label "Wilson"; op g_wilson; table scan; x T; y gamma_ethanol; style lines; }
        );
    }
);
