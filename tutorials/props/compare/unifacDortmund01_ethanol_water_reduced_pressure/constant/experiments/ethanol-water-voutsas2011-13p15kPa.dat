/*--------------------------------------------------------------------------*\
  MEASURED isobaric vapour-liquid equilibrium of ethanol(1) + water(2) at 13.15 kPa.

  SOURCE (the page, not an archive): Voutsas, E.C.; Pamouktsis, C.; Argyris, D.;
  Pappa, G.D. "Measurements and thermodynamic modeling of the ethanol-water
  system with emphasis to the azeotropic region", Fluid Phase Equilibria 308
  (2011) 135-141, doi:10.1016/j.fluid.2011.06.009, Table 1 (p. 137): T, x1, y1
  at 13.15, 19.71 and 32.86 kPa.  Read from the page's own text layer (a
  born-digital PDF); 15 interior points are kept, in the paper's own order.
  The pure-component endpoints (x1 = 0 and 1) are set aside: a bubble point on a
  pure fluid measures the vapour-pressure record, not the mixture model.

  These data were measured in 2011; the Dortmund fit (Gmehling, Li & Schiller
  1993) and the original UNIFAC (Hansen 1991) cannot have used them, so the
  comparison is OUT OF SAMPLE for both models.

  Columns are the props bench's overlay names: x[ethanol], T_bubble, y_eq_ethanol.
\*--------------------------------------------------------------------------*/

property     binaryVLE.T_bubble;
system       ( ethanol water );
pressure     13.15 kPa;

provenance
{
    source       measured;
    reviewStatus transcribedNotCheckedAgainstArticle;
    citation     "Voutsas, Pamouktsis, Argyris & Pappa, Fluid Phase Equilib. 308 (2011) 135-141, Table 1 (p. 137), doi:10.1016/j.fluid.2011.06.009";
    doi          "10.1016/j.fluid.2011.06.009";
    sourceFile   "voutsas2011-ethanol-water-azeotrope-vle.pdf";   // the article read, Table 1 on its page 3 (journal p. 137)
    sha256       "184e43cd36bc45de664ec7a86ea54a064343f62f6cec26355c461cd51422eebc";   // of that PDF: the source file this transcription was read from, not of the data block
}

selection
{
    pureEndpoints
    (
        { x 0; T_bubble 324.53 K; }
        { x 1; T_bubble 307.46 K; }
    );
}

columns
(
    { name x[ethanol];  unit -;  }
    { name T_bubble;  unit K;  }
    { name y_eq_ethanol;  unit -;  }
);

data
(
    0.117  313.71  0.461
    0.241  310.70  0.567
    0.383  309.53  0.632
    0.492  308.82  0.668
    0.590  308.36  0.714
    0.656  308.10  0.737
    0.771  307.70  0.812
    0.840  307.54  0.855
    0.864  307.56  0.874
    0.897  307.51  0.904
    0.908  307.46  0.910
    0.911  307.50  0.914
    0.934  307.48  0.934
    0.947  307.45  0.947
    0.971  307.44  0.969
);
