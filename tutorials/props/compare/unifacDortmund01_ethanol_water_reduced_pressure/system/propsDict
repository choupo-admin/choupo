        vary        { variable x[ethanol];
                      points ( 0.076 0.141 0.260 0.390 0.499 0.599 0.688 0.799 0.805 0.841 0.883 0.913 0.931 0.945 0.960 0.964 ); }
        state       { P 19.71 kPa;  composition { ethanol 0.5;  water 0.5; } }
        thermo
        {
            equilibrium { liquid { activityModel { model UNIFACDortmund; } } }
        }
        properties  ( T_bubble  y_eq_ethanol );
        output      { file txy_dortmund_19p71.csv; }
    }
    {
        name        txy_unifac_32p86;
        type        propertyScan1D;
        //  the 14 measured interior x of Table 1 at 32.86 kPa, in the paper's own order
        vary        { variable x[ethanol];
                      points ( 0.063 0.104 0.150 0.248 0.454 0.581 0.657 0.760 0.839 0.854 0.913 0.931 0.932 0.965 ); }
        state       { P 32.86 kPa;  composition { ethanol 0.5;  water 0.5; } }
        thermo
        {
            equilibrium { liquid { activityModel { model UNIFAC; } } }
        }
        properties  ( T_bubble  y_eq_ethanol );
        output      { file txy_unifac_32p86.csv; }
    }
    {
        name        txy_dortmund_32p86;
        type        propertyScan1D;
        //  the 14 measured interior x of Table 1 at 32.86 kPa, in the paper's own order
        vary        { variable x[ethanol];
                      points ( 0.063 0.104 0.150 0.248 0.454 0.581 0.657 0.760 0.839 0.854 0.913 0.931 0.932 0.965 ); }
        state       { P 32.86 kPa;  composition { ethanol 0.5;  water 0.5; } }
