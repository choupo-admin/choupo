        output      { file txy_dortmund_32p86.csv; }
    }
);

experimental
(
    {
        name      voutsas2011_13p15;
        component ethanol;
        kind      txy;
        models    ( txy_unifac_13p15  txy_dortmund_13p15 );
        dataset   "constant/experiments/ethanol-water-voutsas2011-13p15kPa.dat";
        source    "Voutsas et al., Fluid Phase Equilib. 308 (2011) 135, Table 1 (p. 137), 13.15 kPa -- measured, out of sample for both models";
    }
    {
        name      voutsas2011_19p71;
        component ethanol;
        kind      txy;
        models    ( txy_unifac_19p71  txy_dortmund_19p71 );
        dataset   "constant/experiments/ethanol-water-voutsas2011-19p71kPa.dat";
        source    "Voutsas et al., Fluid Phase Equilib. 308 (2011) 135, Table 1 (p. 137), 19.71 kPa -- measured, out of sample for both models";
    }
