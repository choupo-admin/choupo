// [imported] origin "data/standards/components/NH3.dat" (Choupo-2608 release) -- owned + sha256-verified by constant/propertyManifest
/*--------------------------------*- Choupo -*-----------------------*\
  Component: Ammonia  (NH3, CAS 7664-41-7)

  The Haber-Bosch product (N2 + 3 H2 -> 2 NH3); a Choupo GibbsReactor
  with NH3 + N2 + H2 at 400-500 K, 200 bar is the textbook synthesis
  case.  Also relevant for thermal-NOx (Zeldovich) and SCR flue-gas
  chemistries, and as a refrigerant (R-717).

  CANONICAL FILE.  2026-06-06: the duplicate-CAS twin `ammonia.dat`
  (same CAS 7664-41-7, divergent constants) was merged into this file
  and removed -- one molecule, one file, one set of numbers.
  Sources: constants (Tc/Pc/omega/MW/Tb) cross-checked vs CoolProp 7.2.0
           reference EOS; standardThermochemistry cross-checked vs NASA TM-4513
           (McBride-Gordon-Reno 1993); vaporPressure -- individual
           literature value, primary re-citation pending (IST review);
           liquidViscosity -- fitted to Monogenidou, Assael & Huber,
           J. Phys. Chem. Ref. Data 47, 023102 (2018), Table 6;
           Vliq -- Gao et al., J. Phys. Chem. Ref. Data 52, 013102 (2023).
\*---------------------------------------------------------------------------*/

name        NH3;
formula     NH3;
CAS         7664-41-7;

MW          17.030;            // kg/kmol
Tc          405.40;             // K
Pc          113.59;             // bar
omega       0.252;              // [-]
Tb          239.82;             // K
HvapTb      23330;              // J/mol
Vliq        2.8245e-5;          // m^3/mol, saturated liquid at 25 C (10.03 bar)
//  THE 25 C VALUE, which is what the field means (`Component::Vliq()`,
//  src/thermo/Component.H:97, "liquid molar volume at 25 C"; anchored there by
//  ThermoPackage's Rackett, src/thermo/ThermoPackage.cpp:1940-1966).  Until
//  2026-10-11 this read 2.50e-5 -- ammonia's molar volume at its NORMAL
//  BOILING POINT (239.8 K), which the engine then carried as if it were the
//  25 C one, so liquid ammonia came out ~13 % too dense at 253 K (DEV.md 4c
//  C64, C65 item b).  See provenance { Vliq }.
//  ANCHOR, never an input.  The engine DERIVES the Hildebrand
//  parameter from HvapTb and Vliq (the tree stores no derivative);
//  this is what ChemSep v8.3 computed independently, so the
//  derivation has something to be wrong against.
solubilityParameter 24790;   // Pa^0.5  [anchor, ChemSep v8.3, Artistic-2.0]
role        solute;        // soluble gas: Henry K = H(T)/P (solvent water)

standardThermochemistry
{
    dHf_298    -45940.0;        // J/mol  -- ideal-gas reference
    s_298      192.77;          // J/(mol·K)
}

vaporPressure
{
    model         Antoine;
    // log10(Psat[bar]) = A - B/(T[K]+C).  Coefficients valid ~195-371 K
    // (Psat(Tb=239.82 K) = 1.03 bar; Psat(300 K) = 10.5 bar -- both check).
    coefficients  (4.86886   1113.928   -10.409);
    Trange        (195  371);
}

idealGasHeatCapacity
{
    model         polynomial;
    coefficients  (27.31   0.02383   1.707e-5   -1.185e-8);
    Trange        (250  1500);
}

liquidHeatCapacity
{
    model         polynomial;
    // approximate constant ~80 J/(mol·K) for liquid NH3 (Cp ~ 4.7 J/g·K x MW);
    // merged from the former ammonia.dat twin.
    coefficients  (80.0);
    Trange        (200  350);
}

// Liquid transport.  liquidViscosity: ln(mu/Pa.s) = A + B/T (Andrade).
// A, B = least-squares fit (in ln mu against 1/T) to the SATURATED-LIQUID
// column of Monogenidou, Assael & Huber, J. Phys. Chem. Ref. Data 47, 023102
// (2018), Table 6 -- the reference correlation for ammonia, read in the NIST
// reprint (srd.nist.gov/jpcrdreprint/1.5036724.pdf):
//     T [K]      200     220     240     260     280     300     320
//     mu [uPa s] 516.02  347.27  251.04  192.06  153.03  125.00  103.20
// AAD 0.51 %, max 0.71 % over these seven points (200-320 K); mu(239.82 K)
// = 0.2532 mPa s.  At 340 K the two-constant form is already 3 % off, so
// the validity stops at 320 K.
// REPLACED 2026-10-11 (DEV.md 4c C65 item c): the former A -9.665, B 353.6
// was fitted to the Engineering Toolbox saturated-liquid table -- a no-grant
// compilation under the licence policy (CLAUDE.md 10), never a value's
// origin -- and measured against Table 6 it was not merely unlicensed but
// wrong: -28 % at 200 K, +29 % at 260 K, +65 % at 300 K, +86 % at 320 K.
liquidViscosity
{
    andrade { A -11.8350; B 852.25; }
}

provenance
{
    vaporPressure  "individual literature value -- primary re-citation pending (IST review)";
    constants      "cross-checked vs CoolProp 7.2.0 reference EOS";
    standardThermochemistry "NASA TM-4513 (McBride-Gordon-Reno 1993), ideal-gas, 298 K";
    Vliq
    {
        origin       literature;
        method       "saturated-liquid density at 298.15 K from the reference equation of state, 602.96 kg/m3 (p_sat 1.003 MPa); Vm = M/rho with M = 17.0305 g/mol";
        citation     "Gao, Wu, Bell, Harvey & Lemmon, J. Phys. Chem. Ref. Data 52, 013102 (2023), doi:10.1063/5.0128269 (NIST manuscript, tsapps.nist.gov pub_id 935147), evaluated with CoolProp 8.0.0 (MIT), whose implementation reproduces the paper's Table 7 check values to 6e-7 and Monogenidou et al. (2018) Table 6's 600.17 kg/m3 at 300 K to 1e-7";
        uncertainty  "0.1 % in saturated-liquid density between 195 and 400 K (the paper's own statement)";
        note         "molar volume at the NORMAL BOILING POINT from the same equation is 2.4984e-5 m3/mol (681.65 kg/m3 at 239.82 K) -- the value this field carried until 2026-10-11";
    }
    liquidViscosity
    {
        origin       regressed;
        method       "Andrade least-squares fit (ln mu vs 1/T) to the saturated-liquid viscosities of the reference correlation, Table 6 (7 points, 200-320 K)";
        citation     "Monogenidou, Assael & Huber, J. Phys. Chem. Ref. Data 47, 023102 (2018), doi:10.1063/1.5036724, Table 6";
        validity     (200 320);
        uncertainty  "AAD 0.51 %, max 0.71 % against Table 6; the correlation itself is stated at 0.6-5 % depending on T and P";
    }
}

cosmo
{
    VT2005
    {
        model       COSMOSAC;
        variant     "2002";
        source      "VT-2005 sigma-profile database (Mullins et al., Ind. Eng. Chem. Res. 45 (2006) 4389; DFT-COSMO), file VT2005-1070-PROF.txt bundled in usnistgov/COSMOSAC; CAS 7664-41-7";
        licence     externalRestricted;   // VT-2005: redistribution NOT confirmed -- values NOT shipped
        installed   false;                 // install your own copy: bin/choupo-import-cosmo (-> data/local/cosmo/VT2005/)
    }
    LVPP-HFTZVP-2018
    {
        model       COSMOSAC;
        variant     "LVPP-HFTZVP-2018";
        protocol    "LVPP-18.07 GAMESS HF/TZVP; r_av 1.4 A; f_decay 3.57; d in A; sigma = q/a";
        source      "LVPP sigma-profile database release 18.07 (github.com/lvpp/sigma, asset HF_TZVP.zip, sha256 bd17aaeebb430641...), file AMMONIA.gout; MIT License, Copyright (c) 2017 LVPP; cite Ferrarini, Flores, Muniz & Soares, AIChE J. 64 (2018) 3443, doi:10.1002/aic.16194, and doi:10.5281/zenodo.3613786; identity: InChIKey QGZKDVFQNNGYKY-UHFFFAOYSA-N (full match); formula H3N; resolved by thirdParty/thermoml/identity.json (PubChem and CACTUS agree)";
        derivation  "segment areas, charges and the cavity volume are LVPP's (GAMESS HF/TZVP COSMO output); `area` is the sum of LVPP's segment areas as binned (GAMESS's printed cavity area agrees within its 2-decimal rounding); the 51-point profile is COMPUTED BY CHOUPO from LVPP's surface segments by bin/curate/lvpp_sigma_profile.py under the protocol above (Bell et al. 2020 Eq. 4 averaging, sigma = q/a, area split linearly between grid nodes)";
        licence     MIT;
        installed   true;
        area        48.698542;   // sum of the profile below; GAMESS prints 48.70
        volume      30.54;
        sigmaProfile  (
               0.000000     0.000000     0.000000     0.000000     0.000000     0.000000
               0.000000     0.000000     0.000000     0.000000     0.000000     0.000000
               0.000000     0.746422     2.905540     4.031304     1.796725     3.480626
               4.783511     4.605226     2.466092     1.301248     1.426428     1.484501
               1.829464     1.009227     1.327230     0.956057     1.006648     0.396293
               0.449731     0.388120     1.419872     0.832335     0.767678     0.782626
               0.296705     0.499802     0.786476     0.381444     0.404241     1.153573
               0.549152     0.394469     0.615175     0.697745     0.779524     0.547139
               0.262936     0.862065     0.275192
        );
    }
}

// ---- Aqueous-speciation FACTS (substance-level, classifier-read) ----
// The canonical set of aqueous speciation equilibria this component
// participates in (NH3 + H2O = NH4+ + OH-); vapour-phase reactions are
// NOT part of this fact.  The typed component->species bridge delivers
// the family total in the PHREEQC master convention, NH3 = NH4+ - H+.
aqueousSpeciation  ammonia;
aqueousMapping ( { species NH4; nu 1; } { species H; nu -1; } );
