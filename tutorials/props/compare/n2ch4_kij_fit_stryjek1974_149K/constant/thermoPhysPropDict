/*---------------------------------------------------------------------------*\
  n2ch4_kij_fit_stryjek1974_149K -- the thermophysical system the fit starts
  from: phi-phi, SRK, one-fluid mixing rule.  The pair is the ONE inline form
  the builder accepts, `{ i; j; kij; variedBy <operation>; }`, starting at 0;
  the fit moves it.  The finished fit is the record
  data/standards/parameters/SRK/N2-CH4.dat.
\*---------------------------------------------------------------------------*/
recordType    thermophysicalPropertySystem;
schemaVersion 1;
components    ( N2  CH4 );
equilibrium
{
    formulation phiPhi;
    equationOfState
    {
        model SRK;  mixingRule vanDerWaalsOneFluid;
        binaryInteractions
        {
            N2-CH4 { i N2;  j CH4;  kij 0.0;  variedBy fitParameters; }
        }
    }
    liquid { fugacityRoute equationOfState; root liquid; }
    vapour { fugacityRoute equationOfState; root vapour; }
}
caloric
{
    energyBasis elementsDatum;
    liquid { departureRoute equilibriumEquationOfState; root liquid; }
    vapour { departureRoute equilibriumEquationOfState; root vapour; }
}
