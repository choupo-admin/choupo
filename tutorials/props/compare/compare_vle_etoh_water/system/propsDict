/*---------------------------------------------------------------------------*\
  compare_vle_etoh_water
  ======================

  The canonical "SEE, then DECIDE" props case: ethanol/water T-x-y at 1 atm,
  with two MODEL curves and the MEASURED data on ONE plot.

  Piece 1 -- two scan operations, identical but for the activity model:
      txy_ideal   Raoult (gamma = 1)  -> a smooth lens, NO azeotrope
      txy_nrtl    NRTL                -> the real minimum-boiling azeotrope
  Each emits the (x, T_bubble, y_eq) trio -> the T-x-y / x-y / T-x / T-y toggle
  (x-y is the McCabe-Thiele diagram).

  Piece 2 -- the `experimental {}` overlay: lists the two ops as `models`, and
  points `dataset` at REAL measured points (constant/experiments/...).  The GUI
  draws both model curves + the lab points together; the student SEES that the
  ideal model misses the azeotrope and NRTL captures it, and picks NRTL from
  evidence -- not from a recommended-by badge.
\*---------------------------------------------------------------------------*/

operations
(
    {
        name        txy_ideal;
        type        propertyScan1D;
        vary        { variable x[ethanol];  from 0.0;  to 1.0;  n 51; }
        state       { P 1.01325 bar;  composition { ethanol 0.5;  water 0.5; } }
        thermo
        {
            equilibrium { liquid { activityModel { model ideal; } } }
        }
        properties  ( T_bubble  y_eq_ethanol );
        output      { file txy_ideal.csv; }
    }
    {
        name        txy_nrtl;
        type        propertyScan1D;
        vary        { variable x[ethanol];  from 0.0;  to 1.0;  n 51; }
        state       { P 1.01325 bar;  composition { ethanol 0.5;  water 0.5; } }
        thermo
        {
            equilibrium { liquid { activityModel
            {
                model NRTL;
                binaryParameters
            {
                ethanol-water { i ethanol; j water; a_ij -0.8009; b_ij 246.18; a_ji 3.4578; b_ji -586.0809; alpha 0.30; }
            }
            } } }
        }
        properties  ( T_bubble  y_eq_ethanol );
        output      { file txy_nrtl.csv; }
    }
    {
        // PREDICT (not fit): UNIFAC builds gamma from the molecular groups with
        // NO regressed binary parameters.  ethanol = CH3 + CH2 + OH, water = H2O;
        // the CH2/OH/H2O group interactions alone produce an azeotrope.  The
        // overlay AAD shows how close a zero-data PREDICTION lands: T_bubble
        // AAD 0.407 K against Carey & Lewis, between ideal (5.354 K) and the
        // FITTED NRTL (0.349 K) -- and much nearer the fit than the ideal.
        // The azeotrope lands at x_eth 0.888 / 351.17 K, against NRTL's 0.885
        // and the measured 0.894.  For a method that saw none of these data,
        // that is a good result, and it is the lesson: group prediction gets
        // you into the ballpark for free.  It does NOT retire the fit -- NRTL
        // still wins on T_bubble, Wilson wins on both, and neither of those
        // is predictive.
        //
        // THREE NUMBERS HERE WERE WRONG UNTIL 2026-08-12, and the reason is
        // the reason this case now pins its AADs.  This comment used to claim
        // "T_bubble AAD ~2.6 K" and an azeotrope "misplaced to x_eth ~0.77",
        // and called that mislocation the documented weakness of original
        // UNIFAC for alcohol-water.  The case's own output says 0.407 K and
        // 0.888.  Both claims were 6x and 0.12 mole fraction off, both in the
        // direction that made the method look worse than it is, and NOTHING
        // could catch them: the AAD table was emitted in a `validation` block
        // that no golden row could read, so this case's headline result --
        // how far each model sits from the lab data -- was pinned by nothing
        // at all.  `bin/runTests` now has an `aad` kind; the eight AADs are
        // in `expected`; pinning the old 2.6 there makes the suite FAIL.
        //
        // The third claim was an attribution: "the a_mn table here matches
        // Poling 5th ed. Table 8-24".  The table this case actually reads
        // declares its own source in its own header -- the ChemSep compilation
        // of Hansen, Rasmussen, Fredenslund, Schiller & Gmehling, IECR 30
        // (1991) 2352 -- and that record is the authority on what it contains.
        // Whether Poling reproduces the same revision was never checked
        // against the shipped numbers, so the secondary citation is dropped
        // rather than kept as an unverified endorsement.
        name        txy_unifac;
        type        propertyScan1D;
        vary        { variable x[ethanol];  from 0.0;  to 1.0;  n 51; }
        state       { P 1.01325 bar;  composition { ethanol 0.5;  water 0.5; } }
        thermo
        {
            equilibrium { liquid { activityModel
            {
                model  UNIFAC;
                // groups: resolved from each component's own data (`groups { unifac (...) }` in the .dat) -- ONE home

            } } }
        }
        properties  ( T_bubble  y_eq_ethanol );
        output      { file txy_unifac.csv; }
    }
    {
        // TEST the data, don't just look at it: the van Ness / area
        // thermodynamic consistency check on the SAME measured (x, T, y) set.
        // gamma_i comes straight from the data (modified Raoult, Antoine Psat);
        // a consistent set satisfies the Gibbs-Duhem area + point tests.
        // Reuses the dataset below (the engine accepts its model-scan column
        // aliases T_bubble / y_eq_ethanol).
        name        consistency_etoh_water;
        type        vleConsistency;
        component   ethanol;
        partner     water;
        state       { P 1.01325 bar; }
        dataset     "constant/experiments/etoh_water_vle_1atm.dat";
        output      { file consistency.csv; }
    }
    {
        // WILSON, on the SAME inline pair flash03_wilson_ethanol_water runs on
        // (A_ij 1157.95 / A_ji 4081.65 -- quoted from that case, which owns
        // them; this op curates nothing).  Wilson's FIRST measured-data
        // anchor: until now the model was Gibbs-Duhem-consistent (internal)
        // and exercised by three tutorials, but never held against a lab
        // point.  Expect fitted-Wilson quality close to fitted-NRTL; a large
        // gap here would be a FINDING about the pair, reported, never tuned.
        name        txy_wilson;
        type        propertyScan1D;
        vary        { variable x[ethanol];  from 0.0;  to 1.0;  n 51; }
        state       { P 1.01325 bar;  composition { ethanol 0.5;  water 0.5; } }
        thermo
        {
            equilibrium { liquid { activityModel
            {
                model Wilson;
                binaryParameters
            {
                ethanol-water { i ethanol; j water; A_ij 1157.95; A_ji 4081.65; }
            }
            } } }
        }
        properties  ( T_bubble  y_eq_ethanol );
        output      { file txy_wilson.csv; }
    }
);

experimental
(
    {
        name      etoh_water_1atm;
        component ethanol;
        kind      txy;
        models    ( txy_ideal  txy_nrtl  txy_unifac  txy_wilson );
        dataset   "constant/experiments/etoh_water_vle_1atm.dat";
        source    "Carey & Lewis 1932 (ethanol-water VLE, 101.3 kPa)";
    }
);
