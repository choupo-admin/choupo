        file          "constant/archiveExtracts/diisopropylEther-2Methyl1Propanol-bubbleP-j.fluid.2005.11.017-b3.dat";
        role          fit;   // C283: every laboratory is fitted
        doi           "10.1016/j.fluid.2005.11.017";
