        articleSha256 "bdd27e2405e1e270a7e173d7d14fefbc5cd0ac0bf877faac4fac8fd7614d13a5";
        block         3;
        extractor     bubblePressure;
        extract       "bin/choupo-thermoml extract-px <article file> --block 3 --into <dir>";
        sha256        "04be6743749eb08e37bf8dffab197a05979d70b9222ca68e609ef39421d4a11e";
