/*---------------------------------------------------------------------------*\
  curate15_nrtl_methanol_dimethylCarbonate -- AN NRTL PAIR FROM PUBLISHED MEASUREMENTS, BY THE PIPELINE.

  WRITTEN BY bin/choupo-curate pair methanol dimethylCarbonate (DEV.md 4c C282; record
  docs/design/binary-pairs-from-open-measurements.md section 8).  Every rule
  below was decided before this tool existed (C16, C225, C226); the tool
  applies them and decides nothing.

  THE DECLARATION -- WRITTEN AND COMMITTED BEFORE ANY FIT RAN.
  (C16 slice 2: so the declaration can be read against the result.)

  IDENTITY.  methanol (CAS 67-56-1, InChIKey OKKJLVBELUTLKV-UHFFFAOYSA-N)
  + dimethylCarbonate (CAS 616-38-6, InChIKey IEJIGPNLZYLLBP-UHFFFAOYSA-N), joined
  to the archive through identity.json -- never by name.

  NO MEASURED SERIES IN THIS TREE.  constant/archiveDatasets names each
  dataset (DOI, NIST URL, article sha256, extraction selector, extract
  sha256); `bin/choupo-curate fetch` writes the points into
  constant/archiveExtracts/, which is gitignored.

  STUDIES CONSIDERED: every bubble-temperature block of the pair at or below
  110 kPa with a declared uncertainty (9 block(s)).
  USABLE after the screens: 8.  SET ASIDE, BY NAME:
      - doi 10.1021/je200697m block 2: reports x of dimethylCarbonate,
      the others of methanol; extract-vle has no reorientation (C16
      section 6.1) and a hand edit of a measured file is what the chain
      exists to prevent

  TRIAGE (C226 item 3, leave one study out, fitted by the engine; a study
  whose held-out AAD exceeds its own largest stated U plus the others'
  largest stated U disagrees with them beyond their stated uncertainties):
      10.1021/je0601309: AAD 0.131 K against the limit 2.400 K -> agrees;
      10.1021/acs.jced.7b00185: AAD 0.222 K against the limit 3.210 K ->
      agrees; 10.1016/j.jct.2012.05.002: AAD 0.411 K against the limit
      2.660 K -> agrees; 10.1021/je301290c: AAD 0.260 K against the limit
      2.310 K -> agrees; 10.1021/acs.jced.9b00068: AAD 0.613 K against
      the limit 3.110 K -> agrees; 10.1021/je2005402: AAD 0.453 K against
      the limit 2.420 K -> agrees; 10.1021/je500443v: AAD 0.193 K against
      the limit 3.210 K -> agrees; 10.1016/j.fluid.2018.09.005: AAD 0.315
      K against the limit 2.570 K -> agrees

  PARTITION (the declared rule of C16 slice 2): the FIT set is the usable
  study with the most interior points; the HELD-OUT set is the next largest
  that shares NO author with it and was measured at one pressure.
    FIT       doi 10.1021/je0601309 (65 interior points, 5 isobars 40-93.32 kPa)
              authors: Fukano, M.[Makoto]; Matsuda, H.[Hiroyuki]; Kurihara, K.[Kiyofumi]; Ochi, K.[Kenji]
    HELD OUT  doi 10.1021/je301290c (19 interior points, 101.3 kPa)
              authors: Chen, X.[Xiaochun]; Cai, F.[Fufeng]; Wu, X.[Xinying]; Asumana, C.[Charles]; Yu, G.[Guangren]

  BAND: maxAAD 0.088 % of the held-out mean T.
      declared before the fit by bin/choupo-curate, the ONE rule of C16:
      the held-out set's largest stated expanded uncertainty (U95 = 0.3
      K) plus the catalogue vapour-pressure model's own error at that
      set's pure endpoints (NONE: the held-out study reports no
      pure-component bubble point, so the term is ZERO, the strictest
      reading of the rule -- the band is the measurement's own
      uncertainty alone; measured with no pair involved), as a percentage
      of the held-out mean T (341.73 K) = 0.0878 %, rounded UP to two
      significant figures

  THE FIT.  NRTL with a_ij = a_ji = 0 and alpha = 0.30 fixed: TWO parameters
  (b_ij, b_ji), the C16 frame (bubble temperatures over these ranges do not
  identify more).  Each point weighted by 1/U, U its own stated expanded
  uncertainty.  Two starts: (0, 0) and (800, -400).

  @@RESULT-BEGIN@@
  WHAT THE RUN FOUND: not yet run.
  @@RESULT-END@@

  WHAT IS NOT CLAIMED.  The pair is correct at these pressures and in this
  frame (ideal-gas vapour, the catalogue's own vapour-pressure records); the
  measurements were transcribed by the archive and have NOT been read back
  against the articles (the CHECKLIST that `fetch` writes beside the extracts
  is the aid for that reading).
\*---------------------------------------------------------------------------*/

operations
(
    {
        name        fit_nrtl;
        type        fitParameters;

        parameters
        (
            { path  equilibrium.liquid.activityModel.binaryParameters.methanol-dimethylCarbonate.b_ij;  initial 0;  min -3000;  max 3000; }
            { path  equilibrium.liquid.activityModel.binaryParameters.methanol-dimethylCarbonate.b_ji;  initial 0;  min -3000;  max 3000; }
        );

        evidence
        (
            {
                dataset  "constant/archiveExtracts/methanol-dimethylCarbonate-bubble-je0601309.dat";
                role     fit;
            }
            {
                dataset  "constant/archiveExtracts/methanol-dimethylCarbonate-bubble-je301290c.dat";
                role     validation;
            }
        );

        acceptance
        {
            maxAAD  0.088 percent;
            origin  "declared before the fit by bin/choupo-curate, the ONE rule of C16: the held-out set's largest stated expanded uncertainty (U95 = 0.3 K) plus the catalogue vapour-pressure model's own error at that set's pure endpoints (NONE: the held-out study reports no pure-component bubble point, so the term is ZERO, the strictest reading of the rule -- the band is the measurement's own uncertainty alone; measured with no pair involved), as a percentage of the held-out mean T (341.73 K) = 0.0878 %, rounded UP to two significant figures";
        }

        objective { method leastSquares; }
        residual
        {
            kind        T_bubble;
            components  ( methanol dimethylCarbonate );
            weighting   uncertainty;
        }

        options
        {
            maxIter      80;
            tolerance    1.0e-6;
            fdStep       1.0e-4;
            lambda0      1.0e-3;
        }

        output
        {
            fit_log    fit_history.csv;
            parity     parity.csv;
            proposal   dimethylCarbonate-methanol.proposal.dat;
        }
    }
    {
        name        fit_nrtl_start2;
        type        fitParameters;

        parameters
        (
            { path  equilibrium.liquid.activityModel.binaryParameters.methanol-dimethylCarbonate.b_ij;  initial 800;  min -3000;  max 3000; }
            { path  equilibrium.liquid.activityModel.binaryParameters.methanol-dimethylCarbonate.b_ji;  initial -400;  min -3000;  max 3000; }
        );

        evidence
        (
            {
                dataset  "constant/archiveExtracts/methanol-dimethylCarbonate-bubble-je0601309.dat";
                role     fit;
            }
            {
                dataset  "constant/archiveExtracts/methanol-dimethylCarbonate-bubble-je301290c.dat";
                role     validation;
            }
        );

        acceptance
        {
            maxAAD  0.088 percent;
            origin  "declared before the fit by bin/choupo-curate, the ONE rule of C16: the held-out set's largest stated expanded uncertainty (U95 = 0.3 K) plus the catalogue vapour-pressure model's own error at that set's pure endpoints (NONE: the held-out study reports no pure-component bubble point, so the term is ZERO, the strictest reading of the rule -- the band is the measurement's own uncertainty alone; measured with no pair involved), as a percentage of the held-out mean T (341.73 K) = 0.0878 %, rounded UP to two significant figures";
        }

        objective { method leastSquares; }
        residual
        {
            kind        T_bubble;
            components  ( methanol dimethylCarbonate );
            weighting   uncertainty;
        }

        options
        {
            maxIter      80;
            tolerance    1.0e-6;
            fdStep       1.0e-4;
            lambda0      1.0e-3;
        }

        output
        {
            parity     parity_start2.csv;
        }
    }
    {
        name        txy_ideal;
        type        propertyScan1D;
        vary        { variable x[methanol];  from 0.0;  to 1.0;  n 101; }
        state       { P 101.3 kPa;  composition { methanol 0.5;  dimethylCarbonate 0.5; } }
        thermo
        {
            equilibrium { liquid { activityModel { model ideal; } } }
        }
        properties  ( T_bubble  y_eq_methanol );
        output      { file txy_ideal.csv; }
    }
    {
        name        txy_nrtl;
        type        propertyScan1D;
        vary        { variable x[methanol];  from 0.0;  to 1.0;  n 101; }
        state       { P 101.3 kPa;  composition { methanol 0.5;  dimethylCarbonate 0.5; } }
        thermo
        {
            equilibrium { liquid { activityModel { model NRTL; /* no inline pair: the case's own record */ } } }
        }
        properties  ( T_bubble  y_eq_methanol );
        output      { file txy_nrtl.csv; }
    }
);

experimental
(
    {
        name      heldout;
        component methanol;
        kind      txy;
        models    ( txy_ideal  txy_nrtl );
        dataset   "constant/archiveExtracts/methanol-dimethylCarbonate-bubble-je301290c.dat";
        source    "held out: doi 10.1021/je301290c";
    }
);
