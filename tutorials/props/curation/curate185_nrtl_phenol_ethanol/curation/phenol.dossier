            doi       "10.1016/j.fluid.2017.09.008";
            sha256    "466c00147084b1a9e5a22235d6afa9a412b6b06b70a4aa476d0d807dc00a5ea1";
            provenance measured;
            archiveFile "j.fluid.2017.09.008.xml";
            system    "phenol + ethanol";
        }
        );

        domain
        {
            coordinate  x1;
            fit         { min 0.1; max 0.883; n 54; }
