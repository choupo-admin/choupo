      +4.62 K; doi 10.1021/je200098d row 10: x 0.3470, P 20.000 kPa, T
      358.40 K, dT +4.27 K; doi 10.1021/je200098d row 14: x 0.4300, P
      20.000 kPa, T 358.40 K, dT +3.45 K; doi 10.1021/je200098d row 17: x
      0.5150, P 20.000 kPa, T 358.30 K, dT +3.29 K; doi 10.1021/je200098d
      row 20: x 0.6500, P 20.000 kPa, T 358.40 K, dT +3.11 K; doi
      10.1021/je200098d row 24: x 0.7410, P 20.000 kPa, T 358.20 K, dT
      +3.12 K; doi 10.1016/j.jct.2011.06.015 row 2: x 0.0613, P 101.330
      kPa, T 473.00 K, dT -7.09 K; doi 10.1016/j.jct.2011.06.015 row 4: x
      0.0949, P 101.330 kPa, T 456.60 K, dT -7.28 K; doi
      10.1016/j.jct.2011.06.015 row 5: x 0.1462, P 101.330 kPa, T 446.35
      K, dT -10.64 K; doi 10.1016/j.jct.2011.06.015 row 6: x 0.2184, P
      101.330 kPa, T 432.07 K, dT -5.89 K; doi 10.1016/j.jct.2011.06.015
      row 7: x 0.3436, P 101.330 kPa, T 425.50 K, dT -6.16 K
  @@OUTLIERS-END@@

  @@RESULT-BEGIN@@
  WHAT THE RUN FOUND (pinned in `expected`; measured, not argued).
  fit_nrtl: b_ij = 583.7 K, b_ji = 312.7 K over 28 kept points of 2
  laboratories (14 discarded): max |dT| 3.584 K, mean 1.527 K against the
  acceptance 1 K -> notAccepted. fit_nrtl_start2 lands on the same pair
  (583.7, 312.7). NOT PROMOTABLE: max |dT| 3.584 K over the 28 kept
  points is not below 1 K
  @@RESULT-END@@

  WHAT IS NOT CLAIMED.  The pair is correct at these pressures and in this
  frame (ideal-gas vapour, the catalogue's own vapour-pressure records); the
  measurements were transcribed by the archive and have NOT been read back
  against the articles (the CHECKLIST that `fetch` writes is the aid).
\*---------------------------------------------------------------------------*/

operations
(
    {
        name        fit_nrtl;
        type        fitParameters;

        parameters
        (
            { path  equilibrium.liquid.activityModel.binaryParameters.ethylBenzene-sulfolane.b_ij;  initial 0;  min -3000;  max 3000; }
            { path  equilibrium.liquid.activityModel.binaryParameters.ethylBenzene-sulfolane.b_ji;  initial 0;  min -3000;  max 3000; }
        );

        evidence
        (
            {
                dataset  "constant/archiveExtracts/ethylBenzene-sulfolane-bubble-je200098d.dat";
                role     fit;
                discard  ( 3 4 7 8 10 14 17 20 24 );   // C283 outliers, by name in the header
            }
            {
                dataset  "constant/archiveExtracts/ethylBenzene-sulfolane-bubble-j.jct.2011.06.015.dat";
                role     fit;
                discard  ( 2 4 5 6 7 );   // C283 outliers, by name in the header
            }
        );

        objective { method twoStage;  scale { T_bubble absolute; } }
        residual
        {
            kind        T_bubble;
            components  ( ethylBenzene sulfolane );
            weighting   uncertainty;
        }

        options
        {
            maxIter      80;
            tolerance    1.0e-6;
            fdStep       1.0e-4;
            lambda0      1.0e-3;
        }

        output
        {
            fit_log    fit_history.csv;
            parity     parity.csv;
            proposal   ethylBenzene-sulfolane.proposal.dat;
        }
    }
    {
        name        fit_nrtl_start2;
        type        fitParameters;

        parameters
        (
            { path  equilibrium.liquid.activityModel.binaryParameters.ethylBenzene-sulfolane.b_ij;  initial 800;  min -3000;  max 3000; }
            { path  equilibrium.liquid.activityModel.binaryParameters.ethylBenzene-sulfolane.b_ji;  initial -400;  min -3000;  max 3000; }
        );

        evidence
        (
            {
                dataset  "constant/archiveExtracts/ethylBenzene-sulfolane-bubble-je200098d.dat";
                role     fit;
                discard  ( 3 4 7 8 10 14 17 20 24 );   // C283 outliers, by name in the header
            }
            {
                dataset  "constant/archiveExtracts/ethylBenzene-sulfolane-bubble-j.jct.2011.06.015.dat";
                role     fit;
                discard  ( 2 4 5 6 7 );   // C283 outliers, by name in the header
            }
        );

        objective { method twoStage;  scale { T_bubble absolute; } }
        residual
        {
            kind        T_bubble;
            components  ( ethylBenzene sulfolane );
            weighting   uncertainty;
        }

        options
        {
            maxIter      80;
            tolerance    1.0e-6;
            fdStep       1.0e-4;
            lambda0      1.0e-3;
        }

        output
        {
            parity     parity_start2.csv;
        }
    }
    {
        name        txy_ideal;
        type        propertyScan1D;
        vary        { variable x[ethylBenzene];  from 0.0;  to 1.0;  n 101; }
        state       { P 20 kPa;  composition { ethylBenzene 0.5;  sulfolane 0.5; } }
        thermo
        {
            equilibrium { liquid { activityModel { model ideal; } } }
        }
        properties  ( T_bubble  y_eq_ethylBenzene );
        output      { file txy_ideal.csv; }
    }
    {
        name        txy_nrtl;
        type        propertyScan1D;
        vary        { variable x[ethylBenzene];  from 0.0;  to 1.0;  n 101; }
        state       { P 20 kPa;  composition { ethylBenzene 0.5;  sulfolane 0.5; } }
        thermo
        {
            equilibrium { liquid { activityModel { model NRTL; /* no inline pair: the case's own record */ } } }
        }
        properties  ( T_bubble  y_eq_ethylBenzene );
        output      { file txy_nrtl.csv; }
    }
);

