/*--------------------------------*- Choupo -*--------------------------------*\
  constant/archiveDatasets -- WHERE the measurements of curate212_nrtl_nNonane_4Heptanone
  come from, and how to regenerate them.  NO MEASURED POINT IS IN THIS TREE
  (Vitor, 2026-11-10: the measured series are not copied; only the fitted
  parameters are kept).  `bin/choupo-curate fetch <case>` writes each
  dataset into constant/archiveExtracts/ (gitignored): the article file is taken from
  the local ThermoML cache when it holds it, else from the NIST URL below,
  and BOTH sha256 sums are checked -- a mismatch refuses, an unreachable
  NIST is reported NOT RUN, never a pass.
\*-----------------------------------------------------------------------------*/

recordType    archiveDatasets;

archive
{
    tarball   "ThermoML.v2020-09-30.tgz";
    doi       "10.18434/mds2-2422";
    note      "the finding aid; each article file is also served one by one at the NIST URL";
}

datasets
(
    {
        file          "constant/archiveExtracts/nNonane-4Heptanone-bubble-je500731x.dat";
        role          fit;   // C283: every laboratory is fitted
        doi           "10.1021/je500731x";
        url           "https://trc.nist.gov/ThermoML/10.1021/je500731x.xml";
        page          "https://trc.nist.gov/ThermoML/10.1021/je500731x.json";
        articleFile   "je500731x.xml";
        articleSha256 "4605b878883fb6c43c8f3ca98b7af6e5200100738f2d7ce46f5595239abc43a9";
        block         32;
        filter        ( --interior-only );
        extract       "bin/choupo-thermoml extract-vle <article file> --block 32 --interior-only --into <dir>";
        sha256        "3df535f0dda8e039d25771f431cd55e1e090c8e34045f6cf3717f5964792a275";
        identity
        {
            nNonane        { cas "111-84-2"; inchiKey "BKIMMITUMNQMOS-UHFFFAOYSA-N"; }
            4Heptanone     { cas "123-19-3"; inchiKey "HCFAJYNVAYBARA-UHFFFAOYSA-N"; }
        }
    }
);
