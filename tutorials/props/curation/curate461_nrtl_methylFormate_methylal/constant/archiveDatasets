(
    {
        file          "constant/archiveExtracts/methylFormate-methylal-bubble-j.fluid.2015.03.049.dat";
        role          fit;   // C283: every laboratory is fitted
        doi           "10.1016/j.fluid.2015.03.049";
        url           "https://trc.nist.gov/ThermoML/10.1016/j.fluid.2015.03.049.xml";
        page          "https://trc.nist.gov/ThermoML/10.1016/j.fluid.2015.03.049.json";
