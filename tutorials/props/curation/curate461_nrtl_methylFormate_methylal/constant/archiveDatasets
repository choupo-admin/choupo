        articleSha256 "9d9be30402105a98d32ce291d749fab123063272cdd1138201a6abd4e379faad";
        block         6;
        filter        ( --interior-only );
        extract       "bin/choupo-thermoml extract-vle <article file> --block 6 --interior-only --into <dir>";
        sha256        "d15291afa9d90749d14b58e2fb6dc140462b00e49f72e9110c99234b8daa9545";
        identity
        {
            methylFormate  { cas "107-31-3"; inchiKey "TZIHFWKZFHZASV-UHFFFAOYSA-N"; }
