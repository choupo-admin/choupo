(
    {
        file          "constant/archiveExtracts/nNDimethylformamide-oCresol-bubble-j.fluid.2008.01.020.dat";
        role          fit;   // C283: every laboratory is fitted
        doi           "10.1016/j.fluid.2008.01.020";
        url           "https://trc.nist.gov/ThermoML/10.1016/j.fluid.2008.01.020.xml";
        page          "https://trc.nist.gov/ThermoML/10.1016/j.fluid.2008.01.020.json";
        articleFile   "j.fluid.2008.01.020.xml";
        articleSha256 "9f0315d6fee492b6a3c5922dcb1848ea90206d54b1923a4fe327bd591daa1461";
        block         24;
        filter        ( --interior-only );
        extract       "bin/choupo-thermoml extract-vle <article file> --block 24 --interior-only --into <dir>";
        sha256        "15d121e0bd9fe4301a7c1a5de427d03ab1df383f6c157fa29f4e2b11fd4d7013";
        identity
        {
            nNDimethylformamide { cas "68-12-2"; inchiKey "ZMXDDKWLCZADIW-UHFFFAOYSA-N"; }
            oCresol        { cas "95-48-7"; inchiKey "QWVGKYWNOKOFNN-UHFFFAOYSA-N"; }
        }
    }
