  <PureOrMixtureData>
    <Component><RegNum><nOrgNum>1</nOrgNum></RegNum></Component>
    <Component><RegNum><nOrgNum>2</nOrgNum></RegNum></Component>

    <Property>
      <nPropNumber>1</nPropNumber>
      <Property-MethodID>
        <PropertyGroup>
          <PhaseTransition>
            <ePropName>Temperature, K</ePropName>
          </PhaseTransition>
        </PropertyGroup>
      </Property-MethodID>
      <ePresentation>Direct value, X</ePresentation>
    </Property>

    <Variable>
      <nVarNumber>1</nVarNumber>
      <VariableID>
        <VariableType><eBioVariables>Pressure, kPa</eBioVariables></VariableType>
      </VariableID>
    </Variable>

    <Variable>
      <nVarNumber>2</nVarNumber>
      <VariableID>
        <VariableType><eComponentComposition>Mole fraction</eComponentComposition></VariableType>
        <RegNum><nOrgNum>1</nOrgNum></RegNum>
      </VariableID>
    </Variable>

    <NumValues>
      <VariableValue><nVarNumber>1</nVarNumber><nVarValue>101.325</nVarValue></VariableValue>
      <VariableValue><nVarNumber>2</nVarNumber><nVarValue>0.40</nVarValue></VariableValue>
      <PropertyValue><nPropNumber>1</nPropNumber><nPropValue>356.85</nPropValue></PropertyValue>
    </NumValues>
    <NumValues>
      <VariableValue><nVarNumber>1</nVarNumber><nVarValue>101.325</nVarValue></VariableValue>
      <VariableValue><nVarNumber>2</nVarNumber><nVarValue>0.60</nVarValue></VariableValue>
      <PropertyValue><nPropNumber>1</nPropNumber><nPropValue>355.30</nPropValue></PropertyValue>
    </NumValues>
    <NumValues>
      <VariableValue><nVarNumber>1</nVarNumber><nVarValue>101.325</nVarValue></VariableValue>
      <VariableValue><nVarNumber>2</nVarNumber><nVarValue>0.80</nVarValue></VariableValue>
      <PropertyValue><nPropNumber>1</nPropNumber><nPropValue>353.30</nPropValue></PropertyValue>
    </NumValues>
  </PureOrMixtureData>

</DataReport>
