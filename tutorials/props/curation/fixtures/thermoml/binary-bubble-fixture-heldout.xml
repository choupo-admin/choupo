<!--
  ============================================================================
  STRUCTURAL FIXTURE == SYNTHETIC.  NOT EXPERIMENTAL DATA.
  ============================================================================

  This file exists to exercise Choupo's ThermoML reader end to end.  It is
  written in the published ThermoML dialect (<DataReport>, <Compound>,
  <PureOrMixtureData>) and carries a fixed-pressure binary bubble-point
  series == the ONE geometry the extractor supports.

  EVERY NUMBER BELOW IS INVENTED.  They are not measurements, they are not
  transcribed from any publication, and the DOI is deliberately a non-
  resolving placeholder in the reserved 10.0000 prefix so that nobody can
  mistake it for a citation.  A verdict computed from this file is a statement
  about the PLUMBING and never about physics.

  The extracted dataset declares `provenance { source synthetic; }`, so the
  fact travels with the evidence rather than living only in this comment ==
  which the parser discards.

  Licence: GPL-3.0-or-later, like the rest of Choupo.  No third-party data is
  involved and none is redistributed.
  ============================================================================
-->
<DataReport xmlns="http://www.iupac.org/namespaces/ThermoML">

  <Citation>
    <sDOI>10.0000/choupo-structural-fixture-heldout</sDOI>
    <sTitle>Synthetic fixed-pressure binary bubble-point fixture (held-out half)</sTitle>
    <sAuthor>Choupo structural fixture -- not a publication</sAuthor>
    <yrPubYr>2026</yrPubYr>
  </Citation>

  <Compound>
    <RegNum><nOrgNum>1</nOrgNum></RegNum>
    <sCommonName>ethanol</sCommonName>
    <sFormulaMolec>C2H6O</sFormulaMolec>
