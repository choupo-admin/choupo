        articleSha256 "5c6ee203786249cfbc857d1d06c431f4c46880db0cdc71afdc551d1ba120904d";
        block         9;
        filter        ( --interior-only );
        extract       "bin/choupo-thermoml extract-vle <article file> --block 9 --interior-only --into <dir>";
        sha256        "62cd082609e91d73db8438ea56087ab6e402e881edfaddc208e4b17435548e84";
        identity
        {
            isopropanol    { cas "67-63-0"; inchiKey "KFZMGEQAYNKOFK-UHFFFAOYSA-N"; }
