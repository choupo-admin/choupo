        file          "constant/archiveExtracts/3Pentanone-2Pentanone-bubble-je025651k.dat";
        role          fit;   // C283: every laboratory is fitted
        doi           "10.1021/je025651k";
        url           "https://trc.nist.gov/ThermoML/10.1021/je025651k.xml";
        page          "https://trc.nist.gov/ThermoML/10.1021/je025651k.json";
