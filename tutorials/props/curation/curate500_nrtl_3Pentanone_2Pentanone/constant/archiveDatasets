        block         9;
        filter        ( --interior-only );
        extract       "bin/choupo-thermoml extract-vle <article file> --block 9 --interior-only --into <dir>";
        sha256        "1ca36969353a8753439d628cc758aff5e4d245733c6714590e42f656c1c75b90";
        identity
        {
