/*--------------------------------*- Choupo -*--------------------------------*\
  constant/archiveDatasets -- WHERE the measurements of curate123_nrtl_ethylBenzene_styrene
  come from, and how to regenerate them.  NO MEASURED POINT IS IN THIS TREE
  (Vitor, 2026-11-10: the measured series are not copied; only the fitted
  parameters are kept).  `bin/choupo-curate fetch <case>` writes each
  dataset into constant/archiveExtracts/ (gitignored): the article file is taken from
  the local ThermoML cache when it holds it, else from the NIST URL below,
  and BOTH sha256 sums are checked -- a mismatch refuses, an unreachable
  NIST is reported NOT RUN, never a pass.
\*-----------------------------------------------------------------------------*/

recordType    archiveDatasets;

archive
{
    tarball   "ThermoML.v2020-09-30.tgz";
    doi       "10.18434/mds2-2422";
    note      "the finding aid; each article file is also served one by one at the NIST URL";
}

datasets
(
    {
        file          "constant/archiveExtracts/ethylBenzene-styrene-bubble-je200098d.dat";
        role          fit;   // C283: every laboratory is fitted
        doi           "10.1021/je200098d";
        url           "https://trc.nist.gov/ThermoML/10.1021/je200098d.xml";
        page          "https://trc.nist.gov/ThermoML/10.1021/je200098d.json";
        articleFile   "je200098d.xml";
        articleSha256 "97dcfdc89bc224473ec4eda70c0b694993ef025bd398181a5f734c77e767e829";
        block         2;
        filter        ( --interior-only );
        extract       "bin/choupo-thermoml extract-vle <article file> --block 2 --interior-only --into <dir>";
        sha256        "39343356da099856defbf1ed448159c1d2f05c909ef92d915783fee0878d4e9b";
        identity
        {
            ethylBenzene   { cas "100-41-4"; inchiKey "YNQLUTRBYVCPMQ-UHFFFAOYSA-N"; }
            styrene        { cas "100-42-5"; inchiKey "PPBRXRYQALVLMV-UHFFFAOYSA-N"; }
        }
    }
    {
        file          "constant/archiveExtracts/ethylBenzene-styrene-bubble-je050523s.dat";
        role          fit;   // C283: every laboratory is fitted
        doi           "10.1021/je050523s";
        url           "https://trc.nist.gov/ThermoML/10.1021/je050523s.xml";
        page          "https://trc.nist.gov/ThermoML/10.1021/je050523s.json";
