/*--------------------------------*- Choupo -*--------------------------------*\
  constant/archiveDatasets -- WHERE the measurements of curate117_nrtl_nOctane_ethanol
  come from, and how to regenerate them.  NO MEASURED POINT IS IN THIS TREE
  (Vitor, 2026-11-10: the measured series are not copied; only the fitted
  parameters are kept).  `bin/choupo-curate fetch <case>` writes each
  dataset into constant/archiveExtracts/ (gitignored): the article file is taken from
  the local ThermoML cache when it holds it, else from the NIST URL below,
  and BOTH sha256 sums are checked -- a mismatch refuses, an unreachable
  NIST is reported NOT RUN, never a pass.
\*-----------------------------------------------------------------------------*/

recordType    archiveDatasets;

archive
{
    tarball   "ThermoML.v2020-09-30.tgz";
    doi       "10.18434/mds2-2422";
    note      "the finding aid; each article file is also served one by one at the NIST URL";
}

datasets
(
    {
        file          "constant/archiveExtracts/nOctane-ethanol-bubble-je400238j.dat";
        role          fit;   // C283: every laboratory is fitted
        doi           "10.1021/je400238j";
        url           "https://trc.nist.gov/ThermoML/10.1021/je400238j.xml";
        page          "https://trc.nist.gov/ThermoML/10.1021/je400238j.json";
        articleFile   "je400238j.xml";
        articleSha256 "b6cdd8126de68ebe83eed932f5c4bfc71f3bfdde95aa91ab3f43adc8a70d5fb3";
        block         2;
        filter        ( --interior-only );
        extract       "bin/choupo-thermoml extract-vle <article file> --block 2 --interior-only --into <dir>";
        sha256        "778158a62b1132feae31803f1bc4f6a73dab7ef8e148832bab14aa8270b8b4f9";
        identity
        {
            nOctane        { cas "111-65-9"; inchiKey "TVMXDCGIABBOFY-UHFFFAOYSA-N"; }
            ethanol        { cas "64-17-5"; inchiKey "LFQSCWFLJHTTHZ-UHFFFAOYSA-N"; }
        }
    }
    {
        file          "constant/archiveExtracts/nOctane-ethanol-bubble-j.fluid.2018.07.013.dat";
        role          fit;   // C283: every laboratory is fitted
        doi           "10.1016/j.fluid.2018.07.013";
        url           "https://trc.nist.gov/ThermoML/10.1016/j.fluid.2018.07.013.xml";
        page          "https://trc.nist.gov/ThermoML/10.1016/j.fluid.2018.07.013.json";
        articleFile   "j.fluid.2018.07.013.xml";
        articleSha256 "bf89dc3bab99040fa861ace6d5ac84da32efae3e49783c85363a7686e5a8eac5";
        block         4;
        filter        ( --interior-only );
        xOf           nOctane;   // the article reports the other member; x = 1 - x'
        extract       "bin/choupo-thermoml extract-vle <article file> --block 4 --interior-only --x-of nOctane --into <dir>";
        sha256        "428078dc8ca4b5d50911d8c6dbb7813151caa218699c22061a053121e7afdf2a";
        identity
        {
            nOctane        { cas "111-65-9"; inchiKey "TVMXDCGIABBOFY-UHFFFAOYSA-N"; }
            ethanol        { cas "64-17-5"; inchiKey "LFQSCWFLJHTTHZ-UHFFFAOYSA-N"; }
        }
    }
);
