/*--------------------------------*- Choupo -*--------------------------------*\
  constant/archiveDatasets -- WHERE the measurements of curate174_nrtl_Dichloroethane_nButanol
  come from, and how to regenerate them.  NO MEASURED POINT IS IN THIS TREE
  (Vitor, 2026-11-10: the measured series are not copied; only the fitted
  parameters are kept).  `bin/choupo-curate fetch <case>` writes each
  dataset into constant/archiveExtracts/ (gitignored): the article file is taken from
  the local ThermoML cache when it holds it, else from the NIST URL below,
  and BOTH sha256 sums are checked -- a mismatch refuses, an unreachable
  NIST is reported NOT RUN, never a pass.
\*-----------------------------------------------------------------------------*/

recordType    archiveDatasets;

archive
{
    tarball   "ThermoML.v2020-09-30.tgz";
    doi       "10.18434/mds2-2422";
    note      "the finding aid; each article file is also served one by one at the NIST URL";
}

datasets
(
    {
        file          "constant/archiveExtracts/Dichloroethane-nButanol-bubble-acs.jced.9b00484.dat";
        role          fit;   // C283: every laboratory is fitted
        doi           "10.1021/acs.jced.9b00484";
        url           "https://trc.nist.gov/ThermoML/10.1021/acs.jced.9b00484.xml";
        page          "https://trc.nist.gov/ThermoML/10.1021/acs.jced.9b00484.json";
        articleFile   "acs.jced.9b00484.xml";
        articleSha256 "015da0197afc81a1288049010e1f5b9e01718b75eaaf1f0bb3585dbcaca1fbe7";
        block         2;
        filter        ( --interior-only );
        extract       "bin/choupo-thermoml extract-vle <article file> --block 2 --interior-only --into <dir>";
        sha256        "8db3c3e75be1db1795349892dbe44498d2c1c624bf24cce8288a7b43eae73967";
        identity
        {
            Dichloroethane { cas "107-06-2"; inchiKey "WSLDOOZREJYCGB-UHFFFAOYSA-N"; }
            nButanol       { cas "71-36-3"; inchiKey "LRHPLDYGYMQRHN-UHFFFAOYSA-N"; }
        }
    }
);
