        equilibrium.liquid.activityModel.binaryParameters.1Pentanol-cyclohexane.b_ij  -293.6082077;
        equilibrium.liquid.activityModel.binaryParameters.1Pentanol-cyclohexane.b_ji  1185.10772583;
    }

    evidence
    {
        partitionFingerprint  "1c76102d08368fa1";   // frozen before the fit

