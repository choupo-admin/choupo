/*---------------------------------------------------------------------------*\
  curate06_nrtl_isopropanol_water -- AN NRTL PAIR FROM PUBLISHED MEASUREMENTS, END TO END.

  WHY THIS SYSTEM.  the azeotrope the acetone-from-isopropanol tutorials have to break; the fit set's stated uncertainty varies tenfold along x, which is what the uncertainty weighting is for.

  THE CHAIN, EACH STEP A COMMAND (DEV.md C16; record
  docs/design/binary-pairs-from-open-measurements.md):
    1. bin/choupo-thermoml sync        the NIST/TRC ThermoML Archive
                                       (ThermoML.v2020-09-30.tgz, doi
                                       10.18434/mds2-2422, sha256-verified)
    2. bin/choupo-thermoml identity    CAS -> InChIKey for the catalogue,
                                       two resolvers that must agree
    3. bin/choupo-thermoml vle-index   every binary VLE block, searchable
    4. bin/choupo-thermoml vle-search isopropanol water --geometry bubbleT
    5. bin/choupo-thermoml extract-vle <file> --block N --interior-only
                                       -> the two files under constant/experiments/
    6. choupoProps (this case)         fitParameters -> a proposal record
    7. promotion (a human act)         -> data/standards/parameters/NRTL/isopropanol-water.dat
    8. bin/choupo-import               the seal mirrors that record here

  THE EVIDENCE.  FIT: doi 10.1016/j.jct.2017.02.005 (29 interior points, 100 kPa).
  HELD OUT: doi 10.1021/acs.jced.7b00523 (16 interior points, 101.058 kPa) -- a
  different article, so the held-out AAD is a validation, not a slice of
  the fit.  Each file names its article, its archive file and block, the
  sha256 of the archive file, the two compounds' CAS and InChIKey, and the
  per-point expanded uncertainty; each says `reviewStatus
  transcribedNotCheckedAgainstArticle` because nobody has read the numbers
  back against the paper yet, and the run announces it.  Pure-component
  endpoints are set aside (they measure the vapour-pressure record, not the
  pair) and kept in each file under `selection`.

  THE FIT.  NRTL with a_ij = a_ji = 0 and alpha = 0.30 fixed: TWO
  parameters (b_ij, b_ji), because bubble temperatures over the ranges
  below do not identify more (fit_nrtl_ab in the methanol + water case asks
  that question directly).  Each point is weighted by 1/U, U its OWN stated
  expanded uncertainty (`weighting uncertainty;`), so a point measured to
  0.1 K is not outvoted by one measured to 1 K.  The held-out AAD is plain
  kelvin, unweighted.

  WHAT THE RUN FOUND (pinned in `expected`; measured, not argued).
    * fit_nrtl: b_ij = -69.6 K, b_ji = 968.2 K, in-sample rms 0.52 K;
      fit_nrtl_start2 lands on the same pair.  The fit set's stated
      uncertainty runs from 0.13 to 1.35 K along x, so the 1/U weighting
      changes which points the pair is held to.
    * HELD OUT (101.058 kPa, another laboratory): AAD 0.83 K (0.232 %)
      against a band of 0.63 % -> `validated`; the pair is the catalogue
      record NRTL/isopropanol-water.dat.
    * Overlay on the held-out set: NRTL 0.83 K, UNIFAC 1.27 K, ideal 8.2 K.
      The held-out study's own stated uncertainty is 1.6-1.7 K, and the
      catalogue water record boils 0.52 K low at its pressure.

  WHAT IS NOT CLAIMED.  The pair is correct at these pressures and in this
  frame (ideal-gas vapour, the catalogue's Antoine records); nothing here
  tests it at high pressure, against LLE, or with another vapour model.
\*---------------------------------------------------------------------------*/

operations
(
    {
        name        fit_nrtl;
        type        fitParameters;

        parameters
        (
            { path  equilibrium.liquid.activityModel.binaryParameters.isopropanol-water.b_ij;  initial 0;  min -3000;  max 3000; }
            { path  equilibrium.liquid.activityModel.binaryParameters.isopropanol-water.b_ji;  initial 0;  min -3000;  max 3000; }
        );

        evidence
        (
            {
                dataset  "constant/experiments/isopropanol-water-bubble-j.jct.2017.02.005.dat";
                role     fit;
            }
            {
                dataset  "constant/experiments/isopropanol-water-bubble-acs.jced.7b00523.dat";
                role     validation;
            }
        );

        acceptance
        {
            maxAAD  0.63 percent;
            origin  "declared before the fit, by ONE rule applied to all five C16 systems: the held-out set's largest stated expanded uncertainty (U95 = 1.7 K) plus the catalogue vapour-pressure model's own error at that set's pure endpoints (water -0.519 K, isopropanol -0.246 K; measured with no pair involved), as a percentage of the held-out mean T (356.06 K) = 0.6231 %, rounded UP to two significant figures";
        }

        residual
        {
            kind        T_bubble;
            components  ( isopropanol water );
            weighting   uncertainty;
        }

        options
        {
            maxIter      80;
            tolerance    1.0e-8;
            fdStep       1.0e-4;
            lambda0      1.0e-3;
        }

        output
        {
            fit_log    fit_history.csv;
            parity     parity.csv;
            proposal   isopropanol-water.proposal.dat;
        }
    }
    //  THE SAME FIT FROM ANOTHER START.  A least-squares surface can hold
    //  more than one minimum; if this lands where fit_nrtl landed, the pair
    //  is the answer the data hold, not the answer a start point chose.
    {
        name        fit_nrtl_start2;
        type        fitParameters;

        parameters
        (
            { path  equilibrium.liquid.activityModel.binaryParameters.isopropanol-water.b_ij;  initial 800;  min -3000;  max 3000; }
            { path  equilibrium.liquid.activityModel.binaryParameters.isopropanol-water.b_ji;  initial -400;  min -3000;  max 3000; }
        );

        evidence
        (
            {
                dataset  "constant/experiments/isopropanol-water-bubble-j.jct.2017.02.005.dat";
                role     fit;
            }
            {
                dataset  "constant/experiments/isopropanol-water-bubble-acs.jced.7b00523.dat";
                role     validation;
            }
        );

        acceptance
        {
            maxAAD  0.63 percent;
            origin  "declared before the fit, by ONE rule applied to all five C16 systems: the held-out set's largest stated expanded uncertainty (U95 = 1.7 K) plus the catalogue vapour-pressure model's own error at that set's pure endpoints (water -0.519 K, isopropanol -0.246 K; measured with no pair involved), as a percentage of the held-out mean T (356.06 K) = 0.6231 %, rounded UP to two significant figures";
        }

        residual
        {
            kind        T_bubble;
            components  ( isopropanol water );
            weighting   uncertainty;
        }

        options
        {
            maxIter      80;
            tolerance    1.0e-8;
            fdStep       1.0e-4;
            lambda0      1.0e-3;
        }

        output
        {
            parity     parity_start2.csv;
        }
    }
    {
        name        txy_ideal;
        type        propertyScan1D;
        vary        { variable x[isopropanol];  from 0.0;  to 1.0;  n 101; }
        state       { P 101.058 kPa;  composition { isopropanol 0.5;  water 0.5; } }
        thermo
        {
            equilibrium { liquid { activityModel { model ideal; } } }
        }
        properties  ( T_bubble  y_eq_isopropanol );
        output      { file txy_ideal.csv; }
    }
    {
        name        txy_unifac;
        type        propertyScan1D;
        vary        { variable x[isopropanol];  from 0.0;  to 1.0;  n 101; }
        state       { P 101.058 kPa;  composition { isopropanol 0.5;  water 0.5; } }
        thermo
        {
            equilibrium { liquid { activityModel { model UNIFAC; } } }
        }
        properties  ( T_bubble  y_eq_isopropanol );
        output      { file txy_unifac.csv; }
    }
    {
        name        txy_nrtl;
        type        propertyScan1D;
        vary        { variable x[isopropanol];  from 0.0;  to 1.0;  n 101; }
        state       { P 101.058 kPa;  composition { isopropanol 0.5;  water 0.5; } }
        thermo
        {
            equilibrium { liquid { activityModel { model NRTL; /* no inline pair: the catalogue record, sealed copy */ } } }
        }
        properties  ( T_bubble  y_eq_isopropanol );
        output      { file txy_nrtl.csv; }
    }
    {
        name        txy_ideal_fitP;
        type        propertyScan1D;
        vary        { variable x[isopropanol];  from 0.0;  to 1.0;  n 101; }
        state       { P 100 kPa;  composition { isopropanol 0.5;  water 0.5; } }
        thermo
        {
            equilibrium { liquid { activityModel { model ideal; } } }
        }
        properties  ( T_bubble  y_eq_isopropanol );
        output      { file txy_ideal_fitP.csv; }
    }
    {
        name        txy_unifac_fitP;
        type        propertyScan1D;
        vary        { variable x[isopropanol];  from 0.0;  to 1.0;  n 101; }
        state       { P 100 kPa;  composition { isopropanol 0.5;  water 0.5; } }
        thermo
        {
            equilibrium { liquid { activityModel { model UNIFAC; } } }
        }
        properties  ( T_bubble  y_eq_isopropanol );
        output      { file txy_unifac_fitP.csv; }
    }
    {
        name        txy_nrtl_fitP;
        type        propertyScan1D;
        vary        { variable x[isopropanol];  from 0.0;  to 1.0;  n 101; }
        state       { P 100 kPa;  composition { isopropanol 0.5;  water 0.5; } }
        thermo
        {
            equilibrium { liquid { activityModel { model NRTL; /* no inline pair: the catalogue record, sealed copy */ } } }
        }
        properties  ( T_bubble  y_eq_isopropanol );
        output      { file txy_nrtl_fitP.csv; }
    }
);

experimental
(
    {
        name      heldout_isopropanol_water;
        component isopropanol;
        kind      txy;
        models    ( txy_ideal  txy_unifac  txy_nrtl );
        dataset   "constant/experiments/isopropanol-water-bubble-acs.jced.7b00523.dat";
        source    "held out: doi 10.1021/acs.jced.7b00523";
    }
    {
        name      fitset_isopropanol_water;
        component isopropanol;
        kind      txy;
        models    ( txy_ideal_fitP  txy_unifac_fitP  txy_nrtl_fitP );
        dataset   "constant/experiments/isopropanol-water-bubble-j.jct.2017.02.005.dat";
        source    "IN-SAMPLE (the fit set): doi 10.1016/j.jct.2017.02.005";
    }
);
