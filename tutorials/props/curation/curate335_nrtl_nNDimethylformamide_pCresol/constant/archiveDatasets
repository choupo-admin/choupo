        articleSha256 "9f0315d6fee492b6a3c5922dcb1848ea90206d54b1923a4fe327bd591daa1461";
        block         26;
        filter        ( --interior-only );
        extract       "bin/choupo-thermoml extract-vle <article file> --block 26 --interior-only --into <dir>";
        sha256        "4b1535b48c1ba5d8bcb9451d86c9f82f228088170f691517267ed4d11dde212a";
        identity
        {
            nNDimethylformamide { cas "68-12-2"; inchiKey "ZMXDDKWLCZADIW-UHFFFAOYSA-N"; }
            pCresol        { cas "106-44-5"; inchiKey "IWDCLRJOBJJRNH-UHFFFAOYSA-N"; }
        }
