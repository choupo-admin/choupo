(
    {
        file          "constant/archiveExtracts/nNDimethylformamide-pCresol-bubble-j.fluid.2008.01.020.dat";
        role          fit;   // C283: every laboratory is fitted
        doi           "10.1016/j.fluid.2008.01.020";
        url           "https://trc.nist.gov/ThermoML/10.1016/j.fluid.2008.01.020.xml";
        page          "https://trc.nist.gov/ThermoML/10.1016/j.fluid.2008.01.020.json";
