/*--------------------------------*- Choupo -*--------------------------------*\
  constant/archiveDatasets -- WHERE the measurements of curate159_nrtl_benzene_methanol
  come from, and how to regenerate them.  NO MEASURED POINT IS IN THIS TREE
  (Vitor, 2026-11-10: the measured series are not copied; only the fitted
  parameters are kept).  `bin/choupo-curate fetch <case>` writes each
  dataset into constant/archiveExtracts/ (gitignored): the article file is taken from
  the local ThermoML cache when it holds it, else from the NIST URL below,
  and BOTH sha256 sums are checked -- a mismatch refuses, an unreachable
  NIST is reported NOT RUN, never a pass.
\*-----------------------------------------------------------------------------*/

recordType    archiveDatasets;

archive
{
    tarball   "ThermoML.v2020-09-30.tgz";
    doi       "10.18434/mds2-2422";
    note      "the finding aid; each article file is also served one by one at the NIST URL";
}

datasets
(
    {
        file          "constant/archiveExtracts/benzene-methanol-bubble-j.fluid.2019.03.022.dat";
        role          fit;   // C283: every laboratory is fitted
        doi           "10.1016/j.fluid.2019.03.022";
        url           "https://trc.nist.gov/ThermoML/10.1016/j.fluid.2019.03.022.xml";
        page          "https://trc.nist.gov/ThermoML/10.1016/j.fluid.2019.03.022.json";
        articleFile   "j.fluid.2019.03.022.xml";
        articleSha256 "403cce80c8f10e5b36634d0f14afdbfaaf79df47733366051304441025e32dc0";
        block         0;
        filter        ( --interior-only );
        extract       "bin/choupo-thermoml extract-vle <article file> --block 0 --interior-only --into <dir>";
        sha256        "9669410f9c4acd7ba892d1b5349c97b8e65329a6963a9b63fbac6eac23f29ae2";
        identity
        {
            benzene        { cas "71-43-2"; inchiKey "UHOVQNZJYSORNB-UHFFFAOYSA-N"; }
            methanol       { cas "67-56-1"; inchiKey "OKKJLVBELUTLKV-UHFFFAOYSA-N"; }
        }
    }
    {
        file          "constant/archiveExtracts/benzene-methanol-bubble-j.jct.2006.06.002.dat";
        role          fit;   // C283: every laboratory is fitted
        doi           "10.1016/j.jct.2006.06.002";
        url           "https://trc.nist.gov/ThermoML/10.1016/j.jct.2006.06.002.xml";
        page          "https://trc.nist.gov/ThermoML/10.1016/j.jct.2006.06.002.json";
        articleFile   "j.jct.2006.06.002.xml";
        articleSha256 "07a8e406199bcaeb30b2a918bd5f38a9c8373e5ca928c93aff166a9c3f4f131f";
        block         2;
        filter        ( --interior-only );
        xOf           benzene;   // the article reports the other member; x = 1 - x'
        extract       "bin/choupo-thermoml extract-vle <article file> --block 2 --interior-only --x-of benzene --into <dir>";
        sha256        "57c92b3bcc4e19391bc6a77c16f07a45b8650be9791f76457058c0eaa1f6ebaf";
        identity
        {
            benzene        { cas "71-43-2"; inchiKey "UHOVQNZJYSORNB-UHFFFAOYSA-N"; }
            methanol       { cas "67-56-1"; inchiKey "OKKJLVBELUTLKV-UHFFFAOYSA-N"; }
        }
    }
);
