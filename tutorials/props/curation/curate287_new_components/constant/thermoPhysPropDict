/*  The eight components DEV.md 4c C287 added; an ideal liquid, because
    every property this case asks is a pure-component one.  NOT sealed:
    the case exists to load the catalogue records as they stand.  */

recordType    thermophysicalPropertySystem;
schemaVersion 2;

components       ( 2Ethoxyethanol  ethylOctanoate  13Propanediol  13Butanediol  16Hexanediol  allylAlcohol  33Oxydipropanol  methylLevulinate );

equilibrium
{
    formulation gammaPhi;
    liquid { activityModel { model ideal; } }
    vapour { fugacityModel idealGas; }
}
