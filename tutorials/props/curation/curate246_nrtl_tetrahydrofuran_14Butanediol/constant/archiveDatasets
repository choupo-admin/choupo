        articleSha256 "afab8c6467e07b453f9e7b12210b6a8fafc7f8efb80500ce6fbc236f1cb1d41d";
        block         8;
        filter        ( --interior-only );
        extract       "bin/choupo-thermoml extract-vle <article file> --block 8 --interior-only --into <dir>";
        sha256        "23064f7ec26aceed1276403c6c9e3809951f4d6993367105a8c0af71af1462ac";
        identity
        {
            tetrahydrofuran { cas "109-99-9"; inchiKey "WYURNTSHIVDZCO-UHFFFAOYSA-N"; }
