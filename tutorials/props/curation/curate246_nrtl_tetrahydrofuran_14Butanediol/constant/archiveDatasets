        file          "constant/archiveExtracts/tetrahydrofuran-14Butanediol-bubble-acs.jced.7b00584.dat";
        role          fit;   // C283: every laboratory is fitted
        doi           "10.1021/acs.jced.7b00584";
        url           "https://trc.nist.gov/ThermoML/10.1021/acs.jced.7b00584.xml";
        page          "https://trc.nist.gov/ThermoML/10.1021/acs.jced.7b00584.json";
