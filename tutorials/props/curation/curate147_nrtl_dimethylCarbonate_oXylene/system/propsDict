/*---------------------------------------------------------------------------*\
  curate147_nrtl_dimethylCarbonate_oXylene -- AN NRTL PAIR FROM EVERY LABORATORY'S MEASUREMENTS.

  WRITTEN BY bin/choupo-curate pair dimethylCarbonate oXylene (DEV.md 4c C284, the bulk run;
  record docs/design/binary-pairs-from-open-measurements.md section 11).

  THE DECLARATION -- WRITTEN AND COMMITTED BEFORE ANY FIT RAN (several
  declarations of the bulk run share one commit).

  IDENTITY.  dimethylCarbonate (CAS 616-38-6, InChIKey IEJIGPNLZYLLBP-UHFFFAOYSA-N)
  + oXylene (CAS 95-47-6, InChIKey CTQNGGLPUBDAKN-UHFFFAOYSA-N), joined
  to the archive through identity.json -- never by name.  CLASS (C284): both
  records are volatile molecular liquids (no role nonvolatile/solute, no
  dissociatesTo, no charge, no solid, a vapour-pressure model), and every
  measured temperature lies below both critical temperatures.

  NO MEASURED SERIES IN THIS TREE.  constant/archiveDatasets names each
  dataset (DOI, NIST URL, article sha256, extraction selector, extract
  sha256); `bin/choupo-curate fetch` writes the points into
  constant/archiveExtracts/, which is gitignored.

  STUDIES: every bubble-temperature block of the pair at or below 110 kPa
  with a declared uncertainty (2 block(s)).  FITTED, ALL OF THEM
  (2):
      10.1021/acs.jced.9b00414       block 7    18 pts  101.3 kPa  364.68-414.43 K  U 0.27-2.01 K
      10.1021/acs.jced.7b00372       block 21   11 pts  93.13 kPa  361.48-404.50 K  U 0.24-1.07 K
        (reports x of the other member: written as x[dimethylCarbonate] = 1 - x by --x-of)
  SET ASIDE BY THE EXTRACTION RULES, BY NAME:
      (none)

  THE RULE (DEV.md 4c C283 amended, C284).  Every laboratory above is
  fitted; none is held out (the C16 partition and its band are retired as
  the acceptance test).  NRTL, a_ij = a_ji = 0, alpha = 0.30 fixed: two
  parameters (b_ij, b_ji); each point weighted by 1/U, U its own stated
  expanded uncertainty.  Objective twoStage (least squares, then minimax;
  T_bubble absolute, in K).  OUTLIERS: after a least-squares stage over every
  point, a point with |T_model - T| > 3 K is discarded BY
  NAME (`discard` on its evidence entry, listed below) and the fit repeated
  without it.
  THE GRADED ACCEPTANCE (DEV.md 4c C285, applied to pairs by C286): max
  |T_model - T| over the KEPT points is GRADED -- clean up to 1 K,
  warning up to 2 K, severe up to 4 K, refused above; a point with no
  bubble point refuses. C283's relative clause (5 / 10 / 20 %) judges
  composition; this fit has no composition residual, so only the
  temperature clause applies. Every grade but refused is accepted and
  promoted (autoPromoted, humanReviewed false) with `fitGrade` and its
  max |dT| in the record's provenance; the engine voices a warning or a
  severe grade on every run that reads the pair. A pair that splits ONE
  liquid inside its validity span is not promoted, whatever its grade
  (arm f).
  Two starts: (0, 0) and (800, -400).

  OUTLIERS DISCARDED AFTER THE LEAST-SQUARES STAGE:
  @@OUTLIERS-BEGIN@@
      5 point(s) of 29: doi 10.1021/acs.jced.7b00372 row 7: x 0.4130, P
      93.130 kPa, T 374.88 K, dT -3.03 K; doi 10.1021/acs.jced.7b00372
      row 8: x 0.2655, P 93.130 kPa, T 382.02 K, dT -4.32 K; doi
      10.1021/acs.jced.7b00372 row 9: x 0.1574, P 93.130 kPa, T 390.84 K,
      dT -5.37 K; doi 10.1021/acs.jced.7b00372 row 10: x 0.0975, P 93.130
      kPa, T 397.46 K, dT -4.89 K; doi 10.1021/acs.jced.7b00372 row 11: x
      0.0502, P 93.130 kPa, T 404.50 K, dT -3.61 K
  @@OUTLIERS-END@@

  @@RESULT-BEGIN@@
  WHAT THE RUN FOUND (pinned in `expected`; measured, not argued).
  fit_nrtl: b_ij = 36.1 K, b_ji = 481.2 K over 24 kept points of 2
  laboratories (5 discarded): max |dT| 4.241 K, mean 1.741 K, graded
  refused (limits 1 / 2 / 4 K) -> notAccepted. fit_nrtl_start2 lands on
  the same pair (36.1, 481.2). NOT PROMOTABLE: fit grade refused -- max
  |dT| 4.241 K over the 24 kept points is above 4 K
  @@RESULT-END@@

  EARLIER FITS, SUPERSEDED BY THIS DECLARATION
  @@EARLIER-BEGIN@@
  C283 amended + C284, the bulk run of 2026-11-10: every laboratory
  fitted, outliers beyond 3 K discarded by name, accepted only below 1 K
  (superseded by the graded acceptance of C285, applied to pairs by C286;
  this declaration keeps the same studies, the same outlier rule and the
  same discards -- nothing re-partitioned): WHAT THE RUN FOUND (pinned in
  `expected`; measured, not argued). fit_nrtl: b_ij = 36.1 K, b_ji =
  481.2 K over 24 kept points of 2 laboratories (5 discarded): max |dT|
  4.241 K, mean 1.741 K against the acceptance 1 K -> notAccepted.
  fit_nrtl_start2 lands on the same pair (36.1, 481.2). NOT PROMOTABLE:
  max |dT| 4.241 K over the 24 kept points is not below 1 K
  @@EARLIER-END@@

  WHAT IS NOT CLAIMED.  The pair is correct at these pressures and in this
  frame (ideal-gas vapour, the catalogue's own vapour-pressure records); the
  measurements were transcribed by the archive and have NOT been read back
  against the articles (the CHECKLIST that `fetch` writes is the aid).
\*---------------------------------------------------------------------------*/

operations
(
    {
        name        fit_nrtl;
        type        fitParameters;

        parameters
        (
            { path  equilibrium.liquid.activityModel.binaryParameters.dimethylCarbonate-oXylene.b_ij;  initial 0;  min -3000;  max 3000; }
            { path  equilibrium.liquid.activityModel.binaryParameters.dimethylCarbonate-oXylene.b_ji;  initial 0;  min -3000;  max 3000; }
        );

        evidence
        (
            {
                dataset  "constant/archiveExtracts/dimethylCarbonate-oXylene-bubble-acs.jced.9b00414.dat";
                role     fit;
            }
            {
                dataset  "constant/archiveExtracts/dimethylCarbonate-oXylene-bubble-acs.jced.7b00372.dat";
                role     fit;
                discard  ( 7 8 9 10 11 );   // C283 outliers, by name in the header
            }
        );

        objective { method twoStage;  scale { T_bubble absolute; } }
        residual
        {
            kind        T_bubble;
            components  ( dimethylCarbonate oXylene );
            weighting   uncertainty;
        }

        options
        {
            maxIter      80;
            tolerance    1.0e-6;
            fdStep       1.0e-4;
            lambda0      1.0e-3;
        }

        output
        {
            fit_log    fit_history.csv;
            parity     parity.csv;
            proposal   dimethylCarbonate-oXylene.proposal.dat;
        }
    }
    {
        name        fit_nrtl_start2;
        type        fitParameters;

        parameters
        (
            { path  equilibrium.liquid.activityModel.binaryParameters.dimethylCarbonate-oXylene.b_ij;  initial 800;  min -3000;  max 3000; }
            { path  equilibrium.liquid.activityModel.binaryParameters.dimethylCarbonate-oXylene.b_ji;  initial -400;  min -3000;  max 3000; }
        );

        evidence
        (
            {
                dataset  "constant/archiveExtracts/dimethylCarbonate-oXylene-bubble-acs.jced.9b00414.dat";
                role     fit;
            }
            {
                dataset  "constant/archiveExtracts/dimethylCarbonate-oXylene-bubble-acs.jced.7b00372.dat";
                role     fit;
                discard  ( 7 8 9 10 11 );   // C283 outliers, by name in the header
            }
        );

        objective { method twoStage;  scale { T_bubble absolute; } }
        residual
        {
            kind        T_bubble;
            components  ( dimethylCarbonate oXylene );
            weighting   uncertainty;
        }

        options
        {
            maxIter      80;
            tolerance    1.0e-6;
            fdStep       1.0e-4;
            lambda0      1.0e-3;
        }

        output
        {
            parity     parity_start2.csv;
        }
    }
    {
        name        txy_ideal;
        type        propertyScan1D;
        vary        { variable x[dimethylCarbonate];  from 0.0;  to 1.0;  n 101; }
        state       { P 101.3 kPa;  composition { dimethylCarbonate 0.5;  oXylene 0.5; } }
        thermo
        {
            equilibrium { liquid { activityModel { model ideal; } } }
        }
        properties  ( T_bubble  y_eq_dimethylCarbonate );
        output      { file txy_ideal.csv; }
    }
    {
        name        txy_nrtl;
        type        propertyScan1D;
        vary        { variable x[dimethylCarbonate];  from 0.0;  to 1.0;  n 101; }
        state       { P 101.3 kPa;  composition { dimethylCarbonate 0.5;  oXylene 0.5; } }
        thermo
        {
            equilibrium { liquid { activityModel { model NRTL; /* no inline pair: the case's own record */ } } }
        }
        properties  ( T_bubble  y_eq_dimethylCarbonate );
        output      { file txy_nrtl.csv; }
    }
);

experimental
(
    {
        name      study1;
        component dimethylCarbonate;
        kind      txy;
        models    ( txy_ideal  txy_nrtl );
        dataset   "constant/archiveExtracts/dimethylCarbonate-oXylene-bubble-acs.jced.9b00414.dat";
        source    "IN-SAMPLE (fitted): doi 10.1021/acs.jced.9b00414";
    }
);
