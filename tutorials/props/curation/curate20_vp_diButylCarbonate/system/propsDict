operations
(
    {
        name       fit_antoine;
        type       vaporPressureFit;
        component  diButylCarbonate;

        evidence
        (
            {
                dataset   "constant/archiveExtracts/diButylCarbonate-vapourPressure-acs.jced.6b00517.dat";
                identity  { doi "10.1021/acs.jced.6b00517"; }
                role      fit;
            }
            {
                dataset   "constant/archiveExtracts/diButylCarbonate-vapourPressure-j.jct.2008.02.012.dat";
                identity  { doi "10.1016/j.jct.2008.02.012"; }
                role      fit;
            }
        );

        objective  { method twoStage; }
        outliers   { maxRelativeError 15 percent; }

        output     { file fit_antoine.csv; }
    }
);
