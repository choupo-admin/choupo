    fittedParameters
    {
        equilibrium.liquid.activityModel.binaryParameters.1Propanol-dimethylSulfoxide.b_ij  -469.384384616;
        equilibrium.liquid.activityModel.binaryParameters.1Propanol-dimethylSulfoxide.b_ji  358.928724772;
    }

    evidence
    {
        partitionFingerprint  "e4898e84f188c70b";   // frozen before the fit

        datasets
        (
        {
