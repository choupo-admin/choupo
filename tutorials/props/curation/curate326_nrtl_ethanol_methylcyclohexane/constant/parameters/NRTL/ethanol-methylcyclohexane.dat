/*---------------------------------------------------------------------------*\
  NRTL binary interaction parameters --- ethanol(i) + methylcyclohexane(j)

  REGRESSED BY CHOUPO'S CURATION PIPELINE (bin/choupo-curate, DEV.md 4c C282;
  record docs/design/binary-pairs-from-open-measurements.md) to measured
  bubble temperatures.  The articles named under `evidence` are the
  SOURCE of the measurements; the NIST/TRC ThermoML Archive located them.
  NO MEASURED POINT IS IN THIS RECORD OR THIS TREE: the case regenerates
  them from the DOIs and sha256 sums it declares (constant/archiveDatasets).
  The PARAMETERS are Choupo's own work.

  EQUATION: tau_ij = a_ij + b_ij / T [b in K], G_ij = exp(-alpha tau_ij),
  Renon & Prausnitz direction (src/thermo/activityCoefficient/NRTL.cpp).
  a_ij = a_ji = 0 and alpha = 0.30 FIXED, not fitted.
  FRAME: ideal-gas vapour, no Poynting term, the catalogue's own
  vapour-pressure records for both pure components.

  reviewStatus interim: a case-local record, regressed and not read back.  Fitted on EVERY laboratory (C283), so the
  `validation {}` block below says, truthfully, that nothing
  was held out; the acceptance is the `curation {}` block.
  NOT PROMOTABLE (fit grade warning, max |dT| 1.128 K): the pair splits
  ONE liquid inside its own validity span (check_regressed_pairs arm f)
  -- predicts a LIQUID-LIQUID SPLIT at 345.30 K (x_ethanol 0.199 ..
  0.538), inside its own validity span 345.3-368.84 K -- its evidence is
  bubble temperatures of ONE liquid, which a bubble scan cannot
  contradict; a pair that splits that liquid stays in its case, not the
  catalogue (or it DECLARES `liquidLiquid true;` with tie-line evidence
  and a gap band) -- it rests on ONE laboratory's measurements (doi
  10.1021/je0342318); nothing here tells its systematic error from the
  model's (DEV.md 4c C290)

  REPRODUCE: run tutorials/props/curation/curate326_nrtl_ethanol_methylcyclohexane (after `bin/choupo-curate fetch` on it); its fit
  writes ethanol-methylcyclohexane.proposal.dat, which bin/curate/check_regressed_pairs.py holds
  equal to this record.
\*---------------------------------------------------------------------------*/

recordType binaryInteractionParameters;
schemaVersion 1;

pair { i ethanol; j methylcyclohexane; }

components  ( ethanol  methylcyclohexane );
model       NRTL;

parameters
{
    i           ethanol;
    j           methylcyclohexane;
    a_ij        0.00000000;
    b_ij        242.59274453;
    a_ji        0.00000000;
    b_ji        700.97329189;
    alpha       0.30000000;
}

provenance
{
    origin        fitted;
    method        "fitParameters(T_bubble), Levenberg-Marquardt";
    methodVersion "choupoProps Choupo-dev";
    fittedInCase  "tutorials/props/curation/curate326_nrtl_ethanol_methylcyclohexane";
    reviewStatus  interim;
    reviewReason  "regressed by bin/choupo-curate from archive-transcribed measurements; not yet read back against the articles";
    reuse         "Choupo's own regression; the measured points belong to the cited articles and are not reproduced in this record or this tree";
    fitDate       "2026-11-10";

    evidence
    (
        {
            role      fit;
            dataset   "constant/archiveExtracts/ethanol-methylcyclohexane-bubble-je0342318.dat";
            doi       "10.1021/je0342318";
            sha256    "0492f83334fe3a1cc389cb995b0f7bdc5bd5685169051b34899c5c379d63324e";
            provenance measured;
            archiveFile "je0342318.xml";
            system    "ethanol + methylcyclohexane";
            pressure  "101300.000000 Pa";
        }
    );
    fingerprint "d6660aea85daaeb6";   // of the declaration, frozen before the fit

    //  IN-SAMPLE: the model reproducing the very points it was
    //  fitted to.  It is NOT a validation; see the block below.
    weighting     uncertainty;   // chi2 is sum ((T_model - T_exp)/U)^2, dimensionless
    chi2          22.59142209;
    rms_K         0.71296933;
    nDataPoints   22;
    identifiable  true;
    maxAbsCorr    0.90305464;

    validity
    {
        temperature { min 345.30 K; max 368.84 K; }
        pressure    { min 101300 Pa; max 101300 Pa; }
        note        "the span of the FIT evidence; outside it the pair is an extrapolation";
    }
}

validation
{
    verdict     validationRefused;

    heldOut     none;   // every declared dataset carried `role fit`

    acceptance  none;   // no band was declared before the fit, so no
                        // pass/fail may be read out of the residual above
}

curation
{
    rule            "DEV.md 4c C283 (amended) + C284, graded by C285 (C286)";
    evidence        allLaboratories;   // every study fitted, none held out
    objective       twoStage;
    outlierLimit    3 K;   // |T_model - T| after the least-squares stage
    outliersDropped 0;
    pointsKept      22;
    noBubblePoint   0;
    maxAbsError     1.1283 K;
    meanAbsError    0.6577 K;
    acceptance      graded;   // max |T_model - T| over the kept points, DEV.md 4c C285 (C286)
    gradeLimits_K   (1 2 4);   // upper limits of clean / warning / severe; above, refused
    grade           warning;
    oneLiquid       false;   // arm (f) over the validity span; a pair that splits ONE liquid is never promoted, whatever its grade
    laboratories    1;   // studies with a kept point; the pair rests on ONE laboratory's measurements (DEV.md 4c C290)
    verdict         accepted;
}
