/*--------------------------------------------------------------------------*\
  ETHANOL + WATER BUBBLE POINTS AT 101.3 kPa -- ONE SERIES, 14 INTERIOR POINTS.

  Measured bubble temperature and vapour composition of ethanol (1) + water
  (2) at 101.3 kPa, from the ethanol + water block of

    Lai, H.-S.; Lin, Y.-F.; Tu, C.-H. (2014).  Isobaric (vapor + liquid)
    equilibria for the ternary system of (ethanol + water + 1,3-propanediol)
    and three constituent binary systems at P = 101.3 kPa.
    J. Chem. Thermodyn.  doi:10.1016/j.jct.2013.08.020

  Located through the NIST/TRC ThermoML Archive (a finding aid; see
  thirdParty/thermoml/README.md) and extracted by

    bin/choupo-thermoml extract-vle 10.1016/j.jct.2013.08.020.xml --block 8 \
        --x-of ethanol --interior-only

  (the two pure-component endpoints are set aside, see `selection`).  The
  numbers are the article's; the archive's arrangement is not reproduced.

  ONE FILE, TWO ROLES.  The split lives in system/propsDict, not here: the
  fit evidence entry sets rows 3, 6, 9, 12 aside BY NAME (`discard`) and the
  validation entry sets the other ten aside, so no number is transcribed twice
  and the engine's guard (the same sha256 cannot be both roles) is satisfied
  by rows, not by a copy.  THE RULE, written before anything was fitted:
  number the points 1..14 by increasing x; every THIRD point (x1 = 0.1000,
  0.3940, 0.6310, 0.8480) is HELD OUT.  The azeotrope (x1 about 0.89, row 13)
  is in the fit.

  Column names are the ones the `experimental {}` overlay draws against a
  propertyScan1D AND the ones fitParameters(T_bubble) reads.
\*--------------------------------------------------------------------------*/

property     binaryVLE.T_bubble;
system       ( ethanol water );
pressure     101.3 kPa;

provenance
{
    source       measured;
    reviewStatus transcribedNotCheckedAgainstArticle;
    citation     "Lai, H.-S.; Lin, Y.-F.; Tu, C. -H. (2014). Isobaric (vapor + liquid) equilibria for the ternary system of (ethanol + water + 1,3-propanediol) and three constituent binary systems at P = 101.3 kPa. J. Chem. Thermodyn. doi:10.1016/j.jct.2013.08.020";
    archiveFile  "j.jct.2013.08.020.xml";
    archive      "ThermoML.v2020-09-30.tgz (NIST/TRC ThermoML Archive, doi:10.18434/mds2-2422)";
    block        8;
    doi          "10.1016/j.jct.2013.08.020";
    sha256       "9ade859fa53eb443bb45a75f14e742056f0fb137bbfdf5fdc93dfa05d614a11a";
    identity
    {
        ethanol        { cas "64-17-5"; inchiKey "LFQSCWFLJHTTHZ-UHFFFAOYSA-N"; }
        water          { cas "7732-18-5"; inchiKey "XLYOFNOQVPJJNP-UHFFFAOYSA-N"; }
        rule           "the archive's standard InChIKey matched to the catalogue record's CAS through two resolvers that agree (PubChem PUG REST and NCI CACTUS), molecular formula checked -- never by name";
    }
}

uncertainty
{
    T_bubble
    {
        kind    expandedCombined;   // ThermoML nCombExpandUncertValue
        level   95;            // per cent confidence
        unit    K;
        values  ( 0.45 0.25 0.18 0.14 0.14 0.13 0.13 0.13 0.13 0.13 0.13 0.13 0.13 0.13 );   // per point, in `data` order
    }
}

selection
{
    //  A bubble point on a PURE component measures the vapour-pressure
    //  correlation, not the pair: the pair parameters have no effect
    //  there.  Set aside, not deleted -- the values stay here.
    pureEndpoints
    (
        { x 0; T_bubble 373.15 K; }
        { x 1; T_bubble 351.45 K; }
    );
}

columns
(
    { name x[ethanol];  unit -;  }
    { name T_bubble;  unit K;  }
    { name y_eq_ethanol;  unit -;  }
);

data
(
      0.0150  369.27  0.1390
      0.0350  365.61  0.2610
      0.1000  359.79  0.4360
      0.1830  356.66  0.5250
      0.2920  354.88  0.5850
      0.3940  353.89  0.6110
      0.5010  353.06  0.6480
      0.5430  352.73  0.6690
      0.6310  352.04  0.7140
      0.7490  351.67  0.7810
      0.7940  351.64  0.8140
      0.8480  351.4  0.8550
      0.8990  351.33  0.8980
      0.9490  351.37  0.9460
);
