/*--------------------------------*- Choupo -*--------------------------------*\
  CURATION DOSSIER -- a scientific work record, NOT runtime property data.

  NOTHING IN THIS FILE IS VISIBLE TO THE SOLVER.  Record resolution looks only
  in <case>/constant/, data/standards/ and data/local/, so a file here is out
  of its reach BY CONSTRUCTION -- not by convention.

  Nothing here has been promoted.  Curation state belongs to the evidence
  process; runtime trust belongs to the numerical record actually admitted
  to data/standards/, and only an explicit human promotion moves one there
  (bin/curate/promote-from-dossier).

  MATURITY IS PER PROPERTY, not per component: the properties below may hold
  different verdicts, and any whole-component summary is DERIVED from them
  rather than stored beside them.

  Regenerated on every run.  Hand edits are lost.
\*-----------------------------------------------------------------------------*/

component      ethanol;
reviewStatus   unreviewed;

properties
(
{
    property       binaryVLE.T_bubble;
    operation      nrtl_etoh_water_heldout;   // type fitParameters
    model          "NRTL binary pair, bubble-T residual at fixed P";
    verdict        validated;

    fittedParameters
    {
        equilibrium.liquid.activityModel.binaryParameters.ethanol-water.b_ij  -66.1593780164;
        equilibrium.liquid.activityModel.binaryParameters.ethanol-water.b_ji  684.045431048;
    }

    evidence
    {
        partitionFingerprint  "076762932517cc0c";   // frozen before the fit

        datasets
        (
        {
            role      fit;
            dataset   "constant/experiments/etoh-water-bubble-lai2014.dat";
            doi       "10.1016/j.jct.2013.08.020";
            sha256    "9ade859fa53eb443bb45a75f14e742056f0fb137bbfdf5fdc93dfa05d614a11a";
            provenance measured;
            archiveFile "j.jct.2013.08.020.xml";
            system    "ethanol + water";
            pressure  "101300.000000 Pa";
        }
        {
            role      validation;
            dataset   "constant/experiments/etoh-water-bubble-lai2014.dat";
            doi       "10.1016/j.jct.2013.08.020";
            sha256    "9ade859fa53eb443bb45a75f14e742056f0fb137bbfdf5fdc93dfa05d614a11a";
            provenance measured;
            archiveFile "j.jct.2013.08.020.xml";
            system    "ethanol + water";
            pressure  "101300.000000 Pa";
        }
        );

        domain
        {
            coordinate  x1;
            fit         { min 0.015; max 0.949; n 10; }
            validation  { min 0.1; max 0.848; n 4; }
        }
    }

    metrics
    {
        //  r2InSample: not computed by this operation (it reports chi-square).
        //  rmsHeldOut: not computed by this operation (see aadHeldOutPct).
        aadHeldOutPct     0.0362379363438;
        acceptanceMaxAADPct 0.061;   // DECLARED BEFORE the fit; part of the fingerprint
        acceptanceOrigin  "declared before the fit, by the rule curate04 applies to its systems: the held-out set's largest stated expanded uncertainty (U95 = 0.18 K) plus the catalogue vapour-pressure models' own error at the pure endpoints of the series (water -0.033 K, ethanol -0.003 K; measured with no pair involved, from the Raoult scan at x = 0 and 1), as a percentage of the held-out mean T (354.28 K) = 0.0601 %, rounded UP to two significant figures";
    }
}

);
