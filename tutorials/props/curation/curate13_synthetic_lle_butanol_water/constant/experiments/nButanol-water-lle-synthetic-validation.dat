/*---------------------------------------------------------------------------*\
  SYNTHETIC DATASET -- generated, not measured.  Five tie lines, 288-358 K, the HELD-OUT set (other temperatures than the fit set).

  Produced by RUNNING Choupo's own engine (propertyScanBinary, the
  liquid-liquid flash) on a water + 1-butanol pair of KNOWN parameters
  (NRTL, alpha 0.30, a_ij = a_ji = 0, b_ij = 150 K, b_ji = 1050 K,
  i = nButanol, j = water) -- see system/propsDict.  Each row is a TIE
  LINE: the mole fraction of 1-butanol in the two coexisting liquids at T,
  the water-rich one in `phase1`, the butanol-rich one in `phase2` (the
  residual matches them by order and never needs the labels).  No
  laboratory value, no third-party datum and no archive file is involved;
  licence GPL-3.0-or-later.  The real water + 1-butanol binodal is still
  TO DO: it needs measured tie lines, which this tree does not hold.
\*---------------------------------------------------------------------------*/

property     binaryLLE.binodal;
system       ( nButanol water );

provenance
{
    source  synthetic;   // GENERATED by the engine from known parameters --
                         // never measured (a field the engine reads)
    note    "structural fixture: proves the mixed T_bubble + liquid-liquid residual recovers known parameters, not physics";
}

columns
(
    { name T;                    unit K;  }
    { name x_nButanol_phase1;    unit -;  }
    { name x_nButanol_phase2;    unit -;  }
);

data
(
      288.15  0.0194888166  0.683164899
      298.15  0.0230903965  0.674546147
      318.15  0.031737487  0.654923474
      338.15  0.0426478488  0.63200105
      358.15  0.056359357  0.60544321
);
