/*---------------------------------------------------------------------------*\
  curate13_synthetic_lle_butanol_water -- BUBBLE TEMPERATURES AND TIE LINES IN
  ONE FIT, on a pair whose parameters are KNOWN (DEV.md 4c C226 A1).

  WHAT THIS IS.  A SYNTHETIC witness, labelled as such everywhere it can be:
  the four datasets under constant/experiments/ were GENERATED by running
  Choupo's own engine (propertyScan1D for T_bubble at 101.325 kPa,
  propertyScanBinary for the binodal) on a water + 1-butanol NRTL pair of
  known parameters (alpha 0.30, a_ij = a_ji = 0, b_ij = 150 K, b_ji = 1050 K,
  i = nButanol, j = water).  No laboratory measurement is involved, so this
  case shows that the machinery recovers what it was given and nothing about
  water + 1-butanol itself.  THE REAL PAIR IS STILL TO DO: it needs measured
  tie lines (a ThermoML LLE series, or a published table read by a curator),
  and the cache that would locate them lives outside this tree.

  WHY ONE FIT.  A partially miscible pair has two kinds of evidence about the
  same two numbers: where its boiling liquid sits (T_bubble) and where its two
  liquids sit (the binodal).  A pair regressed to the first alone is free to
  split the liquid wherever it likes or not at all (C16 slice 2:
  ethanol + cyclohexane, validated and splitting its whole span).  The second
  is the measurement that pins the gap.  `kind T_bubble+LLE` adds one row per
  measured binodal composition (x_model - x_measured)/sigma to the bubble rows
  (T_model - T_measured)/U, so a single chi2 weighs both, with the weights the
  author declared -- `weighting uncertainty` for the kelvin rows, and
  `liquidLiquid { sigma }` for the mole-fraction rows.

  THE RULE C16 ALREADY HAS, REUSED.  Fit on one set of datasets, test on
  others the fitter is never handed, with the bands declared BEFORE the fit
  (`maxAAD` for the bubble temperatures, `maxLLE` for the binodal), and a
  verdict.  A held-out tie line the fitted model leaves as ONE liquid is
  named on stderr and is a miss, never a skip.

  THE START.  The inline pair of constant/thermoPhysPropDict (b_ij 0, b_ji
  1000) splits the liquid at every tie line.  A start that splits nothing
  (ideal mixing) is REFUSED by name: the penalty for a missing split is flat,
  so the search would have no gradient.

  WHAT THE RUN SHOWS (pinned in `expected`).  Both starts recover b_ij and
  b_ji of the generating pair to round-off, and the held-out bubble
  temperatures and tie lines are reproduced to round-off: the band-judged
  verdict is `validated`.  That is arithmetic, not evidence about water +
  1-butanol -- the data come from the model.
\*---------------------------------------------------------------------------*/

operations
(
    {
        name        fit_mixed;
        type        fitParameters;

        parameters
        (
            { path  equilibrium.liquid.activityModel.binaryParameters.nButanol-water.b_ij;  initial 0;  min -3000;  max 3000; }
            { path  equilibrium.liquid.activityModel.binaryParameters.nButanol-water.b_ji;  initial 1000;  min -3000;  max 3000; }
        );

        evidence
        (
            { dataset  "constant/experiments/nButanol-water-bubble-synthetic-fit.dat";         role fit; }
            { dataset  "constant/experiments/nButanol-water-lle-synthetic-fit.dat";            role fit; }
            { dataset  "constant/experiments/nButanol-water-bubble-synthetic-validation.dat";  role validation; }
            { dataset  "constant/experiments/nButanol-water-lle-synthetic-validation.dat";     role validation; }
        );

        acceptance
        {
            maxAAD  0.1 percent;
            maxLLE  0.01;
            origin  "declared before the fit, for a SYNTHETIC zero-noise recovery: 0.1 % of T (about 0.4 K, twice the declared 0.2 K standard uncertainty of a bubble point) and 0.01 in mole fraction (twice the declared sigma of a binodal composition).  The data are generated from the model, so the true deviation is round-off; the bands are generous on purpose and the gate (check_lle_residual) holds the recovery to 1e-5, not these.";
        }

        //  C280: pinned to the least-squares objective (this case's header and golden are a least-squares result).
        objective { method leastSquares; scale { binodal absolute; } }
        residual
        {
            kind        T_bubble+LLE;
            components  ( nButanol water );
            weighting   uncertainty;
            liquidLiquid
            {
                sigma   0.005;
                origin  "declared by this case: one standard uncertainty of a binodal mole fraction, 0.005, the scale at which 0.2 K of bubble temperature and a tie-line composition weigh alike for this pair (a stated choice, not a measurement)";
            }
        }

        options
        {
            maxIter      120;
            tolerance    0.3;       // ZERO-NOISE data: chi2 reaches round-off (4e-9, then 3e-9) and a rejected step can never meet a smaller relative change; 0.3 stops at the first step that only polishes round-off
            fdStep       1.0e-5;
            lambda0      1.0e-3;
        }

        output
        {
            fit_log    fit_mixed_history.csv;
            parity     fit_mixed_parity.csv;
            proposal   nButanol-water.proposal.dat;
        }
    }
    {
        name        fit_mixed_start2;
        type        fitParameters;

        parameters
        (
            { path  equilibrium.liquid.activityModel.binaryParameters.nButanol-water.b_ij;  initial 400;  min -3000;  max 3000; }
            { path  equilibrium.liquid.activityModel.binaryParameters.nButanol-water.b_ji;  initial 1400;  min -3000;  max 3000; }
        );

        evidence
        (
            { dataset  "constant/experiments/nButanol-water-bubble-synthetic-fit.dat";         role fit; }
            { dataset  "constant/experiments/nButanol-water-lle-synthetic-fit.dat";            role fit; }
            { dataset  "constant/experiments/nButanol-water-bubble-synthetic-validation.dat";  role validation; }
            { dataset  "constant/experiments/nButanol-water-lle-synthetic-validation.dat";     role validation; }
        );

        acceptance
        {
            maxAAD  0.1 percent;
            maxLLE  0.01;
            origin  "declared before the fit, for a SYNTHETIC zero-noise recovery: 0.1 % of T (about 0.4 K, twice the declared 0.2 K standard uncertainty of a bubble point) and 0.01 in mole fraction (twice the declared sigma of a binodal composition).  The data are generated from the model, so the true deviation is round-off; the bands are generous on purpose and the gate (check_lle_residual) holds the recovery to 1e-5, not these.";
        }

        //  C280: pinned to the least-squares objective (this case's header and golden are a least-squares result).
        objective { method leastSquares; scale { binodal absolute; } }
        residual
        {
            kind        T_bubble+LLE;
            components  ( nButanol water );
            weighting   uncertainty;
            liquidLiquid
            {
                sigma   0.005;
                origin  "declared by this case: one standard uncertainty of a binodal mole fraction, 0.005, the scale at which 0.2 K of bubble temperature and a tie-line composition weigh alike for this pair (a stated choice, not a measurement)";
            }
        }

        options
        {
            maxIter      120;
            tolerance    0.3;       // ZERO-NOISE data: chi2 reaches round-off (4e-9, then 3e-9) and a rejected step can never meet a smaller relative change; 0.3 stops at the first step that only polishes round-off
            fdStep       1.0e-5;
            lambda0      1.0e-3;
        }

        output
        {
            fit_log    fit_mixed_start2_history.csv;
            parity     fit_mixed_start2_parity.csv;
            proposal   nButanol-water.proposal.dat;
        }
    }
);
