(
    {
        file          "constant/archiveExtracts/ethanol-methylTertButylEther-bubble-je9004068.dat";
        role          fit;   // C283: every laboratory is fitted
        doi           "10.1021/je9004068";
        url           "https://trc.nist.gov/ThermoML/10.1021/je9004068.xml";
        page          "https://trc.nist.gov/ThermoML/10.1021/je9004068.json";
