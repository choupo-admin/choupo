/*---------------------------------------------------------------------------*\
  curate161_nrtl_nDecane_mXylene -- AN NRTL PAIR FROM EVERY LABORATORY'S MEASUREMENTS.

  WRITTEN BY bin/choupo-curate pair nDecane mXylene (DEV.md 4c C284, the bulk run;
  record docs/design/binary-pairs-from-open-measurements.md section 11).

  THE DECLARATION -- WRITTEN AND COMMITTED BEFORE ANY FIT RAN (several
  declarations of the bulk run share one commit).

  IDENTITY.  nDecane (CAS 124-18-5, InChIKey DIOQZVSQGTUSAI-UHFFFAOYSA-N)
  + mXylene (CAS 108-38-3, InChIKey IVSZLXZYQVIEFR-UHFFFAOYSA-N), joined
  to the archive through identity.json -- never by name.  CLASS (C284): both
  records are volatile molecular liquids (no role nonvolatile/solute, no
  dissociatesTo, no charge, no solid, a vapour-pressure model), and every
  measured temperature lies below both critical temperatures.

  NO MEASURED SERIES IN THIS TREE.  constant/archiveDatasets names each
  dataset (DOI, NIST URL, article sha256, extraction selector, extract
  sha256); `bin/choupo-curate fetch` writes the points into
  constant/archiveExtracts/, which is gitignored.

  STUDIES: every bubble-temperature block of the pair at or below 110 kPa
  with a declared uncertainty (2 block(s)).  FITTED, ALL OF THEM
  (2):
      10.1016/j.fluid.2012.09.019    block 14   12 pts  20 kPa  361.71-391.29 K  U 0.1-0.17 K
      10.1016/j.fluid.2004.10.027    block 25    5 pts  95.8 kPa  420.05-441.55 K  U 1.01-1.01 K
        (reports x of the other member: written as x[nDecane] = 1 - x by --x-of)
  SET ASIDE BY THE EXTRACTION RULES, BY NAME:
      (none)

  THE RULE (DEV.md 4c C283 amended, C284).  Every laboratory above is
  fitted; none is held out (the C16 partition and its band are retired as
  the acceptance test).  NRTL, a_ij = a_ji = 0, alpha = 0.30 fixed: two
  parameters (b_ij, b_ji); each point weighted by 1/U, U its own stated
  expanded uncertainty.  Objective twoStage (least squares, then minimax;
  T_bubble absolute, in K).  OUTLIERS: after a least-squares stage over every
  point, a point with |T_model - T| > 3 K is discarded BY
  NAME (`discard` on its evidence entry, listed below) and the fit repeated
  without it.  ACCEPTED when max |T_model - T| over the KEPT points is below
  1 K.  C283's 5 % relative clause judges composition; this fit has no
  composition residual, so only the temperature clause applies.  A pair
  that splits ONE liquid inside its validity span is not promoted (arm f).
  Two starts: (0, 0) and (800, -400).

  OUTLIERS DISCARDED AFTER THE LEAST-SQUARES STAGE:
  @@OUTLIERS-BEGIN@@
      5 point(s) of 17: doi 10.1016/j.fluid.2004.10.027 row 1: x 0.7909,
      P 95.800 kPa, T 441.55 K, dT -8.02 K; doi
      10.1016/j.fluid.2004.10.027 row 2: x 0.6021, P 95.800 kPa, T 436.75
      K, dT -10.87 K; doi 10.1016/j.fluid.2004.10.027 row 3: x 0.5195, P
      95.800 kPa, T 434.05 K, dT -10.94 K; doi
      10.1016/j.fluid.2004.10.027 row 4: x 0.3062, P 95.800 kPa, T 425.25
      K, dT -8.16 K; doi 10.1016/j.fluid.2004.10.027 row 5: x 0.2014, P
      95.800 kPa, T 420.05 K, dT -5.48 K
  @@OUTLIERS-END@@

  @@RESULT-BEGIN@@
  WHAT THE RUN FOUND (pinned in `expected`; measured, not argued).
  fit_nrtl: b_ij = -263.0 K, b_ji = 429.5 K over 12 kept points of 2
  laboratories (5 discarded): max |dT| 0.107 K, mean 0.064 K against the
  acceptance 1 K -> accepted. fit_nrtl_start2 lands on the same pair
  (-263.0, 429.5). PROMOTED on 2026-11-10 into
  data/standards/parameters/NRTL/mXylene-nDecane.dat as reviewStatus
  autoPromoted, humanReviewed false, because: max |dT| 0.107 K < 1 K over
  the 12 kept points, one liquid across the validity span
  @@RESULT-END@@

  WHAT IS NOT CLAIMED.  The pair is correct at these pressures and in this
  frame (ideal-gas vapour, the catalogue's own vapour-pressure records); the
  measurements were transcribed by the archive and have NOT been read back
  against the articles (the CHECKLIST that `fetch` writes is the aid).
\*---------------------------------------------------------------------------*/

operations
(
    {
        name        fit_nrtl;
        type        fitParameters;

        parameters
        (
            { path  equilibrium.liquid.activityModel.binaryParameters.nDecane-mXylene.b_ij;  initial 0;  min -3000;  max 3000; }
            { path  equilibrium.liquid.activityModel.binaryParameters.nDecane-mXylene.b_ji;  initial 0;  min -3000;  max 3000; }
        );

        evidence
        (
            {
                dataset  "constant/archiveExtracts/nDecane-mXylene-bubble-j.fluid.2012.09.019.dat";
                role     fit;
            }
            {
                dataset  "constant/archiveExtracts/nDecane-mXylene-bubble-j.fluid.2004.10.027.dat";
                role     fit;
                discard  ( 1 2 3 4 5 );   // C283 outliers, by name in the header
            }
        );

        objective { method twoStage;  scale { T_bubble absolute; } }
        residual
        {
            kind        T_bubble;
            components  ( nDecane mXylene );
            weighting   uncertainty;
        }

        options
        {
            maxIter      80;
            tolerance    1.0e-6;
            fdStep       1.0e-4;
            lambda0      1.0e-3;
        }

        output
        {
            fit_log    fit_history.csv;
            parity     parity.csv;
            proposal   mXylene-nDecane.proposal.dat;
        }
    }
    {
        name        fit_nrtl_start2;
        type        fitParameters;

        parameters
        (
            { path  equilibrium.liquid.activityModel.binaryParameters.nDecane-mXylene.b_ij;  initial 800;  min -3000;  max 3000; }
            { path  equilibrium.liquid.activityModel.binaryParameters.nDecane-mXylene.b_ji;  initial -400;  min -3000;  max 3000; }
        );

        evidence
        (
            {
                dataset  "constant/archiveExtracts/nDecane-mXylene-bubble-j.fluid.2012.09.019.dat";
                role     fit;
            }
            {
                dataset  "constant/archiveExtracts/nDecane-mXylene-bubble-j.fluid.2004.10.027.dat";
                role     fit;
                discard  ( 1 2 3 4 5 );   // C283 outliers, by name in the header
            }
        );

        objective { method twoStage;  scale { T_bubble absolute; } }
        residual
        {
            kind        T_bubble;
            components  ( nDecane mXylene );
            weighting   uncertainty;
        }

        options
        {
            maxIter      80;
            tolerance    1.0e-6;
            fdStep       1.0e-4;
            lambda0      1.0e-3;
        }

        output
        {
            parity     parity_start2.csv;
        }
    }
    {
        name        txy_ideal;
        type        propertyScan1D;
        vary        { variable x[nDecane];  from 0.0;  to 1.0;  n 101; }
        state       { P 20 kPa;  composition { nDecane 0.5;  mXylene 0.5; } }
        thermo
        {
            equilibrium { liquid { activityModel { model ideal; } } }
        }
        properties  ( T_bubble  y_eq_nDecane );
        output      { file txy_ideal.csv; }
    }
    {
        name        txy_unifac;
        type        propertyScan1D;
        vary        { variable x[nDecane];  from 0.0;  to 1.0;  n 101; }
        state       { P 20 kPa;  composition { nDecane 0.5;  mXylene 0.5; } }
        thermo
        {
            equilibrium { liquid { activityModel { model UNIFAC; } } }
        }
        properties  ( T_bubble  y_eq_nDecane );
        output      { file txy_unifac.csv; }
    }
    {
        name        txy_nrtl;
        type        propertyScan1D;
        vary        { variable x[nDecane];  from 0.0;  to 1.0;  n 101; }
        state       { P 20 kPa;  composition { nDecane 0.5;  mXylene 0.5; } }
        thermo
        {
            equilibrium { liquid { activityModel { model NRTL; /* no inline pair: the case's own record */ } } }
        }
        properties  ( T_bubble  y_eq_nDecane );
        output      { file txy_nrtl.csv; }
    }
);

experimental
(
    {
        name      study1;
        component nDecane;
        kind      txy;
        models    ( txy_ideal  txy_unifac  txy_nrtl );
        dataset   "constant/archiveExtracts/nDecane-mXylene-bubble-j.fluid.2012.09.019.dat";
        source    "IN-SAMPLE (fitted): doi 10.1016/j.fluid.2012.09.019";
    }
);
