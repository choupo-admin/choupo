    fittedParameters
    {
        equilibrium.liquid.activityModel.binaryParameters.ethanol-cyclohexane.b_ij  437.369896721;
        equilibrium.liquid.activityModel.binaryParameters.ethanol-cyclohexane.b_ji  485.191812851;
    }

    evidence
    {
