/*---------------------------------------------------------------------------*\
  curate138_nrtl_ethanol_cyclohexane -- AN NRTL PAIR FROM EVERY LABORATORY'S MEASUREMENTS.

  WRITTEN BY bin/choupo-curate pair ethanol cyclohexane (DEV.md 4c C284, the bulk run;
  record docs/design/binary-pairs-from-open-measurements.md section 10).

  THE DECLARATION -- WRITTEN AND COMMITTED BEFORE ANY FIT RAN (several
  declarations of the bulk run share one commit).

  IDENTITY.  ethanol (CAS 64-17-5, InChIKey LFQSCWFLJHTTHZ-UHFFFAOYSA-N)
  + cyclohexane (CAS 110-82-7, InChIKey XDTMQSROBMDMFD-UHFFFAOYSA-N), joined
  to the archive through identity.json -- never by name.  CLASS (C284): both
  records are volatile molecular liquids (no role nonvolatile/solute, no
  dissociatesTo, no charge, no solid, a vapour-pressure model), and every
  measured temperature lies below both critical temperatures.

  NO MEASURED SERIES IN THIS TREE.  constant/archiveDatasets names each
  dataset (DOI, NIST URL, article sha256, extraction selector, extract
  sha256); `bin/choupo-curate fetch` writes the points into
  constant/archiveExtracts/, which is gitignored.

  STUDIES: every bubble-temperature block of the pair at or below 110 kPa
  with a declared uncertainty (2 block(s)).  FITTED, ALL OF THEM
  (2):
      10.1016/j.fluid.2018.07.013    block 0    25 pts  101.3 kPa  337.65-353.45 K  U 0.22-1.71 K
      10.1016/j.fluid.2006.01.023    block 0    14 pts  101.325 kPa  338.08-350.50 K  U 1.36-1.4 K
  SET ASIDE BY THE EXTRACTION RULES, BY NAME:
      (none)

  THE RULE (DEV.md 4c C283 amended, C284).  Every laboratory above is
  fitted; none is held out (the C16 partition and its band are retired as
  the acceptance test).  NRTL, a_ij = a_ji = 0, alpha = 0.30 fixed: two
  parameters (b_ij, b_ji); each point weighted by 1/U, U its own stated
  expanded uncertainty.  Objective twoStage (least squares, then minimax;
  T_bubble absolute, in K).  OUTLIERS: after a least-squares stage over every
  point, a point with |T_model - T| > 3 K is discarded BY
  NAME (`discard` on its evidence entry, listed below) and the fit repeated
  without it.  ACCEPTED when max |T_model - T| over the KEPT points is below
  1 K.  C283's 5 % relative clause judges composition; this fit has no
  composition residual, so only the temperature clause applies.  A pair
  that splits ONE liquid inside its validity span is not promoted (arm f).
  Two starts: (0, 0) and (800, -400).

  OUTLIERS DISCARDED AFTER THE LEAST-SQUARES STAGE:
  @@OUTLIERS-BEGIN@@
      none: every one of the 39 points lies within 3 K after the
      least-squares stage.
  @@OUTLIERS-END@@

  @@RESULT-BEGIN@@
  WHAT THE RUN FOUND (pinned in `expected`; measured, not argued).
  fit_nrtl: b_ij = 437.4 K, b_ji = 485.2 K over 39 kept points of 2
  laboratories (0 discarded): max |dT| 2.682 K, mean 0.903 K against the
  acceptance 1 K -> notAccepted. fit_nrtl_start2 lands on the same pair
  (437.4, 485.2). NOT PROMOTABLE: max |dT| 2.682 K over the 39 kept
  points is not below 1 K
  @@RESULT-END@@

  WHAT IS NOT CLAIMED.  The pair is correct at these pressures and in this
  frame (ideal-gas vapour, the catalogue's own vapour-pressure records); the
  measurements were transcribed by the archive and have NOT been read back
  against the articles (the CHECKLIST that `fetch` writes is the aid).
\*---------------------------------------------------------------------------*/

operations
(
    {
        name        fit_nrtl;
        type        fitParameters;

        parameters
        (
            { path  equilibrium.liquid.activityModel.binaryParameters.ethanol-cyclohexane.b_ij;  initial 0;  min -3000;  max 3000; }
            { path  equilibrium.liquid.activityModel.binaryParameters.ethanol-cyclohexane.b_ji;  initial 0;  min -3000;  max 3000; }
        );

        evidence
        (
            {
                dataset  "constant/archiveExtracts/ethanol-cyclohexane-bubble-j.fluid.2018.07.013.dat";
                role     fit;
            }
            {
                dataset  "constant/archiveExtracts/ethanol-cyclohexane-bubble-j.fluid.2006.01.023.dat";
                role     fit;
            }
        );

        objective { method twoStage;  scale { T_bubble absolute; } }
        residual
        {
            kind        T_bubble;
            components  ( ethanol cyclohexane );
            weighting   uncertainty;
        }

        options
        {
            maxIter      80;
            tolerance    1.0e-6;
            fdStep       1.0e-4;
            lambda0      1.0e-3;
        }

        output
        {
            fit_log    fit_history.csv;
            parity     parity.csv;
            proposal   cyclohexane-ethanol.proposal.dat;
        }
    }
    {
        name        fit_nrtl_start2;
        type        fitParameters;

        parameters
        (
            { path  equilibrium.liquid.activityModel.binaryParameters.ethanol-cyclohexane.b_ij;  initial 800;  min -3000;  max 3000; }
            { path  equilibrium.liquid.activityModel.binaryParameters.ethanol-cyclohexane.b_ji;  initial -400;  min -3000;  max 3000; }
        );

        evidence
        (
            {
                dataset  "constant/archiveExtracts/ethanol-cyclohexane-bubble-j.fluid.2018.07.013.dat";
                role     fit;
            }
            {
                dataset  "constant/archiveExtracts/ethanol-cyclohexane-bubble-j.fluid.2006.01.023.dat";
                role     fit;
            }
        );

        objective { method twoStage;  scale { T_bubble absolute; } }
        residual
        {
            kind        T_bubble;
            components  ( ethanol cyclohexane );
            weighting   uncertainty;
        }

        options
        {
            maxIter      80;
            tolerance    1.0e-6;
            fdStep       1.0e-4;
            lambda0      1.0e-3;
        }

        output
        {
            parity     parity_start2.csv;
        }
    }
    {
        name        txy_ideal;
        type        propertyScan1D;
        vary        { variable x[ethanol];  from 0.0;  to 1.0;  n 101; }
        state       { P 101.3 kPa;  composition { ethanol 0.5;  cyclohexane 0.5; } }
        thermo
        {
            equilibrium { liquid { activityModel { model ideal; } } }
        }
        properties  ( T_bubble  y_eq_ethanol );
        output      { file txy_ideal.csv; }
    }
    {
        name        txy_unifac;
        type        propertyScan1D;
        vary        { variable x[ethanol];  from 0.0;  to 1.0;  n 101; }
        state       { P 101.3 kPa;  composition { ethanol 0.5;  cyclohexane 0.5; } }
        thermo
        {
            equilibrium { liquid { activityModel { model UNIFAC; } } }
        }
        properties  ( T_bubble  y_eq_ethanol );
        output      { file txy_unifac.csv; }
    }
    {
        name        txy_nrtl;
        type        propertyScan1D;
        vary        { variable x[ethanol];  from 0.0;  to 1.0;  n 101; }
        state       { P 101.3 kPa;  composition { ethanol 0.5;  cyclohexane 0.5; } }
        thermo
        {
            equilibrium { liquid { activityModel { model NRTL; /* no inline pair: the case's own record */ } } }
        }
        properties  ( T_bubble  y_eq_ethanol );
        output      { file txy_nrtl.csv; }
    }
);

experimental
(
    {
        name      study1;
        component ethanol;
        kind      txy;
        models    ( txy_ideal  txy_unifac  txy_nrtl );
        dataset   "constant/archiveExtracts/ethanol-cyclohexane-bubble-j.fluid.2018.07.013.dat";
        source    "IN-SAMPLE (fitted): doi 10.1016/j.fluid.2018.07.013";
    }
    {
        name      study2;
        component ethanol;
        kind      txy;
        models    ( txy_ideal  txy_unifac  txy_nrtl );
        dataset   "constant/archiveExtracts/ethanol-cyclohexane-bubble-j.fluid.2006.01.023.dat";
        source    "IN-SAMPLE (fitted): doi 10.1016/j.fluid.2006.01.023";
    }
);
