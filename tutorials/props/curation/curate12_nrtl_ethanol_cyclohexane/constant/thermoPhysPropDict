/*---------------------------------------------------------------------------*\
  curate12_nrtl_ethanol_cyclohexane -- the thermophysical system.

  gamma-phi at LOW PRESSURE, stated as assumptions because they are the
  frame every number in this case is conditional on:
    * vapour: IDEAL GAS (fugacity coefficient 1, no Poynting term) -- the
      data run from 337 to 354 K at or below 101.3 kPa;
    * pure components: the catalogue's own Antoine records, UNCHANGED --
      their error at the held-out set's pure endpoints is measured in the
      acceptance band's origin (system/propsDict), not fitted away;
    * liquid: NRTL, tau_ij = a_ij + b_ij/T, G_ij = exp(-alpha tau_ij),
      alpha 0.30 FIXED (not identified by bubble temperatures alone).

  The inline pair below is the FIT'S STARTING POINT (all zero = ideal
  mixing), not a result: the regressed pair passed its held-out test but was
  NOT promoted (it predicts a second liquid inside its own validity span --
  see system/propsDict); it is the AUTHORED record
  constant/parameters/NRTL/cyclohexane-ethanol.dat of this case, and the
  scan operations read it through their own `thermo {}` override.
\*---------------------------------------------------------------------------*/

recordType    thermophysicalPropertySystem;
schemaVersion 2;

components       ( ethanol  cyclohexane );

equilibrium
{
    formulation gammaPhi;

    liquid
    {
        activityModel
        {
            model NRTL;
            binaryParameters   // the FIT'S starting point -- see the header
            {
                ethanol-cyclohexane
                {
                    i ethanol;
                    j cyclohexane;
                    a_ij 0;
                    b_ij 0;
                    a_ji 0;
                    b_ji 0;
                    alpha 0.30;
                }
            }
        }
        standardState pureLiquid;
    }

    vapour
    {
        fugacityModel idealGas;
    }
}
