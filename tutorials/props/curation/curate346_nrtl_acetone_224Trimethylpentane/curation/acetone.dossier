        equilibrium.liquid.activityModel.binaryParameters.acetone-224Trimethylpentane.b_ij  511.974493138;
        equilibrium.liquid.activityModel.binaryParameters.acetone-224Trimethylpentane.b_ji  106.517393096;
    }

    evidence
    {
        partitionFingerprint  "9e630d57bf885d72";   // frozen before the fit

        datasets
