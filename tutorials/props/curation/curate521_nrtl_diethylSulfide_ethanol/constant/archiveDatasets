(
    {
        file          "constant/archiveExtracts/diethylSulfide-ethanol-bubbleP-j.fluid.2015.10.041-b3.dat";
        role          fit;   // C283: every laboratory is fitted
        doi           "10.1016/j.fluid.2015.10.041";
