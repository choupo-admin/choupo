        articleSha256 "acb1b5e336311344ac044b8a5c190b805532fa909ae5db83ad7fbdbc8e0bf081";
        block         3;
        extractor     bubblePressure;
        extract       "bin/choupo-thermoml extract-px <article file> --block 3 --into <dir>";
        sha256        "37c8bf30d00c7d7f56700472a7e0dbad95ada34b44aaee484fd5f92321c5e2c8";
        identity
        {
            diethylSulfide { cas "352-93-2"; inchiKey "LJSQFQKUNVCTIA-UHFFFAOYSA-N"; }
