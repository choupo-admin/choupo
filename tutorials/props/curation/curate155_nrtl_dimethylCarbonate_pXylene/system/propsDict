/*---------------------------------------------------------------------------*\
  curate155_nrtl_dimethylCarbonate_pXylene -- AN NRTL PAIR FROM EVERY LABORATORY'S MEASUREMENTS.

  WRITTEN BY bin/choupo-curate pair dimethylCarbonate pXylene (DEV.md 4c C284, the bulk run;
  record docs/design/binary-pairs-from-open-measurements.md section 10).

  THE DECLARATION -- WRITTEN AND COMMITTED BEFORE ANY FIT RAN (several
  declarations of the bulk run share one commit).

  IDENTITY.  dimethylCarbonate (CAS 616-38-6, InChIKey IEJIGPNLZYLLBP-UHFFFAOYSA-N)
  + pXylene (CAS 106-42-3, InChIKey URLKBWYHVLBVBO-UHFFFAOYSA-N), joined
  to the archive through identity.json -- never by name.  CLASS (C284): both
  records are volatile molecular liquids (no role nonvolatile/solute, no
  dissociatesTo, no charge, no solid, a vapour-pressure model), and every
  measured temperature lies below both critical temperatures.

  NO MEASURED SERIES IN THIS TREE.  constant/archiveDatasets names each
  dataset (DOI, NIST URL, article sha256, extraction selector, extract
  sha256); `bin/choupo-curate fetch` writes the points into
  constant/archiveExtracts/, which is gitignored.

  STUDIES: every bubble-temperature block of the pair at or below 110 kPa
  with a declared uncertainty (2 block(s)).  FITTED, ALL OF THEM
  (2):
      10.1016/j.jct.2019.01.027      block 5    14 pts  101.3 kPa  366.65-407.95 K  U 0.28-0.75 K
      10.1021/acs.jced.7b00372       block 15   11 pts  93.13 kPa  361.49-403.24 K  U 0.23-1.12 K
        (reports x of the other member: written as x[dimethylCarbonate] = 1 - x by --x-of)
  SET ASIDE BY THE EXTRACTION RULES, BY NAME:
      (none)

  THE RULE (DEV.md 4c C283 amended, C284).  Every laboratory above is
  fitted; none is held out (the C16 partition and its band are retired as
  the acceptance test).  NRTL, a_ij = a_ji = 0, alpha = 0.30 fixed: two
  parameters (b_ij, b_ji); each point weighted by 1/U, U its own stated
  expanded uncertainty.  Objective twoStage (least squares, then minimax;
  T_bubble absolute, in K).  OUTLIERS: after a least-squares stage over every
  point, a point with |T_model - T| > 3 K is discarded BY
  NAME (`discard` on its evidence entry, listed below) and the fit repeated
  without it.  ACCEPTED when max |T_model - T| over the KEPT points is below
  1 K.  C283's 5 % relative clause judges composition; this fit has no
  composition residual, so only the temperature clause applies.  A pair
  that splits ONE liquid inside its validity span is not promoted (arm f).
  Two starts: (0, 0) and (800, -400).

  OUTLIERS DISCARDED AFTER THE LEAST-SQUARES STAGE:
  @@OUTLIERS-BEGIN@@
      6 point(s) of 25: doi 10.1016/j.jct.2019.01.027 row 10: x 0.4007, P
      101.300 kPa, T 380.65 K, dT -3.06 K; doi 10.1016/j.jct.2019.01.027
      row 11: x 0.4878, P 101.300 kPa, T 377.25 K, dT -3.26 K; doi
      10.1021/acs.jced.7b00372 row 7: x 0.4312, P 93.130 kPa, T 369.75 K,
      dT +3.73 K; doi 10.1021/acs.jced.7b00372 row 8: x 0.2628, P 93.130
      kPa, T 376.35 K, dT +6.06 K; doi 10.1021/acs.jced.7b00372 row 9: x
      0.1584, P 93.130 kPa, T 384.79 K, dT +5.54 K; doi
      10.1021/acs.jced.7b00372 row 10: x 0.0631, P 93.130 kPa, T 396.71
      K, dT +3.34 K
  @@OUTLIERS-END@@

  @@RESULT-BEGIN@@
  WHAT THE RUN FOUND (pinned in `expected`; measured, not argued).
  fit_nrtl: b_ij = 666.1 K, b_ji = -266.8 K over 19 kept points of 2
  laboratories (6 discarded): max |dT| 3.093 K, mean 1.497 K against the
  acceptance 1 K -> notAccepted. fit_nrtl_start2 lands on the same pair
  (666.1, -266.8). NOT PROMOTABLE: max |dT| 3.093 K over the 19 kept
  points is not below 1 K
  @@RESULT-END@@

  WHAT IS NOT CLAIMED.  The pair is correct at these pressures and in this
  frame (ideal-gas vapour, the catalogue's own vapour-pressure records); the
  measurements were transcribed by the archive and have NOT been read back
  against the articles (the CHECKLIST that `fetch` writes is the aid).
\*---------------------------------------------------------------------------*/

operations
(
    {
        name        fit_nrtl;
        type        fitParameters;

        parameters
        (
            { path  equilibrium.liquid.activityModel.binaryParameters.dimethylCarbonate-pXylene.b_ij;  initial 0;  min -3000;  max 3000; }
            { path  equilibrium.liquid.activityModel.binaryParameters.dimethylCarbonate-pXylene.b_ji;  initial 0;  min -3000;  max 3000; }
        );

        evidence
        (
            {
                dataset  "constant/archiveExtracts/dimethylCarbonate-pXylene-bubble-j.jct.2019.01.027.dat";
                role     fit;
                discard  ( 10 11 );   // C283 outliers, by name in the header
            }
            {
                dataset  "constant/archiveExtracts/dimethylCarbonate-pXylene-bubble-acs.jced.7b00372.dat";
                role     fit;
                discard  ( 7 8 9 10 );   // C283 outliers, by name in the header
            }
        );

        objective { method twoStage;  scale { T_bubble absolute; } }
        residual
        {
            kind        T_bubble;
            components  ( dimethylCarbonate pXylene );
            weighting   uncertainty;
        }

        options
        {
            maxIter      80;
            tolerance    1.0e-6;
            fdStep       1.0e-4;
            lambda0      1.0e-3;
        }

        output
        {
            fit_log    fit_history.csv;
            parity     parity.csv;
            proposal   dimethylCarbonate-pXylene.proposal.dat;
        }
    }
    {
        name        fit_nrtl_start2;
        type        fitParameters;

        parameters
        (
            { path  equilibrium.liquid.activityModel.binaryParameters.dimethylCarbonate-pXylene.b_ij;  initial 800;  min -3000;  max 3000; }
            { path  equilibrium.liquid.activityModel.binaryParameters.dimethylCarbonate-pXylene.b_ji;  initial -400;  min -3000;  max 3000; }
        );

        evidence
        (
            {
                dataset  "constant/archiveExtracts/dimethylCarbonate-pXylene-bubble-j.jct.2019.01.027.dat";
                role     fit;
                discard  ( 10 11 );   // C283 outliers, by name in the header
            }
            {
                dataset  "constant/archiveExtracts/dimethylCarbonate-pXylene-bubble-acs.jced.7b00372.dat";
                role     fit;
                discard  ( 7 8 9 10 );   // C283 outliers, by name in the header
            }
        );

        objective { method twoStage;  scale { T_bubble absolute; } }
        residual
        {
            kind        T_bubble;
            components  ( dimethylCarbonate pXylene );
            weighting   uncertainty;
        }

        options
        {
            maxIter      80;
            tolerance    1.0e-6;
            fdStep       1.0e-4;
            lambda0      1.0e-3;
        }

        output
        {
            parity     parity_start2.csv;
        }
    }
    {
        name        txy_ideal;
        type        propertyScan1D;
        vary        { variable x[dimethylCarbonate];  from 0.0;  to 1.0;  n 101; }
        state       { P 101.3 kPa;  composition { dimethylCarbonate 0.5;  pXylene 0.5; } }
        thermo
        {
            equilibrium { liquid { activityModel { model ideal; } } }
        }
        properties  ( T_bubble  y_eq_dimethylCarbonate );
        output      { file txy_ideal.csv; }
    }
    {
        name        txy_nrtl;
        type        propertyScan1D;
        vary        { variable x[dimethylCarbonate];  from 0.0;  to 1.0;  n 101; }
        state       { P 101.3 kPa;  composition { dimethylCarbonate 0.5;  pXylene 0.5; } }
        thermo
        {
            equilibrium { liquid { activityModel { model NRTL; /* no inline pair: the case's own record */ } } }
        }
        properties  ( T_bubble  y_eq_dimethylCarbonate );
        output      { file txy_nrtl.csv; }
    }
);

experimental
(
    {
        name      study1;
        component dimethylCarbonate;
        kind      txy;
        models    ( txy_ideal  txy_nrtl );
        dataset   "constant/archiveExtracts/dimethylCarbonate-pXylene-bubble-j.jct.2019.01.027.dat";
        source    "IN-SAMPLE (fitted): doi 10.1016/j.jct.2019.01.027";
    }
);
