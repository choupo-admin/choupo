        file          "constant/archiveExtracts/ethylAcetate-2Methyl2Propanol-bubble-je0202073.dat";
        role          fit;   // C283: every laboratory is fitted
        doi           "10.1021/je0202073";
        url           "https://trc.nist.gov/ThermoML/10.1021/je0202073.xml";
        page          "https://trc.nist.gov/ThermoML/10.1021/je0202073.json";
