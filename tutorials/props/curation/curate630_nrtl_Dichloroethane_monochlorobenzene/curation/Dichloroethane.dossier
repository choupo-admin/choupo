            doi       "10.1021/je0301085";
            sha256    "b1fe3f87feb94add0759ccbac63caabc818e5ec6803f846b16b1badbb1ca828e";
            provenance measured;
            archiveFile "je0301085.xml";
            system    "Dichloroethane + monochlorobenzene";
            pressure  "94600.000000 Pa";
        }
        );

        domain
        {
            coordinate  x1;
            fit         { min 0.155; max 0.899; n 7; }
        }
    }

    metrics
    {
        //  r2InSample: not computed by this operation (it reports chi-square).
        //  NO HELD-OUT METRIC EXISTS.  r2InSample above is exactly that --
