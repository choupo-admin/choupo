/*---------------------------------------------------------------------------*\
  curate17_nrtl_diisopropylEther_isopropanol -- AN NRTL PAIR FROM PUBLISHED MEASUREMENTS, BY THE PIPELINE.

  WRITTEN BY bin/choupo-curate pair diisopropylEther isopropanol (DEV.md 4c C282; record
  docs/design/binary-pairs-from-open-measurements.md section 8).  Every rule
  below was decided before this tool existed (C16, C225, C226); the tool
  applies them and decides nothing.

  THE DECLARATION -- WRITTEN AND COMMITTED BEFORE ANY FIT RAN.
  (C16 slice 2: so the declaration can be read against the result.)

  IDENTITY.  diisopropylEther (CAS 108-20-3, InChIKey ZAFNJMIOTHYJRJ-UHFFFAOYSA-N)
  + isopropanol (CAS 67-63-0, InChIKey KFZMGEQAYNKOFK-UHFFFAOYSA-N), joined
  to the archive through identity.json -- never by name.

  NO MEASURED SERIES IN THIS TREE.  constant/archiveDatasets names each
  dataset (DOI, NIST URL, article sha256, extraction selector, extract
  sha256); `bin/choupo-curate fetch` writes the points into
  constant/archiveExtracts/, which is gitignored.

  STUDIES CONSIDERED: every bubble-temperature block of the pair at or below
  110 kPa with a declared uncertainty (4 block(s)).
  USABLE after the screens: 4.  SET ASIDE, BY NAME:
      (none)

  TRIAGE (C226 item 3, leave one study out, fitted by the engine; a study
  whose held-out AAD exceeds its own largest stated U plus the others'
  largest stated U disagrees with them beyond their stated uncertainties):
      10.1016/j.fluid.2014.09.014: AAD 1.829 K against the limit 2.770 K
      -> agrees; 10.1016/j.fluid.2007.09.014: AAD 0.579 K against the
      limit 1.880 K -> agrees; 10.1021/je300994y: AAD 0.298 K against the
      limit 2.240 K -> agrees; 10.1016/j.jct.2018.11.013: AAD 0.395 K
      against the limit 2.770 K -> agrees

  PARTITION (the declared rule of C16 slice 2): the FIT set is the usable
  study with the most interior points; the HELD-OUT set is the next largest
  that shares NO author with it and was measured at one pressure.
    FIT       doi 10.1016/j.fluid.2014.09.014 (67 interior points, 4 isobars 53.33-94.79 kPa)
              authors: Soujanya, J.; satyavathi, B.; Sankarshana, T.
    HELD OUT  doi 10.1021/je300994y (19 interior points, 101.3 kPa)
              authors: Zhang, Z.[Zhigang]; Yang, L.[Lei]; Xing, Y.[Yuan]; Li, W.[Wenxiu]

  BAND: maxAAD 0.24 % of the held-out mean T.
      declared before the fit by bin/choupo-curate, the ONE rule of C16:
      the held-out set's largest stated expanded uncertainty (U95 = 0.61
      K) plus the catalogue vapour-pressure model's own error at that
      set's pure endpoints (isopropanol -0.206 K, diisopropylEther +0.116
      K; measured with no pair involved), as a percentage of the held-out
      mean T (342.77 K) = 0.2380 %, rounded UP to two significant figures

  THE FIT.  NRTL with a_ij = a_ji = 0 and alpha = 0.30 fixed: TWO parameters
  (b_ij, b_ji), the C16 frame (bubble temperatures over these ranges do not
  identify more).  Each point weighted by 1/U, U its own stated expanded
  uncertainty.  Two starts: (0, 0) and (800, -400).

  @@RESULT-BEGIN@@
  WHAT THE RUN FOUND: not yet run.
  @@RESULT-END@@

  WHAT IS NOT CLAIMED.  The pair is correct at these pressures and in this
  frame (ideal-gas vapour, the catalogue's own vapour-pressure records); the
  measurements were transcribed by the archive and have NOT been read back
  against the articles (the CHECKLIST that `fetch` writes beside the extracts
  is the aid for that reading).
\*---------------------------------------------------------------------------*/

operations
(
    {
        name        fit_nrtl;
        type        fitParameters;

        parameters
        (
            { path  equilibrium.liquid.activityModel.binaryParameters.diisopropylEther-isopropanol.b_ij;  initial 0;  min -3000;  max 3000; }
            { path  equilibrium.liquid.activityModel.binaryParameters.diisopropylEther-isopropanol.b_ji;  initial 0;  min -3000;  max 3000; }
        );

        evidence
        (
            {
                dataset  "constant/archiveExtracts/diisopropylEther-isopropanol-bubble-j.fluid.2014.09.014.dat";
                role     fit;
            }
            {
                dataset  "constant/archiveExtracts/diisopropylEther-isopropanol-bubble-je300994y.dat";
                role     validation;
            }
        );

        acceptance
        {
            maxAAD  0.24 percent;
            origin  "declared before the fit by bin/choupo-curate, the ONE rule of C16: the held-out set's largest stated expanded uncertainty (U95 = 0.61 K) plus the catalogue vapour-pressure model's own error at that set's pure endpoints (isopropanol -0.206 K, diisopropylEther +0.116 K; measured with no pair involved), as a percentage of the held-out mean T (342.77 K) = 0.2380 %, rounded UP to two significant figures";
        }

        objective { method leastSquares; }
        residual
        {
            kind        T_bubble;
            components  ( diisopropylEther isopropanol );
            weighting   uncertainty;
        }

        options
        {
            maxIter      80;
            tolerance    1.0e-6;
            fdStep       1.0e-4;
            lambda0      1.0e-3;
        }

        output
        {
            fit_log    fit_history.csv;
            parity     parity.csv;
            proposal   diisopropylEther-isopropanol.proposal.dat;
        }
    }
    {
        name        fit_nrtl_start2;
        type        fitParameters;

        parameters
        (
            { path  equilibrium.liquid.activityModel.binaryParameters.diisopropylEther-isopropanol.b_ij;  initial 800;  min -3000;  max 3000; }
            { path  equilibrium.liquid.activityModel.binaryParameters.diisopropylEther-isopropanol.b_ji;  initial -400;  min -3000;  max 3000; }
        );

        evidence
        (
            {
                dataset  "constant/archiveExtracts/diisopropylEther-isopropanol-bubble-j.fluid.2014.09.014.dat";
                role     fit;
            }
            {
                dataset  "constant/archiveExtracts/diisopropylEther-isopropanol-bubble-je300994y.dat";
                role     validation;
            }
        );

        acceptance
        {
            maxAAD  0.24 percent;
            origin  "declared before the fit by bin/choupo-curate, the ONE rule of C16: the held-out set's largest stated expanded uncertainty (U95 = 0.61 K) plus the catalogue vapour-pressure model's own error at that set's pure endpoints (isopropanol -0.206 K, diisopropylEther +0.116 K; measured with no pair involved), as a percentage of the held-out mean T (342.77 K) = 0.2380 %, rounded UP to two significant figures";
        }

        objective { method leastSquares; }
        residual
        {
            kind        T_bubble;
            components  ( diisopropylEther isopropanol );
            weighting   uncertainty;
        }

        options
        {
            maxIter      80;
            tolerance    1.0e-6;
            fdStep       1.0e-4;
            lambda0      1.0e-3;
        }

        output
        {
            parity     parity_start2.csv;
        }
    }
    {
        name        txy_ideal;
        type        propertyScan1D;
        vary        { variable x[diisopropylEther];  from 0.0;  to 1.0;  n 101; }
        state       { P 101.3 kPa;  composition { diisopropylEther 0.5;  isopropanol 0.5; } }
        thermo
        {
            equilibrium { liquid { activityModel { model ideal; } } }
        }
        properties  ( T_bubble  y_eq_diisopropylEther );
        output      { file txy_ideal.csv; }
    }
    {
        name        txy_nrtl;
        type        propertyScan1D;
        vary        { variable x[diisopropylEther];  from 0.0;  to 1.0;  n 101; }
        state       { P 101.3 kPa;  composition { diisopropylEther 0.5;  isopropanol 0.5; } }
        thermo
        {
            equilibrium { liquid { activityModel { model NRTL; /* no inline pair: the case's own record */ } } }
        }
        properties  ( T_bubble  y_eq_diisopropylEther );
        output      { file txy_nrtl.csv; }
    }
);

experimental
(
    {
        name      heldout;
        component diisopropylEther;
        kind      txy;
        models    ( txy_ideal  txy_nrtl );
        dataset   "constant/archiveExtracts/diisopropylEther-isopropanol-bubble-je300994y.dat";
        source    "held out: doi 10.1021/je300994y";
    }
);
