(
    {
        file          "constant/archiveExtracts/methylAcetate-diEthylCarbonate-bubble-acs.jced.9b00068.dat";
        role          fit;   // C283: every laboratory is fitted
        doi           "10.1021/acs.jced.9b00068";
        url           "https://trc.nist.gov/ThermoML/10.1021/acs.jced.9b00068.xml";
        page          "https://trc.nist.gov/ThermoML/10.1021/acs.jced.9b00068.json";
        articleFile   "acs.jced.9b00068.xml";
        articleSha256 "83929ebdd41aa5dbd823461b5c67eac5f122cf49437401222c72f1072851fc2d";
        block         18;
        filter        ( --interior-only );
        extract       "bin/choupo-thermoml extract-vle <article file> --block 18 --interior-only --into <dir>";
        sha256        "4146c17899f331fde24ef38f25ada30ccea8faa08c5a1f789f3e5b32b0a279d5";
        identity
        {
            methylAcetate  { cas "79-20-9"; inchiKey "KXKVLQRXCPHEJC-UHFFFAOYSA-N"; }
