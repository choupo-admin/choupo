            provenance measured;
            archiveFile "j.jct.2005.07.004.xml";
            system    "diisopropylEther + nButanol";
        }
        );

        domain
        {
            coordinate  x1;
            fit         { min 0.0591; max 0.952; n 26; }
        }
    }

    metrics
    {
        //  r2InSample: not computed by this operation (it reports chi-square).
