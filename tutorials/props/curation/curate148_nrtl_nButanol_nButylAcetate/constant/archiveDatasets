(
    {
        file          "constant/archiveExtracts/nButanol-nButylAcetate-bubble-je700411p.dat";
        role          fit;   // C283: every laboratory is fitted
        doi           "10.1021/je700411p";
        url           "https://trc.nist.gov/ThermoML/10.1021/je700411p.xml";
        page          "https://trc.nist.gov/ThermoML/10.1021/je700411p.json";
