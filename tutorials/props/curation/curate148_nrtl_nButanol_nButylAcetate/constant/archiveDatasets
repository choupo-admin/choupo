        articleSha256 "32ed6e15958b58bc35d7eb647d3cb4b75e9d6232ffbe7608a87c9c4b09cc34b1";
        block         9;
        filter        ( --interior-only );
        extract       "bin/choupo-thermoml extract-vle <article file> --block 9 --interior-only --into <dir>";
        sha256        "6f08b24b29c2df38e777ad5732bf23c71bf8328c23cad0fb74a30db94535e3ca";
        identity
        {
            nButanol       { cas "71-36-3"; inchiKey "LRHPLDYGYMQRHN-UHFFFAOYSA-N"; }
