        articleSha256 "d87224cb001a1555a0336a273bc382d7a10ec99b3b075b40ae21b9807b9fc9db";
        block         14;
        filter        ( --interior-only );
        extract       "bin/choupo-thermoml extract-vle <article file> --block 14 --interior-only --into <dir>";
        sha256        "ed2585a4d8645df847da31d1103c3354e014a7eb5a4a91621b8df09e464552bf";
        identity
        {
            nNonane        { cas "111-84-2"; inchiKey "BKIMMITUMNQMOS-UHFFFAOYSA-N"; }
