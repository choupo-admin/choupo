(
    {
        file          "constant/archiveExtracts/nNonane-pXylene-bubble-j.fluid.2011.10.009.dat";
        role          fit;   // C283: every laboratory is fitted
        doi           "10.1016/j.fluid.2011.10.009";
        url           "https://trc.nist.gov/ThermoML/10.1016/j.fluid.2011.10.009.xml";
        page          "https://trc.nist.gov/ThermoML/10.1016/j.fluid.2011.10.009.json";
