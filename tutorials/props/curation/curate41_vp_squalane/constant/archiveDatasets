(
    {
        file          "constant/archiveExtracts/squalane-vapourPressure-j.jct.2019.03.032.dat";
        role          fit;   // informational: the operation declares it
        doi           "10.1016/j.jct.2019.03.032";
        url           "https://trc.nist.gov/ThermoML/10.1016/j.jct.2019.03.032.xml";
        page          "https://trc.nist.gov/ThermoML/10.1016/j.jct.2019.03.032.json";
        articleFile   "j.jct.2019.03.032.xml";
        articleSha256 "55e20bbaa69c40a29faad398e5099d7a0010b785a6643883f0e2f4158caac176";
        extractor     vapourPressure;
        inchiKey      "PRAKJMSDJKAYCZ-UHFFFAOYSA-N";
        extract       "bin/choupo-thermoml extract-vp <article file> --inchikey PRAKJMSDJKAYCZ-UHFFFAOYSA-N --into <dir>";
        sha256        "5c1bcb8a9c052594b432a4dba3be5dc5dbb79909f31ea4fb4178af2016d4deef";
        identity
        {
            squalane       { cas "111-01-3"; inchiKey "PRAKJMSDJKAYCZ-UHFFFAOYSA-N"; }
        }
    }
);
