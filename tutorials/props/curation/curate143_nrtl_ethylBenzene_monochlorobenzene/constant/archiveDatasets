/*--------------------------------*- Choupo -*--------------------------------*\
  constant/archiveDatasets -- WHERE the measurements of curate143_nrtl_ethylBenzene_monochlorobenzene
  come from, and how to regenerate them.  NO MEASURED POINT IS IN THIS TREE
  (Vitor, 2026-11-10: the measured series are not copied; only the fitted
  parameters are kept).  `bin/choupo-curate fetch <case>` writes each
  dataset into constant/archiveExtracts/ (gitignored): the article file is taken from
  the local ThermoML cache when it holds it, else from the NIST URL below,
  and BOTH sha256 sums are checked -- a mismatch refuses, an unreachable
  NIST is reported NOT RUN, never a pass.
\*-----------------------------------------------------------------------------*/

recordType    archiveDatasets;

archive
{
    tarball   "ThermoML.v2020-09-30.tgz";
    doi       "10.18434/mds2-2422";
    note      "the finding aid; each article file is also served one by one at the NIST URL";
}

datasets
(
    {
        file          "constant/archiveExtracts/ethylBenzene-monochlorobenzene-bubble-je020186c.dat";
        role          fit;   // C283: every laboratory is fitted
        doi           "10.1021/je020186c";
        url           "https://trc.nist.gov/ThermoML/10.1021/je020186c.xml";
        page          "https://trc.nist.gov/ThermoML/10.1021/je020186c.json";
        articleFile   "je020186c.xml";
        articleSha256 "42c372b090af0eedd09839822f60e727cbd35e444ec214ef4d1075f266e2aa46";
        block         5;
        filter        ( --interior-only );
        extract       "bin/choupo-thermoml extract-vle <article file> --block 5 --interior-only --into <dir>";
        sha256        "96050be3fe3485abdd01f1a0ca330cc29920bffd868f291dd58dcaedc516ad88";
        identity
        {
            ethylBenzene   { cas "100-41-4"; inchiKey "YNQLUTRBYVCPMQ-UHFFFAOYSA-N"; }
            monochlorobenzene { cas "108-90-7"; inchiKey "MVPPADPHJFYWMZ-UHFFFAOYSA-N"; }
        }
    }
    {
        file          "constant/archiveExtracts/ethylBenzene-monochlorobenzene-bubble-j.jct.2005.12.009.dat";
        role          fit;   // C283: every laboratory is fitted
        doi           "10.1016/j.jct.2005.12.009";
        url           "https://trc.nist.gov/ThermoML/10.1016/j.jct.2005.12.009.xml";
        page          "https://trc.nist.gov/ThermoML/10.1016/j.jct.2005.12.009.json";
        articleFile   "j.jct.2005.12.009.xml";
        articleSha256 "a98a2ed0d0a1d32edfbf57f888957a2e25b672502200eb2d43ea3e01fb0a596f";
        block         30;
        filter        ( --interior-only );
        xOf           ethylBenzene;   // the article reports the other member; x = 1 - x'
        extract       "bin/choupo-thermoml extract-vle <article file> --block 30 --interior-only --x-of ethylBenzene --into <dir>";
        sha256        "80ec6c825a34858fa1b2de449b0ee4d9cb16593c3215f2ebeff444e3c39f32db";
        identity
        {
            ethylBenzene   { cas "100-41-4"; inchiKey "YNQLUTRBYVCPMQ-UHFFFAOYSA-N"; }
            monochlorobenzene { cas "108-90-7"; inchiKey "MVPPADPHJFYWMZ-UHFFFAOYSA-N"; }
        }
    }
);
