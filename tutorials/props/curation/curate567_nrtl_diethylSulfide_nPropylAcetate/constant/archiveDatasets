(
    {
        file          "constant/archiveExtracts/diethylSulfide-nPropylAcetate-bubbleP-j.fluid.2010.11.026-b11.dat";
        role          fit;   // C283: every laboratory is fitted
        doi           "10.1016/j.fluid.2010.11.026";
        url           "https://trc.nist.gov/ThermoML/10.1016/j.fluid.2010.11.026.xml";
        page          "https://trc.nist.gov/ThermoML/10.1016/j.fluid.2010.11.026.json";
