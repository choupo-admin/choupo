        articleSha256 "eb52ee2098f75e25e57b87634501a20a630bb76b623e66c3b284e8e8e0dcabb2";
        block         11;
        extractor     bubblePressure;
        extract       "bin/choupo-thermoml extract-px <article file> --block 11 --into <dir>";
        sha256        "36cc35fe44895f5e3cc37a93c0f295d3d21d1734e041312d912c83a49d81e138";
        identity
        {
