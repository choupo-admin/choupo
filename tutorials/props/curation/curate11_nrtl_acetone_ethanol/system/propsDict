/*---------------------------------------------------------------------------*\
  curate11_nrtl_acetone_ethanol -- AN NRTL PAIR FROM PUBLISHED MEASUREMENTS, END TO END.

  WHY THIS SYSTEM.  two of the commonest laboratory solvents, and a positive
  deviation from Raoult's law WITHOUT an azeotrope -- the contrast to every
  other pair of this family, showing that a non-ideal pair need not pinch a
  column.

  THE CHAIN, EACH STEP A COMMAND (DEV.md C16; record
  docs/design/binary-pairs-from-open-measurements.md):
    1. bin/choupo-thermoml sync        the NIST/TRC ThermoML Archive
                                       (ThermoML.v2020-09-30.tgz, doi
                                       10.18434/mds2-2422, sha256-verified)
    2. bin/choupo-thermoml identity    CAS -> InChIKey for the catalogue,
                                       two resolvers that must agree
    3. bin/choupo-thermoml vle-index   every binary VLE block, searchable
    4. bin/choupo-thermoml vle-search acetone ethanol --geometry bubbleT
    5. bin/choupo-thermoml extract-vle <file> --block N --interior-only
                                       -> the two files under constant/experiments/
    6. choupoProps (this case)         fitParameters -> a proposal record
    7. promotion (a human act)         -> data/standards/parameters/NRTL/acetone-ethanol.dat
                                       ONLY if the held-out verdict is `validated`
    8. bin/choupo-import               the seal mirrors that record here

  THE EVIDENCE.  FIT: doi 10.1016/j.fluid.2005.01.007 (19 interior points,
  101.32 kPa).  HELD OUT: doi 10.1021/je400544h (11 interior points, 101.3
  kPa) -- an article whose title names another system; the acetone + ethanol
  block is the one the archive files under it, and reading it back is part
  of the curator's check.  Chosen BEFORE any fit by the slice-2 partition
  rule: the FIT set is the low-pressure bubble-temperature study with the
  most interior points; the HELD-OUT set is the next largest that shares NO
  author with it (the archive carries no affiliations, so a shared author is
  the dependence the rule can check).  Each file names its article, its
  archive file and block, the sha256 of the archive file, the two compounds'
  CAS and InChIKey, and the per-point expanded uncertainty; each says
  `reviewStatus transcribedNotCheckedAgainstArticle` because nobody has read
  the numbers back against the paper yet, and the run announces it.  Pure-
  component endpoints are set aside (they measure the vapour-pressure
  record, not the pair) and kept in each file under `selection`.

  THE FIT.  NRTL with a_ij = a_ji = 0 and alpha = 0.30 fixed: TWO
  parameters (b_ij, b_ji), because bubble temperatures over the ranges
  below do not identify more (fit_nrtl_ab in the methanol + water case asks
  that question directly).  Each point is weighted by 1/U, U its OWN stated
  expanded uncertainty (`weighting uncertainty;`), so a point measured to
  0.1 K is not outvoted by one measured to 1 K.  The held-out AAD is plain
  kelvin, unweighted.

  WHAT THE RUN FOUND (pinned in `expected`; measured, not argued).
    * fit_nrtl: b_ij = 149.8 K, b_ji = 68.1 K, in-sample rms 0.072 K;
      fit_nrtl_start2 lands on the same pair.  max|corr| 0.997: the two b's
      are nearly one direction in the data, as for every near-symmetric pair
      here.
    * HELD OUT (101.3 kPa, no author in common): AAD 0.093 K (0.028 %)
      against a band of 0.14 % -> `validated`; the pair is the catalogue
      record NRTL/acetone-ethanol.dat.
    * Overlay on the held-out set: NRTL 0.093 K, UNIFAC 0.79 K, ideal 3.6 K.
    * PHASE STABILITY: one liquid at every temperature down to 200 K.

  WHAT IS NOT CLAIMED.  The pair is correct at these pressures and in this
  frame (ideal-gas vapour, the catalogue's Antoine records); nothing here
  tests it at high pressure, against LLE, or with another vapour model.
\*---------------------------------------------------------------------------*/

operations
(
    {
        name        fit_nrtl;
        type        fitParameters;

        parameters
        (
            { path  equilibrium.liquid.activityModel.binaryParameters.acetone-ethanol.b_ij;  initial 0;  min -3000;  max 3000; }
            { path  equilibrium.liquid.activityModel.binaryParameters.acetone-ethanol.b_ji;  initial 0;  min -3000;  max 3000; }
        );

        evidence
        (
            {
                dataset  "constant/experiments/acetone-ethanol-bubble-j.fluid.2005.01.007.dat";
                role     fit;
            }
            {
                dataset  "constant/experiments/acetone-ethanol-bubble-je400544h.dat";
                role     validation;
            }
        );

        acceptance
        {
            maxAAD  0.14 percent;
            origin  "declared before the fit, by the ONE rule of C16 (slice 1, five systems; slice 2, four more): the held-out set's largest stated expanded uncertainty (U95 = 0.41 K) plus the catalogue vapour-pressure model's own error at that set's pure endpoints (ethanol -0.003 K, acetone +0.041 K; measured with no pair involved), as a percentage of the held-out mean T (337.79 K) = 0.1335 %, rounded UP to two significant figures";
        }

        residual
        {
            kind        T_bubble;
            components  ( acetone ethanol );
            weighting   uncertainty;
        }

        options
        {
            maxIter      80;
            tolerance    1.0e-8;
            fdStep       1.0e-4;
            lambda0      1.0e-3;
        }

        output
        {
            fit_log    fit_history.csv;
            parity     parity.csv;
            proposal   acetone-ethanol.proposal.dat;
        }
    }
    //  THE SAME FIT FROM ANOTHER START.  A least-squares surface can hold
    //  more than one minimum; if this lands where fit_nrtl landed, the pair
    //  is the answer the data hold, not the answer a start point chose.
    {
        name        fit_nrtl_start2;
        type        fitParameters;

        parameters
        (
            { path  equilibrium.liquid.activityModel.binaryParameters.acetone-ethanol.b_ij;  initial 800;  min -3000;  max 3000; }
            { path  equilibrium.liquid.activityModel.binaryParameters.acetone-ethanol.b_ji;  initial -400;  min -3000;  max 3000; }
        );

        evidence
        (
            {
                dataset  "constant/experiments/acetone-ethanol-bubble-j.fluid.2005.01.007.dat";
                role     fit;
            }
            {
                dataset  "constant/experiments/acetone-ethanol-bubble-je400544h.dat";
                role     validation;
            }
        );

        acceptance
        {
            maxAAD  0.14 percent;
            origin  "declared before the fit, by the ONE rule of C16 (slice 1, five systems; slice 2, four more): the held-out set's largest stated expanded uncertainty (U95 = 0.41 K) plus the catalogue vapour-pressure model's own error at that set's pure endpoints (ethanol -0.003 K, acetone +0.041 K; measured with no pair involved), as a percentage of the held-out mean T (337.79 K) = 0.1335 %, rounded UP to two significant figures";
        }

        residual
        {
            kind        T_bubble;
            components  ( acetone ethanol );
            weighting   uncertainty;
        }

        options
        {
            maxIter      80;
            tolerance    1.0e-8;
            fdStep       1.0e-4;
            lambda0      1.0e-3;
        }

        output
        {
            parity     parity_start2.csv;
        }
    }
    {
        name        txy_ideal;
        type        propertyScan1D;
        vary        { variable x[acetone];  from 0.0;  to 1.0;  n 101; }
        state       { P 101.3 kPa;  composition { acetone 0.5;  ethanol 0.5; } }
        thermo
        {
            equilibrium { liquid { activityModel { model ideal; } } }
        }
        properties  ( T_bubble  y_eq_acetone );
        output      { file txy_ideal.csv; }
    }
    {
        name        txy_unifac;
        type        propertyScan1D;
        vary        { variable x[acetone];  from 0.0;  to 1.0;  n 101; }
        state       { P 101.3 kPa;  composition { acetone 0.5;  ethanol 0.5; } }
        thermo
        {
            equilibrium { liquid { activityModel { model UNIFAC; } } }
        }
        properties  ( T_bubble  y_eq_acetone );
        output      { file txy_unifac.csv; }
    }
    {
        name        txy_nrtl;
        type        propertyScan1D;
        vary        { variable x[acetone];  from 0.0;  to 1.0;  n 101; }
        state       { P 101.3 kPa;  composition { acetone 0.5;  ethanol 0.5; } }
        thermo
        {
            equilibrium { liquid { activityModel { model NRTL; /* no inline pair: the catalogue record, sealed copy */ } } }
        }
        properties  ( T_bubble  y_eq_acetone );
        output      { file txy_nrtl.csv; }
    }
    {
        name        txy_ideal_fitP;
        type        propertyScan1D;
        vary        { variable x[acetone];  from 0.0;  to 1.0;  n 101; }
        state       { P 101.32 kPa;  composition { acetone 0.5;  ethanol 0.5; } }
        thermo
        {
            equilibrium { liquid { activityModel { model ideal; } } }
        }
        properties  ( T_bubble  y_eq_acetone );
        output      { file txy_ideal_fitP.csv; }
    }
    {
        name        txy_unifac_fitP;
        type        propertyScan1D;
        vary        { variable x[acetone];  from 0.0;  to 1.0;  n 101; }
        state       { P 101.32 kPa;  composition { acetone 0.5;  ethanol 0.5; } }
        thermo
        {
            equilibrium { liquid { activityModel { model UNIFAC; } } }
        }
        properties  ( T_bubble  y_eq_acetone );
        output      { file txy_unifac_fitP.csv; }
    }
    {
        name        txy_nrtl_fitP;
        type        propertyScan1D;
        vary        { variable x[acetone];  from 0.0;  to 1.0;  n 101; }
        state       { P 101.32 kPa;  composition { acetone 0.5;  ethanol 0.5; } }
        thermo
        {
            equilibrium { liquid { activityModel { model NRTL; /* no inline pair: the catalogue record, sealed copy */ } } }
        }
        properties  ( T_bubble  y_eq_acetone );
        output      { file txy_nrtl_fitP.csv; }
    }
);

experimental
(
    {
        name      heldout_acetone_ethanol;
        component acetone;
        kind      txy;
        models    ( txy_ideal  txy_unifac  txy_nrtl );
        dataset   "constant/experiments/acetone-ethanol-bubble-je400544h.dat";
        source    "held out: doi 10.1021/je400544h";
    }
    {
        name      fitset_acetone_ethanol;
        component acetone;
        kind      txy;
        models    ( txy_ideal_fitP  txy_unifac_fitP  txy_nrtl_fitP );
        dataset   "constant/experiments/acetone-ethanol-bubble-j.fluid.2005.01.007.dat";
        source    "IN-SAMPLE (the fit set): doi 10.1016/j.fluid.2005.01.007";
    }
);
