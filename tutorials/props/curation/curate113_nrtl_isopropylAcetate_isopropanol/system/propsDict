            }
            {
                dataset  "constant/archiveExtracts/isopropylAcetate-isopropanol-bubble-j.fluid.2019.06.016.dat";
                role     fit;
            }
        );

        objective { method twoStage;  scale { T_bubble absolute; } }
        residual
        {
            kind        T_bubble;
            components  ( isopropylAcetate isopropanol );
            weighting   uncertainty;
        }

        options
        {
            maxIter      80;
            tolerance    1.0e-6;
            fdStep       1.0e-4;
            lambda0      1.0e-3;
        }

        output
        {
            parity     parity_start2.csv;
        }
    }
    {
        name        txy_ideal;
        type        propertyScan1D;
        vary        { variable x[isopropylAcetate];  from 0.0;  to 1.0;  n 101; }
        state       { P 101.32 kPa;  composition { isopropylAcetate 0.5;  isopropanol 0.5; } }
        thermo
        {
            equilibrium { liquid { activityModel { model ideal; } } }
        }
        properties  ( T_bubble  y_eq_isopropylAcetate );
        output      { file txy_ideal.csv; }
    }
    {
        name        txy_unifac;
