operations
(
    {
        name        fit_nrtl;
        type        fitParameters;

        parameters
        (
            { path  equilibrium.liquid.activityModel.binaryParameters.isopropylAcetate-isopropanol.b_ij;  initial 0;  min -3000;  max 3000; }
            { path  equilibrium.liquid.activityModel.binaryParameters.isopropylAcetate-isopropanol.b_ji;  initial 0;  min -3000;  max 3000; }
        );

        evidence
        (
            {
                dataset  "constant/archiveExtracts/isopropylAcetate-isopropanol-bubble-acs.jced.5b00360.dat";
                role     fit;
            }
            {
                dataset  "constant/archiveExtracts/isopropylAcetate-isopropanol-bubble-j.fluid.2017.09.010.dat";
                role     fit;
            }
            {
                dataset  "constant/archiveExtracts/isopropylAcetate-isopropanol-bubble-j.fluid.2019.06.016.dat";
                role     fit;
            }
        );

        objective { method twoStage;  scale { T_bubble absolute; } }
        residual
        {
            kind        T_bubble;
            components  ( isopropylAcetate isopropanol );
            weighting   uncertainty;
        }

        options
        {
            maxIter      80;
            tolerance    1.0e-6;
            fdStep       1.0e-4;
            lambda0      1.0e-3;
        }

        output
        {
            fit_log    fit_history.csv;
            parity     parity.csv;
            proposal   isopropanol-isopropylAcetate.proposal.dat;
        }
    }
    {
        name        fit_nrtl_start2;
        type        fitParameters;

        parameters
        (
            { path  equilibrium.liquid.activityModel.binaryParameters.isopropylAcetate-isopropanol.b_ij;  initial 800;  min -3000;  max 3000; }
