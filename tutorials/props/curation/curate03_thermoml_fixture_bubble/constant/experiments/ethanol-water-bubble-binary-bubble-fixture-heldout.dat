/*--------------------------------------------------------------------------*\
  FIXED-PRESSURE BINARY BUBBLE-POINT EVIDENCE, extracted from a ThermoML
  file by bin/choupo-thermoml extract-vle.

  system       ethanol + water   (x1 is ethanol)
  pressure     101.325 kPa   (CONSTANT across the series)
  points       3

  The identity below is DECLARED AS FIELDS, not only described here:
  a header is a comment the parser discards, and the dossier must be
  able to say which archive file, which publication and which system
  a verdict rests on.

  The role this evidence plays -- fit or held-out validation -- is NOT
  set here.  It is declared in the operation that consumes it, before
  any fitting runs (src/propertyOps/EvidencePartition.H).
\*--------------------------------------------------------------------------*/

property     binaryVLE.T_bubble;
system       ( ethanol water );
pressure     101.325 kPa;

provenance
{
    source       synthetic;
    note         "STRUCTURAL FIXTURE -- generated, never measured.  Any verdict computed from it is about the machinery, not physics";
    archiveFile  "binary-bubble-fixture-heldout.xml";
    doi          "10.0000/choupo-structural-fixture-heldout";
    sha256       "5c373e6bcb5004cd2505d05ab4b920937d332f48384b1a45aa8013155d975091";
}

columns
(
    { name x1;  unit -;  }
    { name T;   unit K;  }
);

data
(
      0.4000  356.85
      0.6000  355.3
      0.8000  353.3
);
