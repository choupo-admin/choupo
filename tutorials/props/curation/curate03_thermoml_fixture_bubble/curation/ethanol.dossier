/*--------------------------------*- Choupo -*--------------------------------*\
  CURATION DOSSIER -- a scientific work record, NOT runtime property data.

  NOTHING IN THIS FILE IS VISIBLE TO THE SOLVER.  Record resolution looks only
  in <case>/constant/, data/standards/ and data/local/, so a file here is out
  of its reach BY CONSTRUCTION -- not by convention.

  Nothing here has been promoted.  Curation state belongs to the evidence
  process; runtime trust belongs to the numerical record actually admitted
  to data/standards/, and only an explicit human promotion moves one there
  (bin/curate/promote-from-dossier).

  MATURITY IS PER PROPERTY, not per component: the properties below may hold
  different verdicts, and any whole-component summary is DERIVED from them
  rather than stored beside them.

  Regenerated on every run.  Hand edits are lost.
\*-----------------------------------------------------------------------------*/

component      ethanol;
reviewStatus   unreviewed;

properties
(
{
    property       binaryVLE.T_bubble;
    operation      thermoml_fixture_bubble;   // type fitParameters
    model          "NRTL binary pair, bubble-T residual at fixed P";
    verdict        validated;

    fittedParameters
    {
        equilibrium.liquid.activityModel.binaryParameters.ethanol-water.a_ij  13.2712085295;
        equilibrium.liquid.activityModel.binaryParameters.ethanol-water.b_ij  -4999.92010409;
        equilibrium.liquid.activityModel.binaryParameters.ethanol-water.a_ji  2.27153896848;
        equilibrium.liquid.activityModel.binaryParameters.ethanol-water.b_ji  131.041909204;
    }

    evidence
    {
        partitionFingerprint  "bcd8e081cfd866ff";   // frozen before the fit

        datasets
        (
        {
            role      fit;
            dataset   "constant/experiments/ethanol-water-bubble-binary-bubble-fixture.dat";
            doi       "10.0000/choupo-structural-fixture";
            sha256    "73b7cd00a31e79391084d569093b69cd0898539101a78d9a838a96d613ac6ce2";
            provenance synthetic;   // GENERATED, not measured -- any verdict here is about the machinery
            archiveFile "binary-bubble-fixture.xml";
            system    "ethanol + water";
            pressure  "101325.000000 Pa";
        }
        {
            role      validation;
            dataset   "constant/experiments/ethanol-water-bubble-binary-bubble-fixture-heldout.dat";
            doi       "10.0000/choupo-structural-fixture-heldout";
            sha256    "5c373e6bcb5004cd2505d05ab4b920937d332f48384b1a45aa8013155d975091";
            provenance synthetic;   // GENERATED, not measured -- any verdict here is about the machinery
            archiveFile "binary-bubble-fixture-heldout.xml";
            system    "ethanol + water";
            pressure  "101325.000000 Pa";
        }
        );

        domain
        {
            coordinate  x1;
            fit         { min 0.05; max 0.9; n 7; }
            validation  { min 0.4; max 0.8; n 3; }
        }
    }

    metrics
    {
        //  r2InSample: not computed by this operation (it reports chi-square).
        //  rmsHeldOut: not computed by this operation (see aadHeldOutPct).
        aadHeldOutPct     0.0528782856338;
        acceptanceMaxAADPct 0.5;   // DECLARED BEFORE the fit; part of the fingerprint
        acceptanceOrigin  "PLUMBING tolerance for a synthetic structural fixture -- the numbers are invented, so this band bounds the extract/partition/regress path and states nothing about experimental accuracy";
    }
}

);
