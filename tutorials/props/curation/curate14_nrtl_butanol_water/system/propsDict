        objective { method leastSquares; }

        residual
        {
            kind        T_bubble+LLE;
            components  ( nButanol water );
            weighting   uncertainty;
            liquidLiquid
            {
                sigmaRelative   0.025;
                origin  "sigmaRelative (C280, the default relative scale of the binodal rows): 0.025 is the absolute sigma this case used before C280, 0.0005, expressed at the water-rich liquid's mole fraction of about 0.02 -- the same judgement of one measurement's uncertainty, as a fraction of the value, so the relative rows weigh the solubility as the absolute ones were meant to; it is the low end of the stated uncertainties, not a value chosen to reach a verdict. The absolute sigma (`scale { binodal absolute; }`, `sigma 0.0005;`) was: REVISED after the first run, and said so: 0.0005, the low end of the tie lines' own stated uncertainties (0.0004 to 0.04). The value declared before the first run, 0.005, is a quarter of the quantity being fitted on the water-rich side (butanol mole fraction about 0.02), so the fit could not see the solubility in water at all and the bubble temperatures (U 0.17 K) decided the pair; the solubility against temperature is what this pair is for (DEV.md 4c C16)";
            }
        }

        options
        {
            maxIter      120;
            tolerance    1.0e-8;
            fdStep       1.0e-4;
            lambda0      1.0e-3;
        }

        output
        {
            fit_log    fit_binodal_history.csv;
            parity     fit_binodal_parity.csv;
            proposal   nButanol-water.proposal.dat;
        }
