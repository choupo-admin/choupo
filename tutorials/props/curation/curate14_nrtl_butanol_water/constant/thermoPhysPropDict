/*---------------------------------------------------------------------------*\
  curate14_nrtl_butanol_water -- the thermophysical system.

  TWO LIQUIDS, ONE ACTIVITY MODEL.  The tie-line residual asks the
  liquid-liquid flash, which needs two liquid phases in the package, so the
  system is declared the way binary01_lle_water_nbutanol declares it:
  `formulation gammaGamma` and `liquidPhases ( liquid1 liquid2 )`, both
  liquids sharing the ONE activity model below -- so the pair being fitted
  is one number, not two.  The bubble temperatures are asked of the same
  package (ideal-gas vapour, the catalogue's own Antoine records).

  The inline pair is the FIT'S STARTING POINT, not a result: b_ij = 0,
  b_ji = 1000 K is a pair that DOES split the liquid at every measured tie
  line (an all-zero start would be ideal mixing, split nothing, and give the
  penalty no gradient -- the run refuses such a start by name).  The fit
  frees a_ij, a_ji and alpha as well (propsDict), from the values below.
\*---------------------------------------------------------------------------*/

recordType    thermophysicalPropertySystem;
schemaVersion 2;

components       ( nButanol  water );

equilibrium
{
    formulation gammaGamma;

    liquid
    {
        activityModel
        {
            model NRTL;
            binaryParameters   // the FIT'S starting point -- see the header
            {
                nButanol-water
                {
                    i nButanol;
                    j water;
                    a_ij 0;
                    b_ij 0;
                    a_ji 0;
                    b_ji 1000;
                    alpha 0.30;
                }
            }
        }
    }

    liquidPhases
    (
        { name liquid1; }
        { name liquid2; }
    );

    vapour
    {
        fugacityModel idealGas;
    }
}
