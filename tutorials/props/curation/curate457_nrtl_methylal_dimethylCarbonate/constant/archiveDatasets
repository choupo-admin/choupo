        articleSha256 "9d9be30402105a98d32ce291d749fab123063272cdd1138201a6abd4e379faad";
        block         10;
        filter        ( --interior-only );
        extract       "bin/choupo-thermoml extract-vle <article file> --block 10 --interior-only --into <dir>";
        sha256        "d697c007aa01e0fd8a45bf77b5fa31e113c7f702b959d124b02cace4e0c42f2f";
        identity
        {
            methylal       { cas "109-87-5"; inchiKey "NKDDWNXOKDWJAK-UHFFFAOYSA-N"; }
