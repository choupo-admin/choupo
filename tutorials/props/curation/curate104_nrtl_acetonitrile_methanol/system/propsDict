/*---------------------------------------------------------------------------*\
  curate104_nrtl_acetonitrile_methanol -- AN NRTL PAIR FROM EVERY LABORATORY'S MEASUREMENTS.

  WRITTEN BY bin/choupo-curate pair acetonitrile methanol (DEV.md 4c C284, the bulk run;
  record docs/design/binary-pairs-from-open-measurements.md section 11).

  THE DECLARATION -- WRITTEN AND COMMITTED BEFORE ANY FIT RAN (several
  declarations of the bulk run share one commit).

  IDENTITY.  acetonitrile (CAS 75-05-8, InChIKey WEVYAHXRMPXWCK-UHFFFAOYSA-N)
  + methanol (CAS 67-56-1, InChIKey OKKJLVBELUTLKV-UHFFFAOYSA-N), joined
  to the archive through identity.json -- never by name.  CLASS (C284): both
  records are volatile molecular liquids (no role nonvolatile/solute, no
  dissociatesTo, no charge, no solid, a vapour-pressure model), and every
  measured temperature lies below both critical temperatures.

  NO MEASURED SERIES IN THIS TREE.  constant/archiveDatasets names each
  dataset (DOI, NIST URL, article sha256, extraction selector, extract
  sha256); `bin/choupo-curate fetch` writes the points into
  constant/archiveExtracts/, which is gitignored.

  STUDIES: every bubble-temperature block of the pair at or below 110 kPa
  with a declared uncertainty (4 block(s)).  FITTED, ALL OF THEM
  (4):
      10.1016/j.fluid.2018.08.009    block 0    14 pts  101.3 kPa  337.24-347.91 K  U 0.13-0.19 K
      10.1021/acs.jced.5b00796       block 2    14 pts  101.32 kPa  336.55-347.85 K  U 0.22-0.31 K
        (reports x of the other member: written as x[acetonitrile] = 1 - x by --x-of)
      10.1016/j.jct.2016.05.011      block 6    13 pts  101.3 kPa  336.57-351.02 K  U 0.31-0.42 K
        (reports x of the other member: written as x[acetonitrile] = 1 - x by --x-of)
      10.1016/j.fluid.2012.12.003    block 7    10 pts  101.3 kPa  336.96-350.19 K  U 0.08-0.1 K
        (reports x of the other member: written as x[acetonitrile] = 1 - x by --x-of)
  SET ASIDE BY THE EXTRACTION RULES, BY NAME:
      (none)

  THE RULE (DEV.md 4c C283 amended, C284).  Every laboratory above is
  fitted; none is held out (the C16 partition and its band are retired as
  the acceptance test).  NRTL, a_ij = a_ji = 0, alpha = 0.30 fixed: two
  parameters (b_ij, b_ji); each point weighted by 1/U, U its own stated
  expanded uncertainty.  Objective twoStage (least squares, then minimax;
  T_bubble absolute, in K).  OUTLIERS: after a least-squares stage over every
  point, a point with |T_model - T| > 3 K is discarded BY
  NAME (`discard` on its evidence entry, listed below) and the fit repeated
  without it.  ACCEPTED when max |T_model - T| over the KEPT points is below
  1 K.  C283's 5 % relative clause judges composition; this fit has no
  composition residual, so only the temperature clause applies.  A pair
  that splits ONE liquid inside its validity span is not promoted (arm f).
  Two starts: (0, 0) and (800, -400).

  OUTLIERS DISCARDED AFTER THE LEAST-SQUARES STAGE:
  @@OUTLIERS-BEGIN@@
      none: every one of the 51 points lies within 3 K after the
      least-squares stage.
  @@OUTLIERS-END@@

  @@RESULT-BEGIN@@
  WHAT THE RUN FOUND (pinned in `expected`; measured, not argued).
  fit_nrtl: b_ij = 351.5 K, b_ji = -20.1 K over 51 kept points of 4
  laboratories (0 discarded): max |dT| 0.991 K, mean 0.452 K against the
  acceptance 1 K -> accepted. fit_nrtl_start2 lands on the same pair
  (351.5, -20.1). PROMOTED on 2026-11-10 into
  data/standards/parameters/NRTL/acetonitrile-methanol.dat as
  reviewStatus autoPromoted, humanReviewed false, because: max |dT| 0.991
  K < 1 K over the 51 kept points, one liquid across the validity span
  @@RESULT-END@@

  WHAT IS NOT CLAIMED.  The pair is correct at these pressures and in this
  frame (ideal-gas vapour, the catalogue's own vapour-pressure records); the
  measurements were transcribed by the archive and have NOT been read back
  against the articles (the CHECKLIST that `fetch` writes is the aid).
\*---------------------------------------------------------------------------*/

operations
(
    {
        name        fit_nrtl;
        type        fitParameters;

        parameters
        (
            { path  equilibrium.liquid.activityModel.binaryParameters.acetonitrile-methanol.b_ij;  initial 0;  min -3000;  max 3000; }
            { path  equilibrium.liquid.activityModel.binaryParameters.acetonitrile-methanol.b_ji;  initial 0;  min -3000;  max 3000; }
        );

        evidence
        (
            {
                dataset  "constant/archiveExtracts/acetonitrile-methanol-bubble-j.fluid.2018.08.009.dat";
                role     fit;
            }
            {
                dataset  "constant/archiveExtracts/acetonitrile-methanol-bubble-acs.jced.5b00796.dat";
                role     fit;
            }
            {
                dataset  "constant/archiveExtracts/acetonitrile-methanol-bubble-j.jct.2016.05.011.dat";
                role     fit;
            }
            {
                dataset  "constant/archiveExtracts/acetonitrile-methanol-bubble-j.fluid.2012.12.003.dat";
                role     fit;
            }
        );

        objective { method twoStage;  scale { T_bubble absolute; } }
        residual
        {
            kind        T_bubble;
            components  ( acetonitrile methanol );
            weighting   uncertainty;
        }

        options
        {
            maxIter      80;
            tolerance    1.0e-6;
            fdStep       1.0e-4;
            lambda0      1.0e-3;
        }

        output
        {
            fit_log    fit_history.csv;
            parity     parity.csv;
            proposal   acetonitrile-methanol.proposal.dat;
        }
    }
    {
        name        fit_nrtl_start2;
        type        fitParameters;

        parameters
        (
            { path  equilibrium.liquid.activityModel.binaryParameters.acetonitrile-methanol.b_ij;  initial 800;  min -3000;  max 3000; }
            { path  equilibrium.liquid.activityModel.binaryParameters.acetonitrile-methanol.b_ji;  initial -400;  min -3000;  max 3000; }
        );

        evidence
        (
            {
                dataset  "constant/archiveExtracts/acetonitrile-methanol-bubble-j.fluid.2018.08.009.dat";
                role     fit;
            }
            {
                dataset  "constant/archiveExtracts/acetonitrile-methanol-bubble-acs.jced.5b00796.dat";
                role     fit;
            }
            {
                dataset  "constant/archiveExtracts/acetonitrile-methanol-bubble-j.jct.2016.05.011.dat";
                role     fit;
            }
            {
                dataset  "constant/archiveExtracts/acetonitrile-methanol-bubble-j.fluid.2012.12.003.dat";
                role     fit;
            }
        );

        objective { method twoStage;  scale { T_bubble absolute; } }
        residual
        {
            kind        T_bubble;
            components  ( acetonitrile methanol );
            weighting   uncertainty;
        }

        options
        {
            maxIter      80;
            tolerance    1.0e-6;
            fdStep       1.0e-4;
            lambda0      1.0e-3;
        }

        output
        {
            parity     parity_start2.csv;
        }
    }
    {
        name        txy_ideal;
        type        propertyScan1D;
        vary        { variable x[acetonitrile];  from 0.0;  to 1.0;  n 101; }
        state       { P 101.3 kPa;  composition { acetonitrile 0.5;  methanol 0.5; } }
        thermo
        {
            equilibrium { liquid { activityModel { model ideal; } } }
        }
        properties  ( T_bubble  y_eq_acetonitrile );
        output      { file txy_ideal.csv; }
    }
    {
        name        txy_nrtl;
        type        propertyScan1D;
        vary        { variable x[acetonitrile];  from 0.0;  to 1.0;  n 101; }
        state       { P 101.3 kPa;  composition { acetonitrile 0.5;  methanol 0.5; } }
        thermo
        {
            equilibrium { liquid { activityModel { model NRTL; /* no inline pair: the case's own record */ } } }
        }
        properties  ( T_bubble  y_eq_acetonitrile );
        output      { file txy_nrtl.csv; }
    }
);

experimental
