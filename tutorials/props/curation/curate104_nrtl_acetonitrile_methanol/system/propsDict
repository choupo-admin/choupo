    {
        name      study1;
        component acetonitrile;
        kind      txy;
        models    ( txy_ideal  txy_nrtl );
        dataset   "constant/archiveExtracts/acetonitrile-methanol-bubble-j.fluid.2018.08.009.dat";
        source    "IN-SAMPLE (fitted): doi 10.1016/j.fluid.2018.08.009";
