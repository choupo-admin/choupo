(
    {
        file          "constant/archiveExtracts/ethanol-pXylene-bubble-je200868y.dat";
        role          fit;   // C283: every laboratory is fitted
        doi           "10.1021/je200868y";
        url           "https://trc.nist.gov/ThermoML/10.1021/je200868y.xml";
        page          "https://trc.nist.gov/ThermoML/10.1021/je200868y.json";
