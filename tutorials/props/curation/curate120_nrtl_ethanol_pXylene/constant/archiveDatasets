        articleSha256 "c8eb85482568bab9e54c9789e8acb353dcc7cb3c8820474c24b5f0bd6528dab4";
        block         6;
        filter        ( --interior-only );
        extract       "bin/choupo-thermoml extract-vle <article file> --block 6 --interior-only --into <dir>";
        sha256        "f6453bbcf186793c3f4562858d6d1a02afc57bf9d46ec95cdc67dd55fa70290b";
        identity
        {
            ethanol        { cas "64-17-5"; inchiKey "LFQSCWFLJHTTHZ-UHFFFAOYSA-N"; }
