        block         11;
        filter        ( --interior-only );
        extract       "bin/choupo-thermoml extract-vle <article file> --block 11 --interior-only --into <dir>";
        sha256        "fb66953f2f2a9e058033fb43d57fb86b2802587df826a20b61e27fe5478a55e9";
        identity
        {
            cyclohexene    { cas "110-83-8"; inchiKey "HGCIXCUEYOPUTN-UHFFFAOYSA-N"; }
