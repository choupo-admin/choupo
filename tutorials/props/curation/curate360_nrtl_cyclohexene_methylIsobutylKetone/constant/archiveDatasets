(
    {
        file          "constant/archiveExtracts/cyclohexene-methylIsobutylKetone-bubble-je100776x.dat";
        role          fit;   // C283: every laboratory is fitted
        doi           "10.1021/je100776x";
        url           "https://trc.nist.gov/ThermoML/10.1021/je100776x.xml";
        page          "https://trc.nist.gov/ThermoML/10.1021/je100776x.json";
