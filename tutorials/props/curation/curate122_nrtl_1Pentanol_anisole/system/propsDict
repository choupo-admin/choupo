/*---------------------------------------------------------------------------*\
  curate122_nrtl_1Pentanol_anisole -- AN NRTL PAIR FROM EVERY LABORATORY'S MEASUREMENTS.

  WRITTEN BY bin/choupo-curate pair 1Pentanol anisole (DEV.md 4c C284, the bulk run;
  record docs/design/binary-pairs-from-open-measurements.md section 10).

  THE DECLARATION -- WRITTEN AND COMMITTED BEFORE ANY FIT RAN (several
  declarations of the bulk run share one commit).

  IDENTITY.  1Pentanol (CAS 71-41-0, InChIKey AMQJEAYHLZJPGS-UHFFFAOYSA-N)
  + anisole (CAS 100-66-3, InChIKey RDOXTESZEPMUJZ-UHFFFAOYSA-N), joined
  to the archive through identity.json -- never by name.  CLASS (C284): both
  records are volatile molecular liquids (no role nonvolatile/solute, no
  dissociatesTo, no charge, no solid, a vapour-pressure model), and every
  measured temperature lies below both critical temperatures.

  NO MEASURED SERIES IN THIS TREE.  constant/archiveDatasets names each
  dataset (DOI, NIST URL, article sha256, extraction selector, extract
  sha256); `bin/choupo-curate fetch` writes the points into
  constant/archiveExtracts/, which is gitignored.

  STUDIES: every bubble-temperature block of the pair at or below 110 kPa
  with a declared uncertainty (2 block(s)).  FITTED, ALL OF THEM
  (2):
      10.1021/je700594n              block 14   40 pts  4 isobars 26.66-101.32 kPa  372.65-419.85 K  U 0.13-0.26 K
      10.1021/je034189g              block 4    28 pts  101.32 kPa  410.06-422.80 K  U 0.12-0.34 K
  SET ASIDE BY THE EXTRACTION RULES, BY NAME:
      (none)

  THE RULE (DEV.md 4c C283 amended, C284).  Every laboratory above is
  fitted; none is held out (the C16 partition and its band are retired as
  the acceptance test).  NRTL, a_ij = a_ji = 0, alpha = 0.30 fixed: two
  parameters (b_ij, b_ji); each point weighted by 1/U, U its own stated
  expanded uncertainty.  Objective twoStage (least squares, then minimax;
  T_bubble absolute, in K).  OUTLIERS: after a least-squares stage over every
  point, a point with |T_model - T| > 3 K is discarded BY
  NAME (`discard` on its evidence entry, listed below) and the fit repeated
  without it.  ACCEPTED when max |T_model - T| over the KEPT points is below
  1 K.  C283's 5 % relative clause judges composition; this fit has no
  composition residual, so only the temperature clause applies.  A pair
  that splits ONE liquid inside its validity span is not promoted (arm f).
  Two starts: (0, 0) and (800, -400).

  OUTLIERS DISCARDED AFTER THE LEAST-SQUARES STAGE:
  @@OUTLIERS-BEGIN@@
      none: every one of the 68 points lies within 3 K after the
      least-squares stage.
  @@OUTLIERS-END@@

  @@RESULT-BEGIN@@
  WHAT THE RUN FOUND (pinned in `expected`; measured, not argued).
  fit_nrtl: b_ij = 143.6 K, b_ji = 178.8 K over 68 kept points of 2
  laboratories (0 discarded): max |dT| 0.884 K, mean 0.197 K against the
  acceptance 1 K -> accepted. fit_nrtl_start2 lands on the same pair
  (143.6, 178.8). PROMOTED on 2026-11-10 into
  data/standards/parameters/NRTL/1Pentanol-anisole.dat as reviewStatus
  autoPromoted, humanReviewed false, because: max |dT| 0.884 K < 1 K over
  the 68 kept points, one liquid across the validity span
  @@RESULT-END@@

  WHAT IS NOT CLAIMED.  The pair is correct at these pressures and in this
  frame (ideal-gas vapour, the catalogue's own vapour-pressure records); the
  measurements were transcribed by the archive and have NOT been read back
  against the articles (the CHECKLIST that `fetch` writes is the aid).
\*---------------------------------------------------------------------------*/

operations
(
    {
        name        fit_nrtl;
        type        fitParameters;

        parameters
        (
            { path  equilibrium.liquid.activityModel.binaryParameters.1Pentanol-anisole.b_ij;  initial 0;  min -3000;  max 3000; }
            { path  equilibrium.liquid.activityModel.binaryParameters.1Pentanol-anisole.b_ji;  initial 0;  min -3000;  max 3000; }
        );

        evidence
        (
            {
                dataset  "constant/archiveExtracts/1Pentanol-anisole-bubble-je700594n.dat";
                role     fit;
            }
            {
                dataset  "constant/archiveExtracts/1Pentanol-anisole-bubble-je034189g.dat";
                role     fit;
            }
        );

        objective { method twoStage;  scale { T_bubble absolute; } }
        residual
        {
            kind        T_bubble;
            components  ( 1Pentanol anisole );
            weighting   uncertainty;
        }

        options
        {
            maxIter      80;
            tolerance    1.0e-6;
            fdStep       1.0e-4;
            lambda0      1.0e-3;
        }

        output
        {
            fit_log    fit_history.csv;
            parity     parity.csv;
            proposal   1Pentanol-anisole.proposal.dat;
        }
    }
    {
        name        fit_nrtl_start2;
        type        fitParameters;

        parameters
        (
            { path  equilibrium.liquid.activityModel.binaryParameters.1Pentanol-anisole.b_ij;  initial 800;  min -3000;  max 3000; }
            { path  equilibrium.liquid.activityModel.binaryParameters.1Pentanol-anisole.b_ji;  initial -400;  min -3000;  max 3000; }
        );

        evidence
        (
            {
                dataset  "constant/archiveExtracts/1Pentanol-anisole-bubble-je700594n.dat";
                role     fit;
            }
            {
                dataset  "constant/archiveExtracts/1Pentanol-anisole-bubble-je034189g.dat";
                role     fit;
            }
        );

        objective { method twoStage;  scale { T_bubble absolute; } }
        residual
        {
            kind        T_bubble;
            components  ( 1Pentanol anisole );
            weighting   uncertainty;
        }

        options
        {
            maxIter      80;
            tolerance    1.0e-6;
            fdStep       1.0e-4;
            lambda0      1.0e-3;
        }

        output
        {
            parity     parity_start2.csv;
        }
    }
    {
        name        txy_ideal;
        type        propertyScan1D;
        vary        { variable x[1Pentanol];  from 0.0;  to 1.0;  n 101; }
        state       { P 101.32 kPa;  composition { 1Pentanol 0.5;  anisole 0.5; } }
        thermo
        {
            equilibrium { liquid { activityModel { model ideal; } } }
        }
        properties  ( T_bubble  y_eq_1Pentanol );
        output      { file txy_ideal.csv; }
    }
    {
        name        txy_nrtl;
        type        propertyScan1D;
        vary        { variable x[1Pentanol];  from 0.0;  to 1.0;  n 101; }
        state       { P 101.32 kPa;  composition { 1Pentanol 0.5;  anisole 0.5; } }
        thermo
        {
            equilibrium { liquid { activityModel { model NRTL; /* no inline pair: the case's own record */ } } }
        }
        properties  ( T_bubble  y_eq_1Pentanol );
        output      { file txy_nrtl.csv; }
    }
);

experimental
(
    {
        name      study2;
        component 1Pentanol;
        kind      txy;
        models    ( txy_ideal  txy_nrtl );
        dataset   "constant/archiveExtracts/1Pentanol-anisole-bubble-je034189g.dat";
        source    "IN-SAMPLE (fitted): doi 10.1021/je034189g";
    }
);
