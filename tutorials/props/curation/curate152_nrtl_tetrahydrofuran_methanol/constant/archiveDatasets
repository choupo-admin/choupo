/*--------------------------------*- Choupo -*--------------------------------*\
  constant/archiveDatasets -- WHERE the measurements of curate152_nrtl_tetrahydrofuran_methanol
  come from, and how to regenerate them.  NO MEASURED POINT IS IN THIS TREE
  (Vitor, 2026-11-10: the measured series are not copied; only the fitted
  parameters are kept).  `bin/choupo-curate fetch <case>` writes each
  dataset into constant/archiveExtracts/ (gitignored): the article file is taken from
  the local ThermoML cache when it holds it, else from the NIST URL below,
  and BOTH sha256 sums are checked -- a mismatch refuses, an unreachable
  NIST is reported NOT RUN, never a pass.
\*-----------------------------------------------------------------------------*/

recordType    archiveDatasets;

archive
{
    tarball   "ThermoML.v2020-09-30.tgz";
    doi       "10.18434/mds2-2422";
    note      "the finding aid; each article file is also served one by one at the NIST URL";
}

datasets
(
    {
        file          "constant/archiveExtracts/tetrahydrofuran-methanol-bubble-j.fluid.2013.09.060.dat";
        role          fit;   // C283: every laboratory is fitted
        doi           "10.1016/j.fluid.2013.09.060";
        url           "https://trc.nist.gov/ThermoML/10.1016/j.fluid.2013.09.060.xml";
        page          "https://trc.nist.gov/ThermoML/10.1016/j.fluid.2013.09.060.json";
        articleFile   "j.fluid.2013.09.060.xml";
        articleSha256 "86eedad221ccc76daeaed0595a91c36fe93380c2c035db33023e9fb2b65ac956";
        block         0;
        filter        ( --interior-only );
        extract       "bin/choupo-thermoml extract-vle <article file> --block 0 --interior-only --into <dir>";
        sha256        "07e6db5df56c8ec3df7c0b4c4757651c60211ff91bf3623dc012ff6a7dbe9151";
        identity
        {
            tetrahydrofuran { cas "109-99-9"; inchiKey "WYURNTSHIVDZCO-UHFFFAOYSA-N"; }
            methanol       { cas "67-56-1"; inchiKey "OKKJLVBELUTLKV-UHFFFAOYSA-N"; }
        }
    }
    {
        file          "constant/archiveExtracts/tetrahydrofuran-methanol-bubble-j.fluid.2016.04.012.dat";
        role          fit;   // C283: every laboratory is fitted
        doi           "10.1016/j.fluid.2016.04.012";
        url           "https://trc.nist.gov/ThermoML/10.1016/j.fluid.2016.04.012.xml";
        page          "https://trc.nist.gov/ThermoML/10.1016/j.fluid.2016.04.012.json";
        articleFile   "j.fluid.2016.04.012.xml";
        articleSha256 "9ed14db306dd7673b49a48a3fa564d3faeb4a04ab6c4ea8eefa897ed3069e015";
        block         2;
        filter        ( --interior-only );
        xOf           tetrahydrofuran;   // the article reports the other member; x = 1 - x'
        extract       "bin/choupo-thermoml extract-vle <article file> --block 2 --interior-only --x-of tetrahydrofuran --into <dir>";
        sha256        "ca78dacf63217477d571bc15d7094d6211613e4f359e4cc1c68a40b1dafae9a4";
        identity
        {
            tetrahydrofuran { cas "109-99-9"; inchiKey "WYURNTSHIVDZCO-UHFFFAOYSA-N"; }
            methanol       { cas "67-56-1"; inchiKey "OKKJLVBELUTLKV-UHFFFAOYSA-N"; }
        }
    }
);
