/*--------------------------------*- Choupo -*--------------------------------*\
  constant/archiveDatasets -- WHERE the measurements of curate320_nrtl_cyclohexene_diEthylCarbonate
  come from, and how to regenerate them.  NO MEASURED POINT IS IN THIS TREE
  (Vitor, 2026-11-10: the measured series are not copied; only the fitted
  parameters are kept).  `bin/choupo-curate fetch <case>` writes each
  dataset into constant/archiveExtracts/ (gitignored): the article file is taken from
  the local ThermoML cache when it holds it, else from the NIST URL below,
  and BOTH sha256 sums are checked -- a mismatch refuses, an unreachable
  NIST is reported NOT RUN, never a pass.
\*-----------------------------------------------------------------------------*/

recordType    archiveDatasets;

archive
{
    tarball   "ThermoML.v2020-09-30.tgz";
    doi       "10.18434/mds2-2422";
    note      "the finding aid; each article file is also served one by one at the NIST URL";
}

datasets
(
    {
        file          "constant/archiveExtracts/cyclohexene-diEthylCarbonate-bubble-je200784y.dat";
        role          fit;   // C283: every laboratory is fitted
        doi           "10.1021/je200784y";
        url           "https://trc.nist.gov/ThermoML/10.1021/je200784y.xml";
        page          "https://trc.nist.gov/ThermoML/10.1021/je200784y.json";
        articleFile   "je200784y.xml";
        articleSha256 "a7695594db44f92cb072af34f2520d0f20b183d2bac95d6a6b68553b91ac8e9a";
        block         3;
        filter        ( --interior-only );
        extract       "bin/choupo-thermoml extract-vle <article file> --block 3 --interior-only --into <dir>";
        sha256        "323a864523bf192cdd48fe5e10bb34a4af7234ae7f830caa76bddfd19d930165";
        identity
        {
            cyclohexene    { cas "110-83-8"; inchiKey "HGCIXCUEYOPUTN-UHFFFAOYSA-N"; }
            diEthylCarbonate { cas "105-58-8"; inchiKey "OIFBSDVPJOWBCH-UHFFFAOYSA-N"; }
        }
    }
);
