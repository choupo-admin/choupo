        sha256        "e08566c44c2093dfd815283ad374ff81213fdd63f438a012bab67195926f23fe";
        identity
        {
            cyclohexane    { cas "110-82-7"; inchiKey "XDTMQSROBMDMFD-UHFFFAOYSA-N"; }
            cyclohexene    { cas "110-83-8"; inchiKey "HGCIXCUEYOPUTN-UHFFFAOYSA-N"; }
        }
    }
);
