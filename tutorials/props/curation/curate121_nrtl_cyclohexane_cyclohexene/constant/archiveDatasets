/*--------------------------------*- Choupo -*--------------------------------*\
  constant/archiveDatasets -- WHERE the measurements of curate121_nrtl_cyclohexane_cyclohexene
  come from, and how to regenerate them.  NO MEASURED POINT IS IN THIS TREE
  (Vitor, 2026-11-10: the measured series are not copied; only the fitted
  parameters are kept).  `bin/choupo-curate fetch <case>` writes each
  dataset into constant/archiveExtracts/ (gitignored): the article file is taken from
  the local ThermoML cache when it holds it, else from the NIST URL below,
  and BOTH sha256 sums are checked -- a mismatch refuses, an unreachable
  NIST is reported NOT RUN, never a pass.
\*-----------------------------------------------------------------------------*/

recordType    archiveDatasets;

archive
{
    tarball   "ThermoML.v2020-09-30.tgz";
    doi       "10.18434/mds2-2422";
    note      "the finding aid; each article file is also served one by one at the NIST URL";
}

datasets
(
    {
        file          "constant/archiveExtracts/cyclohexane-cyclohexene-bubble-j.fluid.2008.12.007.dat";
        role          fit;   // C283: every laboratory is fitted
        doi           "10.1016/j.fluid.2008.12.007";
        url           "https://trc.nist.gov/ThermoML/10.1016/j.fluid.2008.12.007.xml";
        page          "https://trc.nist.gov/ThermoML/10.1016/j.fluid.2008.12.007.json";
        articleFile   "j.fluid.2008.12.007.xml";
        articleSha256 "cf0d793affc5b6352afbf58c0a1c72440497104374abf390356e141c4c39b01b";
        block         10;
        filter        ( --interior-only );
        extract       "bin/choupo-thermoml extract-vle <article file> --block 10 --interior-only --into <dir>";
        sha256        "c9bb807d5917474094666b6e1ec5aa4bc32019fb24b9176739aaf118fb6f3343";
        identity
        {
            cyclohexane    { cas "110-82-7"; inchiKey "XDTMQSROBMDMFD-UHFFFAOYSA-N"; }
            cyclohexene    { cas "110-83-8"; inchiKey "HGCIXCUEYOPUTN-UHFFFAOYSA-N"; }
        }
    }
    {
        file          "constant/archiveExtracts/cyclohexane-cyclohexene-bubble-je049902w.dat";
        role          fit;   // C283: every laboratory is fitted
        doi           "10.1021/je049902w";
        url           "https://trc.nist.gov/ThermoML/10.1021/je049902w.xml";
        page          "https://trc.nist.gov/ThermoML/10.1021/je049902w.json";
        articleFile   "je049902w.xml";
