/*---------------------------------------------------------------------------*\
  curate114_nrtl_pXylene_nDecane -- AN NRTL PAIR FROM EVERY LABORATORY'S MEASUREMENTS.

  WRITTEN BY bin/choupo-curate pair pXylene nDecane (DEV.md 4c C284, the bulk run;
  record docs/design/binary-pairs-from-open-measurements.md section 10).

  THE DECLARATION -- WRITTEN AND COMMITTED BEFORE ANY FIT RAN (several
  declarations of the bulk run share one commit).

  IDENTITY.  pXylene (CAS 106-42-3, InChIKey URLKBWYHVLBVBO-UHFFFAOYSA-N)
  + nDecane (CAS 124-18-5, InChIKey DIOQZVSQGTUSAI-UHFFFAOYSA-N), joined
  to the archive through identity.json -- never by name.  CLASS (C284): both
  records are volatile molecular liquids (no role nonvolatile/solute, no
  dissociatesTo, no charge, no solid, a vapour-pressure model), and every
  measured temperature lies below both critical temperatures.

  NO MEASURED SERIES IN THIS TREE.  constant/archiveDatasets names each
  dataset (DOI, NIST URL, article sha256, extraction selector, extract
  sha256); `bin/choupo-curate fetch` writes the points into
  constant/archiveExtracts/, which is gitignored.

  STUDIES: every bubble-temperature block of the pair at or below 110 kPa
  with a declared uncertainty (3 block(s)).  FITTED, ALL OF THEM
  (3):
      10.1021/je0501585              block 8    18 pts  97.3 kPa  410.10-439.60 K  U 1-1 K
      10.1016/j.fluid.2012.09.019    block 10   11 pts  20 kPa  360.62-389.31 K  U 0.12-0.15 K
        (reports x of the other member: written as x[pXylene] = 1 - x by --x-of)
      10.1016/j.fluid.2004.10.027    block 26    6 pts  95.8 kPa  413.05-436.35 K  U 1.01-1.01 K
  SET ASIDE BY THE EXTRACTION RULES, BY NAME:
      (none)

  THE RULE (DEV.md 4c C283 amended, C284).  Every laboratory above is
  fitted; none is held out (the C16 partition and its band are retired as
  the acceptance test).  NRTL, a_ij = a_ji = 0, alpha = 0.30 fixed: two
  parameters (b_ij, b_ji); each point weighted by 1/U, U its own stated
  expanded uncertainty.  Objective twoStage (least squares, then minimax;
  T_bubble absolute, in K).  OUTLIERS: after a least-squares stage over every
  point, a point with |T_model - T| > 3 K is discarded BY
  NAME (`discard` on its evidence entry, listed below) and the fit repeated
  without it.  ACCEPTED when max |T_model - T| over the KEPT points is below
  1 K.  C283's 5 % relative clause judges composition; this fit has no
  composition residual, so only the temperature clause applies.  A pair
  that splits ONE liquid inside its validity span is not promoted (arm f).
  Two starts: (0, 0) and (800, -400).

  OUTLIERS DISCARDED AFTER THE LEAST-SQUARES STAGE:
  @@OUTLIERS-BEGIN@@
      7 point(s) of 35: doi 10.1021/je0501585 row 1: x 0.0338, P 97.300
      kPa, T 439.60 K, dT +4.37 K; doi 10.1021/je0501585 row 2: x 0.0450,
      P 97.300 kPa, T 438.40 K, dT +4.97 K; doi 10.1021/je0501585 row 3:
      x 0.0850, P 97.300 kPa, T 435.80 K, dT +5.51 K; doi
      10.1021/je0501585 row 4: x 0.1363, P 97.300 kPa, T 434.20 K, dT
      +4.59 K; doi 10.1021/je0501585 row 5: x 0.1500, P 97.300 kPa, T
      433.70 K, dT +4.43 K; doi 10.1021/je0501585 row 6: x 0.2000, P
      97.300 kPa, T 431.80 K, dT +4.04 K; doi 10.1021/je0501585 row 7: x
      0.2500, P 97.300 kPa, T 430.60 K, dT +3.05 K
  @@OUTLIERS-END@@

  @@RESULT-BEGIN@@
  WHAT THE RUN FOUND (pinned in `expected`; measured, not argued).
  fit_nrtl: b_ij = 550.6 K, b_ji = -378.9 K over 28 kept points of 3
  laboratories (7 discarded): max |dT| 1.424 K, mean 0.334 K against the
  acceptance 1 K -> notAccepted. fit_nrtl_start2 lands on the same pair
  (550.6, -378.9). NOT PROMOTABLE: max |dT| 1.424 K over the 28 kept
  points is not below 1 K
  @@RESULT-END@@

  WHAT IS NOT CLAIMED.  The pair is correct at these pressures and in this
  frame (ideal-gas vapour, the catalogue's own vapour-pressure records); the
  measurements were transcribed by the archive and have NOT been read back
  against the articles (the CHECKLIST that `fetch` writes is the aid).
\*---------------------------------------------------------------------------*/

operations
(
    {
        name        fit_nrtl;
        type        fitParameters;

        parameters
        (
            { path  equilibrium.liquid.activityModel.binaryParameters.pXylene-nDecane.b_ij;  initial 0;  min -3000;  max 3000; }
            { path  equilibrium.liquid.activityModel.binaryParameters.pXylene-nDecane.b_ji;  initial 0;  min -3000;  max 3000; }
        );

        evidence
        (
            {
                dataset  "constant/archiveExtracts/pXylene-nDecane-bubble-je0501585.dat";
                role     fit;
                discard  ( 1 2 3 4 5 6 7 );   // C283 outliers, by name in the header
            }
            {
                dataset  "constant/archiveExtracts/pXylene-nDecane-bubble-j.fluid.2012.09.019.dat";
                role     fit;
            }
            {
                dataset  "constant/archiveExtracts/pXylene-nDecane-bubble-j.fluid.2004.10.027.dat";
                role     fit;
            }
        );

        objective { method twoStage;  scale { T_bubble absolute; } }
        residual
        {
            kind        T_bubble;
            components  ( pXylene nDecane );
            weighting   uncertainty;
        }

        options
        {
            maxIter      80;
            tolerance    1.0e-6;
            fdStep       1.0e-4;
            lambda0      1.0e-3;
        }

        output
        {
            fit_log    fit_history.csv;
            parity     parity.csv;
            proposal   nDecane-pXylene.proposal.dat;
        }
    }
    {
        name        fit_nrtl_start2;
        type        fitParameters;

        parameters
        (
            { path  equilibrium.liquid.activityModel.binaryParameters.pXylene-nDecane.b_ij;  initial 800;  min -3000;  max 3000; }
            { path  equilibrium.liquid.activityModel.binaryParameters.pXylene-nDecane.b_ji;  initial -400;  min -3000;  max 3000; }
        );

        evidence
        (
            {
                dataset  "constant/archiveExtracts/pXylene-nDecane-bubble-je0501585.dat";
                role     fit;
                discard  ( 1 2 3 4 5 6 7 );   // C283 outliers, by name in the header
            }
            {
                dataset  "constant/archiveExtracts/pXylene-nDecane-bubble-j.fluid.2012.09.019.dat";
                role     fit;
            }
            {
                dataset  "constant/archiveExtracts/pXylene-nDecane-bubble-j.fluid.2004.10.027.dat";
                role     fit;
            }
        );

        objective { method twoStage;  scale { T_bubble absolute; } }
        residual
        {
            kind        T_bubble;
            components  ( pXylene nDecane );
            weighting   uncertainty;
        }

        options
        {
            maxIter      80;
            tolerance    1.0e-6;
            fdStep       1.0e-4;
            lambda0      1.0e-3;
        }

        output
        {
            parity     parity_start2.csv;
        }
    }
    {
        name        txy_ideal;
        type        propertyScan1D;
        vary        { variable x[pXylene];  from 0.0;  to 1.0;  n 101; }
        state       { P 97.3 kPa;  composition { pXylene 0.5;  nDecane 0.5; } }
        thermo
        {
            equilibrium { liquid { activityModel { model ideal; } } }
        }
        properties  ( T_bubble  y_eq_pXylene );
        output      { file txy_ideal.csv; }
    }
    {
        name        txy_unifac;
        type        propertyScan1D;
        vary        { variable x[pXylene];  from 0.0;  to 1.0;  n 101; }
        state       { P 97.3 kPa;  composition { pXylene 0.5;  nDecane 0.5; } }
        thermo
        {
            equilibrium { liquid { activityModel { model UNIFAC; } } }
        }
        properties  ( T_bubble  y_eq_pXylene );
        output      { file txy_unifac.csv; }
    }
    {
        name        txy_nrtl;
        type        propertyScan1D;
        vary        { variable x[pXylene];  from 0.0;  to 1.0;  n 101; }
        state       { P 97.3 kPa;  composition { pXylene 0.5;  nDecane 0.5; } }
        thermo
        {
            equilibrium { liquid { activityModel { model NRTL; /* no inline pair: the case's own record */ } } }
        }
        properties  ( T_bubble  y_eq_pXylene );
        output      { file txy_nrtl.csv; }
    }
);

experimental
(
    {
        name      study1;
        component pXylene;
        kind      txy;
        models    ( txy_ideal  txy_unifac  txy_nrtl );
        dataset   "constant/archiveExtracts/pXylene-nDecane-bubble-je0501585.dat";
        source    "IN-SAMPLE (fitted): doi 10.1021/je0501585";
    }
);
