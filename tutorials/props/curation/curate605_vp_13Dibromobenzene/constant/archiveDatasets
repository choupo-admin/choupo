/*--------------------------------*- Choupo -*--------------------------------*\
  constant/archiveDatasets -- WHERE the measurements of curate605_vp_13Dibromobenzene
  come from, and how to regenerate them.  NO MEASURED POINT IS IN THIS TREE
  (Vitor, 2026-11-10: the measured series are not copied; only the fitted
  parameters are kept).  `bin/choupo-curate fetch <case>` writes each
  dataset into constant/archiveExtracts/ (gitignored): the article file is taken from
  the local ThermoML cache when it holds it, else from the NIST URL below,
  and BOTH sha256 sums are checked -- a mismatch refuses, an unreachable
  NIST is reported NOT RUN, never a pass.
\*-----------------------------------------------------------------------------*/

recordType    archiveDatasets;

archive
{
    tarball   "ThermoML.v2020-09-30.tgz";
    doi       "10.18434/mds2-2422";
    note      "the finding aid; each article file is also served one by one at the NIST URL";
}

datasets
(
    {
        file          "constant/archiveExtracts/13Dibromobenzene-vapourPressure-je5008795.dat";
        role          fit;   // informational: the operation declares it
        doi           "10.1021/je5008795";
        url           "https://trc.nist.gov/ThermoML/10.1021/je5008795.xml";
        page          "https://trc.nist.gov/ThermoML/10.1021/je5008795.json";
        articleFile   "je5008795.xml";
        articleSha256 "f720abb276f4686af6e1820f74536368c497b20e8b2cf24f364d2fe0aa08af82";
        extractor     vapourPressure;
        inchiKey      "JSRLURSZEMLAFO-UHFFFAOYSA-N";
        extract       "bin/choupo-thermoml extract-vp <article file> --inchikey JSRLURSZEMLAFO-UHFFFAOYSA-N --into <dir>";
        sha256        "f3bef20615d6b1c79456a11e9651cd4ada5cfa6b3a50ab3dd91686799b5882e3";
        identity
        {
            13Dibromobenzene { cas "108-36-1"; inchiKey "JSRLURSZEMLAFO-UHFFFAOYSA-N"; }
        }
    }
);
