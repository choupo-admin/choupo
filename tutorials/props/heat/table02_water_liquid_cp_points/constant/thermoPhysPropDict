/*  table02 -- liquid water's heat capacity, two ways in one run (DEV.md 4c
    C398, slice (c), ruled addendum A2: a heat capacity given as points).

    THE RECORD is this case's own copy of water.dat (constant/components):
    its liquidHeatCapacity block holds two laws, the catalogue's constant
    75.5 J/(mol K) (preferred, as in the catalogue) and `crc82`, a TABLE of
    eleven evaluated points, 0-100 degC, printed per MASS (J/g K) and
    converted with the record's molar mass, interpolated by monotoneCubic,
    with its source in the record's provenance block.
    THE VARIANT `crcPoints` pins the table beside the property, in
    `caloric`.  A variant that changes `caloric` is a model boundary,
    announced as one.

    A table of a heat capacity is INTEGRATED ONCE, at construction, in closed
    form (the sensible enthalpy and entropy follow from it exactly, as from a
    polynomial), and its points must contain 298.15 K, where every liquid
    enthalpy is anchored (the elements datum).  */

recordType    thermophysicalPropertySystem;
schemaVersion 2;

components ( water );

equilibrium
{
    formulation gammaPhi;
    liquid { activityModel { model ideal; } }
    vapour { fugacityModel idealGas; }
}

variants
{
    crcPoints                           // only what differs from the system above
    {
        caloric
        {
            liquidHeatCapacity
            {
                pin ( { component water;  law crc82;
                        reason "the evaluated heat capacity, which falls to a minimum near 35 degC, in place of the record's constant"; } );
            }
        }
    }
}
