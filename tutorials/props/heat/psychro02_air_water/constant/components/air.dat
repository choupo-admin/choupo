  Component: air  (CAS 132259-10-0)
  PROPOSAL TIER -- UNVERIFIED. Imported from ChemSep v8.3
  pure-component data under Artistic License 2.0.
  Critical constants are source data; Psat is an explicitly
  estimated Ambrose-Walton corresponding-states closure.
\*---------------------------------------------------------------------------*/

name        air;
//  A permanent carrier gas: Tc = 132.45 K, so at every temperature a drying
//  or psychrometric case runs at it is FAR supercritical and cannot condense.
//  The KEY, not the fact, was missing (2026-08-29): without it the GUI's
//  psychrometric carrier menu -- which offers only components declaring
//  `noncondensable true;` -- could not offer air, and the default fell to
//  nitrogen, ~3.4 % off in every humidity ratio (MW 28.014 vs 28.96).
noncondensable true;     // permanent carrier gas (psychrometric carrier)
CAS         132259-10-0;
reviewStatus interim;
MW          28.96;      // kg/kmol [origin=ChemSep v8.3]
Tc          132.45;      // K [origin=ChemSep v8.3]
Pc          37.74;      // bar; source Pa / 1e5 [origin=ChemSep v8.3]
omega       0;      // [-] [origin=ChemSep v8.3]
Tb          78.67;      // K [origin=ChemSep v8.3]
diffusionVolume  19.7;          // Fuller Sigma-v [-] [origin=ChemSep v8.3]

standardThermochemistry
{
    dHf_298   0;        // J/mol   [ChemSep v8.3, ideal gas]
    s_298     199;        // J/(mol.K)  third-law absolute
}

idealGasHeatCapacity
{
    model         polynomial;
    // Cp [J/(mol.K)] = a0 + a1 T + a2 T^2 + ...; converted EXACTLY from
    // ChemSep eqno 100 (J/kmol -> J/mol: each coefficient / 1000).
    // Grafted 2026-08-31: the original import predates the importer's
    // eqno-100 emitter, so the psychrometric carrier the GUI offers could
    // not price its own humid heat -- the chart lost its adiabatic and
    // wet-bulb families.  Cp(298.15 K) = 29.00 J/(mol.K).
    coefficients  (29.56229  -0.007164949  2.16294e-05  -1.39748e-08  2.89195e-12);
    Trange        (50  1500);
}

vaporPressure
{
    model         Antoine;
    // log10(Psat [bar]) = A - B / (T[K] + C)
    // converted EXACTLY from ChemSep eqno 10, Psat[Pa] = exp(a - b/(T+c))
    coefficients  (3.998581665  332.6174578  4.6692);
    Trange        (80  119);
}
HvapTb      5851.2;      // J/mol at Tb  [ChemSep eqno 106]

liquidHeatCapacity
{
    model         chemsepCp16;
    // Cp [J/(mol.K)] = A + exp(B/T + C + D T + E T^2)
    coefficients  (53.628  4511.1  -150.1977553  1.582  -0.0051332);
    Trange        (75  124);
}

liquidViscosity
{
    chemsepEq101
    {
        A     -72.336;
        B     813.48;
        C     12.687;
        D     -0.00033062;
        E     2;
        Tmin  59.15;
        Tmax  130;
    }
}

liquidThermalConductivity
{
    chemsepEq16
    {
        A     -0.21199;
        B     -16.311;
        C     -0.23057;
        D     -0.0076197;
        E     2.5018e-06;
        Tmin  75;
        Tmax  125;
    }
}
solubilityParameter 12750;   // Pa^0.5  [ANCHOR, ChemSep v8.3 -- checked against, never used]

