/*---------------------------------------------------------------------------*\
  thermoPhysPropDict (v2) -- the salts of a water-treatment feed, every one
  a STANDARD catalogue record (data/standards/components/) carrying its ion
  stoichiometry `dissociatesTo`, which the DSPM-DE law decomposes; every
  transport fact of an ion (charge, hydrated radius, D0) is read off its
  species record.  No phase equilibrium is computed here.
\*---------------------------------------------------------------------------*/
recordType    thermophysicalPropertySystem;
schemaVersion 2;

components       ( water NaCl NaNO3 NaF KBr Na2CO3 NH4Cl
                   calciumNitrate KNO3 MgCl2 NaBr MgSO4 );

equilibrium
{
    formulation gammaPhi;
    liquid
    {
        activityModel ideal;
        standardState pureLiquid;
    }
    vapour
    {
        fugacityModel idealGas;
    }
}
