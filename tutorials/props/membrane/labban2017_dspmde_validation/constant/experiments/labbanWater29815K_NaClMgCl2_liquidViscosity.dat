/*---------------------------------------------------------------------------*\
  The liquid viscosity this case's film is priced on (water at 298.15 K, the NanoFiltran case's values): 8.968737390077713e-4 Pa.s at 298.15 K.
  It is the SOLVENT's value, stood over the dilute feed of the ops that name
  this record (each solute below 0.1 as a mass fraction, the record's box).
  A HYPOTHESIS of the comparison, stated ONCE here: until DEV.md 4c C435 (4)
  the number was typed in the `massTransfer` block of each op, which now
  refuses it; the bench asks the package, which answers with this record.
  One record per constituent set of a feed, because the package matches a
  record to the set of components present.
\*---------------------------------------------------------------------------*/

provenance
{
    sha256       "32c2508ca60cf1f98f5dab9e2d7500e2daa3e88e4df240b670e2583c9a44f7ac";
    origin       literature;
    kind         adopted;
    basis        "adopted: the reference program's own viscosity of water at 298.15 K (a Vogel fit inside NanoFiltran), taken for the dilute feeds of this case; the value of the SOLVENT, not a measurement of the solution";
    citation     "Labban, O. et al. (2017), DSPM-DE validation case of this tutorial; the water properties are those of the NanoFiltran reference program (Geraldes & Brites Alves, J. Membr. Sci. 321 (2008) 172-182, doi:10.1016/j.memsci.2008.04.054): a Vogel fit for the viscosity, the constant 997 kg/m3";
}

property    liquidViscosity;
system      ( water NaCl MgCl2 );
solvent     water;

columns
(
    { name T;           unit K;    }
    { name mu;          unit Pa.s; }
    { name w[NaCl]; unit -; }
    { name w[MgCl2]; unit -; }
);
data        ( 298.15 8.968737390077713e-4 0 0 );

box
{
    T        ( 298.05 298.25 );
    w[NaCl]  ( 0 0.1 );
    w[MgCl2]  ( 0 0.1 );
}
