/*--------------------------------------------------------------------------*\
  LABBAN 2017 -- artificial seawater, fit rows

  LbL-C hollow-fibre NF membrane, artificial seawater mixture, observed ion rejections at 2, 4 bar -- the FIT (2 and 4 bar) rows.
  REJECTIONS and FLUX: Table 9 (accepted manuscript p. 22, journal p. 26), read on the page image,
  every value a TABLE value (rejection in % there, a fraction here; flux in LMH there, m/s here:
  1 LMH = 1/3.6e6 m/s).  The ion rows are the OBSERVED rejections 1 - c_p/c_b of each ion.
  FEED: Table 6, row Artificial Seawater: Na 11122, Ca 382, Mg 1394, SO4 2136, Cl 20300 (mg/kg).  Salts from the measured cations and sulfate (the article
  measured them by ICP-OES; chloride follows by electroneutrality), molar masses of the catalogue
  species records, density 1 kg/L assumed.  Written as salts because DSPM-DE decomposes them.
  The `fit` / `heldout` split of the three pressures is this case's: 2 and 4 bar fit, 3 bar held out.
\*--------------------------------------------------------------------------*/

property     membrane.rejection;
membrane     LbLC;

provenance
{
    source       measured;
    reviewStatus transcribedFromTable;
    citation     "O. Labban, C. Liu, T. H. Chong, J. H. Lienhard V, Fundamentals of low-pressure nanofiltration: Membrane characterization, modeling, and understanding the multi-ionic interactions in water softening, J. Membr. Sci. 521 (2017) 18-32, doi:10.1016/j.memsci.2016.08.062, Table 9 and Table 6";
    identity     "one series of the study cited above (accepted manuscript read page by page as images and the journal version for the tables); no doi identity of its own";
    licence      "facts: numbers transcribed from a published article (Elsevier copyright); the article and its figures are not in the tree";
}

T            298.15 K;     // ASSUMED: the article states no temperature (see the case README)
feed         { NaCl 439.3033 mol/m3; Na2SO4 22.2361 mol/m3; MgCl2 57.3545 mol/m3; CaCl2 9.5314 mol/m3; }

columns
(
    { name Jv;  unit m/s; }
    { name R_Na;  unit -; }
    { name R_Ca;  unit -; }
    { name R_Mg;  unit -; }
    { name R_SO4;  unit -; }
    { name R_Cl;  unit -; }
);

data
(
    3.888889e-07  -0.0140  0.5450  0.8340  0.8270  0.1100
    1.666667e-06  0.0117  0.7890  0.9360  0.8680  0.1500
);
