/*---------------------------------------------------------------------------*\
  thermoPhysPropDict (v2) -- the solutes of Labban et al. (2017).  The SALTS
  (NaCl, MgCl2, Na2SO4, CaCl2) carry their ion stoichiometry, which the
  DSPM-DE law decomposes; their ions' radii and D0 are this case's own
  species records (constant/species/, the article's Table 2: Stokes radii).
  The three UNCHARGED solutes (glycerol, glucose, sucrose) are plain
  components: their radius and D0 are declared in the operations'
  `transportParameters { neutralSolutes { ... } }` (the article's Table 1).
  No phase equilibrium is computed; the run is at 298.15 K, where the
  Stokes-Einstein correction of every D0 is exactly 1.
\*---------------------------------------------------------------------------*/
recordType    thermophysicalPropertySystem;
schemaVersion 1;

components       ( water NaCl MgCl2 Na2SO4 CaCl2 glycerol glucose sucrose );

equilibrium
{
    formulation gammaPhi;
    liquid
    {
        activityModel ideal;
        standardState pureLiquid;
    }
    vapour
    {
        fugacityModel idealGas;
    }
}

//  THE FILM'S VISCOSITY AND DENSITY (DEV.md 4c C435 (4)): water at 298.15 K, the NanoFiltran case's values.  Stated ONCE, as records of
//  kind adopted in constant/experiments/ (one per constituent set of a feed); the bench asks the
//  package, and a viscosity or density typed in an op's `massTransfer {}` is refused.
transport
{
    liquid
    {
        viscosity
        {
            measured
            {
                labbanWater29815K_glycerol_liquidViscosity { use method; reason "the film's viscosity, 8.968737390077713e-4 Pa.s at 298.15 K (water at 298.15 K, the NanoFiltran case's values): the case's own hypothesis, stated once here and asked of the package by the bench"; }
                labbanWater29815K_glucose_liquidViscosity { use method; reason "the film's viscosity, 8.968737390077713e-4 Pa.s at 298.15 K (water at 298.15 K, the NanoFiltran case's values): the case's own hypothesis, stated once here and asked of the package by the bench"; }
                labbanWater29815K_sucrose_liquidViscosity { use method; reason "the film's viscosity, 8.968737390077713e-4 Pa.s at 298.15 K (water at 298.15 K, the NanoFiltran case's values): the case's own hypothesis, stated once here and asked of the package by the bench"; }
                labbanWater29815K_NaCl_liquidViscosity { use method; reason "the film's viscosity, 8.968737390077713e-4 Pa.s at 298.15 K (water at 298.15 K, the NanoFiltran case's values): the case's own hypothesis, stated once here and asked of the package by the bench"; }
                labbanWater29815K_NaClMgCl2_liquidViscosity { use method; reason "the film's viscosity, 8.968737390077713e-4 Pa.s at 298.15 K (water at 298.15 K, the NanoFiltran case's values): the case's own hypothesis, stated once here and asked of the package by the bench"; }
                labbanWater29815K_Na2SO4NaCl_liquidViscosity { use method; reason "the film's viscosity, 8.968737390077713e-4 Pa.s at 298.15 K (water at 298.15 K, the NanoFiltran case's values): the case's own hypothesis, stated once here and asked of the package by the bench"; }
                labbanWater29815K_NaClNa2SO4MgCl2CaCl2_liquidViscosity { use method; reason "the film's viscosity, 8.968737390077713e-4 Pa.s at 298.15 K (water at 298.15 K, the NanoFiltran case's values): the case's own hypothesis, stated once here and asked of the package by the bench"; }
            }
        }
    }
}

volumetric
{
    liquid
    {
        measured
        {
            labbanWater29815K_glycerol_liquidDensity { use method; replaces { method idealMixing; } reason "the film's density, 997 kg/m3 (water at 298.15 K, the NanoFiltran case's values): the case's own hypothesis, stated once here and asked of the package by the bench"; }
            labbanWater29815K_glucose_liquidDensity { use method; replaces { method idealMixing; } reason "the film's density, 997 kg/m3 (water at 298.15 K, the NanoFiltran case's values): the case's own hypothesis, stated once here and asked of the package by the bench"; }
            labbanWater29815K_sucrose_liquidDensity { use method; replaces { method idealMixing; } reason "the film's density, 997 kg/m3 (water at 298.15 K, the NanoFiltran case's values): the case's own hypothesis, stated once here and asked of the package by the bench"; }
            labbanWater29815K_NaCl_liquidDensity { use method; replaces { method solutionLaw; record NaCl-water; } reason "the film's density, 997 kg/m3 (water at 298.15 K, the NanoFiltran case's values): the case's own hypothesis, stated once here and asked of the package by the bench"; }
            labbanWater29815K_NaClMgCl2_liquidDensity { use method; reason "the film's density, 997 kg/m3 (water at 298.15 K, the NanoFiltran case's values): the case's own hypothesis, stated once here and asked of the package by the bench"; }
            labbanWater29815K_Na2SO4NaCl_liquidDensity { use method; reason "the film's density, 997 kg/m3 (water at 298.15 K, the NanoFiltran case's values): the case's own hypothesis, stated once here and asked of the package by the bench"; }
            labbanWater29815K_NaClNa2SO4MgCl2CaCl2_liquidDensity { use method; reason "the film's density, 997 kg/m3 (water at 298.15 K, the NanoFiltran case's values): the case's own hypothesis, stated once here and asked of the package by the bench"; }
        }
    }
}
