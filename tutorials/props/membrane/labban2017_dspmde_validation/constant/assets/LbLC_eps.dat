poreModel
{
    poreRadius            4.94973e-10;   // m, held at LbLC_pore's value
    porosityOverThickness 331196;   // 1/m, held at LbLC_pore's value
    chargeDensity         0;   // mol/m3, signed, held at LbLC_pore's value
    poreDielectric        53.4675;   // -, FITTED
}

fit
{
    origin            fitted;
    method            "fitParameters, residual kind membrane, model DSPM-DE: Levenberg-Marquardt on observed rejections, weighting absolute";
    fittedInCase      labban2017_dspmde_validation;
    operation         fit_eps_NaCl_pH7;
    propsDict         "system/propsDict";
    fitBlockSha256    "19302e2b2a0503ba171a37b954fcd4d464bee7f528bacfcb03ad70a201f309ae";
    baseRecord        LbLC_pore;
    baseRecordSha256  "2e85f1f0cf82ec769d4d17e262cc08d8893a8ef8eef0303ead4b4118216f510f";
    recordSha256      "22e206c495dc299118c1507ce4c73af1c22c90bad443401407db6c9f4264ef61";
    datasets
    (
        { role fit; dataset "constant/experimental/labban2017_NaCl_pH7.dat"; sha256 "220859cb25e7f218cda2a1d94d1e8000e79d8365be191c2f89c0d377fb35c3ce"; }
    );
    verdict           validationRefused;
    acceptance        none;   // no band was declared before the fit
    heldOut           { measurements 0; AADPoints none; }
    inSample          { measurements 3; AADPoints 1.80337; chi2Reduced 0.000676648; }
    identifiability   { conditionNumber 1; maxAbsCorrelation 0; }
    values            // the 95 % half-width is t(dof) x the standard error
    {
        poreModel
        {
            poreDielectric  { origin fitted; stderr 2.0423; ci95 8.78802; unit "-"; }
        }
    }
    correlation
