/*--------------------------------*- Choupo -*-----------------------*\
  Membrane: LbLC_pore -- WRITTEN BY A PROPERTIES-MODE FIT, not by hand.

  Operation 'fit_pore_uncharged' of case 'labban2017_dspmde_validation' (fitParameters,
  residual kind membrane, model DSPM-DE) fitted the values marked FITTED
  below to the datasets named in fit {}; every other value is base record
  LbLC's.  Fitted values are rounded to 6 significant figures,
  and the verdict was taken at the rounded values.

  A Process-mode run checks the fingerprints in fit {} before it uses this
  record and REFUSES it, naming what changed, when a dataset, the fit block
  or the base record has moved since: re-run the case in Properties mode
  (runCase <case> props) to re-fit it.  An edit here is overwritten by the
  next Properties-mode run.
\*---------------------------------------------------------------------------*/

name           LbLC_pore;
kind           NF;
manufacturer   "none (a laboratory membrane: Labban et al. 2017, Section 3.2)";

provenance     fittedToCase;
fittedAgainst  labban2017_dspmde_validation;

A_w                   1e-10;   // m/(s Pa), raw SI, held at LbLC's value

poreModel
{
    poreRadius            4.94973e-10;   // m, FITTED
    porosityOverThickness 331196;   // 1/m, FITTED
    chargeDensity         0;   // mol/m3, signed, held at LbLC's value
    poreDielectric        80.4;   // -, held at LbLC's value
}

fit
{
    origin            fitted;
    method            "fitParameters, residual kind membrane, model DSPM-DE: Levenberg-Marquardt on observed rejections, weighting absolute";
    fittedInCase      labban2017_dspmde_validation;
    operation         fit_pore_uncharged;
    propsDict         "system/propsDict";
    fitBlockSha256    "53660ab5f9c11d2f71bf6324cb0bbddddfcb62929906a2847abe92ec692bf515";
    baseRecord        LbLC;
    baseRecordSha256  "32dc4506a4a533818bd7cda7e0bd40127231ccabe829fe143ac3aa14ffcdcaf1";
    recordSha256      "c9cf6ce5692d66ed36c4fd822b5f130697092e540f77261a5745dc6ff96c8d91";
    datasets
    (
        { role fit; dataset "constant/experimental/labban2017_glycerol.dat"; sha256 "49102a6102df0f3ca3e5915c5b1e25f4497433b16862e9621d056046d70d5b69"; }
        { role fit; dataset "constant/experimental/labban2017_glucose.dat"; sha256 "5c720e653000132dafb22dc927f0f586798cb1f8fb67015abb361504ac1c0c91"; }
        { role fit; dataset "constant/experimental/labban2017_sucrose.dat"; sha256 "44a013c5da69cffa0a98d44b405a967417e8a767a444716faed05996ccc5a50d"; }
    );
    verdict           validationRefused;
    acceptance        none;   // no band was declared before the fit
    heldOut           { measurements 0; AADPoints none; }
    inSample          { measurements 12; AADPoints 4.06512; chi2Reduced 0.00255909; }
    identifiability   { conditionNumber 24.2659; maxAbsCorrelation 0.879596; }
    values            // the 95 % half-width is t(dof) x the standard error
    {
        poreModel
        {
            poreRadius  { origin fitted; stderr 1.30774e-11; ci95 2.91364e-11; unit "m"; }
            porosityOverThickness  { origin fitted; stderr 100421; ci95 223738; unit "1/m"; }
        }
    }
    correlation
    (
        { a poreModel.poreRadius; b poreModel.porosityOverThickness; r -0.879596; }
    );
}
