    //  A -- r_p and A_k/dx from the three UNCHARGED solutes (Table 3 + Fig. 8).
    //  Free: the pore radius and the porosity over thickness (1/Delta x_e).
    {
        name      fit_pore_uncharged;
        type      fitParameters;
        parameters
        (
            { path poreModel.poreRadius;             initial 6.0e-10; min 2.0e-10; max 3.0e-9; }
            { path poreModel.porosityOverThickness;  initial 5.0e5;   min 1.0e4;   max 1.0e8; }
        );
        evidence
        (
            { dataset "constant/experimental/labban2017_glycerol.dat"; role fit; }
            { dataset "constant/experimental/labban2017_glucose.dat";  role fit; }
            { dataset "constant/experimental/labban2017_sucrose.dat";  role fit; }
        );
        residual
        {
            kind        membrane;
            model       DSPM-DE;
            membrane    LbLC;
            rejection   observed;
            weighting   absolute;
            transportParameters
            {
                poreSolver { method finiteDifference; nodes 101; wallClosure porePermeate; }
                hindrance  DechadilokDeen2006;
                bulkDielectric 80.4;           // p. 17: eps_b = 80.4
                neutralSolutes
            {
                glycerol { radius 2.60e-10; D0 9.50e-10; }   // Table 1: r_i 0.260 nm, D_inf 0.950e-9
                glucose  { radius 3.65e-10; D0 6.90e-10; }   // Table 1: 0.365 nm, 0.690e-9
                sucrose  { radius 4.71e-10; D0 5.20e-10; }   // Table 1: 0.471 nm, 0.520e-9
            }
            }
            massTransfer
            {
                model      StirredCell;        // = the article's Eq. 13 for a hollow fibre, see the header
                a 0.26194;  b 0.33;  c 0.33;   // a = 1.62 (d_i/L)^0.33, d_i 1.0 mm, L 25 cm
                radius     1.0e-3;             // m: d_i, the fibre's inside diameter
                omega      300.0;              // rad/s: u/d_i, u = 0.3 m/s
            }
            polarisation { suctionCorrection GeraldesAfonso2006; ionCoupling electroneutral; }
        }
        options
        {
            maxIter     60;
            tolerance   1.0e-10;
            fdStep      1.0e-4;
            lambda0     1.0e-2;
        }
        output { record "constant/assets/LbLC_pore.dat"; name LbLC_pore; }
    }
