/*---------------------------------------------------------------------------*\
  The liquid density this case's film is priced on (the Amicon 8200 cell of the source, Table 1): 1000 kg/m3 at 298.15 K.
  A HYPOTHESIS of the comparison, not a measurement of the solution: the
  box lets it stand over the dilute feed of the ops that name this record
  (each solute below 0.1 as a mass fraction).  Until DEV.md 4c C435 (4) the
  number was typed in the `massTransfer` block of each op, which now refuses
  it; the bench asks the package, which answers with this record.
\*---------------------------------------------------------------------------*/
provenance
{
    sha256       "72410fc1b54b59129cdc9a89d127ae93e576eb8d6993299c71202b42ed69932b";
    origin       literature;
    kind         adopted;
    basis        "adopted: the source's stated density, 1000 kg/m3, taken for the dilute feeds of its Table 1; a hypothesis of the source, not a measurement of the solution";
    citation     "Geraldes & Afonso, J. Membr. Sci. 300 (2007) 20-27, Table 1 footnote: the Amicon 8200 cell, nu = 8.97e-7 m2/s (mu 8.97e-4 Pa.s, rho 1000 kg/m3)";
}
system      ( water dye Cl );
property    liquidDensity;
solvent     water;
columns     ( { name T; unit K; } { name P; unit kPa; } { name w[dye]; unit -; } { name w[Cl]; unit -; } { name rho; unit kg/m3; } );
data        ( 298.15 101.325 0 0 1000 );
uncertainty 0.5;           // kg/m3: the rounding of the constant
box         { T ( 298.05 298.25 ); P ( 50e3 1500e3 ); w[dye] ( 0 0.1 ); w[Cl] ( 0 0.1 ); }
