/*---------------------------------------------------------------------------*\
  The liquid viscosity this case's film is priced on (the Amicon 8200 cell of the source, Table 1): 8.97e-4 Pa.s at 298.15 K.
  It is the SOLVENT's value, stood over the dilute feed of the ops that name
  this record (each solute below 0.1 as a mass fraction, the record's box).
  A HYPOTHESIS of the comparison, stated ONCE here: until DEV.md 4c C435 (4)
  the number was typed in the `massTransfer` block of each op, which now
  refuses it; the bench asks the package, which answers with this record.
  One record per constituent set of a feed, because the package matches a
  record to the set of components present.
\*---------------------------------------------------------------------------*/

provenance
{
    sha256       "9e57d7c3fe5dddd2558f28f985c8ad81446fcfbc16be60af3d3d86f0030309aa";
    origin       literature;
    kind         adopted;
    basis        "adopted: the source's stated water viscosity (8.97e-4 Pa.s) taken for the dilute feeds of its Table 1; the value of the SOLVENT, not a measurement of the solution";
    citation     "Geraldes & Afonso, J. Membr. Sci. 300 (2007) 20-27, Table 1 footnote: the Amicon 8200 cell, nu = 8.97e-7 m2/s (mu 8.97e-4 Pa.s, rho 1000 kg/m3)";
}

property    liquidViscosity;
system      ( water dye Cl );
solvent     water;

columns
(
    { name T;           unit K;    }
    { name mu;          unit Pa.s; }
    { name w[dye]; unit -; }
    { name w[Cl]; unit -; }
);
data        ( 298.15 8.97e-4 0 0 );

box
{
    T        ( 298.05 298.25 );
    w[dye]  ( 0 0.1 );
    w[Cl]  ( 0 0.1 );
}
