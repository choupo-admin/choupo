/*---------------------------------------------------------------------------*\
  thermoPhysPropDict (v2) -- an aqueous electrolyte solution declared ion by
  ion (Na+, Cl-, dye3-), each ion a component with its aqueous bridge, so
  the polarisationIndex bench reads every charge and diffusivity off the
  species records.  No phase equilibrium is computed here.
\*---------------------------------------------------------------------------*/
recordType    thermophysicalPropertySystem;
schemaVersion 1;

components       ( water Na Cl dye );

equilibrium
{
    formulation gammaPhi;
    liquid
    {
        activityModel ideal;
        standardState pureLiquid;
    }
    aqueous
    {
        activityModel { model davies; }
    }
    vapour
    {
        fugacityModel idealGas;
    }
}

//  THE FILM'S VISCOSITY AND DENSITY (DEV.md 4c C435 (4)): the Amicon 8200 cell of the source, Table 1.  Stated ONCE, as records of
//  kind adopted in constant/experiments/ (one per constituent set of a feed); the bench asks the
//  package, and a viscosity or density typed in an op's `massTransfer {}` is refused.
transport
{
    liquid
    {
        viscosity
        {
            measured
            {
                geraldesAfonsoTable1_dyeCl_liquidViscosity { use method; reason "the film's viscosity, 8.97e-4 Pa.s at 298.15 K (the Amicon 8200 cell of the source, Table 1): the case's own hypothesis, stated once here and asked of the package by the bench"; }
            }
        }
    }
}

volumetric
{
    liquid
    {
        measured
        {
            geraldesAfonsoTable1_dyeCl_liquidDensity { use method; reason "the film's density, 1000 kg/m3 (the Amicon 8200 cell of the source, Table 1): the case's own hypothesis, stated once here and asked of the package by the bench"; }
        }
    }
}
