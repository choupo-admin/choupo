/*---------------------------------------------------------------------------*\
  thermoPhysPropDict (v2) -- an aqueous electrolyte solution declared ion by
  ion (Na+, Cl-, dye3-), each ion a component with its aqueous bridge, so
  the polarisationIndex bench reads every charge and diffusivity off the
  species records.  No phase equilibrium is computed here.
\*---------------------------------------------------------------------------*/
recordType    thermophysicalPropertySystem;
schemaVersion 2;

components       ( water Na Cl dye );

equilibrium
{
    formulation gammaPhi;
    liquid
    {
        activityModel ideal;
        standardState pureLiquid;
    }
    aqueous
    {
        activityModel { model davies; }
    }
    vapour
    {
        fugacityModel idealGas;
    }
}
