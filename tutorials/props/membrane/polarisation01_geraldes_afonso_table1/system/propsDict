/*---------------------------------------------------------------------------*\
  polarisation01 -- THE CONCENTRATION POLARISATION OF A MULTI-IONIC SOLUTION,
  computed the way Geraldes & Afonso did it (J. Membr. Sci. 300 (2007) 20-27,
  doi:10.1016/j.memsci.2007.04.025) for the case study of their Section 2.2:
  nanofiltration of Na+ / Cl- / dye3- solutions in a stirred cell
  (experimental data of Bowen & Mohammad, AIChE J. 44 (1998) 1799).

  THE QUESTION.  How much does each ion pile up at the membrane wall when
  three ions of different diffusivities and charges are rejected to
  different degrees?  The classical film model cannot answer it: it needs
  ONE effective diffusivity for the solution, and a mixture of ions has
  none.  The extended Nernst-Planck approach answers it only after choosing
  a film thickness, which nobody measures.

  THE MODEL.  At the feed-solution/membrane interface, for every ion, the
  flux J_v C_p equals back-diffusion plus convection plus MIGRATION in the
  electrical potential gradient xi that the ions' different mobilities set
  up (Eqs. 2-7); electroneutrality at the interface (Eq. 8) fixes xi.  The
  mass-transfer coefficient of each ion comes from the cell's conventional
  correlation on the ion's OWN diffusivity, Sh_i = 0.23 Re^0.567 Sc_i^0.33
  (Bowen et al. 1997), corrected for the suction effect of the permeation
  by Xi_i = phi_i + (1 + 0.26 phi_i^1.4)^-1.7 (Geraldes & Afonso 2006).
  Four algebraic equations per operating point (Eqs. 25-28), NO film
  thickness, NO new parameter.

  WHAT TO READ IN THE OUTPUT.  The polarisation index Gamma_i = (C_m -
  C_b)/C_b per ion and per row -- the open symbols of the paper's Fig. 7.
  The dye (slowest, most rejected) polarises most; Na+ is dragged along by
  the field; Cl-, less rejected than the dye and pulled by the same field,
  shows a NEGATIVE Gamma at the low Cl- feeds -- its wall concentration is
  BELOW the bulk, which the film model applied ion by ion cannot produce.
  The residual sum z_i C_m,i / sum |z_i| C_m,i printed under each row is
  the electroneutrality the field enforces.

  WHAT IS AND IS NOT MEASURED.  C_b, C_p and J_v are the table's; Na+ is
  derived from electroneutrality as the table's own footnote says.  The
  Gamma are PREDICTIONS of the model from those inputs and the ions' D --
  nothing is fitted.  The paper compares them with an extended
  Nernst-Planck integration in the dye's film (its Fig. 7, filled
  symbols), which this case does not reproduce.

  The gate check_polarisation_coupling recomputes the same four equations
  in Python from this case's own data file and holds every Gamma to 1e-8.
\*---------------------------------------------------------------------------*/

operations
(
    {
        name     table1;
        type     polarisationIndex;
        T        298.15 K;                    // 25 C

        //  The Amicon 8200 stirred cell of the source (Table 1 footnote):
        //  r = 2.4 cm, omega = 41.9 rad/s, nu = 8.97e-7 m2/s (Re = 26907).
        //  nu enters as mu / rho; both are the case's own numbers.
        massTransfer
        {
            model      StirredCell;           // Sh_i = a (omega r^2/nu)^b Sc_i^c
            omega      41.9;                  // rad/s
            radius     2.4 cm;
            viscosity  8.97e-4;               // Pa.s   -> nu = 8.97e-7 m2/s
            density    1000;                  // kg/m3
            // a 0.23;  b 0.567;  c 0.33;     // the defaults (Bowen et al. 1997)
        }

        //  The film's policy: the 2006 suction correction, and the ions
        //  coupled by the interface potential (Eqs. 2-8 of the 2007 paper).
        polarisation
        {
            suctionCorrection  GeraldesAfonso2006;
            ionCoupling        electroneutral;
        }

        ions     ( dye Cl Na );               // components; z and D from their species records
        closeBy  Na;                          // Na+ bulk and permeate from electroneutrality, as the table did
        dataset  "constant/experimental/bowen1998_table1";
    }
);

/*---------------------------------------------------------------------------*\
  THE CASE STUDY OF GERALDES & AFONSO (2007) AS FIGURES (DEV.md 4c C147,
  C149).  The op `table1` already publishes its DEFAULT views with nothing
  declared here: `gamma` (Gamma_i = (C_m - C_b)/C_b of every ion, row by row
  of the dataset), `rejection` (the rejection the cell MEASURES, 1 - C_p/C_b,
  against the one the membrane makes, 1 - C_p/C_m) and `rows` (Table 1 row
  by row with the model's wall).  The `views` below split the same rows by
  DYE LEVEL and draw them against the feed chloride, which is how the
  paper's Fig. 7 reads them (its open symbols).

  Every number is the op's: its published `rows` table (one row per
  measured operating point; src/propertyOps/PolarisationIndex.H).  The
  engine writes postProcessing/table1/<view>.csv (+ .json) every run and the
  GUI's review screen draws them.  The grammar:
  docs/design/a-post-processing-dictionary.md.

  WHAT IS NOT HERE.  The paper's own Gamma values (Fig. 7, both its open and
  filled symbols) are not in the tree -- the 2007 paper was not available to
  this slice, and a figure nobody digitised cannot be quoted -- so every
  Gamma below is Choupo's prediction, set against the MEASURED inputs of
  Table 1, never against the paper's model.  check_polarisation_coupling
  recomputes every Gamma independently in Python (1e-8).
\*---------------------------------------------------------------------------*/

views
(
    {
        name    gamma_dye4;
        type    series;
        title   "Polarisation index of every ion against feed chloride, 4 mol/m3 of dye (Table 1 rows 1-5; the paper's Fig. 7, open symbols)";
        xAxis   { label "feed chloride, C_b,Cl"; unit "mol/m3"; scale linear; }
        yAxis   { label "polarisation index Gamma_i = (C_m - C_b)/C_b"; unit "-"; scale linear; }
        series
        (
            { name dye; label "dye3- Choupo"; op table1; table rows; select { C_b_dye_molm3 4; } x C_b_Cl_molm3; y Gamma_dye; style linesMarkers; group dye; }
            { name Na;  label "Na+ Choupo";   op table1; table rows; select { C_b_dye_molm3 4; } x C_b_Cl_molm3; y Gamma_Na;  style linesMarkers; group Na; }
            { name Cl;  label "Cl- Choupo";   op table1; table rows; select { C_b_dye_molm3 4; } x C_b_Cl_molm3; y Gamma_Cl;  style linesMarkers; group Cl; }
        );
    }
    {
        name    gamma_dye37;
        type    series;
        title   "Polarisation index of every ion against feed chloride, 37 mol/m3 of dye (Table 1 rows 6-10; the paper's Fig. 7, open symbols)";
        xAxis   { label "feed chloride, C_b,Cl"; unit "mol/m3"; scale linear; }
        yAxis   { label "polarisation index Gamma_i = (C_m - C_b)/C_b"; unit "-"; scale linear; }
        series
        (
            { name dye; label "dye3- Choupo"; op table1; table rows; select { C_b_dye_molm3 37; } x C_b_Cl_molm3; y Gamma_dye; style linesMarkers; group dye; }
            { name Na;  label "Na+ Choupo";   op table1; table rows; select { C_b_dye_molm3 37; } x C_b_Cl_molm3; y Gamma_Na;  style linesMarkers; group Na; }
            { name Cl;  label "Cl- Choupo";   op table1; table rows; select { C_b_dye_molm3 37; } x C_b_Cl_molm3; y Gamma_Cl;  style linesMarkers; group Cl; }
        );
    }
    {
        name    rejection_dye4;
        type    series;
        title   "What the cell measures and what the membrane does, 4 mol/m3 of dye: observed rejection 1 - C_p/C_b (from Table 1) against real rejection 1 - C_p/C_m (Choupo's wall)";
        xAxis   { label "feed chloride, C_b,Cl"; unit "mol/m3"; scale linear; }
        yAxis   { label "rejection"; unit "-"; scale linear; }
        series
        (
            { name obsNa;  label "Na+ observed (Table 1)";  op table1; table rows; select { C_b_dye_molm3 4; } x C_b_Cl_molm3; y Robs_Na;  style markers; group Na; }
            { name realNa; label "Na+ real (Choupo wall)";  op table1; table rows; select { C_b_dye_molm3 4; } x C_b_Cl_molm3; y Rreal_Na; style lines;   group Na; }
            { name obsCl;  label "Cl- observed (Table 1)";  op table1; table rows; select { C_b_dye_molm3 4; } x C_b_Cl_molm3; y Robs_Cl;  style markers; group Cl; }
            { name realCl; label "Cl- real (Choupo wall)";  op table1; table rows; select { C_b_dye_molm3 4; } x C_b_Cl_molm3; y Rreal_Cl; style lines;   group Cl; }
        );
    }
    {
        name    rejection_dye37;
        type    series;
        title   "What the cell measures and what the membrane does, 37 mol/m3 of dye: observed rejection 1 - C_p/C_b (from Table 1) against real rejection 1 - C_p/C_m (Choupo's wall)";
        xAxis   { label "feed chloride, C_b,Cl"; unit "mol/m3"; scale linear; }
        yAxis   { label "rejection"; unit "-"; scale linear; }
        series
        (
            { name obsNa;  label "Na+ observed (Table 1)";  op table1; table rows; select { C_b_dye_molm3 37; } x C_b_Cl_molm3; y Robs_Na;  style markers; group Na; }
            { name realNa; label "Na+ real (Choupo wall)";  op table1; table rows; select { C_b_dye_molm3 37; } x C_b_Cl_molm3; y Rreal_Na; style lines;   group Na; }
            { name obsCl;  label "Cl- observed (Table 1)";  op table1; table rows; select { C_b_dye_molm3 37; } x C_b_Cl_molm3; y Robs_Cl;  style markers; group Cl; }
            { name realCl; label "Cl- real (Choupo wall)";  op table1; table rows; select { C_b_dye_molm3 37; } x C_b_Cl_molm3; y Rreal_Cl; style lines;   group Cl; }
        );
    }
);
