operations
(
    //  ---- PART A: code to code with NanoFiltran (its matrix) ----------------
    {
        name      example_ideal;
        type      poreTransport;
        T         298.15 K;
        membrane  NanoFiltranExample;
        transport DSPM-DE;
        transportParameters
        {
            poreSolver { method finiteDifference; nodes 801; wallClosure porePermeate; }
            hindrance  DechadilokDeen2006;
            activity   ideal;
            bulkDielectric 80;                 // NanoFiltran's EWATER
        }
        feedMolPerM3 { NaCl 10; MgCl2 20; }    // Na+ 10, Mg2+ 20, Cl- 50
        J_v       ( 1e-6 5e-6 1e-5 2e-5 5e-5 );
        k_film    10;                          // NanoFiltran's "no polarisation"
        polarisation { suctionCorrection GeraldesAfonso2006; ionCoupling electroneutral; }
    }
    {
        name      example_noBorn;
        type      poreTransport;
        T         298.15 K;
        membrane  NanoFiltranExampleNoBorn;    // eps_p 80 = eps_b
        transport DSPM-DE;
        transportParameters
        {
            poreSolver { method finiteDifference; nodes 801; wallClosure porePermeate; }
            hindrance  DechadilokDeen2006;
            activity   ideal;
            bulkDielectric 80;
        }
        feedMolPerM3 { NaCl 10; MgCl2 20; }
        J_v       ( 5e-5 );
        k_film    10;
        polarisation { suctionCorrection GeraldesAfonso2006; ionCoupling electroneutral; }
    }
    {
        name      example_davies;
        type      poreTransport;
        T         298.15 K;
        membrane  NanoFiltranExampleNoBorn;    // Born off: see the Davies paragraph
        transport DSPM-DE;
        transportParameters
        {
            poreSolver { method finiteDifference; nodes 801; wallClosure porePermeate; }
            hindrance  DechadilokDeen2006;
            activity   bulkOverPoreDavies;
            bulkDielectric 80;
        }
        feedMolPerM3 { NaCl 10; MgCl2 20; }
        J_v       ( 5e-5 );
        k_film    10;
        polarisation { suctionCorrection GeraldesAfonso2006; ionCoupling electroneutral; }
    }
    {
        name      NaCl_ideal;
        type      poreTransport;
        T         298.15 K;
        membrane  NanoFiltranExample;
        transport DSPM-DE;
        transportParameters
        {
            poreSolver { method finiteDifference; nodes 801; wallClosure porePermeate; }
            hindrance  DechadilokDeen2006;
            activity   ideal;
            bulkDielectric 80;
        }
        feedMolPerM3 { NaCl 10; }
        J_v       ( 1e-5 5e-5 );
        k_film    10;
        polarisation { suctionCorrection GeraldesAfonso2006; ionCoupling electroneutral; }
    }
    {
        name      Na2SO4_ideal;
        type      poreTransport;
        T         298.15 K;
        membrane  NanoFiltranExample;
        transport DSPM-DE;
        transportParameters
        {
            poreSolver { method finiteDifference; nodes 801; wallClosure porePermeate; }
            hindrance  DechadilokDeen2006;
            activity   ideal;
            bulkDielectric 80;
        }
        feedMolPerM3 { Na2SO4 10; }
        J_v       ( 1e-5 5e-5 );
        k_film    10;
        polarisation { suctionCorrection GeraldesAfonso2006; ionCoupling electroneutral; }
    }
    {
        name      mixed_polarised;
        type      poreTransport;
        T         298.15 K;
        membrane  NanoFiltranExample;
        transport DSPM-DE;
        transportParameters
