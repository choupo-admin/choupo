//  THE THREE STUDIES, in the paper's order: the question each asks and what
//  KIND of check it is (`purpose`, a closed list -- a purpose is what a study
//  sets out to do, never what the run concluded).  The GUI navigates by
//  them; the engine refuses a study naming an operation not declared below.
studies
(
    {
        name     A;
        title    "A -- Code to code: Choupo against NanoFiltran on one model and the same inputs";
        purpose  codeToCodeVerification;
        summary  "The DSPM-DE pore solved by two independent programs on NanoFiltran's own matrix.  It says the equations are solved right; no number here is a measurement, and the membrane is NanoFiltran's worked example, which describes no real membrane.";
        ops      ( example_ideal example_noBorn example_davies NaCl_ideal Na2SO4_ideal mixed_polarised );
    }
    {
        name     B;
        title    "B -- Experiment: Bowen & Mohammad's measured CA30 rejections (the paper's Fig. 3)";
        purpose  calibratedComparison;
        summary  "A comparison with MEASUREMENTS whose inputs Bowen & Mohammad fitted to these very data (pore radius and thickness, the charge and the flux as functions of the feed).  Agreement says the pore model, carried by those inputs, reproduces them; it is not a prediction.  Nothing was fitted by this run.";
        ops      ( dye4_p1 dye4_p2 dye4_p3 dye4_p4 dye4_p5 dye37_p1 dye37_p2 dye37_p3 dye37_p4 dye37_p5 );
    }
    {
        name     C;
        title    "C -- The stiff case of Table 2 and Fig. 4, and its grid study";
        purpose  numericalStudy;
        summary  "The paper's very stiff pore on six node counts, and Choupo's answer against Table 2 accounted for one change at a time.  Nothing here is a measurement; the anchors are NanoFiltran with its Davies and Born constants and its diffusivity input corrected.";
        ops      ( N10 N20 N50 N100 N200 N350 );
    }
);

operations
(
    //  ---- PART A: code to code with NanoFiltran (its matrix) ----------------
    {
        name      example_ideal;
        type      poreTransport;
        T         298.15 K;
        membrane  NanoFiltranExample;
        transport DSPM-DE;
        transportParameters
        {
            poreSolver { method finiteDifference; nodes 801; wallClosure porePermeate; }
            hindrance  DechadilokDeen2006;
            activity   ideal;
            bulkDielectric 80;                 // NanoFiltran's EWATER
        }
        feedMolPerM3 { NaCl 10; MgCl2 20; }    // Na+ 10, Mg2+ 20, Cl- 50
        J_v       ( 1e-6 5e-6 1e-5 2e-5 5e-5 );
        k_film    10;                          // NanoFiltran's "no polarisation"
        polarisation { suctionCorrection GeraldesAfonso2006; ionCoupling electroneutral; }
    }
    {
        name      example_noBorn;
        type      poreTransport;
        T         298.15 K;
        membrane  NanoFiltranExampleNoBorn;    // eps_p 80 = eps_b
        transport DSPM-DE;
        transportParameters
        {
            poreSolver { method finiteDifference; nodes 801; wallClosure porePermeate; }
            hindrance  DechadilokDeen2006;
            activity   ideal;
            bulkDielectric 80;
        }
        feedMolPerM3 { NaCl 10; MgCl2 20; }
        J_v       ( 5e-5 );
        k_film    10;
        polarisation { suctionCorrection GeraldesAfonso2006; ionCoupling electroneutral; }
    }
    {
        name      example_davies;
        type      poreTransport;
        T         298.15 K;
        membrane  NanoFiltranExampleNoBorn;    // Born off: see the Davies paragraph
        transport DSPM-DE;
        transportParameters
        {
            poreSolver { method finiteDifference; nodes 801; wallClosure porePermeate; }
            hindrance  DechadilokDeen2006;
            activity   bulkOverPoreDavies;
