/*---------------------------------------------------------------------------*\
  thermoPhysPropDict (v2) -- the salts of the NanoFiltran comparison,
  declared as components, each with its ion stoichiometry `dissociatesTo`
  (which the DSPM-DE law decomposes); every transport fact of an ion
  (charge, Stokes radius, D0) is read off its species record.  No phase
  equilibrium is computed here.
\*---------------------------------------------------------------------------*/
recordType    thermophysicalPropertySystem;
schemaVersion 2;

components       ( water NaCl MgCl2 Na2SO4 Na3Dye );

equilibrium
{
    formulation gammaPhi;
    liquid
    {
        activityModel ideal;
        standardState pureLiquid;
    }
    vapour
    {
        fugacityModel idealGas;
    }
}
