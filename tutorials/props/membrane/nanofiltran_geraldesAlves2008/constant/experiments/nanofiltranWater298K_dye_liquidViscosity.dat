/*---------------------------------------------------------------------------*\
  The liquid viscosity the NanoFiltran comparison stands over in Part B (Bowen & Mohammad's CA30, 298 K): the
  reference program's own number, 8.999621107104e-04 Pa.s at 298 K (its Vogel fit
  for WATER at that temperature).  It is the SOLVENT's viscosity, stood over
  the dilute feeds of the ops that name this record (each solute below 1 wt %:
  the largest feed here is about 0.15 wt %% NaCl and the dye); the reference program prices Sc and Re on it
  and so must this case, because the point of the comparison is the program's
  hypothesis, not the package's water.  Until DEV.md 4c C435 the number was
  typed in the `massTransfer` block of each of the ops; the property operation
  now refuses a viscosity typed there, and asks the package, which answers
  with this record.  The two NanoFiltran temperatures (298 K for the paper's
  Part B, 298.15 K for the mixed polarised op) are two records with disjoint
  boxes, each a single row.
\*---------------------------------------------------------------------------*/

provenance
{
    sha256       "1b78fa76e3e2a1f247327cdd4d0620e8c4416245986c7c03ad73a64587a2eb94";
    origin       literature;
    kind         adopted;
    basis        "adopted: the reference program's own viscosity of water at 298 K (a Vogel fit inside NanoFiltran), taken for the dilute feeds of this case; the value of the SOLVENT, not a measurement of the solution";
    citation     "Geraldes, V.; Brites Alves, A. M. (2008). Computer program for simulation of mass transport in nanofiltration membranes. J. Membr. Sci. 321, 172-182. doi:10.1016/j.memsci.2008.04.054 -- NanoFiltran, the program's own water properties (its viscosity law is a Vogel fit; its density is the constant 997 kg/m3)";
}

property    liquidViscosity;
system      ( water NaCl Na3Dye );
solvent     water;

columns
(
    { name T;           unit K;    }
    { name mu;          unit Pa.s; }
    { name w[NaCl]; unit -; }
    { name w[Na3Dye]; unit -; }
);
data        ( 298 8.999621107104e-04 0 0 );

box
{
    T        ( 297.9 298.1 );
    w[NaCl]  ( 0 0.01 );
    w[Na3Dye]  ( 0 0.05 );
}
