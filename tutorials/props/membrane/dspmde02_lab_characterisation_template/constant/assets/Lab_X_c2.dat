/*--------------------------------*- Choupo -*-----------------------*\
  Membrane: Lab_X_c2 -- WRITTEN BY A PROPERTIES-MODE FIT, not by hand.

  Operation 'fit_X_c2' of case 'dspmde02_lab_characterisation_template' (fitParameters,
  residual kind membrane, model DSPM-DE) fitted the values marked FITTED
  below to the datasets named in fit {}; every other value is base record
  Lab_pore's.  Fitted values are rounded to 6 significant figures,
  and the verdict was taken at the rounded values.

  A Process-mode run checks the fingerprints in fit {} before it uses this
  record and REFUSES it, naming what changed, when a dataset, the fit block
  or the base record has moved since: re-run the case in Properties mode
  (runCase <case> props) to re-fit it.  An edit here is overwritten by the
  next Properties-mode run.
\*---------------------------------------------------------------------------*/

name           Lab_X_c2;
kind           NF;
manufacturer   "none (a laboratory membrane)";

provenance     fittedToCase;
fittedAgainst  dspmde02_lab_characterisation_template;

A_w                   1e-10;   // m/(s Pa), raw SI, held at Lab_pore's value

poreModel
{
    poreRadius            4.94973e-10;   // m, held at Lab_pore's value
    porosityOverThickness 331196;   // 1/m, held at Lab_pore's value
    chargeDensity         -4.48346;   // mol/m3, signed, FITTED
    poreDielectric        53.47;   // -, held at Lab_pore's value
}

fit
{
    origin            fitted;
    method            "fitParameters, residual kind membrane, model DSPM-DE: Levenberg-Marquardt on observed rejections, weighting absolute";
    fittedInCase      dspmde02_lab_characterisation_template;
    operation         fit_X_c2;
    propsDict         "system/propsDict";
    fitBlockSha256    "d59752b9d0ae0fc2c7ec1ae449ed63ae3d9d8aabe0a448b8172a79b29682337c";
    baseRecord        Lab_pore;
    baseRecordSha256  "17a312330a316fbe48bc04ed25c11f8197a04b9a35899ad27723022685ecc0c6";
    recordSha256      "1ba3868e3b70f06953fcfc38e193a7c98ee6e9c1578fa08571f90e68371afd74";
    datasets
    (
        { role fit; dataset "constant/experimental/lab_salts.dat"; sha256 "19dda1092ca0c741bc2a6318ab4c26624070fccc2ac73e716a8d0359e347d6ea"; }
        { role validation; dataset "constant/experimental/lab_salts.dat"; sha256 "19dda1092ca0c741bc2a6318ab4c26624070fccc2ac73e716a8d0359e347d6ea"; }
    );
    verdict           validated;
    acceptance        { maxAADPoints 5; origin "the template's default, declared before the fit: the held-out point must be predicted to within 5 points of rejection averaged over its ions.  A laboratory states its own band, and why, BEFORE it runs the fit."; }
    heldOut           { measurements 3; AADPoints 3.35608; }
    inSample          { measurements 6; AADPoints 3.74441; chi2Reduced 0.0023771; }
    identifiability   { conditionNumber 1; maxAbsCorrelation 0; }
    values            // the 95 % half-width is t(dof) x the standard error
    {
        poreModel
        {
            chargeDensity  { origin fitted; stderr 1.86056; ci95 4.7835; unit "mol/m3"; }
        }
    }
    correlation
    (
    );
}
