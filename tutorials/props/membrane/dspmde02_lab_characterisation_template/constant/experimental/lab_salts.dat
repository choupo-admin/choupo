/*--------------------------------------------------------------------------*\
  LABORATORY RECORD OF A NANOFILTRATION MEMBRANE -- the template, FILLED with the points of Labban et al. (2017)

  ONE FILE, ONE EXPERIMENT: three feeds (three concentration levels) x three pressures = nine
  rows, the order a laboratory writes them in.  A ROW is one operating point; every column is
  named by what it is.  FILL IT WITH YOUR OWN: keep the columns, replace the numbers.

    c_<salt>      the feed concentration of each salt, mol/m3 (0 where the salt is absent)
    dP_applied    the pressure you set, Pa -- CARRIED for the reader, never fitted
    Jv            the permeate flux you measured, m/s  (1 LMH = 1/3.6e6 m/s)
    R_<ion>       the OBSERVED rejection of each ion, 1 - c_permeate / c_feed, as a FRACTION;
                  write `nan` for an ion you did not analyse at that point (no term, no zero)

  CONDITIONS, stated once (what the fit reads them from):
    T             this file: `T` below (K)
    pH            the feed's pH -- carried in this comment and in the README; DSPM-DE has no pH,
                  the pore charge X_d you fit IS the pH's effect, and holds at that pH only
    membrane      `membrane` below, a label for the reader; the pore record is in constant/assets
    cross-flow    the film coefficient of your cell, declared in system/propsDict (`massTransfer`
                  for a correlation, or `k_film <m/s>` when you measured it) -- never hidden here

  THE VALUES BELOW are Labban, Liu, Chong & Lienhard, J. Membr. Sci. 521 (2017) 18-32,
  Tables 6-9 (read on the page images; see the case labban2017_dspmde_validation for every
  transcription and its page).  The paper has THREE FEEDS of different composition rather than
  three concentrations of one salt, so the three "concentration levels" are its NaCl + MgCl2,
  NaCl + Na2SO4 and artificial-seawater feeds, and each feed carries the ions the article measured in it (the others are `nan`: not analysed).
  Rows 1-3: feed 1 at 2, 3, 4 bar; rows 4-6: feed 2; rows 7-9: feed 3.
\*--------------------------------------------------------------------------*/

property     membrane.rejection;
membrane     Lab;

provenance
{
    source       measured;
    reviewStatus checked;
    citation     "O. Labban, C. Liu, T. H. Chong, J. H. Lienhard V, J. Membr. Sci. 521 (2017) 18-32, doi:10.1016/j.memsci.2016.08.062, Tables 6-9";
    identity     "the three feeds of one study (Labban 2017, Tables 6-9); a laboratory replaces this with its own experiment";
    licence      "facts: numbers transcribed from a published article (Elsevier copyright); the article is not in the tree";
}

T            298.15 K;     // ASSUMED here (the article states none); YOURS: the temperature of the run

columns
(
    { name c_NaCl;      unit mol/m3; }
    { name c_MgCl2;     unit mol/m3; }
    { name c_Na2SO4;    unit mol/m3; }
    { name c_CaCl2;     unit mol/m3; }
    { name dP_applied;  unit Pa; }
    { name Jv;          unit m/s; }
    { name R_Na;        unit -; }
    { name R_Mg;        unit -; }
    { name R_Ca;        unit -; }
    { name R_SO4;       unit -; }
    { name R_Cl;        unit -; }
);

data
(
      17.3380   10.4588    0.0000    0.0000    200000  3.333333e-06   -0.0760   0.9910      nan      nan   0.5100
      17.3380   10.4588    0.0000    0.0000    300000  5.333333e-06   -0.0170   0.9920      nan      nan   0.4900
      17.3380   10.4588    0.0000    0.0000    400000  7.333333e-06    0.0160   0.9900      nan      nan   0.5100
      17.1411    0.0000    7.0602    0.0000    200000  3.944444e-06    0.3780      nan      nan   0.9450  -0.0900
      17.1411    0.0000    7.0602    0.0000    300000  6.416667e-06    0.3940      nan      nan   0.9450  -0.0700
      17.1411    0.0000    7.0602    0.0000    400000  8.777778e-06    0.3940      nan      nan   0.9380  -0.0600
     439.3033   57.3545   22.2361    9.5314    200000  3.888889e-07   -0.0140   0.8340   0.5450   0.8270   0.1100
     439.3033   57.3545   22.2361    9.5314    300000  1.083333e-06   -0.0060   0.9060   0.7110   0.8540   0.1300
     439.3033   57.3545   22.2361    9.5314    400000  1.666667e-06    0.0117   0.9360   0.7890   0.8680   0.1500
);
