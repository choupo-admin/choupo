/*---------------------------------------------------------------------------*\
  Two SYNTHETIC solvents on an IDEAL liquid.  `ideal` is declared, not
  defaulted, and it is why the hansenMixture op marks every blend point
  `notVerified`: gamma = 1 cannot demix, so it cannot verify that the pair
  is one liquid either.  polymerP is NOT a component here -- it is the op's
  target, read as a record (constant/components/polymerP.dat).
\*---------------------------------------------------------------------------*/
recordType    thermophysicalPropertySystem;
schemaVersion 2;
components ( solventA solventB );
equilibrium
{
    formulation gammaPhi;
    liquid
    {
        activityModel ideal;
        standardState pureLiquid;
    }
    vapour
    {
        fugacityModel idealGas;
    }
}
