/*  surfacetension01 -- five pure liquids, ideal.  Every property asked is a pure-component one;
    nothing flashes.  Not sealed: the records come from data/standards/components.  */

recordType    thermophysicalPropertySystem;
schemaVersion 2;

components ( methanol ethanol 1Propanol triethanolamine nHexane );

equilibrium
{
    formulation gammaPhi;
    liquid { activityModel { model ideal; } }
    vapour { fugacityModel idealGas; }
}
