/*---------------------------------------------------------------------------*\
  NRTL binary interaction parameters --- acetone + carbonTetrachloride, the CASE'S OWN record
  (C433: a pair is found by name; an exception to the catalogue is a record
  in the case's own folder, declared).
\*---------------------------------------------------------------------------*/

recordType binaryInteractionParameters;
schemaVersion 1;

components  ( acetone  carbonTetrachloride );
model       NRTL;

pair { i acetone; j carbonTetrachloride; }

parameters
{
    i          acetone;
    j          carbonTetrachloride;
    a_ij       -0.42790;
    b_ij       0;
    a_ji       1.5931;
    b_ji       0;
    alpha      0.2;
}

provenance
{
    origin        literature;
    citation      "Dimensionless NRTL parameters (alpha 0.2) of Renon et al. (1971) as printed in Kooijman & Taylor, Ind. Eng. Chem. Res. 30 (1991) 1217-1222, Table I p. 1218.  Stated for 25 C only (b_ij = 0).";
    notes         "Moved from the dictionary into the case's own record by C433; no number changed.";
}
