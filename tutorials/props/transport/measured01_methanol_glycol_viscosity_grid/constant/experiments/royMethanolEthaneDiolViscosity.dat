/*---------------------------------------------------------------------------*\
  The dynamic viscosity of liquid methanol + ethane-1,2-diol (ethylene
  glycol) at 12 states: three temperatures (293.15, 298.15, 303.15 K) by four
  mass fractions of the diol (0, 0.25, 0.50, 0.75), at 101 kPa, by the
  capillary-tube (Ostwald; Ubbelohde) method, as the article reports them.
  Transcribed exactly as the NIST ThermoML Archive gives them, row after row
  in the archive's order (mass fraction outer, temperature inner); the archive
  attaches an expanded uncertainty of 0.7 to 1.3 % to each value, which is not
  carried in this file.  The viscosity rises about tenfold from the pure
  alcohol to 75 % glycol: no average of the pure values reproduces it.

  Read by transport.liquid.viscosity.measured (DEV.md 4c C421 slice (8)): a
  table over T and w[ethyleneGlycol], a rectangular grid.  The record states
  what the values are (`kind measured`); the case that reads it states how to
  interpolate and how far the table may stand.  The `P` column is the pressure
  the article states for every row: stated, not applied (the package's liquid
  viscosity takes T and composition).
\*---------------------------------------------------------------------------*/

provenance
{
    //  sha256 is of the `data ( );` block of THIS file as transcribed: it tells this
    //  transcription from a corrected one.
    sha256       "3f086af9b69daa29928aac00cfef76bbc26e6ec8508b24b624fb86ac715a3188";
    origin       literature;
    kind         measured;
    basis        "measured: capillary-tube (Ostwald; Ubbelohde) viscosities of methanol + ethane-1,2-diol at 101 kPa, 293.15-303.15 K, 0-75 mass % diol";
    citation     "Roy, M. N.; Pradhan, P.; Dewan, R. (2009). Study on ion solvent interactions of alkali metal salts in pure methanol and its binary mixtures with ethane-1,2-diol by a conductometric technique. Fluid Phase Equilib. 282, 51-57. doi:10.1016/j.fluid.2009.03.002 (the solvent viscosities the article reports)";
    via          "NIST ThermoML Archive (archive doi 10.18434/mds2-2422), file 10.1016/j.fluid.2009.03.002.xml, property 'Viscosity, Pa*s', variables Mass fraction[1,2-ethanediol] and Temperature, K";
}

property    liquidViscosity;
system      ( methanol ethyleneGlycol );
solvent     methanol;

columns
(
    { name T;                    unit K;    }
    { name P;                    unit kPa;  }
    { name w[ethyleneGlycol];    unit -;    }
    { name mu;                   unit Pa.s; }
);
data
(
    293.15  101  0  0.0005814
    298.15  101  0  0.0005436
    303.15  101  0  0.0005112
    293.15  101  0.25  0.0011268
    298.15  101  0.25  0.0010295
    303.15  101  0.25  0.0009454
    293.15  101  0.5  0.0022692
    298.15  101  0.5  0.0020452
    303.15  101  0.5  0.0018101
    293.15  101  0.75  0.0057998
    298.15  101  0.75  0.004904
    303.15  101  0.75  0.0042319
);

//  What the case may stand the table over: a few kelvin past the rows' support
//  (293.15-303.15 K) and up to 80 % glycol (the rows end at 75 %).
authorised
{
    T                   ( 290 306 );
    w[ethyleneGlycol]   ( 0 0.80 );
    reason      "a few kelvin and five mass percent of glycol past the rows, to show the nearest edge held and announced; the viscosity there is the edge row's, an approximation of the case, not a measurement";
}
