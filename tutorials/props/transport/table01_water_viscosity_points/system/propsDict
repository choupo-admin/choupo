/*  table01 -- water's liquid viscosity at 5, 25, 50 and 80 degC, two ways,
    then one point past the table.

    muVogel_*   the record's preferred law, `vogel` (a fit).
    muTable_*   the variant `crcPoints`: the case's table, logReciprocal.
                5 and 25 degC lie BETWEEN points: the value is the
                interpolant's; 50 and 80 degC are points themselves, so the
                table returns the printed value exactly.
    muPastEnd_extended  110 degC on `crcExtended`: the end segment's chord,
                announced; the largest excursion restated at the end of run.
    muPastEnd_refused   a scan 90-110 degC on `crcPoints`: 90 and 100 degC are
                points; 110 degC is REFUSED by name (written as nan, with the
                note naming the table, the span and the remedies).

    The golden master locks every computed value at reltol 1e-4.  */

operations
(
    {
        name        muVogel_278K;
        type        propertyPoint;
        state       { T 278.15 K;  P 1 bar;  composition { water 1.0; } }
        properties  ( viscosity_liquid );
    }
    {
        name        muVogel_298K;
        type        propertyPoint;
        state       { T 298.15 K;  P 1 bar;  composition { water 1.0; } }
        properties  ( viscosity_liquid );
    }
    {
        name        muVogel_323K;
        type        propertyPoint;
        state       { T 323.15 K;  P 1 bar;  composition { water 1.0; } }
        properties  ( viscosity_liquid );
    }
    {
        name        muVogel_353K;
        type        propertyPoint;
        state       { T 353.15 K;  P 1 bar;  composition { water 1.0; } }
        properties  ( viscosity_liquid );
    }
    {
        name        muTable_278K;
        type        propertyPoint;
        thermo      crcPoints;            // the variant that pins the case's table
        state       { T 278.15 K;  P 1 bar;  composition { water 1.0; } }
        properties  ( viscosity_liquid );
    }
    {
        name        muTable_298K;
        type        propertyPoint;
        thermo      crcPoints;
        state       { T 298.15 K;  P 1 bar;  composition { water 1.0; } }
        properties  ( viscosity_liquid );
    }
    {
        name        muTable_323K;
        type        propertyPoint;
        thermo      crcPoints;
        state       { T 323.15 K;  P 1 bar;  composition { water 1.0; } }
        properties  ( viscosity_liquid );
    }
    {
        name        muTable_353K;
        type        propertyPoint;
        thermo      crcPoints;
        state       { T 353.15 K;  P 1 bar;  composition { water 1.0; } }
        properties  ( viscosity_liquid );
    }
    {
        name        muPastEnd_extended;
        type        propertyPoint;
        thermo      crcExtended;          // the same table, extended to 110 degC
        state       { T 383.15 K;  P 2 bar;  composition { water 1.0; } }
        properties  ( viscosity_liquid );
    }
    {
        name        muPastEnd_refused;
        type        propertyScan1D;
        thermo      crcPoints;            // no extension: refused past 100 degC
        vary        { variable T;  from 363.15 K;  to 383.15 K;  n 3; }
        state       { P 2 bar;  composition { water 1.0; } }
        properties  ( viscosity_liquid );
        output      { file muPastEnd_refused.csv; }
    }
);
