/*  liquidDiffusivity01 -- what `transport { liquid { diffusivity {} } }`
    returns, and in which direction (DEV.md 4c C398 slice (d)).

    topDinf        the system: `returns infiniteDilution`, Wilke-Chang for
                   every pair, at the top of Pelkonen et al.'s Clausthal column,
                   run MIW9 (Chem. Eng. Process. 40 (2001) 235, Table 3: the
                   reflux at 55.47 C, 960 mbar; the liquid at 1.790 m, methanol
                   0.8175, 2-propanol 0.1357, water by difference).  The six
                   values D0(solute in solvent) differ by direction -- the
                   solvent's viscosity and association factor, the solute's
                   volume.  An EFFECTIVE value of this ternary is not asked:
                   it is refused (no rule that reduces the pair values to it
                   has been read; the view says so, and the gate
                   check_liquid_diffusivity_declaration holds the refusal).
    poling288      the variant `poling288`: methanol in water replaced by the
                   measured value Poling 5th ed. Table 11-5 prints at 288 K;
                   water in methanol stays Wilke-Chang.  The datum is used at
                   its own temperature only (its box is the point).
    binaryEffective  the variant `binaryEffective`: `returns effective` with
                   the Vignes rule, on the methanol-water binary at the top's
                   temperature -- the value a column's liquid film would take.

    The golden master locks every computed value at reltol 1e-4.  */

operations
(
    {
        name        topDinf;
        type        propertyPoint;
        state       { T 328.62 K;  P 96000 Pa;  composition { methanol 0.8175;  isopropanol 0.1357;  water 0.0468; } }
        properties  ( D_L_inf_methanol_in_isopropanol  D_L_inf_isopropanol_in_methanol
                      D_L_inf_methanol_in_water        D_L_inf_water_in_methanol
                      D_L_inf_isopropanol_in_water     D_L_inf_water_in_isopropanol );
    }
    {
        name        poling288;
        type        propertyPoint;
        thermo      poling288;            // the variant with the measured entry
        state       { T 288 K;  P 1 bar;  composition { methanol 0.5;  water 0.5; } }
        properties  ( D_L_inf_methanol_in_water  D_L_inf_water_in_methanol );
    }
    {
        name        binaryEffective;
        type        propertyPoint;
        thermo      binaryEffective;      // `returns effective`, rule Vignes
        state       { T 328.62 K;  P 96000 Pa;  composition { methanol 0.9459;  water 0.0541; } }
        properties  ( D_L_inf_methanol_in_water  D_L_inf_water_in_methanol  D_L_effective );
    }
);
