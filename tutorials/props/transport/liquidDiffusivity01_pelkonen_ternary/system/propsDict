/*  liquidDiffusivity01 -- what `transport { liquid { diffusivity {} } }`
    returns, and in which direction (DEV.md 4c C398 slice (d)).

    topDinf        the system: `returns infiniteDilution`, at a state taken
                   from Pelkonen et al.'s Clausthal column, run MIW9 (Chem. Eng.
                   Process. 40 (2001) 235, Table 3): the temperature is T_Top,
                   55.47 C, which their nomenclature defines as the REFLUX
                   stream's; the composition is the liquid SAMPLED at 1.790 m
                   (methanol 0.8175, 2-propanol 0.1357, water by difference);
                   960 mbar.  That liquid's own bubble point at 960 mbar is
                   339.18 K (this package), so the state is the reflux's
                   temperature with the packing's liquid, not a film state.
                   The six values D0(solute in solvent) differ by direction --
                   the solvent's viscosity and association factor, the solute's
                   volume.  The EFFECTIVE value of this ternary is not asked
                   here: it takes rule VignesKooijmanTaylor and a reduction
                   (C329 slice B2a; the case liquidDiffusivity02 runs them on
                   the paper that proposed them), and the six values here are
                   the pairs that rule combines.
    poling288      the variant `poling288`: methanol in water replaced by the
                   value Poling 5th ed. Table 11-5 prints at 288 K (p. 11.31);
                   water in methanol stays Wilke-Chang, named with its reason.
                   The datum is used at its own temperature only (its box is
                   the point).
    wc313, leeLi313
                   methanol-water at 313.13 K: Wilke-Chang beside the two values
                   Lee & Li measured (Poling 5th ed. p. 11.38, Example 11-8):
                   water in methanol is where Wilke-Chang is used outside its
                   stated scope, and the gap is printed, not hidden.
    binaryEffective, cbBinary, lcBinary, abBinary
                   `returns effective` by Vignes, Caldwell-Babb,
                   Leffler-Cullinan and Anderson-Babb on the methanol-water
                   binary at the same temperature, each beside the two
                   infinite-dilution values and the mixture's viscosity.
    muMethanol, muWater, muIsopropanol
                   the pure liquids' viscosities at that temperature (what
                   Wilke-Chang and the viscosity-corrected rules read).

    The golden master locks every computed value at reltol 1e-4.  */

operations
(
    {
        name        topDinf;
        type        propertyPoint;
        state       { T 328.62 K;  P 96000 Pa;  composition { methanol 0.8175;  isopropanol 0.1357;  water 0.0468; } }
        properties  ( D_L_inf_methanol_in_isopropanol  D_L_inf_isopropanol_in_methanol
                      D_L_inf_methanol_in_water        D_L_inf_water_in_methanol
                      D_L_inf_isopropanol_in_water     D_L_inf_water_in_isopropanol );
    }
    {
        name        poling288;
        type        propertyPoint;
        thermo      poling288;            // the variant with the stated entry
        state       { T 288 K;  P 1 bar;  composition { methanol 0.5;  water 0.5; } }
        properties  ( D_L_inf_methanol_in_water  D_L_inf_water_in_methanol );
    }
    {
        name        wc313;                // Wilke-Chang at Lee & Li's temperature
        type        propertyPoint;
        state       { T 313.13 K;  P 1 bar;  composition { methanol 0.5;  water 0.5; } }
        properties  ( D_L_inf_methanol_in_water  D_L_inf_water_in_methanol );
    }
    {
        name        leeLi313;             // the two values Lee & Li measured (Poling p. 11.38)
        type        propertyPoint;
        thermo      leeLi313;
        state       { T 313.13 K;  P 1 bar;  composition { methanol 0.5;  water 0.5; } }
        properties  ( D_L_inf_methanol_in_water  D_L_inf_water_in_methanol );
    }
    {
        name        binaryEffective;
        type        propertyPoint;
        thermo      binaryEffective;      // `returns effective`, rule Vignes
        state       { T 328.62 K;  P 96000 Pa;  composition { methanol 0.9459;  water 0.0541; } }
        properties  ( D_L_inf_methanol_in_water  D_L_inf_water_in_methanol  D_L_effective  viscosity_liquid );
    }
    {
        name        cbBinary;
        type        propertyPoint;
        thermo      cbBinary;      // `returns effective`, rule CaldwellBabb
        state       { T 328.62 K;  P 96000 Pa;  composition { methanol 0.9459;  water 0.0541; } }
        properties  ( D_L_inf_methanol_in_water  D_L_inf_water_in_methanol  D_L_effective  viscosity_liquid );
    }
    {
        name        lcBinary;
        type        propertyPoint;
        thermo      lcBinary;      // `returns effective`, rule LefflerCullinan
        state       { T 328.62 K;  P 96000 Pa;  composition { methanol 0.9459;  water 0.0541; } }
        properties  ( D_L_inf_methanol_in_water  D_L_inf_water_in_methanol  D_L_effective  viscosity_liquid );
    }
    {
        name        abBinary;
        type        propertyPoint;
        thermo      abBinary;      // `returns effective`, rule AndersonBabb
        state       { T 328.62 K;  P 96000 Pa;  composition { methanol 0.9459;  water 0.0541; } }
        properties  ( D_L_inf_methanol_in_water  D_L_inf_water_in_methanol  D_L_effective  viscosity_liquid );
    }
    {
        name        muMethanol;
        type        propertyPoint;
        state       { T 328.62 K;  P 96000 Pa;  composition { methanol 1; } }
        properties  ( viscosity_liquid );
    }
    {
        name        muWater;
        type        propertyPoint;
        state       { T 328.62 K;  P 96000 Pa;  composition { water 1; } }
        properties  ( viscosity_liquid );
    }
    {
        name        muIsopropanol;
        type        propertyPoint;
        state       { T 328.62 K;  P 96000 Pa;  composition { isopropanol 1; } }
        properties  ( viscosity_liquid );
    }
);
