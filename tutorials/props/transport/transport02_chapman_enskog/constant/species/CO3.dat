/*--------------------------------*- Choupo -*--------------------------------*\
  species/CO3.dat -- ONE model species, ONE typed file (the 2026-07-18
  structural decision: the aqueous monolith dismantled; a sealed case copies
  exactly the species it reaches, so the student sees the facts in use).
  Body fields verbatim from the curated catalogue record (citations ride).
\*-----------------------------------------------------------------------------*/
recordType modelSpecies;
schemaVersion 1;

name    CO3;
formula     "CO3-2";
charge  -2;
MW { value 60.01; unit g/mol;}
aqueousThermo
{
//  These two carried NO citation of their own: the gate saw the
//  Criss-Cobble source of the Cp block below and counted the record
//  as sourced -- the same shape its own docstring records for a
//  volumetric block.  The primary page was read 2026-08-24 and both
//  values agree exactly, so the citation is now theirs.
source "Wagman et al., The NBS Tables of Chemical Thermodynamic Properties, J. Phys. Chem. Ref. Data 11, Suppl. 2 (1982), Table 23:C (CARBON), p. 2-83, row 'CO3= ao' -- PRIMARY PAGE READ 2026-08-24 (delegated review, docs/design/interim-review-2026-08-24.md)";
hfAq { value -677140; unit J/mol;}
sAq  { value -56.9;  unit J/mol/K;}
        // Criss-Cobble 1964 (JACS 86, 5390, Table II, verbatim):
// T-AVERAGED partial molal heat capacity Cp-bar]_298^T,
// cal/mol/K on the CC ABSOLUTE single-ion scale (Cp(H+) =
// 28 cal at 25 C -- cancels in any NEUTRAL salt sum, the
// only thing the engine consumes).
cpAvg298
{
    model  crissCobble1964;
    scale  crissCobbleAbsolute;
    units  "cal/mol/K";
    averageFrom298
    (
        { T 298.15; value -139; }
        { T 333.15; value -121; }
        { T 373.15; value -132; }
        { T 423.15; value -127; }
        { T 473.15; value -138; }
    );
    source "Criss & Cobble, JACS 86 (1964) 5390, Table II";
}
}
