/*---------------------------------------------------------------------------*\
  IN-DIE COMPACTION OF MCC (Avicel PH200)
  -- van der Haven et al., Sci. Data 13 (2026) 1468, CC BY 4.0.

  Each row is ONE tablet compressed once on a Styl'One compaction simulator
  (Euro B 11.28 mm flat-faced punches), read at its MAXIMUM force:
    P        the compaction pressure, the mean of the upper and lower punch
             forces over the punch face (the dataset's own definition);
    density  the in-die density at that force, corrected for punch
             deformation -- both transcribed from the archive's
             `Compaction (true density)/Preprocessed data/Density vs
             Pressure - MCC.csv` (columns 2 and 1), all 45 rows;
    C        the Kawakita volume strain (H0 - h)/H0, computed HERE from the
             same tablet's raw file (`Raw data/MCC/*.xlsx`, sheet Datas:
             `Die filling height` H0 and `Corrected compression thickness at
             max force` h); the raw file's pressure matches the
             preprocessed one to 1e-3 MPa, which is how the rows were paired.
  The true density the case declares (1.6374 g/cm3) is the dataset's own
  EFFECTIVE true density (Kuentz-Leuenberger fit), `Processed
  data/Effective true density/Effective true densities.tab` -- not a helium
  pycnometry value; a pycnometric one is lower for MCC, which moves D.
  Rows sorted by pressure; values as printed to six figures, nothing adjusted.
\*---------------------------------------------------------------------------*/
provenance
{
    source         "van der Haven, D. L. H., Mikoroni, M., Jensen, R., Ortoft, F. H., Andreasen, J. L., Andersen, M. E., Dax, D., Zafar, U., Megarry, A., Naelapaa, K., Fragkopoulos, I. S., Elliott, J. A., Characterisation data of common pharmaceutical excipient powders and tablets for formulation development, Sci. Data 13 (2026) 1468, doi:10.1038/s41597-026-07707-0; data: Zenodo doi:10.5281/zenodo.16732963";
    licence        "CC BY 4.0 (article and Zenodo record)";
    transcribed    "from Preprocessed data/Density vs Pressure - MCC.csv and Raw data/MCC/*.xlsx of the Zenodo archive, read 2026-11-02";
    reviewStatus   interim;
}

columns
(
    { name P; unit MPa; }      // compaction pressure at maximum force
    { name density; unit g/cm3; }      // in-die density at maximum force
    { name C; unit -; }      // Kawakita strain (H0 - h)/H0, from the raw file
);

data
(
