/*---------------------------------------------------------------------------*\
  psat01_antoine_recovery: THE FIGURES (C480).  The fit publishes its points as a table, so the page opens on the data against the fitted Antoine curve, the parity and the residuals, and on A, B, C, R2 and the enthalpy of vaporisation with their units; the coefficients must come back exactly.
\*---------------------------------------------------------------------------*/
operations
(
    {
        name       psat_water_fit;
        type       vaporPressureFit;
        component  water;
        dataset    "constant/experiments/psat-water-synthetic.dat";
        output     { file psat_water_fit.csv; }
    }
);
