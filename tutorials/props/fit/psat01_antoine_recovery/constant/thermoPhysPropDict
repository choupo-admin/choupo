/*  The fit itself needs no thermodynamics -- it regresses numbers from a
    file.  The package is here for the CROSS-CHECK: the op names the
    component so its dHvap can be read against the curated correlation the
    data came from.
*/
recordType    thermophysicalPropertySystem;
schemaVersion 2;

components    ( water );

equilibrium
{
    formulation gammaPhi;
    liquid  { activityModel { model ideal; } }
    vapour  { fugacityModel idealGas; }
}
