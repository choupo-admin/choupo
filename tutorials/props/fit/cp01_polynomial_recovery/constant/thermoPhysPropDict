/*  The regression needs no thermodynamics.  The package is here for the
    KIRCHHOFF cross-check: the op names the component so its curated
    ideal-gas Cp can be read against the fitted liquid one.
*/
recordType    thermophysicalPropertySystem;
schemaVersion 2;

components    ( Dichloroethane );

equilibrium
{
    formulation gammaPhi;
    liquid  { activityModel { model ideal; } }
    vapour  { fugacityModel idealGas; }
}
