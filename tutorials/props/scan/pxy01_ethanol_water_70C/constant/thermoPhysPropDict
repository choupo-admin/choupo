/*---------------------------------------------------------------------------*\
  thermophysicalPropertySystem (v2) -- gammaPhi for ethanol/water, the SAME
  package as hxy01_ethanol_water_1atm: NRTL with the curated pair, an
  ideal-gas vapour (the frame the pair was regressed in).  The P-x-y and the
  T-x-y of this case therefore read one equilibrium, and the round trip in
  system/propsDict holds them to each other.
\*---------------------------------------------------------------------------*/
recordType    thermophysicalPropertySystem;
schemaVersion 1;

components ( ethanol water );

equilibrium
{
    formulation gammaPhi;               // gamma (liquid) x phi (vapour)
    liquid
    {
        activityModel
        {
            model NRTL;
            binaryParameters            // declared WHERE consumed
            {
                ethanol-water { source "data/standards/parameters/NRTL/ethanol-water.dat"; }
            }
        }
        standardState pureLiquid;       // gamma_i -> 1 as x_i -> 1 (Raoult datum)
    }
    vapour
    {
        fugacityModel idealGas;         // consistent with the pair regression
    }
}
