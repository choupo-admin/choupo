/*---------------------------------------------------------------------------*\
  thermoPhysPropDict (v2) -- SRK on both phases, kij = 0; and the variant
  `peneloux`, which adds the volume translation of Peneloux, Rauzy and Freze
  (Fluid Phase Equilib. 8 (1982) 7-23).

  THE SHIFT IS DATA THE CASE CARRIES.  The catalogue's component records hold
  no Rackett Z_RA, so the variant declares each component's, with where it was
  read: Table 1, p. 10 of the paper (column RKSc1, the adjusted Z_RA the paper
  recommends).  c = 0.40768 (R Tc/Pc)(0.29441 - Z_RA) (Eq. 8, p. 10).  A
  component declared without a Z_RA or a shift is REFUSED by name; the
  Yamada-Gunn estimate is available only by writing `missingZRA YamadaGunn;`.
\*---------------------------------------------------------------------------*/

recordType    thermophysicalPropertySystem;
schemaVersion 2;

components    ( nHexane nDecane );

equilibrium
{
    formulation phiPhi;

    equationOfState
    {
        model      SRK;
        mixingRule vanDerWaalsOneFluid;
    }

    liquid { fugacityRoute equationOfState; root liquid; }
    vapour { fugacityRoute equationOfState; root vapour; }
}

caloric
{
    energyBasis elementsDatum;
    liquid { departureRoute equilibriumEquationOfState; root liquid; }
    vapour { departureRoute equilibriumEquationOfState; root vapour; }
}

variants
{
    peneloux                            // only what differs from the system above
    {
        equilibrium
        {
            formulation phiPhi;

            equationOfState
            {
                model      SRK;
                mixingRule vanDerWaalsOneFluid;

                volumeTranslation
                {
                    model Peneloux;
                    components
                    {
                        nHexane { ZRA 0.2636;
                                  source "Peneloux, Rauzy and Freze 1982, Fluid Phase Equilib. 8, 7-23, Table 1 p. 10 (RKSc1, n-hexane)"; }
                        nDecane { ZRA 0.2578;
                                  source "Peneloux, Rauzy and Freze 1982, Fluid Phase Equilib. 8, 7-23, Table 1 p. 10 (RKSc1, n-decane)"; }
                    }
                }
            }

            liquid { fugacityRoute equationOfState; root liquid; }
            vapour { fugacityRoute equationOfState; root vapour; }
        }
    }

    penelouxSpencer                          // the SAME shift with the Z_RA of Spencer and Adler (Table 1, same page)
    {
        equilibrium
        {
            formulation phiPhi;

            equationOfState
            {
                model      SRK;
                mixingRule vanDerWaalsOneFluid;

                volumeTranslation
                {
                    model Peneloux;
                    components
                    {
                        nHexane { ZRA 0.2636;
                                  source "Peneloux, Rauzy and Freze 1982, Fluid Phase Equilib. 8, 7-23, Table 1 p. 10 (Spencer-Adler column, n-hexane)"; }
                        nDecane { ZRA 0.2507;
                                  source "Peneloux, Rauzy and Freze 1982, Fluid Phase Equilib. 8, 7-23, Table 1 p. 10 (Spencer-Adler column, n-decane)"; }
                    }
                }
            }

            liquid { fugacityRoute equationOfState; root liquid; }
            vapour { fugacityRoute equationOfState; root vapour; }
        }
    }
}
