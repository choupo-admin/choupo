    VT2005
    {
        model       COSMOSAC;
        variant     "2002";
        source      "SYNTHETIC teaching surrogate (Choupo, GPL-3.0-or-later): Gaussian sigma-profile with the qualitative shape of the compound class (polar bimodal / apolar central), NOT the VT-2005 values -- the real dataset is externally licensed; install it with bin/choupo-import-cosmo";
        area        80.0;
        volume      60.0;
        sigmaProfile
        (
