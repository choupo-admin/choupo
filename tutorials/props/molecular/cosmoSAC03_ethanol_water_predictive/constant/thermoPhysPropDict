/*---------------------------------------------------------------------------*\
  thermoPhysPropDict -- the PREDICTIVE model is the case's package:
  COSMO-SAC variant LVPP-HFTZVP-2018, each component carrying its own sigma
  profile (constant/components/<name>.dat, set LVPP-HFTZVP-2018) and NO
  binary parameter.  The fitted NRTL is brought in by ONE operation's
  thermo{} override (system/propsDict), never mixed into this package.
\*---------------------------------------------------------------------------*/

recordType    thermophysicalPropertySystem;
schemaVersion 2;

components       ( ethanol  water );

equilibrium
{
    formulation gammaPhi;

    liquid
    {
        activityModel
        {
            model cosmoSAC;
            source LVPP-HFTZVP-2018;
        }
        standardState pureLiquid;
    }

    vapour
    {
        fugacityModel idealGas;
    }
}
