/*---------------------------------------------------------------------------*\
  A PAIR RECORD OF TWO NAMED SETS (contract K3, Theory Guide sec:pair-sets) --
  nButanol(i) + water(j), NRTL.  A WITNESS RECORD, case-local, NOT a catalogue
  record.

  set `lle`        the numbers of the catalogue record
                   data/standards/parameters/NRTL/nButanol-water.dat, copied
                   VERBATIM: regressed by Choupo to measured liquid-liquid tie
                   lines and the heteroazeotrope (DEV.md 4c C16, C225, C226).
                   Its own record says what it is not for: the homogeneous
                   butanol-rich VLE at 1 atm (2.18 K high on average).
  set `probe_vle`  A PROBE, NOT A REGRESSION AND NOT A PUBLISHED SET: the
                   `lle` tau numbers (a_ij, b_ij, a_ji, b_ji) scaled by 0.7,
                   alpha kept.  No honest second set of this pair (one fitted
                   to the homogeneous VLE alone) exists in the tree or in the
                   literature folder, and none is invented here: this set
                   exists so a case can SELECT a second set and the run show
                   which one it used.  Its numbers must never be cited.
\*---------------------------------------------------------------------------*/

recordType binaryInteractionParameters;
schemaVersion 1;

pair { i nButanol; j water; }

components  ( nButanol  water );
model       NRTL;

preferred lle;

sets
{
    lle
    {
        parameters
        {
            i           nButanol;
            j           water;
            a_ij        -4.11160376;
            b_ij        1708.88106578;
            a_ji        4.05956908;
            b_ji        -151.85707409;
            alpha       0.44639312;
        }
        provenance
        {
            origin        fitted;
            method        "copied from the catalogue record nButanol-water.dat (fitParameters, T_bubble + LLE)";
            reviewStatus  interim;
            reviewReason  "a witness copy of the catalogue's set for the K3 contract; the catalogue record is the authority";
        }
        validity
        {
            temperature { min 288.20 K; max 365.85 K; }
            pressure    { min 101300 Pa; max 101300 Pa; }
            note        "the span of the catalogue record's fit evidence";
        }
        fittedTo lle;
    }

    probe_vle
    {
        parameters
        {
            i           nButanol;
            j           water;
            a_ij        -2.87812263;
            b_ij        1196.21674605;
            a_ji        2.84169836;
            b_ji        -106.29995186;
            alpha       0.44639312;
        }
        provenance
        {
            origin        assumed;
            method        "PROBE: the lle set's tau numbers scaled by 0.7; not a regression";
            reviewStatus  interim;
            reviewReason  "a constructed probe so that a case can select a second named set; never to be cited";
        }
        validity
        {
            temperature { min 288.20 K; max 365.85 K; }
            note        "inherited from the lle set for the probe; the probe is not a measured fit";
        }
        fittedTo vle;
    }
}
