/*---------------------------------------------------------------------------*\
  thermoPhysPropDict (v2) -- gammaPhi for nButanol + water with a pair record
  of TWO NAMED SETS (constant/parameters/NRTL/nButanol-water-sets.dat).  The
  case's own system takes the record's `preferred` set (lle); the variant
  `vleSet` names the other with `set probe_vle;` beside the pair's `source`.
  The numbers of the second set are a PROBE (see the record's header).
\*---------------------------------------------------------------------------*/
recordType    thermophysicalPropertySystem;
schemaVersion 1;

components ( nButanol water );

equilibrium
{
    formulation gammaPhi;
    liquid
    {
        activityModel
        {
            model NRTL;
            binaryParameters
            {
                nButanol-water { source "constant/parameters/NRTL/nButanol-water-sets.dat"; }
            }
        }
        standardState pureLiquid;
    }
    vapour { fugacityModel idealGas; }
}

variants
{
    vleSet
    {
        equilibrium
        {
            formulation gammaPhi;
            liquid
            {
                activityModel
                {
                    model NRTL;
                    binaryParameters
                    {
                        nButanol-water { source "constant/parameters/NRTL/nButanol-water-sets.dat"; set probe_vle; }
                    }
                }
                standardState pureLiquid;
            }
            vapour { fugacityModel idealGas; }
        }
    }
}
