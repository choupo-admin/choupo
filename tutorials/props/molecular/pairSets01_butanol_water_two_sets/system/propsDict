/*  Two operations: the same state, the same liquid, one pair record -- the
    first reads the record's preferred set (lle, from the case's own system),
    the second the set `probe_vle` (variant vleSet).  The pressures differ
    because the sets' numbers differ; nothing else changes. */
operations
(
    {
        name        bubble_preferred_set;
        type        propertyPoint;
        state
        {
            T            373.15 K;
            P            1 atm;
            composition  { nButanol 0.8;  water 0.2; }
        }
        properties  ( P_bubble );
    }

    {
        name        bubble_probe_set;
        type        propertyPoint;
        thermo      vleSet;
        state
        {
            T            373.15 K;
            P            1 atm;
            composition  { nButanol 0.8;  water 0.2; }
        }
        properties  ( P_bubble );
    }
);
