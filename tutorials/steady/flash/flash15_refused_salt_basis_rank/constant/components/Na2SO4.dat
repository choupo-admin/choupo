/*----------------------------------------------------------*\
  constant/components/Na2SO4.dat -- MERGED sealed record: the standards base with
  this case's partial overlay applied top-level (Choupo-2607 release).
  Materialised by bin/choupo-import so the sealed case reads ONE
  complete record with the catalogue hidden; provenance (base +
  overlay hashes) is recorded in constant/propertyManifest.
\*----------------------------------------------------------*/

/*  CASE-LOCAL OVERLAY: the declared bridge of Na2SO4 onto the ion families.
    Additive to data/standards/components/Na2SO4.dat -- everything else (MW, the
    solid datum, solidPhases) comes from the curated record.

    These four bridges together are what make the basis matrix rank 3.  Each
    one on its own is unremarkable; it is the SET that is degenerate.  */

name        Na2SO4;

formula     Na2SO4;

CAS         7757-82-6;

MW          142.036;

role        nonvolatile;

solid
{
    rho_p   2680.0;            
}

standardThermochemistry
{
    dHf_298   -1387080;        
    s_298     149.58;          
    referenceState     pureSolid;
}

solidHeatCapacity
{
    model         polynomial;          
    coefficients  ( 128.2 );           
    Trange        ( 298  600 );        
}

provenance
{
    standardThermochemistry { origin literature; method "Wagman et al. NBS Tables 1982 (anhydrous thenardite)"; }
    solidHeatCapacity { origin literature; method "Wagman et al. NBS Tables 1982 (Cp298, carried constant)"; }
    rho_p { origin literature; method "thenardite mineralogical density ~2.68 g/cm3"; }
}

solidPhases
{
    thenardite
    {
        dissolutionReaction { masters ( { ion Na; nu 2; } { ion SO4; nu 1; } ); }
        equilibrium { logK25 0.65; dH -23100; analytic ( 159.849 0.01699 -5000 -59.6073 ); source "USGS PHREEQC phreeqc.dat (public domain); lit: ref. 3"; }
    }
}

aqueousSpeciation  Na2SO4Salt;

aqueousMapping ( { species Na; nu 2; } { species SO4; nu 1; } );
