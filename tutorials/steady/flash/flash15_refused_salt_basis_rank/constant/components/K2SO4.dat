/*----------------------------------------------------------*\
  constant/components/K2SO4.dat -- MERGED sealed record: the standards base with
  this case's partial overlay applied top-level (Choupo-2607 release).
  Materialised by bin/choupo-import so the sealed case reads ONE
  complete record with the catalogue hidden; provenance (base +
  overlay hashes) is recorded in constant/propertyManifest.
\*----------------------------------------------------------*/

/*  CASE-LOCAL OVERLAY: the declared bridge of K2SO4 onto the ion families.
    Additive to data/standards/components/K2SO4.dat -- everything else (MW, the
    solid datum, solidPhases) comes from the curated record.

    These four bridges together are what make the basis matrix rank 3.  Each
    one on its own is unremarkable; it is the SET that is degenerate.  */

name        K2SO4;

formula     K2SO4;

CAS         7778-80-5;

MW          174.259;

role        nonvolatile;

solid
{
    rho_p   2660.0;            
}

standardThermochemistry
{
    dHf_298   -1437790;        
    s_298     175.56;          
    referenceState     pureSolid;
}

solidHeatCapacity
{
    model         polynomial;          
    coefficients  ( 131.46 );          
    Trange        ( 298  600 );        
}

provenance
{
    standardThermochemistry { origin literature; method "Wagman et al. NBS Tables 1982"; }
    solidHeatCapacity { origin literature; method "Wagman et al. NBS Tables 1982 (Cp298, carried constant)"; }
    rho_p { origin literature; method "arcanite mineralogical density ~2.66 g/cm3"; }
}

solidPhases
{
    arcanite
    {
        dissolutionReaction { masters ( { ion K; nu 2; } { ion SO4; nu 1; } ); }
        equilibrium { logK25 -1.776; dH 20920; analytic ( 674.142 0.30423 -18037 -280.236 0 -0.000144055 ); source "USGS PHREEQC phreeqc.dat (public domain); lit: ref. 3"; }
    }
}

aqueousSpeciation  K2SO4Salt;

aqueousMapping ( { species K; nu 2; } { species SO4; nu 1; } );
