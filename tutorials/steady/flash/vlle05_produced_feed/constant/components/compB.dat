/*---------------------------------------------------------------------------*\
  Component: compB  -- synthetic PSEUDO-component for VLLE algorithm audit.
  Antoine giving Psat ≈ 0.5 bar at 350 K (the less-volatile audit partner).
  Pedagogically only --- NOT A REAL SUBSTANCE (formula "B", CAS 00-00-0).

  THIS COPY carries a SYNTHETIC standardThermochemistry block, ADOPTED by
  the witness vlle05_produced_feed (DEV.md C37 item 4): a fictitious
  species has no elements and no real heat of formation, so the datum
  below is INVENTED (dHf_298 = 0, s_298 = 200 J/mol/K for all three) and
  only DIFFERENCES of it are read -- it exists so that the energy report
  runs and the producer's row and the report can be compared.  The
  catalogue record keeps its deliberate absence.
  Sources: none -- a synthetic audit species: the Antoine coefficients
  (Psat ~0.5 bar at 350 K) and the flat Cp values are TUNED for the VLLE
  algorithm test; no physical primary exists (not a real substance).
\*---------------------------------------------------------------------------*/

name        compB;
formula     B;
CAS         00-00-0;

MW          50.0;
Tc          550.0;
Pc          40.0;
omega       0.20;
Tb          355.0;
HvapTb      35000;
Vliq        1.0e-4;

vaporPressure
{
    model         Antoine;
    coefficients  (4.0   1700.0   -30.0);   // log10 P_bar = A - B/(T + C)
    Trange        (300  400);
}

idealGasHeatCapacity
{
    model         polynomial;
    coefficients  (80.0   0.0   0.0   0.0);
    Trange        (200  500);
}

liquidHeatCapacity
{
    model         polynomial;
    coefficients  (120.0);
    Trange        (300  400);
}

// SYNTHETIC datum (see the header): invented, differences only.
standardThermochemistry
{
    dHf_298   0.0;
    s_298     200.0;
}
