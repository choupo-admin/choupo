/*---------------------------------------------------------------------------*\
  The package the ThermoResolver recommends for this system -- persisted,
  reviewable, sealed (the resolver materialises; the runtime classifies the
  sealed system, VERIFIES this declaration and executes it, announcing any
  divergence).

  Classification (from canonical component FACTS, never from names):
      water        declared aqueous solvent      (a_w-based VLE)
      aceticAcid   molecular reactive            (aqueousSpeciation aceticAcid)
      NH3          molecular reactive            (aqueousSpeciation ammonia)
      ethanol      molecular condensable,        (aqueousSpeciation none)
                   nonionising

  Aqueous network: HAc-formation + NH3aq-formation + water-dissociation on
  masters ( Acetate NH4 ); the acid-base coupling NH3 + HAc = NH4+ + Ac-
  emerges from the shared H+.  Vapour-phase reaction: the acetic dimer
  (2 HAc(g) = (HAc)2(g)) lives on the gas-liquid record -- deliberately NOT
  inside aqueousSpeciation.

  The composite mixed-solvent electrolyte v1 is AVAILABLE and is the
  resolver recommendation for this system (flash13 runs it, with the full
  curated ethanol-water NRTL pair on the backbone).  This tutorial
  DELIBERATELY overrides that recommendation with the authorised ideal
  molecular VLE approximation for ethanol, so that flash12 stays the ideal
  REFERENCE case for comparison with flash13 -- delimited to the listed
  components, announced when exercised, refused for anything unlisted.
  One declared liquid surface: Davies ions, unit-gamma neutrals, ethanol
  gamma = 1 with p = x * psat(T).
\*---------------------------------------------------------------------------*/

recordType    thermophysicalPropertySystem;
schemaVersion 2;

components    ( aceticAcid  NH3  ethanol  water );

equilibrium
{
    formulation electrolyteGammaPhi;

    aqueous
    {
        activityModel { model davies; }      // this slice's rung (announced)
    }

    vapour    { fugacityModel idealGas; }

    volatiles ( aceticAcid  NH3  ethanol  water );
}

approximations
{
    idealMolecularVLE
    {
        components ( ethanol );              // delimited -- never global
        reason "ideal reference case for comparison with flash13";
    }
}
