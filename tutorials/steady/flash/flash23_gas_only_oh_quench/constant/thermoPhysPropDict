/*---------------------------------------------------------------------------*\
  thermoPhysPropDict (v2) -- ideal gamma-phi: Raoult for water, an ideal-gas
  vapour.  N2 and water are components; OH is a gas-only species of the
  NASA table, resolved by name from the declared table (DEV.md 4c C458).
\*---------------------------------------------------------------------------*/

recordType    thermophysicalPropertySystem;
schemaVersion 1;

components       ( N2 water OH );

//  OH is not a component: it is read from the gas-species table, because
//  components/ has no record of that name and this system declares the table.
speciesTables ( NASA-TP-2002-211556 );

equilibrium
{
    formulation gammaPhi;

    liquid
    {
        activityModel ideal;
        standardState pureLiquid;
    }

    vapour
    {
        fugacityModel idealGas;
    }
}
