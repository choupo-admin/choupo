/*--------------------------------*- Choupo -*--------------------------------*\
|  CASE-LOCAL OVERLAY of data/standards/components/CaCO3.dat.                  |
|  The Database overlays field by field: everything not named here -- MW, the  |
|  solid formation datum, solidHeatCapacity, solidPhases -- comes from the     |
|  curated record and is NOT copied.                                          |
\*-----------------------------------------------------------------------------*/

name        CaCO3;

formula     CaCO3;

CAS         471-34-1;

MW          100.0869;

role        nonvolatile;

solid
{
    rho_p   2710.0;            
}

standardThermochemistry
{
    dHf_298   -1207600;        
    s_298     91.7;            
    referenceState     pureSolid;
}

solidHeatCapacity
{
    model         polynomial;          
    coefficients  ( 29.8993   0.224617   -1.49637e-04 );
    Trange        ( 298  600 );        
}

solidPhases
{
    aragonite
    {
        dissolutionReaction { masters ( { ion Ca; nu 1; } { ion HCO3; nu 1; } { ion H; nu -1; } ); }
        equilibrium { logK25 1.993; dH -25731.6; analytic ( -64.0902 -0.04546451 -2248.497 32.66939 563713.9 ); source "USGS PHREEQC phreeqc.dat (public domain)"; }
    }
    calcite
    {
        dissolutionReaction { masters ( { ion Ca; nu 1; } { ion HCO3; nu 1; } { ion H; nu -1; } ); }
        
        
        
        
        
        
        
        
        
        equilibrium { logK25 1.849; dH -24509.8; analytic ( -64.0194 -0.04546451 -2312.471 32.66939 563713.9 ); validC ( 0 90 ); source "Plummer and Busenberg, Geochim. Cosmochim. Acta 46 (1982) 1011 (log Ksp -8.480 at 25 C, 0 - 90 C), rebased to HCO3; the same equation is in USGS PHREEQC phreeqc.dat (public domain)"; }
    }
}

aqueousSpeciation  carbonate;

aqueousMapping ( { species Ca; nu 1; } { species HCO3; nu 1; } );
