recordType gasLiquidEquilibrium;
schemaVersion 2;

// Equilibrium-parameterisation identity (ADR 2026-07-26, D2 migration wave):
// typed physical family + versioned convention profile.  gasSpecies is the
// gas-phase key of the gasOf contract (the component's declared formula:
// water -> H2O).  No Sander pair exists for the solvent itself -- single
// parameterisation, no cross-convention diagnostic.
gasSpecies       H2O;
dissolvedSpecies H2O;
solvent          water;
convention       PHREEQC-gasMolal-v1;

reaction "H2O(g) = H2O";
      logK25 1.5047; dH -44065; analytic ( -63.558906 -0.0096708571 4838.676 21.258553 -87337.878 1.0974088e-06 ); source "derived from water's own vapour-pressure law (components/water.dat, IAPWS SR1-86 Eq. 1): logK = -log10(psat/atm), six-term least squares over 273.16-473.15 K by bin/curate/fit_water_vapour_equilibrium.py; replaces the USGS PHREEQC phreeqc.dat fit";
