/*---------------------------------------------------------------------------*\
  thermoPhysPropDict (v2) -- T1 ideal gamma-phi mixture.
  Raoult DECLARED, not defaulted (gamma = 1 identically).
  Migrated mechanically from the v1 flat form (physics identical);
  v2 contract 2026-07-17.

  C256 (2026-11-09), MEASURED: water's vapour pressure is consulted above its
  critical temperature only for the superheated steam (773.15 K, 80 bar),
  which is one gas phase; a pure component has no K, so no printed number
  depends on it.
\*---------------------------------------------------------------------------*/

recordType    thermophysicalPropertySystem;
schemaVersion 2;

components       ( water );

equilibrium
{
    formulation gammaPhi;

    liquid
    {
        activityModel ideal;
        standardState pureLiquid;
    }

    vapour
    {
        fugacityModel idealGas;
    }
}

// Per-component multi-property surface override (dome + caloric + volume
// + transport on the named component) -- orthogonal to the blocks above.
pureFluids
{
    water { method IF97; }
}
