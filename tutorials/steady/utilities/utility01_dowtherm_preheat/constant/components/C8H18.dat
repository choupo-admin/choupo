// --- vendored for self-containment (2026-06-07) ---------------------
// origin   standard
// source   data/standards/components/C8H18.dat
// sha256   aa2bb451ff0bea77aa934a65f1ec2129d62f3e8564ae5d32cab2445def5b95b5
// note     byte-copy of the FROZEN reference at vendoring time. This case
//          is now self-contained + reproducible even if the standard evolves.
//          Verify-vs-standard / re-sync is a deliberate curation act.
// ----------------------------------------------------------------------

/*--------------------------------*- Choupo -*-----------------------*\
  Component: n-Octane  (C8H18, CAS 111-65-9)

  Reference compound for the gasoline RON / MON scale (iso-octane =
  2,2,4-trimethylpentane has the same Tc within ~5 K so this entry
  doubles as a surrogate when the isomer is not resolved).  Useful
  for combustion equilibria in IC engines.
  Sources: Reid-Prausnitz-Poling 4th ed., Appendix A; NIST WebBook.
\*---------------------------------------------------------------------------*/

name        C8H18;
formula     C8H18;
CAS         111-65-9;

MW          114.231;           // kg/kmol
Tc          568.70;             // K
Pc          24.86;              // bar
omega       0.398;              // [-]
Tb          398.83;             // K
HvapTb      34410;              // J/mol
Vliq        1.638e-4;           // m^3/mol

standardThermochemistry
{
    dHf_298    -208447.0;       // J/mol  -- ideal-gas reference
    s_298      466.73;          // J/(mol·K)
}

vaporPressure
{
    model         Antoine;
    coefficients  (4.04867   1351.94   -64.030);
    Trange        (326  399);
}

idealGasHeatCapacity
{
    model         polynomial;
    coefficients  (-6.096   0.7712   -4.195e-4   8.855e-8);
    Trange        (250  1500);
}

//  MIRROR of the catalogue fit -- the ONE home of these coefficients is
//  data/standards/components/nOctane.dat (same substance, CAS 111-65-9;
//  this authored record keeps the case's own component name).  Choupo's own
//  quadratic on the 11 points of Coulier et al., J. Chem. Eng. Data 60
//  (2015) 1563, doi 10.1021/je5008444, via the NIST ThermoML archive;
//  fit rms 0.18 J/(mol K).  provenance: transcribedNotCheckedAgainstArticle.
//  If the catalogue fit ever moves, this copy must follow it.
liquidHeatCapacity
{
    model         polynomial;
    coefficients  (181.6086   7.339146e-2   5.7048860e-4);
    Trange        (283.15  333.15);
}
