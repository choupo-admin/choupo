/*---------------------------------------------------------------------------*\
  thermoPhysPropDict (v2) -- T7 electrolyteGammaPhi: aqueous electrolyte
  (eNRTL) x ideal vapour; the REAL solid equilibrium rides in the inline
  chemistry{} block (TRANSITIONAL: the chemistryDict grammar is not ratified).
  NaCl + ethanol (antisolvent) eNRTL -- drowning-out crystallisation (gammaPMMixed).
  eNRTL pair resolved by cation-anion name: data/standards/parameters/eNRTL/Na-Cl.dat
\*---------------------------------------------------------------------------*/

recordType    thermophysicalPropertySystem;
schemaVersion 1;

components ( water ethanol NaCl );

equilibrium
{
    formulation electrolyteGammaPhi;    // aqueous electrolyte x ideal vapour

    aqueous
    {
        activityModel
        {
            model eNRTL;
        }
        compositionBasis molality;
    }

    vapour
    {
        fugacityModel idealGas;
    }
}


caloric
{
    energyBasis elementsDatum;          // ONE datum: the elements at 298.15 K

    aqueous
    {
        enthalpyRoute ionicReferencePlusExcess;   // aqueous inf-dilution ion
    }                                             //   datum + L_phi excess
    vapour
    {
        enthalpyRoute idealGasCp;
    }
}

// THE LIQUOR'S VOLUME (DEV.md 4c C421): the MSMPR's residence time tau = V/Q
// asks the property door for the liquor's density.  The package holds a
// density law for NaCl in water, but none for NaCl in a water-ethanol
// mixture, so this case DECLARES the hypothesis the unit used to make
// unannounced (it summed the components' stored volumes and gave the dissolved
// salt none): the NaCl keeps its mass and adds no volume.  The bound, 0.15, is
// set from the converged run's own [hypothesis] line: the largest NaCl share
// of the liquor it reaches is 0.117 by mass (the saturated brine is 26.4 %,
// and the ethanol fed with it dilutes it).
approximations
{
    massWithoutVolume
    {
        components      ( NaCl );
        maxMassFraction 0.15;
        reason          "the water-ethanol-NaCl liquor has no density law in the catalogue, only water-NaCl does; the dissolved salt keeps its mass and adds no volume, the reading this unit made silently before C421.  The largest NaCl share of the liquor the run reaches is 0.117 by mass (the saturated brine feed is 26.4 %, and the ethanol fed with it dilutes it)";
    }
}
