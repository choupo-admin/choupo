/*--------------------------------*- Choupo -*--------------------------------*\
  species/HCO3.dat -- ONE model species, ONE typed file (the 2026-07-18
  structural decision: the aqueous monolith dismantled; a sealed case copies
  exactly the species it reaches, so the student sees the facts in use).
  Body fields verbatim from the curated catalogue record (citations ride).
\*-----------------------------------------------------------------------------*/
recordType modelSpecies;
schemaVersion 1;

name    HCO3;
formula     "HCO3-";
charge  -1;
MW { value 61.02; unit g/mol;}
aqueousThermo
{
//  These two carried NO citation of their own: the gate saw the
//  Criss-Cobble source of the Cp block below and counted the record
//  as sourced -- the same shape its own docstring records for a
//  volumetric block.  The primary page was read 2026-08-24 and both
//  values agree exactly, so the citation is now theirs.
source "Wagman et al., The NBS Tables of Chemical Thermodynamic Properties, J. Phys. Chem. Ref. Data 11, Suppl. 2 (1982), Table 23:C (CARBON), p. 2-83, row 'HCO3- bicarbonate, ao' -- PRIMARY PAGE READ 2026-08-24 (delegated review, docs/design/interim-review-2026-08-24.md)";
hfAq { value -691990; unit J/mol;}
sAq  { value 91.2;  unit J/mol/K;}
        // Criss-Cobble 1964 (JACS 86, 5390, Table II, verbatim):
// T-AVERAGED partial molal heat capacity Cp-bar]_298^T,
// cal/mol/K on the CC ABSOLUTE single-ion scale (Cp(H+) =
// 28 cal at 25 C -- cancels in any NEUTRAL salt sum, the
// only thing the engine consumes).
cpAvg298
{
    model  crissCobble1964;
    scale  crissCobbleAbsolute;
    units  "cal/mol/K";
    averageFrom298
    (
        { T 298.15; value -48; }
        { T 333.15; value -27; }
        { T 373.15; value -25; }
        { T 423.15; value -34; }
        { T 473.15; value -35; }
    );
    potentiometric true;   // CC note b (cell-potential dT, larger errors)
    source "Criss & Cobble, JACS 86 (1964) 5390, Table II";
}
}

transport
{
    //  D0 ONLY (DEV.md 4c C157).  No `radius` is curated for this ion: the
    //  tier's radius is the HYDRATED radius of Nightingale, J. Phys. Chem. 63
    //  (1959) 1381 -- the convention of the eight master ions and of every
    //  DSPM-DE pore fitted against them -- and that table was not read back
    //  in the session that wrote this block.  A Stokes radius computed from
    //  D0 would be a different convention under the same key, so none is
    //  written: DSPM-DE still refuses this ion by name, while the multi-ionic
    //  polarisation film and the electrodialysis units read D0 alone.
    D0 { value 1.18e-09; unit m2/s; }
    provenance
    {
        source  "USGS PHREEQC database phreeqc.dat (usgs-coupled/phreeqc3, branch master, fetched 2026-10-25, sha256 5b80d45c989cd1db7aab485e198321ba550d5902be8097c8be26d85ba03da278), SOLUTION_SPECIES `CO3-2 + H+ = HCO3-` (line 225), `-dw` line 231: the 25 C tracer diffusion coefficient Dw is its first field; the further fields (temperature and ionic-strength dependence) are not used.  The database names no per-value reference on this line; its file-level references are Appelo, Parkhurst and Post, Geochim. Cosmochim. Acta 125 (2014) 49-67 (its ref. 1) and Appelo, Cem. Concr. Res. 101 (2017) 102-113 (its ref. 3)";
        licence publicDomain;
        D0
        {
            origin        literature;
            method        "read from the cited database line by a parse that checks the species equation above it (Dw at 25 C, infinite dilution)";
            reviewStatus  interim;
            notes         "Transcribed by machine from the cited public-domain database, not read back against a primary measurement of this ion's limiting conductance; the Stokes-Einstein correction to the run temperature is applied by the consumer (thermo/transport/StokesEinstein.H).";
        }
    }
}

volumetric
{
    //  STANDARD-STATE (infinite-dilution) partial molar volume,
    //  CONVENTIONAL scale V0(H+) = 0 (see the convention profile:
    //  only electroneutral sums are physical).
    //  CORRECTED 2026-08-24 against the primary page: the stored 24.29 is
//  not in Millero's Table III, which gives 23.4 at 25 degC (and to one
//  decimal, not two).  This record's own flag -- 'lower transcription
//  confidence than the majors, review first' -- was RIGHT, and it is
//  the only one of the eleven that was.
    V0          { value 23.4; unit cm3/mol; }
    convention  MilleroConventional-v1;
    Trange      ( 293 303 );   // 25 C table; +-5 K working band, extrapolation announced by the consumer's domain refusals
    source "Millero, Chem. Rev. 71 (1971) 147, Table III (Conventional Partial Molal Volumes of Ions in Water at 0, 25 and 50 degC), 25 degC block, p. 162 -- PRIMARY PAGE READ 2026-08-24 (delegated review, docs/design/interim-review-2026-08-24.md).  Millero states the table is itself taken from the compilation of his ref 81";
}
