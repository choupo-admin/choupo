/*---------------------------------------------------------------------------*\
  THE DEMONSTRATION'S REACTION, WHOSE REACTANT IS ABSENT (DEV.md 4c C378,
  ruling 4).  A CSTR needs a reaction; this one's rate is first order in
  sucrose, which the caustic feed does not carry, so the rate is zero and the
  reactor is a vessel of volume V_R that the liquid passes through.  Sucrose
  hydrolysis C12H22O11 + H2O -> 2 C6H12O6, written to two glucose for want of
  a fructose record (the same formula; the elements balance exactly).  On the
  aqueous electrolyte formulation an organic acid would be speciated, so the
  NaOH demonstrations do not use the esterification of the others.  The
  kinetics are ILLUSTRATIVE.
\*---------------------------------------------------------------------------*/
absentSucrose
{
    stoichiometry
    (
        { component sucrose;  nu -1;  order 1; }
        { component water;    nu -1;  order 0; }
        { component glucose;  nu  2;  order 0; }
    );
    kinetics
    {
        type   Arrhenius;
        A      1.0e3;        // 1/s -- illustrative
        Ea     5.0e4;        // J/mol
    }
}
