      0.5700  352.39
      0.6160  352.11
      0.6700  351.82
      0.7110  351.64
      0.8020  351.37
      0.8350  351.3
      0.8690  351.27
      0.9010  351.26
      0.9140  351.26
      0.9220  351.27
