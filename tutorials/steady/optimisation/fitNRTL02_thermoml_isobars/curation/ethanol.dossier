/*--------------------------------*- Choupo -*--------------------------------*\
  CURATION DOSSIER -- a scientific work record, NOT runtime property data.

  NOTHING IN THIS FILE IS VISIBLE TO THE SOLVER.  Record resolution looks only
  in <case>/constant/, data/standards/ and data/local/, so a file here is out
  of its reach BY CONSTRUCTION -- not by convention.

  Nothing here has been promoted.  Curation state belongs to the evidence
  process; runtime trust belongs to the numerical record actually admitted
  to data/standards/, and only an explicit human promotion moves one there
  (bin/curate/promote-from-dossier).

  MATURITY IS PER PROPERTY, not per component: the properties below may hold
  different verdicts, and any whole-component summary is DERIVED from them
  rather than stored beside them.

  Regenerated on every run.  Hand edits are lost.
\*-----------------------------------------------------------------------------*/

component      ethanol;
reviewStatus   unreviewed;

properties
(
{
    property       binaryVLE.T_bubble;
    operation      fit_NRTL_across_isobars;   // type fitParameters
    model          "NRTL binary pair, bubble-T residual at fixed P";
    verdict        heldOutPerformed;

    fittedParameters
    {
        equilibrium.liquid.activityModel.binaryParameters.ethanol-water.a_ij  1.63848598983;
        equilibrium.liquid.activityModel.binaryParameters.ethanol-water.b_ij  -539.173511227;
        equilibrium.liquid.activityModel.binaryParameters.ethanol-water.a_ji  -0.460896026686;
        equilibrium.liquid.activityModel.binaryParameters.ethanol-water.b_ji  681.603178514;
    }

    evidence
    {
        partitionFingerprint  "faae7fa065484f47";   // frozen before the fit

        datasets
        (
        {
            role      fit;
            dataset   "constant/experiments/ethanol-water-bubble-j.fluid.2011.06.009.dat";
            doi       "10.1016/j.fluid.2011.06.009";
            sha256    "288bc73f24c1c1e54f8f5685a6b1353d92378f093fd15271a27337b3a32e899d";
            provenance measured;
            archiveFile "j.fluid.2011.06.009.xml";
            system    "ethanol + water";
        }
        {
            role      validation;
            dataset   "constant/experiments/ethanol-water-bubble-je2008704.dat";
            doi       "10.1021/je2008704";
            sha256    "f24eca1286fb3d1fc4611eaf05bc771813d0dc41e81cf37c0c49b3ea9b871758";
            provenance measured;
            archiveFile "je2008704.xml";
            system    "ethanol + water";
            pressure  "101300.000000 Pa";
        }
        );

        domain
        {
            coordinate  x1;
            fit         { min 0.063; max 0.971; n 45; }
            validation  { min 0.018; max 0.972; n 21; }
        }
    }

    metrics
    {
        //  r2InSample: not computed by this operation (it reports chi-square).
        //  rmsHeldOut: not computed by this operation (see aadHeldOutPct).
        aadHeldOutPct     0.108817419527;
        //  No acceptance band was declared, so the residuals above are
        //  reported and NO verdict is claimed on them.  Whether they are
        //  small enough is a judgement, and the engine does not make it.
    }
}

);
