/*---------------------------------------------------------------------------*\
  sensitivity02_feasibility_map / system/outerDict

  WHAT THIS CASE IS: the sweep's FEASIBILITY MAP (design forum
  #102.6/#103 -- Front 4b).  The same reflux sweep as sensitivity01, now
  with declared CONSTRAINTS: every row of the CSV is EVALUATED and
  MARKED -- per constraint the value, the bound, the SIGNED normalised
  residual and a satisfied flag, plus a final `feasible` verdict.  No
  point is ever filtered or hidden: the infeasible rows ARE the lesson
  (where the purity spec fails and where the reboiler budget binds).

      x_D_LK  atLeast 0.985  -- the distillate purity spec: it fails for
                                R below ~2.9 (4 of the 10 rows, R = 1.5 to 2.67);
      V_strip atMost  0.065  -- the boilup budget: V_strip rises linearly
                                with R and reaches 0.0640 at R = 5.0, so the
                                budget would bind only at R ~ 5.07, just
                                BEYOND this sweep: no row violates it.

  The feasible window the student READS off the map is therefore bounded
  by the purity spec alone on this range (R = 3.06 to 5.0, 6 rows); the
  budget is the margin that remains (residual -0.016 at R = 5.0).  Widen
  `range` past 5.07 to see it bind.  These are the same constraints the SQP
  optimizer would enforce (optim04), parsed by the SAME shared grammar, but
  here as a MAP, not a single optimum.  The golden pins the feasible/infeasible split.
\*---------------------------------------------------------------------------*/

type    sweep;

parameter
{
    target    units[0].operation.refluxRatio;
    range     ( 1.5  5.0 );
    nPoints   10;
}

responses
(
    column01.T_top
    column01.T_bottom
    column01.x_D_LK
    column01.x_B_HK
    column01.V_strip
);

constraints
(
    { kpi column01.x_D_LK;   atLeast 0.985;  }
    { kpi column01.V_strip;  atMost  0.065;  }
);

report
{
    format   csv;
    file     sweep_results.csv;
}
