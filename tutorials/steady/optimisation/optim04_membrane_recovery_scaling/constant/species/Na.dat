/*--------------------------------*- Choupo -*--------------------------------*\
  species/Na.dat -- ONE model species, ONE typed file (the 2026-07-18
  structural decision: the aqueous monolith dismantled; a sealed case copies
  exactly the species it reaches, so the student sees the facts in use).
  Body fields verbatim from the curated catalogue record (citations ride).
\*-----------------------------------------------------------------------------*/
recordType modelSpecies;
schemaVersion 1;

name    Na;
formula     "Na+";
charge  +1;
MW { value 22.99; unit g/mol;}
aqueousThermo
{
hfAq { value -240120; unit J/mol;}
sAq  { value 59.0;  unit J/mol/K;}
cpAq { value 46.4; unit J/mol/K;}
        // Criss-Cobble 1964 (JACS 86, 5390, Table II, verbatim):
// T-AVERAGED partial molal heat capacity Cp-bar]_298^T,
// cal/mol/K on the CC ABSOLUTE single-ion scale (Cp(H+) =
// 28 cal at 25 C -- cancels in any NEUTRAL salt sum, the
// only thing the engine consumes).
cpAvg298
{
    model  crissCobble1964;
    scale  crissCobbleAbsolute;
    units  "cal/mol/K";
    averageFrom298
    (
        { T 298.15; value 37; }
        { T 333.15; value 35; }
        { T 373.15; value 41; }
        { T 423.15; value 41; }
        { T 473.15; value 45; }
    );
    source "Criss & Cobble, JACS 86 (1964) 5390, Table II";
}
}
transport
{
    //  `radius` is the HYDRATED radius r_H of Nightingale, J. Phys. Chem. 63 (1959) 1381, Table I -- the convention
    //  of every DSPM-DE pore fitted against it -- with its own provenance below.  `D0` is the 25 C limiting
    //  diffusivity read at the page of Li & Gregory 1974 (DEV.md 4c C403; its own provenance below); before: a value
    //  transcribed by machine from a geochemical database.
    radius { value 3.58e-10; unit m; }   // 3.58 A
    D0 { value 1.33e-09; unit m2/s; }
    provenance
    {
        radius
        {
            source        "E. R. Nightingale, Jr., Phenomenological Theory of Ion Solvation. Effective Radii of Hydrated Ions, J. Phys. Chem. 63 (1959) 1381-1387, doi:10.1021/j150579a011, Table I (p. 1383), row Na+, column r_H at 25 C: 3.58 A";
            origin        literature;
            method        "read back against the primary page (Table I, the effective hydrated radius r_H) on 2026-10-25 (DEV.md 4c C161): the stored value matches it to the digit";
            reviewStatus  interim;
            notes         "The tier's radius convention: Nightingale's hydrated radius, the one DSPM-DE pores are fitted on -- not a Stokes radius from D0 (his r_s column is a different quantity).";
        }
        //  Cross-check, entering no value: the CRC Handbook of Chemistry and Physics, 82nd ed., table
        //  'Ionic Conductivity and Diffusion at Infinite Dilution' (PDF pp. 304-306 of the folder copy), read at its page
        //  as a second opinion on this ion at 25 C; it is a compilation and is not this value's origin.
        D0
        {
            source        "Y.-H. Li and S. Gregory, Diffusion of ions in sea water and in deep-sea sediments, Geochim. Cosmochim. Acta 38 (1974) 703-714, Table 1 (p. 705: tracer and self-diffusion coefficients of ions at infinite dilution, 10^-6 cm2/s at 0, 18 and 25 C), row Na+, column 25 C: 13.3 x 10^-6 cm2/s";
            origin        literature;
            method        "read at the page, 2026-11-15 (DEV.md 4c C403): the scan's text layer of this table is garbled, so the row was read from the page image; the 25 C entry converted (1 x 10^-6 cm2/s = 1 x 10^-10 m2/s) to 1.33e-09 m2/s";
            reviewStatus  interim;
            notes         "Li & Gregory give, for the same row, 0 C 6.27 x 1e-10 m2/s; 18 C 11.3 x 1e-10 m2/s; 25 C 13.3 x 1e-10 m2/s (kept here for the later check of the Stokes-Einstein correction to the run temperature, thermo/transport/StokesEinstein.H, which is applied by the consumer). A second compiled table (named in the comment above) gives 1.334e-09 m2/s for this ion at 25 C (+0.3 %).";
        }
    }
}

volumetric
{
    //  STANDARD-STATE (infinite-dilution) partial molar volume,
    //  CONVENTIONAL scale V0(H+) = 0 (see the convention profile:
    //  only electroneutral sums are physical).
    V0          { value -1.21; unit cm3/mol; }
    convention  MilleroConventional-v1;
    Trange      ( 293 303 );   // 25 C table; +-5 K working band, extrapolation announced by the consumer's domain refusals
    source      "Millero, Chem. Rev. 71 (1971) 147, Table III (Conventional Partial Molal Volumes of Ions in Water at 0, 25 and 50 degC), 25 degC block, p. 162 -- PRIMARY PAGE READ 2026-08-24 (delegated review, docs/design/interim-review-2026-08-24.md).  Millero states the table is itself taken from the compilation of his ref 81";
}
