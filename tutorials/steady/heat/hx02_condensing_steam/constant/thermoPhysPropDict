/*---------------------------------------------------------------------------*\
  thermoPhysPropDict (v2) -- pure water, IF97.
  One component; IF97 prices both phases and the saturation curve, so the
  latent heat the outlet carries is the steam tables', not a correlation's.
\*---------------------------------------------------------------------------*/

recordType    thermophysicalPropertySystem;
schemaVersion 2;

components       ( water );

equilibrium
{
    formulation gammaPhi;

    liquid
    {
        activityModel ideal;
        standardState pureLiquid;
    }

    vapour
    {
        fugacityModel idealGas;
    }
}

pureFluids
{
    water { method IF97; }
}
