/*---------------------------------------------------------------------------*\
  thermoPhysPropDict (v2) -- water + N2 (the dry-air carrier).  The tower
  reads, per component and by name if absent: water's vapour pressure
  (saturation curve), liquid Cp (water-side sensible heat), ideal-gas Cp
  (vapour humid heat) and latent heat; N2's ideal-gas Cp (dry humid heat).
\*---------------------------------------------------------------------------*/

recordType    thermophysicalPropertySystem;
schemaVersion 2;

components    ( water  N2 );

equilibrium
{
    formulation gammaPhi;
    liquid  { activityModel ideal;  standardState pureLiquid; }
    vapour  { fugacityModel idealGas; }
}
