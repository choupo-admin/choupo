/*---------------------------------------------------------------------------*\
  thermoPhysPropDict (v2) -- single synthetic teaching fluid, ideal.
  hxFluid is a case-local SYNTHETIC component (constant liquid cp) so
  the pinch targets are hand-checkable; see constant/components/.
\*---------------------------------------------------------------------------*/

recordType    thermophysicalPropertySystem;
schemaVersion 2;

components       ( hxFluid );

equilibrium
{
    formulation gammaPhi;

    liquid
    {
        activityModel ideal;
        standardState pureLiquid;
    }

    vapour
    {
        fugacityModel idealGas;
    }
}
