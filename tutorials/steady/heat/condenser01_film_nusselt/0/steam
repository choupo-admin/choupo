/*--- Choupo stream state.  Every DIMENSIONAL value carries its unit; the parser converts to SI.
     componentMolarFlows is the OVERALL material (all phases); a phases{} block, when present,
     is a decomposition that sums back to it exactly. ---*/

componentMolarFlows
{
    water    100 kmol/h;
}

T               372.76 K;
P               100000 Pa;
//  Saturated vapour, DECLARED.  372.76 K is IAPWS-IF97's Tsat(1 bar) =
//  372.756 K, the curve the film model and (DEV.md C39) the package's
//  K-values both read.  On the curve the side is the last digits of T; the
//  word, not those digits, says which side of the dome it is on.
phase           gas;
