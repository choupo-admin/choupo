/*---------------------------------------------------------------------------*\
  plog01 -- a PLOG table with ONE pressure line.  Below the lowest and above the highest
  tabulated pressure k is that end's value (no extrapolation; Cantera 3.2.0 the same), so a
  one-line table is a plain modified Arrhenius at every P.  Here P = 3 bar lies ABOVE the
  single line, written at 1 atm.
  Reference: elementary01a (modifiedArrhenius, the same ODE).  Hand value at P = 3 bar, 900 K:
    A_eq = 1.2e7 * 1e-6 * 900^1.5 = 324000 m3/mol/s, Ea = 125520 J/mol, k = 0.016814971049578225 m3/mol/s,
    r = k c^2, c = P/(R T) = 40.0907850149809 mol/m3 (constant along the isobaric bed).
  The outlet and the reported k_isom must equal elementary01a's to 1e-9 (bin/curate/check_plog.py).
\*---------------------------------------------------------------------------*/

isom
{
    stoichiometry
    (
        { component nButane;    nu -1;  order 2; }
        { component isoButane;  nu  1;  order 0; }
    );
    kinetics
    {
        type   plog;
        plog
        (
            { P 1 atm; A 1.2e7; b 1.5; Ea 30.0; }
        );
        units  { A "cm3/mol/s"; Ea "kcal/mol"; }
    }
}
