/*---------------------------------------------------------------------------*\
  thermoPhysPropDict (v2) -- ideal gamma-phi, IDEAL GAS declared.
  At 50 bar that is an approximation, and it is the one both reactors share:
  every equilibriumReactor Kp is on the ideal-gas rung, so a real equation of
  state here would make the Gibbs reactor and the declared list answer two
  different questions.
\*---------------------------------------------------------------------------*/

recordType    thermophysicalPropertySystem;
schemaVersion 2;

components       ( CO  H2  methanol  water  CO2  CH4 );

equilibrium
{
    formulation gammaPhi;

    liquid
    {
        activityModel ideal;
        standardState pureLiquid;
    }

    vapour
    {
        fugacityModel idealGas;
    }
}
