/*---------------------------------------------------------------------------*\
  Reaction library for the methanol synthesis gas.  Stoichiometry only: each
  Kp(T) comes from the species' standardThermochemistry (K = exp(-dG/RT)).
  Balanced by atom count (C, H, O):
      methanolSynthesis   CO + 2 H2   <->  CH3OH        C 1=1  H 4=4  O 1=1
      waterGasShift       CO + H2O    <->  CO2 + H2     C 1=1  H 2=2  O 2=2
      methanation         CO + 3 H2   <->  CH4 + H2O    C 1=1  H 6=6  O 1=1
  The three are independent (six species, three elements).  Which of them a
  reactor may use is declared by the unit's `reactions ( ... );` list, not
  here: a library entry is a pathway that EXISTS; the list says which ones
  are OPEN.  A reaction entry may also carry `temperatureApproach <dT>;`,
  overriding the unit's global value for that reaction alone (0 exempts it);
  none does here.
\*---------------------------------------------------------------------------*/

methanolSynthesis       // CO + 2 H2 <-> CH3OH
{
    stoichiometry
    (
        { component CO;        nu -1; }
        { component H2;        nu -2; }
        { component methanol;  nu  1; }
    );
}

waterGasShift           // CO + H2O <-> CO2 + H2
{
    stoichiometry
    (
        { component CO;     nu -1; }
        { component water;  nu -1; }
        { component CO2;    nu  1; }
        { component H2;     nu  1; }
    );
}

methanation             // CO + 3 H2 <-> CH4 + H2O
{
    stoichiometry
    (
        { component CO;     nu -1; }
        { component H2;     nu -3; }
        { component CH4;    nu  1; }
        { component water;  nu  1; }
    );
}
