/*--- Choupo stream state.  Every DIMENSIONAL value carries its unit; the parser converts to SI.
     componentMolarFlows is the OVERALL material (all phases); a phases{} block, when present,
     is a decomposition that sums back to it exactly. ---*/

//  Methane and steam at a steam-to-carbon ratio of 1.0.  The composition and
//  the conditions are this case's premise, chosen so that carbon forms at
//  equilibrium (bin/curate/check_gibbs_solid_phase.py recomputes it by an
//  independent route), not a quoted plant specification.
componentMolarFlows
{
    CH4      10.0 kmol/h;
    water    10.0 kmol/h;
}

T               900 K;
P               1 bar;
phase           gas;
