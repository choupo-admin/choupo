/*--- Choupo stream state.  Every DIMENSIONAL value carries its unit; the parser converts to SI.
     componentMolarFlows is the OVERALL material (all phases); a phases{} block, when present,
     is a decomposition that sums back to it exactly. ---*/

//  The water the electrolytic route splits: 4404 kmol/h, which makes the
//  4404 kmol/h of H2 (3 x 1468) its synthesis needs.
//
//  THE STATE IS THE REFERENCE STATE, NOT A PROCESS CONDITION: 298.15 K and
//  0.02 bar, below the vapour pressure of water at 25 C, so every
//  species is the IDEAL GAS its formation datum is written for.  An ideal
//  gas's enthalpy does not depend on pressure, so the heats this unit
//  publishes are the standard ones (water as vapour: the lower-heating-
//  value basis).
componentMolarFlows
{
    water    4404 kmol/h;
}

T               298.15 K;
P               0.02 bar;
phase           gas;
