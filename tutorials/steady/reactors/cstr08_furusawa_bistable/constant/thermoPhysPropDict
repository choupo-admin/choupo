/*---------------------------------------------------------------------------*\
  thermoPhysPropDict (v2) -- an IDEAL liquid (gamma = 1, declared, not
  defaulted).  The consequence is stated in system/flowsheetDict: an ideal
  liquid has no heat of mixing, so the heat released is the pure-liquid
  reaction enthalpy.
\*---------------------------------------------------------------------------*/

recordType    thermophysicalPropertySystem;
schemaVersion 2;

components       ( 12PropyleneOxide  water  methanol  12Propanediol );

equilibrium
{
    formulation gammaPhi;
    liquid
    {
        activityModel ideal;
        standardState pureLiquid;
    }
    vapour
    {
        fugacityModel idealGas;
    }
}
