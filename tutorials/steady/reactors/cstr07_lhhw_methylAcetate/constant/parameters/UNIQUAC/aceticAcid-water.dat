/*---------------------------------------------------------------------------*\
  UNIQUAC binary interaction parameters --- aceticAcid-water
  Delta u_ij(T) = a_ij + b_ij*T + c_ij*T^2  [a in K, b dimensionless, c in K^-1];
  tau_ij = exp(-Delta u_ij / T).  The authors' own set, the one their rate
  constants were regressed with (see constant/thermoPhysPropDict).
\*---------------------------------------------------------------------------*/
components ( aceticAcid water );
model       UNIQUAC;

parameters
{
    i      aceticAcid;
    j      water;
    a_ij   422.38;    a_ji   -98.12;     // K
    b_ij   -0.051007;    b_ji   -0.29355;
    c_ij   -2.4019e-04;    c_ji   -7.6741e-05;
}

provenance
{
    origin     literature;
    citation   "Popken, Gotze & Gmehling, Ind. Eng. Chem. Res. 39 (2000) 2601-2611, Table 3 (p. 2603; UNIQUAC Delta u = a + b T + c T^2, fitted by the authors simultaneously to DDB VLE + gamma-infinity + h^E data, DDB 1998); read from the page image of the paper in the literature folder, 2026-11-21";
}
