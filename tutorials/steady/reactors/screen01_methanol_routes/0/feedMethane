/*--- Choupo stream state.  Every DIMENSIONAL value carries its unit; the parser converts to SI.
     componentMolarFlows is the OVERALL material (all phases); a phases{} block, when present,
     is a decomposition that sums back to it exactly. ---*/

//  Methane and oxygen at the stoichiometric ratio of route C -- methane
//  with PURE oxygen at 50 bar; where this sits against its flammable
//  envelope at the operating T and P is the safety filter's first question.
componentMolarFlows
{
    CH4      2.0 kmol/h;
    O2       1.0 kmol/h;
}

T               525 K;
P               50 bar;
phase           gas;
