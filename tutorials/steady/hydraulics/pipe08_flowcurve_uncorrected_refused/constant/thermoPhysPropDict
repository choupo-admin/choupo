/*  pipe04 -- the property system: the liquid declares its flow curve (door form 3).  */

recordType    thermophysicalPropertySystem;
schemaVersion 1;

components ( polymerSolution );

equilibrium
{
    formulation gammaPhi;
    liquid { activityModel { model ideal; } }
    vapour { fugacityModel idealGas; }
}

transport
{
    liquid
    {
        rheology
        {
            measured
            {
                powerLawEx31
                {
                    use            method;
                    interpolation  logLog;
                    reason         "the flow curve IS this liquid's rheology; Newtonian by absence, declared here because it is not";
                    fit            { model powerLaw; }
                }
            }
        }
    }
}
