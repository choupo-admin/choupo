/*---------------------------------------------------------------------------*\
  flowsheetDict  --  agitation03_shear_thickening_refused

  The agitation01 case with a SHEAR-THICKENING flow curve (a power law with n = 1.3, the case's
  own illustration).  The viscosity is highest at the impeller, where the shear is highest, and
  "the impeller draws enormous power to rotate in this almost solidified material" (Chhabra &
  Richardson, p. 396): the vessel REFUSES by name (R9; `.expect-nonconvergence`).
\*---------------------------------------------------------------------------*/

units
(
    {
        name        M1;
        type        agitatedVessel;
        in          feed;
        outputs     ( stirred );

        operation
        {
            vessel    { D_T 2.2 m; }
            impeller  { record helicalRibbonEx85; tipSpeed 1.0 m/s; }
            thermalMode isothermal;
            outsideCorrelationWindow
            {
                reason "the book's own Example 8.5 takes H/D = 1.5, past the 0.88-1.30 of the 148 configurations eq. 8.7 was fitted to (p. 386, 417); reproduced as printed";
            }
        }
    }
);
