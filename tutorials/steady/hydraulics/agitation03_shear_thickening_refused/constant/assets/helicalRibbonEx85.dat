/*---------------------------------------------------------------------------*\
  constant/assets/helicalRibbonEx85.dat -- the helical ribbon impeller of Chhabra & Richardson
  Example 8.5 (p. 417), as an impeller ASSET RECORD (kind impeller; R7).

  What is a fact of THE IMPELLER lives here: its geometry as ratios (the source's), the
  Metzner-Otto constant with its stated uncertainty, the laminar power constant (by the
  correlation of eq. 8.7, which reads the geometry) and where the laminar line ends.  The
  fluid's flow curve is not here (the property dictionary), and no speed is (the unit).
\*---------------------------------------------------------------------------*/

name      helicalRibbonEx85;
kind      impeller;
type      helicalRibbon;

provenance
{
    origin    literature;
    citation  "Chhabra, R. P. and Richardson, J. F. (2008). Non-Newtonian Flow and Applied Rheology, 2nd ed., Butterworth-Heinemann. Example 8.5, p. 417-418; eq. 8.7 (Delaplace & Leuliet 2000), p. 386; eq. 8.24, p. 417";
    basis     "the geometry and the Metzner-Otto constant the example states for its plant ribbon";
}

geometry
{
    Nr             2;          // number of ribbons
    clearanceRatio 0.05;       // (D_T - D)/D
    W_over_D       0.08;       // ribbon width / diameter
    s_over_D       1.0;        // pitch / diameter
    H_over_D       1.5;        // liquid height / diameter
}

shearConstant
{
    ks           30;           // gamma_avg = k_s N (eq. 8.9, p. 391): "given to be 30 for this geometry"
    uncertainty  0.275;        // "not uncommon for k_s to have an uncertainty of +-25-30 %" (p. 395): the middle of the stated range
    source       "Example 8.5, p. 417 (given); uncertainty p. 395";
}

laminarPower
{
    Kp             correlation;        // Po Re = K_p; K_p from eq. 8.7 at this geometry
    correlation    helicalRibbon87;
    KpUncertainty  0.20;               // "a maximum error of +-20 %" of eq. 8.7 for viscous Newtonian liquids (p. 386)
    ReCritical     { a 183; b -0.3333333; source "eq. 8.24, p. 417: Re_cr = 183 / Po^(1/3), the end of the laminar flow"; }
}
