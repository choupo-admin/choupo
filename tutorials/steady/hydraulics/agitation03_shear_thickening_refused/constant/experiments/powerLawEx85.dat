/*---------------------------------------------------------------------------*\
  constant/experiments/powerLawEx85.dat -- the flow curve of polymerMelt, as the case's experiment record

  An experiment record of kind FLOW CURVE (docs/design/measured-facts-materials-and-flow-curves.md,
  R1-R10).  These rows are NOT readings: the source prints the parameters of a constitutive
  equation and no rows, so the rows are the equation evaluated at the shear rates below
  (`instrument model`, `kind adopted`): the source's own numbers, nothing added.
\*---------------------------------------------------------------------------*/

provenance
{
    //  sha256 is of the `data ( );` block of THIS file as written: it tells these rows from an edited copy.
    sha256       "5dbd2635995d489550b61d91eb12891e6a199b0a0930179b18bd612e4b6c2ec1";
    origin       literature;
    kind         adopted;
    basis        "the power-law parameters printed in Example 8.5 (m = 200 Pa s^n, n = 1.3 (a shear-thickening illustration of the case's own)); rows generated from tau = m gamma^n";
    citation     "Chhabra, R. P. and Richardson, J. F. (2008). Non-Newtonian Flow and Applied Rheology, 2nd ed., Butterworth-Heinemann. Example 8.5, p. 417-418 (power law, eq. 1.12, p. 9)";
}

property    flowCurve;
system      ( polymerMelt );

conditions
{
    instrument   model;
    model        "tau = m gamma^n, m = 200 Pa s^n, n = 1.3 (a shear-thickening illustration of the case's own) (Chhabra & Richardson eq. 1.12; Example 8.5, p. 417)";
    T            450 K;      // the source states no temperature: the case's nominal one
}

columns
(
    { name gamma; unit 1/s; }
    { name tau;   unit Pa;  }
);
data
(
    0.01       0.502377286
    0.1        10.0237447
    1          200
    10         3990.52463
    100        79621.4341
    1000       1588656.47
);
