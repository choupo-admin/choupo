/*---------------------------------------------------------------------------*\
  thermoPhysPropDict (v2) -- nitrogen as an ideal gas, with the transport
  surface the gas line needs: the vapour density (ideal gas, Z = 1) and the
  gas viscosity (Chung, from Tc / Pc / omega).  The pipe types neither.
\*---------------------------------------------------------------------------*/

recordType    thermophysicalPropertySystem;
schemaVersion 1;

components ( N2 );

equilibrium
{
    formulation gammaPhi;

    liquid
    {
        activityModel ideal;
        standardState pureLiquid;
    }

    vapour
    {
        fugacityModel idealGas;
    }
}

transport
{
    vapour
    {
        viscosity { model Chung; }
    }
}
