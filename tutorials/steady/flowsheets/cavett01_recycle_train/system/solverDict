/*---------------------------------------------------------------------------*\
  solverDict -- the numerical strategy, which on THIS flowsheet is the whole
  point.  On the primary Rosen-Pauls conditions the 1963 pathology DEFEATS
  Wegstein per-component acceleration outright: 300 iterations limit-cycling
  at |dtear| ~ 1.4e-2, exit 1, no converged/ (the contract as ratified).
  Newton on the same two torn mixer outlets: 7 iterations to 4e-9.  Swap
  `recycleSolver Wegstein;` back in to watch the defeat -- the case is the
  measurement, not the anecdote.
\*---------------------------------------------------------------------------*/

tearStreams      ( mixed2  mixed3 );
recycleSolver    Newton;
recycleTol       1e-6;
recycleMaxIter   300;
