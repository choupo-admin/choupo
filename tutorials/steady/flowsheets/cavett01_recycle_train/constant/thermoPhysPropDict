/*---------------------------------------------------------------------------*\
  thermoPhysPropDict (v2) -- phi-phi SRK for the Cavett recycle train.

  One cubic for both phases (K_i = phi_L,i / phi_V,i at the two roots), the
  same declared world as flash09.  All binary interaction parameters are at
  their vdW-one-fluid default k_ij = 0: this case's subject is the RECYCLE
  TOPOLOGY and its convergence, not the mixture thermodynamics, and a
  16-component hydrocarbon set at k_ij = 0 is the standard undressed cubic.
  (The N2-CH4 pair in the catalogue could dress one of the 120 pairs; adding
  one measured pair to an otherwise bare matrix would be noise wearing a
  citation, so none is declared.)

  C256 (2026-11-09), MEASURED: N2 (Tc 126.2 K) and CH4 (190.6 K) have their
  vapour pressures consulted above Tc at 298 K, outside the equilibrium: every
  K this train prints is phi_L/phi_V of the one SRK, so no printed number
  depends on that vapour pressure.
\*---------------------------------------------------------------------------*/

recordType    thermophysicalPropertySystem;
schemaVersion 2;

components ( N2 CO2 H2S CH4 ethane propane isoButane nButane
             isopentane nPentane nHexane nHeptane nOctane nNonane
             nDecane nUndecane );

equilibrium
{
    formulation phiPhi;

    equationOfState
    {
        model      SRK;
        mixingRule vanDerWaalsOneFluid;
    }

    liquid { fugacityRoute equationOfState; root liquid; }
    vapour { fugacityRoute equationOfState; root vapour; }
}

caloric
{
    energyBasis elementsDatum;
    liquid { departureRoute equilibriumEquationOfState; root liquid; }
    vapour { departureRoute equilibriumEquationOfState; root vapour; }
}
