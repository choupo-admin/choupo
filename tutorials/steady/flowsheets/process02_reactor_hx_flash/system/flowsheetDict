/*---------------------------------------------------------------------------*\
  Three-unit flowsheet — physically realistic operation:

       feed (350 K)                       hotStream (~359 K, 0.9 % vap)
           │              reactorOut          │
           ▼     CSTR     350 K, X=52%        ▼      flash
       [reactor] ────► [heater] ────► [separator] ──┬─► vapProd
                                                    └─► liqProd

  The flash inherits T from its input stream (no explicit operation.T)
  — propagation through the flowsheet.
\*---------------------------------------------------------------------------*/

// stream state lives on disk in 0/ (per-stream files); flowsheetDict is TOPOLOGY only

units
(
    {
        name        reactor;
        type        cstr;
        in          feed;
        outputs     ( reactorOut );

        operation   { V_R 0.005; }
        reaction    esterification_etac;
    }

    {
        name        heater;
        type        heater;
        in          reactorOut;
        outputs     ( hotStream );

        // Credo-pure: hardware = Q.  T_out is a RESULT.  With reactorOut
        // at ~350 K and F ~ 1 kmol/h, Q = 1.0 kW carries the stream past
        // its BUBBLE POINT: the temperature rises through the sensible
        // part and then slows while the rest of the duty vaporises 5.3 %
        // of the stream (hotStream 363.64 K, vf 0.053).  That is the whole
        // point of specifying Q rather than T_out -- the outlet state,
        // temperature AND vapour fraction, is what the first law says it is.
        // Until 2026-08-09 this unit inverted Q on a sensible Cp relation
        // and reported a single-phase outlet that really cost 8x the
        // declared duty (827 % energy closure); the fix is recorded in
        // docs/design/tp-stream-energy-coherence.md.  2026-11-03: the duty
        // was 0.40 kW, which reached the bubble point at ~359 K.  With the
        // acetic-acid vapour now ASSOCIATED (docs/design/
        // acetic-acid-latent-heat-closure.md) the bubble point of this
        // mixture sits higher, 0.40 kW leaves the stream a liquid at
        // 361.95 K, and check_duty_inversion needs an outlet that crosses
        // the dome -- so the duty is 1.0 kW, which does.  If the design
        // required a specific T_out, a DesignSpec on $Q with target
        // hotStream.T would replace this.
        operation   { Q  1.0 kW; }
    }

    {
        name        separator;
        type        isothermalFlash;
        in          hotStream;
        outputs     ( liqProd  vapProd );

        operation   { P 1.0 bar; }           // no T → inherits ~359 K from hotStream
    }
);
