/*  Sector B: the plant's dictionary, with water's liquid viscosity pinned to
    the table `crcWaterMu` -- read from THIS sector's constant/experiments/
    (six points, every second of the handbook's), never from the plant's.  */

recordType    thermophysicalPropertySystem;
schemaVersion 1;

inherits      "../../../constant";

transport
{
    liquid
    {
        viscosity
        {
            pin ( { component water;  table crcWaterMu;  interpolation logReciprocal;
                    reason "this sector's own table (the same pin text in both sectors)"; } );
        }
    }
}
