/*  table05 -- the PLANT's property dictionary.  Water, an ideal liquid; the
    liquid viscosity on the record's preferred law.  Each sector inherits this
    dictionary and pins its own table (sectors/<S>/constant/thermoPhysPropDict).
    This dictionary pins nothing, so constant/experiments/crcWaterMu.dat here
    (a decoy) is cited by no entry and read by no package.  */

recordType    thermophysicalPropertySystem;
schemaVersion 1;

components ( water );

equilibrium
{
    formulation gammaPhi;
    liquid { activityModel { model ideal; } }
    vapour { fugacityModel idealGas; }
}

transport
{
    liquid
    {
        viscosity { }      // no word: the record's preferred law (vogel)
    }
}
