/*  Luyben Figure 1, stream Rin: 57.83 kmol/h at 389 K and 2.6 atm.  The
    component split is derived from his Rout in the flowsheetDict header and
    closes on his own total to 0.02 %.                                        */

/*  PHASE DECLARED (2026-09-25).  This file used to say only (T, P, z), and an
    unpinned state MEANS its own equilibrium -- so `vf` resolved to the liquid
    leg and the energy report priced a 389 K vapour feed as a liquid.  Nothing
    in the case contradicted it, which is why it survived: an ABSENCE gives a
    reader no second number to compare.  Declaring the phase is what the
    author plainly meant, and it restores this case's own shipped duties.   */

T     389 K;
P     2.6 atm;
phase gas;

componentMolarFlows
{
    isopropanol  38.63 kmol/h;
    acetone       0.0  kmol/h;
    H2            0.0  kmol/h;
    water        19.19 kmol/h;
}
