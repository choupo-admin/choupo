isothermalFlash
{
    tolerance           1e-8;
    maxIter             50;
    compositionTol      1e-6;
    maxOuterIter        50;
}

// ---- Recycle plan: the tear CUTS + the outer solver (numerical
//      strategy -- the topology stays in flowsheetDict) ----
tearStreams           ( recycle );
recycleSolver          Newton;        // Newton on the tear variables (default);
recycleTol             1e-5;
recycleMaxIter         120;
//  Wegstein acceleration bounds -- COMMENTED because this case runs
//  `recycleSolver Newton;`, so the Wegstein branch is never entered
//  and these were read by nothing.  Uncomment them together with
//  `recycleSolver Wegstein;` to use them.
// recycleWegsteinQmin    0.0;
// recycleWegsteinQmax    0.0;
