/*---------------------------------------------------------------------------*\
  thermoPhysPropDict (v2) -- T1 ideal gamma-phi mixture over an SRK vapour,
  the package of gibbs10_ammonia_fugacity with argon added: at 150 bar the
  fugacity correction to the ammonia equilibrium matters, and a staged
  converter's recycle gas carries an inert.  Raoult DECLARED, not defaulted
  (gamma = 1 identically); no liquid forms in this case.

  C256 (2026-11-09), MEASURED: N2, H2, NH3 and Ar are priced above their
  critical temperatures in this run (Psat continued past Tc), but every stream
  is one gas phase (vf = 1) and no K of theirs is printed, so no printed
  number depends on that K.
\*---------------------------------------------------------------------------*/

recordType    thermophysicalPropertySystem;
schemaVersion 2;

components       ( N2  H2  NH3  Ar );

equilibrium
{
    formulation gammaPhi;

    liquid
    {
        activityModel ideal;
        standardState pureLiquid;
    }

    vapour
    {
        fugacityModel SRK;
    }
}
