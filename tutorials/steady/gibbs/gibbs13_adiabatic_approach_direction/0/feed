/*--- Choupo stream state.  Every DIMENSIONAL value carries its unit; the parser converts to SI.
     componentMolarFlows is the OVERALL material (all phases); a phases{} block, when present,
     is a decomposition that sums back to it exactly. ---*/

//  The third bed's inlet: two beds' worth of ammonia already made, 415 C,
//  150 bar.  The composition is AUTHOR-SET to be representative of a staged
//  converter's last bed (N2:H2 = 1:3, 16 % NH3, 8 % argon); it is not a
//  plant measurement.

componentMolarFlows
{
    N2    1900 kmol/h;
    H2    5700 kmol/h;
    NH3   1600 kmol/h;
    Ar     800 kmol/h;
}

T               688.15 K;
P               15000000 Pa;
phase           gas;
