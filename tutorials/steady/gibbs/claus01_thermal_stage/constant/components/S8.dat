/*--------------------------------*- Choupo -*-----------------------*\
  Component: S8 (from NASA TM-4513)
  Generated by bin/import_nasa.py from NASA-7 polynomial data
  (NASA TM-4513, McBride, Gordon & Reno 1993 -- a US government work, PUBLIC DOMAIN; read from cantera's bundled nasa_gas.yaml).  No liquid phase at process conditions ---
  the entry is tagged `role nonvolatile;` so vapour-pressure routines
  never get called.  dHf_298 and s_298 from NASA-7 integration
  constants at T = 298.15 K.
\*---------------------------------------------------------------------------*/

name           S8;
formula        S8;
CAS            n/a;

MW             256.48;       // kg/kmol
role           nonvolatile;

standardThermochemistry
{
    dHf_298    100419.4277;            // J/mol  -- ideal-gas reference
    s_298      430.3169;           // J/(mol·K)  -- third-law absolute
}

idealGasHeatCapacity
{
    model         polynomial;
    coefficients  (1.171107e+02   1.785877e-01   -1.670957e-04   5.154799e-08);
    //  the window IS the fit's range -- see fit_cp_poly3
    Trange        (250  1500);
}
