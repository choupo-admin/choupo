// [imported] origin "data/standards/chemistry/H2Saq-formation.dat" (Choupo-2607 release) -- owned + sha256-verified by constant/propertyManifest
recordType aqueousSpeciation;
schemaVersion 1;

// Dissolved hydrogen sulfide, the FIRST ionisation written in the
// catalogue's formation convention:  HS- + H+ = H2S(aq),
// pKa1 = 6.994 at 25 C (PHREEQC phreeqc.dat: H2S = H+ + HS-,
// log_k -6.994, delta_h +5.3 kcal dissociation -> formation dH -22175
// J/mol).  The name carries the interim `aq` suffix: the component H2S
// exists, and a derived neutral homonymous with a component must be
// lexically disambiguated while record references are bare strings.
species H2Saq; ion "H2S"; z 0; masters ( { ion HS; nu 1; } { ion H; nu 1; } );
      logK25 6.994; dH -22175; source "USGS PHREEQC phreeqc.dat (public domain): H2S = H+ + HS-, log_k -6.994, delta_h 5.3 kcal";
