/*---------------------------------------------------------------------------*\
  A furnace at 1.5 bar and well over 1000 K is an ideal gas and nothing else:
  there is no liquid in this unit, so the liquid slot is declared for the
  grammar's sake and never evaluated.
\*---------------------------------------------------------------------------*/

recordType    thermophysicalPropertySystem;
schemaVersion 2;

components ( H2S SO2 water CO2 CO N2 O2 H2 S2 S8 S SO carbonylSulfide CS2 );

equilibrium
{
    formulation gammaPhi;

    liquid
    {
        activityModel ideal;
        standardState pureLiquid;
    }

    vapour
    {
        fugacityModel idealGas;
    }
}
