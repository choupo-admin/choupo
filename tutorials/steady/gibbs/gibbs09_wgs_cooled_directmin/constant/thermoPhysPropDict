/*---------------------------------------------------------------------------*\
  thermoPhysPropDict (v2) -- the dilute-solution (Henry) world (since C256; it
  was the T1 ideal gamma-phi mixture).
  Raoult DECLARED, not defaulted (gamma = 1 identically).
  Migrated mechanically from the v1 flat form (physics identical);
  v2 contract 2026-07-17.
  WHY HENRY (C256, 2026-11-09).  CO (Tc 132.9 K), CO2 (304.1 K) and H2
  (33.2 K) are above their critical temperatures at 350 K, and the cooled
  reactor condenses water: the dissolved gas in that condensate was priced
  through a vapour pressure continued past Tc (K's that are not K's; slice
  5a moved the dissolved H2 of gibbs09 by +136 % between two of them).  The
  catalogue carries all three pairs with water (Sander 2015), so they are
  Henry solutes and the water the solvent.
  WHAT THE DECLARATION REACHES, MEASURED: the two-phase FEED's resolution,
  which prices the dissolved gas on these pairs.  The Gibbs reactor's OWN
  condensate does not: it condenses by y_i P against Psat_i (an engine gap
  reported under C256), so the gas it leaves in the condensate still rests
  on the continued vapour pressure.
\*---------------------------------------------------------------------------*/

recordType    thermophysicalPropertySystem;
schemaVersion 2;

components       ( CO  water  CO2  H2 );

equilibrium
{
    formulation diluteSolution;

    liquid
    {
        solvent
        {
            component     water;
            standardState pureLiquid;          // the Raoult rung
        }
        solutes
        {
            components    ( CO  CO2  H2 );
            standardState infiniteDilution;    // the Henry rung
            solutionModel henryDilute;
            binaryParameters
            {
                // Sander (2015) compilation, CC-BY
                CO-water { source "data/standards/parameters/Henry/CO-water.dat"; }
                CO2-water { source "data/standards/parameters/Henry/CO2-water.dat"; }
                H2-water { source "data/standards/parameters/Henry/H2-water.dat"; }
            }
        }
    }

    vapour
    {
        fugacityModel idealGas;
    }
}
