/*---------------------------------------------------------------------------*\
  thermoPhysPropDict (v2) -- gibbs02's package (ideal gas, ideal liquid),
  plus graphite.  Graphite's record says `referenceState pureSolid;`: it
  never enters the vapour or the liquid mixture, and the Gibbs reactor
  gives it a phase of its own.
\*---------------------------------------------------------------------------*/

recordType    thermophysicalPropertySystem;
schemaVersion 2;

components       ( CH4  water  CO  CO2  H2  graphite );

equilibrium
{
    formulation gammaPhi;

    liquid
    {
        activityModel ideal;
        standardState pureLiquid;
    }

    vapour
    {
        fugacityModel idealGas;
    }
}
