/*---------------------------------------------------------------------------*\
  thermoPhysPropDict (v2) -- ideal gamma-phi, IDEAL GAS declared: the
  package each of the three source cases uses (gibbs01, gibbs11, equil03).
  Each reactor's own `species` list picks its subset.
  Graphite's record says `referenceState pureSolid;`: it never enters the
  vapour or the liquid mixture, and the Gibbs reactor gives it a phase of
  its own.
\*---------------------------------------------------------------------------*/

recordType    thermophysicalPropertySystem;
schemaVersion 2;

components       ( CO  water  CO2  H2  CH4  graphite  NH3  O2  N2  NO );

equilibrium
{
    formulation gammaPhi;

    liquid
    {
        activityModel ideal;
        standardState pureLiquid;
    }

    vapour
    {
        fugacityModel idealGas;
    }
}
