     componentMolarFlows is the OVERALL material (all phases); a phases{} block, when present,
     is a decomposition that sums back to it exactly. ---*/

//  equil03's feed: 10 kmol/h of NH3 in 90 kmol/h of air taken as 21 % O2
//  and 79 % N2 -- that case's premise, not a plant specification.
componentMolarFlows
{
    NH3      10.0 kmol/h;
    O2       18.9 kmol/h;
    N2       71.1 kmol/h;
}

T               700 K;
P               5 bar;
phase           gas;
