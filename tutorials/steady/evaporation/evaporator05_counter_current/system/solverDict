/*---------------------------------------------------------------------------*\
  solverDict  --  numerical strategy: the recycle plan (tear cuts + solver)
                  and per-unit-op-type solver options
\*---------------------------------------------------------------------------*/

// ---- Recycle plan: the tear CUTS + the outer solver (numerical
//      strategy -- the topology stays in flowsheetDict) ----
tearStreams            ( V1 V2 );
recycleSolver          Wegstein;   // this case is tuned for damped Wegstein
recycleTol             1.0e-5;
recycleMaxIter        120;
recycleWegsteinQmin   -0.7;        // strong damping; counter-current
recycleWegsteinQmax    0.0;        //   recycles can over-shoot.
