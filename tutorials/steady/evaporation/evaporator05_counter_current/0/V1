/*--- Choupo stream state.  Every DIMENSIONAL value carries its unit; the parser converts to SI.
     componentMolarFlows is the OVERALL material (all phases); a phases{} block, when present,
     is a decomposition that sums back to it exactly. ---*/

componentMolarFlows
{
    agua    61.2 kmol/h;
}

T               375 K;
P               100000 Pa;

// generated by choupo-init0 -- an initial ESTIMATE propagated from the authored inlets;
// the solver overwrites it.  Edit freely; choupo-init0 never overwrites without --force.

//  A TEAR SEED IS AN INLET ON THE FIRST PASS, SO IT MUST DECLARE ITS PHASE.
//  This train is COUNTER-CURRENT: the units are declared in liquid-flow order
//  (cold -> hot), so each effect's heating vapour is produced by a unit that
//  runs LATER and `V1` is a declared tear.  On the first Wegstein pass the
//  chest of the effect that consumes it is read from THIS FILE -- and a state
//  file that gives only (T, P) is read as LIQUID, which is not a vapour chest
//  at all.  The evaporator refuses that since 2026-09-12; before it did, the
//  loop simply started from a chest carrying no latent heat and said nothing.
//  Record: docs/design/the-word-that-was-not-there.md
phase           gas;
