/*---------------------------------------------------------------------------*\
  thickener01_settlingTest_talmageFitch / flowsheetDict

  One thickener.  The batch settling test is the slurry's own measurement
  and lives with the unit; the lists are in SI (s, m) because a list does
  not carry a unit word.
\*---------------------------------------------------------------------------*/

units
(
    {
        name        thickener;
        type        thickener;
        model       talmageFitch;
        in          feed;
        outputs     ( underflow overflow );
        operation
        {
            settlingTest
            {
                //  Geankoplis Problem 30.1-11, p. 1451: "The original slurry
                //  concentration is 250 kg/m3 of slurry."
                initialConcentration    250 kg/m3;
                //  t in hours as printed: 0 0.50 1.00 1.75 3.00 5.00 12.0 20.0
                time    ( 0  1800  3600  6300  10800  18000  43200  72000 );   // s
                height  ( 0.360  0.285  0.211  0.150  0.125  0.113  0.102  0.090 );  // m
            }
            //  The end of the steep part of the curve, read off the data by
            //  eye (1.75 h): the student's choice, drawn by the unit.
            compressionTime         1.75 h;
            //  The target, declared: H_u = 250 x 0.360 / 700 = 0.1286 m lies
            //  inside the test (its last reading is 0.090 m, 1000 kg/m3).
            underflowConcentration  700 kg/m3;
        }
    }
);
