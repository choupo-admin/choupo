/*--- Choupo stream state.  Every DIMENSIONAL value carries its unit; the parser converts to SI.
     componentMolarFlows is the OVERALL material (all phases); a phases{} block, when present,
     is a decomposition that sums back to it exactly. ---*/

//  The cycle-averaged feed of one press on Geankoplis's cycle (Examples
//  24.2-2 and 24.2-3): 3.37 m3 of filtrate every 27.73 min = 2.02548e-3 m3/s
//  at 996.9 kg/m3; c_S = 23.47 kg solids per m3 of filtrate -> 0.0475381
//  kg/s of CaCO3; the cake keeps (m - 1) = 1 kg of water per kg of solids, so
//  the slurry brings 2.019205 + 0.047538 = 2.066743 kg/s of water (c_x =
//  0.022484).  No size distribution: the law reads bulk properties only.

componentMolarFlows
{
    CaCO3       1.7098859 kmol/h;
    water     413.0044172 kmol/h;
}

T               298.2 K;
P               101325 Pa;

phases
{
    liquid
    {
        componentMolarFlows
        {
            water     413.0044172 kmol/h;
        }
    }
    solid
    {
        componentMolarFlows
        {
            CaCO3       1.7098859 kmol/h;
        }
    }
}
