/*---------------------------------------------------------------------------*\
  splitter01_slurry_sizeDistribution / thermoPhysPropDict

  Calcite in water, ideal.  A splitter reads no property; the solid is the
  carrier of the size distribution and nothing more.
\*---------------------------------------------------------------------------*/

recordType    thermophysicalPropertySystem;
schemaVersion 1;

components ( CaCO3 water );

equilibrium
{
    formulation gammaPhi;
    liquid  { activityModel ideal; standardState pureLiquid; }
    vapour  { fugacityModel idealGas; }
}
