/*---------------------------------------------------------------------------*\
  filter05_calciumSilicate_measuredTest / thermoPhysPropDict

  A case-local pseudo-solid (constant/components/calciumSilicateParticles.dat,
  the test's 1950 kg/m3) in water.  The filter reads the filtrate's viscosity
  and density from here: Vogel's law from water's record (8.89e-4 Pa s at
  298.2 K) and water's Vliq.  The cake's RESISTANCE is not here: it is the
  sample's (constant/experiments/).
\*-----------------------------------------------------------------------------*/

recordType    thermophysicalPropertySystem;
schemaVersion 1;

components ( calciumSilicateParticles water );

equilibrium
{
    formulation gammaPhi;
    liquid  { activityModel ideal; standardState pureLiquid; }
    vapour  { fugacityModel idealGas; }
}

transport
{
    liquid
    {
        viscosity { model Vogel; }
    }
}
