/*---------------------------------------------------------------------------*\
  psd01_grid_and_moments / thermoPhysPropDict

  Two calcite powders, dry; no fluid flows.
  CaCO3 (calcite) carries a solid formation datum and a solid heat capacity
  (Robie & Hemingway 1995), so the temperature rise the shaft work causes is
\*---------------------------------------------------------------------------*/

recordType    thermophysicalPropertySystem;
schemaVersion 2;

components ( CaCO3 );

equilibrium
{
    formulation gammaPhi;
    liquid  { activityModel ideal; standardState pureLiquid; }
    vapour  { fugacityModel idealGas; }
}
