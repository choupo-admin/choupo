/*---------------------------------------------------------------------------*\
  centrifuge01_tubularBowl_geankoplis / thermoPhysPropDict

  Two case-local pseudo-components, in this case's constant/components/: the
  example names neither its liquid nor its particles: a liquid of 801 kg/m3
  and 0.100 Pa s, particles of 1461 kg/m3.  The centrifuge reads the
  liquid's density and viscosity from this package (Andrade with B = 0: a
  constant viscosity) and the particles' rho_p from their record.
\*---------------------------------------------------------------------------*/

recordType    thermophysicalPropertySystem;
schemaVersion 2;

components ( suspendedParticles viscousSolution );

equilibrium
{
    formulation gammaPhi;
    liquid  { activityModel ideal; standardState pureLiquid; }
    vapour  { fugacityModel idealGas; }
}

transport
{
    liquid
    {
        viscosity { model Andrade; }
    }
}
