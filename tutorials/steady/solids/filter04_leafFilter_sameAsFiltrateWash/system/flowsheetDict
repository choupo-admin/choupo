/*---------------------------------------------------------------------------*\
  filter04_leafFilter_sameAsFiltrateWash / flowsheetDict

  One leaf filter (filter02's press, washed along the filtrate's path), two
  inlets (the slurry, the wash water), three outlets (the washed cake, the
  filtrate, the spent wash).
\*---------------------------------------------------------------------------*/

units
(
    {
        name        leaf;
        type        cakeFilter;
        model       batchPress;
        inputs      ( slurry washWater );
        outputs     ( cake filtrate spentWash );
        operation
        {
            pressureDrop            338 kPa;          // Example 24.2-1
            //  alpha, R_m (Example 24.2-1, from the t/V vs V line of the laboratory
            //  test) and m (Example 24.2-4, see controlDict) are the SAMPLE's.
            sample                  caco3_geankoplis_ex24_2_1;
            area                    17.46 m2;         // 20 frames x 0.873 m2
            filtratePerCycle        3.37 m3;          // Example 24.2-2
            cleaningTime            20 min;           // Example 24.2-3
            //  A leaf filter: the wash follows the filtrate's path, at the
            //  final filtration rate (eq. 24.2-19).  filter02 declares
            //  throughWashing here (eq. 24.2-20, one quarter of that rate).
            washFlowPath            sameAsFiltrate;
            washing
            {
                model       displacement;
            }
        }
    }
);
