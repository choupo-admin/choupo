/*---------------------------------------------------------------------------*\
  filter02_caco3_pressWashing / thermoPhysPropDict

  CaCO3 (calcite, rho_p 2710 kg/m3) in water.  The filter reads the
  filtrate's viscosity and density from here: Vogel's law from water's
  record (8.89e-4 Pa s at 298.2 K; the book takes 8.937e-4 from its
  Appendix A.2) and water's Vliq (996.9 kg/m3, the book's value).  No
  aqueous chemistry is declared: the calcite does not dissolve here.
\*---------------------------------------------------------------------------*/

recordType    thermophysicalPropertySystem;
schemaVersion 2;

components ( CaCO3 water );

equilibrium
{
    formulation gammaPhi;
    liquid  { activityModel ideal; standardState pureLiquid; }
    vapour  { fugacityModel idealGas; }
}

transport
{
    liquid
    {
        viscosity { model Vogel; }
    }
}
