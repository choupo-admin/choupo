//  King (2001) Example 10.1: 99.4 short tons/h of dry dolomite (Fig. 10.3),
//  carried on the catalogue's CALCITE record (see constant/thermoPhysPropDict),
//  with the MEASURED feed analysis of Table 10.1 (% passing 3, 2, 1.5, 1.25,
//  1.0, 0.75, 0.5, 0.375, 0.25 in: 100, 95.52, 88.58, 81.87, 72.73, 61.00,
//  44.47, 36.36, 25.40) written as the mass in each sieve interval on the
//  test's OWN edges; the run re-bins it onto the case's grid (uniform in
//  ln x inside each interval) and prints the mapping's closure.

componentMolarFlows
{
    CaCO3       900.9587 kmol/h;     // 99.4 short ton/h on calcite's MW 100.0869
}

T               298.15 K;
P               101325 Pa;

phases
{
    solid
    {
        componentMolarFlows
        {
            CaCO3       900.9587 kmol/h;
        }
        particleSizeDistribution
        {
            //         pan       0.25-0.375 0.375-0.5 0.5-0.75  0.75-1.0  1.0-1.25  1.25-1.5  1.5-2.0   2.0-3.0 in
