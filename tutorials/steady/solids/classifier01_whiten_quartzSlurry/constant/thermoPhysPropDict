/*---------------------------------------------------------------------------*\
  hydrocyclone01_quartz_willsTable91 / thermoPhysPropDict

  A quartz slurry in water.  The hydrocyclone does no work and exchanges no
  heat; the liquid's density (Rackett, from water's record) and the solid's
  particle density are read only for the printed C_V and pulp density.
\*---------------------------------------------------------------------------*/

recordType    thermophysicalPropertySystem;
schemaVersion 2;

components ( silica water );

equilibrium
{
    formulation gammaPhi;
    liquid  { activityModel ideal; standardState pureLiquid; }
    vapour  { fugacityModel idealGas; }
}
