/*---------------------------------------------------------------------------*\
  centrifuge02_discStack_sigmaIdentity / thermoPhysPropDict

  CaCO3 particles (calcite's record, rho_p 2710 kg/m3) in water.  The
  centrifuge reads the particles' density from their record and the liquid's
  density and viscosity (Vogel, water's record) from this package; it does
  no work and reads no enthalpy.
\*---------------------------------------------------------------------------*/

recordType    thermophysicalPropertySystem;
schemaVersion 2;

components ( CaCO3 water );

equilibrium
{
    formulation gammaPhi;
    liquid  { activityModel ideal; standardState pureLiquid; }
    vapour  { fugacityModel idealGas; }
}

transport
{
    liquid
    {
        viscosity { model Vogel; }
    }
}
