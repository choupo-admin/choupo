/*---------------------------------------------------------------------------*\
  thermoPhysPropDict (v2) -- T1 ideal gamma-phi mixture.
  Raoult DECLARED, not defaulted (gamma = 1 identically).
  Migrated mechanically from the v1 flat form (physics identical);
  v2 contract 2026-07-17.

  C256 (2026-11-09), MEASURED: N2, O2 and Ar are priced above their critical
  temperatures somewhere in this run (Psat continued past Tc), but no stream
  holding a liquid carries any of them at a temperature above its own Tc and
  no K of theirs is printed, so no printed number depends on that K.
\*---------------------------------------------------------------------------*/

recordType    thermophysicalPropertySystem;
schemaVersion 1;

components       ( water  air  sucrose );

equilibrium
{
    formulation gammaPhi;

    liquid
    {
        activityModel ideal;
        standardState pureLiquid;
    }

    vapour
    {
        fugacityModel idealGas;
    }
}

transport
{
    //  The FEED's viscosity, which the atomiser reads (DEV.md 4c C421: a liquid property is never typed in the
    //  unit).  Swindells et al. (1958), the NBS table: 30-50 wt % sucrose, 20-35 C, `kind measured`; the feed is 40 wt % at 25 C, inside the rows.
    liquid
    {
        viscosity
        {
            measured
            {
                swindellsSucroseWaterViscosity
                {
                    use            method;
                    interpolation  ( logReciprocal monotoneCubic );     // T, then w[sucrose]
                }
            }
        }
    }

    vapour
    {
        viscosity           { model Chung; }
        thermalConductivity { model Eucken; }
        diffusivity         { model Fuller; }
    }

    interface
    {
        surfaceTension { model StoredCorrelation; }   // water's own record law (0.072 N/m at 25 C); the dissolved sugar is not counted
    }
}
