/*--- Choupo stream state.  Every DIMENSIONAL value carries its unit; the parser converts to SI.
     componentMolarFlows is the OVERALL material (all phases); a phases{} block, when present,
     is a decomposition that sums back to it exactly. ---*/

componentMolarFlows
{
    N2    150 kmol/h;
    silica    0.8322237017 kmol/h;
}

T               300 K;
P               101325 Pa;

phases
{
    vapour
    {
        componentMolarFlows
        {
            N2    150 kmol/h;
        }
    }
    solid
    {
        componentMolarFlows
        {
            silica    0.8322237017 kmol/h;
        }
    }
}

particleSizeDistribution
{
    //  A FITTED LAW, not a transcribed sieve analysis.
    //
    //  The sibling case gasSolidSplitter01_ideal declares six explicit bins.
    //  That is what every Choupo case had to do before the SizeDistribution
    //  family existed -- expand a Rosin-Rammler by hand and put the MODEL in
    //  the case file, where nothing could check it and no moment could be
    //  taken from it.
    //
    //  Here the model is DECLARED and the engine discretises it.  d63 is the
    //  size below which 63.2 % (= 1 - 1/e) of the MASS lies -- the
    //  parameter's actual meaning, routinely mistaken for a mean -- and n is
    //  the spread, ~1 being a very broad cut and large n a narrow one.  RRSB
    //  is declared on the MASS basis, which the engine carries with the
    //  numbers, so a consumer asking for a number-weighted mean gets the
    //  conversion done rather than done wrongly.
    //  WITNESS for the `tabular` form (2026-08-23): sieve data as measured
    //  -- the pedagogically central "I have a screen analysis" input.  The
    //  seven (diameter, mass fraction) rows below are the Rosin-Rammler
    //  sibling's own distribution SAMPLED at its bin centres, so the two
    //  cases describe nearly the same powder through the two declaration
    //  forms and their d50/eta KPIs land close -- a cross-check, not a tie.
    model         tabular;
    basis         mass;
    diameters     ( 5e-6  10e-6  15e-6  20e-6  30e-6  45e-6  70e-6 );
    massFractions ( 0.06  0.15  0.17  0.16  0.23  0.16  0.07 );
}
