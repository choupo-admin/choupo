/*---------------------------------------------------------------------------*\
  thermoPhysPropDict (v2) -- T1 ideal gamma-phi mixture (toluene / n-hexadecane).
  Raoult DECLARED, not defaulted (gamma = 1 identically): two hydrocarbons that
  are alike in kind, so the only thing that makes this column hard is how far
  apart they boil (384 K and 560 K at 1 atm), not any non-ideality.

  VAPOUR: ideal at 1 atm.  Read the purities as ideal-vapour values; the real
  vapour's phi was not measured for this pair.
\*---------------------------------------------------------------------------*/

recordType    thermophysicalPropertySystem;
schemaVersion 1;

components       ( toluene  nHexadecane );

equilibrium
{
    formulation gammaPhi;

    liquid
    {
        activityModel ideal;
        standardState pureLiquid;
    }

    vapour
    {
        fugacityModel idealGas;
    }
}
