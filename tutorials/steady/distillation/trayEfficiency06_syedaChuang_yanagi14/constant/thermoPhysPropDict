/*---------------------------------------------------------------------------*\
  thermoPhysPropDict (v2) -- cyclohexane / n-heptane, the FRI test system of
  Yanagi & Sakata (1982).  Two saturated hydrocarbons of similar size: Raoult
  (gamma = 1) and an ideal-gas vapour at 34 kPa.  The vapour pressures are the
  records' Antoine fits to the CoolProp reference equations.

  Transport, used only by a COMPUTED tray efficiency and by the hydraulics:
    vapour viscosity  Chung (Vc ESTIMATED from Zc(omega), announced)
    vapour diffusion  Fuller (diffusion volumes from the formula)
    surface tension   Brock-Bird (corresponding states, from Tc, Pc, Tb)
  None of the three is fitted to anything in the paper.
\*---------------------------------------------------------------------------*/

recordType    thermophysicalPropertySystem;
schemaVersion 2;

components ( cyclohexane nHeptane );

equilibrium
{
    formulation gammaPhi;

    liquid
    {
        activityModel ideal;
        standardState pureLiquid;
    }

    vapour
    {
        fugacityModel idealGas;
    }
}

transport
{
    vapour
    {
        viscosity   { model Chung; }
        diffusivity { model Fuller; }
    }

    liquid
    {
        //  The paper's own liquid viscosity, the set's measured value (C398 (d)):
        //  constant/experiments/yanagi1982_34kPa_liquidViscosity.dat.
        viscosity
        {
            measured
            {
                yanagi1982_34kPa_liquidViscosity { use method; reason "Yanagi and Sakata Table II gives one average for the run; the case stands it over every state of the trays, as it did when the value was typed in the efficiency block"; }
            }
        }

        //  The effective liquid diffusivity of the binary: Wilke-Chang at infinite
        //  dilution both ways, combined by the form linear in D*mu (Anderson-Babb,
        //  as Poling 5th ed. p. 11.34 states it): the rule this column took before
        //  slice (d), there written as Wilke-Chang in the mixture viscosity.
        diffusivity
        {
            returns             effective;
            composition         { rule AndersonBabb; }
            infiniteDilution    { default { model WilkeChang; } }
            thermodynamicFactor { take 1; }
        }
    }

    interface
    {
        surfaceTension { model BrockBird; }
    }
}
