/*---------------------------------------------------------------------------*\
  Sweep the vapour load -- the boil-up as an F-factor on the tower area, the
  abscissa of Yanagi & Sakata's Figure 12 -- and read what the paper
  measured: the overall tray efficiency (the Fenske slope over the trays),
  the pressure drop (Figure 13 plots it against the superficial velocity,
  `u_bottomTray`), and the approach to flood.  The upper end is a sweep limit, not the model's flood: measured loads above it
  are reported in the case header (run by hand where the model reaches them, counted as
  model misses where it refuses, psi >= 1).
\*---------------------------------------------------------------------------*/

type        sweep;

parameter
{
    target    units[0].operation.totalReflux.fFactor;
    range     ( 0.3  1.7 );
    nPoints   15;
}

responses
(
    column.overallTrayEfficiency
    column.E_MV_mean
    column.E_MV_dry_mean
    column.floodApproach_max
    column.dP_column_kPa
    column.u_bottomTray
);

report
{
    format    csv;
    file      sweep_fFactor.csv;
}
