/*---------------------------------------------------------------------------*\
  thermoPhysPropDict (v2) -- p-xylene / o-xylene, the FRI test system of
  Schulz et al. (2018).  Two isomers: Raoult (gamma = 1), ideal-gas vapour at
  0.02-0.1 bar.  Vapour pressures: the records' Antoine fits to CoolProp.
  Transport for the packing model: Chung (vapour viscosity), Fuller (vapour
  diffusivity; diffusion volumes added to the case's component records),
  Brock-Bird (surface tension).  Nothing fitted to the paper.
  For the rate-based model's film heat-transfer coefficients (ratebased
  cases only): the vapour thermal conductivity by Eucken (Physik. Z. 14
  (1913) 324, via Reid, Prausnitz & Poling 4th ed. Eq 10-3.2) and the
  liquid one by Sato-Riedel (Reid, Prausnitz & Poling 4th ed. Eq 10-9.1);
  both are estimates from data the component records already carry.
\*---------------------------------------------------------------------------*/

recordType    thermophysicalPropertySystem;
schemaVersion 2;

components ( pXylene oXylene );

equilibrium
{
    formulation gammaPhi;

    liquid
    {
        activityModel ideal;
        standardState pureLiquid;
    }

    vapour
    {
        fugacityModel idealGas;
    }
}

transport
{
    vapour
    {
        viscosity   { model Chung; }
        diffusivity { model Fuller; }
        thermalConductivity { model Eucken; }        // estimate: Cp_ig and mu
    }

    liquid
    {
        thermalConductivity { model SatoRiedel; }    // estimate: MW, Tb, Tc
    }

    interface
    {
        surfaceTension { model BrockBird; }
    }
}
