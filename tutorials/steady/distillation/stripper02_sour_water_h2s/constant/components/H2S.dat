// [imported] origin "data/standards/components/H2S.dat" (Choupo-2608 release) -- owned + sha256-verified by constant/propertyManifest
/*--------------------------------*- Choupo -*-----------------------*\
  Component: Hydrogen sulfide  (H2S, CAS 7783-06-4)

  Sour-gas contaminant in natural gas and biogas.  Removed by amine
  scrubbing; recovered as elemental S via the Claus process
  (2 H2S + SO2 -> 3 S + 2 H2O at 1000-1500 K) --- another good
  GibbsReactor target with strong T sensitivity.
  Sources: constants (Tc/Pc/omega/MW/Tb) cross-checked vs CoolProp 7.2.0
  reference EOS; standardThermochemistry cross-checked vs NASA TM-4513
  (McBride-Gordon-Reno 1993); idealGasHeatCapacity -- individual
  literature value, primary re-citation pending (IST review).
\*---------------------------------------------------------------------------*/

name        H2S;
formula     H2S;
CAS         7783-06-4;

// role solute (v0.28+): in a water solvent the K-value comes from
// HenrysLaw/H2S-water.dat instead of Antoine/Raoult.
role        solute;

MW          34.082;            // kg/kmol
Tc          373.40;             // K
Pc          89.63;              // bar
omega       0.090;              // [-]
Tb          212.85;             // K  HEOS reference EoS; two independent
                                //    Psat curves (Poling, Perry) agree the
                                //    old 213.60 sat above 1 atm (2026-08-23)             // K
HvapTb      18670;              // J/mol
Vliq        3.49e-5;            // m^3/mol
//  ANCHOR, never an input.  The engine DERIVES the Hildebrand
//  parameter from HvapTb and Vliq (the tree stores no derivative);
//  this is what ChemSep v8.3 computed independently, so the
//  derivation has something to be wrong against.
solubilityParameter 18000;   // Pa^0.5  [anchor, ChemSep v8.3, Artistic-2.0]

standardThermochemistry
{
    dHf_298    -20630.0;        // J/mol  -- ideal-gas reference
    s_298      205.79;          // J/(mol·K)
}

vaporPressure
{
    model         Antoine;
    // log10(Psat [bar]) = A - B / (T[K] + C)
    // Poling 5e App. A (via the MIT-licensed `chemicals` 1.5.2 data
    // distribution; INTERIM pending primary review (Vitor)); consistent with
    // Tb 212.85 K (HEOS), see Tb note
    coefficients  (4.22882   806.933   -21.76);
    Trange        (186  227);
}

idealGasHeatCapacity
{
    model         polynomial;
    coefficients  (31.94   1.436e-3   2.432e-5   -1.176e-8);
    Trange        (250  1500);
}

// ---- Aqueous-speciation FACT (substance-level, classifier-read) ----
// H2S(aq) = HS- + H+: the sulfide set, master HS.
aqueousSpeciation  sulfide;
aqueousMapping ( { species HS; nu 1; } { species H; nu 1; } );

cosmo
{
    LVPP-HFTZVP-2018
    {
        model       COSMOSAC;
        variant     "LVPP-HFTZVP-2018";
        protocol    "LVPP-18.07 GAMESS HF/TZVP; r_av 1.4 A; f_decay 3.57; d in A; sigma = q/a";
        source      "LVPP sigma-profile database release 18.07 (github.com/lvpp/sigma, asset HF_TZVP.zip, sha256 bd17aaeebb430641...), file HYDROGEN_SULFIDE.gout; MIT License, Copyright (c) 2017 LVPP; cite Ferrarini, Flores, Muniz & Soares, AIChE J. 64 (2018) 3443, doi:10.1002/aic.16194, and doi:10.5281/zenodo.3613786; identity: InChIKey RWSOTUBLDIXVET-UHFFFAOYSA-N (full match); formula H2S; resolved by thirdParty/thermoml/identity.json (PubChem and CACTUS agree)";
        derivation  "segment areas, charges and the cavity volume are LVPP's (GAMESS HF/TZVP COSMO output); `area` is the sum of LVPP's segment areas as binned (GAMESS's printed cavity area agrees within its 2-decimal rounding); the 51-point profile is COMPUTED BY CHOUPO from LVPP's surface segments by bin/curate/lvpp_sigma_profile.py under the protocol above (Bell et al. 2020 Eq. 4 averaging, sigma = q/a, area split linearly between grid nodes)";
        licence     MIT;
        installed   true;
        area        62.274590;   // sum of the profile below; GAMESS prints 62.27
        volume      45.17;
        sigmaProfile  (
               0.000000     0.000000     0.000000     0.000000     0.000000     0.000000
               0.000000     0.000000     0.000000     0.000000     0.000000     0.000000
               0.000000     0.000000     0.000000     0.818017     4.947660     4.431159
               3.068817     4.466195     2.187687     1.360027     2.683025     3.526084
               2.508685     2.994456     3.185087     2.195421     2.892080     6.508066
               2.769298     1.772322     1.637736     3.143212     3.694164     0.967005
               0.518387     0.000000     0.000000     0.000000     0.000000     0.000000
               0.000000     0.000000     0.000000     0.000000     0.000000     0.000000
               0.000000     0.000000     0.000000
        );
    }
}
