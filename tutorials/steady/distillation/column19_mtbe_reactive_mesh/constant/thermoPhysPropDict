/*---------------------------------------------------------------------------*\
  thermoPhysPropDict (v2) -- gamma-phi, predictive UNIFAC liquid, ideal vapour.

  The MTBE system: methanol, isobutene, MTBE and the C4 cut.  Methanol is the
  strongly non-ideal member (it forms azeotropes with the C4 hydrocarbons and
  with MTBE), so the liquid is the predictive group-contribution UNIFAC; the
  Raoult datum (gamma -> 1 as x -> 1) is the standard state the reaction's K_a
  is written in.  The vapour at 7 bar stays ideal (a stated simplification).
\*---------------------------------------------------------------------------*/

recordType    thermophysicalPropertySystem;
schemaVersion 2;

components ( methanol  isoButene  methylTertButylEther  propane  isoButane
             nButane  1Butene  cis2Butene  trans2Butene );

equilibrium
{
    formulation gammaPhi;

    liquid
    {
        activityModel { model UNIFAC; }
        standardState pureLiquid;
    }

    vapour
    {
        fugacityModel idealGas;
    }
}
