/*--- Choupo stream state.  Every DIMENSIONAL value carries its unit; the parser converts to SI.
     componentMolarFlows is the OVERALL material (all phases); a phases{} block, when present,
     is a decomposition that sums back to it exactly. ---*/

/*  AN INITIAL GUESS, NOT AN INPUT.  The column computes the distillate; the
    0/ contract only requires a complete state for every stream, and this file
    supplies one.  It is seeded with the paper's MEASURED top composition
    (Table 2, converted in flowsheetDict section 4) at the spec rate of
    142.023556 kmol/h, because that is the honest place to start a run whose
    question is "does the column reproduce it".  The zero-wt-% components are
    seeded at 1e-9 kmol/h rather than 0 so the file describes a physically
    reachable state.

    Seeding the answer does NOT bias it: the Wang-Henke sweep starts from its
    own internal profile (feed composition on every stage, linear T), never
    from these numbers.  Compare converged/distillate against this file to read
    predicted-against-measured directly.                                      */

componentMolarFlows
{
    propane          9.753606 kmol/h;      //  5.3 wt %
    isoButane      130.544353 kmol/h;      // 93.5 wt %
    nButane          0.279235 kmol/h;      //  0.2 wt %
    1Butene          0.578545 kmol/h;      //  0.4 wt %
    isoButene        1e-9 kmol/h;          //  0   wt % as printed
    trans2Butene     0.867817 kmol/h;      //  0.6 wt %
    neopentane       1e-9 kmol/h;          //  0   wt % as printed
    isopentane       1e-9 kmol/h;          //  0   wt % as printed
    nPentane         1e-9 kmol/h;          //  0   wt % as printed
}                                          // total 142.023556 kmol/h = 8115 kg/h

T               314.2 K;                   // guess, near the overhead bubble point
P               658600 Pa;
vaporFraction   0.0;                       // total condenser
