/*---------------------------------------------------------------------------*\
  column10_flooding -- the view the lesson opens on (DEV.md 4c C477).

  The lesson: the same column as column09, built too narrow; the stage
  equations converge all the same, and only the hydraulics say the tower cannot
  pass its traffic.

  The plot: how close each tray runs to flooding, and the downcomer liquid
  backup, tray by tray; the rectifying trays are the ones near the limit.

  This declares how the run is DRAWN, over what the column already publishes;
  it computes nothing and changes no number.  Grammar: docs/design/a-post-
  processing-dictionary.md.
\*---------------------------------------------------------------------------*/

views
(
    {
        name    flood_by_tray;
        type    profile;
        title   "A narrow column converges, but its trays run at the edge of flooding";
        xAxis   { label "stage (1 = top tray)"; unit "-"; scale linear; }
        yAxis   { label "approach to flooding velocity (1 = flooding)"; unit "-"; scale linear; }
        note    "Read it: 1.0 is flooding and the design target is 0.80. Every rectifying tray (stages 1-7) is above 1.0, from 1.05 on the top tray to 1.126 on stage 7 just above the feed, against the 0.80 that column09's wider tower was sized for; the stripping trays carry less vapour and sit near 0.67-0.71. The last stage is the reboiler and has no tray, so its zero is not a tray. The separation printed in the stream table is identical to column09's: only this figure says the tower could not hold it.";
        series
        (
            { name flood; label "fraction of the flooding velocity"; unitOp column10; table profile; x stage; y floodApproach; style linesMarkers; }
        );
    }
    {
        name    backup_by_tray;
        type    profile;
        title   "Downcomer liquid backup: the second limit of the narrow tower";
        xAxis   { label "stage (1 = top tray)"; unit "-"; scale linear; }
        yAxis   { label "downcomer backup"; unit "mm"; scale linear; }
        note    "Read it: the backup follows the flooding profile and peaks at the same tray; its peak is 253.8 mm at stage 7, against the 275 mm limit in the run's hydraulics table (a narrower column would flood from below, for this second reason). The last stage is the reboiler (no tray, zero).";
        series
        (
            { name backup; label "backup in the downcomer"; unitOp column10; table profile; x stage; y h_backup_mm; style linesMarkers; }
        );
    }
);
