/*---------------------------------------------------------------------------*\
  thermoPhysPropDict (v2) -- T1 ideal gamma-phi mixture; the liquid IS an
  aqueous electrolyte solution (declared once, `aqueous {}`), and every
  solute is an ION declared as a component with its aqueous bridge -- the
  form the scaling audit and the SDEM law both read.
\*---------------------------------------------------------------------------*/
recordType    thermophysicalPropertySystem;
schemaVersion 1;

components       ( water Na Cl NO3 NH4 );

equilibrium
{
    formulation gammaPhi;
    liquid
    {
        activityModel ideal;
        standardState pureLiquid;
    }
    aqueous
    {
        activityModel { model davies; }
    }
    vapour
    {
        fugacityModel idealGas;
    }
}

approximations
{
    massWithoutVolume
    {
        components      ( Na Cl NO3 NH4 );
        maxMassFraction 0.005;
        reason          "the membrane feed's dissolved ions keep their mass and add no volume to the feed's liquid density (their mass fraction is at most 0.0006); a membrane unit asks the package for the feed density and a solute with no liquid volume needs this declared reading (C402: the 1000 kg/m3 the unit used to type is gone); the engine's own bound on it is about +1.8 % on rho at 1 mol/kg (AqueousVolumetric.H)";
    }
}
