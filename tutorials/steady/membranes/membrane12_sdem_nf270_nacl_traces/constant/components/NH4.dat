/*---------------------------------------------------------------------------*\
  Component: ammonium ion (NH4+)  -- CASE-LOCAL ionic component
  A master ion of the electrolyte catalogue used AS a flowsheet component,
  so the stream carries a water ANALYSIS ion by ion and the membrane's
  transport law (SDEM) can read each ion's charge through the declared
  aqueous bridge below.  Name matches the `species` key in the model-species
  catalogue (data/standards/species/NH4.dat); MW is that record's.
  nonvolatile: an ion never enters the vapour.
  dissociation 1: one osmotically active particle per mole of ion (the
  analysis already lists ions, not salts).
\*---------------------------------------------------------------------------*/
name           NH4;
formula        "NH4+";
MW             18.039;          // g/mol  (= kg/kmol), species/NH4.dat
role           nonvolatile;
reviewStatus   interim;       // MW and charge transcribed from the species record; not yet read back by a human
dissociation   1;              // already an ion: 1 particle/mol
aqueousMapping ( { species NH4; nu 1; } );
