/*---------------------------------------------------------------------------*\
  thermoPhysPropDict (v2) -- T1 ideal gamma-phi mixture; the liquid IS an
  aqueous electrolyte solution (declared once, `aqueous {}`), and every
  solute is an ION declared as a component with its aqueous bridge -- the
  form the scaling audit and the SDEM law both read.
\*---------------------------------------------------------------------------*/
recordType    thermophysicalPropertySystem;
schemaVersion 2;

components       ( water Na Cl NO3 NH4 );

equilibrium
{
    formulation gammaPhi;
    liquid
    {
        activityModel ideal;
        standardState pureLiquid;
    }
    aqueous
    {
        activityModel { model davies; }
    }
    vapour
    {
        fugacityModel idealGas;
    }
}

// THE LIQUID DENSITY'S HYPOTHESIS (DEV.md 4c C378 pilot): the pump and the
// CSTR take their liquid density from the property kernel, which refuses a
// component with no liquid volume.  This case declares, with its bound set
// from its own feed, that the listed components keep their mass and add no
// volume -- what the pump did unannounced before the pilot.
approximations
{
    massWithoutVolume
    {
        components      ( Na Cl NO3 NH4 );
        maxMassFraction 0.005;
        reason          "the NF feed's dissolved ions keep their mass and add no volume to the booster pump's liquid density (their mass fraction in the feed is about 9e-4); the engine's own bound on this reading is about +1.8 % on rho at 1 mol/kg (AqueousVolumetric.H)";
    }
}
