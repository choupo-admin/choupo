/*---------------------------------------------------------------------------*\
  thermoPhysPropDict (v2) -- T1 ideal gamma-phi mixture, NaCl and MgSO4 as
  two lumped nonvolatile SOLUTES (membrane01's form).  A salt is neutral, so
  one constant rejection per salt gives an electroneutral permeate by
  construction -- the reason this feed is declared by salts and not ion by
  ion (see the README).
\*---------------------------------------------------------------------------*/
recordType    thermophysicalPropertySystem;
schemaVersion 2;

components       ( water  NaCl  MgSO4 );

equilibrium
{
    formulation gammaPhi;
    liquid
    {
        activityModel ideal;
        standardState pureLiquid;
    }
    vapour
    {
        fugacityModel idealGas;
    }
}
