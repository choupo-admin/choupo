/*---------------------------------------------------------------------------*\
  thermoPhysPropDict (v2) -- T1 ideal gamma-phi mixture.
  Raoult DECLARED, not defaulted (gamma = 1 identically).
  Migrated mechanically from the v1 flat form (physics identical);
  v2 contract 2026-07-17.
\*---------------------------------------------------------------------------*/

recordType    thermophysicalPropertySystem;
schemaVersion 1;

components       ( water  Ca  Mg  Na  K  Cl  SO4  HCO3 );

equilibrium
{
    formulation gammaPhi;

    liquid
    {
        activityModel ideal;
        standardState pureLiquid;
    }

    // The liquid IS an aqueous electrolyte solution -- declared here, once,
    // independently of the phase equilibrium above (this vessel computes no
    // VLE).  The scaling audit READS this; it no longer picks a model itself.
    aqueous
    {
        activityModel { model davies; }
    }

    vapour
    {
        fugacityModel idealGas;
    }
}

approximations
{
    massWithoutVolume
    {
        components      ( Ca Mg Na K Cl SO4 HCO3 );
        maxMassFraction 0.005;
        reason          "the membrane feed's dissolved ions keep their mass and add no volume to the feed's liquid density (their mass fraction is at most 0.0014); a membrane unit asks the package for the feed density and a solute with no liquid volume needs this declared reading (C402: the 1000 kg/m3 the unit used to type is gone); the engine's own bound on it is about +1.8 % on rho at 1 mol/kg (AqueousVolumetric.H)";
    }
}
