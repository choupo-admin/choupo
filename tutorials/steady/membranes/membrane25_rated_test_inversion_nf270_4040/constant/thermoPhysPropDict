/*---------------------------------------------------------------------------*\
  thermoPhysPropDict (v2) -- T1 ideal gamma-phi mixture, MgSO4 as ONE lumped
  nonvolatile solute (membrane01's form).  The data sheet's rated test is a
  SALT test, so the feed is declared by the salt: declared ion by ion,
  `fromRatedTest` refuses (a salt's rejection says nothing about how it
  splits between its ions).
\*---------------------------------------------------------------------------*/
recordType    thermophysicalPropertySystem;
schemaVersion 2;

components       ( water  MgSO4 );

equilibrium
{
    formulation gammaPhi;
    liquid
    {
        activityModel ideal;
        standardState pureLiquid;
    }
    vapour
    {
        fugacityModel idealGas;
    }
}
