/*---------------------------------------------------------------------------*\
  thermoPhysPropDict (v2) -- T1 ideal gamma-phi mixture; the solutes are
  SALTS (NaCl, CaCl2, MgSO4), each a component whose `dissociatesTo` gives
  the ions the DSPM-DE law works in (their charge, Stokes radius and D0 are
  read off the species records).

  THE LIQUID VISCOSITY IS DECLARED, because the ion D0 are 25 C values and
  this array runs at 20 C: every membrane reader of D0 corrects it by
  Stokes-Einstein, D(T) = D0 (T/298.15)(mu(298.15)/mu(T)), on THIS model
  (water's Vogel record) -- 0.874 at 293.15 K, printed on the run.  Without
  the declaration the run would use the 25 C values and say so.
\*---------------------------------------------------------------------------*/
recordType    thermophysicalPropertySystem;
schemaVersion 2;

components       ( water  NaCl  CaCl2  MgSO4 );

equilibrium
{
    formulation gammaPhi;
    liquid
    {
        activityModel ideal;
        standardState pureLiquid;
    }
    vapour
    {
        fugacityModel idealGas;
    }
}

transport
{
    liquid
    {
        viscosity { model Vogel; }
    }
}

// THE LIQUID DENSITY'S HYPOTHESIS (DEV.md 4c C378 pilot): the pump and the
// CSTR take their liquid density from the property kernel, which refuses a
// component with no liquid volume.  This case declares, with its bound set
// from its own feed, that the listed components keep their mass and add no
// volume -- what the pump did unannounced before the pilot.
approximations
{
    massWithoutVolume
    {
        components      ( NaCl CaCl2 MgSO4 );
        maxMassFraction 0.005;
        reason          "the NF feed's three salts keep their mass and add no volume to the booster pump's liquid density (their mass fraction in the feed is below 2e-3); the engine's own bound on this reading is about +1.8 % on rho at 1 mol/kg (AqueousVolumetric.H)";
    }
}
