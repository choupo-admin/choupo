/*---------------------------------------------------------------------------*\
  thermoPhysPropDict (v2) -- T1 ideal gamma-phi mixture; the solutes are
  SALTS (NaCl, CaCl2, MgSO4), each a component whose `dissociatesTo` gives
  the ions the DSPM-DE law works in (their charge, Stokes radius and D0 are
  read off the species records).

  THE LIQUID VISCOSITY IS DECLARED, because the ion D0 are 25 C values and
  this array runs at 20 C: every membrane reader of D0 corrects it by
  Stokes-Einstein, D(T) = D0 (T/298.15)(mu(298.15)/mu(T)), on THIS model
  (water's Vogel record) -- 0.874 at 293.15 K, printed on the run.  Without
  the declaration the run would use the 25 C values and say so.
\*---------------------------------------------------------------------------*/
recordType    thermophysicalPropertySystem;
schemaVersion 2;

components       ( water  NaCl  CaCl2  MgSO4 );

equilibrium
{
    formulation gammaPhi;
    liquid
    {
        activityModel ideal;
        standardState pureLiquid;
    }
    vapour
    {
        fugacityModel idealGas;
    }
}

transport
{
    liquid
    {
        viscosity
        {
            model Vogel;       // the SE temperature correction of the ions' D0 reads water's law
            measured
            {
                dil20_CaCl2MgSO4NaCl_liquidViscosity { use method; reason "the case stands the stated value over every feed of this liquid in its box, as it did when the value was typed in the unit block; water's viscosity for a dilute feed, the status in the file's basis"; }
            }
        }
        diffusivity
        {
            returns infiniteDilution;
            infiniteDilution
            {
                entries
                (
                    { solute NaCl; solvent water; kind infiniteDilution;
                      value 1.611e-09 m2/s;  T 298.15 K;  box { T (293.15 298.15); }
                      reason "the datum is at 25 C and the case runs at 20 C: D falls about 2 to 3 % per K on that page, so the film coefficient of the salt-level column is about 10 % high; the case stands the value over 20 to 25 C as a hypothesis";
                      source "Lide (ed.), CRC Handbook of Chemistry and Physics, 82nd ed. (2001), table 'Ionic conductivity and diffusion at infinite dilution' (Vanysek; PDF page 304 of Handbooks-DataCompilations/lide-crc-handbook-chemistry-physics-82ed.pdf): Na+ 1.334, Cl- 2.032 x 1e-5 cm2/s, combined by the page's salt relation D = (z+ + z-) D+ D- / (z+ D+ + z- D-)"; }
                    { solute CaCl2; solvent water; kind infiniteDilution;
                      value 1.335e-09 m2/s;  T 298.15 K;  box { T (293.15 298.15); }
                      reason "the datum is at 25 C and the case runs at 20 C: D falls about 2 to 3 % per K on that page, so the film coefficient of the salt-level column is about 10 % high; the case stands the value over 20 to 25 C as a hypothesis";
                      source "Lide (ed.), CRC Handbook of Chemistry and Physics, 82nd ed. (2001), table 'Ionic conductivity and diffusion at infinite dilution' (Vanysek; PDF page 304 of Handbooks-DataCompilations/lide-crc-handbook-chemistry-physics-82ed.pdf): Ca2+ 0.792, Cl- 2.032 x 1e-5 cm2/s, combined by the page's salt relation D = (z+ + z-) D+ D- / (z+ D+ + z- D-)"; }
                    { solute MgSO4; solvent water; kind infiniteDilution;
                      value 8.491e-10 m2/s;  T 298.15 K;  box { T (293.15 298.15); }
                      reason "the datum is at 25 C and the case runs at 20 C: D falls about 2 to 3 % per K on that page, so the film coefficient of the salt-level column is about 10 % high; the case stands the value over 20 to 25 C as a hypothesis";
                      source "Lide (ed.), CRC Handbook of Chemistry and Physics, 82nd ed. (2001), table 'Ionic conductivity and diffusion at infinite dilution' (Vanysek; PDF page 304 of Handbooks-DataCompilations/lide-crc-handbook-chemistry-physics-82ed.pdf): Mg2+ 0.706, SO42- 1.065 x 1e-5 cm2/s, combined by the page's salt relation D = (z+ + z-) D+ D- / (z+ D+ + z- D-)"; }
                );
            }
        }
    }
}

// THE LIQUID DENSITY'S HYPOTHESIS (DEV.md 4c C378 pilot): the pump and the
// CSTR take their liquid density from the property kernel, which refuses a
// component with no liquid volume.  This case declares, with its bound set
// from its own feed, that the listed components keep their mass and add no
// volume -- what the pump did unannounced before the pilot.
approximations
{
    massWithoutVolume
    {
        components      ( NaCl CaCl2 MgSO4 );
        maxMassFraction 0.005;
        reason          "the NF feed's three salts keep their mass and add no volume to the booster pump's liquid density (their mass fraction in the feed is below 2e-3); the engine's own bound on this reading is about +1.8 % on rho at 1 mol/kg (AqueousVolumetric.H)";
    }
}
