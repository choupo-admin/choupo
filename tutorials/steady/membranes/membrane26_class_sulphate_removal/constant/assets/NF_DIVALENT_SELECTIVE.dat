// [imported] origin "data/standards/assets/NF_DIVALENT_SELECTIVE.dat" (Choupo-2608 release) -- owned + sha256-verified by constant/propertyManifest
/*--------------------------------*- Choupo -*-----------------------*\
  Membrane FUNCTIONAL CLASS: NF_DIVALENT_SELECTIVE
  (a nanofilter that holds sulphate and lets sodium chloride through)

  WHAT THIS RECORD IS.  A membrane a student chooses by WHAT IT DOES,
  before -- or instead of -- choosing a product.  It is NOT a product: it
  names no manufacturer and no model number, and every number in it is an
  ILLUSTRATIVE teaching assumption, not a measurement
  (`reviewStatus illustrative;`, announced on every run that reads it).
  A case names it where it would name an element: `module
  NF_DIVALENT_SELECTIVE;` with `transport constantRejection;` and
  `rejection { NaCl fromRatedTest; MgSO4 fromRatedTest; }`.

  WHAT IT DECLARES, and how each value was chosen (DEV.md 4c C189):
    * OBSERVED rejections, feed to permeate, at its own reference test --
      ONE value per salt, taken at the MIDDLE of the screening window the
      external specification gives for the class (the `bands {}` block
      below; a lower-bounded window "> 90 %" is read as [0.90, 1.0]).  The
      middle is a choice, recorded as one: it is the value a teaching
      profile can defend without claiming to be either end.
          NaCl   window 10-50 %   -> 30 %
          MgSO4  window > 90 %    -> 95 %
    * A water permeance A_w, a round teaching value (10 L m-2 h-1 bar-1),
      chosen by the curator so that the class element delivers about its
      reference permeate at the reference test.  No source states it.
    * The element it is deployed in, BY REFERENCE: `element Generic-4040;`
      (data/standards/assets/Generic-4040.dat) -- its area, leaves, leaf
      length and feed spacer are adopted, never restated, and their own
      estimates are announced as that record's.
  The INTRINSIC rejection `constantRejection` needs is DERIVED from the
  observed one by inverting the reference test with the module's own film
  (src/unitOperations/membrane/RatedTestInversion), never typed here.

  THE REFERENCE TEST is the conventional nanofiltration standard test
  (2,000 ppm of the salt, 4.8 bar gauge, 25 C, 15 % recovery) on the class
  element.  Its permeate flow is the class's own nominal figure, chosen with
  A_w; the run prints the engine's permeate at the test beside it.

  NOTHING PER ION, NO PORE.  A class states salt rejections; splitting a
  salt's rejection between its ions is a transport model (SDEM, DSPM-DE),
  not a datum, so only `transport constantRejection;` can run a class.
\*---------------------------------------------------------------------------*/

name           NF_DIVALENT_SELECTIVE;
kind           membraneClass;
membraneType   NF;
reviewStatus   illustrative;
description    "high sulphate (divalent-salt) retention with sodium chloride passage";
application    "sulphate removal, softening of a brackish or sea water with the monovalent salt left in the permeate";
element        Generic-4040;

A_w            2.78e-6 m/s/bar;    // 10 L m-2 h-1 bar-1, illustrative

ratedTests
(
    {
        id                 naclRef;
        solute             NaCl;
        feedMassFraction   2.0e-3;
        P                  4.8 bar;
        pressureBasis      feedGauge;
        T                  298.15 K;
        recovery           0.15;
        permeateFlow       7.5 m3/d;
        permeateFlowBasis  sameTest;
        rejection          0.30;
        rejectionValueType typical;
        source             "illustrative class reference test (Choupo, DEV.md 4c C189); not a measurement";
    }
    {
        id                 mgso4Ref;
        solute             MgSO4;
        feedMassFraction   2.0e-3;
        P                  4.8 bar;
        pressureBasis      feedGauge;
        T                  298.15 K;
        recovery           0.15;
        permeateFlow       7.0 m3/d;
        permeateFlowBasis  sameTest;
        rejection          0.95;
        rejectionValueType typical;
        source             "illustrative class reference test (Choupo, DEV.md 4c C189); not a measurement";
    }
);

bands
{
    NaCl   { min 0.10; max 0.50; }
    MgSO4  { min 0.90; max 1.0;  }
    source "external specification relayed by Vitor Geraldes 2026-10-31 (DEV.md 4c C189), section 3, example screening windows -- NOT universal guarantees";
}

provenance
{
    source  "Choupo functional class, DEV.md 4c C189 slice 3 (2026-10-31): an illustrative teaching profile; the rejection windows from the external specification's section 3, the values at their middle, A_w a curator's round teaching value";
    A_w
    {
        origin  assumed;
        method  "a round teaching value consistent with the class's reference permeate";
    }
}
