/*---------------------------------------------------------------------------*\
  Water's viscosity at 25 C, 0.890 mPa s (CRC), the value this case typed before C402 ("water at 25 C"), now with its source.  It is the viscosity of the solvent, stood over a dilute feed (each solute below 1 wt %).  How far it is from the solution's: the same table at p. 8-77 gives NaCl at 20 C: 0.5 wt % 1.011, 1 wt % 1.020, 3 wt % 1.052, 4 wt % 1.068 mPa s, i.e. NaCl at 1 wt % is +1.8 % over water and at 0.5 wt % +0.9 %, and this feed is below that.
  Read by transport.liquid.viscosity.measured (DEV.md 4c C398 slice (d)); until C402 the number was typed in the
  membrane unit's massTransfer block, which now refuses it.
\*---------------------------------------------------------------------------*/

provenance
{
    sha256       "9885428ba591fa72483a9ae973fc8964b54cb81fe970ea763350c04019135ae0";
    source       literature;
    kind         adopted;
    basis        "pure water at 25 C, taken for the dilute solution of NaCl: the value of the SOLVENT, not a measurement of the solution";
    citation     "Lide (ed.), CRC Handbook of Chemistry and Physics, 82nd ed. (2001), table 'Viscosity of liquids', p. 6-170: water, 0.890 mPa s at 25 C";
}

property    liquidViscosity;
system      ( NaCl water );
solvent     water;

columns
(
    { name T;       unit K;    }
    { name mu;      unit Pa.s; }
    { name w[NaCl]; unit -;    }
);
data        ( 298.15 0.890e-3 0 );

box
{
    T        ( 297.65 298.65 );
    w[NaCl]  ( 0 0.05 );
}
