/*--- Choupo stream state.  Every DIMENSIONAL value carries its unit; the parser converts to SI.
     componentMolarFlows is the OVERALL material (all phases). ---*/
//  2.6 m3/h of 2 g/L NaCl (2000 ppm): per m3, NaCl 2/58.44 = 0.03422 kmol
//  and water (1000 - 2)/18.015 = 55.40 kmol.  2.6 m3/h is the feed the
//  sheet's rated test implies (9.5 m3/d permeate at 15 % recovery = 63 m3/d),
//  under the element's 3.6 m3/h maximum.
componentMolarFlows
{
    water   144.04 kmol/h;
    NaCl    0.08898 kmol/h;
}
T               298.15 K;      // 25 C, the sheet's test temperature
P               4.8 bar;       // the sheet's rated applied pressure (70 psi)
