/*----------------------------------------------------------*\
  constant/components/water.dat -- MERGED sealed record: the standards base with
  this case's partial overlay applied top-level (Choupo-2607 release).
  Materialised by bin/choupo-import so the sealed case reads ONE
  complete record with the catalogue hidden; provenance (base +
  overlay hashes) is recorded in constant/propertyManifest.
\*----------------------------------------------------------*/

name        water;

formula     H2O;

CAS         7732-18-5;

MW          18.015;

Tc          647.14;

Pc          220.64;

omega       0.3449;

Tb          373.15;

HvapTb      40660;

Vliq        1.807e-5;

diffusionVolume  13.1;

standardThermochemistry
{
    dHf_298   -241826.0;        
    s_298     188.834;         
}

vaporPressure
{
    //  IAPWS SR1-86(1992) Eq. 1:  ln(p/pc) = (Tc/T) sum a_i u^e_i ,  u = 1 - T/Tc ,
    //  with the reducing constants of the release, Tc = 647.096 K and
    //  pc = 22.064 MPa (its Sec. 2), NOT this record's Tc.  Coefficients as
    //  printed in Wagner & Pruss 2002, Eq. (2.5), p. 399.
    model         Wagner;
    reducing      { T 647.096 K;  P 22.064 MPa; }
    exponents     (1 1.5 3 3.5 4 7.5);
    coefficients  (-7.85951783  1.84408259  -11.7866497  22.6807411  -15.9618719  1.80122502);
    Trange        (273.16  647.096);
}

idealGasHeatCapacity
{
    model         polynomial;
    coefficients  (32.243   1.924e-3   1.0555e-5   -3.596e-9);
    Trange        (200  1500);
}

liquidHeatCapacity
{
    model         polynomial;
    coefficients  (75.5);
    Trange        (273  373);
}

ebulioscopic
{
    K_b   0.512;
    K_f   1.853;
}

associationFactor  2.6;

liquidViscosity
{
    andrade { A -13.03; B 1796.1; }
    vogel   { A -10.5366; B 541.4; C 144.0; }
}

groups
{
    unifac ( { group H2O; count 1; } );
}

uniquac
{
    r   0.9200;
    q   1.4000;     
}

cosmo
{
    VT2005
    {
        model       COSMOSAC;
        variant     "2002";
        source      "VT-2005 sigma-profile database (Mullins et al., Ind. Eng. Chem. Res. 45 (2006) 4389; DFT-COSMO), file VT2005-1076-PROF.txt bundled in usnistgov/COSMOSAC; CAS 7732-18-5";
        licence     externalRestricted;   
        installed   false;
    }
}
