/*---------------------------------------------------------------------------*\
  thermoPhysPropDict (v2) -- the dilute-solution (Henry) world (since C256; it
  was the T1 ideal gamma-phi mixture).
  Raoult DECLARED, not defaulted (gamma = 1 identically).
  Migrated mechanically from the v1 flat form (physics identical);
  v2 contract 2026-07-17.
  WHY HENRY (C256, 2026-11-09; the same change as ChemicalPlantTutorial, the
  plant this sweep is built on).  CO2 (Tc 304.1 K) and N2 (126.2 K) are
  above their critical temperatures everywhere here; on the ideal package the
  fermentation flash priced CO2 through a vapour pressure continued past Tc
  (K_CO2 500.9) and the beer it recycles carried 0.17 mol % CO2 on it.  The
  catalogue carries both pairs with water (Sander 2015).  The constants are
  for pure water; the flash liquid is ~20 mol % ethanol and no mixed-solvent
  Henry route exists.  Ethanol, water and sucrose stay on Raoult, gamma = 1.
\*---------------------------------------------------------------------------*/

recordType    thermophysicalPropertySystem;
schemaVersion 2;

components       ( water  sucrose  N2  ethanol  CO2 );

equilibrium
{
    formulation diluteSolution;

    liquid
    {
        solvent
        {
            component     water;
            standardState pureLiquid;          // the Raoult rung
        }
        solutes
        {
            components    ( CO2  N2 );
            standardState infiniteDilution;    // the Henry rung
            solutionModel henryDilute;
            binaryParameters
            {
                // Sander (2015) compilation, CC-BY
                CO2-water { source "data/standards/parameters/Henry/CO2-water.dat"; }
                N2-water { source "data/standards/parameters/Henry/N2-water.dat"; }
            }
        }
    }

    vapour
    {
        fugacityModel idealGas;
    }
}

transport
{
    vapour
    {
        viscosity           { model Chung; }
        thermalConductivity { model Eucken; }
        diffusivity         { model Fuller; }
    }
}
