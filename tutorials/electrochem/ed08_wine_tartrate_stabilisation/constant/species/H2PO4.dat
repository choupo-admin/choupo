/*--------------------------------*- Choupo -*--------------------------------*\
  species/H2PO4.dat -- CASE-LOCAL model species for the wine tutorial ed08.

  Body fields (name, formula, charge, MW, cpAvg298) are data/standards/
  species/H2PO4.dat's, verbatim (its hfAq/sAq are NOT curated there either);
  the transport block is this case's addition.
  THE TRANSPORT BLOCK IS AN ESTIMATE AND SAYS SO.  No limiting ionic
  conductivity of this anion could be READ from a primary source in the
  session that wrote this record (the measurements exist and are named in
  `notes` below, behind paywalls); a value written from memory would be an
  invisible falsehood, so the D0 is derived by a stated method from facts the
  tree already carries, marked `origin estimated; reviewStatus unverified;`
  and ANNOUNCED by the engine on every run that reads it.  Promotion to
  data/standards/ is a curation act reserved to a human review against the
  named primaries.
\*-----------------------------------------------------------------------------*/
recordType modelSpecies;
schemaVersion 1;

name    H2PO4;
formula     "H2PO4-";
charge  -1;
MW { value 96.987; unit g/mol;}
aqueousThermo
{
// Criss-Cobble 1964 (JACS 86, 5390, Table II, verbatim):
// T-AVERAGED partial molal heat capacity Cp-bar]_298^T,
// cal/mol/K on the CC ABSOLUTE single-ion scale.
cpAvg298
{
    model  crissCobble1964;
    scale  crissCobbleAbsolute;
    units  "cal/mol/K";
    averageFrom298
    (
        { T 298.15; value -55; }
        { T 333.15; value -31; }
        { T 373.15; value -23; }
        { T 423.15; value -39; }
        { T 473.15; value -41; }
    );
    potentiometric true;   // CC note b (cell-potential dT, larger errors)
    source "Criss & Cobble, JACS 86 (1964) 5390, Table II";
}
}

transport
{
    D0 { value 1.06e-9; unit m2/s; }
    provenance
    {
        source  "no primary read; derived from the tree's own records as stated in `method`";
        licence "this record's derivation is the project's own; the inputs are the catalogue's, cited in their own records";
        D0
        {
            origin        estimated;
            method        "set EQUAL to the catalogue D0 of the sulfate ion (data/standards/species/SO4.dat, 1.06e-9 m2/s): a tetrahedral oxyanion of the same size, one charge fewer -- the mobility a unit charge on that frame gives, lambda0 = 39.8 S cm2/mol by Nernst-Einstein";
            reviewStatus  unverified;
            notes         "Verify against Selvaratnam and Spiro, Trans. Faraday Soc. 61 (1965) 360 (transference numbers of orthophosphoric acid and the limiting equivalent conductance of H2PO4- at 25 C) or Pethybridge, Talbot and House, J. Solution Chem. 35 (2006) 1055; neither could be read here.";
        }
    }
}
