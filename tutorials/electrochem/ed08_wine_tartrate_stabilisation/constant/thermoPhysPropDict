/*---------------------------------------------------------------------------*\
  thermoPhysPropDict (v2) -- the wine as an ionic analysis in a water carrier.

  Fourteen components: water and thirteen ions, each a case-local component
  bridged to its model species (constant/components/, constant/species/ and
  the catalogue's species/).  ETHANOL IS NOT AMONG THEM -- it cannot be: the
  stack sends every non-water component through the aqueous-species bridge
  and refuses one with no species row (system/flowsheetDict, first
  paragraph).  The aqueous activity model is declared here, once, and the
  stack READS it.
\*---------------------------------------------------------------------------*/

recordType    thermophysicalPropertySystem;
schemaVersion 2;

//  The ORDER of this list is part of what the conductivity target is
//  order-INDEPENDENT of (the demin target, `targetDemin`, would read the
//  FIRST cation -- K here -- as its reference ion; see the header).
components       ( water  K  Na  Ca  Mg  H  Cl  SO4  HTart  Tart  HMal  Mal  Lactate  H2PO4 );

equilibrium
{
    formulation gammaPhi;

    liquid
    {
        activityModel ideal;
        standardState pureLiquid;
    }

    // The liquid IS an aqueous electrolyte solution -- declared here, once,
    // independently of the phase equilibrium above (this stack computes no
    // VLE).  Davies on an ionic strength of about 0.04 mol/kg.
    aqueous
    {
        activityModel { model davies; }
    }

    vapour
    {
        fugacityModel idealGas;
    }
}

//  THE LIQUID VISCOSITY IS DECLARED, and the limiting-current model reads it
//  twice (at 293.15 K for Re and Sc, at 298.15 K to correct the curated ion
//  D0 through Stokes-Einstein) -- on PURE WATER: the engine prices the
//  solvent as water at the run temperature, and this wine's ethanol is not
//  in the composition (header, first paragraph).
transport
{
    liquid
    {
        viscosity { model Vogel; }
    }
}
