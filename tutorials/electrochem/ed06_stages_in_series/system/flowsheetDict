        (
            { from ST3.power;  kind work;  target W_shaft; }
        );
    }
    {
        name        ST4;
        type        electrodialysisStack;
        inputs      ( D3  C3 );
        outputs     ( D4  C4 );

        operation
        {
            stack             EurodiaED-100P-50;
            membrane          CMX_AMX;      // the record names no pair -- the CASE must
            targetDemin       0.6;          // each stage removes 60 % of ITS OWN inlet
            xi                0.9;
            E_electrodes      2.0;          // V (raw SI), lumped, announced
        }

        energyOutputs
