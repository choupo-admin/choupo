/*---------------------------------------------------------------------------*\
  solverDict -- the recycle plan.  Two cuts, both in the synthesis loop:
  the MATERIAL recycle (Recycle, the separator vapour going back) and the
  ENERGY recycle (HotEffluent, bed 3's outlet that preheats bed 1's
  feed in the FEHE, through three kinetic beds).
\*---------------------------------------------------------------------------*/
tearStreams        ( Recycle  HotEffluent );
recycleSolver       Newton;
recycleTol          1e-8;
recycleMaxIter      200;
