//  CATALYST BED 2 of 3 -- an ADIABATIC plug-flow bed on the Dyson & Simon
//  (1968) rate law for an IRON catalyst (constant/reactions).  Its inlet
//  temperature is set by the interbed cooler before it; its outlet
//  temperature and conversion are RESULTS.
//
//  THE VOLUME IS SOLVED so the effluent is 5 K short of equilibrium -- the
//  per-bed approach of US 5,352,428 (Bhakta & Grotz 1994), the same source
//  and value the base case's Gibbs converter declares, read through this
//  bed's own `approach_K` KPI (T* from the rate law's own Ka).  The volume is
//  `$V_Bed2`, declared in the plant's `variables {}` and solved by the
//  DesignSpec in system/outerDict; Bed1's header says how a folder reaches it.
//  Its diameter (the converter's), particle, void fraction and allowable
//  drop: Bed1's header.

type      pfr;
operation
{
    V_R          $V_Bed2;       // catalyst bed -- SOLVED by system/outerDict; see above
    nSteps       400;           // RK4 axial steps
    thermalMode  adiabatic;     // T is a RESULT: the bed heats itself
    diameter     $D_converter;  // the CONVERTER's one diameter -- see Bed1's header
    catalyst     { particleDiameter 8 mm; }                        // AUTHOR-SET, see above
    pressureDrop { model Ergun;  voidFraction 0.40;  allowable 1 bar; }   // AUTHOR-SET, see above
}
reactions ( ammoniaSynthesis );
boundary  { inlets ( Feed );  outlets ( Out ); }
