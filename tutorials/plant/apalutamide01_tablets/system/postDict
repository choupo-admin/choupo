/*---------------------------------------------------------------------------*\
  postDict -- sizing, costing and economics of the apalutamide tablet plant.

  WHAT IS SIZED (and so costed, and placed on the plot plan): the equipment
  of the SOLUTION, SPRAY-DRYING AND SOLVENT-RECOVERY section, for which the
  engine has a sizer and the costing a correlation --

    SD                 sprayDryer   sized on its evaporation (Turton's key is
                                    the WATER evaporated; here it is acetone,
                                    whose latent heat per kg is about a fifth
                                    of water's -- the correlation is applied
                                    to a solvent it was not built for, said)
    blower             compressor   on its shaft power (1 kW: far below the
                                    correlation's range, announced on the run)
    gasHeater          shellTubeHX  A = Q/(U LMTD) against MP steam
    exhaustCooler      shellTubeHX  against cooling water
    solventCondenser   shellTubeHX  against ammonia refrigeration
    airHeater          shellTubeHX  against LP steam (the coating air)
    condensatePot      vessel       by vapour residence time
    solutionPrep       vessel       on a declared volume (one shift of solution)
    coatingSuspensionPrep  vessel   on a declared volume
    acetoneTank / recoveredTank     storage, LINKED to their flowsheet units

  WHAT IS NOT SIZED, AND HOW IT REACHES THE CAPITAL ANYWAY.  The blenders,
  the roller compactor, the mill, the screen, the tablet press, the coating
  pan and the packaging line are MASS-BALANCE PLACEHOLDERS in the flowsheet
  (`mixer` / `splitter` / `solidDryer`): Choupo has no sizer and no cost
  correlation for any of them, and it does not invent one.  Neither is the GMP
  BUILDING -- clean rooms, HVAC -- which in a drug-product plant is usually
  the largest single capital item.  They enter the capital as DECLARED
  QUOTES (`costing { quotes ( ... ); }` below, DEV.md 4c C98): one price per
  item, each an AUTHOR-SET PLACEHOLDER said so on its own line, for the group
  to replace with a vendor's quotation.  NOT in the capital still: the
  warehouse and the offices/QC laboratory as quoted items (the economics'
  siteFactor term is Turton's estimate of such auxiliary facilities), vent
  treatment for the purge, dust collection, cleaning systems.  The README
  (section 6) says what is in and what is not.

  EVERY DESIGN NUMBER BELOW IS AN AUTHOR-SET ASSUMPTION, said on its line,
  for the groups to replace; none cites a source because none was read.
  Rules followed: MATERIAL SS316 everywhere (product contact and an organic
  solvent; whether a non-contact item could be carbon steel is the groups'
  question); pressureDesign 2 bar (the loop runs at about 1.1 bar; a closed,
  INERTED dryer is not designed to contain a dust explosion -- that is what
  the nitrogen is for, and the README discusses it); vessels with a fully
  radiographed joint, 1.5 mm corrosion allowance and L/D 1.5, declared so
  that no engine default is used silently.
\*---------------------------------------------------------------------------*/

sizing
{
    units
    (
        //  ---- the spray dryer --------------------------------------------
        { unitName SD;  type sprayDryer;  material SS316;
          designRules { pressureDesign 2; } }

        //  ---- the loop blower ---------------------------------------------
        { unitName blower;  type compressor;  material SS316;
          designRules { pressureDesign 2; } }

        //  ---- the exchangers: A = Q/(U LMTD), LMTD computed against the
        //  utility record; every U is a gas-side film against condensing
        //  steam, water or a boiling refrigerant -- ASSUMED.
        { unitName gasHeater;  type shellTubeHX;  material SS316;
          designRules { utility steamMP;  U 40;  pressureDesign 2; } }
        { unitName exhaustCooler;  type shellTubeHX;  material SS316;
          designRules { utility coolingWater;  U 40;  pressureDesign 2; } }
        { unitName solventCondenser;  type shellTubeHX;  material SS316;
          designRules { utility refrigerationNH3;  U 60;  pressureDesign 2; } }
        { unitName airHeater;  type shellTubeHX;  material SS316;
          designRules { utility steamLP;  U 40;  pressureDesign 2; } }

        //  ---- the condensate pot: 10 s of the gas it parts the condensate
        //  from (V = Q_vapour x tau, ideal gas) -- ASSUMED; its liquid
        //  holdup is not in this basis, so the volume is a LOWER BOUND.
        { unitName condensatePot;  type vessel;  material SS316;
          designRules { residenceTime 10;  flowKey F_beta;  flowUnit kmol/s;
                        L_over_D 1.5;  pressureDesign 2;
                        corrosionAllow 0.0015;  jointEfficiency 1.0; } }

        //  ---- the two preparation tanks, on DECLARED volumes ------------
        //  The solution tank holds one shift (8 h) of spray solution:
        //  8 h x 30.72 kg/h / 790 kg/m3 = 0.31 m3, at a 0.6 working fill
        //  0.52 m3 -> 0.5 m3.  A hand calculation on the base case: redo it
        //  when the basis moves (it does not follow the run).
        { unitName solutionPrep;  type vessel;  material SS316;
          designRules { volume 0.5;  L_over_D 1.5;  pressureDesign 2;
                        corrosionAllow 0.0015;  jointEfficiency 1.0; } }
        //  The coating-suspension tank: one shift is 8.8 kg, about 8 L; it
        //  is declared at 0.1 m3, the smallest stirred vessel a coating
        //  suspension is usually made in -- an ASSUMPTION, not a calculation.
        { unitName coatingSuspensionPrep;  type vessel;  material SS316;
          designRules { volume 0.1;  L_over_D 1.5;  pressureDesign 2;
                        corrosionAllow 0.0015;  jointEfficiency 1.0; } }
    );

    //  ---- the two acetone tanks, LINKED to their storageTank units (the
    //  hold time has one home: system/flowsheetDict) -----------------------
    storage
    (
        { unit acetoneTank;    material SS316;  maxTankVolume 30000; }
        { unit recoveredTank;  material SS316;  maxTankVolume 30000; }
    );
}

costing
{
    method    Turton;
    year      2026;
    cepci     820;        // a projection -- AUTHOR-SET (greenAmmoniaPEQ's)
    cepci2001 397;        // the correlations' own basis year
    usdToEur  0.92;

    //  THE DECLARED QUOTES (DEV.md 4c C98).  EVERY VALUE BELOW IS AN
    //  AUTHOR-SET PLACEHOLDER -- a round number of the right order chosen so
    //  that the solid-dose train and its building are not ZERO in the
    //  capital -- and none is a vendor's price.  A group replaces each one
    //  with a dated quotation (vendor, reference, date in `source`) and says
    //  whether it is the installed price (`basis installed;`) or an
    //  ex-works price (`basis purchased;` with its own `bareModuleFactor`
    //  and `bareModuleFactorSource`).  All are in 2026 money, the costing
    //  year, so no index is applied.  `kind equipment;` is a machine: in the
    //  FCI it also drives the auxiliary-facilities estimate (siteFactor x
    //  base) like any module; `kind facility;` is the building, which does
    //  not (it IS a facility).
    quotes
    (
        { unit tabletPress;  value 1000000;  currency EUR;  year 2026;
          basis installed;  kind equipment;
          source "author-set placeholder (DEV.md 4c C98), not a quotation";
          reason "a rotary tablet press installed in its suite, a round figure; replace with the press vendor's quotation for the chosen model and its tooling"; }
        { unit blender;  value 300000;  currency EUR;  year 2026;
          basis installed;  kind equipment;
          source "author-set placeholder (DEV.md 4c C98), not a quotation";
          reason "the intragranular bin blender and its bins, a round figure; replace with a vendor quotation"; }
        { unit rollerCompactor;  value 600000;  currency EUR;  year 2026;
          basis installed;  kind equipment;
          source "author-set placeholder (DEV.md 4c C98), not a quotation";
          reason "a roller compactor with its feeder, a round figure; replace with a vendor quotation"; }
        { unit mill;  value 150000;  currency EUR;  year 2026;
          basis installed;  kind equipment;
          source "author-set placeholder (DEV.md 4c C98), not a quotation";
          reason "the granulating mill AND the screen below it (the flowsheet's `screen` carries no quote of its own), a round figure; replace with a vendor quotation"; }
        { unit finalBlender;  value 300000;  currency EUR;  year 2026;
          basis installed;  kind equipment;
          source "author-set placeholder (DEV.md 4c C98), not a quotation";
          reason "the extragranular (final) blender, a round figure; replace with a vendor quotation"; }
        { unit coatingPan;  value 800000;  currency EUR;  year 2026;
          basis installed;  kind equipment;
          source "author-set placeholder (DEV.md 4c C98), not a quotation";
          reason "a perforated pan coater with its spray system and its air handling -- the flowsheet's `coatingDryer` is the drying half of the same machine and carries no quote of its own -- a round figure; replace with a vendor quotation"; }
        { unit packagingLine;  value 1500000;  currency EUR;  year 2026;
          basis installed;  kind equipment;
          source "author-set placeholder (DEV.md 4c C98), not a quotation";
          reason "a bottle or blister line with serialisation, a round figure; replace with a vendor quotation"; }
        { item productionBuilding;  value 11000000;  currency EUR;  year 2026;
          basis installed;  kind facility;
          source "author-set placeholder (DEV.md 4c C98), not a quotation or a building estimate";
          reason "the GMP building of the solid-dose train, the layout's 50 m x 36 m `productionBuilding` box (1800 m2) at a round 6000 EUR per m2 of footprint for clean rooms, HVAC and services; replace with a contractor's estimate for the group's own building"; }
    );
}

economics
{
    method              discountedCashFlow;
    projectLife         10;          // yr -- ASSUMED (a product's market life
                                     // after a generic launch is the groups'
                                     // question)
    constructionPeriod  1;
    discountRate        0.10;        // ASSUMED
    taxRate             0.21;        // ASSUMED (a corporate rate, no country chosen)
    depreciation        straightLine;
    depreciableLife     7;           // yr -- ASSUMED
    salvageFraction     0.0;
    //  THE OPERATING HOURS.  The plant runs in CAMPAIGNS, and this steady
    //  case is the plant AT its campaign rate: 0.45 x 8760 h = 3942 h/yr on
    //  stream gives 12 672 x 3942 = 49.95 million tablets a year.  An
    //  AUTHOR-SET ASSUMPTION; the campaign plan behind it (how the line is
    //  shared, cleaned and changed over) is the groups' question.
    streamFactor        0.45;
    siteFactor          0.50;
    contingencyFee      1.18;
    //  Non-particulate processing steps (Turton's operator count): the
    //  blower, the four exchangers.  The PARTICULATE steps are counted apart,
    //  in `particulateSteps` below (Turton's P, DEV.md 4c C98).
    N_np                5;
    particulateSteps
    {
        count   6;
        source  "the case's own count (DEV.md 4c C98): spray drying, blending, roller compaction, milling and screening, tableting, coating -- the final blend and packaging folded into their neighbours";
        reason  "Turton's P counts the processing steps that handle particulate solids; this plant's train is six of them.  P enters SQUARED (31.7 P^2): at P = 6 the formula staffs about 34 operators a shift.  With the crew below declared, P drives only the printed COMPARISON";
    }

    //  THE OPERATING CREW, DECLARED (DEV.md 4c C98 round 2).  The labour is
    //  priced from THIS crew, not from Turton's correlation, which is a
    //  regression over CONTINUOUS chemical plants: it grows with the number
    //  of processing steps (and with P squared), while a campaign
    //  drug-product suite is staffed ROOM BY ROOM -- one press operator runs
    //  one press whatever the plant around it.  The run prints the
    //  correlation beside this crew as a comparison.  EVERY NUMBER BELOW IS
    //  AN AUTHOR-SET ASSUMPTION: replace it with the group's own staffing
    //  plan (operators per room per shift, from the campaign hours of README
    //  section 9, question 3).  The 4.5 positions per operator-per-shift the
    //  engine applies assumes round-the-clock cover; a line run on fewer
    //  shifts than that is the group's question.
    operatingCrew
    {
        areas
        (
            { area "solvent section";   operatorsPerShift 2; }  // solution prep, spray dryer, N2 loop, recovery
            { area "dispensing";        operatorsPerShift 1; }
            { area "dry granulation";   operatorsPerShift 2; }  // blending, roller compaction, milling, screening
            { area "compression";       operatorsPerShift 1; }  // the tablet press
            { area "coating";           operatorsPerShift 1; }
            { area "packaging";         operatorsPerShift 3; }
            { area "material handling"; operatorsPerShift 1; }  // containers, IPC samples, warehouse runs
        );
        source  "author-set assumption (DEV.md 4c C98 round 2), not a staffing study";
        reason  "a campaign oral-solid-dose suite is staffed per room and per running machine; the numbers are round figures of the right order for ONE line -- replace them with the group's staffing plan";
    }
    estimateClass       5;           // concept screening: the solids train is priced on placeholders
    accuracyBand        ( -50 100 ); // Class 5, the wide corner -- chosen
    refuseOnMissingPrice 1;

    workingCapital
    {
        //  60 days of raw materials in the warehouse: quarantine, sampling
        //  and QC release of every incoming lot before use (GMP) plus the
        //  supply cycle -- ASSUMED.  The acetone in its tank is counted by
        //  that tank, not here.
        rawMaterialStock   60 day;
        receivables        60 day;   // ASSUMED: wholesaler terms
        payables           30 day;   // ASSUMED
        minimumCash        15 day;
    }

    land
    {
        price   80;      // EUR per m2 of plot
        source  "placeholder for the groups' site; not a market quotation";
        reason  "a round number so that the land appears in the capital and the cash flow; replace it with the price of the site the group chooses";
    }
}

