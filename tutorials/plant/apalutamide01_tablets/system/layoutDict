            zones   ( { zone 1; radius 3 m; height 4 m; } { zone 2; radius 6 m; height 5 m; } );
        }
    }
    {
        item        "recoveredTank/tank1";
        x           14 m;
        y           -14 m;
        z           0 m;
        orientation alongX;
        footprint   { length 2.0 m; width 2.0 m; height 2.0 m; }   // author-set
        release
        {
            source  "author-set assumption for the group to replace with its own site data; not taken from any hazardous-area standard";
            reason  "recovered acetone, cold but warming: the vent and a spill inside the bund";
            zones   ( { zone 1; radius 3 m; height 4 m; } { zone 2; radius 6 m; height 5 m; } );
        }
    }

    //  ================ THE COATING UTILITIES (see the header) ==========
    //  The coating air heater stands on the production building's ROOF, in
    //  the coater's air-handling unit (z = the roof).  A = 0.86 m2 -- by
    //  hand, a small coil.
    {
        item        "airHeater";
        x           -30 m;
        y           10 m;
        z           10 m;
        orientation alongX;
        footprint   { length 1.5 m; width 0.4 m; height 0.6 m; }   // author-set
    }
    {
        item        "coatingSuspensionPrep";   // D and H from its own sizing
        x           -16 m;
        y           12 m;
        z           0 m;
        orientation vertical;
    }

    //  ======================== THE SITE BUILDINGS ======================
    {
        nonProcess  "productionBuilding";
        kind        productionBuilding;
        x           -45 m;
        y           0 m;
        z           0 m;
        orientation alongX;
        footprint   { length 50 m; width 36 m; height 10 m; }
        source      "author-set assumption for the group to replace; not a building design";
        reason      "the GMP building of the solid-dose train (dispensing to packaging); its interior is the `building {}` block at the end of this file";
        ignition    "general-purpose electrical equipment, presses and coaters, and people: treated as an ignition source";
    }
    {
        nonProcess  "warehouse";
        kind        warehouse;
        x           -45 m;
        y           -40 m;
        z           0 m;
        orientation alongX;
        footprint   { length 50 m; width 20 m; height 10 m; }
        source      "author-set assumption for the group to replace; not a building design";
        reason      "raw materials in quarantine and released, the packed product awaiting release; on the site road so trucks unload at its doors";
        ignition    "forklift trucks and people: treated as an ignition source";
    }
    {
