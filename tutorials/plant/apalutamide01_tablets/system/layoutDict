        x           4 m;
        y           -14 m;
        z           0 m;
        orientation alongX;
        footprint   { length 2.6 m; width 2.6 m; height 2.6 m; }   // author-set
        release
        {
            source  "author-set assumption for the group to replace with its own site data; not taken from any hazardous-area standard";
