separation
(
    {
        source  "author-set assumption for the group to replace with its own site data; not taken from any published spacing table";
        reason  "round numbers chosen so that the check is visible on this plant; a real project takes its distances from the standard its client and its insurer specify, with that standard's permission";
        measure edgeToEdge;
        distances
        (
            { between ( vessel vessel );                       distance 3 m;  }
            { between ( sprayDryer vessel );                   distance 3 m;  }
            { between ( storageTank storageTank );             distance 5 m;  }
            { between ( storageTank vessel );                  distance 8 m;  }
            { between ( productionBuilding vessel );           distance 15 m; }
            { between ( productionBuilding sprayDryer );       distance 20 m; }
            { between ( productionBuilding storageTank );      distance 20 m; }
            { between ( storageTank warehouse );               distance 20 m; }
            { between ( officesAndLaboratory storageTank );    distance 30 m; }
            { between ( officesAndLaboratory sprayDryer );     distance 30 m; }
        );
    }
