//  The prevailing wind blows FROM THE WEST (true bearing 270 deg) and the
//  plot plan's +y points north: the buildings are upwind of the solvent
//  area, so a release drifts away from the people.  An ignition source
//  within +/- 30 deg of downwind and 60 m of a release is announced.
wind
{
    from        270 deg;
    planNorth   0 deg;
    halfAngle   30 deg;
    reach       60 m;
    source      "author-set assumption for the group to replace with its own site data; not a measured wind rose";
    reason      "a prevailing direction lets the plot plan be read for which way a release drifts";
}

//  THE PIPE RACK, south of the solvent area: the drying-gas loop, the
//  solvent lines and the utilities.  It stops 2 m short of the road between
//  the production building and the solvent area.
pipeRack
{
    y            -6 m;
    elevation    6 m;
    laneSpacing  0.4 m;
    lanesPerTier 6;
    tierSpacing  1.2 m;
    xStart       -8 m;
    xEnd         30 m;
    reason       "author-set assumption for the group to replace: a short rack between the solvent area and its tanks, clear of every road";
}

//  The coating air is drawn from the atmosphere at the air-handling unit's
//  intake ON THE ROOF, beside the heater -- not carried from the rack's west
//  end through the building's wall, which is where the router alone would
//  put it (the engine announced that run as a `pipeClash`).  A battery
//  limit adds no point, so the route is this one waypoint, 0.4 m above the
//  heater's top, and down into it.
pipes
{
    coatingAirIn { waypoints ( { x -30 m; y 10 m; z 11 m; } ); }
}

