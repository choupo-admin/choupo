/*---------------------------------------------------------------------------*\
  layoutDict -- the PLOT PLAN of the apalutamide tablet plant (DEV.md 4c C97,
  phase A).  A STARTING POINT for the group, to copy and change.

  HOW IT WAS MADE.  `bin/choupo-layout --draft` placed the four items whose
  sizers publish a diameter and a height (the spray dryer and three
  vessels) on one line; it was then arranged by hand into a SOLVENT AREA
  east of the buildings and a TANK AREA south of the pipe rack, with the
  site buildings as NON-PROCESS items.

  THE SITE, west to east, with the prevailing wind FROM THE WEST (below):
    * the offices and the quality-control laboratory, and the gate;
    * the WAREHOUSE (raw materials in quarantine, released materials, the
      packed product awaiting release);
    * the GMP PRODUCTION BUILDING: dispensing, blending, roller
      compaction, milling, final blending, tableting, film coating and
      packaging all happen INSIDE it.  None of those machines is a sized
      item (they are mass-balance placeholders in the flowsheet), so the
      building is ONE declared box here.  ITS INTERIOR -- rooms, cleanliness
      grades, the pressure cascade, the flows of people, material and waste
      -- is PHASE B of DEV.md 4c C97 and will plug in HERE, as the interior
      of this `productionBuilding` item; nothing in this file is drawn
      inside it today;
    * the SOLVENT AREA, downwind: the solution tank, the spray dryer and its
      closed nitrogen loop (heater, blower, exhaust cooler, condenser,
      condensate pot), with the acetone tanks south of the rack.  Everything
      that holds acetone is out here, away from people and from ignition
      sources, and its hazardous-area zones are declared.

  WHAT IS THE ENGINE'S AND WHAT IS OURS.  The spray dryer's chamber and the
  three vessels' diameters and heights are their sizers' own; the
  exchangers, the blower and the tanks publish an AREA, a POWER or a
  VOLUME, not a shape, so their plan boxes are DECLARED below (each with
  the arithmetic).  EVERYTHING ELSE IS AN AUTHOR-SET ASSUMPTION FOR THE
  GROUP TO REPLACE WITH ITS OWN SITE DATA: every position, every building's
  size, every separation distance, the wind and every hazardous-area zone.
  They are round numbers chosen so that the checks are visible on this
  plant, not values from any spacing or hazardous-area standard: the
  published ones (IEC 60079-10-1 and its national codes for zones; company
  and insurance spacing guides) grant no redistribution, and a citation
  invented for a round number would turn "unsourced" into "falsely sourced".

  ONE FINDING IS LEFT ON PURPOSE: the coating-suspension tank stands 4 m
  from the production building, inside the 15 m the separation table asks
  between a `vessel` and a building.  The check reads the equipment KIND,
  not what the vessel holds -- this one holds a water suspension of a
  polymer and pigments, nothing that burns.  The group must either justify
  the distance or, better, put the tank where it belongs: inside the coating
  suite, which is phase B.

  WHAT THE ROUTER DRAWS THAT A PHARMACEUTICAL PLANT DOES NOT HAVE.  The
  engine routes EVERY material stream as a pipe on the rack, and it places
  every unsized mixer and splitter -- here the blenders, the compactor, the
  mill, the screen, the press, the coating pan and the packaging line -- as
  a JUNCTION on the rack.  So the powders after the spray dryer are drawn as
  pipes along the rack.  They are not: in the plant they move in closed
  containers (bins, IBCs) inside the production building, and the bought
  powders arrive by truck in drums and bags.  The router cannot be told so
  today; read those lines as "the material goes from here to there", and
  see the README (section 7).

  Grammar and checks: docs/design/a-plant-layout-is-declared-and-checked.md
\*---------------------------------------------------------------------------*/

items
(
    //  ======================== THE SOLVENT AREA ========================
    {
        item        "solutionPrep";      // D and H from its own sizing (0.5 m3)
        x           2 m;
        y           0 m;
        z           0 m;
        orientation vertical;
        release
        {
            source  "author-set assumption for the group to replace with its own site data; not taken from any hazardous-area standard";
            reason  "acetone at 25 C: the manway is opened to charge the API and the polymer, the classic moment a solvent vapour and a powder cloud meet";
            zones   ( { zone 1; radius 1.5 m; height 2.5 m; } { zone 2; radius 4 m; height 4 m; } );
        }
    }
    {
        item        "SD";                // the chamber's D and H from its own sizing
        x           8 m;
        y           0 m;
        z           0 m;
        orientation vertical;
        release
        {
            source  "author-set assumption for the group to replace with its own site data; not taken from any hazardous-area standard";
            reason  "acetone vapour in nitrogen inside a CLOSED, INERTED loop: only the flanges, the atomiser seal and the powder discharge valve can release";
            zones   ( { zone 2; radius 3 m; height 5 m; } );
        }
    }
    //  The gas heater: A = 2.61 m2 (design/gasHeater), about 30 tubes of
    //  19 mm by 1.5 m in a shell of the order of 0.3 m -- by hand.
    {
        item        "gasHeater";
        x           8 m;
        y           5 m;
        z           0 m;
        orientation alongX;
        footprint   { length 2.5 m; width 0.5 m; height 0.7 m; }   // author-set
    }
    //  The loop blower and its motor on a skid -- by hand; the sizer
    //  publishes a power (1 kW), not a shape.
    {
        item        "blower";
        x           14 m;
        y           5 m;
        z           0 m;
        orientation alongX;
        footprint   { length 1.5 m; width 1.0 m; height 1.2 m; }   // author-set
        release
        {
            source  "author-set assumption for the group to replace with its own site data; not taken from any hazardous-area standard";
            reason  "nitrogen with acetone vapour across the shaft seal";
            zones   ( { zone 2; radius 2 m; height 3 m; } );
        }
    }
    //  The exhaust cooler: A = 5.02 m2 -- about 60 tubes of 19 mm by 1.5 m.
    {
        item        "exhaustCooler";
        x           14 m;
        y           0 m;
        z           0 m;
        orientation alongX;
        footprint   { length 2.5 m; width 0.6 m; height 0.8 m; }   // author-set
    }
    //  The solvent condenser: A = 3.54 m2 -- about 40 tubes of 19 mm by 1.5 m.
    {
        item        "solventCondenser";
        x           20 m;
        y           0 m;
        z           0 m;
        orientation alongX;
        footprint   { length 2.5 m; width 0.5 m; height 0.7 m; }   // author-set
    }
    {
        item        "condensatePot";     // D and H from its own sizing
        x           25 m;
        y           0 m;
        z           0 m;
        orientation vertical;
        release
        {
            source  "author-set assumption for the group to replace with its own site data; not taken from any hazardous-area standard";
            reason  "liquid acetone at -10 C: the drain and the level connections";
            zones   ( { zone 2; radius 3 m; height 4 m; } );
        }
    }

    //  ======================== THE TANK AREA ===========================
    //  A tank publishes its VOLUME, so each plan box is DECLARED as the
    //  bounding box of an upright cylinder that holds it:
    //    acetoneTank/tank1    13.83 m3: D 2.6 m x H 2.6 m (pi/4 x 2.6^2 x 2.6 = 13.80)
    //    recoveredTank/tank1   6.18 m3: D 2.0 m x H 2.0 m (pi/4 x 2.0^2 x 2.0 =  6.28)
    //  Redo the boxes when the hold times or the basis move.
    {
        item        "acetoneTank/tank1";
        x           4 m;
        y           -14 m;
        z           0 m;
        orientation alongX;
        footprint   { length 2.6 m; width 2.6 m; height 2.6 m; }   // author-set
        release
        {
            source  "author-set assumption for the group to replace with its own site data; not taken from any hazardous-area standard";
            reason  "acetone vapour breathed out of the vent as the tank fills and as the sun warms it, and a spill inside the bund";
            zones   ( { zone 1; radius 3 m; height 4 m; } { zone 2; radius 6 m; height 5 m; } );
        }
    }
    {
        item        "recoveredTank/tank1";
        x           14 m;
        y           -14 m;
        z           0 m;
        orientation alongX;
        footprint   { length 2.0 m; width 2.0 m; height 2.0 m; }   // author-set
        release
        {
            source  "author-set assumption for the group to replace with its own site data; not taken from any hazardous-area standard";
            reason  "recovered acetone, cold but warming: the vent and a spill inside the bund";
            zones   ( { zone 1; radius 3 m; height 4 m; } { zone 2; radius 6 m; height 5 m; } );
        }
    }

    //  ================ THE COATING UTILITIES (see the header) ==========
    //  The coating air heater stands on the production building's ROOF, in
    //  the coater's air-handling unit (z = the roof).  A = 0.86 m2 -- by
    //  hand, a small coil.
    {
        item        "airHeater";
        x           -30 m;
        y           10 m;
        z           10 m;
        orientation alongX;
        footprint   { length 1.5 m; width 0.4 m; height 0.6 m; }   // author-set
    }
    {
        item        "coatingSuspensionPrep";   // D and H from its own sizing
        x           -16 m;
        y           12 m;
        z           0 m;
        orientation vertical;
    }

    //  ======================== THE SITE BUILDINGS ======================
    {
        nonProcess  "productionBuilding";
        kind        productionBuilding;
        x           -45 m;
        y           0 m;
        z           0 m;
        orientation alongX;
        footprint   { length 50 m; width 36 m; height 10 m; }
        source      "author-set assumption for the group to replace; not a building design";
        reason      "the GMP building of the solid-dose train (dispensing to packaging); its interior is phase B of DEV.md 4c C97";
        ignition    "general-purpose electrical equipment, presses and coaters, and people: treated as an ignition source";
    }
    {
        nonProcess  "warehouse";
        kind        warehouse;
        x           -45 m;
        y           -40 m;
        z           0 m;
        orientation alongX;
        footprint   { length 50 m; width 20 m; height 10 m; }
        source      "author-set assumption for the group to replace; not a building design";
        reason      "raw materials in quarantine and released, the packed product awaiting release; on the site road so trucks unload at its doors";
        ignition    "forklift trucks and people: treated as an ignition source";
    }
    {
        nonProcess  "officesAndQC";
        kind        officesAndLaboratory;
        x           -90 m;
        y           -5 m;
        z           0 m;
        orientation alongY;
        footprint   { length 30 m; width 16 m; height 8 m; }
        source      "author-set assumption for the group to replace; not a building design";
        reason      "offices and the quality-control laboratory that releases every lot; upwind of everything, beside the gate";
        ignition    "a laboratory (hot plates, ovens) and people: treated as an ignition source";
    }
    {
        nonProcess  "gate";
        kind        gate;
        x           -106 m;
        y           -54 m;
        z           0 m;
        orientation alongX;
        footprint   { length 4 m; width 3 m; height 3 m; }
        source      "author-set assumption for the group to replace; not a building design";
        reason      "the site entrance: a guardhouse beside the site road and its barrier";
    }
);

separation
(
    {
        source  "author-set assumption for the group to replace with its own site data; not taken from any published spacing table";
        reason  "round numbers chosen so that the check is visible on this plant; a real project takes its distances from the standard its client and its insurer specify, with that standard's permission";
        measure edgeToEdge;
        distances
        (
            { between ( vessel vessel );                       distance 3 m;  }
            { between ( sprayDryer vessel );                   distance 3 m;  }
            { between ( storageTank storageTank );             distance 5 m;  }
            { between ( storageTank vessel );                  distance 8 m;  }
            { between ( productionBuilding vessel );           distance 15 m; }
            { between ( productionBuilding sprayDryer );       distance 20 m; }
            { between ( productionBuilding storageTank );      distance 20 m; }
            { between ( storageTank warehouse );               distance 20 m; }
            { between ( officesAndLaboratory storageTank );    distance 30 m; }
            { between ( officesAndLaboratory sprayDryer );     distance 30 m; }
        );
    }
);

//  The prevailing wind blows FROM THE WEST (true bearing 270 deg) and the
//  plot plan's +y points north: the buildings are upwind of the solvent
//  area, so a release drifts away from the people.  An ignition source
//  within +/- 30 deg of downwind and 60 m of a release is announced.
wind
{
    from        270 deg;
    planNorth   0 deg;
    halfAngle   30 deg;
    reach       60 m;
    source      "author-set assumption for the group to replace with its own site data; not a measured wind rose";
    reason      "a prevailing direction lets the plot plan be read for which way a release drifts";
}

//  THE PIPE RACK, south of the solvent area: the drying-gas loop, the
//  solvent lines and the utilities.  It stops 2 m short of the road between
//  the production building and the solvent area.
pipeRack
{
    y            -6 m;
    elevation    6 m;
    laneSpacing  0.4 m;
    lanesPerTier 6;
    tierSpacing  1.2 m;
    xStart       -8 m;
    xEnd         30 m;
    reason       "author-set assumption for the group to replace: a short rack between the solvent area and its tanks, clear of every road";
}

roads
{
    source   "author-set assumption for the group to replace; not taken from a road or fire standard";
    reason   "one site road from the gate past the offices, the warehouse and the production building, and a loop round the solvent area so a fire tender reaches it from three sides";
    headroom 5 m;
    access
    {
        distance 25 m;
        source   "author-set assumption for the group to replace; not taken from a fire code";
        reason   "the reach of a fire tender's hoses from the road, as a round number";
    }
    noTraffic ( 1 );
    network
    (
        {
            road      "site";
            width     7 m;
            reason    "the gate to the east end of the site, past the warehouse doors";
            waypoints ( { x -110 m; y -60 m; } { x 36 m; y -60 m; } );
        }
        {
            road      "offices";
            width     6 m;
            reason    "to the offices and laboratory and their car park";
            waypoints ( { x -78 m; y -60 m; } { x -78 m; y 22 m; } );
        }
        {
            road      "buildingNorth";
            width     6 m;
            reason    "north of the production building: its goods-in and goods-out doors, and the coating annex";
            waypoints ( { x -78 m; y 22 m; } { x -12 m; y 22 m; } );
        }
        {
            road      "solventWest";
            width     6 m;
            reason    "between the production building and the solvent area, west of the rack";
            waypoints ( { x -12 m; y -60 m; } { x -12 m; y 22 m; } );
        }
        {
            road      "solventEast";
            width     6 m;
            reason    "east of the solvent area and the tanks, past the rack's end";
            waypoints ( { x 36 m; y -60 m; } { x 36 m; y 12 m; } );
        }
        {
            road      "solventNorth";
            width     6 m;
            reason    "north of the spray dryer and the blower, closing the loop round the solvent area";
            waypoints ( { x -12 m; y 12 m; } { x 36 m; y 12 m; } );
        }
    );
}

plot
{
    margin  5 m;
    reason  "author-set assumption for the group to replace: a fence and a clear strip inside it; not taken from any spacing standard";
}

