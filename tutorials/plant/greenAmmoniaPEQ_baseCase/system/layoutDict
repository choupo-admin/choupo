//  The prevailing wind blows FROM the north-west (true bearing 315 deg); the
//  plot plan's +y axis points to true north.  An ignition source within
//  +/- 30 deg of the DOWNWIND direction (south-east) and within 60 m of a
//  release source is announced.  The control room and the substation stand
//  upwind or across the wind of every release source, so nothing is; the
//  tank farm stands downwind of the process, away from both.
wind
{
    from        315 deg;
    planNorth   0 deg;
    halfAngle   30 deg;
    reach       60 m;
    source      "author-set assumption for the students to replace with their own site data; not a measured wind rose";
    reason      "a prevailing direction lets the plot plan be read for which way a release drifts";
}

//  THE PIPE RACK (DEV.md 4c C80).  Every stream between two placed items, or
//  through a mixer or splitter (drawn as a junction on the rack), or to a
//  battery limit, is routed by the engine: up from the top of its source,
//  across to its LANE on this rack, along it, and down to the top of its
//  target -- and its length is published (Reports -> "Plant layout (3D)",
//  the pipe register).  The rack runs along plan x between the compressor
//  row (y = -20 to -10) and the reaction row (y = 7 to 14); the plant's
//  inlets arrive at its west end (xStart) and its outlets leave at its east
//  end (xEnd), and each is carried from there to its crossing on the fence
//  (the `fence` block below).  EVERY NUMBER HERE IS AN AUTHOR-SET ASSUMPTION FOR THE
//  STUDENTS TO REPLACE: where a rack runs, how high and how wide, is a
//  design choice they must defend (road clearance, access, the length it
//  costs).  Delete the block and the engine routes on its stated default
//  rack, and says so.
pipeRack
{
    y            -2 m;
    elevation    7 m;
    laneSpacing  0.6 m;
    lanesPerTier 6;
    tierSpacing  1.2 m;
    xStart       -14 m;
    xEnd         100 m;
    reason       "author-set assumption for the students to replace: a rack between the compressor and the reaction rows, clear of the roads at 7 m, its east end the process area's battery limit";
}

//  THE ROADS (2026-11-09; the method of ammonia02_full_plant, DEV.md 4c C90).
//  Centre lines at grade, 6 m wide (the entrance 7 m, two-way).  The MAIN
//  road runs south of the compressor row from the hydrogen buffer to the
//  EAST road; the east, NORTH and WEST roads close a ring round the process
//  block, so a fire tender reaches every item from two sides; the west road
//  runs on north as the ENTRANCE road to the main gate; the TANK-FARM road
//  leaves the east road along the north side of the bund to the emergency
//  gate.  The west and east roads cross UNDER the pipe rack (7 m, above the
//  5 m headroom).  The engine refuses a road through a footprint or under a
//  rack or pipe lower than the headroom, and announces a road no gate
//  reaches, a building no road serves and a process item with no road
//  within the access distance.  AUTHOR-SET ASSUMPTIONS throughout; no truck
//  route is declared (no process stream moves by road here).
roads
{
    source   "author-set assumption for this exercise; not taken from a road or fire standard";
    reason   "a ring road round the process block so a fire tender reaches every item from two sides, joined to the main gate by the entrance road, and a road along the tank farm to a second gate";
    headroom 5 m;
    access
    {
        distance 20 m;
        source   "author-set assumption for this exercise; not taken from a fire code";
        reason   "the reach of a fire tender's hoses and of a mobile crane parked on the road, as a round number";
    }
    noTraffic ( 1 );
    network
    (
        {
            road      "main";
            width     6 m;
            reason    "south of the compressor row, from the hydrogen buffer to the east road";
            waypoints ( { x -65 m; y -30 m; } { x 95 m; y -30 m; } );
        }
        {
            road      "east";
            width     6 m;
            reason    "past the storage flash, under the rack's east end, closing the ring";
            waypoints ( { x 95 m; y -30 m; } { x 95 m; y 30 m; } );
        }
        {
            road      "north";
            width     6 m;
            reason    "behind the loop: the converter, the separator and the let-down drums, clear of the loop kerb's pit";
            waypoints ( { x -10 m; y 30 m; } { x 95 m; y 30 m; } );
        }
        {
            road      "west";
            width     6 m;
            reason    "beside the nitrogen booster, under the rack's west end, closing the ring";
            waypoints ( { x -10 m; y -30 m; } { x -10 m; y 30 m; } );
        }
        {
            road      "entrance";
            width     7 m;
            reason    "the main gate to the ring, past the control room; two-way";
            waypoints ( { x -10 m; y 30 m; } { x -10 m; y 50 m; } );
        }
        {
            road      "tankFarm";
            width     6 m;
            reason    "along the north side of the tank bund to the emergency gate, so a fire tender reaches both tanks from the road";
            waypoints ( { x 95 m; y 3 m; } { x 215 m; y 3 m; } );
        }
        {
            road      "flareSpur";
            width     6 m;
            reason    "a spur north from the tank-farm road to the flare (2026-11-10), so a tender and a crane reach the stack's base and its pilot without crossing the process block";
            waypoints ( { x 190 m; y 3 m; } { x 190 m; y 38 m; } );
        }
    );
}

//  THE PLOT (DEV.md 4c C82).  The engine publishes the plot area as the
//  envelope of the placed footprints, the routed pipes and the declared
//  roads, grown on every side by this margin -- the fence and a clear strip
//  inside it.  The roads are declared above and inside the envelope, so the
//  margin no longer carries them (it was 10 m "for the perimeter road"
