    //  ---- the flare header: the three loop vessels that vent --------------
    {
        name      "Flare-Separator";
        service   flareHeader;
        from      "Separator";
        to        "flare";
        toPort    { side west; elevation 2 m; }
        reason    "the separator's relief and vent connection to the flare header (no relief valve is declared in this case: the line has no flow to carry)";
    }
    {
        name      "Flare-LetdownHP";
        service   flareHeader;
        from      "LetdownHP";
        to        "flare";
        toPort    { side west; elevation 2 m; }
