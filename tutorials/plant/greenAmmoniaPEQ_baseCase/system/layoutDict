        to        "Aftercooler";
        carries   { unit Aftercooler; utility coolingWater; }
        reason    "the make-up aftercooler's cooling water, from the tower";
    }
    {
        name      "CW-WaterCooler-supply";
        service   coolingWaterSupply;
        from      "coolingTower";
        to        "WaterCooler";
        carries   { unit WaterCooler; utility coolingWater; }
        reason    "the loop's water cooler, from the tower";
    }
    //  ---- cooling water, cooler to tower (return) -------------------------
    {
        name      "CW-N2Cooler-return";
        service   coolingWaterReturn;
        from      "N2Cooler";
        to        "coolingTower";
        carries   { unit N2Cooler; utility coolingWater; }
        reason    "the nitrogen cooler's warm water back to the tower";
    }
    {
        name      "CW-Intercooler-return";
        service   coolingWaterReturn;
        from      "Intercooler";
        to        "coolingTower";
        carries   { unit Intercooler; utility coolingWater; }
        reason    "the make-up intercooler's warm water back to the tower";
    }
    {
        name      "CW-Aftercooler-return";
        service   coolingWaterReturn;
        from      "Aftercooler";
        to        "coolingTower";
        carries   { unit Aftercooler; utility coolingWater; }
        reason    "the make-up aftercooler's warm water back to the tower";
    }
    {
        name      "CW-WaterCooler-return";
        service   coolingWaterReturn;
        from      "WaterCooler";
        to        "coolingTower";
        carries   { unit WaterCooler; utility coolingWater; }
