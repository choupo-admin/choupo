    elevation    6 m;
    laneSpacing  0.6 m;
    lanesPerTier 6;
    tierSpacing  1.5 m;
    xStart       -118 m;
    xEnd         130 m;
    reason       "author-set assumption for this exercise: one east-west rack north of the middle road, above the roads' 5 m headroom";
}

//  THE FENCE.  Drawn from the plot, opening at the gate (north).  The
//  three boundary streams cross it at published points; what lies beyond
//  is named here and NOT drawn.
fence
{
    source  "author-set assumption for this exercise; not taken from any site survey or fencing standard";
    reason  "the site boundary: the land the plot prices, closed by a fence with one gate, and the point where each pipeline enters or leaves the plant";
    inset   0 m;
    crossings
    (
        { stream seawater;   from "the open intake: the 1.6 km subsea pipeline from the Mediterranean (not drawn)";                       side south;  at -134 m; }
        { stream spentBrine; to   "the brine outfall: the concentrate line to its diffuser in the sea (not drawn)";                         side south;  at 75 m; }
        { stream product;    to   "the irrigation and potable network: the product main to the Campo de Dalias region (not drawn)";         side north;  at 70 m; }
    );
