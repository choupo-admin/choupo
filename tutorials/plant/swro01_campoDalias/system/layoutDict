//  THE TYPICAL TRAIN (DEV.md 4c C272).  Train 1's items are placed above, in
//  full; the other five trains are REPEATS of it, declared once here.  The
//  engine moves each member by (k - 1) x the pitch, takes its size from the
//  sized item of train k, stands it in the room the building lists for train
//  1's item, checks it and pipes it like any item (a header with a branch per
//  train), and publishes trains 2..6 as one OUTLINE per room, marked "typical
//  of train 1".  Two groups, because the pieces do not repeat on one pitch:
//  the pumps and racks step 19 m along x, one train beside the next; the
//  energy-recovery arrays stand in their own hall, stacked 5 m apart along y.
typicals
(
    {
        typical "train";
        index   "train";
        count   6;
        pitch   { x 19 m; y 0 m; }
        members ( "RO1/train1" "RO2a/train1" "RO2b/train1" "HPpump/train1" "Booster/train1" "Pass2Pump/train1" );
        source  "author-set assumption for this exercise: the six trains are identical, side by side on a 19 m pitch";
        reason  "the pump, the booster, the second-pass pump and the two passes' racks of one train repeat unchanged train after train";
    }
    {
        typical "erArray";
        index   "train";
        count   6;
        pitch   { x 0 m; y 5 m; }
        members ( "PX/train1" );
        source  "author-set assumption for this exercise: the six trains' energy-recovery skids stacked on a 5 m pitch along y";
        reason  "each train's array of pressure exchangers stands on its own skid, one beside the next in the energy-recovery hall";
    }
);

//  THE RO BUILDING (DEV.md 4c C100, C199).  One shell, four rooms the sized
//  items STAND IN (their base is the room's floor): the pump hall along the
//  south wall, the first-pass hall with the six trains' racks, the second-pass
//  hall north of it, and the energy-recovery hall on the east end.  A room of
//  an SWRO plant is not a clean room: every room is grade CNC at the outside
//  pressure, so the GMP cascade has nothing to say here and the engine's
//  checks that matter are the geometry ones (an item must fit its room, an
//  item inside a room must be listed by it).  EVERY DIMENSION IS AUTHOR-SET.
building
{
    name     "swro01 reverse-osmosis building";
    source   "author-set assumption for this exercise; not a building design";
    reason   "the building the six trains stand in: pumps, first and second pass racks and the energy-recovery arrays, as a real SWRO plant houses them";
    envelope roBuilding;

    cascade
    {
        minimumStep 10 Pa;
        source "unused: every room is CNC at the outside pressure, so no grade differential is asked of this building (the key is the grammar's required field)";
        reason "a reverse-osmosis hall is a wet industrial hall, not a clean room";
    }

    floors
    (
        { floor ground; elevation 0 m; height 10 m; }
    );

    rooms
    (
        { room pumpHall;  floor ground; xMin -115 m; xMax 8 m;  yMin -47 m; yMax -32 m; grade CNC; pressure 0 Pa; relativeTo outside;
          equipment ( HPpump/train1 Booster/train1 Pass2Pump/train1 );   // the repeats of trains 2..6 follow (`typicals`)
          source "author-set"; reason "the six trains' high-pressure pumps, boosters and second-pass pumps in one hall along the south wall, each pump in line with its train's racks"; }
        { room ro1Hall;   floor ground; xMin -115 m; xMax 8 m;  yMin -32 m; yMax 2 m;   grade CNC; pressure 0 Pa; relativeTo outside;
          equipment ( RO1/train1 );
          source "author-set"; reason "the first pass: the six trains' racks of seawater vessels, each bank's loading clearance at its east end"; }
        { room ro2Hall;   floor ground; xMin -115 m; xMax 8 m;  yMin 2 m;   yMax 16 m;  grade CNC; pressure 0 Pa; relativeTo outside;
          equipment ( RO2a/train1 RO2b/train1 );
          source "author-set"; reason "the second pass: the six trains' racks of brackish vessels, the 54-vessel and the 18-vessel stages"; }
        { room pxHall;    floor ground; xMin 8 m;    xMax 36 m; yMin -32 m; yMax 2 m;   grade CNC; pressure 0 Pa; relativeTo outside;
          equipment ( PX/train1 );
          source "author-set"; reason "the energy-recovery arrays of the six trains on skids beside the first-pass hall, the high-pressure brine and seawater headers short"; }
    );

    connections
    (
        { between ( pumpHall outside );  type door; }
        { between ( pumpHall ro1Hall );  type door; }
        { between ( ro1Hall ro2Hall );   type door; }
        { between ( ro1Hall pxHall );    type door; }
        { between ( ro2Hall outside );   type door; }
        { between ( pxHall outside );    type door; }
    );
}

