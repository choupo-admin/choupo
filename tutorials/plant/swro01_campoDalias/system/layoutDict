//  THE ROADS.  The spine runs from the gate down the west side of the
//  process halls, the south road along the north edge of the pretreatment,
//  the middle road between the two passes and the east road along the
//  chemical store, the substation and the product stores; the north road
//  closes the ring.  The rack (6 m) stands above the 5 m headroom.
roads
{
    source   "author-set assumption for this exercise; not taken from a road or fire standard";
    reason   "a ring road so a fire tender reaches every hall from two sides, joined to the gate by the spine";
    headroom 5 m;
    access
    {
        distance 20 m;
        source   "author-set assumption for this exercise; not taken from a fire code";
        reason   "the reach of a fire tender's hoses and of a mobile crane parked on the road, as a round number";
    }
    network
    (
        {
            road         "spine";
            width        6 m;
            cornerRadius 10 m;
            reason       "from the gate to the south road, between the administration and the process halls";
            waypoints    ( { x -122 m; y 134 m; } { x -122 m; y 128 m; } { x -122 m; y -51 m; } );
        }
        {
            road         "north";
            width        6 m;
            cornerRadius 10 m;
            reason       "north of the product stores, joining the spine to the east road";
            waypoints    ( { x -122 m; y 128 m; } { x 135 m; y 128 m; } );
        }
        {
            road         "south";
            width        6 m;
            cornerRadius 10 m;
            reason       "between the pretreatment and the first-pass hall, to the east road";
            waypoints    ( { x -122 m; y -51 m; } { x 135 m; y -51 m; } );
