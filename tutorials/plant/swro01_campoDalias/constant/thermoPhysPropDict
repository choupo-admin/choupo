/*---------------------------------------------------------------------------*\
  thermoPhysPropDict (v2) -- T1 ideal gamma-phi mixture, the salts as ONE
  lumped nonvolatile solute (NaCl, in OSMOTIC equivalence to the seawater of
  the case study's Table 2) and boron as a second solute that the modules split
  into boric acid and borate by the pH (constant/components/boron.dat; the
  declared aqueous chemistry below).  membrane01's form with one more solute.
\*---------------------------------------------------------------------------*/
recordType    thermophysicalPropertySystem;
schemaVersion 2;

components       ( water  NaCl  boron );

equilibrium
{
    formulation gammaPhi;
    liquid
    {
        activityModel ideal;
        standardState pureLiquid;
    }
    //  THE AQUEOUS CHEMISTRY THE BORON SPLIT READS (DEV.md 4c C198).  The liquid
    //  IS seawater: the module asks the package for the base fraction of the
    //  boron (H3BO3 + H2O = BOH4 + H, chemistry/BOH4-formation.dat) at its
    //  inlet bulk, and the activity model is the CASE'S.  Davies is the
    //  model the tree has that carries every ion here; at seawater strength
    //  (I ~ 0.6 mol/kg) it is beyond its own ~0.5 mol/kg band and the run says
    //  so -- the alpha at pass 1 is indicative, not quantitative.
    aqueous
    {
        activityModel { model davies; }
    }
    vapour
    {
        fugacityModel idealGas;
    }
}

// THE LIQUID DENSITY'S HYPOTHESIS (DEV.md 4c C378 pilot): the pump and the
// CSTR take their liquid density from the property kernel, which refuses a
// component with no liquid volume.  This case declares, with its bound set
// from its own feed, that the listed components keep their mass and add no
// volume -- what the pump did unannounced before the pilot.
approximations
{
    massWithoutVolume
    {
        components      ( NaCl );
        maxMassFraction 0.05;
        reason          "seawater RO plant: the salt keeps its mass and adds no volume to the pumps' liquid density (its mass fraction is about 0.035); the engine's own bound on this reading is about +1.8 % on rho at 1 mol/kg (AqueousVolumetric.H)";
    }
}
