/*---------------------------------------------------------------------------*\
  thermoPhysPropDict (v2) -- T1 ideal gamma-phi mixture, the salts as ONE
  lumped nonvolatile solute (NaCl, in OSMOTIC equivalence to the seawater of
  the case study's Table 2) and boron as a second lumped solute
  (constant/components/boron.dat).  membrane01's form with one more solute.
\*---------------------------------------------------------------------------*/
recordType    thermophysicalPropertySystem;
schemaVersion 2;

components       ( water  NaCl  boron );

equilibrium
{
    formulation gammaPhi;
    liquid
    {
        activityModel ideal;
        standardState pureLiquid;
    }
    vapour
    {
        fugacityModel idealGas;
    }
}
