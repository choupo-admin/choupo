/*---------------------------------------------------------------------------*\
  thermoPhysPropDict (v2) -- T1 ideal gamma-phi mixture, the salts as ONE
  lumped nonvolatile solute (NaCl, in OSMOTIC equivalence to the seawater of
  the case study's Table 2) and boron as a second solute that the modules split
  into boric acid and borate by the pH (constant/components/boron.dat; the
  declared aqueous chemistry below).  membrane01's form with one more solute.
\*---------------------------------------------------------------------------*/
recordType    thermophysicalPropertySystem;
schemaVersion 2;

components       ( water  NaCl  boron );

equilibrium
{
    formulation gammaPhi;
    liquid
    {
        activityModel ideal;
        standardState pureLiquid;
    }
    //  THE AQUEOUS CHEMISTRY THE BORON SPLIT READS (DEV.md 4c C198).  The liquid
    //  IS seawater: the module asks the package for the base fraction of the
    //  boron (H3BO3 + H2O = BOH4 + H, chemistry/BOH4-formation.dat) at its
    //  inlet bulk, and the activity model is the CASE'S.  Davies is the
    //  model the tree has that carries every ion here; at seawater strength
    //  (I ~ 0.6 mol/kg) it is beyond its own ~0.5 mol/kg band and the run says
    //  so -- the alpha at pass 1 is indicative, not quantitative.
    aqueous
    {
        activityModel { model davies; }
    }
    vapour
    {
        fugacityModel idealGas;
    }
}

// THE LIQUID DENSITY'S HYPOTHESIS (DEV.md 4c C378 pilot): the pump and the
// CSTR take their liquid density from the property kernel, which refuses a
// component with no liquid volume.  This case declares, with its bound set
// from its own feed, that the listed components keep their mass and add no
// volume -- what the pump did unannounced before the pilot.
approximations
{
    massWithoutVolume
    {
        components      ( NaCl );
        maxMassFraction 0.05;
        reason          "seawater RO plant: the salt keeps its mass and adds no volume to the pumps' liquid density (its mass fraction is about 0.035); the engine's own bound on this reading is about +1.8 % on rho at 1 mol/kg (AqueousVolumetric.H)";
    }
}

transport
{
    liquid
    {
        viscosity
        {
            //  The Stokes-Einstein correction of an ion's D0 (and of nothing else here) reads WATER's
            //  viscosity law at the film temperature; the record holds two laws and marks none preferred.
            pin ( { component water; law vogel; reason "the temperature scaling of an ion's D0 reads water's viscosity; the Vogel fit is the one the membrane cases that declared a viscosity model used"; } );
            measured
            {
                sw1p0_NaClboron_liquidViscosity { use method; reason "the case stands the stated value over every feed of this liquid in its box, as it did when the value was typed in the unit block; its own assumption for a seawater feed, the status in the file's basis"; }
                sw1p0_NaCl_liquidViscosity { use method; reason "the case stands the stated value over every feed of this liquid in its box, as it did when the value was typed in the unit block; its own assumption for a seawater feed, the status in the file's basis"; }
                sw1p0_boron_liquidViscosity { use method; reason "the case stands the stated value over every feed of this liquid in its box, as it did when the value was typed in the unit block; its own assumption for a seawater feed, the status in the file's basis"; }
            }
        }
        diffusivity
        {
            returns infiniteDilution;
            infiniteDilution
            {
                entries
                (
                    { solute NaCl; solvent water; kind infiniteDilution;
                      value 1.611e-09 m2/s;  T 298.15 K;  box { T (297.65 298.65); }
                      reason "the datum is at 25 C; the module runs within a few tenths of a kelvin of it (pump heating), and D moves about 2 to 3 % per K on that page, so the box stands it over +-0.5 K, about 1 % of D, as a hypothesis";
                      source "Lide (ed.), CRC Handbook of Chemistry and Physics, 82nd ed. (2001), table 'Ionic conductivity and diffusion at infinite dilution' (Vanysek; PDF page 304 of Handbooks-DataCompilations/lide-crc-handbook-chemistry-physics-82ed.pdf): Na+ 1.334, Cl- 2.032 x 1e-5 cm2/s, combined by the page's salt relation D = (z+ + z-) D+ D- / (z+ D+ + z- D-)"; }
                    { solute boron; solvent water; kind infiniteDilution;
                      value 1.611e-09 m2/s;  T 298.15 K;  box { T (297.65 298.65); }
                      reason "boron has no diffusivity in any source read for this slice; the film coefficient goes as D^0.75 (Schock and Miquel), so the hypothesis is worth a few percent of k on the boron row; a measured value of boric acid in water replaces it";
                      source "NO SOURCE READ for boric acid in water: the value is NaCl's (Lide (ed.), CRC Handbook of Chemistry and Physics, 82nd ed. (2001), table 'Ionic conductivity and diffusion at infinite dilution' (Vanysek; PDF page 304 of Handbooks-DataCompilations/lide-crc-handbook-chemistry-physics-82ed.pdf): Na+ 1.334, Cl- 2.032 x 1e-5 cm2/s, combined by the page's salt relation), the case's own earlier assumption that one value serves both solutes, kept as an explicit hypothesis"; }
                );
            }
        }
    }
}
