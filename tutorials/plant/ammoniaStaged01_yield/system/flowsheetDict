/*---------------------------------------------------------------------------*\
  THE STAGED DESIGN SEQUENCE -- flowsheet, SHARED BY ALL THREE STAGES.

  Everything in this file except the `converter` block is BYTE-IDENTICAL
  across ammoniaStaged01_yield, ammoniaStaged02_equilibrium and
  ammoniaStaged03_approach.  Diff two of them and the only thing that moves
  is the reactor model -- which is the whole point: one rung of the fidelity
  ladder at a time, and nothing else.

        makeup (N2:H2 = 1:3 + 1 mol% Ar) -+
                                          v
                                     [mixer] <------- recycle <--------+
                                          |                            |
                                          v                            |
                                    [converter]   <-- THE ONLY         |
                                    700 K, 200 bar     DIFFERENCE      |
                                          v                            |
                        [separator]  isothermalFlash 250 K, 200 bar    |
                          |      |                                     |
                rawLiquid-+      +-- unreactedGas                      |
                    |                    |                             |
                    v               [purgeSplit] splitter              |
               [letdown]              |        |                       |
              flash 20 bar    purge --+        +-- recycle ------------+
                |       |      (5 % bleed)          (95 %)
      productNH3+       +letdownGas

  SCALE.  The makeup is 8000 kmol/h (N2 1980, H2 5940, Ar 80), which is
  1 mol% argon and H2:N2 exactly 3.0.  This is NOT the scale of
  tutorials/steady/flowsheets/ammonia01_synthesis_loop, whose structure this
  flowsheet copies: that case runs 1 kmol/h of makeup, and at that rate the
  converter's catalyst charge is about 2 litres -- below the lower bound of
  every vessel cost correlation the engine carries, so stage C could not
  honestly cost it.  The flowsheet is linear in flow (the flash and the
  reactor are both intensive), so the scale-up changes no intensive answer;
  compare this case's converter y_NH3 against ammonia01's own golden and they
  agree.

  TOPOLOGY ONLY.  Stream state lives on disk in 0/, one file per stream.
\*---------------------------------------------------------------------------*/
// stream state lives on disk in 0/ (per-stream files); flowsheetDict is TOPOLOGY only
units
(
    {
        name     mixer;
        type     mixer;
        inputs   ( makeup  recycle );
        outputs  ( mixed );
    }
    {
        //  ===================================================================
        //  STAGE A -- YIELD (STOICHIOMETRIC) REACTOR.
        //
        //  The reactor is a DECLARED single-pass conversion of the limiting
        //  reactant and nothing else.  It knows no thermodynamics: it will
        //  produce whatever conversion this dict asks for, at any temperature
        //  and any pressure, whether or not equilibrium allows it.  That is
        //  not a defect of the model -- it is what a yield reactor IS, and it
        //  is why stage A may claim a MATERIAL balance and nothing beyond one.
        //  It may not claim a converged HEAT balance either: this unit prices
        //  its duty on the ideal-gas rung while these streams are priced by
        //  SRK at 200 bar, and the plant's first law is out by 2278.14 kW
        //  because of it.  The engine says so on every run.  README section 4.
        //
        //  WHERE THE 0.25 COMES FROM: IT IS A DECLARED ASSUMPTION.  Those are
        //  the words, and they are deliberate.  No primary source retrieved
        //  for this case states a per-pass nitrogen conversion for an ammonia
        //  synthesis converter as a number.  What IS sourced is the closest
        //  measurable neighbour, and it is quoted in the README: a commercial
        //  converter taking 3.5 vol% NH3 in to 16.1 vol% NH3 out
        //  (US 5,352,428, CF Braun, 1994), conditions the patent calls
        //  "typical and optimum in many commercial process designs".  Turning
        //  that pair into a nitrogen conversion needs the feed's H2:N2 ratio
        //  and its inert content, which that passage does not give -- so it
        //  brackets 0.25 and does not source it.
        //
        //  WHAT WOULD REPLACE IT: stage B and stage C.  That is the whole
        //  point of the ladder.  An assumption is not a lie; an assumption
        //  never checked is.
        //  ===================================================================
        name       converter;
        type       conversionReactor;
        in         mixed;
        outputs    ( reacted );
        reaction   ammoniaSynthesis;            // constant/reactions
        operation  { conversion 0.25;  T 700 K; }
    }
    {
        name     separator;
        type     isothermalFlash;
        in       reacted;
        outputs  ( rawLiquid  unreactedGas );
        operation { T 250.0 K;  P 200.0 bar; }
    }
    {
        name     letdown;
        type     isothermalFlash;
        in       rawLiquid;
        outputs  ( productNH3  letdownGas );
        operation { T 250.0 K;  P 20.0 bar; }   // let-down drum: flash off the dissolved N2/H2
    }
    {
        name     purgeSplit;
        type     splitter;
        in       unreactedGas;
        outputs  ( purge  recycle );
        operation { fractions ( 0.05  0.95 ); }
    }
);
