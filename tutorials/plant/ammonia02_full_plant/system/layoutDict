    noTraffic ( 1 );
    //  The vehicle every truck route is checked against.  A turning circle is
    //  the one number about a truck a road designer needs first, and this one
    //  is the law's, not ours.
    designVehicle
    {
        turningDiameter 25 m;
        source  "Council Directive 96/53/EC of 25 July 1996 (maximum dimensions of road vehicles in the Community), Annex I point 1.5: any motor vehicle or vehicle combination in motion must be able to turn within a swept circle of outer radius 12,50 m and inner radius 5,30 m (read at legislation.gov.uk, 2026-10-18)";
        reason  "the largest vehicle that may come to the site, an articulated truck delivering catalyst or collecting waste, turns within that circle by law; its outer 25 m diameter is what a corner must hold";
    }
    network
    (
        {
            road         "entrance";
            width        7 m;
            cornerRadius 10 m;
            reason       "the gate to the main road, past the car park, the offices, the canteen and the control room; two-way";
            waypoints    ( { x -12 m; y -76 m; } { x -12 m; y -31 m; } );
        }
        {
            road         "main";
            width        6 m;
            cornerRadius 10 m;
            reason       "south of the compressor row, from the fire pumps to the east road, carrying the weighbridge just past the corner the truck loop turns at; kept 18 m off the compressors so the EduTool's guided moves of the control room (DEV.md 4c C75 slice 2) stand clear of every road";
            waypoints    ( { x -36 m; y -31 m; } { x 68 m; y -31 m; } );
        }
        {
            road      "east";
            width     6 m;
            reason    "past the separator, the let-down drum and the water cooler, under the rack";
            waypoints ( { x 68 m; y -31 m; } { x 68 m; y 16 m; } );
        }
        {
            road      "north";
            width     6 m;
            reason    "behind the exchangers, closing the ring";
            waypoints ( { x -8 m; y 16 m; } { x 68 m; y 16 m; } );
        }
        {
            road      "west";
            width     6 m;
            reason    "beside the makeup compressor, closing the ring; its north end is the emergency gate's road";
            waypoints ( { x -8 m; y -31 m; } { x -8 m; y 16 m; } );
        }
        {
            road      "rackCrossing";
            width     6 m;
            reason    "the converter's crane access: under the rack between the recycle compressor and the exchanger";
            waypoints ( { x 28 m; y -31 m; } { x 28 m; y 16 m; } );
        }
        {
            road      "tankFarm";
            width     6 m;
            reason    "the main road carried east along the product tank farm (DEV.md 4c C92), so a fire tender reaches every bullet from the road";
            waypoints ( { x 68 m; y -31 m; } { x 146 m; y -31 m; } );
        }
        {
            road         "yard";
            width        7 m;
            cornerRadius 10 m;
            oneWay       yes;
            reason       "the truck yard, driven west only: past the warehouse door and the laydown area back to the entrance road, where a truck turns south for the gate";
            waypoints    ( { x 60 m; y -52 m; } { x -12 m; y -52 m; } );
        }
        {
            road         "yardLink";
            width        7 m;
            cornerRadius 10 m;
            oneWay       yes;
            reason       "from the main road down to the truck yard, driven south only; 21 m long, enough for the two 10 m corners at its ends";
            waypoints    ( { x 60 m; y -31 m; } { x 60 m; y -52 m; } );
        }
    );
    //  THE TRUCK LOOP: in at the main gate and out at it, one way round, over
    //  the weighbridge, past the warehouse and the laydown area.
    truckRoutes
    (
        {
            route  "deliveries";
            from   gate;
            to     gate;
            roads  ( entrance main yardLink yard entrance );
            serves ( warehouse laydown );
            reason "catalyst, chemicals, spares and turnaround equipment in, waste out: weighed in on the main road, unloaded on the yard road, out by the gate it came in by, with no reversing and no turning round";
        }
    );
}

//  THE PLOT (DEV.md 4c C82).  The engine publishes the plot area as the
//  envelope of the placed footprints, the routed pipes and the declared
//  roads, grown on every side by this margin -- the fence and a clear strip
//  inside it.  The roads are declared above and inside the envelope, so the
//  margin no longer carries them (it was 10 m "for the perimeter road" before
//  they were declared, DEV.md 4c C90).  AUTHOR-SET ASSUMPTION, a round number
//  for this exercise, not taken from any spacing standard; the students
//  replace it with their own site's.  The economics prices this plot area
//  as land (system/postDict, `economics { land { ... } }`).
//  SECONDARY CONTAINMENT (DEV.md 4c C134).  The seven T201 bullets hold
//  liquid ammonia at about 22 bar.  A spill from a pressurised store flashes
//  in part and the rest pools COLD; it must not lie under the bullets, where
//  a fire on it would heat the vessels that feed it.  So the bullets stand on
//  a kerbed, sloped CATCH AREA that leads a spill to a REMOTE impounding pit
//  south of the farm, outside the catch area -- an IMPOUNDING area, not a
//  bund round the vessels.  Rule: 100 % of the liquid the largest bullet
//  holds at its working level (552 m3, the run's own inventory), plus 50 mm
//  of rain over the catch area and the open pit.  The pit, 24 m x 9 m x
//  3.5 m, holds 756 m3 against the 686 m3 the rule requires.  Every number
//  here is an AUTHOR-SET ASSUMPTION for this exercise: the case's reading of
//  the usual form of an impounding rule for a pressurised liquefied gas, NOT
//  a transcription of any code (the code the client specifies sets the
//  margin, the allowances and how far the pit must stand from the vessels;
//  Choupo ships no such table).  The product pipe and the let-down line run
//  OVER the 0.3 m kerb on the rack's height; a pipe through it below its top
//  would be announced.
bunds
(
    {
        name        "tankFarm";
        kind        impounding;
        items       ( "T201/vessel1" "T201/vessel2" "T201/vessel3" "T201/vessel4"
                      "T201/vessel5" "T201/vessel6" "T201/vessel7" );
        region      { xMin 73 m; xMax 143 m; yMin -71 m; yMax -36 m; }
        wall        { height 0.3 m; }
        pit         { x 108 m; y -77 m; length 24 m; width 9 m; depth 3.5 m; }
        drain       sumpPump;
        capacityRule
        {
            basis   heldLiquid;
            terms   ( { fraction 1; of largest; } );
            allowances
            (
                { name rain; depth 50 mm; reason "a design storm on the catch area and the open pit, as a round author-set number; the site's own rainfall statistics replace it"; }
            );
            source  "author-set assumption for this exercise: the case's reading of the usual form of an impounding rule for a pressurised liquefied gas (the largest vessel's liquid, plus rain); not a transcription of any code";
            reason  "one bullet fails, not seven; the liquid it holds at its working level is what can run to the pit";
        }
        source      "author-set assumption for this exercise; not a civil design";
        reason      "the bullets stand on a 0.3 m-kerbed slab sloped south to a pit outside it, between the tank farm and the south fence, clear of every road";
    }
);

plot
{
    margin  5 m;
    reason  "author-set assumption for this exercise: the fence and a 5 m clear strip inside it; the roads are declared in `roads` and lie inside the envelope; not taken from any spacing standard";
}

