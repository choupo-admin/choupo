/*---------------------------------------------------------------------------*\
  ammonia02_full_plant -- the PLOT PLAN of the synthesis loop (DEV.md 4c C75)

  HOW THIS FILE WAS MADE.  `bin/choupo-layout --draft` wrote a proposal: the
  three vessels (the only items whose sizers publish a diameter and a height)
  in flow order on one line, and the four other items listed for the author
  to place.  It was then moved by hand into the arrangement below: the two
  compressors in a compressor row to the south-west, the converter with its
  feed-effluent exchanger, the water cooler with the separator, the let-down
  drum, and a control room as a NON-PROCESS item.

  WHAT IS THE ENGINE'S AND WHAT IS OURS.  The three vessels' diameters and
  heights are their sizers' own (design/<unit>/vessel); every position below,
  every declared footprint, every separation distance, the wind and every
  zone extent are AUTHOR-SET ASSUMPTIONS FOR THIS EXERCISE -- round numbers
  chosen to make the check visible, not values taken from any spacing or
  hazardous-area standard.  Choupo ships no such table: the published ones
  (CCPS, GAP 2.5.2, Mecklenburgh; IEC 60079-10-1, EI 15, API RP 505) grant no
  redistribution, and inventing a citation for a round number would turn
  "unsourced" into "falsely sourced".

  ONE PAIR IS DELIBERATELY TOO CLOSE.  The let-down drum stands 1.9 m from
  the separator, edge to edge, against the 4 m this file declares between
  two vessels: the run ANNOUNCES it (stderr, the caveat block, the result
  JSON) rather than refusing, because a short distance is a layout a student
  must see and defend, while an overlap is not a layout at all.  Move
  `letdown` to x 62 m and the announcement goes away.

  THE SITE (DEV.md 4c C90).  A gate with its guardhouse on the south fence,
  a road network that rings the process area and crosses under the pipe rack
  once, and the site buildings a plant this size needs besides the control
  room: a warehouse (spares, catalyst drums, consumables) and a canteen.
  Every position, footprint, road width, the headroom and the access
  distance are AUTHOR-SET ASSUMPTIONS FOR THIS EXERCISE, said as such in each
  `source`; none is taken from a fire code or a road standard.
  THERE IS NO WEIGHBRIDGE, and that is read off the case, not chosen: the
  product leaves at a battery limit as a pipe (`productNH3`, the let-down
  drum's liquid -- a world-scale ~1400 t/day train ships by pipeline, rail or
  ship, and this case declares no product storage or loading bay), and the
  makeup syngas ARRIVES by pipe at 25 bar from the front end (`makeup`).  No
  stream of this flowsheet moves by truck, so nothing is weighed at the
  gate; the trucks that do come (catalyst, spares) are deliveries, not
  custody transfer.  A case whose product leaves in road tankers declares
  `{ nonProcess "weighbridge"; kind weighbridge; ... }` on a road, and the
  engine then requires a road to run over its deck.

  Grammar and checks: docs/design/a-plant-layout-is-declared-and-checked.md
\*---------------------------------------------------------------------------*/

items
(
    //  The compressor row, south-west of the loop.  A compressor publishes
    //  its power and ratio, not a size, so its plan box is DECLARED.
    {
        item        "makeupComp";
        x           6 m;
        y           -8 m;
        z           0 m;
        orientation alongX;
        footprint   { length 8 m; width 4 m; height 4 m; }   // author-set
        release
        {
            source  "author-set assumption for this exercise; not taken from any hazardous-area standard";
            reason  "hydrogen-rich syngas at 25-200 bar: shaft seals and flanges are secondary-grade release points";
            zones   ( { zone 2; radius 7.5 m; height 6 m; } );
        }
    }
    {
        item        "recycleComp";
        x           18 m;
        y           -8 m;
        z           0 m;
        orientation alongX;
        footprint   { length 6 m; width 3.5 m; height 3.5 m; }   // author-set
        release
        {
            source  "author-set assumption for this exercise; not taken from any hazardous-area standard";
            reason  "recycle gas (H2, N2, NH3) at loop pressure across the compressor seals";
            zones   ( { zone 2; radius 6 m; height 5 m; } );
        }
    }

    //  The converter and its feed-effluent exchanger.  The exchanger is
    //  RATED (an area at a declared U), so it publishes no shell diameter:
    //  its box is declared.
    {
        item        "converter";        // D and H from its own sizing
        x           40 m;
        y           -6 m;
        z           0 m;
        orientation vertical;
    }
    {
        item        "FEHE";
        x           40 m;
        y           6 m;
        z           0 m;
        orientation alongX;
        footprint   { length 12 m; width 2 m; height 2.5 m; }   // author-set
    }

    //  Cooling, separation and let-down.
    {
        item        "waterCooler";
        x           56 m;
        y           6 m;
        z           0 m;
        orientation alongX;
        footprint   { length 12 m; width 2 m; height 2.5 m; }   // author-set
    }
    {
        item        "separator";        // D and H from its own sizing
        x           56 m;
        y           -6 m;
        z           0 m;
        orientation vertical;
        release
        {
            source  "author-set assumption for this exercise; not taken from any hazardous-area standard";
            reason  "liquid ammonia and dissolved hydrogen at 200 bar: level and drain connections";
            zones   ( { zone 2; radius 5 m; height 10 m; } );
        }
    }
    {
        item        "letdown";          // D and H from its own sizing
        x           59.5 m;             // DELIBERATELY too close (see the header)
        y           -6 m;
        z           0 m;
        orientation vertical;
        release
        {
            source  "author-set assumption for this exercise; not taken from any hazardous-area standard";
            reason  "flash gas (H2, N2, NH3) released at the let-down pressure";
            zones   ( { zone 1; radius 1.5 m; height 3 m; } { zone 2; radius 4.5 m; height 5 m; } );
        }
    }

    //  The SITE BUILDINGS are not equipment the flowsheet sizes, so each is
    //  a NON-PROCESS item: its kind, its box, and where both come from are
    //  declared.  The kind is the word the separation table names and the
    //  3D view draws by (controlRoom, warehouse, canteen, gate, weighbridge,
    //  substation; any other word is a plain box).
    {
        nonProcess  "controlRoom";
        kind        controlRoom;
        x           -30 m;
        y           -40 m;
        z           0 m;
        orientation alongX;
        footprint   { length 15 m; width 10 m; height 4 m; }
        source      "author-set assumption for this exercise; not a building design";
        reason      "the operators' room for the DCS consoles, kept upwind and out of every zone";
        ignition    "non-hazardous-area electrical equipment and people: treated as an ignition source";
    }
    {
        nonProcess  "gate";
        kind        gate;
        x           -19 m;
        y           -63 m;
        z           0 m;
        orientation alongX;
        footprint   { length 4 m; width 3 m; height 3 m; }
        source      "author-set assumption for this exercise; not a building design";
        reason      "the site entrance on the south fence: a guardhouse beside the entrance road and its barrier";
    }
    {
        nonProcess  "canteen";
        kind        canteen;
        x           -30 m;
        y           -58 m;
        z           0 m;
        orientation alongX;
        footprint   { length 12 m; width 8 m; height 4 m; }
        source      "author-set assumption for this exercise; not a building design";
        reason      "meals and rest for the shift crews, beside the control room and more than the wind reach (60 m) from every release source, so no wind the EduTool's guided moves turn puts the kitchen downwind of one";
        ignition    "a kitchen (open flames) and people: treated as an ignition source";
    }
    {
        nonProcess  "warehouse";
        kind        warehouse;
        x           -30 m;
        y           -20 m;
        z           0 m;
        orientation alongX;
        footprint   { length 20 m; width 12 m; height 7 m; }
        source      "author-set assumption for this exercise; not a building design";
        reason      "spares, catalyst drums for the converter's recharge and consumables, on the main road so a truck unloads at its door";
    }
);

separation
(
    {
        source  "author-set assumption for this exercise; not taken from any published spacing table";
        reason  "round numbers chosen so that the check is visible on this plant; a real project takes its distances from the standard its client specifies, with that standard's permission";
        measure edgeToEdge;
        distances
        (
            { between ( vessel vessel );           distance 4 m;  }
            { between ( compressor vessel );       distance 9 m;  }
            { between ( compressor compressor );   distance 4 m;  }
            { between ( shellTubeHX vessel );      distance 3 m;  }
            { between ( compressor controlRoom );   distance 30 m; }
            { between ( controlRoom vessel );      distance 30 m; }
            { between ( controlRoom shellTubeHX ); distance 30 m; }
            { between ( canteen compressor );      distance 30 m; }
            { between ( canteen vessel );          distance 30 m; }
            { between ( canteen shellTubeHX );     distance 30 m; }
            { between ( compressor warehouse );    distance 15 m; }
            { between ( vessel warehouse );        distance 15 m; }
            { between ( shellTubeHX warehouse );   distance 15 m; }
        );
    }
);

//  The prevailing wind blows FROM the south-west (true bearing 225 deg); the
//  plot plan's +y axis points to true north.  An ignition source within
//  +/- 30 deg of the DOWNWIND direction and within 60 m of a release source
//  is announced.  The control room stands upwind, so nothing is.
wind
{
    from        225 deg;
    planNorth   0 deg;
    halfAngle   30 deg;
    reach       60 m;
    source      "author-set assumption for this exercise; not a measured wind rose";
    reason      "a prevailing direction lets the plot plan be read for which way a release drifts";
}

//  THE ROADS (DEV.md 4c C90).  Centre lines at grade, every segment along
//  one plan axis.  The entrance road runs north from the gate to the main
//  road, which rings the process area with the north, east and west roads;
//  two roads cross UNDER the pipe rack: one between the recycle compressor
//  and the feed-effluent exchanger, and the east road at the rack's east
//  end (the rack is the engine's stated default, 6 m up, above the 5 m
//  headroom declared here).  The engine refuses a road through a
//  footprint or under a rack or a pipe lower than the headroom, announces a
//  road no gate reaches, a building no road serves and a process item with
//  no road within the access distance, and publishes the length and the
//  paved area (inside the plot below).  AUTHOR-SET ASSUMPTIONS throughout.
roads
{
    source   "author-set assumption for this exercise; not taken from a road or fire standard";
    reason   "a ring road round the process area so a fire tender reaches every item from two sides, joined to the gate by the entrance road";
    headroom 5 m;
    access
    {
        distance 20 m;
        source   "author-set assumption for this exercise; not taken from a fire code";
        reason   "the reach of a fire tender's hoses and of a mobile crane parked on the road, as a round number";
    }
    noTraffic ( 1 );
    network
    (
        {
            road      "entrance";
            width     7 m;
            reason    "the gate to the main road, past the canteen and the control room";
            waypoints ( { x -12 m; y -66 m; } { x -12 m; y -31 m; } );
        }
        {
            road      "main";
            width     6 m;
            reason    "south of the compressor row, from the warehouse door to the east road; kept 18 m off the compressors so the EduTool's guided moves of the control room (DEV.md 4c C75 slice 2) stand clear of every road";
            waypoints ( { x -36 m; y -31 m; } { x 68 m; y -31 m; } );
        }
        {
            road      "east";
            width     6 m;
            reason    "past the separator, the let-down drum and the water cooler, under the rack's east end";
            waypoints ( { x 68 m; y -31 m; } { x 68 m; y 16 m; } );
        }
        {
            road      "north";
            width     6 m;
            reason    "behind the exchangers, closing the ring";
            waypoints ( { x -8 m; y 16 m; } { x 68 m; y 16 m; } );
        }
        {
            road      "west";
            width     6 m;
            reason    "beside the makeup compressor, closing the ring";
            waypoints ( { x -8 m; y -31 m; } { x -8 m; y 16 m; } );
        }
        {
            road      "rackCrossing";
            width     6 m;
            reason    "the converter's crane access: under the rack between the recycle compressor and the exchanger";
            waypoints ( { x 28 m; y -31 m; } { x 28 m; y 16 m; } );
        }
    );
}

//  THE PLOT (DEV.md 4c C82).  The engine publishes the plot area as the
//  envelope of the placed footprints, the routed pipes and the declared
//  roads, grown on every side by this margin -- the fence and a clear strip
//  inside it.  The roads are declared above and inside the envelope, so the
//  margin no longer carries them (it was 10 m "for the perimeter road" before
//  they were declared, DEV.md 4c C90).  AUTHOR-SET ASSUMPTION, a round number
//  for this exercise, not taken from any spacing standard; the students
//  replace it with their own site's.  The economics prices this plot area
//  as land (system/postDict, `economics { land { ... } }`).
plot
{
    margin  5 m;
    reason  "author-set assumption for this exercise: the fence and a 5 m clear strip inside it; the roads are declared in `roads` and lie inside the envelope; not taken from any spacing standard";
}

