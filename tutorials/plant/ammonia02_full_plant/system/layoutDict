        measure edgeToEdge;
        distances
        (
            { between ( vessel vessel );           distance 4 m;  }
            { between ( compressor vessel );       distance 9 m;  }
            { between ( compressor compressor );   distance 4 m;  }
            { between ( shellTubeHX vessel );      distance 3 m;  }
            { between ( compressor controlRoom );   distance 30 m; }
            { between ( controlRoom vessel );      distance 30 m; }
            { between ( controlRoom shellTubeHX ); distance 30 m; }
            { between ( canteen compressor );      distance 30 m; }
            { between ( canteen vessel );          distance 30 m; }
            { between ( canteen shellTubeHX );     distance 30 m; }
