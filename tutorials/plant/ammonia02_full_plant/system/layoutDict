//  The prevailing wind blows FROM the south-west (true bearing 225 deg); the
//  plot plan's +y axis points to true north.  An ignition source within
//  +/- 30 deg of the DOWNWIND direction and within 60 m of a release source
//  is announced.  The control room stands upwind, so nothing is.
wind
{
    from        225 deg;
    planNorth   0 deg;
    halfAngle   30 deg;
    reach       60 m;
    source      "author-set assumption for this exercise; not a measured wind rose";
    reason      "a prevailing direction lets the plot plan be read for which way a release drifts";
}

//  THE ROADS (DEV.md 4c C90).  Centre lines at grade, every segment along
//  one plan axis.  The entrance road runs north from the gate to the main
//  road, which rings the process area with the north, east and west roads,
//  and the tank-farm road carries the main road east along the product
//  bullets (DEV.md 4c C92); two roads cross UNDER the pipe rack: one between
//  the recycle compressor and the feed-effluent exchanger, and the east
//  road, where the rack runs on toward the tank farm (the rack is declared
//  below, 6 m up, above the 5 m headroom declared here; every pipe that
//  leaves the plant runs on from its lane to the fence crossing the
//  `fence {}` block declares for it).  The engine refuses a road through a
//  footprint or under a rack or a pipe lower than the headroom, announces a
//  road no gate reaches, a building no road serves and a process item with
//  no road within the access distance, and publishes the length and the
//  paved area (inside the plot below).  AUTHOR-SET ASSUMPTIONS throughout.
roads
{
    source   "author-set assumption for this exercise; not taken from a road or fire standard";
    reason   "a ring road round the process area so a fire tender reaches every item from two sides, joined to the gate by the entrance road";
    headroom 5 m;
    access
    {
        distance 20 m;
        source   "author-set assumption for this exercise; not taken from a fire code";
        reason   "the reach of a fire tender's hoses and of a mobile crane parked on the road, as a round number";
    }
    noTraffic ( 1 );
    network
    (
        {
            road      "entrance";
            width     7 m;
            reason    "the gate to the main road, past the canteen and the control room";
            waypoints ( { x -12 m; y -66 m; } { x -12 m; y -31 m; } );
        }
        {
            road      "main";
            width     6 m;
            reason    "south of the compressor row, from the warehouse door to the east road; kept 18 m off the compressors so the EduTool's guided moves of the control room (DEV.md 4c C75 slice 2) stand clear of every road";
            waypoints ( { x -36 m; y -31 m; } { x 68 m; y -31 m; } );
        }
        {
            road      "east";
            width     6 m;
            reason    "past the separator, the let-down drum and the water cooler, under the rack";
            waypoints ( { x 68 m; y -31 m; } { x 68 m; y 16 m; } );
        }
        {
            road      "north";
            width     6 m;
            reason    "behind the exchangers, closing the ring";
            waypoints ( { x -8 m; y 16 m; } { x 68 m; y 16 m; } );
        }
        {
            road      "west";
            width     6 m;
            reason    "beside the makeup compressor, closing the ring";
            waypoints ( { x -8 m; y -31 m; } { x -8 m; y 16 m; } );
        }
        {
            road      "rackCrossing";
            width     6 m;
            reason    "the converter's crane access: under the rack between the recycle compressor and the exchanger";
            waypoints ( { x 28 m; y -31 m; } { x 28 m; y 16 m; } );
        }
        {
            road      "tankFarm";
            width     6 m;
            reason    "the main road carried east along the product tank farm (DEV.md 4c C92), so a fire tender reaches every bullet from the road";
            waypoints ( { x 68 m; y -31 m; } { x 146 m; y -31 m; } );
        }
    );
}

//  THE PLOT (DEV.md 4c C82).  The engine publishes the plot area as the
//  envelope of the placed footprints, the routed pipes and the declared
//  roads, grown on every side by this margin -- the fence and a clear strip
//  inside it.  The roads are declared above and inside the envelope, so the
//  margin no longer carries them (it was 10 m "for the perimeter road" before
//  they were declared, DEV.md 4c C90).  AUTHOR-SET ASSUMPTION, a round number
//  for this exercise, not taken from any spacing standard; the students
//  replace it with their own site's.  The economics prices this plot area
//  as land (system/postDict, `economics { land { ... } }`).
plot
{
    margin  5 m;
    reason  "author-set assumption for this exercise: the fence and a 5 m clear strip inside it; the roads are declared in `roads` and lie inside the envelope; not taken from any spacing standard";
}

//  THE PIPE RACK, DECLARED (DEV.md 4c C93).  Until the tank farm was added
//  this case ran on the engine's STATED DEFAULT rack (the mean plan y of the
//  placed process items).  Seven bullets 50 m south of the loop drag that
//  mean onto the main road, so the rack is declared where the loop is: on
//  the line the default used to give (y = -22/7 m, rounded), from the inlet
//  end of the compressor row to 5 m past the first bullet, where the pipes
//  to the tank farm leave it.  Lanes and tiers are the default's own
//  drafting values.  AUTHOR-SET, like everything here.  (The stated default
//  is still exercised: check_plant_layout runs a copy of this case with
//  this block removed.)
pipeRack
{
    y            -3 m;
    elevation    6 m;
    laneSpacing  0.6 m;
    lanesPerTier 6;
    tierSpacing  1.5 m;
    xStart       -3 m;
    xEnd         83 m;
    reason       "author-set assumption for this exercise: the rack along the loop, where the stated default stood before the tank farm moved it, carried 5 m past the first bullet";
}

//  THE FENCE (DEV.md 4c C93).  The engine draws it from the PLOT above --
//  the plot's boundary, moved `inset` inward; with inset 0 the margin is the
//  clear strip inside it -- so its line is typed nowhere.  It opens at the
//  gate, on the side nearest it, as wide as the entrance road; a road that
//  met the fence anywhere else would be refused.  Every pipe that enters or
//  leaves the plant crosses it at a published point, and each crossing says
//  where the stream comes from or goes to.  The syngas arrives by PIPELINE
//  from the ADJACENT INDUSTRIAL PARK (Vitor's ruling on C92: no syngas
//  tank).  Every origin and destination below is an AUTHOR-SET ASSUMPTION
//  FOR THIS EXERCISE, not a survey of any real site; the product's bullets
//  hold two days before the export pipeline takes it.  The cooling water,
//  the let-down gas and the purge leave on the north side, near the units
//  that make them, instead of at the far end of the rack.
fence
{
    source  "author-set assumption for this exercise; not taken from any site survey or fencing standard";
    reason  "the site boundary: the land the plot prices, closed by a fence with one gate, and the point where every pipeline enters or leaves the plant";
    inset   0 m;
    crossings
    (
        { stream makeup;        from "adjacent industrial park: syngas pipeline at 25 bar"; }
        { stream cw;            from "site cooling-water system: supply from the cooling tower outside this battery limit";  side north;  at 55 m; }
        { stream cwOut;         to   "site cooling-water system: return to the cooling tower outside this battery limit";    side north;  at 57 m; }
        { stream letdownGas;    to   "adjacent industrial park: fuel-gas header";                                               side north;  at 60 m; }
        { stream purge;         to   "adjacent industrial park: hydrogen recovery from the loop purge";                         side north;  at 37 m; }
        { stream productStored; to   "ammonia export pipeline to the terminal";                                                 side south;  at 78 m; }
    );
}

