/*---------------------------------------------------------------------------*\
  DRYING / system/flowsheetDict   (SECTOR -- COMPOSITE)

  Spray dryer -> additional solid drying -> cyclone dust separator.
  The solid powder goes SD -> BD -> product.  The spray-dryer exhaust goes
  SD -> CY, but in THIS run the cyclone is idle: the engine's spray dryer
  sends every particle to its powder outlet and none to the exhaust, so the
  exhaust reaches CY as gas only (solidsIn_mass 0 and efficiency 0 in the
  golden) and Dust is zero.  The cyclone is wired for a dryer that does
  carry fines out; today none is modelled.
\*---------------------------------------------------------------------------*/

sectors    ( SD  BD  CY );

boundary
{
    inlets   ( Magma  DryingAir  BdAir );
    outlets  ( Powder  Dust  ExhaustClean  BdVapour );
}

connections
{
    Magma        { to SD/Magma; }
    DryingAir    { to SD/DryingAir; }
    BdAir        { to BD/hotAir; }
    WetPowder    { from SD/WetPowder;    to BD/WetPowder; }   // solid: spray -> extra drying
    Exhaust      { from SD/Exhaust;      to CY/Exhaust; }     // exhaust gas, no solids in this run -> cyclone (idle)
    DryPowder    { from BD/DryPowder; }
    Vapour       { from BD/Vapour; }
    ExhaustClean { from CY/ExhaustClean; }
    Dust         { from CY/Dust; }
}
