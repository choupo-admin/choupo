/*---------------------------------------------------------------------------*\
  thermoPhysPropDict (v2) -- the dilute-solution (Henry) world: water on the
  pure-liquid (Raoult) rung, CO2 and N2 on the infinite-dilution (Henry)
  rung, every other component on Raoult with gamma = 1 (as before).
  WHY HENRY (C256, 2026-11-09).  CO2 (Tc 304.1 K) and N2 (Tc 126.2 K) are
  above their critical temperatures everywhere in this plant.  On the
  ideal gamma-phi package their K was Psat/P with a vapour pressure that
  does not exist above Tc (continued from Tc since C245 slice 5a): the
  fermentation flash at 320 K and 1 bar published K_CO2 = 500.9, and the
  beer it sends back to the fermentor carried that much CO2.  A sparingly
  soluble gas over an aqueous liquid is what the Henry rung is for, and the
  catalogue carries both pairs with water (Sander 2015, CC-BY).
  WHAT IT DOES NOT FIX.  The constants are for PURE water; the flash liquid
  is about 20 mol % ethanol, which raises CO2's solubility, and no mixed-
  solvent Henry route exists yet (the deferred D3 transfer term).  Ethanol,
  water and sucrose stay on Raoult with gamma = 1 -- the case's existing
  approximation, untouched here.
\*---------------------------------------------------------------------------*/

recordType    thermophysicalPropertySystem;
schemaVersion 2;

components       ( water  sucrose  N2  ethanol  CO2 );

equilibrium
{
    formulation diluteSolution;

    liquid
    {
        solvent
        {
            component     water;
            standardState pureLiquid;          // the Raoult rung
        }
        solutes
        {
            components    ( CO2  N2 );
            standardState infiniteDilution;    // the Henry rung
            solutionModel henryDilute;
            binaryParameters
            {
                // Sander (2015) compilation, CC-BY
                CO2-water { source "data/standards/parameters/Henry/CO2-water.dat"; }
                N2-water  { source "data/standards/parameters/Henry/N2-water.dat"; }
            }
        }
    }

    vapour
    {
        fugacityModel idealGas;
    }
}

transport
{
    vapour
    {
        viscosity           { model Chung; }
        thermalConductivity { model Eucken; }
        diffusivity         { model Fuller; }
    }
}

// THE LIQUID DENSITY'S HYPOTHESIS (DEV.md 4c C378 pilot): the pump and the
// CSTR take their liquid density from the property kernel, which refuses a
// component with no liquid volume.  This case declares, with its bound set
// from its own feed, that the listed components keep their mass and add no
// volume -- what the pump did unannounced before the pilot.
approximations
{
    massWithoutVolume
    {
        components      ( CO2 N2 );
        maxMassFraction 0.05;
        reason          "the fermentor's feed carries dissolved CO2, a declared Henry solute whose partial molar volume this pilot does not read: it keeps its mass and adds no volume.  N2, the other declared Henry solute, is listed because a Newton perturbation of the recycle puts a trace of it in the feed.  The bound covers the recycle's seed (3 % CO2 by mole, w 0.033 in the mixed feed of the first pass); the converged feed carries far less";
    }
}
