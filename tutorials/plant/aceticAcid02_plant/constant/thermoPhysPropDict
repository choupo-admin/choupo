/*---------------------------------------------------------------------------*\
  thermoPhysPropDict (v2) -- gamma-phi, UNIFAC liquid, ideal-gas vapour.

  UNIFAC is PREDICTIVE (group contribution, no fitted binary pairs): the
  catalogue holds no regressed pair for most of this system (the UNIQUAC and
  NRTL files cover only methyl acetate with methanol, water or acetic acid).
  Every activity coefficient here is therefore an estimate from structure.

  THE VAPOUR IS NOT A PLAIN IDEAL GAS FOR ACETIC ACID.  Since C201 the package
  prices the association the acetic acid record declares (`vapourDimerisation`:
  monomer + dimer at equilibrium) inside the ideal-gas vapour, so y enters K.

  WHAT THIS DOES NOT HAVE, stated rather than hidden:
    * CO IN THE LIQUID.  No UNIFAC group exists for carbon monoxide, so it sits
      outside the activity model (gamma = 1, a Psat extrapolated far above its
      critical temperature) -- the same approximation, with the same sentence
      of justification, that acetonePlant makes for hydrogen.
\*---------------------------------------------------------------------------*/

recordType    thermophysicalPropertySystem;
schemaVersion 1;

components       ( CO  methanol  aceticAcid  dimethylEther  methylAcetate  water );

equilibrium
{
    formulation gammaPhi;

    liquid
    {
        activityModel { model UNIFAC; }
        standardState pureLiquid;
    }

    vapour
    {
        fugacityModel idealGas;
    }
}

//  THE SURFACE TENSION THE LIGHTS COLUMN'S TRAYS ARE RATED ON (C398 A4): each
//  component by its RECORD'S OWN law (sigma = A tau^n, fitted to measurements;
//  the four laws are evaluated near 400 K, about 60 K past their fitted
//  ranges, and the run announces each extrapolation), mixed by Butler, the
//  package's default rule.  methylAcetate's record carries no law, so it is
//  priced by Brock-Bird, announced with that method's stated scope (Poling 5th
//  ed. p. 12.3: "for nonpolar liquids"); CO is above its critical temperature
//  and left out.  Brock-Bird alone was the surface until review row DF-15:
//  Poling's Table 12-1 measures it +53 % on acetic acid at 293 K, where the
//  record law gives 27.53 against the measured 27.59 mN/m.  Until C398 A4 the
//  column's `hydraulics {}` typed 0.019 N/m, assumed with no source read.
transport
{
    interface
    {
        surfaceTension { model StoredCorrelation; }
    }
}

//  C256 (2026-11-09), MEASURED: the CO dissolved in the 30 bar condensate
//  (3.3 mol %, K_CO 29.9 in the condenser flash) and carried into the column
//  feed (0.065 %) rests on a vapour pressure CONTINUED past CO's Tc
//  (132.9 K) -- it is not a solubility, and it sets the CO the column vents
//  and the crude acid carries.  No Henry pair for CO in acetic acid is in
//  the catalogue, a Henry solute cannot be declared inside a UNIFAC liquid,
//  and SRK on an associating acid at 30 bar would be a worse surface than
//  the one this plant has: the number stays a declared non-K.
approximations
{
    componentOutsideActivityModel
    {
        components ( CO );
        reason     "supercritical permanent gas; no UNIFAC group exists for carbon monoxide. Its liquid mole fraction in this flowsheet is small (the condenser sits at 30 bar, where CO is sparingly soluble in acetic acid) but NOT measured here; Henry in a mixed solvent is the principled route and is not built.";
    }
}
