/*---------------------------------------------------------------------------*\
  aceticAcid02_plant -- acetic acid from CO + methanol, with its plant.
  A BASE CASE: it runs, it is NOT optimised, and every number a student would
  tune is a plain key below (see README section 4).

      freshMethanol -> [methanolTank] -> [methanolPump] -> methanolToProcess
        1 atm            14 days           to 30 bar          |
      +-------------------------------------------------------+
      |
      +---------------+          (freshCO arrives by pipeline, not stored)
      freshCO --------+--> [M1] --> [preheater] --> [reactor] -----> liquid ---+
      coRecycle ------+      ^        460 K        gibbsReactor        |       |
                             |                     460 K, 30 bar,      v       |
                             |                     approach 10        gas      |
                             |                                         |       |
                             |                                  [condenser]    |
                             |                                    330 K, 30 bar|
                             |                                    |        |   |
                             |                                  coGas   condensate
                             |                                    |        |   |
                             |                            [purgeSplit]     +-[M2]
                             |                              |     |            |
                             |                          purge   coRecycle      v
                             +--------------------------------------+  [letdown valve]
                                                                           |
                                                                      [degasser] --> offgas
                                                                           |
                                                                    [lightsColumn]
                                                                      |         |
                                                                  lightsOut   acidProduct
                                                                                  |
                                                                            [acidCooler] 313 K
                                                                                  |
                                                                              coldAcid
                                                                                  |
                                                                             [acidTank] --> acidShipped

  ONE recycle: CO, against a 5 % purge.  The light by-products leave through
  the lights column's distillate (a declared outlet, not recycled -- a second
  recycle was built first and cost 7 min 25 s a run for a stream that is 94 %
  acetic acid).  The reactor is the one of aceticAcid01_gibbsReactor.

  THE TANKS (DEV.md 4c C87).  The methanol is BOUGHT and held in a feed tank
  before the process takes it; the acid is COOLED and held in a product tank
  between shipments.  Both tanks are `storageTank` units: the outlet IS the
  inlet (same F, z, T, P), so they move no process number -- what they add
  is the holdup the plant's working capital rests on, and the equipment the
  plot plan and an economic analysis must carry.  They are SIZED in
  system/postDict, by a `storage` entry that LINKS each unit (`unit
  methanolTank;`) and reads its residence time, fill fraction and inlet
  from it: the stock is declared ONCE, here.  CO is NOT stored: it arrives
  by pipeline at the plant pressure, as a gas no atmospheric tank holds.
\*-----------------------------------------------------------------------------*/
units
(
    //  ---- RAW-MATERIAL INVENTORY: the methanol feed tank -----------------
    //  An ATMOSPHERIC tank, so `0/freshMethanol` arrives at 1 atm and a pump
    //  lifts the stored liquid to the plant pressure (until the tanks were
    //  added the feed was declared at 30 bar and the pump sat outside the
    //  battery limit).  The residence time is the stock the plant holds:
    //  14 days is an AUTHOR-SET ASSUMPTION, for the students to replace --
    //  a delivery cycle plus a safety stock, so that one late delivery does
    //  not stop the plant.  It is NOT taken from any source.  It is declared
    //  HERE AND NOWHERE ELSE: the unit publishes the holdup from it, and the
    //  tank in system/postDict (`unit methanolTank;`) is sized on the
    //  residence time and fill fraction this unit publishes -- declaring
    //  either there as well is refused by name.
    {
        name        methanolTank;
        type        storageTank;
        in          freshMethanol;
        outputs     ( methanolStored );
        operation   { residenceTime 14 day;  fillFraction 0.90; }
    }
    {
        //  Lifts the stored methanol from 1 atm to the plant pressure.  The
        //  efficiency is an AUTHOR-SET ASSUMPTION.  No sizer exists for a
        //  pump, so it has no item and no place on the plot plan: its two
        //  streams are listed as not routed, with that reason.
        name        methanolPump;
        type        pump;
        in          methanolStored;
        outputs     ( methanolToProcess );
        operation   { P_out 30 bar;  eta 0.65; }
    }
    {
        //  Fresh feeds and the CO recycle merge at a DECLARED temperature:
        //  a gas+liquid merge has no well-posed adiabatic T (see mixer), and
        //  the preheater below sets the real reactor-feed state.
        name        M1;
        type        mixer;
        inputs      ( methanolToProcess  freshCO  coRecycle );
        outputs     ( mixedFeed );
        operation   { T 320 K; }
    }
    {
        name        preheater;
        type        phaseChanger;
        in          mixedFeed;
        outputs     ( reactorFeed );
        operation   { outletT 460 K;  P 30 bar; }
    }
    {
        name        reactor;
        type        gibbsReactor;
        in          reactorFeed;
        outputs     ( gas  liquid );
        operation
        {
            T                    460.0 K;
            P                    30.0 bar;
            temperatureApproach  10;            // K, a MAGNITUDE; the engine assigns the sign
            elements   ( C  H  O );
            species
            (
                { name CO;            atoms ( 1 0 1 ); }
                { name methanol;      atoms ( 1 4 1 ); }
                { name aceticAcid;    atoms ( 2 4 2 ); }
                { name dimethylEther; atoms ( 2 6 1 ); }
                { name methylAcetate; atoms ( 3 6 2 ); }
                { name water;         atoms ( 0 2 1 ); }
            );
        }
    }
    {
        //  Recovers the acetic acid the reactor gas carries (about a fifth of
        //  it).  The flash computes the duty that brings its feed to 330 K.
        name        condenser;
        type        isothermalFlash;
        in          gas;
        outputs     ( condensate  coGas );
        operation   { T 330 K;  P 30 bar; }
    }
    {
        name        purgeSplit;
        type        splitter;
        in          coGas;
        outputs     ( purge  coRecycle );
        operation   { fractions ( 0.05  0.95 ); }
    }
    {
        name        M2;
        type        mixer;
        inputs      ( liquid  condensate );
        outputs     ( crudeAcid );
    }
    {
        name        letdown;
        type        valve;
        in          crudeAcid;
        outputs     ( letdownOut );
        operation   { P 1.5 bar; }
    }
    {
        //  Takes out the permanent gas the condenser left dissolved (CO) and
        //  the dimethyl ether: a total condenser cannot condense them, and the
        //  column refuses a feed that makes it try (acetonePlant, hydrogen).
        //  The offgas also carries a little acid and lights; it is a declared
        //  plant OUTLET here, not recycled.
        name        degasser;
        type        isothermalFlash;
        in          letdownOut;
        outputs     ( columnFeed  offgas );
        operation   { T 380 K;  P 1.5 bar; }
    }
    {
        //  Takes the light by-products overhead and acetic acid out of the
        //  bottom.  The distillate is a RATE: the column sits OUTSIDE the
        //  recycle (the CO loop closes at the condenser), so its feed does
        //  not move from pass to pass and a rate is a well-posed
        //  specification.  A recovery specification would be an outer secant
        //  of full column solves -- measured at 7 min 25 s on this plant.
        name        lightsColumn;
        type        distillationColumn;
        model       simultaneous;
        in          columnFeed;
        outputs     ( lightsOut  acidProduct );
        operation
        {
            nStages 20;  feedStage 14;  refluxRatio 5.0;  P 1.5 bar;
            distillateRate 1.0 kmol/h;

            //  SIEVE-TRAY HYDRAULICS, in DESIGN mode: no `diameter`, so the
            //  pass DESIGNS it (the widest tray sets the tower), and the
            //  column's sizer (system/postDict) builds the shell on it.
            //  EVERY NUMBER BELOW IS AN AUTHOR-SET ASSUMPTION for the
            //  students to replace with their own tray design; the geometry
            //  is the textbook sieve tray of column09_tray_hydraulics, not a
            //  design for this service.  The trays' liquid carries a trace
            //  of CO and dimethyl ether above their critical temperatures:
            //  its density is taken over the other components, and the run
            //  says so (DEV.md 4c C79).
            hydraulics
            {
                trayType               sieve;
                traySpacing            0.50;     // m -- ASSUMED
                weirHeight             0.050;    // m -- ASSUMED
                holeDiameter           5.0e-3;   // m -- ASSUMED
                holeAreaFraction       0.10;     // A_holes / A_active -- ASSUMED
                downcomerAreaFraction  0.12;     // A_downcomer / A_tower -- ASSUMED
                weirLengthFraction     0.77;     // l_weir / D, goes with 0.12
                orificeCoefficient     0.84;     // C_o -- the Liebson chart value
                                                 // column09 reads; not re-read here
                floodFraction          0.80;     // design target -- ASSUMED
                //  The package carries no surface-tension model, so it is
                //  DECLARED: of the order of acetic acid's near its normal
                //  boiling point -- ASSUMED, no source was read for it.
                sigma                  0.019;    // N/m
                //  `K2` (the weep-point chart) is NOT declared: it is read off
                //  a chart against this tray's own h_w + h_ow, and nobody has
                //  read it for this tray.  The run says the weep check was not
                //  performed rather than borrow column09's value.
            }
        }
    }

    //  ---- the PRODUCT COOLER ----------------------------------------------
    //  The acid leaves the column at its bubble point at 1.5 bar, about
    //  404 K -- 13 K ABOVE its normal boiling point (391.05 K, `Tb` of
    //  constant/components/aceticAcid.dat), so an atmospheric tank could not
    //  hold it: it would boil off through the roof vents.  This cooler
    //  brings it down against the plant's cooling water before it is
    //  stored (DEV.md 4c C87, Vitor: "arrefece o acido").
    //  313.15 K (40 degC) is an AUTHOR-SET ASSUMPTION, for the students to
    //  replace, chosen for three reasons: (1) 78 K below the 1 atm boiling
    //  point, so the tank breathes little acid vapour; (2) above the acid's
    //  freezing point, about 290 K (16.6 degC -- a handbook figure, NOT read
    //  from this case's records, which carry no melting point), with margin,
    //  so glacial acid does not freeze in the tank or the line; (3) 15 K
    //  above the cooling-water supply (298.15 K, constant/utilities/
    //  coolingWater.dat), a reachable cold-end approach for that utility.
    //  The pressure is the column's: a cooler is not a let-down.  Its duty is
    //  a cooling-utility cost, and it is SIZED in system/postDict as a
    //  shell-and-tube exchanger, as the preheater is.
    {
        name        acidCooler;
        type        phaseChanger;
        in          acidProduct;
        outputs     ( coldAcid );
        operation   { outletT 313.15 K;  P 1.5 bar; }
    }

    //  ---- PRODUCT INVENTORY: the acetic acid product tank ----------------
    //  The acid held between shipments: 7 days is an AUTHOR-SET ASSUMPTION,
    //  for the students to replace -- a weekly shipment plus nothing else.
    //  It is NOT taken from any source, and it is declared here and nowhere
    //  else (see the methanol tank).  The tank holds the COOLED acid.
    {
        name        acidTank;
        type        storageTank;
        in          coldAcid;
        outputs     ( acidShipped );
        operation   { residenceTime 7 day;  fillFraction 0.90; }
    }
);
