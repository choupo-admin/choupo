        reason  "the pressure-temperature rating of a flange is what fixes its class; the engine carries no table, the case declares the three it needs (Type 316 only: this case's items are all SS316); the class is the first column whose working pressure at the first temperature row at or above the design temperature holds the design pressure";
        tables
        (
            {
                material SS316;  group "group 2.2 (Type 316 stainless steel)";
                source "Perry 9th ed., Table 10-42d, p. 10-96";
                minF -20;
                classes ( 150 300 600 900 1500 );
                rows
