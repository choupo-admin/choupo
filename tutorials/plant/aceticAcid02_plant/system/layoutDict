            { nominalSize 0.75; outsideDiameter 1.050 in;
              schedules ({ schedule 40; wall 0.113 in; } { schedule 80; wall 0.154 in; } { schedule 160; wall 0.219 in; }); }
            { nominalSize 1; outsideDiameter 1.315 in;
              schedules ({ schedule 40; wall 0.133 in; } { schedule 80; wall 0.179 in; } { schedule 160; wall 0.250 in; }); }
            { nominalSize 1.25; outsideDiameter 1.660 in;
              schedules ({ schedule 40; wall 0.140 in; } { schedule 80; wall 0.191 in; } { schedule 160; wall 0.250 in; }); }
            { nominalSize 1.5; outsideDiameter 1.900 in;
              schedules ({ schedule 40; wall 0.145 in; } { schedule 80; wall 0.200 in; } { schedule 160; wall 0.281 in; }); }
            { nominalSize 2; outsideDiameter 2.375 in;
              schedules ({ schedule 40; wall 0.154 in; } { schedule 80; wall 0.218 in; } { schedule 160; wall 0.344 in; }); }
            { nominalSize 2.5; outsideDiameter 2.875 in;
              schedules ({ schedule 40; wall 0.203 in; } { schedule 80; wall 0.276 in; } { schedule 160; wall 0.375 in; }); }
