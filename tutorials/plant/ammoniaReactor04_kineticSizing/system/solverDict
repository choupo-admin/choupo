/*---------------------------------------------------------------------------*\
  solverDict -- numerical strategy.  IDENTICAL in all four stages: the ladder
  is about the REACTOR MODEL, so the recycle plan must not move with it.
\*---------------------------------------------------------------------------*/

// ---- Recycle plan: the tear CUT + the outer solver (numerical strategy --
//      the topology stays in flowsheetDict) ----
tearStreams          ( recycle );
recycleSolver         Newton;
recycleTol            1e-5;
recycleMaxIter        200;
