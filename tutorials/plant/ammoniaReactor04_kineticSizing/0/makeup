/*--- Choupo stream state.  Every DIMENSIONAL value carries its unit; the parser converts to SI.
     componentMolarFlows is the OVERALL material (all phases); a phases{} block, when present,
     is a decomposition that sums back to it exactly. ---*/
// PLANT-BOUNDARY INLET.  8000 kmol/h of stoichiometric makeup: H2:N2 = 3.0
// exactly, argon 1.00 mol%.  IDENTICAL in all four stages -- the ladder is
// about the reactor, so the feed must not move with it.

componentMolarFlows
{
    N2    1980 kmol/h;
    H2    5940 kmol/h;
    Ar    80 kmol/h;
}

T               300 K;
P               20000000 Pa;
