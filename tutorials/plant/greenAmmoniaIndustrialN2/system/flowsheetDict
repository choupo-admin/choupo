/*---------------------------------------------------------------------------*\
  GREEN AMMONIA, 1200 t/day -- the base case of the PEQ 2026-27 project base
  data, v2: hydrogen from electrolysis at 30 bar, nitrogen from an on-site
  cryogenic ASU at 8 bar (99.99 % N2, 100 ppm Ar), a 150 bar synthesis loop
  with an equilibrium converter, refrigerated separation, and a
  water-scrubbed purge.  ONE LEVEL, no sectors: about twenty units, all on one
  canvas, because the loop is what a group has to understand and a sector
  boundary would cut it in half.

  N2Feed -[N2Boost]-[N2Cooler]-+
                               +-[MakeupMix]-[MakeupComp1]-[Intercooler]-[MakeupComp2]-[Aftercooler]-+
  H2Feed ----------------------+                                                                     |
                                                                                                     v
          Recycle -[RecycleComp]-------------------------------------------------------------->[LoopMix]
             ^                                                                                       |
             |                         +----------- HotEffluent (tear) -----------+                  v
             |                         v                                          |              [FEHE] cold side
             |   CooledEffluent <---[FEHE] hot side                                |                  |
             |        |                                                           |    PreheatedFeed  v
             |   [WaterCooler]<-Cw                                    [Converter] 460 C, 5 K approach
             |        |
             |   [Chiller]  -20 C (refrigeration)
             |        |
             |   [Separator]  140 bar --- RawLiquid -[LetdownHP]-[StorageFlash]- ProductNH3 (-35 C, 1 atm)
             |        |                                 |              |
             |   UnreactedGas                      LetdownGas      FlashGas (to the refrigeration unit)
             |        |
             +--[PurgeSplit]--Purge-[PurgeValve]-[PurgeHeater]-[Scrubber]<-WashWater
                                                                 |      |
                                                          ScrubbedGas  AqueousNH3

  WHERE EACH NUMBER COMES FROM.  Feeds, loop pressure, the 380 C converter
  inlet and the -20 C separation are the base data (sections 2.3-2.5).  The rest are DECLARED here and are the groups' to
  change:
    * compressors are specified by SHAFT POWER, the only way Choupo's
      compressor is specified; each power was chosen so that its discharge
      lands on the pressure the base data give (30, 67 and 150 bar for the
      make-up, 150 bar for the recycle).  Change a flow and the pressure moves:
      read it, and re-tune the power.
    * the loop pressure drop is LUMPED at the separator (declared at 140 bar,
      i.e. the base data's "recycle compressor dp ~ 10 bar").  Every other unit
      holds its pressure.
    * the converter is ONE gibbsReactor at its OUTLET temperature, 460 C,
      5 K short of equilibrium (see the comment on the unit).  The outlet
      temperature is a design choice the base data leave open; the base data's
      three intercooled beds are how a real converter reaches it, and their
      number and size need the kinetics (task 2).  The reactor's duty is the
      reaction heat the intercoolers remove as medium-pressure steam; the
      steam side is not modelled.
    * the purge fraction gives the base data's ~12 kmol/h purge (stream 8).
      The argon at the converter inlet then sits near 0.2 %, not the base
      data's 1 %: most of the argon leaves DISSOLVED in the liquid, through
      the let-down and storage flashes (task 3 starts there).

  WHAT IS NOT IN THIS CASE, and is the groups' work (base data, section 2.8):
    * the < 100 ppm H2O + O2 of the hydrogen.  The feed here is pure H2.  Both
      are catalyst poisons: a dryer/deoxo on the make-up, or injecting the
      make-up upstream of the separator so the liquid ammonia washes it, is a
      design decision, not a default.
    * the cold gas/gas exchanger between the separator vapour and the effluent
      (the base data's ~9 MW): the Chiller here takes the whole cooling from
      the water cooler down to -20 C, so its duty is an UPPER bound on the
      refrigeration.
    * the refrigeration cycle itself (the Chiller's duty is a heat to remove,
      not an electrical load), the steam system, the start-up heater, and the
      beds themselves: their number, inlet temperatures and catalyst volumes
      need a rate law (tutorials/plant/ammoniaStaged04_kinetic).

  WHAT THE GROUPS SHOULD NOTICE.  The base data's 18 % per-pass conversion
  (~12 % NH3 out) is a KINETIC figure: at 460 C the equilibrium allows much
  more, so this converter converts more per pass and the recycle is about
  half the base data's.  Raising the outlet temperature towards the 520 C
  limit brings the two together -- try it.

  TOPOLOGY ONLY.  Stream state lives in 0/, one file per stream.
\*---------------------------------------------------------------------------*/

units
(
    //  ---- nitrogen and make-up compression (base data 2.5, steps 1-2) ----
    { name N2Boost;      type compressor;    in N2Feed;         outputs ( N2Compressed );
      operation { W_shaft 2110 kW;  eta 0.78; } }
    { name N2Cooler;     type phaseChanger;  in N2Compressed;   outputs ( N2Cooled );
      operation { outletT 313.15 K; } }
    { name MakeupMix;    type mixer;         inputs ( H2Feed  N2Cooled );  outputs ( Makeup30 ); }
    { name MakeupComp1;  type compressor;    in Makeup30;       outputs ( Makeup67 );
      operation { W_shaft 5200 kW;  eta 0.75; } }
    { name Intercooler;  type phaseChanger;  in Makeup67;       outputs ( Makeup67Cool );
      operation { outletT 313.15 K; } }
    { name MakeupComp2;  type compressor;    in Makeup67Cool;   outputs ( Makeup150 );
      operation { W_shaft 5510 kW;  eta 0.75; } }
    { name Aftercooler;  type phaseChanger;  in Makeup150;      outputs ( Makeup );
      operation { outletT 313.15 K; } }

    //  ---- the synthesis loop (step 3) ----
    { name RecycleComp;  type compressor;    in Recycle;        outputs ( CompRecycle );
      operation { W_shaft 850 kW;  eta 0.75; } }
    { name LoopMix;      type mixer;         inputs ( Makeup  CompRecycle );  outputs ( Mixed ); }
    { name FEHE;         type heatExchanger; inputs ( HotEffluent  Mixed );
      outputs ( CooledEffluent  PreheatedFeed );
      operation { area 2000 m2;  U 550 W/m2/K;  flow counter; } }
    //  THE CONVERTER IS ONE EQUILIBRIUM REACTOR -- the first-pass practice.
    //  A Gibbs reactor computes only the OUTLET: the equilibrium of the atoms
    //  that enter, at the declared temperature and pressure.  It has no
    //  volume and no path, so three Gibbs beds in series with coolers between
    //  them give exactly the outlet of ONE Gibbs reactor at the last bed's
    //  outlet temperature.  So: one reactor, at the converter OUTLET
    //  temperature, 5 K short of equilibrium; its duty is the reaction heat
    //  the intercoolers must remove (steam).  How many beds, and how big, is
    //  a question for a plug-flow reactor with a rate law
    //  (tutorials/plant/ammoniaStaged04_kinetic) -- task 2.
    //
    //  temperatureApproach: the ammonia content is the equilibrium one 5 K
    //  ABOVE the actual temperature (US 5,352,428, Bhakta & Grotz 1994: "the
    //  ammonia concentration corresponds to the equilibrium concentration at
    //  a temperature 5 C. above the actual temperature"; design range 0-30 C,
    //  preferably 1-10 C).  See tutorials/plant/ammoniaStaged03_approach.
    { name Converter;  type gibbsReactor;  in PreheatedFeed;  outputs ( HotEffluent );
      operation
      {
          T 733.15 K;  P 150 bar;           // converter OUTLET, 460 C -- a design choice
          temperatureApproach 5;            // K, a magnitude; the engine assigns the sign
          elements ( N  H  Ar );
          species ( { name N2; atoms ( 2 0 0 ); } { name H2; atoms ( 0 2 0 ); }
                    { name NH3; atoms ( 1 3 0 ); } { name Ar; atoms ( 0 0 1 ); } );
      } }

    //  ---- condensation and separation (step 4) ----
    { name WaterCooler;  type heatExchanger; inputs ( CooledEffluent  Cw );
      outputs ( WaterCooledEffluent  CwOut );
      operation { area 1500 m2;  U 700 W/m2/K;  flow counter; } }
    { name Chiller;      type phaseChanger;  in WaterCooledEffluent;  outputs ( ChilledEffluent );
      operation { outletT 253.15 K; } }                 // -20 C
    { name Separator;    type isothermalFlash;  in ChilledEffluent;
      outputs ( RawLiquid  UnreactedGas );
      operation { T 253.15 K;  P 140 bar; } }

    //  ---- recycle and purge (steps 5-6) ----
    { name PurgeSplit;   type splitter;      in UnreactedGas;   outputs ( Purge  Recycle );
      operation { fractions ( 0.00085  0.99915 ); } }
    { name PurgeValve;   type valve;         in Purge;          outputs ( PurgeLP );
      operation { P 30 bar; } }
    { name PurgeHeater;  type phaseChanger;  in PurgeLP;        outputs ( PurgeWarm );
      operation { outletT 298.15 K; } }
    { name Scrubber;     type absorber;      inputs ( PurgeWarm  WashWater );
      outputs ( ScrubbedGas  AqueousNH3 );
      operation { stages 6; }
      //  The scrubber's OWN thermodynamic world: water is the solvent here,
      //  ammonia the solute.  Henry is a convention for SPARINGLY soluble
      //  solutes, so this is defensible only while the rich liquid stays
      //  dilute (a few % m/m) -- which is what the wash-water rate is for.
      thermo
      {
          equilibrium
          {
              formulation diluteSolution;
              liquid
              {
                  solvent { component water;  standardState pureLiquid; }
                  solutes
                  {
                      components    ( NH3 N2 H2 Ar );
                      standardState infiniteDilution;
                      solutionModel henryDilute;
                      binaryParameters
                      {
                          NH3-water { source "data/standards/parameters/Henry/NH3-water.dat"; }
                          N2-water  { source "data/standards/parameters/Henry/N2-water.dat"; }
                          H2-water  { source "data/standards/parameters/Henry/H2-water.dat"; }
                          Ar-water  { source "data/standards/parameters/Henry/Ar-water.dat"; }
                      }
                  }
              }
              vapour { fugacityModel SRK; }
          }
      } }

    //  ---- finishing (step 7): let-down in two stages to storage ----
    { name LetdownHP;    type isothermalFlash;  in RawLiquid;
      outputs ( LetdownLiquid  LetdownGas );
      operation { T 253.15 K;  P 20 bar; } }
    { name StorageFlash; type isothermalFlash;  in LetdownLiquid;
      outputs ( ProductNH3  FlashGas );
      operation { T 238.15 K;  P 1.01325 bar; } }   // -35 C, see below
    //  WHY -35 C AND NOT -33.4 C.  Liquid ammonia at 1 atm and its own boiling
    //  point is a PURE component ON its saturation curve: there K_NH3 = 1 and
    //  every vapour fraction satisfies the flash, so the answer is whatever
    //  the solver lands on (measured at -34 C: 85 % "vaporised", which is not
    //  a result).  The store is therefore declared 1.7 K below the boiling
    //  point, where the flash only releases the dissolved H2, N2 and Ar.  A
    //  real let-down is an ADIABATIC flash whose ammonia vapour returns to
    //  the refrigeration unit -- part of task 5.
);

utilities
(
    {
        name     CW_LOOP;
        service  coolingWater;
        supply   Cw;
        return   CwOut;
        note     "loop cooling water: the first cut of the effluent's cooling";
    }
);

variables
{
    NH3_t_h            { compute "ProductNH3.F * 17.0305 * 3.6"; }
    NH3_t_day          { compute "NH3_t_h * 24"; }
    W_compression_kW   { compute "N2Boost.W_shaft_kW + MakeupComp1.W_shaft_kW + MakeupComp2.W_shaft_kW + RecycleComp.W_shaft_kW"; }
    W_specific_kWh_t   { compute "W_compression_kW / NH3_t_h"; }
    H2_specific_kg_t   { compute "H2Feed.F * 2.01588 * 3.6 * 1000 / NH3_t_h"; }
    y_NH3_converter    { compute "Converter.y_NH3"; }
    Q_steam_kW         { compute "-Converter.Q_kW"; }
    Q_refrigeration_kW { compute "-Chiller.Q_kW"; }
    purge_kmol_h       { compute "Purge.F * 3600"; }
}
