/*---------------------------------------------------------------------------*\
  GREEN AMMONIA, 1200 t/day -- the base case of the PEQ 2026-27 project base
  data, v2: hydrogen from electrolysis at 30 bar, nitrogen from an on-site
  ASU at 8 bar (99.99 % N2, 100 ppm Ar), a 150 bar synthesis loop with an
  equilibrium converter, and refrigerated separation.  Seventeen units, each
  in its OWN folder (<Unit>/system/flowsheetDict) so any one of them opens
  standalone in the GUI -- a tab of its own, its own What-if -- and no
  sectors: the loop is what a group has to understand.  This file holds the
  plant's topology only: which folders exist, and the pipes between them.

  N2Feed -[N2Boost]-[N2Cooler]-+
                               +-[MakeupMix]-[MakeupComp1]-[Intercooler]-[MakeupComp2]-[Aftercooler]-+
  H2Feed ----------------------+                                                                     |
                                                                                                     v
          Recycle -[RecycleComp]-------------------------------------------------------------->[LoopMix]
             ^                                                                                       |
             |                         +----------- HotEffluent (tear) -----------+                  v
             |                         v                                          |              [FEHE] cold side
             |   CooledEffluent <---[FEHE] hot side                                |                  |
             |        |                                                           |    PreheatedFeed  v
             |   [WaterCooler]  40 C                                    [Converter] 460 C, 5 K approach
             |        |
             |   [Chiller]  -20 C
             |        |
             |   [Separator]  140 bar --- RawLiquid -[LetdownHP]-[StorageFlash]- ProductNH3 (-35 C, 1 atm)
             |        |                                 |              |
             +--[PurgeSplit]-- Purge               LetdownGas      FlashGas

  WHERE EACH NUMBER COMES FROM.  Feeds, loop pressure, the 380 C converter
  inlet and the -20 C separation are the base data (sections 2.3-2.5).  The
  rest are DECLARED here and are the groups' to change:
    * compressors are specified by SHAFT POWER, the only way Choupo's
      compressor is specified; each power was chosen so that its discharge
      lands on the pressure the base data give (30, 67 and 150 bar for the
      make-up, 150 bar for the recycle).  Change a flow and the pressure moves:
      read it, and re-tune the power.
    * the loop pressure drop is LUMPED at the separator (declared at 140 bar,
      i.e. the base data's "recycle compressor dp ~ 10 bar").
    * the converter is ONE Gibbs reactor at its OUTLET temperature, 460 C,
      5 K short of equilibrium (see the comment on the unit).  Its duty is
      the reaction heat the intercoolers remove as steam.
    * every cooler is a phaseChanger with a declared outlet temperature: its
      duty is the heat to remove, and which utility removes it is the group's.
    * the purge fraction gives the base data's ~12 kmol/h purge (stream 8).

  WHAT IS NOT IN THIS CASE, and is the groups' work (base data, section 2.8):
  the converter's beds (number, inlet temperatures, catalyst volume -- they
  need a rate law, tutorials/plant/ammoniaStaged04_kinetic); the H2O + O2 of
  the hydrogen (the feed here is pure H2); the cold gas/gas exchanger before
  the chiller (so the chiller duty is an upper bound); the purge scrubber and
  the let-down gas recovery; the cooling water, the refrigeration cycle and
  the steam system; sizing and economics.

  WHAT THE GROUPS SHOULD NOTICE.  The base data's 18 % per-pass conversion
  (~12 % NH3 out) is a KINETIC figure: at 460 C the equilibrium allows more,
  so this converter converts more per pass and the recycle is about half the
  base data's.  The loop settles at H2/N2 ~ 3.6, not 3, because what leaves
  dissolved in the liquid is nitrogen-rich; and most of the argon leaves
  dissolved in the liquid, not through the purge.

  TOPOLOGY ONLY.  Stream state lives in 0/, one file per stream.
\*---------------------------------------------------------------------------*/

sectors
(
    N2Boost
    N2Cooler
    MakeupMix
    MakeupComp1
    Intercooler
    MakeupComp2
    Aftercooler
    RecycleComp
    LoopMix
    FEHE
    Converter
    WaterCooler
    Chiller
    Separator
    PurgeSplit
    LetdownHP
    StorageFlash
);

boundary
{
    inlets   ( H2Feed  N2Feed );
    outlets  ( ProductNH3  LetdownGas  FlashGas  Purge );
}

connections
{
    H2Feed              { to MakeupMix/H2; }
    N2Feed              { to N2Boost/Feed; }
    N2Compressed        { from N2Boost/Out;  to N2Cooler/Feed; }
    N2Cooled            { from N2Cooler/Out;  to MakeupMix/N2; }
    Makeup30            { from MakeupMix/Out;  to MakeupComp1/Feed; }
    Makeup67            { from MakeupComp1/Out;  to Intercooler/Feed; }
    Makeup67Cool        { from Intercooler/Out;  to MakeupComp2/Feed; }
    Makeup150           { from MakeupComp2/Out;  to Aftercooler/Feed; }
    Makeup              { from Aftercooler/Out;  to LoopMix/Makeup; }
    Recycle             { from PurgeSplit/Recycle;  to RecycleComp/Feed; }
    CompRecycle         { from RecycleComp/Out;  to LoopMix/Recycle; }
    Mixed               { from LoopMix/Out;  to FEHE/Cold; }
    PreheatedFeed       { from FEHE/ColdOut;  to Converter/Feed; }
    HotEffluent         { from Converter/Out;  to FEHE/Hot; }
    CooledEffluent      { from FEHE/HotOut;  to WaterCooler/Feed; }
    WaterCooledEffluent { from WaterCooler/Out;  to Chiller/Feed; }
    ChilledEffluent     { from Chiller/Out;  to Separator/Feed; }
    RawLiquid           { from Separator/Liquid;  to LetdownHP/Feed; }
    UnreactedGas        { from Separator/Vapour;  to PurgeSplit/Feed; }
    Purge               { from PurgeSplit/Purge; }
    LetdownLiquid       { from LetdownHP/Liquid;  to StorageFlash/Feed; }
    LetdownGas          { from LetdownHP/Vapour; }
    ProductNH3          { from StorageFlash/Liquid; }
    FlashGas            { from StorageFlash/Vapour; }
}

variables
{
    NH3_t_h            { compute "ProductNH3.F * 17.0305 * 3.6"; }
    NH3_t_day          { compute "NH3_t_h * 24"; }
    W_compression_kW   { compute "N2Boost.W_shaft_kW + MakeupComp1.W_shaft_kW + MakeupComp2.W_shaft_kW + RecycleComp.W_shaft_kW"; }
    W_specific_kWh_t   { compute "W_compression_kW / NH3_t_h"; }
    H2_specific_kg_t   { compute "H2Feed.F * 2.01588 * 3.6 * 1000 / NH3_t_h"; }
    y_NH3_converter    { compute "Converter.y_NH3"; }
    Q_steam_kW         { compute "-Converter.Q_kW"; }
    Q_refrigeration_kW { compute "-Chiller.Q_kW"; }
    purge_kmol_h       { compute "Purge.F * 3600"; }
}
