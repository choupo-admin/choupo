/*--------------------------------*- Choupo -*--------------------------------*\
  postDict -- the sizing -> costing -> economics chain of the 500 t/day green
  ammonia unit.  EVERYTHING in this file is a DESIGN DECISION of the group:
  the U values, the design LMTDs, the design pressures, the catalyst volume
  and the residence times.  Change them and read the effect on the FCI.

  BATTERY LIMITS: the electrolyser park and the ASU are OUTSIDE.  The FCI that
  comes out of here is the SYNTHESIS LOOP + compression, not the whole plant.
\*---------------------------------------------------------------------------*/
sizing
{
    //  A `unitName` IS THE ENGINE'S NAME OF THE UNIT.  This case is flat, so
    //  that is the name in system/flowsheetDict (`Separator`, not
    //  `LOOP.Separator`); a name the result does not know fails the sizing
    //  unit by unit and starves the costing behind it.
    //
    //  NOT SIZED HERE, and said so rather than filled with a guess: the three
    //  catalyst beds (a bed reaching 5 K from equilibrium has no volume --
    //  the catalyst charge needs the kinetics, task 2), the inter-bed boilers,
    //  the coolers and the chiller (their duties are in the result; their
    //  exchangers and the refrigeration and steam systems are tasks 5 and 6).
    //  The capital below is therefore INCOMPLETE and must not be quoted as
    //  the plant's.
    units
    (
        { unitName N2Boost;      type compressor;  material carbonSteel;
          designRules { pressureDesign 35.0; } }
        { unitName MakeupComp1;  type compressor;  material carbonSteel;
          designRules { pressureDesign 80.0; } }
        { unitName MakeupComp2;  type compressor;  material SS316;
          designRules { pressureDesign 180.0; } }
        { unitName RecycleComp;  type compressor;  material SS316;
          designRules { pressureDesign 180.0; } }

        { unitName FEHE;         type shellTubeHX;  material SS316;
          designRules { U 550.0;  LMTD 60.0;  pressureDesign 180.0; } }
        { unitName WaterCooler;  type shellTubeHX;  material carbonSteel;
          designRules { U 700.0;  LMTD 20.0;  pressureDesign 180.0; } }

        { unitName Separator;    type vessel;  material SS316;
          designRules { residenceTime 45.0;  flowKey F_beta;  flowUnit kmol/s;
                        L_over_D 3.0;  pressureDesign 170.0;
                        corrosionAllow 0.003;  jointEfficiency 1.0; } }
        { unitName LetdownHP;    type vessel;  material carbonSteel;
          designRules { residenceTime 60.0;  flowKey F_beta;  flowUnit kmol/s;
                        L_over_D 3.0;  pressureDesign 25.0;
                        corrosionAllow 0.003;  jointEfficiency 1.0; } }
    );
}
costing
{
    method    Turton;
    year      2026;
    cepci     820;
    cepci2001 397;
    usdToEur  0.92;
}
economics
{
    method              discountedCashFlow;
    projectLife         20;
    constructionPeriod  2;
    discountRate        0.08;
    taxRate             0.21;
    depreciation        straightLine;
    depreciableLife     10;
    salvageFraction     0.0;
    workingCapital      0.15;
    streamFactor        0.685;      // 6000 h/year: 300 kt/y at 50 t/h (base data 2.2)
    siteFactor          0.50;
    contingencyFee      1.18;
    estimateClass       4;
    refuseOnMissingPrice 1;
}
