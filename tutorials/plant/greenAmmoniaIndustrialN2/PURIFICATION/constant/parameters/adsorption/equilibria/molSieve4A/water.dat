/*--------------------------------*- Choupo -*--------------------------------*\
  Adsorption isotherm -- water on 4A molecular sieve.

      q = q_max * b(T) * p / (1 + b(T) * p)          [mol/kg, p in bar]
      b(T) = b_298 * exp( -dH_ads/R * (1/T - 1/tRef) )

  Water on 4A is a nearly irreversible adsorbate at ambient temperature
  (b*p >> 1 even at millibar partial pressures: that is why a molecular-sieve
  dryer delivers ppm) and desorbs with the heat of regeneration.  q_max
  12 mol/kg = 216 g/kg is the saturation loading; the cycle's WORKING capacity
  (the difference between the loading at T_ads and at T_regen) is what
  tsaTwinBed computes and reports.

  TEACHING ANCHOR -- an order-of-magnitude fit at 298 K, not design data.  A
  serious sizing starts from the vendor's isotherm.
\*---------------------------------------------------------------------------*/

recordType      adsorptionIsotherm;
schemaVersion   1;

adsorbent       molSieve4A;
adsorbate       water;

model           langmuir;

parameters
{
    q_max   12.0;     // saturation loading [mol/kg]
    b_298   1.0e4;    // affinity at tRef [1/bar]
    dH_ads  -55000;   // isosteric heat of adsorption [J/mol] (<0, exothermic)
}

tRef            298.15;
loadingBasis    molPerKgAdsorbent;
pressureBasis   partialPressureBar;
quality         teachingOnly;

provenance
{
    origin    assumed;
    method    "order of magnitude from Ruthven (1984) and commercial 4A data sheets; teaching anchor for the PEQ 2026-27 case";
    curation  "authored for greenNH3_04; not migrated from the catalogue (there is no 4A-water pair in data/standards)";
}
