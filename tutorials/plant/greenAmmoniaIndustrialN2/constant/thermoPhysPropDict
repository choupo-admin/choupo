/*---------------------------------------------------------------------------*\
  thermoPhysPropDict (v2) -- T6 dilute-solution (Henry) world.  Henry is a
  CONVENTION for the solutes group, not a model of the whole liquid: the
  solvent sits on the pure-liquid (Raoult) rung, each solute on the
  infinite-dilution rung.  The builder VERIFIES every declared pair file.
  Migrated mechanically from the v1 flat solvent/solutes form (physics
  identical -- the solutes list states the engine's own Henry selection);
  v2 contract 2026-07-17.

  greenNH3_04: ARGON added to the solutes group, and O2 added to the components.

  Without the Ar-NH3 pair, argon fell onto the Raoult rung with a vapour
  pressure extrapolated ABOVE its critical temperature: K_Ar = 1.7 in the
  separator against K_N2 = 124, and argon left dissolved in the product instead
  of accumulating in the loop.  The pair was fitted from the IUPAC-NIST
  Solubility Data Series Vol. 4 -- see the header of
  constant/parameters/Henry/Ar-NH3.dat and the dossier in curation/Ar-NH3/.

  Oxygen exists ONLY in the purification section (it comes in with the
  industrial nitrogen and is consumed entirely in the deoxo); it never reaches
  the synthesis loop, so it needs no Henry pair in ammonia.  Water was already
  declared (cooling water) and is now also the deoxo reaction product.
\*---------------------------------------------------------------------------*/

recordType    thermophysicalPropertySystem;
schemaVersion 2;

components       ( N2  H2  NH3  Ar  water  O2 );

equilibrium
{
    formulation diluteSolution;

    liquid
    {
        solvent
        {
            component     NH3;
            standardState pureLiquid;          // the Raoult rung
        }
        solutes
        {
            components    ( N2 H2 Ar );
            standardState infiniteDilution;    // the Henry rung
            solutionModel henryDilute;
            binaryParameters
            {
                N2-NH3 { source "data/standards/parameters/Henry/N2-NH3.dat"; }
                H2-NH3 { source "data/standards/parameters/Henry/H2-NH3.dat"; }
                Ar-NH3 { source "constant/parameters/Henry/Ar-NH3.dat"; }
            }
        }
    }

    vapour
    {
        fugacityModel SRK;
    }
}
