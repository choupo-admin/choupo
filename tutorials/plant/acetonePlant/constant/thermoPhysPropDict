recordType    thermophysicalPropertySystem;
schemaVersion 1;

components       ( isopropanol  acetone  H2  water );

equilibrium
{
    formulation gammaPhi;
    liquid  { activityModel { model UNIFAC; }  standardState pureLiquid; }
    vapour  { fugacityModel idealGas; }
}

//  VAPOUR (C239 S6, measured 2026-11-23,
//    docs/audits/2026-11-23-c239-s5-vapour-measurement.md): the vapour is
//    IDEAL at 1 atm, where the real one has phi 0.95-0.97.  With the WHOLE
//    plant on SRK the duties of column C1 move 1.10 % (condenser) and 1.15 %
//    (reboiler).  That is a plant-wide figure, not the column's alone: the
//    real vapour also changes the hydrogen split in the flash and the recycle,
//    so C1's feed changes; per mole of C1 feed the duties move 0.74 % and 0.79
//    %.

//  THE ONE APPROXIMATION THIS CASE BUYS, declared so it can be refused if
//  nobody wants it and RECORDED in the answer when they do.
//
//  UNIFAC prices a component from its molecular groups.  There is no UNIFAC
//  group for hydrogen -- none exists in the published table, and inventing one
//  would be fabrication rather than approximation -- so without this block the
//  package REFUSES by name (forum #67, and the refusal is right).
//
//  What gamma = 1 buys here, and what it does NOT: H2 leaves the flash almost
//  entirely in the vapour, which is physically correct, but it does so because
//  its liquid reference is a vapour pressure extrapolated far above its own
//  critical temperature (33.18 K) -- the run says so in the caveats.  The
//  answer is right for the wrong reason, and the size of what is at stake is
//  small: Luyben's own F1 carries H2 at a mole fraction of 2e-4.
//
//  C256 (2026-11-09), MEASURED: the H2 the flash leaves in flashLiquid
//  (0.27 mol %), carried into C1 and out in acetoneProduct (0.11 %), rests on
//  a vapour pressure CONTINUED past H2's Tc -- it is not a solubility, and
//  slice 5a had moved the vent gas by +129 % between two such numbers.  The
//  first honest rung is Henry (the catalogue holds H2-water) and the ABSORBER
//  now takes it (its per-unit diluteSolution world, system/flowsheetDict),
//  but a Henry solute can only be declared inside that world, whose other
//  components are ideal: putting the flash there would discard the UNIFAC
//  surface the acetone/IPA/water split needs, and no mixed-solvent Henry
//  route exists.  The flash keeps this approximation; the number stays a
//  declared non-K.
approximations
{
    componentOutsideActivityModel
    {
        components ( H2 );
        reason     "supercritical permanent gas; no UNIFAC group exists for hydrogen, and its liquid mole fraction in this flowsheet is 2e-4 (Luyben F1). Henry in a mixed solvent is the principled route and is the deferred D3 transfer term";
    }
}

//  VARIANTS (DEV.md 4c C398 / C402): what a unit's inline `thermo { }` used to
//  carry, now NAMED here and selected by `thermo <name>;` in the unit.  A variant
//  states only what differs from the system above; the rest is the system's.
variants
{
    //  Dilute-solution (Henry) world of the absorber; see the comment on the unit.
    henryAbsorber
    {
        equilibrium
        {
            formulation diluteSolution;

            liquid
            {
                solvent
                {
                    component     water;
                    standardState pureLiquid;
                }
                solutes
                {
                    components    ( acetone  H2 );
                    standardState infiniteDilution;
                    solutionModel henryDilute;
                    binaryParameters
                    {
                        acetone-water { }
                        //  C256 (2026-11-09): H2 is above its critical
                        //  temperature (33.2 K) here; on the Raoult rung
                        //  its K was a vapour pressure continued past Tc
                        //  (A_H2 0.0016 printed from it), so it dissolves
                        //  by Henry like the acetone -- as in acetone05.
                        H2-water      { }
                    }
                }
            }

            vapour { fugacityModel idealGas; }
        }
    }
}
