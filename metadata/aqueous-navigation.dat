    Sr    { familyRoots ( strontium );  }

    // --- transition / heavy metals ----------------------------------------
    FeII    { familyRoots ( iron );       }
    FeIII  { familyRoots ( iron );       }
    MnII    { familyRoots ( manganese );  }
    MnIII  { familyRoots ( manganese );  }
    MnO4   { familyRoots ( manganese );  }
    CrO4   { familyRoots ( chromium );   }
