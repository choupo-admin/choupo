{
  "name": "Choupo",
  "short_name": "Choupo",
  "description": "A glass-box chemical process simulator that runs in the browser.",
  "start_url": "/app/",
  "scope": "/app/",
  "display": "standalone",
  "background_color": "#ffffff",
