/*---------------------------------------------------------------------------*\
  Choupo STAGING record  --  PRIVATE tier (data/tmp/, gitignored).

  Aqueous solubility (solid-liquid equilibrium) of atrazine in water.

  ARITY 2: this is a SYSTEM property, not an intrinsic component field.
  Reclassified 2026-07-24 out of a comment line in
  data/tmp/components/atrazine.candidate.dat  (RECORD_SPEC.md arity rule:
  "zero usable science may live only in a comment").

  PHASE 4 (2026-07-24, agent:solubility) -- solid-phase identification and
  rights clearance.  VERDICT: solid phase NOT ESTABLISHED, but this is the cleanest
  numeric pair in the family and the primary lineage is a research article.
  The runtime does not read this tier yet.
\*---------------------------------------------------------------------------*/

recordType      solubility;
schemaVersion   1;
recordId        atrazine-water;
participants    ( atrazine water );
property        aqueousSolubility;

conditions
{
    temperature   298.15 K;   // 25 C
    pressure      101325 Pa;   // ambient, ASSUMED -- not stated by the source
    phase         aqueous;
    solidPhase    unspecified;
    phaseBasis    notEstablished;
}

// PHASE 4 search: no phase-identified determination located.  Atrazine is
// not known to form a hydrate, and the two independent numbers agree to
// within their temperature difference -- so the practical risk from the
// missing phase is low here.  It is still not stated, so it is still a
// gap; the record says which kind of gap it is.
value
{
    solubility    33 mg/L;
    originalStatement  "33 mg/L @ 25 C";   // verbatim, before conversion
}

alternativeDeterminations
{
    wardWeber1968
    {
        solubility    34.7 mg/L;
        conditions    { temperature 299.15 K; solidPhase unspecified; phaseBasis notEstablished; }
        origin        measured;
        citation      "Ward, T.M. & Weber, J.B., J. Agric. Food Chem. 16 (1968) 959 (measuring primary)";
        note          "consistent with the headline value given the 1 C difference";
    }
}

provenance
{
    origin      measured;
    citation    "Yalkowsky, S.H., Handbook of Aqueous Solubility Data, 2nd ed., CRC 2010, p.152; primary lineage Ward, T.M. & Weber, J.B., J. Agric. Food Chem. 16 (1968) 959";
    doi         "-";
    licence     "facts, primary-cited";
    evidenceId  -;
    curator     "agent:solubility";
    retrieved   2026-07-24;
}

blockedBy       "no source states the equilibrating solid phase";
status          flagged;
