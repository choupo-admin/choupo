/*---------------------------------------------------------------------------*\
  Choupo STAGING record  --  PRIVATE tier (data/tmp/, gitignored).

  Aqueous solubility (solid-liquid equilibrium) of xylitol in water.

  ARITY 2: this is a SYSTEM property, not an intrinsic component field.
  Reclassified 2026-07-24 out of a comment line in
  data/tmp/components/xylitol.candidate.dat  (RECORD_SPEC.md arity rule:
  "zero usable science may live only in a comment").

  PHASE 4 (2026-07-24, agent:solubility) -- solid-phase identification and
  rights clearance.  VERDICT: number DELETED on rights grounds; it was flagged as
  order-of-magnitude in its own component record anyway.
  The runtime does not read this tier yet.
\*---------------------------------------------------------------------------*/

recordType      solubility;
schemaVersion   1;
recordId        xylitol-water;
participants    ( xylitol water );
property        aqueousSolubility;

conditions
{
    temperature   298.15 K;   // 25 C, as the withdrawn source stated
    pressure      101325 Pa;   // ambient, ASSUMED
    phase         aqueous;
    solidPhase    unspecified;
    phaseBasis    notEstablished;
}

// RIGHTS ACTION (phase 4): NUMBER DELETED.
//
// The only carrier of this value was The Merck Index -- a paywalled
// commercial compilation with no grant to honour.  The phase-4 rule is
// that a non-redistributable number is not kept merely because it is
// convenient: either it is re-routed to an open source that is verified
// to report the same quantity, or it goes.  A search for an open
// measuring primary reporting this solubility did not find one that
// could be read and verified, so the digit has been removed rather than
// re-labelled.  What remains is a structured absence: the record still
// exists, still declares the equilibrium it is about, and states exactly
// what is missing and why.
//
// Nothing of value was lost: the component record itself already labelled
// the withdrawn figure an approximation ("very soluble"), i.e. it was an
// order-of-magnitude statement dressed as a measurement.  Xylitol is also
// known in more than one crystalline form, and no source consulted said
// which one it dissolved.
value
{
    available     none;   // number DELETED in phase 4 -- see blockedBy
}

provenance
{
    origin      -;
    citation    "WITHDRAWN -- the previous value came from The Merck Index (paywalled commercial compilation) and is not redistributable; no open primary located";
    doi         "-";
    licence     "-";
    evidenceId  -;
    curator     "agent:solubility";
    retrieved   2026-07-24;
}

blockedBy       "The Merck Index -- not redistributable, value deleted; the withdrawn figure was explicitly an approximation; no source states the equilibrating solid phase";
status          flagged;
