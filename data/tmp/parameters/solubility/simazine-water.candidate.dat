/*---------------------------------------------------------------------------*\
  Choupo STAGING record  --  PRIVATE tier (data/tmp/, gitignored).

  Aqueous solubility (solid-liquid equilibrium) of simazine in water.

  ARITY 2: this is a SYSTEM property, not an intrinsic component field.
  Reclassified 2026-07-24 out of a comment line in
  data/tmp/components/simazine.candidate.dat  (RECORD_SPEC.md arity rule:
  "zero usable science may live only in a comment").

  PHASE 4 (2026-07-24, agent:solubility) -- solid-phase identification and
  rights clearance.  VERDICT: rightsPending CLEARED by re-routing to the open USDA-ARS
  PPD; solid phase still NOT ESTABLISHED.
  The runtime does not read this tier yet.
\*---------------------------------------------------------------------------*/

recordType      solubility;
schemaVersion   1;
recordId        simazine-water;
participants    ( simazine water );
property        aqueousSolubility;

conditions
{
    temperature   295.15 K;   // 22 C -- as stated by the OPEN source
    pressure      101325 Pa;   // ambient, ASSUMED -- not stated by the source
    phase         aqueous;
    solidPhase    unspecified;
    phaseBasis    notEstablished;
}

// RIGHTS ACTION (phase 4).  Phase 2 carried 6.2 mg/L attributed to
// Tomlin (ed.), The Pesticide Manual, 11th ed., BCPC 1997 -- a paywalled
// commercial compilation, hence rightsPending.  The USDA-ARS Pesticide
// Properties Database, a US-government public-domain compilation, reports
// the SAME quantity for simazine and was read directly:
//
//     Water solubility (ppm):   -temp-   -source-   -reference-
//     3.5                        20         H        9HERBH
//     84                         85         H        9HERBH
//     6.2*                       22         M        9CIBAG
//     5                                     C        JPFCD2 22:55-69,1987
//
// (* = the value ARS selects when several exist; M = manufacturer data,
//  H = handbook, C = calculated.)  The selected entry is 6.2 ppm at 22 C.
// The number is therefore re-routed to the open source and the record is
// no longer rightsPending.  NOTE what changed with it: the open source
// states 22 C, not the 20 C the paywalled compilation stated, and it
// carries no pH.  The phase-2 "pH 7, 20 C" framing came from the
// withdrawn source and has been dropped rather than transplanted.
value
{
    solubility    6.2 mg/L;
    originalStatement  "6.2 ppm @ 22 C (selected value, manufacturer data, ref 9CIBAG)";   // verbatim from the open source
}

alternativeDeterminations
{
    ars20C
    {
        solubility    3.5 mg/L;
        conditions    { temperature 293.15 K; solidPhase unspecified; phaseBasis notEstablished; }
        origin        measured;
        citation      "USDA-ARS PPD, handbook entry, ref 9HERBH";
        note          "same open table, 20 C -- 1.8x below the selected value";
    }
    ars85C
    {
        solubility    84 mg/L;
        conditions    { temperature 358.15 K; solidPhase unspecified; phaseBasis notEstablished; }
        origin        measured;
        citation      "USDA-ARS PPD, handbook entry, ref 9HERBH";
        note          "same open table, 85 C -- the only temperature leverage available here";
    }
}

provenance
{
    origin      measured;
    citation    "USDA-ARS Pesticide Properties Database (PPD), individual pesticide file; US Department of Agriculture, Agricultural Research Service -- US-government work, public domain (SIMAZINE.TXT), selected value, manufacturer data ref 9CIBAG";
    doi         "-";
    licence     "US-government work, public domain";
    evidenceId  -;
    curator     "agent:solubility";
    retrieved   2026-07-24;
}

blockedBy       "no source states the equilibrating solid phase";
status          flagged;
