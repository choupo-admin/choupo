recordType      partitionCoefficient;
schemaVersion   1;
recordId        ibuprofen-octanol-water;
participants    ( ibuprofen octanol water );
property        logKow;

conditions
{
    temperature   298.15 K;   // 25 C -- the conventional log P reference
                  // temperature is NOT restated by the source; the
                  // 25 C convention is assumed and flagged here.
    pressure      101325 Pa;   // ambient, ASSUMED -- not stated by the source
    pH            "neutral form";
    chemicalForm  neutral;
}

// NEUTRAL-form partition.  The component comment also carries a loose
// 'logD(pH7) ~ 1.0' aside with NO primary -- deliberately NOT recorded
// here: a logD at a stated pH is a separate measurement, not a note.
value
{
    logKow   3.97;   // dimensionless (log10 of a concentration ratio)
}

provenance
{
    origin      measured;
    citation    "Avdeef, A., J. Pharm. Sci. 82 (1993) 183-190; via PubChem HSDB";
    doi         "-";
    licence     "facts, primary-cited";
    evidenceId  -;
    curator     "agent:partition";
    retrieved   2026-07-24;
}

status          flagged;

