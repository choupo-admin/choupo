recordType      diffusionCoefficient;
schemaVersion   1;
recordId        diffusion-carbamazepine-water;
participants    ( carbamazepine water );
property        aqueousDiffusionCoefficient;

conditions
{
    temperature   298.15 K;
    phase         aqueous;
    composition   infiniteDilution;
}

value
{
    D             6.6e-10 m2/s;
}

validity
{
    temperatureRange   ( 298.15 298.15 ) K;   // single-point datum
    concentration      infiniteDilution;
}

// how THIS value was obtained (glass-box; inputs stated in full)
derivation
{
    method                 "Stokes-Einstein D = kT/(6 pi eta r)";
    radius                 0.37 nm;
    radiusOrigin           "MEASURED - see record hydrodynamicRadius-carbamazepine-water";
    viscosity              0.890e-3 Pa.s;
    temperature            298.15 K;
    origin                 derived;
}

pendingPrimary
{
    route         "a measured D exists: Fluid Phase Equilibria 580 (2024) 114056 (Taylor dispersion, 298.15 K) - PAYWALLED; prefer it over this derivation once transcribed";

    // PHASE 7 (2026-07-25) -- the route citation was RESOLVED to a full reference, and
    // retrieval was attempted.  Identification only; the digit was NOT read.
