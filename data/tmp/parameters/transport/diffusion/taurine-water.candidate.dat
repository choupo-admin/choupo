recordType      diffusionCoefficient;
schemaVersion   1;
recordId        diffusion-taurine-water;
participants    ( taurine water );
property        aqueousDiffusionCoefficient;

conditions
{
    temperature   298.15 K;
    phase         aqueous;
    composition   infiniteDilution;
}

value
{
    D             8.7e-10 m2/s;
}

validity
{
    temperatureRange   ( 298.15 298.15 ) K;   // single-point datum
    concentration      infiniteDilution;
}

// how THIS value was obtained (glass-box; inputs stated in full)
derivation
{
    method                 "Stokes-Einstein D = kT/(6 pi eta r), r from the partial molar volume";
    radius                 0.28 nm;   // approximate, as recorded in the source comment
    radiusOrigin           "Choupo estimate from the partial molar volume V_molar";
    partialMolarVolume     93 cm3/mol;   // approximate, as recorded in the source comment
    viscosity              0.8903e-3 Pa.s;
    temperature            298.15 K;
    partialMolarVolumeStatus "FLAGGED approximate - verify digit-exact vs Millero, Lo Surdo & Shin, J. Phys. Chem. 82 (1978) 784 / Mishra & Ahluwalia, J. Phys. Chem. 88 (1984) 86";
    origin                 estimated;
}

flagged
{
    reason        "Choupo own estimate, NOT a measurement; the measured primary is paywalled";
    route         "no open primary located; transcribe from a primary aqueous-diffusion study";
    action        "PHASE-6 SEARCH (2026-07-24) found no open measured primary. Taurine is a
                  SULFONIC zwitterion, not an alpha-amino acid, so it is absent from all three
                  standard alpha-amino-acid diffusion sets (Umecky, T.; Kuga, T.; Funazukuri,
                  T., 'Infinite Dilution Binary Diffusion Coefficients of Several alpha-Amino
                  Acids in Water over a Temperature Range from (293.2 to 333.2) K', J. Chem.
                  Eng. Data 51 (2006) 1705-1710, doi 10.1021/je060149b (Taylor dispersion;
                  closed, checked 2026-07-24); Ma, Y.; Zhu, C.; Ma, P.; Yu, K. T., 'Studies on
                  the Diffusion Coefficients of Amino Acids in Aqueous Solutions', J. Chem.
                  Eng. Data 50 (2005) 1192, doi 10.1021/je049582g (closed); Longsworth, J. Am.
                  Chem. Soc. 75 (1953) 5705-5709, doi 10.1021/ja01118a065 (Gouy, 25 deg C,
                  infinite dilution; closed, no repository copy)) - do not keep pointing this
                  record at them. The realistic determination is a PFG-NMR (DOSY) self-
                  diffusion measurement of taurine in H2O at 298 K, or a Taylor-dispersion
                  run; search the osmolyte / taurine-transport physical-chemistry literature
                  rather than the amino-acid literature.  Independently, V0(taurine) ~ 93
                  cm3/mol is FLAGGED and this estimate is built on it - the volume must be
                  fixed first.";
}

provenance
{
    origin        estimated;
    citation      "Choupo own Stokes-Einstein estimate from the partial molar volume (V_molar primary: Millero, Lo Surdo & Shin, J. Phys. Chem. 82 (1978) 784)";
    doi           "-";
    licence       "facts, primary-cited";
    evidenceId    -;
    curator       "agent:diffusion";
    retrieved     2026-07-24;
}

status          flagged;
