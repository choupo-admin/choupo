recordType      diffusionCoefficient;
schemaVersion   1;
recordId        diffusion-arginine-water;
participants    ( arginine water );
property        aqueousDiffusionCoefficient;

conditions
{
    temperature   298.15 K;
    phase         aqueous;
    composition   infiniteDilution;
}

value
{
    D             6.6e-10 m2/s;
}

validity
{
    temperatureRange   ( 298.15 298.15 ) K;   // single-point datum
    concentration      infiniteDilution;
}

// how THIS value was obtained (glass-box; inputs stated in full)
derivation
{
    method                 "Stokes-Einstein D = kT/(6 pi eta r), r from the partial molar volume";
    radius                 0.369 nm;
    radiusOrigin           "Choupo estimate from the partial molar volume V_molar";
    partialMolarVolume     127.3 cm3/mol;   // approximate, as recorded in the source comment
    viscosity              0.8903e-3 Pa.s;
    temperature            298.15 K;
    partialMolarVolumeStatus "FLAGGED approximate - verify digit-exact vs Millero, Lo Surdo & Shin, J. Phys. Chem. 82 (1978) 784 / Mishra & Ahluwalia, J. Phys. Chem. 88 (1984) 86";
    origin                 estimated;
}

flagged
{
    reason        "Choupo own estimate, NOT a measurement; the measured primary is paywalled";
    route         "arginine aqueous diffusion, Fluid Phase Equilib. 187-188 (2001) 61 - PAYWALLED; also Germann, Turner & Allison, J. Phys. Chem. A 111 (2007) 1452 (NMR, 12 amino acids) - measured in D2O at pD 3.5 (cationic form): needs an H2O/charge correction";
    action        "PHASE-6 SEARCH (2026-07-24) found no open measured primary. Two independent
                  defects, both must close.  (1) The DATUM: the phase-2 route 'Fluid Phase
                  Equilib. 187-188 (2001) 61' is a bare volume/page with no title or authors
                  and could NOT be resolved in phase 6 - either pin it or drop it; the
                  resolvable alternatives are Umecky, T.; Kuga, T.; Funazukuri, T., 'Infinite
                  Dilution Binary Diffusion Coefficients of Several alpha-Amino Acids in Water
                  over a Temperature Range from (293.2 to 333.2) K', J. Chem. Eng. Data 51
                  (2006) 1705-1710, doi 10.1021/je060149b (Taylor dispersion; closed, checked
