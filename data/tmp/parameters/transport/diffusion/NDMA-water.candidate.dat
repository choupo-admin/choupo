recordType      diffusionCoefficient;
schemaVersion   1;
recordId        diffusion-NDMA-water;
participants    ( NDMA water );
property        aqueousDiffusionCoefficient;

conditions
{
    temperature   298.15 K;
    phase         aqueous;
    composition   infiniteDilution;
}

value
{
    D             1.1e-9 m2/s;
}

validity
{
    temperatureRange   ( 298.15 298.15 ) K;   // single-point datum
    concentration      infiniteDilution;
}

// how THIS value was obtained (glass-box; inputs stated in full)
derivation
{
    method                 "order-of-magnitude literature value; no correlation, no primary";
    origin                 estimated;
}

flagged
{
    reason        "ORDER-OF-MAGNITUDE ONLY - no primary source, no method";
    route         "fill from a primary aqueous-diffusion / RO-transport study (nitrosamine size-diffusivity vs permeability literature)";
    action        "PHASE-6 SEARCH (2026-07-24) found no open measured primary. As with
                  acrylamide this is a bare order of magnitude with no method and no primary.
                  One concrete unexplored lead was identified on 2026-07-24: the open thesis
                  'Assessment and optimisation of N-nitrosamine rejection by reverse osmosis
                  for planned potable water recycling applications' (Research Online,
                  University of Wollongong) - OPEN and downloadable; check whether it MEASURES
                  D_aq(NDMA) or merely cites it, because a thesis quoting a number is not the
                  primary and must be followed back.  Otherwise search the nitrosamine
                  physical-chemistry literature for a diaphragm-cell or Taylor-dispersion
                  determination.  Failing both, replace the bare number with a method-declared
                  estimate.  Note also the ledger's separate defect: this component declares
                  role nonvolatile while its own boiling point is ~152 deg C.";
}

provenance
{
    origin        estimated;
    citation      "literature order-of-magnitude only; NO primary pinned at curation";
    doi           "-";
    licence       "facts, primary-cited";
    evidenceId    -;
    curator       "agent:diffusion";
    retrieved     2026-07-24;
}

status          flagged;
