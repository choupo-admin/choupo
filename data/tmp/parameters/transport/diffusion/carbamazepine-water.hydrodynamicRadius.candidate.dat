// This radius was MEASURED independently - it is NOT the Stokes radius
// back-computed from a diffusion coefficient, and carries its own provenance.

recordType      hydrodynamicRadius;
schemaVersion   1;
recordId        hydrodynamicRadius-carbamazepine-water;
participants    ( carbamazepine water );
property        hydrodynamicRadius;

conditions
{
    temperature   298.15 K;
    phase         aqueous;
    composition   infiniteDilution;
}

value
{
    radius        0.37 nm;
}

crossCheck
{
    note          "D_aq = 6.6e-10 m2/s is DERIVED from this radius - see record diffusion-carbamazepine-water; it is not an independent measurement";
}

provenance
{
    origin        measured;
    method        "nanofiltration hindered-transport characterisation";
    citation      "Hidalgo, Gomez, Murcia et al., Membranes 13 (2023) 868, Table 3 (open access, CC-BY)";
    doi           "10.3390/membranes13110868";
    licence       "facts, primary-cited";
    evidenceId    -;
    curator       "agent:diffusion";
    retrieved     2026-07-24;
}

status          candidate;
