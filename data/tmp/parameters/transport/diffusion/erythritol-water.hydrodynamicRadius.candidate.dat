// This radius was MEASURED independently - it is NOT the Stokes radius
// back-computed from a diffusion coefficient, and carries its own provenance.

recordType      hydrodynamicRadius;
schemaVersion   1;
recordId        hydrodynamicRadius-erythritol-water;
participants    ( erythritol water );
property        hydrodynamicRadius;

conditions
{
    temperature   298.15 K;   // ambient, as recorded; the source states no
                             // single thermostatted T - VERIFY at curation
    phase         aqueous;
    composition   aqueousSolutionDroplet;   // erythritol-water particles,
                             // NOT a bulk infinite-dilution measurement
}

value
{
    radius        0.34 nm;
    uncertainty   0.01 nm;
}

crossCheck
{
    note          "the Choupo geometric equivalent-sphere radius (0.322 nm from the solid molar volume) corroborates but is a SEPARATE, estimated quantity";
}

provenance
{
    origin        measured;
    method        "viscosity / Stokes-Einstein on erythritol-water particles";
    citation      "Song, Marsh et al., Atmos. Meas. Tech. 11 (2018) 4809";
    doi           "-";
    licence       "facts, primary-cited";
    evidenceId    -;
    curator       "agent:diffusion";
    retrieved     2026-07-24;
}

status          candidate;
