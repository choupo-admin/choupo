/*----------------------------*- Choupo (CANDIDATE) -*----------------------*\
  STAGING RECORD - PRIVATE tier (data/tmp, gitignored).  Envelope per
  data/tmp/RECORD_SPEC.md.  The runtime does NOT read this file yet.

  ARITY 2: an aqueous diffusion coefficient is a SOLUTE-SOLVENT
  (system) property, not an intrinsic pure-compound datum -> it lives under
  parameters/, never inside components/<name>.candidate.dat.

  Provenance chain: extracted 2026-07-24 (phase-2 reclassification) from the
  comment block of components/estrone.candidate.dat; primary citation
  cross-checked against data/tmp/hormones_SOURCES.md.  The value and its
  citation were MOVED verbatim - nothing was re-derived, rounded or improved.
\*---------------------------------------------------------------------------*/


recordType      diffusionCoefficient;
schemaVersion   1;
recordId        diffusion-estrone-water;
participants    ( estrone water );
property        aqueousDiffusionCoefficient;

conditions
{
    temperature   298.15 K;
    phase         aqueous;
    composition   infiniteDilution;
}

value
{
    D             5.5e-10 m2/s;
}

validity
{
    temperatureRange   ( 298.15 298.15 ) K;   // single-point datum
    concentration      infiniteDilution;
}

// how THIS value was obtained (glass-box; inputs stated in full)
derivation
{
    method                 "Wilke-Chang D = 7.4e-8*(phi*M_w)^0.5*T/(mu*Vb^0.6) cm2/s, phi=2.6, M_w=18 g/mol, T=298.15 K, mu=0.890 cP; Vb = Le Bas additive volume";
    leBasVolume            306 cm3/mol;   // approximate, as recorded in the source comment
    viscosity              0.890e-3 Pa.s;
    temperature            298.15 K;
    origin                 estimated;
}

// a Stokes radius computed FROM the D above is NOT an independent datum
derived
{
    equation      "r = kT/(6 pi mu D)";
    viscosity     0.890e-3 Pa.s;
    temperature   298.15 K;
    radius        0.45 nm;   // PROVISIONAL: recompute if D is replaced
    origin        derived;
}

flagged
{
    reason        "Choupo own estimate, NOT a measurement; Wilke-Chang overestimates D by ~15-20% for fused-ring steroids";
    route         "Nghiem, Schafer & Elimelech, Environ. Sci. Technol. 38 (2004) 1888-1896; Comerton, Andrews, Bagley & Yang, J. Membr. Sci. 303 (2007) 267 (measured Stokes radii / hindered-transport D; PAYWALLED at curation)";
    action        "PHASE-6 SEARCH (2026-07-24) found no open measured primary. METHOD WARNING,
                  sharpened in phase 6: the two phase-2 'routes' are now resolved - Nghiem, L.
                  D.; Schafer, A. I.; Elimelech, M., 'Removal of Natural Hormones by
                  Nanofiltration Membranes: Measurement, Modeling, and Mechanisms', Environ.
                  Sci. Technol. 38 (2004) 1888-1896, doi 10.1021/es034952r, and Comerton, A.
                  M.; Andrews, R. C.; Bagley, D. M.; Yang, P., 'Membrane adsorption of
                  endocrine disrupting compounds and pharmaceutically active compounds', J.
                  Membr. Sci. 303 (2007) 267-277, doi 10.1016/j.memsci.2007.07.025.  BOTH are
                  membrane-rejection studies whose solute D_aq / Stokes radii are themselves
                  Wilke-Chang or Stokes-Einstein ESTIMATES.  Transcribing them would LAUNDER
                  an estimate into a 'measurement' and must not be done.  The deliverable is a
                  DIRECT determination of D_aq for the pure solute in water at 298 K - Taylor
                  dispersion, diaphragm cell, Gouy/Rayleigh interferometry or PFG-NMR (DOSY) -
                  published as a physical-chemistry measurement, not inferred from a membrane
                  flux.  Until such a paper is in hand the record stays an own-estimate.";
}

provenance
{
    origin        estimated;
    citation      "Choupo own Wilke-Chang estimate (glass-box); measured NF-transport primary PAYWALLED";
    doi           "-";
    licence       "facts, primary-cited";
    evidenceId    -;
    curator       "agent:diffusion";
    retrieved     2026-07-24;
}

status          flagged;
