recordType      diffusionCoefficient;
schemaVersion   1;
recordId        diffusion-galactose-water;
participants    ( galactose water );
property        aqueousDiffusionCoefficient;

conditions
{
    temperature   298.15 K;
    phase         aqueous;
    composition   infiniteDilution;
}

value
{
    D             6.8e-10 m2/s;
}

validity
{
    temperatureRange   ( 298.15 298.15 ) K;   // single-point datum
    concentration      infiniteDilution;
}

// how THIS value was obtained (glass-box; inputs stated in full)
derivation
{
    method                 "chemical-analogue surrogate (C4 epimer of glucose)";
    anchorValue            6.79e-10 m2/s;
    anchorSubstance        glucose;
    origin                 estimated;
}

// a Stokes radius computed FROM the D above is NOT an independent datum
derived
{
    equation      "r = kT/(6 pi mu D)";
    viscosity     0.8903e-3 Pa.s;
    temperature   298.15 K;
    radius        0.36 nm;   // PROVISIONAL: recompute if D is replaced
    origin        derived;
}

flagged
{
    reason        "the exact 298.15 K digit was NOT transcribable from the paywalled primary table";
    route         "Mogi, Sugai, Fuse & Funazukuri, J. Chem. Eng. Data 52 (2007) 40-43 (measured the full T-series; transcribe the 298.15 K digit)";
    action        "PHASE 6 TRIED HARDEST HERE AND STILL FAILED - the record is an analogue
                  surrogate (the glucose C4 epimer) and must not be promoted while it is.
                  What was checked on 2026-07-24: (a) Mogi, N.; Sugai, E.; Fuse, Y.;
