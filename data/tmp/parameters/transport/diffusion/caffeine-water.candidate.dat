/*----------------------------*- Choupo (CANDIDATE) -*----------------------*\
  STAGING RECORD - PRIVATE tier (data/tmp, gitignored).  Envelope per
  data/tmp/RECORD_SPEC.md.  The runtime does NOT read this file yet.

  ARITY 2: an aqueous diffusion coefficient is a SOLUTE-SOLVENT
  (system) property, not an intrinsic pure-compound datum -> it lives under
  parameters/, never inside components/<name>.candidate.dat.

  CREATED 2026-07-24 (phase 6).  Phase 2 deliberately emitted NO caffeine
  record because the only thing the staging tree held was a *range*
  ("literature order-of-magnitude ~0.6-0.7e-9 m2/s") and a range is not a
  value.  This record exists because a MEASURED primary was located and read:
  the limiting mutual diffusion coefficient of caffeine in water at 25.00 C,
  determined by Taylor dispersion and corroborated by 14C tracer
  diaphragm-cell intradiffusion in a different laboratory.
\*---------------------------------------------------------------------------*/


recordType      diffusionCoefficient;
schemaVersion   1;
recordId        diffusion-caffeine-water;
participants    ( caffeine water );
property        aqueousDiffusionCoefficient;

conditions
{
    temperature   298.15 K;            // the source states 25.00 C
    phase         aqueous;
    composition   infiniteDilution;    // limiting MUTUAL diffusion coefficient D0
}

value
{
    D             0.769e-9 m2/s;
}

validity
{
    temperatureRange   ( 293.15 338.15 ) K;   // source measured 20-65 C by Taylor dispersion
    concentration      infiniteDilution;
}

// how THIS value was obtained (glass-box; inputs stated in full)
derivation
{
    method                 "transcribed from the primary - no derivation, no correlation, no rounding";
    quantity               "limiting mutual diffusion coefficient D0 (Taylor dispersion)";
    origin                 measured;
}

// what the primary actually reports, so the digit can be audited without the paper
sourceReport
{
    recommendedValue       0.769e-9 m2/s;
    recommendedValueNote   "stated in the Results text as 'the limiting mutual diffusion
                            coefficient, 0.769 x 10-9 m2 s-1', and carried as the fixed
                            constant a0 of the D_I(m, 25 C) polynomial in the paper's Table 4";
    replicateDeterminations "Table 3 lists two independent Taylor-dispersion runs at 25.00 C,
                            0.78 x 10-9 and 0.76 x 10-9 m2 s-1 (the final subscript digit of
                            each is illegible in the scanned open copy and is NOT reproduced
                            here); they bracket the recommended 0.769e-9";
    independentTechnique   "14C-labelled caffeine intradiffusion, diaphragm cell: the lowest
                            concentration measured at 25 C (0.001 mol/kg) gave
                            D_I = 0.774 x 10-9 m2 s-1, which the authors describe as in
                            excellent agreement with the limiting mutual value";
    supersededLiterature   "the paper quotes two earlier limiting mutual determinations that
                            it judges too low - Bichsel at 21.5 C, 0.53 x 10-9 m2 s-1, and
                            McCabe at 25 C, 0.68 x 10-9 m2 s-1 - and prefers its own on the
                            grounds that two independent methods in two laboratories agree.
                            The percentage deviations printed in that sentence are garbled in
                            the scanned copy and are deliberately NOT reproduced.";
}

// a Stokes radius computed FROM the D above is NOT an independent datum
derived
{
    equation      "r = kT/(6 pi mu D)";
    viscosity     0.8903e-3 Pa.s;      // pure water, 298.15 K
    temperature   298.15 K;
    radius        0.319 nm;
    origin        derived;
}

// what this record replaced (auditability: never a silent creation)
supersedes
{
    previousState "NO record - components/caffeine.candidate.dat carried only the prose
                   range '~0.6-0.7e-9 m2/s' and phase 2 refused to emit a midpoint";
    previousRoute "Niesner & Heintz, J. Chem. Eng. Data 45 (2000) 1121, doi 10.1021/je0000569
                   ('Diffusion Coefficients of Aromatics in Aqueous Solution') was the route
                   named in the phase-2 ledger; it was never transcribed and remains closed
                   access (Unpaywall is_oa = false, checked 2026-07-24).  The route taken
                   instead is the primary cited below.";
    note          "the located measurement, 0.769e-9, lies ABOVE the range the staging tree
                   had been carrying - had the midpoint 0.65e-9 been invented in phase 2 it
                   would have been ~15 % low";
}

sourceAccess
{
    openCopy      "author/institutional deposit at UNSWorks, University of New South Wales,
                   hdl 1959.4/unsworks_34711 (published version of the RSC article)";
    copyLicence   "the repository stamps the deposited PDF CC BY-NC-ND 4.0";
    useMade       "FACT EXTRACTION ONLY - a measured number and its conditions.  No text,
                   table layout or figure was copied.  The value is attributed to the primary
                   journal article, not to the repository.  Recorded here because
                   CLAUDE.md excludes NonCommercial *databases/compilations* as sources; this
                   is a primary research report, which is a different thing, and the curator
                   who promotes this record should confirm they agree.";
}

provenance
{
    origin        measured;
    citation      "Price, W. E.; Trickett, K. A.; Harris, K. R., 'Association of Caffeine in
                   Aqueous Solution. Effects on Caffeine Intradiffusion', J. Chem. Soc.,
                   Faraday Trans. 1 85 (1989) 3281-3288";
    doi           "10.1039/f19898503281";
    licence       "facts, primary-cited";
    evidenceId    -;
    curator       "agent:diffusion-phase6";
    retrieved     2026-07-24;
}

status          candidate;
