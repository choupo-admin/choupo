recordType      diffusionCoefficient;
schemaVersion   1;
recordId        diffusion-xylitol-water;
participants    ( xylitol water );
property        aqueousDiffusionCoefficient;

conditions
{
    temperature   298.15 K;
    phase         aqueous;
    composition   infiniteDilution;
}

value
{
    D             7.2e-10 m2/s;
}

validity
{
    temperatureRange   ( 298.15 298.15 ) K;   // single-point datum
    concentration      infiniteDilution;
}

// how THIS value was obtained (glass-box; inputs stated in full)
derivation
{
    method                 "Stokes-Einstein D = kT/(6 pi eta r)";
    radius                 0.341 nm;
    radiusOrigin           "equivalent-sphere radius (3 Vm / 4 pi NA)^(1/3) from the SOLID molar volume M/rho";
    solidMolarVolume       100.1 cm3/mol;
    viscosity              0.890e-3 Pa.s;
    temperature            298.15 K;
    origin                 estimated;
}

flagged
{
    reason        "Choupo own estimate, NOT a measurement; Stokes-Einstein with a hard-sphere radius underestimates D for small solutes by ~20-40%";
    route         "Kimura et al., Bull. Chem. Soc. Jpn. 63 (1990) 533, 'Diffusion of Polar and Nonpolar Molecules in Water and Ethanol' (meso-erythritol, xylitol, mannitol, 278-373 K) - PAYWALLED";
    action        "SHORTEST ROUTE CONFIRMED in phase 6: xylitol IS one of the six solutes of
                  Kimura, Y. et al., 'Diffusion of Polar and Nonpolar Molecules in Water and
                  Ethanol', Bull. Chem. Soc. Jpn. 63 (1990) 533-537, doi 10.1246/bcsj.63.533 -
                  abstract read verbatim 2026-07-24: interdiffusion coefficients in water at
                  concentrations close to infinite dilution, 278-373 K.  Access is Oxford
                  Academic, paywalled; the Unpaywall is_oa = true is stale (it points at the
                  dead journal.csj.jp host). Obtain the article and transcribe the 298 K
                  digit; that single act closes this record and the erythritol one.";
}

