/*---------------------------------------------------------------------------*\
  Choupo STAGING record  --  PRIVATE tier (data/tmp/, gitignored).

  Henry's-law constant of PFOA (perfluorooctanoic acid) in liquid water.

  ARITY 2: an air-water partition coefficient is a SOLUTE-SOLVENT (system)
  property, not an intrinsic pure-compound datum -> it lives under
  parameters/, never inside components/PFOA.candidate.dat.

  Provenance chain: phase 3 (2026-07-24) DELETED this value from the component
  file because no `parameters/henry/` home existed; it was held verbatim in
  data/tmp/components/_CLEANUP_hormones_pfas_volatiles.md, section 2
  ("removed from a component, and NO HOME EXISTS YET").  This record is that
  home.  The value and its citation were MOVED verbatim -- nothing was
  re-derived, rounded or improved.  Do NOT re-add it to the component.
  Envelope: ../../RECORD_SPEC.md.  The runtime does NOT read this file yet.
\*---------------------------------------------------------------------------*/

recordType      henrysLawConstant;
schemaVersion   1;
recordId        henry-PFOA-water;
participants    ( PFOA water );
property        henrysLawConstant;

conditions
{
    temperature   298.15 K;   // ASSUMED, NOT SOURCED.  ATSDR Table 4-2 does not
                  // restate a temperature for this entry.  The 25 C convention
                  // is applied here and flagged; it is the single largest
                  // uncertainty in the record (a Henry constant typically
                  // changes by a factor of ~2 over 20 K).
    pressure      101325 Pa;   // ambient, ASSUMED -- not stated by the source
    phase         aqueous;
    composition   infiniteDilution;
    chemicalForm  neutral;     // the NEUTRAL acid -- see the caveat below
}

// FLAGGED, and not for a legal reason: an air-water partition constant is
// ILL-DEFINED for a perfluoroalkyl acid at any environmental pH.  PFOA's own
// pKa determinations span more than three log units (-0.5 Goss 2007; 1.30
// Kutsuna & Hori 2008; 2.80 Moody & Field 2000 -- all three held in
// chemistry/aqueousSpeciation/PFOA-pKa1.candidate.dat).  Only the NEUTRAL acid
// volatilises; above the pKa the perfluorooctanoate anion dominates and the
// EFFECTIVE air-water partitioning falls by orders of magnitude.  PFOA is also
// an interfacially active surfactant, so it accumulates at the air-water
// interface rather than partitioning through it.  Use this number as the
// neutral-species constant only, never as a stripping descriptor at pH 7.
value
{
    H_pc     0.362 Pa.m3/mol;   // = p_gas / c_aqueous  (concentration basis)
    // no uncertainty is reported by the source
}

validity
{
    temperatureRange   ( 298.15 298.15 ) K;   // single point, at the ASSUMED T
    concentrationRange infiniteDilution;
}

// The engine's Henry family (data/standards/parameters/Henry/<solute>-water.dat)
// is parameterised on the PRESSURE / MOLE-FRACTION basis, H_xp [Pa], via a
// van't Hoff form.  Converting between the bases is exact arithmetic once the
// molar density of the solvent is fixed, so it is shown here rather than hidden:
derived
{
    equation      "H_xp = H_pc * c_water,  c_water = rho_water / M_water";
    rhoWater      997.05 kg/m3;      // at 298.15 K (standard value)
    MWater        0.0180153 kg/mol;
    cWater        55345.7 mol/m3;    // = 997.05 / 0.0180153, Choupo's own arithmetic
    H_xp          2.003e4 Pa;        // = 0.362 x 55345.7
    origin        derived;
    note          "PROVISIONAL: this inherits the ASSUMED 298.15 K above.  It is
                   NOT a second independent datum and must be recomputed, never
                   re-cited, if H_pc or the temperature is replaced.";
}

// NOT DONE, deliberately: no van't Hoff enthalpy (dH_diss) exists for this
// pair in the staged material, so the engine's `model vantHoff;` form CANNOT be
// completed from this record.  Fitting one through a single point would
// manufacture a temperature dependence.  A promotion to the engine family needs
// a second temperature.
declaredGaps
{
    dissolutionEnthalpy   "absent -- no second temperature staged";
    primary               "ATSDR Table 4-2 consolidates primaries but does not
                           name one for this entry; pin it before promotion";
    sourceTemperature     "not restated by the compilation";
}

provenance
{
    origin      measured;
    citation    "ATSDR, Toxicological Profile for Perfluoroalkyls (2021), Table 4-2";
    doi         "-";
    licence     "public domain (US Government, ATSDR/CDC) -- legally clean for the public tier";
    evidenceId  -;
    curator     "agent:henry";
    retrieved   2026-07-24;
}

status          flagged;   // legally clean; flagged on PHYSICS (form/pH,
                           // surfactant) and on the unsourced temperature.
