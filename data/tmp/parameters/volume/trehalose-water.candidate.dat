// An apparent/partial molar volume at infinite dilution is arity 2.

recordType      partialMolarVolume;
schemaVersion   1;
recordId        volume-trehalose-water;
participants    ( trehalose water );
property        apparentMolarVolumeAtInfiniteDilution;

conditions
{
    temperature   298.15 K;            // as carried; the source's T is NOT verified
    pressure      101325 Pa;
    phase         aqueous;
    composition   infiniteDilution;
}

value
{
    V0            207.6 cm3/mol;       // = 2.076e-4 m3/mol
}

provenance
{
    origin      measured;
    citation    "Banipal et al., disaccharide partial-molar-volume studies --
                 CITATION UNRESOLVED: no journal, volume, year or pages was ever
                 recorded for this value in the staging ledgers";
    doi         "-";
    licence     "facts, primary-cited (citation incomplete)";
    evidenceId  -;
    curator     "agent:components-sugars";
    retrieved   2026-07-24;
}

crossCheck      "sucrose V0 = 211.5 cm3/mol; lactose 209.1 -- the three isomeric
                 disaccharides span only 4 cm3/mol, as expected";

hydrationCaution
    "The component declares the ANHYDROUS crystal while the solid in equilibrium
    with water at 25 C is the dihydrate.  The dissolved-solute V0 is independent
    of that choice, but do not pair it with a solid volume without saying which
    solid.";

// PHASE 6 (2026-07-24) -- the author-only citation was RESOLVED bibliographically.
// This is an IDENTIFICATION, not a verification: the paper was not obtained and
// the digit above has NOT been checked against its table.  Status stays flagged.
pendingPrimary
{
    citation      "Banipal, P. K.; Banipal, T. S.; Lark, B. S.; Ahluwalia, J. C.,
                   'Partial molar heat capacities and volumes of some mono-, di- and
                   tri-saccharides in water at 298.15, 308.15 and 318.15 K',
                   J. Chem. Soc., Faraday Trans. 93 (1997) 81-87";
    doi           "10.1039/a604656h";
    howResolved   "Crossref bibliographic search on the only fragment the staging tree
                   carried ('Banipal ... disaccharide partial molar volumes'); it is the
                   single Banipal saccharide-volume paper whose title, scope (mono-, di-
                   and tri-saccharides in WATER, not in a co-solvent) and temperature set
