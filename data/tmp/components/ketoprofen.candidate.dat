/*----------------------------*- Choupo (CANDIDATE) -*----------------------*\
  CANDIDATE component: ketoprofen  (C16H14O3, CAS 22071-15-4)
  NSAID (benzophenone-type); carboxylic acid, anionic at neutral pH.

  PHASE-3 CLEANUP 2026-07-24 -- ARITY 1 ONLY.  Every system / state-dependent
  value that used to live in a comment block here was moved in phase 2 to its
  arity-correct home and is NOT restated here (never in two places); what is
  left below is intrinsic pure-compound data, each numeric carrying UNIT +
  PHASE/state + `origin` + citation.  The comments below are POINTERS only.

  RETENTION RULE for computed descriptors (McGowan V_x / Le Bas Vb): kept here
  only when no phase-2 record already carries the number as a derivation input.

  Private staging tier (data/tmp/, gitignored).  The runtime does not read it.
\*---------------------------------------------------------------------------*/

// ===== IDENTITY (arity 1) =====
name              ketoprofen;
formula           C16H14O3;
CAS               22071-15-4;
InChIKey  DKYWVDODHFEZIM-UHFFFAOYSA-N;   // FIRST BLOCK ONLY (14 chars) as retrieved
MW                254.28;           // g/mol
// role: WITHDRAWN 2026-07-24 (advisor ruling).  The engine's `role` enum conflates
// three independent axes -- intrinsic phase behaviour, what the CASE lets the
// component do, and which equilibrium route is used.  Staged as `nonvolatile`, it here meant
// only "I intend to use this as an aqueous solute" -- a CASE INTENT, not a physical
// claim.  A component may be BOTH volatile and a solute; they are not exclusive.
// The physical evidence is kept structured below; the engine does not read this tree.
phaseBehaviour
{
    roleAsStaged            nonvolatile;      // historical, NOT a physical assertion
    volatilityEvidence      "none in this file";
    contradictsStagedRole   no;
    note "restate as: intrinsic phase evidence | case phase declaration | equilibrium route (Raoult|EOS|Henry|chemical|excluded)";
}
intendedCaseUse             aqueousSolute;   // declaration of INTENT


identityProvenance
{
    origin      derived;    // MW computed from the formula with standard atomic weights
    citation    "PubChem CID 3825 (US NIH, public domain), PUG-REST retrieval";
    doi         "-";
    licence     "public domain (US Government)";
    evidenceId  -;
    curator     "agent:pharma-cleanup";
    retrieved   2026-07-24;
}

// NOTE ON IDENTITY: CAS 22071-15-4 is the RACEMATE.  Any melting point, crystal
// density or thermochemistry added later must state the stereochemical form.

// ===== INTRINSIC SOLID-STATE DATA =====
meltingPointStatus
{
    present     no;
    reason      "no melting point was curated at staging; none is invented here.  A value must arrive with the phase transition (solid -> liquid), the pressure, the stereochemical form and an open primary.";
    status      flagged;
}

solidStateStatus
{
    crystalDensity  none;
    reason          "no crystal density curated (X-ray unit-cell density would be the primary).  Without rho_c the pure-component molar volume V_m = MW/rho_c is not derivable, so none is declared.  The V_x below is a COMPUTED descriptor, not V_m.";
    status          flagged;
}

thermochemistryStatus
{
    present     no;
    reason      "no open, phase-declared solid dHf / S298 / Cp located (combustion / DSC calorimetry paywalled).  Routing a nonvolatile solid through the ideal-gas rung is forbidden by contract.";
    status      flagged;
}

// ===== COMPUTED MOLECULAR DESCRIPTORS (arity 1, NOT measurements) =====
descriptors
{
    mcGowanVolume
    {
        value       197.8 cm3/mol;
        state       molecularDescriptor;   // additive; not a phase property, not V_m
        origin      estimated;
        method      "McGowan characteristic volume V_x: additive atomic contributions minus 6.56 cm3/mol per bond; computed by Choupo for C16H14O3, 2 rings";
        citation    "Abraham, M.H. & McGowan, J.C., Chromatographia 23 (1987) 243";
        doi         "-";
        licence     "facts, primary-cited";
        curator     "agent:pharma-cleanup";
        retrieved   2026-07-24;
        status      flagged;   // Choupo's own estimate; never a measured molar volume
        note        "retained here because no phase-2 record carries it: recordId diffusion-ketoprofen-water is a MEASURED D and needs no volume input.";
    }
}

// ===== COSMO =====
cosmoStatus
{
    namedSet       none;
    evidence       "evidence/lvpp-ketoprofen/metadata.dat  (recordId lvpp-ketoprofen)";
    evidenceModel  "COSMO, NWChem B3LYP def2-SVPD, SES cavity, LVPP release v25";
    deployable     no;
    reason         "LVPP's QM protocol is incompatible with Choupo's VT-2005 sigma profiles used by the cosmoSAC2002 variant: on the ethylene cross-check the LVPP cavity is +6.1 % in area and +10.3 % in volume vs VT-2005.  Mixing a profile with another variant's constants is a LOUD error by contract.";
    status         flagged;
}

// ===== PC-SAFT =====
pcSaftStatus
{
    parameterSet   none;    // POINTER ONLY -- no digits are transcribed here
    pinnedSource   "Ferreira et al., J. Supercrit. Fluids (2022), ketoprofen in scCO2";
    numbersInHand  no;
    reason         "the pinned source is paywalled; systematic extraction of a parameter table carries EU sui generis database-right risk, so the digits are NEVER transcribed into this tier.  Full status: parameters/PCSAFT/_INVENTORY.md.  A set would additionally have to carry variant, units, association scheme, combining rules, objective function and data range before it is transportable.";
    status          flagged;         // STRUCTURED ABSENCE -- no number is carried
    blockedBy       "the pinned parameter source is a paywalled article and no row was
                     ever transcribed";
    action          "read ONE compound's row at the pinned source and stage it with its
                     own citation PLUS variant, units, association scheme, combining
                     rules, objective function and data range; never the whole table";
    legalNote2      "reclassified rightsPending -> flagged 2026-07-24 (rights-clearance
                     pass): rightsPending means a VALUE is held that cannot be shipped.
                     No value is held here, so this is a declared GAP, not a legal
                     blocker on any number.";
}

