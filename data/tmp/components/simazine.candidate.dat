/*----------------------------*- Choupo (CANDIDATE) -*----------------------*\
  CANDIDATE component: simazine  (C7H12ClN5, CAS 122-34-9)
  PRIVATE staging tier (data/tmp/, gitignored).  The runtime does NOT read it.

  ARITY-1 ONLY (phase 3, 2026-07-24).  Intrinsic pure-compound data only:
  identity, role, dissociation, crystal density and the pure-solid molar volume
  derived from it.  pKa, logKow and aqueous solubility are SYSTEM / equilibrium
  properties and have been MOVED; pointers below.  Envelope: ../RECORD_SPEC.md.
\*---------------------------------------------------------------------------*/

name           simazine;
formula        C7H12ClN5;
CAS            122-34-9;
InChIKey       ODCWYMIRDDJXKW-UHFFFAOYSA-N;
pubchemCID     5216;
MW             201.66;            // g/mol
// role: WITHDRAWN 2026-07-24 (advisor ruling).  The engine's `role` enum conflates
// three independent axes -- intrinsic phase behaviour, what the CASE lets the
// component do, and which equilibrium route is used.  Staged as `nonvolatile`, it here meant
// only "I intend to use this as an aqueous solute" -- a CASE INTENT, not a physical
// claim.  A component may be BOTH volatile and a solute; they are not exclusive.
// The physical evidence is kept structured below; the engine does not read this tree.
phaseBehaviour
{
    roleAsStaged            nonvolatile;      // historical, NOT a physical assertion
    volatilityEvidence      "none in this file";
    contradictsStagedRole   no;
    note "restate as: intrinsic phase evidence | case phase declaration | equilibrium route (Raoult|EOS|Henry|chemical|excluded)";
}
intendedCaseUse             aqueousSolute;   // declaration of INTENT

dissociation   1;                 // effectively neutral at ambient pH -- justified by the pKa record referenced below

identityProvenance
{
    source      "PubChem CID 5216 (US NIH, public domain), PUG-REST";
    licence     "public-domain fact";
    curator     "agent:components";
    retrieved   2026-07-24;
    status      candidate;
}

standardThermochemistry
{
    available    none;             // EXPLICIT ABSENCE -- do not fabricate
    phase        solid;
    status       flagged;
    blockedBy    "no clean primary solid dHf / S / Cp located";
    action       "fill from a primary before any simazine energy balance";
}

// Pure-component (arity-1) volumetrics of the CRYSTAL.  NOT a partial molar
// volume in water and NOT the Le Bas volume used in Wilke-Chang.
solidDensity
{
    phase         solid;
    value         1302.0;             // kg/m3 (1.302 g/cm3)
    temperature   293.15;             // K (20 C)

    provenance
    {
        unit        "kg/m3";
        phase       solid;
        origin      measured;
        citation    "NTP Chemical Repository Database (1992); surfaced via PubChem";
        licence     "US government work, facts primary-cited";
        status      candidate;
    }
}

solidMolarVolume
{
    phase         solid;
    value         1.5489e-4;          // m3/mol (154.89 cm3/mol)
    temperature   293.15;             // K

    derivation
    {
        equation   "V = MW / rho";
        MW         201.66;            // g/mol
        rho        1.302;             // g/cm3, from solidDensity above
        origin     derived;
    }
    status        candidate;
}

groups
{
    joback  none;
    reason  "chloro-triazine ring has no first-order Joback group; nonvolatile trace solute, no VLE estimate wanted";
    status  flagged;
}

cosmo
{
    VT2005
    {
        variant       cosmoSAC2002;
        available     none;           // no VT-2005 entry for simazine
        status        flagged;
    }
    LVPP_B3LYP_def2SVPD
    {
        variant       lvppB3LYP_def2SVPD;
        available     none;           // LVPP ships no COSMO output for simazine
        source        "LVPP sigma database (github lvpp/sigma, MIT)";
        status        flagged;
    }
    reason        "no deployable set exists.  Even where LVPP data exist its QM protocol is incompatible with Choupo's VT-2005 cosmoSAC2002 constants (ethylene cross-check: +6.1 % cavity area, +10.3 % cavity volume) -- never tag an LVPP profile as cosmoSAC2002.";
}

pcSaft
{
    available     none;
    status        flagged;
    reason        "no pure-component parameter set located from an open primary; not fabricated.";
}

// --- MOVED OUT (arity >= 2 / state-dependent) -- POINTERS ONLY, no values ---
references
{
    acidDissociation    "chemistry/aqueousSpeciation/simazine-pKa1.candidate.dat (recordId simazine-pKa1)";
    chargeAtPH7         "DELETED as DERIVED -- the negligible protonation at pH 7 follows from that pKa, never stored";
    partitionOctanolWater "parameters/partition/simazine-octanol-water.candidate.dat (recordId simazine-octanol-water)";
    aqueousSolubility   "parameters/solubility/simazine-water.candidate.dat (recordId simazine-water)";
    stokesRadius        "NO RECORD -- the candidate primaries (Kiso et al., J. Membr. Sci. 358 (2010) 101-113; Van der Bruggen et al., J. Membr. Sci. 193 (2001) 51-63) were paywalled at curation";
    aqueousDiffusion    "NO RECORD -- would follow by Stokes-Einstein from the missing radius, or from the same NF-table primaries";
    cosmoSurface        "no evidence record -- LVPP ships no COSMO output for simazine";
}

applicationNote "the middle member of the atrazine / simazine / diuron NF benchmark set: same chloro-triazine core as atrazine with shorter side chains, and reported slightly less retained in the same studies.  The comparison is qualitative here -- no rejection number is stored on a component.";
