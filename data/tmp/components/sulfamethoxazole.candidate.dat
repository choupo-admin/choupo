/*----------------------------*- Choupo (CANDIDATE) -*----------------------*\
  CANDIDATE component: sulfamethoxazole  (C10H11N3O3S, CAS 723-46-6)
  Sulfonamide antibiotic; amphoteric; NF/RO trace-organic rejection benchmark.

  PHASE-3 CLEANUP 2026-07-24 -- ARITY 1 ONLY.  Every system / state-dependent
  value that used to live in a comment block here was moved in phase 2 to its
  arity-correct home and is NOT restated here (never in two places); what is
  left below is intrinsic pure-compound data, each numeric carrying UNIT +
  PHASE/state + `origin` + citation.  The comments below are POINTERS only.

  RETENTION RULE for computed descriptors (McGowan V_x / Le Bas Vb): kept here
  only when no phase-2 record already carries the number as a derivation input.
  The Le Bas Vb is NOT kept here -- it is the derivation input of recordId
  diffusion-sulfamethoxazole-water.

  Private staging tier (data/tmp/, gitignored).  The runtime does not read it.
\*---------------------------------------------------------------------------*/

// ===== IDENTITY (arity 1) =====
name              sulfamethoxazole;
formula           C10H11N3O3S;
CAS               723-46-6;
InChIKey  JLKIGFTWXXRPMT-UHFFFAOYSA-N;   // FIRST BLOCK ONLY (14 chars) as retrieved
MW                253.28;           // g/mol
// role: WITHDRAWN 2026-07-24 (advisor ruling).  The engine's `role` enum conflates
// three independent axes -- intrinsic phase behaviour, what the CASE lets the
// component do, and which equilibrium route is used.  Staged as `nonvolatile`, it here meant
// only "I intend to use this as an aqueous solute" -- a CASE INTENT, not a physical
// claim.  A component may be BOTH volatile and a solute; they are not exclusive.
// The physical evidence is kept structured below; the engine does not read this tree.
phaseBehaviour
{
    roleAsStaged            nonvolatile;      // historical, NOT a physical assertion
    volatilityEvidence      "none in this file";
    contradictsStagedRole   no;
    note "restate as: intrinsic phase evidence | case phase declaration | equilibrium route (Raoult|EOS|Henry|chemical|excluded)";
}
intendedCaseUse             aqueousSolute;   // declaration of INTENT


identityProvenance
{
    origin      derived;    // MW computed from the formula with standard atomic weights
    citation    "PubChem CID 5329 (US NIH, public domain), PUG-REST retrieval";
    doi         "-";
    licence     "public domain (US Government)";
    evidenceId  -;
    curator     "agent:pharma-cleanup";
    retrieved   2026-07-24;
}

// ===== INTRINSIC SOLID-STATE DATA =====
meltingPoint
{
    value              440.15 K;          // = 167 C
    originalStatement  "167 C";           // verbatim, before the K conversion (Choupo's own arithmetic)
    transition         "solid -> liquid";
    phaseBefore        solid;
    phaseAfter         liquid;
    polymorph          unspecified;       // NOT stated by the source
    pressure           101325 Pa;         // ambient, ASSUMED -- not stated by the source
    origin             measured;
    citation           "HSDB (US NLM, public domain), PubChem CID 5329; HMDB concurs at 167 C";
    doi                "-";
    licence            "public domain (US Government) / facts, primary-cited";
    curator            "agent:pharma-cleanup";
    retrieved          2026-07-24;
    status             flagged;   // compilation source; the measuring primary behind HSDB is not pinned
}

solidStateStatus
{
    crystalDensity  none;
    reason          "no crystal density curated (an X-ray unit-cell density, per polymorph, would be the primary).  Without rho_c the PURE-component molar volume V_m = MW/rho_c is NOT derivable, so none is declared.  The Le Bas Vb that used to sit in this file is a COMPUTED descriptor and was never V_m.";
    status          flagged;
}

thermochemistryStatus
{
    present     no;
    reason      "no open, phase-declared solid dHf / S298 / Cp located (combustion / DSC calorimetry paywalled or unavailable).  Routing a nonvolatile solid through the ideal-gas rung is forbidden by contract.";
    status      flagged;
}

// ===== MOLECULAR GEOMETRY (arity 1) =====
descriptors
{
    molecularDimensions
    {
        width       0.526 nm;
        height      0.587 nm;
        length      1.031 nm;
        state       molecularDescriptor;   // single-molecule geometry, not a phase property
        origin      estimated;             // molecular-geometry computation, as published
        method      "molecular dimensions (W x H x L) as reported by the primary; the underlying geometry-optimisation protocol is NOT restated in the source's abstract and is not reproduced here";
        citation    "Bizi, M. & El Bachra, F.E., Molecules 26 (2021) 7318 (open access)";
        doi         "10.3390/molecules26237318";
        licence     "CC-BY (open access)";
        curator     "agent:pharma-cleanup";
        retrieved   2026-07-24;
        status      flagged;   // computed geometry; method not fully documented in-source
        note        "retained here because no phase-2 record carries these dimensions; they are the only steric descriptor of this solute in the staging tier.";
    }

    // Le Bas Vb is NOT declared here: it is already recorded, with its method
    // reference, as the derivation input of recordId
    // diffusion-sulfamethoxazole-water (parameters/transport/diffusion/).
}

// ===== COSMO =====
cosmoStatus
{
    namedSet       none;
    evidence       -;      // no LVPP entry: no evidence/lvpp-sulfamethoxazole/ directory exists
    deployable     no;
    reason         "no open sigma profile located: not in the VT-2005 77-compound set, and the InChIKey-skeleton join against LVPP release v25 found no match.  The VT pharmaceutical set (Mullins, IECR 46 (2007) ie0711022) is paywalled; a CHAOS (CC-BY) join is PENDING.  Even were an LVPP profile found, LVPP's QM protocol is incompatible with Choupo's VT-2005 cosmoSAC2002 constants (ethylene cross-check: +6.1 % cavity area, +10.3 % volume).";
    status         flagged;
}

// ===== PC-SAFT =====
pcSaftStatus
{
    parameterSet   none;
    pinnedSource   "-";
    numbersInHand  no;
    reason         "no published open parameter set identified.  See parameters/PCSAFT/_INVENTORY.md.";
    status         flagged;
}

// ===== POINTERS -- values MOVED OUT in phase 2 (home + recordId; no values here) =====
// pKa1 (aniline -NH3+)   -> chemistry/aqueousSpeciation/  recordId sulfamethoxazole-pKa1
// pKa2 (sulfonamide N-H) -> chemistry/aqueousSpeciation/  recordId sulfamethoxazole-pKa2
// chargeAtPH7            -> DELETED (derived from the two equilibria above; never stored)
// logKow (NEUTRAL form)  -> parameters/partition/         recordId sulfamethoxazole-octanol-water
// logD at pH 8 (ANION)   -> parameters/partition/         recordId sulfamethoxazole-octanol-water-pH8
// aqueous solubility     -> parameters/solubility/        recordId sulfamethoxazole-water
// D_aq (ESTIMATE), its   -> parameters/transport/diffusion/  recordId diffusion-sulfamethoxazole-water
//   Le Bas Vb input and the Stokes radius derived from it (same record)

// DEFECT FIXED 2026-07-24: this component used to list logKow (neutral species)
// and logD at pH 8 (the anion) side by side under one "hydrophobicity" heading,
// as if they were two readings of one quantity.  They are DIFFERENT quantities
// on different species; they are now two separate partition records and this
// file keeps NEITHER, only the two pointers above.

status            candidate;   // applies to the identity block; every property
                               // block above carries its own status
