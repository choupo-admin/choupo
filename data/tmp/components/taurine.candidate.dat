/*----------------------------*- Choupo (CANDIDATE) -*----------------------*\
  CANDIDATE component: taurine  (2-aminoethanesulfonic acid, C2H7NO3S, CAS 107-35-7)
  PRIVATE staging tier (data/tmp/, gitignored).  The runtime does NOT read it.

  ARITY-1 ONLY (phase 3, 2026-07-24).  Intrinsic pure-compound data only; every
  system / state property has been MOVED to its arity-correct home and is
  referenced by POINTER below.  Envelope: ../RECORD_SPEC.md.

  DEFECT FIXED here: the sulfonate pKa1 and the pI were ESTIMATES, not
  measurements, and the file additionally contradicted itself (header "sulfonate
  pKa<0, amine pKa~9.0" vs body "pKa1 ~1.5, pKa2 ~9.06, pI ~5.2").  Nothing of
  that kind is presented here as a datum any more: all of it is deleted from the
  component and lives -- flagged as an ESTIMATE -- in chemistry/aqueousSpeciation/.
\*---------------------------------------------------------------------------*/

name           taurine;
formula        C2H7NO3S;
CAS            107-35-7;
InChIKey       XOAAWQZATWQOTB-UHFFFAOYSA-N;
pubchemCID     1123;
MW             125.15;            // g/mol
// role: WITHDRAWN 2026-07-24 (advisor ruling).  The engine's `role` enum conflates
// three independent axes -- intrinsic phase behaviour, what the CASE lets the
// component do, and which equilibrium route is used.  Staged as `nonvolatile`, it here meant
// only "I intend to use this as an aqueous solute" -- a CASE INTENT, not a physical
// claim.  A component may be BOTH volatile and a solute; they are not exclusive.
// The physical evidence is kept structured below; the engine does not read this tree.
phaseBehaviour
{
    roleAsStaged            nonvolatile;      // historical, NOT a physical assertion
    volatilityEvidence      "none in this file";
    contradictsStagedRole   no;
    note "restate as: intrinsic phase evidence | case phase declaration | equilibrium route (Raoult|EOS|Henry|chemical|excluded)";
}
intendedCaseUse             aqueousSolute;   // declaration of INTENT


identityProvenance
{
    source      "PubChem CID 1123 (US NIH, public domain), PUG-REST";
    licence     "public-domain fact";
    curator     "agent:components";
    retrieved   2026-07-24;
    status      candidate;
}

standardThermochemistry
{
    phase            solid;            // crystalline zwitterion
    referenceState   pureSolid;
    dHf_298          -774500.0;        // J/mol
    s_298            154.0;            // J/(mol K)

    provenance
    {
        dHf_298
        {
            unit        "J/mol";
            phase       solid;
            origin      measured;
            citation    "Yang, Pilcher & Macnab, J. Chem. Thermodyn. 26 (1994) 787 (combustion -1614.9 kJ/mol; reported -774.5 +/- 0.9)";
            route       "located through the NIST WebBook condensed-phase free view (ID=C91105792, Mask=2), used only as a finding aid -- a no-grant compilation, the value is re-cited to the primary";
            licence     "facts, primary-cited";
            status      candidate;
        }
        s_298
        {
            unit        "J/(mol K)";
            phase       solid;
            origin      measured;
            citation    "Huffman & Fox, J. Am. Chem. Soc. 62 (1940) 3464";
            licence     "facts, primary-cited";
            status      flagged;
            flagReason  "the compiler (NIST) flags this S(298) as resting on a LOW-TEMPERATURE EXTRAPOLATION of the 1940 calorimetry, not on a measurement down to 0 K";
        }
    }
}

solidHeatCapacity
{
    phase         solid;
    model         polynomial;         // constant-Cp near ambient
    coefficients  ( 140.54 );         // Cp J/(mol K)
    Trange        ( 280 320 );        // K

    provenance
    {
        unit        "J/(mol K)";
        phase       solid;
        origin      measured;
        citation    "Huffman & Fox, J. Am. Chem. Soc. 62 (1940) 3464";
        measuredAt  "300.3 K -- an UNSMOOTHED single datum, used near-ambient as a constant Cp; it is not a 298.15 K smoothed value";
        licence     "facts, primary-cited";
        status      flagged;
    }
}

groups
{
    joback  none;
    reason  "no first-order Joback group exists for the sulfonic acid; nonvolatile solute, no VLE estimate wanted";
    status  flagged;
}

cosmo
{
    LVPP_B3LYP_def2SVPD
    {
        variant       lvppB3LYP_def2SVPD;
        available     none;            // LVPP ships no COSMO output for taurine
        source        "LVPP sigma database (github lvpp/sigma, MIT)";
        status        flagged;
    }
    VT2005
    {
        variant       cosmoSAC2002;
        available     none;
        status        flagged;
    }
    reason        "no deployable set exists.  The LVPP QM protocol is in any case incompatible with Choupo's VT-2005 cosmoSAC2002 constants (ethylene cross-check: +6.1 % cavity area, +10.3 % cavity volume).";
    modellingNote "a permanently charged sulfonate is not representable by a single neutral-molecule COSMO profile -- an electrolyte speciation model is the physically right route";
}

pcSaft
{
    CamerettiSadowski2008
    {
        variant       pcSaftAssociating5Param;
        available     none;
        citation      "Cameretti & Sadowski, Chem. Eng. Process. 47 (2008) 1018 (neutral zwitterion); Held/Do ePC-SAFT for the charged form";
        status        flagged;         // STRUCTURED ABSENCE -- no number is carried
        blockedBy     "Cameretti & Sadowski (2008) is a paywalled article; the parameter
                       row was never transcribed";
        action        "read the amino-acid row of that paper (or Held & Sadowski's
                       ePC-SAFT work for the charged form) and stage m, sigma, eps/k,
                       N_assoc, eps_assoc/k, kappa_assoc TOGETHER WITH the association
                       scheme, combining rules, objective function and data range --
                       five numbers without a protocol are not a parameter set.  Take
                       ONE compound's row with its own citation, never the table.";
        legalNote     "reading one row of a primary research paper and citing it is
                       normal scholarship; systematic extraction of the whole table is
                       the EU sui-generis database-right risk.  Because NO number is
                       held here, this block is a declared GAP, not a rights-pending
                       value -- reclassified rightsPending -> flagged 2026-07-24.";
    }
}

