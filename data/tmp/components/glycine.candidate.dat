/*----------------------------*- Choupo (CANDIDATE) -*----------------------*\
  CANDIDATE component: glycine  (C2H5NO2, CAS 56-40-6)
  PRIVATE staging tier (data/tmp/, gitignored).  The runtime does NOT read it.

  ARITY-1 ONLY (phase 3, 2026-07-24).  This file now carries INTRINSIC
  pure-compound data only.  Every system / state property (D_aq, Stokes radius,
  pKa, pI, charge(pH), partial molar volume in water, COSMO surface) has been
  MOVED to its arity-correct home; what remains below is a POINTER -- a
  cross-reference, never a second copy of a value.  Envelope: ../RECORD_SPEC.md.
\*---------------------------------------------------------------------------*/

name           glycine;
formula        C2H5NO2;
CAS            56-40-6;
InChIKey       DHMQDGOQFOQNFH-UHFFFAOYSA-N;
pubchemCID     750;
MW             75.07;             // g/mol
// role: WITHDRAWN 2026-07-24 (advisor ruling).  The engine's `role` enum conflates
// three independent axes -- intrinsic phase behaviour, what the CASE lets the
// component do, and which equilibrium route is used.  Staged as `nonvolatile`, it here meant
// only "I intend to use this as an aqueous solute" -- a CASE INTENT, not a physical
// claim.  A component may be BOTH volatile and a solute; they are not exclusive.
// The physical evidence is kept structured below; the engine does not read this tree.
phaseBehaviour
{
    roleAsStaged            nonvolatile;      // historical, NOT a physical assertion
    volatilityEvidence      "none in this file";
    contradictsStagedRole   no;
    note "restate as: intrinsic phase evidence | case phase declaration | equilibrium route (Raoult|EOS|Henry|chemical|excluded)";
}
intendedCaseUse             aqueousSolute;   // declaration of INTENT


identityProvenance
{
    source      "PubChem CID 750 (US NIH, public domain), PUG-REST";
    licence     "public-domain fact";
    curator     "agent:components";
    retrieved   2026-07-24;
    status      candidate;
}

// Crystalline (zwitterionic) solid rung -- glycine decomposes before it boils,
// so the pureSolid reference is the only physical one.
standardThermochemistry
{
    phase            solid;            // crystalline zwitterion
    referenceState   pureSolid;
    dHf_298          -527500.0;        // J/mol
    s_298            103.51;           // J/(mol K)

    provenance
    {
        dHf_298
        {
            unit        "J/mol";
            phase       solid;
            origin      measured;
            citation    "Vasil'ev, Borodin & Kopnyshev, Russ. J. Phys. Chem. 65 (1991) 29";
            crossCheck  "CODATA-consistent value approx -528.5 kJ/mol (not merged)";
            licence     "facts, primary-cited";
            status      candidate;
        }
        s_298
        {
            unit        "J/(mol K)";
            phase       solid;
            origin      measured;
            citation    "Hutchens, Cole & Stout, J. Am. Chem. Soc. 82 (1960) 4813";
            licence     "facts, primary-cited";
            status      candidate;
        }
    }
}

solidHeatCapacity
{
    phase         solid;
    model         polynomial;         // constant-Cp near ambient
    coefficients  ( 95.0 );           // Cp(298) J/(mol K)
    Trange        ( 280 320 );        // K

    provenance
    {
        unit        "J/(mol K)";
        phase       solid;
        origin      measured;
        citation    "Badelin, Kulikov et al., Thermochim. Acta 169 (1990) 81";
        crossCheck  "Hutchens, Cole & Stout, JACS 82 (1960) 4813 report 99.2 J/(mol K) -- quoted, NOT merged";
        licence     "facts, primary-cited";
        status      candidate;
    }
}

groups
{
    joback ( { group NH2; count 1; } { group CH2; count 1; } { group acid; count 1; } );
    note   "PROPOSED structure record for review -- NOT a VLE estimate (nonvolatile solute)";
    status candidate;
}

// COSMO surface: NAMED SET, not a loose note.  Nothing deployable exists.
cosmo
{
    LVPP_B3LYP_def2SVPD
    {
        variant       lvppB3LYP_def2SVPD;   // NOT cosmoSAC2002 -- no matching runtime constants
        source        "LVPP sigma database (github lvpp/sigma, MIT, DOI 10.5281/zenodo.3613785; Ferrarini et al., AIChE J. 64 (2018) 3443)";
        evidenceId    "evidence/lvpp-glycine/metadata.dat (recordId lvpp-glycine)";
        area          notCopied;      // stays in the evidence record
        volume        notCopied;
        sigmaProfile  notCopied;
        status        flagged;
        reason        "LVPP QM protocol is incompatible with Choupo's VT-2005 cosmoSAC2002 sets; measured on ethylene (present in both): +6.1 % cavity area, +10.3 % cavity volume.  Do NOT tag an LVPP profile as cosmoSAC2002.";
    }
    VT2005
    {
        variant       cosmoSAC2002;
        available     none;           // no VT-2005 entry for this compound
        status        flagged;
    }
    modellingNote "amino acids are COSMO-modelled as the NEUTRAL gas-phase tautomer, never as the aqueous zwitterion";
}

// PC-SAFT: NAMED SET, no numbers transcribed.
pcSaft
{
    CamerettiSadowski2008
    {
        variant       pcSaftAssociating5Param;   // m, sigma, eps/k, N_assoc, eps_assoc/k, kappa_assoc
        available     none;
        citation      "Cameretti & Sadowski, Chem. Eng. Process. 47 (2008) 1018 (neutral zwitterion); Held/Do ePC-SAFT for the charged form";
        status        flagged;         // STRUCTURED ABSENCE -- no number is carried
        blockedBy     "Cameretti & Sadowski (2008) is a paywalled article; the parameter
                       row was never transcribed";
        action        "read the amino-acid row of that paper (or Held & Sadowski's
                       ePC-SAFT work for the charged form) and stage m, sigma, eps/k,
                       N_assoc, eps_assoc/k, kappa_assoc TOGETHER WITH the association
                       scheme, combining rules, objective function and data range --
                       five numbers without a protocol are not a parameter set.  Take
                       ONE compound's row with its own citation, never the table.";
        legalNote     "reading one row of a primary research paper and citing it is
                       normal scholarship; systematic extraction of the whole table is
                       the EU sui-generis database-right risk.  Because NO number is
                       held here, this block is a declared GAP, not a rights-pending
                       value -- reclassified rightsPending -> flagged 2026-07-24.";
    }
}

// --- MOVED OUT (arity >= 2 / state-dependent) -- POINTERS ONLY, no values ---
references
{
    aqueousDiffusion    "parameters/transport/diffusion/glycine-water.candidate.dat (recordId diffusion-glycine-water)";
    stokesRadius        "derived inside that same diffusion record -- never a second datum";
    acidDissociation    "chemistry/aqueousSpeciation/glycine-pKa1|pKa2.candidate.dat (recordId glycine-pKa1, glycine-pKa2)";
    isoelectricPoint    "chemistry/aqueousSpeciation/glycine-pI.candidate.dat (recordId glycine-pI)";
    chargeAtPH7         "DELETED as DERIVED -- it is a result of the pKa equilibria, never stored";
    partialMolarVolume  "aqueous V2 at infinite dilution (Millero, Lo Surdo & Shin, J. Phys. Chem. 82 (1978) 784) -- a SOLUTE+WATER system property; GAP: no arity-2 volumetric record home exists yet, the number survives only in data/tmp/aminoacids_SOURCES.md section 3";
    cosmoSurface        "evidence/lvpp-glycine/metadata.dat (recordId lvpp-glycine)";
}

speciationNote  "ampholyte: the van't Hoff factor is NOT a plain integer -- i = f(pH), set by the referenced dissociation equilibria, not by a component constant";
