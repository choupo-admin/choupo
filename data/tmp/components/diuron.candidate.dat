// Pure-component (arity-1) volumetrics of the CRYSTAL.  NOT a partial molar
// volume in water and NOT the Le Bas volume used in Wilke-Chang.
// RIGHTS CLEARANCE 2026-07-24 -- action: DROP.  The 1.48 g/cm3 crystal density
// reached us ONLY through the e-Pesticide Manual (BCPC), a paywalled commercial
// compilation.  Searched for an open/public-domain route (the atrazine and glyphosate
// ATSDR tables that cleared those two have no diuron counterpart; the EPA Diuron RED,
// which IS public domain, was fetched and its physical-properties entries give the
// melting point and water solubility but NO density).  No number could be legally
// shipped, so the number is DELETED and the gap declared.
solidDensity
{
    phase         solid;
    available     none;               // DROPPED -- nothing invented, nothing kept
    status        flagged;
    blockedBy     "e-Pesticide Manual (BCPC) -- paywalled commercial compilation";
    action        "take the crystal density from a published single-crystal structure of
                   diuron (Acta Cryst. reports Dx directly, and the cell parameters are
                   also in the open Crystallography Open Database), or from a
                   public-domain regulatory dossier that states one WITH a temperature";
    droppedValue  "1.48 g/cm3, temperature not stated (this is recorded so the deletion
                   is auditable, NOT so the number can be re-used)";
}

solidMolarVolume
{
    phase         solid;
    available     none;               // DROPPED -- it was V = MW/rho on the dropped rho
    status        flagged;
    blockedBy     "derived from the dropped solidDensity above";
    action        "recompute as V = MW / rho once a legally clear rho exists";
    droppedValue  "1.5749e-4 m3/mol (157.49 cm3/mol), from MW 233.09 and rho 1.48 g/cm3";
}

