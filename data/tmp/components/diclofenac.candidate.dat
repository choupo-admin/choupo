/*----------------------------*- Choupo (CANDIDATE) -*----------------------*\
  CANDIDATE component: diclofenac  (C14H11Cl2NO2, CAS 15307-86-5)
  NSAID; carboxylic acid, anionic at neutral pH; common NF/RO benchmark.

  PHASE-3 CLEANUP 2026-07-24 -- ARITY 1 ONLY.  Every system / state-dependent
  value that used to live in a comment block here was moved in phase 2 to its
  arity-correct home and is NOT restated here (never in two places); what is
  left below is intrinsic pure-compound data, each numeric carrying UNIT +
  PHASE/state + `origin` + citation.  The comments below are POINTERS only.

  RETENTION RULE for computed descriptors (McGowan V_x / Le Bas Vb): kept here
  only when no phase-2 record already carries the number as a derivation input.
  Diclofenac's V_x is NOT kept here -- it is the stated derivation input of
  recordId diffusion-diclofenac-water.

  Private staging tier (data/tmp/, gitignored).  The runtime does not read it.
\*---------------------------------------------------------------------------*/

// ===== IDENTITY (arity 1) =====
name              diclofenac;
formula           C14H11Cl2NO2;
CAS               15307-86-5;
InChIKey  DCOPUUMXTXDBNB-UHFFFAOYSA-N;   // FIRST BLOCK ONLY (14 chars) as retrieved
MW                296.15;           // g/mol
// role: WITHDRAWN 2026-07-24 (advisor ruling).  The engine's `role` enum conflates
// three independent axes -- intrinsic phase behaviour, what the CASE lets the
// component do, and which equilibrium route is used.  Staged as `nonvolatile`, it here meant
// only "I intend to use this as an aqueous solute" -- a CASE INTENT, not a physical
// claim.  A component may be BOTH volatile and a solute; they are not exclusive.
// The physical evidence is kept structured below; the engine does not read this tree.
phaseBehaviour
{
    roleAsStaged            nonvolatile;      // historical, NOT a physical assertion
    volatilityEvidence      "none in this file";
    contradictsStagedRole   no;
    note "restate as: intrinsic phase evidence | case phase declaration | equilibrium route (Raoult|EOS|Henry|chemical|excluded)";
}
intendedCaseUse             aqueousSolute;   // declaration of INTENT


identityProvenance
{
    origin      derived;    // MW computed from the formula with standard atomic weights
    citation    "PubChem CID 3033 (US NIH, public domain), PUG-REST retrieval";
    doi         "-";
    licence     "public domain (US Government)";
    evidenceId  -;
    curator     "agent:pharma-cleanup";
    retrieved   2026-07-24;
}

// NOTE ON IDENTITY: this record is the FREE ACID (C14H11Cl2NO2).  The sodium
// salt (a different solid, far more soluble) is a different substance and must
// never inherit this file's solid-state data.

// ===== INTRINSIC SOLID-STATE DATA =====
meltingPointStatus
{
    present     no;
    reason      "no melting point was curated at staging; none is invented here.  A value must arrive with the phase transition (solid -> liquid), the pressure, the salt/free-acid form and an open primary.";
    status      flagged;
}

solidStateStatus
{
    crystalDensity  none;
    reason          "no crystal density curated (X-ray unit-cell density would be the primary).  Without rho_c the pure-component molar volume V_m = MW/rho_c is not derivable, so none is declared.";
    status          flagged;
}

thermochemistryStatus
{
    present     no;
    reason      "no open, phase-declared solid dHf / S298 / Cp located (combustion / DSC calorimetry paywalled).  Routing a nonvolatile solid through the ideal-gas rung is forbidden by contract.";
    status      flagged;
}

// ===== COMPUTED MOLECULAR DESCRIPTORS =====
descriptors
{
    // McGowan V_x is NOT declared here: it is already recorded, with its method
    // primary, as the derivation input of recordId diffusion-diclofenac-water
    // (parameters/transport/diffusion/).  One number, one home.
    note   "no arity-1 descriptor is stored in this file; see the pointer above.";
}

// ===== COSMO =====
cosmoStatus
{
    namedSet       none;
    evidence       "evidence/lvpp-diclofenac/metadata.dat  (recordId lvpp-diclofenac)";
    evidenceModel  "COSMO, NWChem B3LYP def2-SVPD, SES cavity, LVPP release v25";
    deployable     no;
    reason         "LVPP's QM protocol is incompatible with Choupo's VT-2005 sigma profiles used by the cosmoSAC2002 variant: on the ethylene cross-check the LVPP cavity is +6.1 % in area and +10.3 % in volume vs VT-2005.  Mixing a profile with another variant's constants is a LOUD error by contract.";
    status         flagged;
}

// ===== PC-SAFT =====
pcSaftStatus
{
    parameterSet   none;
    pinnedSource   "-";
    numbersInHand  no;
    reason         "no published diclofenac parameter set identified.  See parameters/PCSAFT/_INVENTORY.md.";
    status         flagged;
}

// ===== POINTERS -- values MOVED OUT in phase 2 (home + recordId; no values here) =====
// pKa (carboxylic acid)  -> chemistry/aqueousSpeciation/  recordId diclofenac-pKa1
// chargeAtPH7            -> DELETED (derived from the equilibrium above; never stored)
// logKow                 -> parameters/partition/         recordId diclofenac-octanol-water
// aqueous solubility     -> parameters/solubility/        recordId diclofenac-water
// D_aq (ESTIMATE) + the  -> parameters/transport/diffusion/  recordId diffusion-diclofenac-water
//   McGowan V_x it was computed from (that record's `derivation {}` block)
// COSMO cavity           -> evidence/lvpp-diclofenac/metadata.dat  recordId lvpp-diclofenac

// DEFECT CARRIED FORWARD (recorded, not hidden): the estimated D_aq that left
// this file applies WILKE-CHANG to a McGowan V_x.  Wilke-Chang is defined on a
// LE BAS molar volume -- a method mismatch.  It is visible inside recordId
// diffusion-diclofenac-water; this component asserts no D at all.

status            candidate;   // applies to the identity block; every property
                               // block above carries its own status
