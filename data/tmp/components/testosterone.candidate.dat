/*----------------------------*- Choupo (CANDIDATE) -*----------------------*\
  CANDIDATE component: testosterone  (C19H28O2, CAS 58-22-0)
  Androgenic steroid hormone / EDC; neutral 3-keto-Delta4 / 17-OH steroid.
  Part of the studied steroid set for NF/RO trace-organic rejection.

  IDENTITY source: PubChem CID 6013 (US NIH, public domain), retrieved
    2026-07-24 via PUG-REST.  CAS 58-22-0 as listed on that public record.

  SCOPE (phase-3 cleanup, 2026-07-24): ARITY-1 INTRINSIC ONLY.  Every system /
    equilibrium / state datum was re-homed in phase 2 and is NOT duplicated here
    (data/tmp/RECORD_SPEC.md, ARITY rule).  The pointers carry NO numbers.

  STATUS: candidate.  Not promotable -- no thermochemistry, no Cp, no VLE leg.
\*---------------------------------------------------------------------------*/

name              testosterone;
formula           C19H28O2;
CAS               58-22-0;
InChIKey  MUMGGOZAMZWBJJ-DYKIIFRCSA-N;   // 14-char skeleton only (see estradiol note)
MW                288.42;           // g/mol
// role: WITHDRAWN 2026-07-24 (advisor ruling).  The engine's `role` enum conflates
// three independent axes -- intrinsic phase behaviour, what the CASE lets the
// component do, and which equilibrium route is used.  Staged as `nonvolatile`, it here meant
// only "I intend to use this as an aqueous solute" -- a CASE INTENT, not a physical
// claim.  A component may be BOTH volatile and a solute; they are not exclusive.
// The physical evidence is kept structured below; the engine does not read this tree.
phaseBehaviour
{
    roleAsStaged            nonvolatile;      // historical, NOT a physical assertion
    volatilityEvidence      "none in this file";
    contradictsStagedRole   no;
    note "restate as: intrinsic phase evidence | case phase declaration | equilibrium route (Raoult|EOS|Henry|chemical|excluded)";
}
intendedCaseUse             aqueousSolute;   // declaration of INTENT



// ---- RE-HOMED IN PHASE 2 (pointers only, no values) ------------------------
// D_aq + Stokes radius  -> parameters/transport/diffusion/  recordId diffusion-testosterone-water
// logKow                -> parameters/partition/            recordId testosterone-octanol-water
// aqueous solubility    -> parameters/solubility/           recordId testosterone-water
// COSMO cavity (LVPP)   -> evidence/lvpp-testosterone/      recordId lvpp-testosterone
// NO dissociation record exists, deliberately: the source states there is no
//   acidic pKa and the strongest-basic centre lies far outside the 0-14 window
//   (chemistry/aqueousSpeciation/_LEDGER.md section 6a).  That is an ABSENCE
//   statement about an equilibrium, held in the speciation ledger -- not a
//   component field, and not a value.


// ---- ARITY-1 INTRINSIC ------------------------------------------------------

// Tfus is reported as a RANGE, not a single value; it is kept as a range rather
// than collapsed to a midpoint (a midpoint would be an invented number).
TfusRange         ( 426.15 430.15 );  // K (153-157 degC), crystalline solid;
                                      //   POLYMORPH not stated by the source.
                                      //   [HSDB via PubChem CID 6013; US NLM,
                                      //   public domain]  A second compilation
                                      //   (HMDB) quotes a single 155 degC, which
                                      //   sits inside this range -- not merged.


// ---- DECLARED GAPS (absences, never estimates) ------------------------------
// solidDensity           : no crystal density on the public record; absent, NOT
//                          estimated.  The Le Bas additive volume feeding the
//                          Wilke-Chang diffusion estimate lives inside
//                          diffusion-testosterone-water.
// standardThermochemistry: no open combustion / formation datum located.
// Tc / Pc / omega /
// vaporPressure /
// idealGasHeatCapacity   : no VLE leg (fused-ring steroid; Joback not
//                          parametrized for it).
//
// COSMO-SAC -- NO DEPLOYABLE SET; no `cosmo {}` block may be written here.
//   evidence/lvpp-testosterone holds the LVPP cavity descriptors as EVIDENCE
//   only: the LVPP QM protocol is incompatible with Choupo's VT-2005
//   `cosmoSAC2002` sets (ethylene cross-check: +6.1 % area, +10.3 % volume).
//   The LVPP surface is the NEUTRAL GAS-PHASE tautomer, NEVER the aqueous
//   species -- and for a 3-keto-Delta4 steroid it is also one chosen tautomer
//   (keto, not enol) and one chosen conformer.
// PC-SAFT -- no published steroid parameter set
//   (parameters/PCSAFT/_INVENTORY.md, section 3).

provenance
{
    TfusRange
    {
        origin      measured;
        citation    "HSDB via PubChem CID 6013 (US NLM, public domain)";
        note        "reported as a 153-157 degC range; polymorph not stated; HMDB's single 155 degC not merged";
        status      candidate;
    }
}
