name           phenylalanine;
formula        C9H11NO2;
CAS            63-91-2;
InChIKey       COLNVLDHVKWLRT-QMMMGPOBSA-N;
pubchemCID     6140;
MW             165.19;            // g/mol
// role: WITHDRAWN 2026-07-24 (advisor ruling).  The engine's `role` enum conflates
// three independent axes -- intrinsic phase behaviour, what the CASE lets the
// component do, and which equilibrium route is used.  Staged as `nonvolatile`, it here meant
// only "I intend to use this as an aqueous solute" -- a CASE INTENT, not a physical
// claim.  A component may be BOTH volatile and a solute; they are not exclusive.
// The physical evidence is kept structured below; the engine does not read this tree.
phaseBehaviour
{
    roleAsStaged            nonvolatile;      // historical, NOT a physical assertion
    volatilityEvidence      "none in this file";
    contradictsStagedRole   no;
    note "restate as: intrinsic phase evidence | case phase declaration | equilibrium route (Raoult|EOS|Henry|chemical|excluded)";
}
intendedCaseUse             aqueousSolute;   // declaration of INTENT


identityProvenance
{
    source      "PubChem CID 6140 (US NIH, public domain), PUG-REST";
    licence     "public-domain fact";
    curator     "agent:components";
    retrieved   2026-07-24;
    status      candidate;
}

standardThermochemistry
{
    phase            solid;            // crystalline zwitterion
    referenceState   pureSolid;
    dHf_298          -467400.0;        // J/mol -- DERIVED, see derivation{} below
    s_298            213.64;           // J/(mol K)

    // dHf is NOT a directly measured datum here: it is a Hess-law result from a
    // measured enthalpy of combustion.  The equation and every input are stated.
    derivation
    {
        quantity     dHf_298;
        equation     "dHf(cr) = 9*dHf(CO2,g) + 5.5*dHf(H2O,l) - dHc(cr)";
        dHc_cr       -4646300.0;       // J/mol (-4646.3 +/- 0.8 kJ/mol), measured
        dHf_CO2_g    -393510.0;        // J/mol
        dHf_H2O_l    -285830.0;        // J/mol
        result       -467400.0;        // J/mol
        origin       derived;
    }

    provenance
    {
        dHf_298
        {
            unit        "J/mol";
            phase       solid;
            origin      derived;
            citation    "dHc(cr) primary: Tsuzuki, Harper et al. (1958)";
            route       "located through the NIST WebBook condensed-phase free view (ID=C63912, Mask=2), used only as a finding aid -- a no-grant compilation, the value is re-cited to the primary";
            licence     "facts, primary-cited";
            status      candidate;
        }
        s_298
        {
            unit        "J/(mol K)";
            phase       solid;
            origin      measured;
            citation    "Cole, Hutchens & Stout (1963)";
            licence     "facts, primary-cited";
            status      candidate;
        }
    }
}

solidHeatCapacity
{
    phase         solid;
    model         polynomial;         // constant-Cp near ambient
    coefficients  ( 203.1 );          // Cp(298) J/(mol K)
    Trange        ( 280 320 );        // K

    provenance
    {
        unit        "J/(mol K)";
        phase       solid;
        origin      measured;
        citation    "Spink & Wadso, J. Chem. Thermodyn. 7 (1975) 561";
        licence     "facts, primary-cited";
        status      candidate;
    }
}

groups
{
    joback  none;
    reason  "aromatic ring plus amino acid backbone; nonvolatile solute, no VLE estimate wanted";
    status  flagged;
}

