{
    phase       liquid;
    value       ~425;              // K (about 152 C), APPROXIMATE, as stated in the staging source
    unit        "K";
    origin      "stated in the staging source WITHOUT a citation";
    status      flagged;
    action      "pin an open primary before this number is used for anything";
}

