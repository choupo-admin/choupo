/*----------------------------*- Choupo (CANDIDATE) -*----------------------*\
  CANDIDATE component: iopromide  (C18H24I3N3O8, CAS 73334-07-3)
  Iodinated X-ray contrast medium.  Large, neutral, hydrophilic, persistent:
  the well-rejected size-exclusion extreme of the NF/RO tracer set.

  PHASE-3 CLEANUP 2026-07-24 -- ARITY 1 ONLY.  Every system / state-dependent
  value that used to live in a comment block here was moved in phase 2 to its
  arity-correct home and is NOT restated here (never in two places); what is
  left below is intrinsic pure-compound data, each numeric carrying UNIT +
  PHASE/state + `origin` + citation.  The comments below are POINTERS only.

  RETENTION RULE for computed descriptors (McGowan V_x / Le Bas Vb): kept here
  only when no phase-2 record already carries the number as a derivation input.
  The Le Bas Vb is NOT kept here -- it is the derivation input of recordId
  diffusion-iopromide-water.

  THIS FILE HOLDS NO MEASURED PROPERTY VALUE AT ALL.  Everything staged for
  iopromide was either a system property (moved), a computed descriptor, or a
  qualitative statement.  That is the honest state; nothing is filled in.

  Private staging tier (data/tmp/, gitignored).  The runtime does not read it.
\*---------------------------------------------------------------------------*/

// ===== IDENTITY (arity 1) =====
name              iopromide;
formula           C18H24I3N3O8;
CAS               73334-07-3;
InChIKey  DGAIEPBNLOQYER-UHFFFAOYSA-N;   // FIRST BLOCK ONLY (14 chars) as retrieved
MW                791.11;           // g/mol
// role: WITHDRAWN 2026-07-24 (advisor ruling).  The engine's `role` enum conflates
// three independent axes -- intrinsic phase behaviour, what the CASE lets the
// component do, and which equilibrium route is used.  Staged as `nonvolatile`, it here meant
// only "I intend to use this as an aqueous solute" -- a CASE INTENT, not a physical
// claim.  A component may be BOTH volatile and a solute; they are not exclusive.
// The physical evidence is kept structured below; the engine does not read this tree.
phaseBehaviour
{
    roleAsStaged            nonvolatile;      // historical, NOT a physical assertion
    volatilityEvidence      "none in this file";
    contradictsStagedRole   no;
    note "restate as: intrinsic phase evidence | case phase declaration | equilibrium route (Raoult|EOS|Henry|chemical|excluded)";
}
intendedCaseUse             aqueousSolute;   // declaration of INTENT


identityProvenance
{
    origin      derived;    // MW computed from the formula with standard atomic weights
    citation    "PubChem CID 3736 (US NIH, public domain), PUG-REST retrieval";
    doi         "-";
    licence     "public domain (US Government)";
    evidenceId  -;
    curator     "agent:pharma-cleanup";
    retrieved   2026-07-24;
}

// NOTE ON IDENTITY: iopromide exists as rotational isomers / an amorphous solid
// in practice; the identity above is the molecular formula only.

// ===== INTRINSIC SOLID-STATE DATA =====
meltingPointStatus
{
    present     no;
    reason      "no clean melting point exists to record: the compound decomposes rather than melting cleanly, and no open source gives a fusion temperature with a phase transition.  A decomposition onset is NOT a melting point and is not stored as one.";
    status      flagged;
}

solidStateStatus
{
    crystalDensity  none;
    reason          "no crystal density curated; the commercial solid is amorphous, so an X-ray unit-cell density may not even be definable for the relevant form.  Without rho_c the PURE-component molar volume V_m = MW/rho_c is NOT derivable, so none is declared.";
    status          flagged;
}

thermochemistryStatus
{
    present     no;
    reason      "no open, phase-declared solid dHf / S298 / Cp located for this large triiodinated solid.  Routing a nonvolatile solid through the ideal-gas rung is forbidden by contract.";
    status      flagged;
}

// ===== COMPUTED MOLECULAR DESCRIPTORS =====
descriptors
{
    // Le Bas Vb is NOT declared here: it is already recorded, with its method
    // reference and the iodine increment used, as the derivation input of
    // recordId diffusion-iopromide-water (parameters/transport/diffusion/).
    note   "no arity-1 descriptor is stored in this file; see the pointer above.";
}

// ===== COSMO =====
cosmoStatus
{
    namedSet       none;
    evidence       -;      // no LVPP entry: no evidence/lvpp-iopromide/ directory exists
    deployable     no;
    reason         "no open sigma profile located: not in the VT-2005 77-compound set, and the InChIKey-skeleton join against LVPP release v25 found no match (a triiodinated molecule of this size is unlikely to appear in any public set).  A CHAOS (CC-BY) join is PENDING.  Even were a profile found, LVPP's QM protocol is incompatible with Choupo's VT-2005 cosmoSAC2002 constants (ethylene cross-check: +6.1 % cavity area, +10.3 % volume).";
    status         flagged;
}

// ===== PC-SAFT =====
pcSaftStatus
{
    parameterSet   none;
    pinnedSource   "-";
    numbersInHand  no;
    reason         "no published open parameter set identified.  See parameters/PCSAFT/_INVENTORY.md.";
    status         flagged;
}

// ===== POINTERS -- values MOVED OUT in phase 2 (home + recordId; no values here) =====
// logKow (COMPUTED)     -> parameters/partition/         recordId iopromide-octanol-water
// pKa                   -> NO RECORD: the staged statement was an ABSENCE ("no ionisation
//                          in the pH 2-12 band"), not an equilibrium.  An absence is not
//                          a datum and no speciation record was created.
// chargeAtPH7           -> DELETED (derived; never stored)
// aqueous solubility    -> NO RECORD: the staged statement was qualitative with no
//                          temperature (see parameters/solubility/_LEDGER.md, "not emitted")
// D_aq (ESTIMATE), its  -> parameters/transport/diffusion/  recordId diffusion-iopromide-water
//   Le Bas Vb input and the Stokes radius derived from it (same record)

// DEFECT FIXED 2026-07-24: this component carried a logKow that is a COMPUTED
// (HMDB-predicted) value while sitting under a "Hydrophobicity" heading beside
// experimental values on neighbouring components -- computed data wearing a
// measured face.  It is now a single partition record whose `origin` reads
// `estimated`; this file asserts no partition coefficient at all.

status            candidate;   // applies to the identity block; every property
                               // block above carries its own status
