pureComponentProperties
{
    solidDensity
    {
        available     none;               // DROPPED 2026-07-24 (rights clearance)
        status        flagged;
        blockedBy     "ChemicalBook (web aggregator) + CRC Handbook -- neither is redistributable";
        action        "read Dx (calculated density) from a published single-crystal structure of
                      the NAMED polymorph/anomer -- Acta Cryst. reports it directly -- or
                      derive rho = Z*MW/(N_A*V_cell) from open cell parameters (the
                      Crystallography Open Database is CC0 and cites the primary for each
                      entry).  Record the cell, Z and the arithmetic in a derivation{}
                      block, and NAME the solid form.";
        droppedValue  "value = 1.585 g/cm3; temperature = 293.15 K; citation = ChemicalBook CAS 5328-37-0";
    }

    solidMolarVolume
    {
        available     none;               // DROPPED 2026-07-24 (rights clearance)
        status        flagged;
        blockedBy     "DERIVED from the solidDensity above, which was dropped -- a
                       derivative cannot outlive the datum it was computed from";
        action        "recompute V = MW / rho once a legally clear rho exists, and
                       name the solid form both refer to";
        droppedValue  "94.72 cm3/mol  (this is the PURE-SOLID molar volume; the partial molar
                       volume in water is a SYSTEM property and is unaffected -- it
                       lives in parameters/volume/)";
    }

    meltingPoint
    {
        available     none;               // DROPPED 2026-07-24 (rights clearance)
        status        flagged;
        blockedBy     "The Merck Index + ChemicalBook -- paywalled compilation / web aggregator";
        action        "take T_fus from a calorimetric (DSC / adiabatic) primary that STATES the
                      polymorph or anomer it melted, and stage it in a fusion{} block
                      together with dHfus -- a melting point without a named solid form is
                      not a property of a substance, it is a property of a sample.";
        droppedValue  "value = 431.15 K; range = ( 431.15 438.15 ) K; transition = fusionWithDecomposition; citation = The Merck Index";
    }
}

identityDescriptors
{
    specificRotation
    {
        available     none;               // DROPPED 2026-07-24 (rights clearance)
        status        flagged;
        blockedBy     "The Merck Index -- paywalled commercial compilation";
        action        "take [alpha]_D from a polarimetric primary that states c, solvent,
                      temperature, wavelength and the mutarotation state.  This is an
                      IDENTITY descriptor, not a thermophysical datum, so it is the
                      lowest-priority gap in this file.";
        droppedValue  "value = 104.5 deg; temperature = 293.15 K; solvent = water; composition = mutarotation equilibrium; wavelength = 589.3 nm; citation = The Merck Index";
    }
}

// --- COSMO surface: NO deployable set (structured flag) ---
cosmoStatus
{
    recordType      cosmoSurfaceStatus;
    schemaVersion   1;
    deployableSet   none;
    evidenceRecord  none;                 // no evidence/lvpp-arabinose record staged
    reason          "no VT-2005 cosmoSAC2002 set ships for arabinose and no LVPP
                     arabinose record was staged.";
    protocolIncompatibility
        "An LVPP surface would not be usable anyway: different QM protocol (NWChem
         B3LYP/def2-SVPD, SES cavity) from the VT-2005 surfaces the cosmoSAC2002
         constants were regressed against (Mullins et al., IECR 45 (2006) 4389);
         measured on ethylene, +6.1 % area / +10.3 % volume.  Never tag an LVPP
         surface variant cosmoSAC2002.";
    identityCaution "any future LVPP/CHAOS match MUST use the full 27-character key
                     above -- block 1 alone would silently return xylose.";
    status          flagged;
}

// --- PC-SAFT: no set exists (structured flag) ---
pcSaftStatus
{
    recordType      saftParameterSetStatus;
    schemaVersion   1;
    deployableSet   none;
    sourcePinned    none;                 // arabinose is NOT among the 13 sugars
                                          //   fitted by Held & Sadowski (AIChE J.
                                          //   59 (2013) 4794-4805)
    numbersInHand   no;
    surrogateNote   "using xylose parameters for arabinose is a MODELLING CHOICE
                     made by a case, never arabinose's own parameter set; it must
                     never be filed here.";
    status          flagged;              // needs a fit with the full protocol recorded
}

groups
{
    unifac ( { group CH2; count 1; } { group CH; count 3; } { group OH; count 4; } { group CHO; count 1; } );   // PROPOSED (review vs Choupo UNIFAC vocab) -- aldo-pentose, open-chain decomposition
}
