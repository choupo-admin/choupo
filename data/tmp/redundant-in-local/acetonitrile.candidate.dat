\*---------------------------------------------------------------------------*/

name        acetonitrile;
formula     C2H3N;
CAS         75-05-8;
MW          41.053;
// SMILES CC#N   InChIKey WEVYAHXRMPXWCK-UHFFFAOYSA-N   PubChem CID 6342

groups
{
    joback ( { group CH3; count 1; } { group CN; count 1; } );   // PROPOSED (review) — first-order Joback decomposition
