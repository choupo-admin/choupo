recordType      acidDissociation;
schemaVersion   1;
recordId        simazine-pKa1;
participants    ( simazineH+ simazine H+ );
property        pKa;
reaction        "simazineH+ (protonated triazine ring N) = simazine + H+";
site            "triazine ring N (conjugate acid, very weak base)";
step            1;

conditions
{
    temperature     293.15 K;   // 20 C -- EXPLICITLY stated by the source, NOT 25 C
    phase           aqueous;
    ionicStrength   not stated;
}

value
{
    available       none;      // DROPPED 2026-07-24 -- see NOTES (rights clearance)
}

