    {
        pKa       1.62;
        temperature 293.15 K;
        citation  "Tomlin, The Pesticide Manual 11th ed. (BCPC 1997); via PubChem PUG-View / HSDB";
        licence   "rightsPending -- paywalled commercial compilation, PRIVATE tier only.
                   This was the datum until 2026-07-24.";
    }
    alt2
    {
        pKa       1.70;
        temperature 294.15 K;   // 21 C, as stated
        citation  "California DPR, 'Simazine Risk Characterization Document' (2013),
