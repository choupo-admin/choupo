        equilibrium.liquid.activityModel.binaryParameters.isobutylAcetate-dimethylSulfoxide.b_ji  252.653843182;
    }

    evidence
    {
        partitionFingerprint  "e3529ec3ed4a2813";   // frozen before the fit

        datasets
