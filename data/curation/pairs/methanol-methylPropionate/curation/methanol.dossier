    fittedParameters
    {
        equilibrium.liquid.activityModel.binaryParameters.methanol-methylPropionate.b_ij  286.708300649;
        equilibrium.liquid.activityModel.binaryParameters.methanol-methylPropionate.b_ji  101.644159515;
    }

    evidence
    {
        partitionFingerprint  "0ec552ad4ed4d1b5";   // frozen before the fit

        datasets
        (
        {
            role      fit;
            dataset   "constant/archiveExtracts/methanol-methylPropionate-bubble-j.jct.2019.01.004.dat";
