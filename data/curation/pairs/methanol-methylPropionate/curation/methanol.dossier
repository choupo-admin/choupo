            sha256    "4ab6fdb91fed18b9e052e23ba1b17f800379b3594e369a2d95aac7b0d8a62eeb";
            provenance measured;
            archiveFile "j.jct.2019.01.004.xml";
            system    "methanol + methylPropionate";
            pressure  "101300.000000 Pa";
        }
        );

        domain
        {
            coordinate  x1;
            fit         { min 0.045; max 0.966; n 11; }
        }
    }

    metrics
    {
        //  r2InSample: not computed by this operation (it reports chi-square).
