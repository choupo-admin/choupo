// (DEV.md 4c C294; bin/curate/uniquac_rq_from_groups.py).
uniquac
{
    r   4.3725;
    q   3.8320;
}

groups
{
    unifac ( { group CH3; count 1; } { group CH2; count 2; } { group C2H5O2; count 1; } );
    joback ( { group CH3; count 1; } { group CH2; count 4; } { group ether; count 1; } { group OH; count 1; } );
}

