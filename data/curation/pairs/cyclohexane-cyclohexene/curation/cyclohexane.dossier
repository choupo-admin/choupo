            provenance measured;
            archiveFile "je049902w.xml";
            system    "cyclohexane + cyclohexene";
        }
        );

        domain
        {
            coordinate  x1;
            fit         { min 0.0027; max 0.999; n 81; }
        }
    }

    metrics
    {
