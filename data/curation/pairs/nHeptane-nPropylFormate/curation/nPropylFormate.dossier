    {
        equilibrium.liquid.activityModel.binaryParameters.nPropylFormate-nHeptane.b_ij  410.593239715;
        equilibrium.liquid.activityModel.binaryParameters.nPropylFormate-nHeptane.b_ji  5.12489574668;
    }

    evidence
    {
        partitionFingerprint  "4a9dc9bb27fac8a3";   // frozen before the fit

