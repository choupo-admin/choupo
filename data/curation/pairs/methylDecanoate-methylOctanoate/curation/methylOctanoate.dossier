    fittedParameters
    {
        equilibrium.liquid.activityModel.binaryParameters.methylOctanoate-methylDecanoate.b_ij  -513.036101165;
        equilibrium.liquid.activityModel.binaryParameters.methylOctanoate-methylDecanoate.b_ji  935.820773169;
    }

    evidence
    {
        partitionFingerprint  "e2bc0f41aab2c249";   // frozen before the fit

        datasets
        (
        {
            role      fit;
            dataset   "constant/archiveExtracts/methylOctanoate-methylDecanoate-bubble-j.jct.2016.11.024.dat";
            doi       "10.1016/j.jct.2016.11.024";
            sha256    "cde8e82cf6c2907b30c7d6be39b4cdd1c9928e2d1a0c0294bc61ae78af66ce5a";
            provenance measured;
            archiveFile "j.jct.2016.11.024.xml";
            system    "methylOctanoate + methylDecanoate";
        }
        );

        domain
        {
            coordinate  x1;
            fit         { min 0.0595; max 0.8785; n 33; }
        }
    }

    metrics
    {
        //  r2InSample: not computed by this operation (it reports chi-square).
