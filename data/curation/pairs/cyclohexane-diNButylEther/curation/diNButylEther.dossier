        equilibrium.liquid.activityModel.binaryParameters.diNButylEther-cyclohexane.b_ij  89.7969688587;
        equilibrium.liquid.activityModel.binaryParameters.diNButylEther-cyclohexane.b_ji  -93.7165637474;
    }

    evidence
    {
