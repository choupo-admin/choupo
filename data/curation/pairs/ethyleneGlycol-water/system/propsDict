                role     fit;
                discard  ( 3 );   // C283 outliers, by name in the header
            }
            {
                dataset  "constant/archiveExtracts/water-ethyleneGlycol-bubble-je2008704.dat";
                role     fit;
            }
            {
                dataset  "constant/archiveExtracts/water-ethyleneGlycol-bubble-acs.jced.6b00264.dat";
                role     fit;
            }
        );

        objective { method twoStage;  scale { T_bubble absolute; } }
        residual
        {
            kind        T_bubble;
            components  ( water ethyleneGlycol );
            weighting   uncertainty;
        }

        options
        {
            maxIter      80;
            tolerance    1.0e-6;
            fdStep       1.0e-4;
            lambda0      1.0e-3;
        }

        output
        {
            parity     parity_start2.csv;
        }
    }
    {
        name        txy_ideal;
        type        propertyScan1D;
        vary        { variable x[water];  from 0.0;  to 1.0;  n 101; }
        state       { P 100 kPa;  composition { water 0.5;  ethyleneGlycol 0.5; } }
        thermo
        {
            equilibrium { liquid { activityModel { model ideal; } } }
        }
        properties  ( T_bubble  y_eq_water );
        output      { file txy_ideal.csv; }
    }
    {
        name        txy_nrtl;
        type        propertyScan1D;
        vary        { variable x[water];  from 0.0;  to 1.0;  n 101; }
        state       { P 100 kPa;  composition { water 0.5;  ethyleneGlycol 0.5; } }
        thermo
        {
            equilibrium { liquid { activityModel { model NRTL; /* no inline pair: the case's own record */ } } }
        }
        properties  ( T_bubble  y_eq_water );
        output      { file txy_nrtl.csv; }
    }
    // @@C294-OPS-BEGIN@@ -- UNIQUAC and Wilson on the NRTL fit's own evidence (DEV.md 4c C294)
    {
        name        fit_wilson;
        type        fitParameters;

        parameters
        (
            { path  equilibrium.liquid.activityModel.binaryParameters.water-ethyleneGlycol.A_ij;  initial 0;  min -30000;  max 30000; }
            { path  equilibrium.liquid.activityModel.binaryParameters.water-ethyleneGlycol.A_ji;  initial 0;  min -30000;  max 30000; }
        );

        thermo   // the model, as a fragment of the case's system (C294)
        {
            equilibrium
            {
                liquid
                {
                    activityModel
                    {
                        model Wilson;
                        binaryParameters   // the FIT'S starting point
