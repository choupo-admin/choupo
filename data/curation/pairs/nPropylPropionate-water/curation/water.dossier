    refusal        "No independent experimental evidence remains after fitting.";

    fittedParameters
    {
        equilibrium.liquid.activityModel.binaryParameters.water-nPropylPropionate.b_ij  1639.11209137;
        equilibrium.liquid.activityModel.binaryParameters.water-nPropylPropionate.b_ji  156.010688881;
    }

    evidence
    {
        partitionFingerprint  "50d5c5d807d9f08b";   // frozen before the fit

        datasets
        (
        {
            role      fit;
            dataset   "constant/archiveExtracts/water-nPropylPropionate-bubble-je101302p.dat";
            doi       "10.1021/je101302p";
            sha256    "bdc86ef24b356f9bfdd0ea861f4f3c7cabdceddf281b88c512e7e37c3758e967";
            provenance measured;
            archiveFile "je101302p.xml";
            system    "water + nPropylPropionate";
            pressure  "101300.000000 Pa";
        }
        );

        domain
        {
            coordinate  x1;
            fit         { min 0.0179; max 0.998; n 5; }
        }
    }

    metrics
    {
        //  r2InSample: not computed by this operation (it reports chi-square).
