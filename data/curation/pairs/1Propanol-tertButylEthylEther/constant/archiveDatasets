(
    {
        file          "constant/archiveExtracts/tertButylEthylEther-1Propanol-bubble-j.fluid.2007.04.009.dat";
        role          fit;   // C283: every laboratory is fitted
        doi           "10.1016/j.fluid.2007.04.009";
        url           "https://trc.nist.gov/ThermoML/10.1016/j.fluid.2007.04.009.xml";
        page          "https://trc.nist.gov/ThermoML/10.1016/j.fluid.2007.04.009.json";
        articleFile   "j.fluid.2007.04.009.xml";
        articleSha256 "2d52d19d50de90270423da77e2ad9b4a87863cd87b4e9311bc9c56ea5e2786b4";
        block         10;
        filter        ( --interior-only );
        extract       "bin/choupo-thermoml extract-vle <article file> --block 10 --interior-only --into <dir>";
        sha256        "9674f56553f4838a1e3a352e285aab19e67ac81238ab0782690887040d4db608";
        identity
        {
            tertButylEthylEther { cas "637-92-3"; inchiKey "NUMQCACRALPSHD-UHFFFAOYSA-N"; }
            1Propanol      { cas "71-23-8"; inchiKey "BDERNNFJNOPAEC-UHFFFAOYSA-N"; }
        }
    }
