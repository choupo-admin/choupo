    refusal        "No independent experimental evidence remains after fitting.";

    fittedParameters
    {
        equilibrium.liquid.activityModel.binaryParameters.mCresol-nitrobenzene.b_ij  336.140818772;
        equilibrium.liquid.activityModel.binaryParameters.mCresol-nitrobenzene.b_ji  -257.981537538;
    }

    evidence
    {
        partitionFingerprint  "9a5c9063e30d78e7";   // frozen before the fit

        datasets
        (
        {
            role      fit;
            dataset   "constant/archiveExtracts/mCresol-nitrobenzene-bubble-j.fluid.2006.12.010.dat";
            doi       "10.1016/j.fluid.2006.12.010";
            sha256    "d4cfa3604387d388024be3cdc5143f2772e636a4781a3529a2ec44f88f93e3fd";
            provenance measured;
            archiveFile "j.fluid.2006.12.010.xml";
            system    "mCresol + nitrobenzene";
            pressure  "94950.000000 Pa";
        }
        );

        domain
        {
            coordinate  x1;
            fit         { min 0.0655; max 0.869; n 12; }
        }
    }

    metrics
    {
        //  r2InSample: not computed by this operation (it reports chi-square).
