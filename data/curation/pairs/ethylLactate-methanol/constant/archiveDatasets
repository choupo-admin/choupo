        sha256        "bd472b3b907e31559fb96e3780534563a9b36e8f5c3e01129f2c4d021333781c";
        identity
        {
            methanol       { cas "67-56-1"; inchiKey "OKKJLVBELUTLKV-UHFFFAOYSA-N"; }
