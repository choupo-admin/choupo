        doi           "10.1021/je900481e";
        url           "https://trc.nist.gov/ThermoML/10.1021/je900481e.xml";
        page          "https://trc.nist.gov/ThermoML/10.1021/je900481e.json";
        articleFile   "je900481e.xml";
