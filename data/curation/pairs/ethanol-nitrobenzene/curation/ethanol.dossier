    refusal        "No independent experimental evidence remains after fitting.";

    fittedParameters
    {
        equilibrium.liquid.activityModel.binaryParameters.ethanol-nitrobenzene.b_ij  535.028904937;
        equilibrium.liquid.activityModel.binaryParameters.ethanol-nitrobenzene.b_ji  -542.350184869;
    }

    evidence
    {
        partitionFingerprint  "e7fec59e95fdb99e";   // frozen before the fit

        datasets
        (
        {
            role      fit;
            dataset   "constant/archiveExtracts/ethanol-nitrobenzene-bubble-j.jct.2005.08.011.dat";
            doi       "10.1016/j.jct.2005.08.011";
            sha256    "851cdb6ff7bdf3d7c26cd45d5747115356958c2a46697532260c787131a443cd";
            provenance measured;
            archiveFile "j.jct.2005.08.011.xml";
            system    "ethanol + nitrobenzene";
            pressure  "94950.000000 Pa";
        }
        );

        domain
        {
            coordinate  x1;
            fit         { min 0.0603; max 0.9408; n 13; }
        }
    }

    metrics
    {
        //  r2InSample: not computed by this operation (it reports chi-square).
