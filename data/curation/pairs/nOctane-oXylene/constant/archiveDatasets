        block         12;
        filter        ( --interior-only );
        extract       "bin/choupo-thermoml extract-vle <article file> --block 12 --interior-only --into <dir>";
        sha256        "cb648e243ed205f508f4d6ebcf8890724500c6e726897e5f10ab10323ba2d14d";
        identity
        {
            nOctane        { cas "111-65-9"; inchiKey "TVMXDCGIABBOFY-UHFFFAOYSA-N"; }
