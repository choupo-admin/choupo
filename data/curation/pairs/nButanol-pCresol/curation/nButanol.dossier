    fittedParameters
    {
        equilibrium.liquid.activityModel.binaryParameters.nButanol-pCresol.b_ij  397.426105376;
        equilibrium.liquid.activityModel.binaryParameters.nButanol-pCresol.b_ji  -24.171552418;
    }

    evidence
    {
        partitionFingerprint  "282244ae6ae971c5";   // frozen before the fit

        datasets
        (
        {
            role      fit;
            dataset   "constant/archiveExtracts/nButanol-pCresol-bubble-j.fluid.2006.03.018.dat";
            doi       "10.1016/j.fluid.2006.03.018";
            sha256    "6e931cdb390e5154eade3106db61c1605da2984fb405d27b2b4043d47fc3b77f";
            provenance measured;
            archiveFile "j.fluid.2006.03.018.xml";
            system    "nButanol + pCresol";
            pressure  "95230.000000 Pa";
        }
        );

        domain
        {
            coordinate  x1;
            fit         { min 0.0513; max 0.9001; n 10; }
        }
    }

    metrics
    {
