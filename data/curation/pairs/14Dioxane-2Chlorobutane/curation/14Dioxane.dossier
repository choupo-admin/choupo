            provenance measured;
            archiveFile "je020185k.xml";
            system    "14Dioxane + 2Chlorobutane";
            pressure  "40000.000000 Pa";
        }
        );

        domain
        {
            coordinate  x1;
            fit         { min 0.098; max 0.936; n 12; }
        }
    }

    metrics
    {
        //  r2InSample: not computed by this operation (it reports chi-square).
