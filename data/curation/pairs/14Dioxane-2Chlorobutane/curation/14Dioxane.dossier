    {
        equilibrium.liquid.activityModel.binaryParameters.14Dioxane-2Chlorobutane.b_ij  -64.9571483652;
        equilibrium.liquid.activityModel.binaryParameters.14Dioxane-2Chlorobutane.b_ji  276.418126732;
    }

    evidence
    {
        partitionFingerprint  "85f51094c50e580f";   // frozen before the fit

