name        ethylPropionate;
CAS         105-37-3;
formula     C5H10O2;
reviewStatus autoPromoted;
review      { by none; }   // DEV.md 4c C300 rule 4 (C297): nobody has reviewed it
MW          102.1330;      // kg/kmol, from the formula (IUPAC standard atomic weights)
Tc          546.3;      // K, IUPAC recommended (provenance.Tc)
Pc          33.9;      // bar, IUPAC recommended (provenance.Pc)
omega       0.390521;      // [-] (provenance.omega)
//  Tb: NOT DECLARED -- the archive reports no boiling temperature at
//  101.3 kPa for it, and a Tb read back off the fitted Antoine would be
//  the curve tested against itself (the fitted normal boiling point is
//  in provenance.vaporPressure.acceptance.Tnb_fit).

standardThermochemistry
{
    dHf_298   -463810;        // J/mol, ideal gas, Joback ESTIMATE (provenance.dHf_298)
    s_298     402.06;        // J/(mol K), ideal gas, DERIVED from Joback (provenance.s_298)
}

vaporPressure
{
    model         Antoine;
    // log10(Psat [bar]) = A - B / (T[K] + C), FITTED by bin/choupo-curate vp to
    // measured vapour pressures -- see provenance.vaporPressure
    coefficients  (4.143442505  1270.464502  -65.09247183);
    Trange        (348.07  408.75);   // the fit's own span; outside it the engine announces the extrapolation
}

Vliq        1.143939e-04;      // m3/mol at 25 C, FITTED (provenance.Vliq)

idealGasHeatCapacity
{
    model         polynomial;
    // Cp [J/(mol K)] = a0 + a1 T + a2 T^2 + a3 T^3, Joback ESTIMATE
    coefficients  (23.752  0.42404  -1.536000e-04  -8.800000e-09);
    Trange        (273  1000);
}

liquidHeatCapacity
{
    model         polynomial;
    // Cp [J/(mol K)] = a0 + a1 T + a2 T^2, Rowlinson-Bondi ESTIMATE (provenance.liquidHeatCapacity)
    coefficients  (199.3337592  -0.1758844491  0.0006552283005);
    Trange        (348.07  408.75);
}

