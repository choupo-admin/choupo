        equilibrium.liquid.activityModel.binaryParameters.ethylAcetate-diethylSuccinate.b_ij  -155.577859261;
        equilibrium.liquid.activityModel.binaryParameters.ethylAcetate-diethylSuccinate.b_ji  -155.577859261;
    }

    evidence
    {
        partitionFingerprint  "aad82d68258e788d";   // frozen before the fit

        datasets
        (
        {
            role      fit;
            dataset   "constant/archiveExtracts/ethylAcetate-diethylSuccinate-bubbleP-j.fluid.2009.11.013-b0.dat";
            doi       "10.1016/j.fluid.2009.11.013";
            sha256    "ff3fc93888d1f81f095d56de2dcffcc3e9eed376c795c66efb57179d210d6544";
            provenance measured;
            archiveFile "j.fluid.2009.11.013.xml";
            system    "ethylAcetate + diethylSuccinate";
        }
        );

        domain
        {
            coordinate  x1;
            fit         { min 0.021; max 0.773; n 5; }
        }
    }

    metrics
    {
        //  r2InSample: not computed by this operation (it reports chi-square).
        //  NO HELD-OUT METRIC EXISTS.  r2InSample above is exactly that --
        //  in-sample -- and must not be read as an external check.
    }
}

