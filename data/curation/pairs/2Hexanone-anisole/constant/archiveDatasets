/*--------------------------------*- Choupo -*--------------------------------*\
  constant/archiveDatasets -- WHERE the measurements of 2Hexanone-anisole
  come from, and how to regenerate them.  NO MEASURED POINT IS IN THIS TREE
  (Vitor, 2026-11-10: the measured series are not copied; only the fitted
  parameters are kept).  `bin/choupo-curate fetch <case>` writes each
  dataset into constant/archiveExtracts/ (gitignored): the article file is taken from
  the local ThermoML cache when it holds it, else from the NIST URL below,
  and BOTH sha256 sums are checked -- a mismatch refuses, an unreachable
  NIST is reported NOT RUN, never a pass.
\*-----------------------------------------------------------------------------*/

recordType    archiveDatasets;

archive
{
    tarball   "ThermoML.v2020-09-30.tgz";
    doi       "10.18434/mds2-2422";
    note      "the finding aid; each article file is also served one by one at the NIST URL";
}

datasets
(
    {
        file          "constant/archiveExtracts/2Hexanone-anisole-bubble-je900058p.dat";
        role          fit;   // C283: every laboratory is fitted
        doi           "10.1021/je900058p";
        url           "https://trc.nist.gov/ThermoML/10.1021/je900058p.xml";
        page          "https://trc.nist.gov/ThermoML/10.1021/je900058p.json";
        articleFile   "je900058p.xml";
        articleSha256 "60ee278277a3b7dc9d96214f7d63ff569e6663b61875855e60bc38fea824b588";
        block         9;
        filter        ( --interior-only );
        extract       "bin/choupo-thermoml extract-vle <article file> --block 9 --interior-only --into <dir>";
        sha256        "3b1c31a6cf0a9b37265120c6e0cff6e2b32a09ae0e7956bf17229cbe47b0ecb2";
        identity
        {
            2Hexanone      { cas "591-78-6"; inchiKey "QQZOPKMRPOGIEB-UHFFFAOYSA-N"; }
            anisole        { cas "100-66-3"; inchiKey "RDOXTESZEPMUJZ-UHFFFAOYSA-N"; }
        }
    }
);
