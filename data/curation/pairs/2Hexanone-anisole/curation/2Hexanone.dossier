    fittedParameters
    {
        equilibrium.liquid.activityModel.binaryParameters.2Hexanone-anisole.b_ij  204.529867499;
        equilibrium.liquid.activityModel.binaryParameters.2Hexanone-anisole.b_ji  -156.751629027;
    }

    evidence
    {
        partitionFingerprint  "958059a01b7b843a";   // frozen before the fit

