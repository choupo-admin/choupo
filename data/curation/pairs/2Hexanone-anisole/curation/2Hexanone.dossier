            provenance measured;
            archiveFile "je900058p.xml";
            system    "2Hexanone + anisole";
        }
        );

        domain
        {
            coordinate  x1;
            fit         { min 0.218; max 0.9; n 32; }
        }
    }

    metrics
    {
        //  r2InSample: not computed by this operation (it reports chi-square).
