/*--------------------------------*- Choupo -*--------------------------------*\
  constant/archiveDatasets -- WHERE the measurements of methylPentanoate-propionitrile
  come from, and how to regenerate them.  NO MEASURED POINT IS IN THIS TREE
  (Vitor, 2026-11-10: the measured series are not copied; only the fitted
  parameters are kept).  `bin/choupo-curate fetch <case>` writes each
  dataset into constant/archiveExtracts/ (gitignored): the article file is taken from
  the local ThermoML cache when it holds it, else from the NIST URL below,
  and BOTH sha256 sums are checked -- a mismatch refuses, an unreachable
  NIST is reported NOT RUN, never a pass.
\*-----------------------------------------------------------------------------*/

recordType    archiveDatasets;

archive
{
    tarball   "ThermoML.v2020-09-30.tgz";
    doi       "10.18434/mds2-2422";
    note      "the finding aid; each article file is also served one by one at the NIST URL";
}

datasets
(
    {
        file          "constant/archiveExtracts/methylPentanoate-propionitrile-bubble-je060469v.dat";
        role          fit;   // C283: every laboratory is fitted
        doi           "10.1021/je060469v";
        url           "https://trc.nist.gov/ThermoML/10.1021/je060469v.xml";
        page          "https://trc.nist.gov/ThermoML/10.1021/je060469v.json";
        articleFile   "je060469v.xml";
        articleSha256 "c9cd2f7a154f8a26d2842cfb6f97bb9fd4fe3b13126bafecc810181a2851b659";
        block         14;
        filter        ( --interior-only );
        extract       "bin/choupo-thermoml extract-vle <article file> --block 14 --interior-only --into <dir>";
        sha256        "fe330b4dc28f3e5bf9f47a5261a22c770a41fc2d12292c46b9713014d188c2f4";
        identity
        {
            methylPentanoate { cas "624-24-8"; inchiKey "HNBDRPTVWVGKBR-UHFFFAOYSA-N"; }
            propionitrile  { cas "107-12-0"; inchiKey "FVSKHRXBFJPNKK-UHFFFAOYSA-N"; }
        }
    }
);
