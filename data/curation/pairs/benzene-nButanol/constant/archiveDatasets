/*--------------------------------*- Choupo -*--------------------------------*\
  constant/archiveDatasets -- WHERE the measurements of benzene-nButanol
  come from, and how to regenerate them.  NO MEASURED POINT IS IN THIS TREE
  (Vitor, 2026-11-10: the measured series are not copied; only the fitted
  parameters are kept).  `bin/choupo-curate fetch <case>` writes each
  dataset into constant/archiveExtracts/ (gitignored): the article file is taken from
  the local ThermoML cache when it holds it, else from the NIST URL below,
  and BOTH sha256 sums are checked -- a mismatch refuses, an unreachable
  NIST is reported NOT RUN, never a pass.  The extractor is `extract-px`
  (a bubble-PRESSURE block at a stated temperature, DEV.md 4c C291).
\*-----------------------------------------------------------------------------*/

recordType    archiveDatasets;

archive
{
    tarball   "ThermoML.v2020-09-30.tgz";
    doi       "10.18434/mds2-2422";
    note      "the finding aid; each article file is also served one by one at the NIST URL";
}

datasets
(
    {
        file          "constant/archiveExtracts/benzene-nButanol-bubbleP-j.jct.2005.07.004-b4.dat";
        role          fit;   // C283: every laboratory is fitted
        doi           "10.1016/j.jct.2005.07.004";
        url           "https://trc.nist.gov/ThermoML/10.1016/j.jct.2005.07.004.xml";
        page          "https://trc.nist.gov/ThermoML/10.1016/j.jct.2005.07.004.json";
        articleFile   "j.jct.2005.07.004.xml";
        articleSha256 "2a1993b096a24879ffe37939a4b0df227a87217f5ee55caf7b37f1f753b56527";
        block         4;
        extractor     bubblePressure;
        extract       "bin/choupo-thermoml extract-px <article file> --block 4 --into <dir>";
        sha256        "da112c37cc9f899e92d4396aeccf12e12b6fb233c0ea9047cfd77cea1e170eb8";
        identity
        {
            benzene        { cas "71-43-2"; inchiKey "UHOVQNZJYSORNB-UHFFFAOYSA-N"; }
            nButanol       { cas "71-36-3"; inchiKey "LRHPLDYGYMQRHN-UHFFFAOYSA-N"; }
        }
    }
    {
        file          "constant/archiveExtracts/benzene-nButanol-bubbleP-j.jct.2004.01.001-b18.dat";
        role          fit;   // C283: every laboratory is fitted
        doi           "10.1016/j.jct.2004.01.001";
        url           "https://trc.nist.gov/ThermoML/10.1016/j.jct.2004.01.001.xml";
        page          "https://trc.nist.gov/ThermoML/10.1016/j.jct.2004.01.001.json";
        articleFile   "j.jct.2004.01.001.xml";
        articleSha256 "c36869b5255205e6fc68ce6d0363667c9aa8b7994ca9e1040ea169089fe65a21";
        block         18;
        extractor     bubblePressure;
        xOf           benzene;   // the article reports the other member; x = 1 - x'
        extract       "bin/choupo-thermoml extract-px <article file> --block 18 --x-of benzene --into <dir>";
        sha256        "d4bbd58f53b3118d3f0671b15dc11287982fa9e24201c42ab7b3a536e06dcd3c";
        identity
        {
            benzene        { cas "71-43-2"; inchiKey "UHOVQNZJYSORNB-UHFFFAOYSA-N"; }
            nButanol       { cas "71-36-3"; inchiKey "LRHPLDYGYMQRHN-UHFFFAOYSA-N"; }
        }
    }
);
