/*--------------------------------*- Choupo -*--------------------------------*\
  constant/archiveDatasets -- WHERE the measurements of nDecane-oXylene
  come from, and how to regenerate them.  NO MEASURED POINT IS IN THIS TREE
  (Vitor, 2026-11-10: the measured series are not copied; only the fitted
  parameters are kept).  `bin/choupo-curate fetch <case>` writes each
  dataset into constant/archiveExtracts/ (gitignored): the article file is taken from
  the local ThermoML cache when it holds it, else from the NIST URL below,
  and BOTH sha256 sums are checked -- a mismatch refuses, an unreachable
  NIST is reported NOT RUN, never a pass.
\*-----------------------------------------------------------------------------*/

recordType    archiveDatasets;

archive
{
    tarball   "ThermoML.v2020-09-30.tgz";
    doi       "10.18434/mds2-2422";
    note      "the finding aid; each article file is also served one by one at the NIST URL";
}

datasets
(
    {
        file          "constant/archiveExtracts/nDecane-oXylene-bubble-j.fluid.2012.09.019.dat";
        role          fit;   // C283: every laboratory is fitted
        doi           "10.1016/j.fluid.2012.09.019";
        url           "https://trc.nist.gov/ThermoML/10.1016/j.fluid.2012.09.019.xml";
        page          "https://trc.nist.gov/ThermoML/10.1016/j.fluid.2012.09.019.json";
        articleFile   "j.fluid.2012.09.019.xml";
        articleSha256 "7ab32e1e73d47ffb72cce97fbd8aed01dd70cc88c73c7e45957aadf589cfd90b";
        block         12;
        filter        ( --interior-only );
        extract       "bin/choupo-thermoml extract-vle <article file> --block 12 --interior-only --into <dir>";
        sha256        "7a39740a57c3c917911774b2ffd215db4cbc0c57cfd1cba94154c7e4436e4c4e";
        identity
        {
            nDecane        { cas "124-18-5"; inchiKey "DIOQZVSQGTUSAI-UHFFFAOYSA-N"; }
            oXylene        { cas "95-47-6"; inchiKey "CTQNGGLPUBDAKN-UHFFFAOYSA-N"; }
        }
    }
    {
        file          "constant/archiveExtracts/nDecane-oXylene-bubble-j.fluid.2004.10.027.dat";
        role          fit;   // C283: every laboratory is fitted
        doi           "10.1016/j.fluid.2004.10.027";
        url           "https://trc.nist.gov/ThermoML/10.1016/j.fluid.2004.10.027.xml";
        page          "https://trc.nist.gov/ThermoML/10.1016/j.fluid.2004.10.027.json";
        articleFile   "j.fluid.2004.10.027.xml";
        articleSha256 "dedfec1f89c424222eb64267c206a4a687646def0a2f935f68318ea9398d71d6";
        block         24;
        filter        ( --interior-only );
        xOf           nDecane;   // the article reports the other member; x = 1 - x'
        extract       "bin/choupo-thermoml extract-vle <article file> --block 24 --interior-only --x-of nDecane --into <dir>";
        sha256        "d7341851da6eabb1de11e664c08a1218c4358b321fce15838abe280154ac7edf";
        identity
        {
            nDecane        { cas "124-18-5"; inchiKey "DIOQZVSQGTUSAI-UHFFFAOYSA-N"; }
            oXylene        { cas "95-47-6"; inchiKey "CTQNGGLPUBDAKN-UHFFFAOYSA-N"; }
        }
    }
);
