            doi       "10.1016/j.fluid.2008.01.020";
            sha256    "9f0315d6fee492b6a3c5922dcb1848ea90206d54b1923a4fe327bd591daa1461";
            provenance measured;
            archiveFile "j.fluid.2008.01.020.xml";
            system    "pXylene + nNDimethylformamide";
            pressure  "95100.000000 Pa";
        }
        );

        domain
