    fittedParameters
    {
        equilibrium.liquid.activityModel.binaryParameters.diNPropylEther-1Pentanol.b_ij  530.03135326;
        equilibrium.liquid.activityModel.binaryParameters.diNPropylEther-1Pentanol.b_ji  -139.524576412;
    }

    evidence
    {
