/*--------------------------------*- Choupo -*--------------------------------*\
  constant/archiveDatasets -- WHERE the measurements of 1Propanol-dimethylCarbonate
  come from, and how to regenerate them.  NO MEASURED POINT IS IN THIS TREE
  (Vitor, 2026-11-10: the measured series are not copied; only the fitted
  parameters are kept).  `bin/choupo-curate fetch <case>` writes each
  dataset into constant/archiveExtracts/ (gitignored): the article file is taken from
  the local ThermoML cache when it holds it, else from the NIST URL below,
  and BOTH sha256 sums are checked -- a mismatch refuses, an unreachable
  NIST is reported NOT RUN, never a pass.
\*-----------------------------------------------------------------------------*/

recordType    archiveDatasets;

archive
{
    tarball   "ThermoML.v2020-09-30.tgz";
    doi       "10.18434/mds2-2422";
    note      "the finding aid; each article file is also served one by one at the NIST URL";
}

datasets
(
    {
        file          "constant/archiveExtracts/1Propanol-dimethylCarbonate-bubble-j.jct.2011.08.006.dat";
        role          fit;   // C283: every laboratory is fitted
        doi           "10.1016/j.jct.2011.08.006";
        url           "https://trc.nist.gov/ThermoML/10.1016/j.jct.2011.08.006.xml";
        page          "https://trc.nist.gov/ThermoML/10.1016/j.jct.2011.08.006.json";
        articleFile   "j.jct.2011.08.006.xml";
        articleSha256 "682a55d05fe8902bbf42f1d947981fa35b0d90029fa727758bcfb6519f239cc6";
        block         3;
        filter        ( --interior-only );
        extract       "bin/choupo-thermoml extract-vle <article file> --block 3 --interior-only --into <dir>";
        sha256        "e56057bde311c8f23a03f05b8b935657a733e8b1a53f64b5149b79be9c9a4893";
        identity
        {
            1Propanol      { cas "71-23-8"; inchiKey "BDERNNFJNOPAEC-UHFFFAOYSA-N"; }
            dimethylCarbonate { cas "616-38-6"; inchiKey "IEJIGPNLZYLLBP-UHFFFAOYSA-N"; }
        }
    }
    {
        file          "constant/archiveExtracts/1Propanol-dimethylCarbonate-bubble-je030131q.dat";
        role          fit;   // C283: every laboratory is fitted
        doi           "10.1021/je030131q";
        url           "https://trc.nist.gov/ThermoML/10.1021/je030131q.xml";
        page          "https://trc.nist.gov/ThermoML/10.1021/je030131q.json";
        articleFile   "je030131q.xml";
        articleSha256 "b41bca23136ec66aba1b6984f5c0f44a5fca02ba9d89bed1e374a726fb032c08";
        block         24;
        filter        ( --interior-only );
        xOf           1Propanol;   // the article reports the other member; x = 1 - x'
        extract       "bin/choupo-thermoml extract-vle <article file> --block 24 --interior-only --x-of 1Propanol --into <dir>";
        sha256        "786e2624481caea6f1813211879b18fde941d338e982387dbbf5cbee05c19126";
        identity
        {
            1Propanol      { cas "71-23-8"; inchiKey "BDERNNFJNOPAEC-UHFFFAOYSA-N"; }
            dimethylCarbonate { cas "616-38-6"; inchiKey "IEJIGPNLZYLLBP-UHFFFAOYSA-N"; }
        }
    }
);
