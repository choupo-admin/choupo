        articleSha256 "1e51e148a411dd6d0f92e2bdb90371ad41472fab6ab57c1c895e50f71d8517c5";
        block         25;
        filter        ( --interior-only );
        extract       "bin/choupo-thermoml extract-vle <article file> --block 25 --interior-only --into <dir>";
        sha256        "95f5057c2520759e3963d3cb35d14f77ea19e174e32f7f50a4ea52da7421fc29";
        identity
        {
            methylTertButylEther { cas "1634-04-4"; inchiKey "BZLVMXJERCGZMT-UHFFFAOYSA-N"; }
            acetonitrile   { cas "75-05-8"; inchiKey "WEVYAHXRMPXWCK-UHFFFAOYSA-N"; }
