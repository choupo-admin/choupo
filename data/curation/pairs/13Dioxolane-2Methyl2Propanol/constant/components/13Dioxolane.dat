    coefficients  (4.496742762  1370.944673  -42.80953915);
    Trange        (275  350.77);   // the fit's own span; outside it the engine announces the extrapolation
}

Vliq        6.962462e-05;      // m3/mol at 25 C, FITTED (provenance.Vliq)

idealGasHeatCapacity
{
    model         polynomial;
    // Cp [J/(mol K)] = a0 + a1 T + a2 T^2 + a3 T^3, Joback ESTIMATE
    coefficients  (-31.62  0.441  -2.944000e-04  7.480000e-08);
    Trange        (273  1000);
}

liquidHeatCapacity
{
    model         polynomial;
    // Cp [J/(mol K)] = a0 + a1 T + a2 T^2, FITTED (provenance.liquidHeatCapacity)
    coefficients  (4.7973368  0.5216459915  -0.0004341941513);
    Trange        (288.15  328.15);
}

