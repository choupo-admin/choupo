/*--------------------------------*- Choupo -*--------------------------------*\
  constant/archiveDatasets -- WHERE the measurements of 1Methoxy2Propanol-water
  come from, and how to regenerate them.  NO MEASURED POINT IS IN THIS TREE
  (Vitor, 2026-11-10: the measured series are not copied; only the fitted
  parameters are kept).  `bin/choupo-curate fetch <case>` writes each
  dataset into constant/archiveExtracts/ (gitignored): the article file is taken from
  the local ThermoML cache when it holds it, else from the NIST URL below,
  and BOTH sha256 sums are checked -- a mismatch refuses, an unreachable
  NIST is reported NOT RUN, never a pass.
\*-----------------------------------------------------------------------------*/

recordType    archiveDatasets;

archive
{
    tarball   "ThermoML.v2020-09-30.tgz";
    doi       "10.18434/mds2-2422";
    note      "the finding aid; each article file is also served one by one at the NIST URL";
}

datasets
(
    {
        file          "constant/archiveExtracts/water-1Methoxy2Propanol-bubble-j.fluid.2007.06.006.dat";
        role          fit;   // C283: every laboratory is fitted
        doi           "10.1016/j.fluid.2007.06.006";
        url           "https://trc.nist.gov/ThermoML/10.1016/j.fluid.2007.06.006.xml";
        page          "https://trc.nist.gov/ThermoML/10.1016/j.fluid.2007.06.006.json";
        articleFile   "j.fluid.2007.06.006.xml";
        articleSha256 "1199da24ff6d595c35b20f12ca5001fe7bb53d23719dca5dafec2b262c84ad53";
        block         2;
        filter        ( --interior-only );
        extract       "bin/choupo-thermoml extract-vle <article file> --block 2 --interior-only --into <dir>";
        sha256        "bccaaa430112e51da40a55c8b8a01525203cd652bf8e6622c389549fe198b9c2";
        identity
        {
            water          { cas "7732-18-5"; inchiKey "XLYOFNOQVPJJNP-UHFFFAOYSA-N"; }
            1Methoxy2Propanol { cas "107-98-2"; inchiKey "ARXJGSRGQADJSQ-UHFFFAOYSA-N"; }
        }
    }
    {
        file          "constant/archiveExtracts/water-1Methoxy2Propanol-bubble-acs.jced.6b00895.dat";
        role          fit;   // C283: every laboratory is fitted
        doi           "10.1021/acs.jced.6b00895";
        url           "https://trc.nist.gov/ThermoML/10.1021/acs.jced.6b00895.xml";
        page          "https://trc.nist.gov/ThermoML/10.1021/acs.jced.6b00895.json";
        articleFile   "acs.jced.6b00895.xml";
        articleSha256 "0ae2e355a34202e32a89a88b12de714caef2b7db39d7b78295fcb8eac63e0cd6";
        block         6;
        filter        ( --interior-only );
        xOf           water;   // the article reports the other member; x = 1 - x'
        extract       "bin/choupo-thermoml extract-vle <article file> --block 6 --interior-only --x-of water --into <dir>";
        sha256        "7fd66fe702bf21232a7414df9cef97a7461823a95351cfc30899e640e6b5c939";
        identity
        {
            water          { cas "7732-18-5"; inchiKey "XLYOFNOQVPJJNP-UHFFFAOYSA-N"; }
            1Methoxy2Propanol { cas "107-98-2"; inchiKey "ARXJGSRGQADJSQ-UHFFFAOYSA-N"; }
        }
    }
);
