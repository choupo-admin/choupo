        equilibrium.liquid.activityModel.binaryParameters.cumene-nNDimethylacetamide.b_ij  179.479138917;
        equilibrium.liquid.activityModel.binaryParameters.cumene-nNDimethylacetamide.b_ji  502.817343114;
    }

    evidence
    {
        partitionFingerprint  "48b3f4d712d26d05";   // frozen before the fit

        datasets
        (
        {
