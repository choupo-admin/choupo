/*--------------------------------*- Choupo -*--------------------------------*\
  constant/archiveDatasets -- WHERE the measurements of ethylButanoate-nHeptane
  come from, and how to regenerate them.  NO MEASURED POINT IS IN THIS TREE
  (Vitor, 2026-11-10: the measured series are not copied; only the fitted
  parameters are kept).  `bin/choupo-curate fetch <case>` writes each
  dataset into constant/archiveExtracts/ (gitignored): the article file is taken from
  the local ThermoML cache when it holds it, else from the NIST URL below,
  and BOTH sha256 sums are checked -- a mismatch refuses, an unreachable
  NIST is reported NOT RUN, never a pass.
\*-----------------------------------------------------------------------------*/

recordType    archiveDatasets;

archive
{
    tarball   "ThermoML.v2020-09-30.tgz";
    doi       "10.18434/mds2-2422";
    note      "the finding aid; each article file is also served one by one at the NIST URL";
}

datasets
(
    {
        file          "constant/archiveExtracts/ethylButanoate-nHeptane-bubble-je300799f.dat";
        role          fit;   // C283: every laboratory is fitted
        doi           "10.1021/je300799f";
        url           "https://trc.nist.gov/ThermoML/10.1021/je300799f.xml";
        page          "https://trc.nist.gov/ThermoML/10.1021/je300799f.json";
        articleFile   "je300799f.xml";
        articleSha256 "2b9f12af8b997bb1fff5760f52cf3597321cffbf8f72a5c44165755f4179be91";
        block         18;
        filter        ( --interior-only );
        extract       "bin/choupo-thermoml extract-vle <article file> --block 18 --interior-only --into <dir>";
        sha256        "ddf2949ffef9318670be286b43f1c4bbb8856633d88c17cdd58dc3fc608a7330";
        identity
        {
            ethylButanoate { cas "105-54-4"; inchiKey "OBNCKNCVKJNDBV-UHFFFAOYSA-N"; }
            nHeptane       { cas "142-82-5"; inchiKey "IMNFDUFMRHMDMM-UHFFFAOYSA-N"; }
        }
    }
);
