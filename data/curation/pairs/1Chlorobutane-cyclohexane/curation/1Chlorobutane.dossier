            sha256    "294793403436783975100d8eaea9083144484e525d73d8310f0c45881e55d4a5";
            provenance measured;
            archiveFile "j.fluid.2006.02.009.xml";
            system    "1Chlorobutane + cyclohexane";
        }
        );

        domain
        {
            coordinate  x1;
            fit         { min 0.049; max 0.9526; n 45; }
        }
    }

    metrics
    {
