        equilibrium.liquid.activityModel.binaryParameters.1Chlorobutane-cyclohexane.b_ij  -61.7309873936;
        equilibrium.liquid.activityModel.binaryParameters.1Chlorobutane-cyclohexane.b_ji  189.555549024;
    }

    evidence
    {
        partitionFingerprint  "5db658a09725a598";   // frozen before the fit

