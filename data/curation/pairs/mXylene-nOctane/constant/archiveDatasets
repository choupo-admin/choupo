/*--------------------------------*- Choupo -*--------------------------------*\
  constant/archiveDatasets -- WHERE the measurements of mXylene-nOctane
  come from, and how to regenerate them.  NO MEASURED POINT IS IN THIS TREE
  (Vitor, 2026-11-10: the measured series are not copied; only the fitted
  parameters are kept).  `bin/choupo-curate fetch <case>` writes each
  dataset into constant/archiveExtracts/ (gitignored): the article file is taken from
  the local ThermoML cache when it holds it, else from the NIST URL below,
  and BOTH sha256 sums are checked -- a mismatch refuses, an unreachable
  NIST is reported NOT RUN, never a pass.
\*-----------------------------------------------------------------------------*/

recordType    archiveDatasets;

archive
{
    tarball   "ThermoML.v2020-09-30.tgz";
    doi       "10.18434/mds2-2422";
    note      "the finding aid; each article file is also served one by one at the NIST URL";
}

datasets
(
    {
        file          "constant/archiveExtracts/nOctane-mXylene-bubble-j.fluid.2013.01.015.dat";
        role          fit;   // C283: every laboratory is fitted
        doi           "10.1016/j.fluid.2013.01.015";
        url           "https://trc.nist.gov/ThermoML/10.1016/j.fluid.2013.01.015.xml";
        page          "https://trc.nist.gov/ThermoML/10.1016/j.fluid.2013.01.015.json";
        articleFile   "j.fluid.2013.01.015.xml";
        articleSha256 "ea4a823b5e6d896b5e973eb5b31e45cd12636e65619bce99573a67b1b68fa599";
        block         13;
        filter        ( --interior-only );
        extract       "bin/choupo-thermoml extract-vle <article file> --block 13 --interior-only --into <dir>";
        sha256        "869c6ed8d9c624628d205b4169619cc2069466be081139071237799fb0b51694";
        identity
        {
            nOctane        { cas "111-65-9"; inchiKey "TVMXDCGIABBOFY-UHFFFAOYSA-N"; }
            mXylene        { cas "108-38-3"; inchiKey "IVSZLXZYQVIEFR-UHFFFAOYSA-N"; }
        }
    }
    {
        file          "constant/archiveExtracts/nOctane-mXylene-bubble-je3002283.dat";
        role          fit;   // C283: every laboratory is fitted
        doi           "10.1021/je3002283";
        url           "https://trc.nist.gov/ThermoML/10.1021/je3002283.xml";
        page          "https://trc.nist.gov/ThermoML/10.1021/je3002283.json";
        articleFile   "je3002283.xml";
