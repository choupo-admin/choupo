        block         14;
        filter        ( --interior-only );
        extract       "bin/choupo-thermoml extract-vle <article file> --block 14 --interior-only --into <dir>";
        sha256        "45eb8750d6865c8a86c6694b8f7e2f9f64fdece4ddbda07d0fab55b5f5565c8f";
        identity
        {
            nOctane        { cas "111-65-9"; inchiKey "TVMXDCGIABBOFY-UHFFFAOYSA-N"; }
