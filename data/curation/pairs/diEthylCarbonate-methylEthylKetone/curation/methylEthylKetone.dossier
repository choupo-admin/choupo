    refusal        "No independent experimental evidence remains after fitting.";

    fittedParameters
    {
        equilibrium.liquid.activityModel.binaryParameters.methylEthylKetone-diEthylCarbonate.b_ij  -365.107156491;
        equilibrium.liquid.activityModel.binaryParameters.methylEthylKetone-diEthylCarbonate.b_ji  548.057139484;
    }

    evidence
    {
        partitionFingerprint  "6b77a17dd61a05a3";   // frozen before the fit

        datasets
        (
        {
            role      fit;
            dataset   "constant/archiveExtracts/methylEthylKetone-diEthylCarbonate-bubble-j.fluid.2005.06.024.dat";
            doi       "10.1016/j.fluid.2005.06.024";
            sha256    "422d54687a6c94980e1987583edc0e1cd6169261060333e26cf2866dc9c0091d";
            provenance measured;
            archiveFile "j.fluid.2005.06.024.xml";
            system    "methylEthylKetone + diEthylCarbonate";
            pressure  "101325.000000 Pa";
        }
        );

        domain
        {
            coordinate  x1;
            fit         { min 0.0259; max 0.9688; n 29; }
        }
    }

    metrics
    {
        //  r2InSample: not computed by this operation (it reports chi-square).
        //  NO HELD-OUT METRIC EXISTS.  r2InSample above is exactly that --
        //  in-sample -- and must not be read as an external check.
    }
}

{
