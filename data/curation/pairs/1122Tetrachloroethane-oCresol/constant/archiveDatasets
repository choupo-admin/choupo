/*--------------------------------*- Choupo -*--------------------------------*\
  constant/archiveDatasets -- WHERE the measurements of 1122Tetrachloroethane-oCresol
  come from, and how to regenerate them.  NO MEASURED POINT IS IN THIS TREE
  (Vitor, 2026-11-10: the measured series are not copied; only the fitted
  parameters are kept).  `bin/choupo-curate fetch <case>` writes each
  dataset into constant/archiveExtracts/ (gitignored): the article file is taken from
  the local ThermoML cache when it holds it, else from the NIST URL below,
  and BOTH sha256 sums are checked -- a mismatch refuses, an unreachable
  NIST is reported NOT RUN, never a pass.
\*-----------------------------------------------------------------------------*/

recordType    archiveDatasets;

archive
{
    tarball   "ThermoML.v2020-09-30.tgz";
    doi       "10.18434/mds2-2422";
    note      "the finding aid; each article file is also served one by one at the NIST URL";
}

datasets
(
    {
        file          "constant/archiveExtracts/1122Tetrachloroethane-oCresol-bubble-j.fluid.2005.09.012.dat";
        role          fit;   // C283: every laboratory is fitted
        doi           "10.1016/j.fluid.2005.09.012";
        url           "https://trc.nist.gov/ThermoML/10.1016/j.fluid.2005.09.012.xml";
        page          "https://trc.nist.gov/ThermoML/10.1016/j.fluid.2005.09.012.json";
        articleFile   "j.fluid.2005.09.012.xml";
        articleSha256 "8d576b09c152731f488ef5ca477c825da08189f3bd20efec499def20bf5e6d77";
        block         31;
        filter        ( --interior-only );
        extract       "bin/choupo-thermoml extract-vle <article file> --block 31 --interior-only --into <dir>";
        sha256        "96392c87f6c110c4d864bf2be38af12f697501fa79da6527da86d899462e5640";
        identity
        {
            1122Tetrachloroethane { cas "79-34-5"; inchiKey "QPFMBZIOSGYJDE-UHFFFAOYSA-N"; }
            oCresol        { cas "95-48-7"; inchiKey "QWVGKYWNOKOFNN-UHFFFAOYSA-N"; }
        }
    }
);
