name        1122Tetrachloroethane;
CAS         79-34-5;
formula     C2H2Cl4;
reviewStatus autoPromoted;
review      { by none; }   // DEV.md 4c C300 rule 4 (C297): nobody has reviewed it
MW          167.8380;      // kg/kmol, from the formula (IUPAC standard atomic weights)
Tc          605.914388;      // K, Joback ESTIMATE (provenance.Tc)
Pc          42.0563185;      // bar, Joback ESTIMATE (provenance.Pc)
omega       0.565214;      // [-] (provenance.omega)
Tb          419.35;      // K, measured (provenance.Tb)

standardThermochemistry
{
    dHf_298   -158130;        // J/mol, ideal gas, Joback ESTIMATE (provenance.dHf_298)
    s_298     348.54;        // J/(mol K), ideal gas, DERIVED from Joback (provenance.s_298)
}

vaporPressure
{
    model         Antoine;
    // log10(Psat [bar]) = A - B / (T[K] + C), FITTED by bin/choupo-curate vp to
    // measured vapour pressures -- see provenance.vaporPressure
    coefficients  (4.239650499  1525.764486  -59.21475272);
    Trange        (283.15  418.95);   // the fit's own span; outside it the engine announces the extrapolation
}

Vliq        1.056732e-04;      // m3/mol at 25 C, FITTED (provenance.Vliq)

idealGasHeatCapacity
{
    model         polynomial;
    // Cp [J/(mol K)] = a0 + a1 T + a2 T^2 + a3 T^3, Joback ESTIMATE
    coefficients  (49.27  0.2328  -1.730000e-04  4.760000e-08);
    Trange        (273  1000);
}

liquidHeatCapacity
{
    model         polynomial;
    // Cp [J/(mol K)] = a0 + a1 T + a2 T^2, Rowlinson-Bondi ESTIMATE (provenance.liquidHeatCapacity)
    coefficients  (252.5953394  -0.337890885  0.000518261485);
    Trange        (283.15  418.95);
}

