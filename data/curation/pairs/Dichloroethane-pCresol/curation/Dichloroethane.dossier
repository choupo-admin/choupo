        equilibrium.liquid.activityModel.binaryParameters.Dichloroethane-pCresol.b_ij  4.36762504466;
        equilibrium.liquid.activityModel.binaryParameters.Dichloroethane-pCresol.b_ji  -60.0670596573;
    }

    evidence
    {
