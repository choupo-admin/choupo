/*--------------------------------*- Choupo -*--------------------------------*\
  constant/archiveDatasets -- WHERE the measurements of 2Butanol-nHexane
  come from, and how to regenerate them.  NO MEASURED POINT IS IN THIS TREE
  (Vitor, 2026-11-10: the measured series are not copied; only the fitted
  parameters are kept).  `bin/choupo-curate fetch <case>` writes each
  dataset into constant/archiveExtracts/ (gitignored): the article file is taken from
  the local ThermoML cache when it holds it, else from the NIST URL below,
  and BOTH sha256 sums are checked -- a mismatch refuses, an unreachable
  NIST is reported NOT RUN, never a pass.  The extractor is `extract-px`
  (a bubble-PRESSURE block at a stated temperature, DEV.md 4c C291).
\*-----------------------------------------------------------------------------*/

recordType    archiveDatasets;

archive
{
    tarball   "ThermoML.v2020-09-30.tgz";
    doi       "10.18434/mds2-2422";
    note      "the finding aid; each article file is also served one by one at the NIST URL";
}

datasets
(
    {
        file          "constant/archiveExtracts/nHexane-2Butanol-bubbleP-acs.jced.9b00102-b15.dat";
        role          fit;   // C283: every laboratory is fitted
        doi           "10.1021/acs.jced.9b00102";
        url           "https://trc.nist.gov/ThermoML/10.1021/acs.jced.9b00102.xml";
        page          "https://trc.nist.gov/ThermoML/10.1021/acs.jced.9b00102.json";
        articleFile   "acs.jced.9b00102.xml";
        articleSha256 "487db9b9cafb1b083818b96a38d6740ad07d81e1e79f1365575fa2907f10f157";
        block         15;
        extractor     bubblePressure;
        extract       "bin/choupo-thermoml extract-px <article file> --block 15 --into <dir>";
        sha256        "ce08d33083c3778d132caa29e25215771dfa993fc988e93f4363e89977469c71";
        identity
        {
            nHexane        { cas "110-54-3"; inchiKey "VLKZOEOYAKHREP-UHFFFAOYSA-N"; }
            2Butanol       { cas "78-92-2"; inchiKey "BTANRVKWQNVYAZ-UHFFFAOYSA-N"; }
        }
    }
    {
        file          "constant/archiveExtracts/nHexane-2Butanol-bubbleP-j.fluid.2011.08.009-b6.dat";
        role          fit;   // C283: every laboratory is fitted
        doi           "10.1016/j.fluid.2011.08.009";
        url           "https://trc.nist.gov/ThermoML/10.1016/j.fluid.2011.08.009.xml";
        page          "https://trc.nist.gov/ThermoML/10.1016/j.fluid.2011.08.009.json";
        articleFile   "j.fluid.2011.08.009.xml";
        articleSha256 "22f5851c0d467d9f2c31bf010aa1b3e6352d65d7f37f2814a7cff0135b55a3ef";
        block         6;
        extractor     bubblePressure;
        xOf           nHexane;   // the article reports the other member; x = 1 - x'
        extract       "bin/choupo-thermoml extract-px <article file> --block 6 --x-of nHexane --into <dir>";
        sha256        "93c3961100892296b51f228d10b14ed68efaf9cbea7156a68484fc548679caa1";
        identity
        {
            nHexane        { cas "110-54-3"; inchiKey "VLKZOEOYAKHREP-UHFFFAOYSA-N"; }
            2Butanol       { cas "78-92-2"; inchiKey "BTANRVKWQNVYAZ-UHFFFAOYSA-N"; }
        }
    }
);
