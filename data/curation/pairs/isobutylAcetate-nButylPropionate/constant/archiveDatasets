        articleSha256 "7c88936a12308a0cff09556562a3e040c3e808b37d91fe1a96692b16fbc613da";
        block         11;
        filter        ( --interior-only );
        extract       "bin/choupo-thermoml extract-vle <article file> --block 11 --interior-only --into <dir>";
        sha256        "dacb1e579211d00bc64c593d588dd26f345d01af2fbffff37e7161a07ecc8097";
        identity
        {
            isobutylAcetate { cas "110-19-0"; inchiKey "GJRQTCIYDGXPES-UHFFFAOYSA-N"; }
