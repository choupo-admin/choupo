(
    {
        file          "constant/archiveExtracts/isobutylAcetate-nButylPropionate-bubble-j.fluid.2005.09.015.dat";
        role          fit;   // C283: every laboratory is fitted
        doi           "10.1016/j.fluid.2005.09.015";
        url           "https://trc.nist.gov/ThermoML/10.1016/j.fluid.2005.09.015.xml";
        page          "https://trc.nist.gov/ThermoML/10.1016/j.fluid.2005.09.015.json";
