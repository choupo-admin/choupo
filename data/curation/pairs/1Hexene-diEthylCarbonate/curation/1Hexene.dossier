    refusal        "No independent experimental evidence remains after fitting.";

    fittedParameters
    {
        equilibrium.liquid.activityModel.binaryParameters.1Hexene-diEthylCarbonate.b_ij  262.154797758;
        equilibrium.liquid.activityModel.binaryParameters.1Hexene-diEthylCarbonate.b_ji  -34.270277645;
    }

    evidence
    {
        partitionFingerprint  "6a95f012b036d13b";   // frozen before the fit

        datasets
        (
        {
            role      fit;
            dataset   "constant/archiveExtracts/1Hexene-diEthylCarbonate-bubble-acs.jced.6b00905.dat";
            doi       "10.1021/acs.jced.6b00905";
            sha256    "6f775772f346c715de261147f232e1d104af55efb2da8e13f2766cbd03babb23";
            provenance measured;
            archiveFile "acs.jced.6b00905.xml";
            system    "1Hexene + diEthylCarbonate";
            pressure  "100000.000000 Pa";
        }
        );

        domain
        {
            coordinate  x1;
            fit         { min 0.022; max 0.979; n 21; }
        }
    }

    metrics
    {
        //  r2InSample: not computed by this operation (it reports chi-square).
