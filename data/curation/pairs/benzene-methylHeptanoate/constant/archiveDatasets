/*--------------------------------*- Choupo -*--------------------------------*\
  constant/archiveDatasets -- WHERE the measurements of benzene-methylHeptanoate
  come from, and how to regenerate them.  NO MEASURED POINT IS IN THIS TREE
  (Vitor, 2026-11-10: the measured series are not copied; only the fitted
  parameters are kept).  `bin/choupo-curate fetch <case>` writes each
  dataset into constant/archiveExtracts/ (gitignored): the article file is taken from
  the local ThermoML cache when it holds it, else from the NIST URL below,
  and BOTH sha256 sums are checked -- a mismatch refuses, an unreachable
  NIST is reported NOT RUN, never a pass.
\*-----------------------------------------------------------------------------*/

recordType    archiveDatasets;

archive
{
    tarball   "ThermoML.v2020-09-30.tgz";
    doi       "10.18434/mds2-2422";
    note      "the finding aid; each article file is also served one by one at the NIST URL";
}

datasets
(
    {
        file          "constant/archiveExtracts/benzene-methylHeptanoate-bubble-je800915d.dat";
        role          fit;   // C283: every laboratory is fitted
        doi           "10.1021/je800915d";
        url           "https://trc.nist.gov/ThermoML/10.1021/je800915d.xml";
        page          "https://trc.nist.gov/ThermoML/10.1021/je800915d.json";
        articleFile   "je800915d.xml";
        articleSha256 "201b89a6ab7adecfd45e74868b6f7770c8f84d31cc174c0c41d44be657e19d69";
        block         19;
        filter        ( --interior-only );
        extract       "bin/choupo-thermoml extract-vle <article file> --block 19 --interior-only --into <dir>";
        sha256        "dfd3af8d28d8bb0246d203550f2e8478287d8a27633e5e65c8ed9582836aac95";
        identity
        {
            benzene        { cas "71-43-2"; inchiKey "UHOVQNZJYSORNB-UHFFFAOYSA-N"; }
            methylHeptanoate { cas "106-73-0"; inchiKey "XNCNNDVCAUWAIT-UHFFFAOYSA-N"; }
        }
    }
);
