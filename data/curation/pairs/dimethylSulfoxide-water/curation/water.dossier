        equilibrium.liquid.activityModel.binaryParameters.water-dimethylSulfoxide.b_ij  -7.65623581529;
        equilibrium.liquid.activityModel.binaryParameters.water-dimethylSulfoxide.b_ji  -321.269655101;
    }

    evidence
