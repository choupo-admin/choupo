            components  ( 1Octanol nDodecane );
            weighting   uncertainty;
        }

        options
        {
            maxIter      80;
            tolerance    1.0e-6;
            fdStep       1.0e-4;
            lambda0      1.0e-3;
        }

        output
        {
            parity     parity_start2.csv;
        }
    }
    {
        name        txy_ideal;
        type        propertyScan1D;
        vary        { variable x[1Octanol];  from 0.0;  to 1.0;  n 101; }
        state       { P 40 kPa;  composition { 1Octanol 0.5;  nDodecane 0.5; } }
        thermo
        {
            equilibrium { liquid { activityModel { model ideal; } } }
        }
        properties  ( T_bubble  y_eq_1Octanol );
        output      { file txy_ideal.csv; }
    }
    {
        name        txy_nrtl;
        type        propertyScan1D;
        vary        { variable x[1Octanol];  from 0.0;  to 1.0;  n 101; }
        state       { P 40 kPa;  composition { 1Octanol 0.5;  nDodecane 0.5; } }
        thermo
        {
            equilibrium { liquid { activityModel { model NRTL; /* no inline pair: the case's own record */ } } }
        }
        properties  ( T_bubble  y_eq_1Octanol );
        output      { file txy_nrtl.csv; }
    }
    // @@C294-OPS-BEGIN@@ -- UNIQUAC and Wilson on the NRTL fit's own evidence (DEV.md 4c C294)
    {
        name        fit_uniquac;
        type        fitParameters;

        parameters
        (
            { path  equilibrium.liquid.activityModel.binaryParameters.1Octanol-nDodecane.a_ij;  initial 0;  min -3000;  max 3000; }
            { path  equilibrium.liquid.activityModel.binaryParameters.1Octanol-nDodecane.a_ji;  initial 0;  min -3000;  max 3000; }
        );

        thermo   // the model, as a fragment of the case's system (C294)
        {
