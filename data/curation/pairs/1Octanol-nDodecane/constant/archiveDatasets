/*--------------------------------*- Choupo -*--------------------------------*\
  constant/archiveDatasets -- WHERE the measurements of 1Octanol-nDodecane
  come from, and how to regenerate them.  NO MEASURED POINT IS IN THIS TREE
  (Vitor, 2026-11-10: the measured series are not copied; only the fitted
  parameters are kept).  `bin/choupo-curate fetch <case>` writes each
  dataset into constant/archiveExtracts/ (gitignored): the article file is taken from
  the local ThermoML cache when it holds it, else from the NIST URL below,
  and BOTH sha256 sums are checked -- a mismatch refuses, an unreachable
  NIST is reported NOT RUN, never a pass.
\*-----------------------------------------------------------------------------*/

recordType    archiveDatasets;

archive
{
    tarball   "ThermoML.v2020-09-30.tgz";
    doi       "10.18434/mds2-2422";
    note      "the finding aid; each article file is also served one by one at the NIST URL";
}

datasets
(
    {
        file          "constant/archiveExtracts/1Octanol-nDodecane-bubble-acs.jced.8b00680.dat";
        role          fit;   // C283: every laboratory is fitted
        doi           "10.1021/acs.jced.8b00680";
        url           "https://trc.nist.gov/ThermoML/10.1021/acs.jced.8b00680.xml";
        page          "https://trc.nist.gov/ThermoML/10.1021/acs.jced.8b00680.json";
        articleFile   "acs.jced.8b00680.xml";
        articleSha256 "24e5d0a547f0ece199cef88e38a33059d446a79066ec16e532dde61242113b94";
        block         20;
        filter        ( --interior-only );
        extract       "bin/choupo-thermoml extract-vle <article file> --block 20 --interior-only --into <dir>";
        sha256        "48e50db9f6e69823f3a6271cd7e7c055cbea477604a936e9074a1f892aa81428";
        identity
        {
            1Octanol       { cas "111-87-5"; inchiKey "KBPLFHHGFOOTCA-UHFFFAOYSA-N"; }
            nDodecane      { cas "112-40-3"; inchiKey "SNRUBQQJIBEYMU-UHFFFAOYSA-N"; }
        }
    }
);
