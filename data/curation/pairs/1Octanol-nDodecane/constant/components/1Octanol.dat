uniquac
{
    r   6.6219;
    q   5.8280;
}

groups
{
    unifac ( { group CH3; count 1; } { group CH2; count 7; } { group OH; count 1; } );
    joback ( { group CH3; count 1; } { group CH2; count 7; } { group OH; count 1; } );
}

