name        1Octanol;
CAS         111-87-5;
formula     C8H18O;
reviewStatus autoPromoted;
humanReviewed false;
MW          130.2310;      // kg/kmol, from the formula (IUPAC standard atomic weights)
Tc          634.648434;      // K, Joback ESTIMATE (provenance.Tc)
Pc          27.8766159;      // bar, Joback ESTIMATE (provenance.Pc)
omega       0.769443;      // [-] (provenance.omega)
//  Tb: NOT DECLARED -- the archive reports no boiling temperature at
//  101.3 kPa for it, and a Tb read back off the fitted Antoine would be
//  the curve tested against itself (the fitted normal boiling point is
//  in provenance.vaporPressure.acceptance.Tnb_fit).  Joback's Tb is NOT stored either: the vapour-pressure
//  grade would read an estimate as a measurement (WRITE_ESTIMATED_TB in
//  the tool); the case data/curation/batches/new_components_estimated prints it.

standardThermochemistry
{
    dHf_298   -360680;        // J/mol, ideal gas, Joback ESTIMATE (provenance.dHf_298)
    s_298     518.51;        // J/(mol K), ideal gas, DERIVED from Joback (provenance.s_298)
}

vaporPressure
{
    model         Antoine;
    // log10(Psat [bar]) = A - B / (T[K] + C), FITTED by bin/choupo-curate vp to
    // measured vapour pressures -- see provenance.vaporPressure
    coefficients  (4.00937961  1350.831959  -132.5414178);
    Trange        (298.15  468.47);   // the fit's own span; outside it the engine announces the extrapolation
}

Vliq        1.576533e-04;      // m3/mol at 25 C, FITTED (provenance.Vliq)

idealGasHeatCapacity
{
    model         polynomial;
    // Cp [J/(mol K)] = a0 + a1 T + a2 T^2 + a3 T^3, Joback ESTIMATE
    coefficients  (0.907  0.79782  -4.418000e-04  9.380000e-08);
    Trange        (273  1000);
}

liquidHeatCapacity
{
    model         polynomial;
    // Cp [J/(mol K)] = a0 + a1 T + a2 T^2, FITTED (provenance.liquidHeatCapacity)
    coefficients  (-2361.343213  16.26106806  -0.02431188435);
    Trange        (288.15  333.15);
}

