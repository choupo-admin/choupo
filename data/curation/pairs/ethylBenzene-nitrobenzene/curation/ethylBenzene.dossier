        equilibrium.liquid.activityModel.binaryParameters.ethylBenzene-nitrobenzene.b_ij  192.387181971;
        equilibrium.liquid.activityModel.binaryParameters.ethylBenzene-nitrobenzene.b_ji  -187.181393546;
    }

    evidence
