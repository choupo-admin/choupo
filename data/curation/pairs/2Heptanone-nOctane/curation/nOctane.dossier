        equilibrium.liquid.activityModel.binaryParameters.nOctane-2Heptanone.b_ij  -32.731387575;
        equilibrium.liquid.activityModel.binaryParameters.nOctane-2Heptanone.b_ji  416.551024144;
    }

    evidence
    {
        partitionFingerprint  "21c239252695093b";   // frozen before the fit

