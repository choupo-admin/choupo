/*--------------------------------*- Choupo -*--------------------------------*\
  constant/archiveDatasets -- WHERE the measurements of acetonitrile-isopropanol
  come from, and how to regenerate them.  NO MEASURED POINT IS IN THIS TREE
  (Vitor, 2026-11-10: the measured series are not copied; only the fitted
  parameters are kept).  `bin/choupo-curate fetch <case>` writes each
  dataset into constant/archiveExtracts/ (gitignored): the article file is taken from
  the local ThermoML cache when it holds it, else from the NIST URL below,
  and BOTH sha256 sums are checked -- a mismatch refuses, an unreachable
  NIST is reported NOT RUN, never a pass.
\*-----------------------------------------------------------------------------*/

recordType    archiveDatasets;

archive
{
    tarball   "ThermoML.v2020-09-30.tgz";
    doi       "10.18434/mds2-2422";
    note      "the finding aid; each article file is also served one by one at the NIST URL";
}

datasets
(
    {
        file          "constant/archiveExtracts/acetonitrile-isopropanol-bubble-j.jct.2007.03.007.dat";
        role          fit;   // C283: every laboratory is fitted
        doi           "10.1016/j.jct.2007.03.007";
        url           "https://trc.nist.gov/ThermoML/10.1016/j.jct.2007.03.007.xml";
        page          "https://trc.nist.gov/ThermoML/10.1016/j.jct.2007.03.007.json";
        articleFile   "j.jct.2007.03.007.xml";
        articleSha256 "1e51e148a411dd6d0f92e2bdb90371ad41472fab6ab57c1c895e50f71d8517c5";
        block         24;
        filter        ( --interior-only );
        extract       "bin/choupo-thermoml extract-vle <article file> --block 24 --interior-only --into <dir>";
        sha256        "ccebc9a3e930f5d1798742e3fd7ba049dbc0fa8996f2bfe1848c98c8f7e90bfc";
        identity
        {
            acetonitrile   { cas "75-05-8"; inchiKey "WEVYAHXRMPXWCK-UHFFFAOYSA-N"; }
            isopropanol    { cas "67-63-0"; inchiKey "KFZMGEQAYNKOFK-UHFFFAOYSA-N"; }
        }
    }
    {
        file          "constant/archiveExtracts/acetonitrile-isopropanol-bubble-j.fluid.2015.10.035.dat";
        role          fit;   // C283: every laboratory is fitted
        doi           "10.1016/j.fluid.2015.10.035";
        url           "https://trc.nist.gov/ThermoML/10.1016/j.fluid.2015.10.035.xml";
        page          "https://trc.nist.gov/ThermoML/10.1016/j.fluid.2015.10.035.json";
        articleFile   "j.fluid.2015.10.035.xml";
        articleSha256 "5617d2a65b872b8e2bd91b07ea48975117a45969d783db1032ea446760f93d6b";
        block         6;
        filter        ( --interior-only );
        xOf           acetonitrile;   // the article reports the other member; x = 1 - x'
        extract       "bin/choupo-thermoml extract-vle <article file> --block 6 --interior-only --x-of acetonitrile --into <dir>";
        sha256        "a99955d449a37023f990ea6dc2549a0f86a1958059192765baa3ff94978d3bd0";
        identity
        {
            acetonitrile   { cas "75-05-8"; inchiKey "WEVYAHXRMPXWCK-UHFFFAOYSA-N"; }
            isopropanol    { cas "67-63-0"; inchiKey "KFZMGEQAYNKOFK-UHFFFAOYSA-N"; }
        }
    }
);
