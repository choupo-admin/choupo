    fittedParameters
    {
        equilibrium.liquid.activityModel.binaryParameters.methylAcetate-nHeptane.b_ij  515.977672002;
        equilibrium.liquid.activityModel.binaryParameters.methylAcetate-nHeptane.b_ji  -14.6093315323;
    }

    evidence
    {
        partitionFingerprint  "3e219d550c00b858";   // frozen before the fit

        datasets
        (
        {
            role      fit;
            dataset   "constant/archiveExtracts/methylAcetate-nHeptane-bubble-je030117d.dat";
