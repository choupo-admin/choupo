/*--------------------------------*- Choupo -*--------------------------------*\
  constant/archiveDatasets -- WHERE the measurements of 224Trimethylpentane-diethylDisulfide
  come from, and how to regenerate them.  NO MEASURED POINT IS IN THIS TREE
  (Vitor, 2026-11-10: the measured series are not copied; only the fitted
  parameters are kept).  `bin/choupo-curate fetch <case>` writes each
  dataset into constant/archiveExtracts/ (gitignored): the article file is taken from
  the local ThermoML cache when it holds it, else from the NIST URL below,
  and BOTH sha256 sums are checked -- a mismatch refuses, an unreachable
  NIST is reported NOT RUN, never a pass.  The extractor is `extract-px`
  (a bubble-PRESSURE block at a stated temperature, DEV.md 4c C291).
\*-----------------------------------------------------------------------------*/

recordType    archiveDatasets;

archive
{
    tarball   "ThermoML.v2020-09-30.tgz";
    doi       "10.18434/mds2-2422";
    note      "the finding aid; each article file is also served one by one at the NIST URL";
}

datasets
(
    {
        file          "constant/archiveExtracts/diethylDisulfide-224Trimethylpentane-bubbleP-j.fluid.2010.02.043-b14.dat";
        role          fit;   // C283: every laboratory is fitted
        doi           "10.1016/j.fluid.2010.02.043";
        url           "https://trc.nist.gov/ThermoML/10.1016/j.fluid.2010.02.043.xml";
        page          "https://trc.nist.gov/ThermoML/10.1016/j.fluid.2010.02.043.json";
        articleFile   "j.fluid.2010.02.043.xml";
        articleSha256 "5be56e39820f0cc4910d3dcbfcdb5e4a54f65227a1dbd768d2229cc9a5768918";
        block         14;
        extractor     bubblePressure;
        extract       "bin/choupo-thermoml extract-px <article file> --block 14 --into <dir>";
        sha256        "43a5ce13794159835350b471b7daef185f6f7cd11475f8595caac1ffc8cfcebf";
        identity
        {
            diethylDisulfide { cas "110-81-6"; inchiKey "CETBSQOFQKLHHZ-UHFFFAOYSA-N"; }
            224Trimethylpentane { cas "540-84-1"; inchiKey "NHTMVDHEPJAVLT-UHFFFAOYSA-N"; }
        }
    }
);
