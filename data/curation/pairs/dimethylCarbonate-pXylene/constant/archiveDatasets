/*--------------------------------*- Choupo -*--------------------------------*\
  constant/archiveDatasets -- WHERE the measurements of dimethylCarbonate-pXylene
  come from, and how to regenerate them.  NO MEASURED POINT IS IN THIS TREE
  (Vitor, 2026-11-10: the measured series are not copied; only the fitted
  parameters are kept).  `bin/choupo-curate fetch <case>` writes each
  dataset into constant/archiveExtracts/ (gitignored): the article file is taken from
  the local ThermoML cache when it holds it, else from the NIST URL below,
  and BOTH sha256 sums are checked -- a mismatch refuses, an unreachable
  NIST is reported NOT RUN, never a pass.
\*-----------------------------------------------------------------------------*/

recordType    archiveDatasets;

archive
{
    tarball   "ThermoML.v2020-09-30.tgz";
    doi       "10.18434/mds2-2422";
    note      "the finding aid; each article file is also served one by one at the NIST URL";
}

datasets
(
    {
        file          "constant/archiveExtracts/dimethylCarbonate-pXylene-bubble-j.jct.2019.01.027.dat";
        role          fit;   // C283: every laboratory is fitted
        doi           "10.1016/j.jct.2019.01.027";
        url           "https://trc.nist.gov/ThermoML/10.1016/j.jct.2019.01.027.xml";
        page          "https://trc.nist.gov/ThermoML/10.1016/j.jct.2019.01.027.json";
        articleFile   "j.jct.2019.01.027.xml";
        articleSha256 "b483671263a2fbe218a2721e05d40244c97b9d191d1fcbd6def03d55233c3bc7";
        block         5;
        filter        ( --interior-only );
        extract       "bin/choupo-thermoml extract-vle <article file> --block 5 --interior-only --into <dir>";
        sha256        "a78fb076acd0b038772ff318861673f78555f9802a4124167af8cc8bb2e1079e";
        identity
        {
            dimethylCarbonate { cas "616-38-6"; inchiKey "IEJIGPNLZYLLBP-UHFFFAOYSA-N"; }
            pXylene        { cas "106-42-3"; inchiKey "URLKBWYHVLBVBO-UHFFFAOYSA-N"; }
        }
    }
    {
        file          "constant/archiveExtracts/dimethylCarbonate-pXylene-bubble-acs.jced.7b00372.dat";
        role          fit;   // C283: every laboratory is fitted
        doi           "10.1021/acs.jced.7b00372";
        url           "https://trc.nist.gov/ThermoML/10.1021/acs.jced.7b00372.xml";
        page          "https://trc.nist.gov/ThermoML/10.1021/acs.jced.7b00372.json";
        articleFile   "acs.jced.7b00372.xml";
        articleSha256 "d7db373526dce14490ebc7cd7c42f771c4b2aae1013b5b3e8a930cd4d5a5a0a5";
        block         15;
        filter        ( --interior-only );
        xOf           dimethylCarbonate;   // the article reports the other member; x = 1 - x'
        extract       "bin/choupo-thermoml extract-vle <article file> --block 15 --interior-only --x-of dimethylCarbonate --into <dir>";
        sha256        "35779c76318069f4092767a1ffaedb3d2441cd5c688b295a000921391acb79bf";
        identity
        {
            dimethylCarbonate { cas "616-38-6"; inchiKey "IEJIGPNLZYLLBP-UHFFFAOYSA-N"; }
            pXylene        { cas "106-42-3"; inchiKey "URLKBWYHVLBVBO-UHFFFAOYSA-N"; }
        }
    }
);
