        equilibrium.liquid.activityModel.binaryParameters.tetrahydropyran-1Propanol.b_ij  196.013870761;
        equilibrium.liquid.activityModel.binaryParameters.tetrahydropyran-1Propanol.b_ji  -18.2993516135;
    }

    evidence
    {
        partitionFingerprint  "0090c39b2b39dac5";   // frozen before the fit

