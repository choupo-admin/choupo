            provenance measured;
            archiveFile "je800145h.xml";
            system    "tetrahydropyran + 1Propanol";
        }
        );

        domain
        {
            coordinate  x1;
            fit         { min 0.0969; max 0.95; n 66; }
        }
    }

    metrics
    {
