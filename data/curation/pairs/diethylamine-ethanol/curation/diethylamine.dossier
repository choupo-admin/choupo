        equilibrium.liquid.activityModel.binaryParameters.diethylamine-ethanol.b_ij  -280.800935517;
        equilibrium.liquid.activityModel.binaryParameters.diethylamine-ethanol.b_ji  29.4664527841;
    }

    evidence
    {
        partitionFingerprint  "e4f7ce6064b6c7a3";   // frozen before the fit

        datasets
