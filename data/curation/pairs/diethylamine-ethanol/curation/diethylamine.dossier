            provenance measured;
            archiveFile "je4008712.xml";
            system    "diethylamine + ethanol";
        }
        );

        domain
        {
            coordinate  x1;
            fit         { min 0.093; max 0.915; n 22; }
        }
    }

    metrics
    {
        //  r2InSample: not computed by this operation (it reports chi-square).
