/*--------------------------------*- Choupo -*--------------------------------*\
  constant/archiveDatasets -- WHERE the measurements of ethylAcetate-nNonane
  come from, and how to regenerate them.  NO MEASURED POINT IS IN THIS TREE
  (Vitor, 2026-11-10: the measured series are not copied; only the fitted
  parameters are kept).  `bin/choupo-curate fetch <case>` writes each
  dataset into constant/archiveExtracts/ (gitignored): the article file is taken from
  the local ThermoML cache when it holds it, else from the NIST URL below,
  and BOTH sha256 sums are checked -- a mismatch refuses, an unreachable
  NIST is reported NOT RUN, never a pass.
\*-----------------------------------------------------------------------------*/

recordType    archiveDatasets;

archive
{
    tarball   "ThermoML.v2020-09-30.tgz";
    doi       "10.18434/mds2-2422";
    note      "the finding aid; each article file is also served one by one at the NIST URL";
}

datasets
(
    {
        file          "constant/archiveExtracts/ethylAcetate-nNonane-bubble-je100832h.dat";
        role          fit;   // C283: every laboratory is fitted
        doi           "10.1021/je100832h";
        url           "https://trc.nist.gov/ThermoML/10.1021/je100832h.xml";
        page          "https://trc.nist.gov/ThermoML/10.1021/je100832h.json";
        articleFile   "je100832h.xml";
        articleSha256 "31832926e022cafa7293ca700a38facbcc7ceaed1c4ccc0746fbf2ab3d4bf7c3";
        block         34;
        filter        ( --interior-only );
        extract       "bin/choupo-thermoml extract-vle <article file> --block 34 --interior-only --into <dir>";
        sha256        "271663fdb0a9abc4c4b33f0d14763d251f96fb1e4944fee1a83ade0762b50afb";
        identity
        {
            ethylAcetate   { cas "141-78-6"; inchiKey "XEKOWRVHYACXOJ-UHFFFAOYSA-N"; }
            nNonane        { cas "111-84-2"; inchiKey "BKIMMITUMNQMOS-UHFFFAOYSA-N"; }
        }
    }
);
