    refusal        "No independent experimental evidence remains after fitting.";

    fittedParameters
    {
        equilibrium.liquid.activityModel.binaryParameters.furan-ethanol.b_ij  753.658397027;
        equilibrium.liquid.activityModel.binaryParameters.furan-ethanol.b_ji  -55.4589784663;
    }

    evidence
    {
        partitionFingerprint  "7bc54a6cf795d796";   // frozen before the fit

        datasets
        (
        {
            role      fit;
            dataset   "constant/archiveExtracts/furan-ethanol-bubble-j.fluid.2016.09.019.dat";
            doi       "10.1016/j.fluid.2016.09.019";
            sha256    "b0d55a17e8d4c705b3ee99272de3dbee68d39e87d69879e9e02940d98bf07cc1";
            provenance measured;
            archiveFile "j.fluid.2016.09.019.xml";
            system    "furan + ethanol";
            pressure  "101000.000000 Pa";
        }
        );

        domain
        {
            coordinate  x1;
            fit         { min 0.006; max 0.82; n 14; }
        }
    }

    metrics
    {
        //  r2InSample: not computed by this operation (it reports chi-square).
