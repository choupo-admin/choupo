name        allylAlcohol;
CAS         107-18-6;
formula     C3H6O;
reviewStatus autoPromoted;
humanReviewed false;
MW          58.0800;      // kg/kmol, from the formula (IUPAC standard atomic weights)
Tc          547.1;      // K, measured (provenance.Tc)
Pc          56.4;      // bar, measured (provenance.Pc)
omega       0.556577;      // [-] (provenance.omega)
Tb          369.925;      // K, measured (provenance.Tb)

standardThermochemistry
{
    dHf_298   -132050;        // J/mol, ideal gas, Joback ESTIMATE (provenance.dHf_298)
    s_298     319.15;        // J/(mol K), ideal gas, DERIVED from Joback (provenance.s_298)
}

vaporPressure
{
    model         Antoine;
    // log10(Psat [bar]) = A - B / (T[K] + C), FITTED by bin/choupo-curate vp to
    // measured vapour pressures -- see provenance.vaporPressure
    coefficients  (4.704343519  1398.82103  -72.78546934);
    Trange        (311.42  546.5);   // the fit's own span; outside it the engine announces the extrapolation
}

Vliq        6.827069e-05;      // m3/mol at 25 C, FITTED (provenance.Vliq)

idealGasHeatCapacity
{
    model         polynomial;
    // Cp [J/(mol K)] = a0 + a1 T + a2 T^2 + a3 T^3, Joback ESTIMATE
    coefficients  (2.461  0.3028  -1.927000e-04  5.170000e-08);
    Trange        (273  1000);
}

liquidHeatCapacity
{
    model         polynomial;
    // Cp [J/(mol K)] = a0 + a1 T + a2 T^2, FITTED (provenance.liquidHeatCapacity)
    coefficients  (101.6134416  -0.1932720399  0.001152301554);
    Trange        (273.41  324.46);
}

