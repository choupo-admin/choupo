            provenance measured;
            archiveFile "j.fluid.2018.07.013.xml";
            system    "ethanol + nHexane";
            pressure  "101300.000000 Pa";
        }
        );

        domain
        {
            coordinate  x1;
            fit         { min 0.0462; max 0.9987; n 16; }
        }
    }

    metrics
    {
