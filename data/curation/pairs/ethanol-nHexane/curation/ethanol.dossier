    {
        equilibrium.liquid.activityModel.binaryParameters.ethanol-nHexane.b_ij  557.110601842;
        equilibrium.liquid.activityModel.binaryParameters.ethanol-nHexane.b_ji  306.870282693;
    }

    evidence
    {
        partitionFingerprint  "9d6f725b439775c6";   // frozen before the fit

