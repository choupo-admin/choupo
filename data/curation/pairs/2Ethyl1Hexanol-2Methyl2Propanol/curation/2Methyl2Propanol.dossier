        equilibrium.liquid.activityModel.binaryParameters.2Methyl2Propanol-2Ethyl1Hexanol.b_ij  212.591596453;
        equilibrium.liquid.activityModel.binaryParameters.2Methyl2Propanol-2Ethyl1Hexanol.b_ji  426.195681366;
    }

