    refusal        "No independent experimental evidence remains after fitting.";

    fittedParameters
    {
        equilibrium.liquid.activityModel.binaryParameters.dimethylCarbonate-2Pentanone.b_ij  135.782507883;
        equilibrium.liquid.activityModel.binaryParameters.dimethylCarbonate-2Pentanone.b_ji  -35.573231905;
    }

    evidence
    {
        partitionFingerprint  "5e6e5fa3985aadca";   // frozen before the fit

        datasets
        (
        {
            role      fit;
            dataset   "constant/archiveExtracts/dimethylCarbonate-2Pentanone-bubble-je0497000.dat";
            doi       "10.1021/je0497000";
            sha256    "9bab2c80c477552a1d31d1deeac1f03eb6e12e8417b59e3872339cd82d079a9e";
            provenance measured;
            archiveFile "je0497000.xml";
            system    "dimethylCarbonate + 2Pentanone";
            pressure  "101300.000000 Pa";
        }
        );

        domain
        {
            coordinate  x1;
            fit         { min 0.0078; max 0.9616; n 37; }
        }
    }

    metrics
    {
        //  r2InSample: not computed by this operation (it reports chi-square).
        //  NO HELD-OUT METRIC EXISTS.  r2InSample above is exactly that --
        //  in-sample -- and must not be read as an external check.
    }
}

