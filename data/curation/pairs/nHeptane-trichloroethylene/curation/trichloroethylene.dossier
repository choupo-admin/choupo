    fittedParameters
    {
        equilibrium.liquid.activityModel.binaryParameters.trichloroethylene-nHeptane.b_ij  -239.348992123;
        equilibrium.liquid.activityModel.binaryParameters.trichloroethylene-nHeptane.b_ji  425.925607195;
    }

    evidence
    {
        partitionFingerprint  "a1e2fcc45f43ff0b";   // frozen before the fit

        datasets
        (
        {
            role      fit;
            dataset   "constant/archiveExtracts/trichloroethylene-nHeptane-bubble-je0301085.dat";
