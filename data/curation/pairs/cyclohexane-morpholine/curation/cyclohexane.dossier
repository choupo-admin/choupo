        equilibrium.liquid.activityModel.binaryParameters.cyclohexane-morpholine.b_ij  373.784543108;
        equilibrium.liquid.activityModel.binaryParameters.cyclohexane-morpholine.b_ji  122.676220006;
    }

    evidence
    {
