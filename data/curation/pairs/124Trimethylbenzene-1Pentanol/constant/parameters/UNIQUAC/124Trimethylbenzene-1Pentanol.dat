/*---------------------------------------------------------------------------*\
  UNIQUAC binary interaction parameters --- 1Pentanol(i) + 124Trimethylbenzene(j)

  REGRESSED BY CHOUPO'S CURATION PIPELINE (bin/choupo-curate pairs --models, DEV.md 4c C294 on C282;
  record docs/design/binary-pairs-from-open-measurements.md) to measured
  bubble PRESSURES at stated temperatures (P-x, DEV.md 4c C291).  The articles named under `evidence` are the
  SOURCE of the measurements; the NIST/TRC ThermoML Archive located them.
  NO MEASURED POINT IS IN THIS RECORD OR THIS TREE: the case regenerates
  them from the DOIs and sha256 sums it declares (constant/archiveDatasets).
  The PARAMETERS are Choupo's own work.

  EQUATION: UNIQUAC, tau_ij = exp(-(a_ij + b_ij T + c_ij T^2) / T) [a in K],
  Abrams & Prausnitz (src/thermo/activityCoefficient/UNIQUAC.cpp); r and q
  each component's own record.  b_ij = b_ji = c_ij = c_ji = 0 FIXED, not
  fitted: two parameters a_ij, a_ji (DEV.md 4c C294).
  FRAME: ideal-gas vapour, no Poynting term, the catalogue's own
  vapour-pressure records for both pure components.

  reviewStatus interim: a case-local record, regressed and not read back.
  Fitted on EVERY laboratory with the NRTL fit's own kept points (C294), so
  the `validation {}` block says, truthfully, that nothing was held out;
  the acceptance is the `curation {}` block.
  NOT PROMOTABLE (fit grade warning, max |dP|/P 9.248 %): the pair splits
  ONE liquid inside its own validity span (arm f, UNIQUAC) -- predicts a
  LIQUID-LIQUID SPLIT at 313.15 K (x_1Pentanol 0.000 .. 0.337), inside
  its own validity span 313.15-313.15 K -- its evidence is bubble points
  of ONE liquid; a UNIQUAC pair that splits that liquid stays in its case

  REPRODUCE: run data/curation/pairs/124Trimethylbenzene-1Pentanol (after `bin/choupo-curate fetch` on it); its fit_uniquac
  writes 124Trimethylbenzene-1Pentanol.UNIQUAC.proposal.dat, which bin/curate/check_regressed_pairs.py holds
  equal to this record.
\*---------------------------------------------------------------------------*/

recordType binaryInteractionParameters;
schemaVersion 1;

pair { i 1Pentanol; j 124Trimethylbenzene; }

components  ( 1Pentanol  124Trimethylbenzene );
model       UNIQUAC;

parameters
{
    i           1Pentanol;
    j           124Trimethylbenzene;
    a_ij        -339.65700099;
    b_ij        0.00000000;
    c_ij        0.00000000;
    a_ji        2099.61923399;
    b_ji        0.00000000;
    c_ji        0.00000000;
}

provenance
{
    origin        fitted;
    method        "fitParameters(P_bubble), Levenberg-Marquardt";
    methodVersion "choupoProps Choupo-dev";
    fittedInCase  "data/curation/pairs/124Trimethylbenzene-1Pentanol";
    reviewStatus  interim;
    reviewReason  "regressed by bin/choupo-curate from archive-transcribed measurements; not yet read back against the articles";
    reuse         "Choupo's own regression; the measured points belong to the cited articles and are not reproduced in this record or this tree";
    fitDate       "2026-11-11";

    evidence
    (
        {
            role      fit;
            dataset   "constant/archiveExtracts/1Pentanol-124Trimethylbenzene-bubbleP-j.fluid.2017.12.031-b10.dat";
            doi       "10.1016/j.fluid.2017.12.031";
            sha256    "b7862c82eecf3591e4b347ced684a9c611c41ac5508fdb32a44c133e211c61f3";
            provenance measured;
            archiveFile "j.fluid.2017.12.031.xml";
            system    "1Pentanol + 124Trimethylbenzene";
        }
    );
    fingerprint "207741f3b41d7c8a";   // of the declaration, frozen before the fit

    //  IN-SAMPLE: the model reproducing the very points it was
    //  fitted to.  It is NOT a validation; see the block below.
    weighting     equal;   // chi2 is sum ((P_model - P_exp)/P_exp)^2, dimensionless
    chi2          0.09961718;
    rms_rel       0.06729081;
    nDataPoints   22;
    identifiable  true;
    maxAbsCorr    0.95647350;

    validity
    {
        temperature { min 313.15 K; max 313.15 K; }
        pressure    { min 989 Pa; max 1182 Pa; }
        note        "the span of the FIT evidence; outside it the pair is an extrapolation";
    }
}

validation
{
    verdict     validationRefused;

    heldOut     none;   // every declared dataset carried `role fit`

    acceptance  none;   // no band was declared before the fit, so no
                        // pass/fail may be read out of the residual above
}

curation
{
    rule            "DEV.md 4c C294 (the NRTL case's own evidence and kept points, another activity model) on DEV.md 4c C291 (bubble-pressure pairs; every laboratory, graded by C285)";
    model           UNIQUAC;
    discardsFrom    fit_nrtl;   // the outliers were decided ONCE, on the NRTL least-squares stage, and reused (C294)
    evidence        allLaboratories;   // every study fitted, none held out
    objective       twoStage;
    residual        P_bubble;
    residualScale   relative;   // (P_model - P)/P at each point's stated T
    outlierLimit_pct 20;   // the NRTL least-squares stage's, reused
    outliersDropped 2;
    pointsKept      22;
    noBubblePoint   0;
    maxRelError_pct 9.2481;
    meanRelError_pct 6.1594;
    acceptance      graded;   // max relative pressure error over the kept points, DEV.md 4c C285 (C291)
    gradeLimits_pct (5 10 20);   // upper limits of clean / warning / severe; above, refused
    grade           warning;
    oneLiquid       false;   // arm (f) on this model's own equation over the validity span
    temperatures    1;   // distinct stated temperatures in the kept evidence
    laboratories    1;   // distinct articles in the kept evidence
    singleTemperature true;
    singleLaboratory  true;
    verdict         accepted;
}
