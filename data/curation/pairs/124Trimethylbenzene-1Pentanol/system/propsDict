    {
        name        fit_nrtl;
        type        fitParameters;

        parameters
        (
            { path  equilibrium.liquid.activityModel.binaryParameters.1Pentanol-124Trimethylbenzene.b_ij;  initial 0;  min -3000;  max 3000; }
            { path  equilibrium.liquid.activityModel.binaryParameters.1Pentanol-124Trimethylbenzene.b_ji;  initial 0;  min -3000;  max 3000; }
        );

        evidence
        (
            {
                dataset  "constant/archiveExtracts/1Pentanol-124Trimethylbenzene-bubbleP-j.fluid.2017.12.031-b10.dat";
                role     fit;
                discard  ( 1 2 );   // C291 outliers, by name in the header
            }
        );

        objective { method twoStage;  scale { P_bubble relative; } }
        residual
        {
            kind        P_bubble;
            components  ( 1Pentanol 124Trimethylbenzene );
        }

        options
        {
            maxIter      80;
            tolerance    1.0e-6;
            fdStep       1.0e-4;
            lambda0      1.0e-3;
        }

        output
        {
            fit_log    fit_history.csv;
