    fittedParameters
    {
        equilibrium.liquid.activityModel.binaryParameters.2Methyl2Propanol-224Trimethylpentane.b_ij  -69.6522571594;
        equilibrium.liquid.activityModel.binaryParameters.2Methyl2Propanol-224Trimethylpentane.b_ji  491.029472118;
    }

    evidence
    {
        partitionFingerprint  "cca80baa4f3ea394";   // frozen before the fit

        datasets
        (
        {
            role      fit;
            dataset   "constant/archiveExtracts/2Methyl2Propanol-224Trimethylpentane-bubble-j.jct.2005.04.006.dat";
            doi       "10.1016/j.jct.2005.04.006";
            sha256    "e157abbd4d346d9ee5e79799e72fb16000d461970ab65ba327666624870901bc";
            provenance measured;
            archiveFile "j.jct.2005.04.006.xml";
            system    "2Methyl2Propanol + 224Trimethylpentane";
            pressure  "95800.000000 Pa";
        }
        );

        domain
        {
            coordinate  x1;
            fit         { min 0.1189; max 0.958; n 7; }
        }
    }

    metrics
    {
        //  r2InSample: not computed by this operation (it reports chi-square).
        //  NO HELD-OUT METRIC EXISTS.  r2InSample above is exactly that --
        //  in-sample -- and must not be read as an external check.
    }
}

{
