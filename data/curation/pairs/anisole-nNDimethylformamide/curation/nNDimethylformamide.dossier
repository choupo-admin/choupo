        equilibrium.liquid.activityModel.binaryParameters.nNDimethylformamide-anisole.b_ij  189.382328654;
        equilibrium.liquid.activityModel.binaryParameters.nNDimethylformamide-anisole.b_ji  179.378915764;
    }

