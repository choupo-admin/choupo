        file          "constant/archiveExtracts/methylIsobutylKetone-dimethylSulfoxide-bubble-j.jct.2007.04.004.dat";
        role          fit;   // C283: every laboratory is fitted
        doi           "10.1016/j.jct.2007.04.004";
        url           "https://trc.nist.gov/ThermoML/10.1016/j.jct.2007.04.004.xml";
        page          "https://trc.nist.gov/ThermoML/10.1016/j.jct.2007.04.004.json";
