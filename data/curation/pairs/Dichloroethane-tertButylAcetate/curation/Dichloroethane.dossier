            provenance measured;
            archiveFile "acs.jced.8b00434.xml";
            system    "Dichloroethane + tertButylAcetate";
            pressure  "101300.000000 Pa";
        }
        );

        domain
        {
            coordinate  x1;
            fit         { min 0.1074; max 0.9352; n 18; }
        }
    }

    metrics
    {
        //  r2InSample: not computed by this operation (it reports chi-square).
