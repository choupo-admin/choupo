        equilibrium.liquid.activityModel.binaryParameters.Dichloroethane-tertButylAcetate.b_ij  -493.551395608;
        equilibrium.liquid.activityModel.binaryParameters.Dichloroethane-tertButylAcetate.b_ji  884.916488867;
    }

    evidence
    {
        partitionFingerprint  "d54575574936eb99";   // frozen before the fit

