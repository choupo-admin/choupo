    fittedParameters
    {
        equilibrium.liquid.activityModel.binaryParameters.Dichloroethane-ethylBenzene.b_ij  421.736078625;
        equilibrium.liquid.activityModel.binaryParameters.Dichloroethane-ethylBenzene.b_ji  -453.038074626;
    }

    evidence
    {
        partitionFingerprint  "76eb5609c4a0449a";   // frozen before the fit

        datasets
        (
        {
            role      fit;
            dataset   "constant/archiveExtracts/Dichloroethane-ethylBenzene-bubble-j.jct.2005.12.009.dat";
            doi       "10.1016/j.jct.2005.12.009";
            sha256    "a98a2ed0d0a1d32edfbf57f888957a2e25b672502200eb2d43ea3e01fb0a596f";
            provenance measured;
            archiveFile "j.jct.2005.12.009.xml";
            system    "Dichloroethane + ethylBenzene";
            pressure  "94700.000000 Pa";
        }
        );

        domain
        {
            coordinate  x1;
            fit         { min 0.1146; max 0.902; n 8; }
        }
    }

    metrics
    {
        //  r2InSample: not computed by this operation (it reports chi-square).
