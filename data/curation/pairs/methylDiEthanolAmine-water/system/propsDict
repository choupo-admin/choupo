operations
(
    {
        name        fit_nrtl;
        type        fitParameters;

        parameters
        (
            { path  equilibrium.liquid.activityModel.binaryParameters.methylDiEthanolAmine-water.b_ij;  initial 0;  min -3000;  max 3000; }
            { path  equilibrium.liquid.activityModel.binaryParameters.methylDiEthanolAmine-water.b_ji;  initial 0;  min -3000;  max 3000; }
        );

        evidence
        (
            {
                dataset  "constant/archiveExtracts/methylDiEthanolAmine-water-bubble-acs.jced.8b00054.dat";
                role     fit;
                discard  ( 17 21 22 23 25 26 27 28 29 30 31 32 33 );   // C283 outliers, by name in the header
            }
            {
                dataset  "constant/archiveExtracts/methylDiEthanolAmine-water-bubble-je060396f.dat";
                role     fit;
            }
        );

        objective { method twoStage;  scale { T_bubble absolute; } }
        residual
        {
            kind        T_bubble;
            components  ( methylDiEthanolAmine water );
            weighting   uncertainty;
        }

        options
        {
            maxIter      80;
            tolerance    1.0e-6;
            fdStep       1.0e-4;
            lambda0      1.0e-3;
        }

        output
        {
            fit_log    fit_history.csv;
            parity     parity.csv;
            proposal   methylDiEthanolAmine-water.proposal.dat;
        }
