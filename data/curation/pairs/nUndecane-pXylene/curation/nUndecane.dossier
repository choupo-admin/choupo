    fittedParameters
    {
        equilibrium.liquid.activityModel.binaryParameters.nUndecane-pXylene.b_ij  53.6201228306;
        equilibrium.liquid.activityModel.binaryParameters.nUndecane-pXylene.b_ji  -60.0574066597;
    }

    evidence
    {
        partitionFingerprint  "049c41b7cbf4aa2a";   // frozen before the fit

