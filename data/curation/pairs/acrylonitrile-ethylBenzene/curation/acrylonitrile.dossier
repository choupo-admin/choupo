    refusal        "No independent experimental evidence remains after fitting.";

    fittedParameters
    {
        equilibrium.liquid.activityModel.binaryParameters.acrylonitrile-ethylBenzene.b_ij  328.592506662;
        equilibrium.liquid.activityModel.binaryParameters.acrylonitrile-ethylBenzene.b_ji  -53.909612778;
    }

    evidence
    {
        partitionFingerprint  "a03730604a7c5fff";   // frozen before the fit

        datasets
        (
        {
            role      fit;
            dataset   "constant/archiveExtracts/acrylonitrile-ethylBenzene-bubble-j.jct.2004.11.015.dat";
            doi       "10.1016/j.jct.2004.11.015";
            sha256    "0b0ecaf961c36dd7300bf4c0ee8640cbba1c9a07e2d75b74fedbd59150174849";
            provenance measured;
            archiveFile "j.jct.2004.11.015.xml";
            system    "acrylonitrile + ethylBenzene";
            pressure  "94700.000000 Pa";
        }
        );

        domain
        {
            coordinate  x1;
            fit         { min 0.1568; max 0.8987; n 6; }
        }
    }

    metrics
    {
        //  r2InSample: not computed by this operation (it reports chi-square).
        //  NO HELD-OUT METRIC EXISTS.  r2InSample above is exactly that --
        //  in-sample -- and must not be read as an external check.
    }
}

{
