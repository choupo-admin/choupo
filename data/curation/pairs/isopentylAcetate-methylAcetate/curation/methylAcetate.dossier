    refusal        "No independent experimental evidence remains after fitting.";

    fittedParameters
    {
        equilibrium.liquid.activityModel.binaryParameters.methylAcetate-isopentylAcetate.b_ij  667.057253788;
        equilibrium.liquid.activityModel.binaryParameters.methylAcetate-isopentylAcetate.b_ji  -82.8796851215;
    }

    evidence
    {
        partitionFingerprint  "df5d469961fbf1a4";   // frozen before the fit

        datasets
        (
        {
            role      fit;
            dataset   "constant/archiveExtracts/methylAcetate-isopentylAcetate-bubble-acs.jced.8b00807.dat";
            doi       "10.1021/acs.jced.8b00807";
            sha256    "575f053bfde22a3c838a4930b2608783e66abc1867bbe03f4dbdcc0483fa3302";
            provenance measured;
            archiveFile "acs.jced.8b00807.xml";
            system    "methylAcetate + isopentylAcetate";
            pressure  "101300.000000 Pa";
        }
        );

        domain
        {
            coordinate  x1;
            fit         { min 0.0063; max 0.8579; n 16; }
        }
    }

    metrics
    {
        //  r2InSample: not computed by this operation (it reports chi-square).
        //  NO HELD-OUT METRIC EXISTS.  r2InSample above is exactly that --
        //  in-sample -- and must not be read as an external check.
    }
}

