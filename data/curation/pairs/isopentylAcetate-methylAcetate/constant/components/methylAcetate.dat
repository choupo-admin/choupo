// [imported] origin "data/standards/components/methylAcetate.dat" (Choupo-2608 release) -- owned + sha256-verified by constant/propertyManifest
/*--------------------------------*- Choupo -*-----------------------*\
  Component: Methyl acetate  (C3H6O2, CAS 79-20-9)

  Added 2026-06-28 to support the reactive-distillation validation against
  Pöpken, Steinigeweg & Gmehling, Ind. Eng. Chem. Res. 40 (2001) 1566
  (methanol + acetic acid <=> methyl acetate + water).

  Primary data: NIST WebBook / DIPPR-class compilations (critical constants,
  Tb, Hvap); Antoine from Ambrose, Sprake & Townsend, J. Chem. Thermodyn.
  (P in bar, T in K, log10 form).  UNIFAC decomposition 1 CH3 + 1 CH3COO
  (Poling, Prausnitz & O'Connell, "The Properties of Gases and Liquids", 5th ed.,
  Table 8-23 example).
\*---------------------------------------------------------------------------*/

name        methylAcetate;
formula     C3H6O2;
CAS         79-20-9;

MW          74.079;
Tc          506.55;
Pc          47.50;
omega       0.3310;
Tb          330.02;
HvapTb      30320;
Vliq        7.984e-5;
//  ANCHOR, never an input.  The engine DERIVES the Hildebrand
//  parameter from HvapTb and Vliq (the tree stores no derivative);
//  this is what ChemSep v8.3 computed independently, so the
//  derivation has something to be wrong against.
solubilityParameter 19350;   // Pa^0.5  [anchor, ChemSep v8.3, Artistic-2.0]

standardThermochemistry
{
    dHf_298   -411900.0;       // J/mol  ideal-gas reference (NIST)
    s_298      324.40;         // J/(mol·K)  third-law absolute (gas)
}

vaporPressure
{
    model         Antoine;     // log10(P/bar) = A - B/(T/K + C)
    coefficients  (4.18621   1156.43   -53.461);
    //  CORRECTED 2026-08-24 against the primary in hand (Poling 5e,
    //  Appendix A, section D, methyl ethanoate, CAS 79-20-9): the
    //  coefficients are the book's exactly, but the declared window read
    //  (260 380) where the FIT runs 249.90-351.11 K.  The upper end was
    //  29 K beyond the correlation -- the direction that SILENCES an
    //  extrapolation announcement the reader is owed.  Now the source's
    //  own range; cases above 351.11 K announce, as they should.
    Trange        (249.9  351.11);
}

idealGasHeatCapacity
{
    model         polynomial;
    coefficients  (20.0   0.2550   -8.00e-5);
    Trange        (200  1000);
}

liquidHeatCapacity
{
    model         polynomial;
    coefficients  (140.0);
    Trange        (290  360);
}

groups
{
    unifac ( { group CH3; count 1; } { group CH3COO; count 1; } );
    joback ( { group CH3; count 2; } { group COO; count 1; } );
}

uniquac
{
    r   2.8042;
    q   2.5760;     // van der Waals (Abrams-Prausnitz), as used by Popken 2000 Table 2
}

cosmo
{
    VT2005
    {
        model       COSMOSAC;
        variant     "2002";
        source      "VT-2005 sigma-profile database (Mullins et al., Ind. Eng. Chem. Res. 45 (2006) 4389; DFT-COSMO), file VT2005-0638-PROF.txt bundled in usnistgov/COSMOSAC; CAS 79-20-9";
        licence     externalRestricted;   // VT-2005: redistribution NOT confirmed -- values NOT shipped
        installed   false;                 // install your own copy: bin/choupo-import-cosmo (-> data/local/cosmo/VT2005/)
    }
    LVPP-HFTZVP-2018
    {
        model       COSMOSAC;
        variant     "LVPP-HFTZVP-2018";
        protocol    "LVPP-18.07 GAMESS HF/TZVP; r_av 1.4 A; f_decay 3.57; d in A; sigma = q/a";
        source      "LVPP sigma-profile database release 18.07 (github.com/lvpp/sigma, asset HF_TZVP.zip, sha256 bd17aaeebb430641...), file METHYL_ACETATE.gout; MIT License, Copyright (c) 2017 LVPP; cite Ferrarini, Flores, Muniz & Soares, AIChE J. 64 (2018) 3443, doi:10.1002/aic.16194, and doi:10.5281/zenodo.3613786; identity: InChIKey KXKVLQRXCPHEJC-UHFFFAOYSA-N (full match); formula C3H6O2; resolved by thirdParty/thermoml/identity.json (PubChem and CACTUS agree)";
        derivation  "segment areas, charges and the cavity volume are LVPP's (GAMESS HF/TZVP COSMO output); `area` is the sum of LVPP's segment areas as binned (GAMESS's printed cavity area agrees within its 2-decimal rounding); the 51-point profile is COMPUTED BY CHOUPO from LVPP's surface segments by bin/curate/lvpp_sigma_profile.py under the protocol above (Bell et al. 2020 Eq. 4 averaging, sigma = q/a, area split linearly between grid nodes)";
        licence     MIT;
        installed   true;
        area        112.737169;   // sum of the profile below; GAMESS prints 112.74
        volume      96.57;
        sigmaProfile  (
               0.000000     0.000000     0.000000     0.000000     0.000000     0.000000
               0.000000     0.000000     0.000000     0.000000     0.000000     0.000000
               0.000000     0.000000     0.000000     0.000000     0.000000     2.463810
              11.040304    14.931843    10.456175    10.615984     9.524490    10.864362
               7.088645     2.971599     1.482062     1.723229     1.290806     1.063551
               1.889380     1.916617     1.113362     1.738817     1.719661     2.688749
               2.758459     2.026617     1.623331     2.882615     4.540895     2.078710
               0.243096     0.000000     0.000000     0.000000     0.000000     0.000000
               0.000000     0.000000     0.000000
        );
    }
}
