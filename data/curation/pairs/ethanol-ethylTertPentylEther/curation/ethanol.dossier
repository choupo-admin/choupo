    refusal        "No independent experimental evidence remains after fitting.";

    fittedParameters
    {
        equilibrium.liquid.activityModel.binaryParameters.ethanol-ethylTertPentylEther.b_ij  456.112580662;
        equilibrium.liquid.activityModel.binaryParameters.ethanol-ethylTertPentylEther.b_ji  102.583458805;
    }

    evidence
    {
        partitionFingerprint  "c35fce5b22bf8a7c";   // frozen before the fit

        datasets
        (
        {
            role      fit;
            dataset   "constant/archiveExtracts/ethanol-ethylTertPentylEther-bubble-j.fluid.2005.04.003.dat";
            doi       "10.1016/j.fluid.2005.04.003";
            sha256    "0e3206584c4c10c9242f97a4d7ca1aff18df9e3e11f166a66f40f07bbe763c91";
            provenance measured;
            archiveFile "j.fluid.2005.04.003.xml";
            system    "ethanol + ethylTertPentylEther";
            pressure  "101325.000000 Pa";
        }
        );

        domain
        {
            coordinate  x1;
            fit         { min 0.0592; max 0.9968; n 30; }
        }
    }

    metrics
    {
        //  r2InSample: not computed by this operation (it reports chi-square).
