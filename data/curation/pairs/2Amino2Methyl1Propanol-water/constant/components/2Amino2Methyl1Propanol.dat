//  the tool); the case data/curation/batches/new_components_c309 prints it.

standardThermochemistry
{
    dHf_298   -253080;        // J/mol, ideal gas, Joback ESTIMATE (provenance.dHf_298)
    s_298     375.43;        // J/(mol K), ideal gas, DERIVED from Joback (provenance.s_298)
}

vaporPressure
{
    model         Antoine;
    // log10(Psat [bar]) = A - B / (T[K] + C), FITTED by bin/choupo-curate vp to
    // measured vapour pressures -- see provenance.vaporPressure
    coefficients  (5.387891752  2009.853958  -63.51695606);
    Trange        (293.29  452);   // the fit's own span; outside it the engine announces the extrapolation
}

Vliq        9.546242e-05;      // m3/mol at 25 C, FITTED (provenance.Vliq)

idealGasHeatCapacity
{
    model         polynomial;
    // Cp [J/(mol K)] = a0 + a1 T + a2 T^2 + a3 T^3, Joback ESTIMATE
    coefficients  (-13.439  0.60554  -4.394000e-04  1.291000e-07);
    Trange        (273  1000);
}

liquidHeatCapacity
{
    model         polynomial;
    // Cp [J/(mol K)] = a0 + a1 T, Zabransky RECOMMENDED (provenance.liquidHeatCapacity)
    coefficients  (23.99002199  0.6904543709);
    Trange        (298.1  397.8);
}

groups
{
    joback ( { group CH3; count 2; } { group C; count 1; } { group CH2; count 1; } { group NH2; count 1; } { group OH; count 1; } );
}

