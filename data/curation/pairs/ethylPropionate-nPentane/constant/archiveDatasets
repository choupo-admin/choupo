/*--------------------------------*- Choupo -*--------------------------------*\
  constant/archiveDatasets -- WHERE the measurements of ethylPropionate-nPentane
  come from, and how to regenerate them.  NO MEASURED POINT IS IN THIS TREE
  (Vitor, 2026-11-10: the measured series are not copied; only the fitted
  parameters are kept).  `bin/choupo-curate fetch <case>` writes each
  dataset into constant/archiveExtracts/ (gitignored): the article file is taken from
  the local ThermoML cache when it holds it, else from the NIST URL below,
  and BOTH sha256 sums are checked -- a mismatch refuses, an unreachable
  NIST is reported NOT RUN, never a pass.
\*-----------------------------------------------------------------------------*/

recordType    archiveDatasets;

archive
{
    tarball   "ThermoML.v2020-09-30.tgz";
    doi       "10.18434/mds2-2422";
    note      "the finding aid; each article file is also served one by one at the NIST URL";
}

datasets
(
    {
        file          "constant/archiveExtracts/ethylPropionate-nPentane-bubble-je4009415.dat";
        role          fit;   // C283: every laboratory is fitted
        doi           "10.1021/je4009415";
        url           "https://trc.nist.gov/ThermoML/10.1021/je4009415.xml";
        page          "https://trc.nist.gov/ThermoML/10.1021/je4009415.json";
        articleFile   "je4009415.xml";
        articleSha256 "c7eb83e2dc95e5a893713ee18fede2761c1385cf1fb4f90cc1cb6bfd32c3c0ac";
        block         28;
        filter        ( --interior-only );
        extract       "bin/choupo-thermoml extract-vle <article file> --block 28 --interior-only --into <dir>";
        sha256        "33daacca87565cf13b75aafd6651bd5b59e2c31cf252ce50e43f3376d6f99548";
        identity
        {
            ethylPropionate { cas "105-37-3"; inchiKey "FKRCODPIKNYEAC-UHFFFAOYSA-N"; }
            nPentane       { cas "109-66-0"; inchiKey "OFBQJSOFQDEBGM-UHFFFAOYSA-N"; }
        }
    }
);
