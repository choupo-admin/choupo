        equilibrium.liquid.activityModel.binaryParameters.methylcyclohexane-diEthylCarbonate.b_ij  57.1060886602;
        equilibrium.liquid.activityModel.binaryParameters.methylcyclohexane-diEthylCarbonate.b_ji  282.163417819;
    }

    evidence
