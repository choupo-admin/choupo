    refusal        "No independent experimental evidence remains after fitting.";

    fittedParameters
    {
        equilibrium.liquid.activityModel.binaryParameters.allylAlcohol-ethylAcetate.b_ij  186.6104899;
        equilibrium.liquid.activityModel.binaryParameters.allylAlcohol-ethylAcetate.b_ji  -64.2830498672;
    }

    evidence
    {
        partitionFingerprint  "c1643e95737aa7a8";   // frozen before the fit

        datasets
        (
        {
            role      fit;
            dataset   "constant/archiveExtracts/allylAlcohol-ethylAcetate-bubble-acs.jced.8b00908.dat";
            doi       "10.1021/acs.jced.8b00908";
            sha256    "3ece7dd8820b2c369d51ff86a462babb7e27693df78c6ef76f4382c9f6b32c01";
            provenance measured;
            archiveFile "acs.jced.8b00908.xml";
            system    "allylAlcohol + ethylAcetate";
            pressure  "101300.000000 Pa";
        }
        );

        domain
        {
            coordinate  x1;
            fit         { min 0.1145; max 0.9512; n 15; }
        }
    }

    metrics
    {
        //  r2InSample: not computed by this operation (it reports chi-square).
