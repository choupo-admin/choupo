    fittedParameters
    {
        equilibrium.liquid.activityModel.binaryParameters.isopropanol-2Ethoxyethanol.b_ij  -273.961687547;
        equilibrium.liquid.activityModel.binaryParameters.isopropanol-2Ethoxyethanol.b_ji  458.196161307;
    }

    evidence
    {
        partitionFingerprint  "0c202e3995853a16";   // frozen before the fit

        datasets
        (
        {
            role      fit;
            dataset   "constant/archiveExtracts/isopropanol-2Ethoxyethanol-bubble-j.jct.2018.11.013.dat";
