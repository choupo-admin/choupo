            provenance measured;
            archiveFile "j.jct.2018.11.013.xml";
            system    "isopropanol + 2Ethoxyethanol";
            pressure  "101300.000000 Pa";
        }
        );

        domain
        {
            coordinate  x1;
            fit         { min 0.0189; max 0.9122; n 12; }
        }
    }

    metrics
    {
        //  r2InSample: not computed by this operation (it reports chi-square).
