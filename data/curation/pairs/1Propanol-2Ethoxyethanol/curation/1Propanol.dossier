    fittedParameters
    {
        equilibrium.liquid.activityModel.binaryParameters.1Propanol-2Ethoxyethanol.b_ij  873.841266682;
        equilibrium.liquid.activityModel.binaryParameters.1Propanol-2Ethoxyethanol.b_ji  -474.342973215;
    }

    evidence
    {
        partitionFingerprint  "2d20319b74c15721";   // frozen before the fit

