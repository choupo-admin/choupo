uniquac
{
    r   4.8259;
    q   4.2720;
}

groups
{
    unifac ( { group CH3; count 3; } { group C; count 1; } { group CH3COO; count 1; } );
    joback ( { group CH3; count 4; } { group C; count 1; } { group ester; count 1; } );
}

