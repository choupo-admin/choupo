/*--------------------------------*- Choupo -*--------------------------------*\
  constant/archiveDatasets -- WHERE the measurements of 2Butanol-tetrahydropyran
  come from, and how to regenerate them.  NO MEASURED POINT IS IN THIS TREE
  (Vitor, 2026-11-10: the measured series are not copied; only the fitted
  parameters are kept).  `bin/choupo-curate fetch <case>` writes each
  dataset into constant/archiveExtracts/ (gitignored): the article file is taken from
  the local ThermoML cache when it holds it, else from the NIST URL below,
  and BOTH sha256 sums are checked -- a mismatch refuses, an unreachable
  NIST is reported NOT RUN, never a pass.
\*-----------------------------------------------------------------------------*/

recordType    archiveDatasets;

archive
{
    tarball   "ThermoML.v2020-09-30.tgz";
    doi       "10.18434/mds2-2422";
    note      "the finding aid; each article file is also served one by one at the NIST URL";
}

datasets
(
    {
        file          "constant/archiveExtracts/tetrahydropyran-2Butanol-bubble-je800145h.dat";
        role          fit;   // C283: every laboratory is fitted
        doi           "10.1021/je800145h";
        url           "https://trc.nist.gov/ThermoML/10.1021/je800145h.xml";
        page          "https://trc.nist.gov/ThermoML/10.1021/je800145h.json";
        articleFile   "je800145h.xml";
        articleSha256 "5dd47b3ee3daba46383121cf9b59b062c8da13cdfd2befd3f7223b52bdbfa81a";
        block         15;
        filter        ( --interior-only );
        extract       "bin/choupo-thermoml extract-vle <article file> --block 15 --interior-only --into <dir>";
        sha256        "3a03a40456a7af44964fb0dc63a306c83ebae73041f27c288c0bfe090dc832ed";
        identity
        {
            tetrahydropyran { cas "142-68-7"; inchiKey "DHXVGJBLRPWPCS-UHFFFAOYSA-N"; }
            2Butanol       { cas "78-92-2"; inchiKey "BTANRVKWQNVYAZ-UHFFFAOYSA-N"; }
        }
    }
    {
        file          "constant/archiveExtracts/tetrahydropyran-2Butanol-bubble-j.fluid.2012.12.021.dat";
        role          fit;   // C283: every laboratory is fitted
        doi           "10.1016/j.fluid.2012.12.021";
        url           "https://trc.nist.gov/ThermoML/10.1016/j.fluid.2012.12.021.xml";
        page          "https://trc.nist.gov/ThermoML/10.1016/j.fluid.2012.12.021.json";
        articleFile   "j.fluid.2012.12.021.xml";
        articleSha256 "8dae6abcc2062d52ab8d7403f85b7879478c15c00047ae7cac2aecd44ba50638";
        block         6;
        filter        ( --interior-only );
        xOf           tetrahydropyran;   // the article reports the other member; x = 1 - x'
        extract       "bin/choupo-thermoml extract-vle <article file> --block 6 --interior-only --x-of tetrahydropyran --into <dir>";
        sha256        "6c8bfecbc48cd83b58709ce12a3c378f0e2be2b38647804aae4086b3f0153a6a";
        identity
        {
            tetrahydropyran { cas "142-68-7"; inchiKey "DHXVGJBLRPWPCS-UHFFFAOYSA-N"; }
            2Butanol       { cas "78-92-2"; inchiKey "BTANRVKWQNVYAZ-UHFFFAOYSA-N"; }
        }
    }
);
