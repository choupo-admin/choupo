/*--------------------------------*- Choupo -*--------------------------------*\
  constant/archiveDatasets -- WHERE the measurements of ethyleneGlycol-methylDiEthanolAmine
  come from, and how to regenerate them.  NO MEASURED POINT IS IN THIS TREE
  (Vitor, 2026-11-10: the measured series are not copied; only the fitted
  parameters are kept).  `bin/choupo-curate fetch <case>` writes each
  dataset into constant/archiveExtracts/ (gitignored): the article file is taken from
  the local ThermoML cache when it holds it, else from the NIST URL below,
  and BOTH sha256 sums are checked -- a mismatch refuses, an unreachable
  NIST is reported NOT RUN, never a pass.
\*-----------------------------------------------------------------------------*/

recordType    archiveDatasets;

archive
{
    tarball   "ThermoML.v2020-09-30.tgz";
    doi       "10.18434/mds2-2422";
    note      "the finding aid; each article file is also served one by one at the NIST URL";
}

datasets
(
    {
        file          "constant/archiveExtracts/ethyleneGlycol-methylDiEthanolAmine-bubble-je400373d.dat";
        role          fit;   // C283: every laboratory is fitted
        doi           "10.1021/je400373d";
        url           "https://trc.nist.gov/ThermoML/10.1021/je400373d.xml";
        page          "https://trc.nist.gov/ThermoML/10.1021/je400373d.json";
        articleFile   "je400373d.xml";
        articleSha256 "5fd41a9baa3403e420dbd131ccdfe658a984d48b0965881982e740966f424eda";
        block         8;
        filter        ( --interior-only );
        extract       "bin/choupo-thermoml extract-vle <article file> --block 8 --interior-only --into <dir>";
        sha256        "0cec97e597b7d8594375ff9a95f6356107aacc9435cd6c0a9881885a3401280e";
        identity
        {
            ethyleneGlycol { cas "107-21-1"; inchiKey "LYCAIKOWRPUZTN-UHFFFAOYSA-N"; }
            methylDiEthanolAmine { cas "105-59-9"; inchiKey "CRVGTESFCCXCTH-UHFFFAOYSA-N"; }
        }
    }
    {
        file          "constant/archiveExtracts/ethyleneGlycol-methylDiEthanolAmine-bubble-acs.jced.8b00054.dat";
        role          fit;   // C283: every laboratory is fitted
        doi           "10.1021/acs.jced.8b00054";
        url           "https://trc.nist.gov/ThermoML/10.1021/acs.jced.8b00054.xml";
        page          "https://trc.nist.gov/ThermoML/10.1021/acs.jced.8b00054.json";
        articleFile   "acs.jced.8b00054.xml";
        articleSha256 "87fdfe4ce4455970e1a0d55c274cb156e01b4f7f3922db74ae4e4ff88b26f625";
        block         13;
        filter        ( --interior-only );
        xOf           ethyleneGlycol;   // the article reports the other member; x = 1 - x'
        extract       "bin/choupo-thermoml extract-vle <article file> --block 13 --interior-only --x-of ethyleneGlycol --into <dir>";
        sha256        "f3ccfca42a072508f84dce783b75d66ee7698aa7956c54121785f7ef80639822";
        identity
        {
            ethyleneGlycol { cas "107-21-1"; inchiKey "LYCAIKOWRPUZTN-UHFFFAOYSA-N"; }
            methylDiEthanolAmine { cas "105-59-9"; inchiKey "CRVGTESFCCXCTH-UHFFFAOYSA-N"; }
        }
    }
);
