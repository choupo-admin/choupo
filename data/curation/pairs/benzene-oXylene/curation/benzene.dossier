    refusal        "No independent experimental evidence remains after fitting.";

    fittedParameters
    {
        equilibrium.liquid.activityModel.binaryParameters.benzene-oXylene.b_ij  898.365073318;
        equilibrium.liquid.activityModel.binaryParameters.benzene-oXylene.b_ji  -501.259786348;
    }

    evidence
    {
        partitionFingerprint  "127dc09a8c43122b";   // frozen before the fit

        datasets
        (
        {
            role      fit;
            dataset   "constant/archiveExtracts/benzene-oXylene-bubble-j.fluid.2013.05.016.dat";
            doi       "10.1016/j.fluid.2013.05.016";
            sha256    "69c038c024b6aad74ec319ce22dd0c9fee1fb16db43ed87f57a51036170b3f17";
            provenance measured;
            archiveFile "j.fluid.2013.05.016.xml";
            system    "benzene + oXylene";
            pressure  "101300.000000 Pa";
        }
        );

        domain
        {
            coordinate  x1;
            fit         { min 0.03; max 0.98; n 17; }
        }
    }

    metrics
    {
        //  r2InSample: not computed by this operation (it reports chi-square).
