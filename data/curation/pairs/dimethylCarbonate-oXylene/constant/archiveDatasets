/*--------------------------------*- Choupo -*--------------------------------*\
  constant/archiveDatasets -- WHERE the measurements of dimethylCarbonate-oXylene
  come from, and how to regenerate them.  NO MEASURED POINT IS IN THIS TREE
  (Vitor, 2026-11-10: the measured series are not copied; only the fitted
  parameters are kept).  `bin/choupo-curate fetch <case>` writes each
  dataset into constant/archiveExtracts/ (gitignored): the article file is taken from
  the local ThermoML cache when it holds it, else from the NIST URL below,
  and BOTH sha256 sums are checked -- a mismatch refuses, an unreachable
  NIST is reported NOT RUN, never a pass.
\*-----------------------------------------------------------------------------*/

recordType    archiveDatasets;

archive
{
    tarball   "ThermoML.v2020-09-30.tgz";
    doi       "10.18434/mds2-2422";
    note      "the finding aid; each article file is also served one by one at the NIST URL";
}

datasets
(
    {
        file          "constant/archiveExtracts/dimethylCarbonate-oXylene-bubble-acs.jced.9b00414.dat";
        role          fit;   // C283: every laboratory is fitted
        doi           "10.1021/acs.jced.9b00414";
        url           "https://trc.nist.gov/ThermoML/10.1021/acs.jced.9b00414.xml";
        page          "https://trc.nist.gov/ThermoML/10.1021/acs.jced.9b00414.json";
        articleFile   "acs.jced.9b00414.xml";
        articleSha256 "08859773e230d7e51409d5d329c037ea6ec178042d4602aca05aa5470b4ea6d5";
        block         7;
        filter        ( --interior-only );
        extract       "bin/choupo-thermoml extract-vle <article file> --block 7 --interior-only --into <dir>";
        sha256        "ae8f3502295876bf40bd6128f3318856b15803351c383fe0421eee1c5ccf6c60";
        identity
        {
            dimethylCarbonate { cas "616-38-6"; inchiKey "IEJIGPNLZYLLBP-UHFFFAOYSA-N"; }
            oXylene        { cas "95-47-6"; inchiKey "CTQNGGLPUBDAKN-UHFFFAOYSA-N"; }
        }
    }
    {
        file          "constant/archiveExtracts/dimethylCarbonate-oXylene-bubble-acs.jced.7b00372.dat";
        role          fit;   // C283: every laboratory is fitted
        doi           "10.1021/acs.jced.7b00372";
        url           "https://trc.nist.gov/ThermoML/10.1021/acs.jced.7b00372.xml";
        page          "https://trc.nist.gov/ThermoML/10.1021/acs.jced.7b00372.json";
        articleFile   "acs.jced.7b00372.xml";
        articleSha256 "d7db373526dce14490ebc7cd7c42f771c4b2aae1013b5b3e8a930cd4d5a5a0a5";
        block         21;
        filter        ( --interior-only );
        xOf           dimethylCarbonate;   // the article reports the other member; x = 1 - x'
        extract       "bin/choupo-thermoml extract-vle <article file> --block 21 --interior-only --x-of dimethylCarbonate --into <dir>";
        sha256        "3cd18a42e8cf9b0837adf6a31b815aa25c71c1a77f525e9a9ce6da793e897876";
        identity
        {
            dimethylCarbonate { cas "616-38-6"; inchiKey "IEJIGPNLZYLLBP-UHFFFAOYSA-N"; }
            oXylene        { cas "95-47-6"; inchiKey "CTQNGGLPUBDAKN-UHFFFAOYSA-N"; }
        }
    }
);
