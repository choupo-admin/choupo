    refusal        "No independent experimental evidence remains after fitting.";

    fittedParameters
    {
        equilibrium.liquid.activityModel.binaryParameters.toluene-monochlorobenzene.b_ij  -299.332949447;
        equilibrium.liquid.activityModel.binaryParameters.toluene-monochlorobenzene.b_ji  361.502341244;
    }

    evidence
    {
        partitionFingerprint  "d88b1a7166f3adb4";   // frozen before the fit

        datasets
        (
        {
            role      fit;
            dataset   "constant/archiveExtracts/toluene-monochlorobenzene-bubble-je020186c.dat";
            doi       "10.1021/je020186c";
            sha256    "42c372b090af0eedd09839822f60e727cbd35e444ec214ef4d1075f266e2aa46";
            provenance measured;
            archiveFile "je020186c.xml";
            system    "toluene + monochlorobenzene";
        }
        );

        domain
        {
            coordinate  x1;
            fit         { min 0.286; max 0.793; n 24; }
        }
    }

    metrics
    {
