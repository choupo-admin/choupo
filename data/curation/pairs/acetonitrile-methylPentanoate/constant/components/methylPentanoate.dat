uniquac
{
    r   4.8274;
    q   4.1960;
}

groups
{
    unifac ( { group CH3; count 2; } { group CH2; count 2; } { group CH2COO; count 1; } );
    joback ( { group CH3; count 2; } { group CH2; count 3; } { group ester; count 1; } );
}

