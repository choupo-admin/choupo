    refusal        "No independent experimental evidence remains after fitting.";

    fittedParameters
    {
        equilibrium.liquid.activityModel.binaryParameters.water-1Methoxy2PropylAcetate.b_ij  1528.80869473;
        equilibrium.liquid.activityModel.binaryParameters.water-1Methoxy2PropylAcetate.b_ji  -44.8163302269;
    }

    evidence
    {
        partitionFingerprint  "8bacf6d1f5f9872f";   // frozen before the fit

        datasets
        (
        {
            role      fit;
            dataset   "constant/archiveExtracts/water-1Methoxy2PropylAcetate-bubble-j.fluid.2007.06.006.dat";
            doi       "10.1016/j.fluid.2007.06.006";
            sha256    "1199da24ff6d595c35b20f12ca5001fe7bb53d23719dca5dafec2b262c84ad53";
            provenance measured;
            archiveFile "j.fluid.2007.06.006.xml";
            system    "water + 1Methoxy2PropylAcetate";
        }
        );

        domain
        {
            coordinate  x1;
            fit         { min 0.048; max 0.99; n 42; }
        }
    }

    metrics
    {
        //  r2InSample: not computed by this operation (it reports chi-square).
        //  NO HELD-OUT METRIC EXISTS.  r2InSample above is exactly that --
