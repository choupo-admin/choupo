        articleSha256 "1199da24ff6d595c35b20f12ca5001fe7bb53d23719dca5dafec2b262c84ad53";
        block         4;
        filter        ( --interior-only );
        extract       "bin/choupo-thermoml extract-vle <article file> --block 4 --interior-only --into <dir>";
        sha256        "5cae75681c9db9bfdae012ee30e2a32496bf5723d4b2eba899b4d2393c2dfe3c";
        identity
        {
            water          { cas "7732-18-5"; inchiKey "XLYOFNOQVPJJNP-UHFFFAOYSA-N"; }
            1Methoxy2PropylAcetate { cas "108-65-6"; inchiKey "LLHKCFNBLRBOGN-UHFFFAOYSA-N"; }
        }
    }
