/*--------------------------------*- Choupo -*--------------------------------*\
  constant/archiveDatasets -- WHERE the measurements of nButanol-toluene
  come from, and how to regenerate them.  NO MEASURED POINT IS IN THIS TREE
  (Vitor, 2026-11-10: the measured series are not copied; only the fitted
  parameters are kept).  `bin/choupo-curate fetch <case>` writes each
  dataset into constant/archiveExtracts/ (gitignored): the article file is taken from
  the local ThermoML cache when it holds it, else from the NIST URL below,
  and BOTH sha256 sums are checked -- a mismatch refuses, an unreachable
  NIST is reported NOT RUN, never a pass.  The extractor is `extract-px`
  (a bubble-PRESSURE block at a stated temperature, DEV.md 4c C291).
\*-----------------------------------------------------------------------------*/

recordType    archiveDatasets;

archive
{
    tarball   "ThermoML.v2020-09-30.tgz";
    doi       "10.18434/mds2-2422";
    note      "the finding aid; each article file is also served one by one at the NIST URL";
}

datasets
(
    {
        file          "constant/archiveExtracts/nButanol-toluene-bubbleP-je200840e-b10.dat";
        role          fit;   // C283: every laboratory is fitted
        doi           "10.1021/je200840e";
        url           "https://trc.nist.gov/ThermoML/10.1021/je200840e.xml";
        page          "https://trc.nist.gov/ThermoML/10.1021/je200840e.json";
        articleFile   "je200840e.xml";
        articleSha256 "2426b562d0d40fb4f309ec00281df6ba258d2ddf7e75d7e4616c16757f76bbba";
        block         10;
        extractor     bubblePressure;
        extract       "bin/choupo-thermoml extract-px <article file> --block 10 --into <dir>";
        sha256        "dba8a6819a8ab06cb27c5905a0ee07caa10cd185a7659341d69687d92bce7bf3";
        identity
        {
            nButanol       { cas "71-36-3"; inchiKey "LRHPLDYGYMQRHN-UHFFFAOYSA-N"; }
            toluene        { cas "108-88-3"; inchiKey "YXFVVABEGXRONW-UHFFFAOYSA-N"; }
        }
    }
    {
        file          "constant/archiveExtracts/nButanol-toluene-bubbleP-j.jct.2004.01.001-b19.dat";
        role          fit;   // C283: every laboratory is fitted
        doi           "10.1016/j.jct.2004.01.001";
        url           "https://trc.nist.gov/ThermoML/10.1016/j.jct.2004.01.001.xml";
        page          "https://trc.nist.gov/ThermoML/10.1016/j.jct.2004.01.001.json";
        articleFile   "j.jct.2004.01.001.xml";
        articleSha256 "c36869b5255205e6fc68ce6d0363667c9aa8b7994ca9e1040ea169089fe65a21";
        block         19;
        extractor     bubblePressure;
        extract       "bin/choupo-thermoml extract-px <article file> --block 19 --into <dir>";
        sha256        "ef852432d5784bf4cf2efa46fef818db96432fbfb687f3bcec4cd67d6805cf75";
        identity
        {
            nButanol       { cas "71-36-3"; inchiKey "LRHPLDYGYMQRHN-UHFFFAOYSA-N"; }
            toluene        { cas "108-88-3"; inchiKey "YXFVVABEGXRONW-UHFFFAOYSA-N"; }
        }
    }
);
