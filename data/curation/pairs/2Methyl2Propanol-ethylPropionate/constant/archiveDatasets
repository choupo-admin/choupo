/*--------------------------------*- Choupo -*--------------------------------*\
  constant/archiveDatasets -- WHERE the measurements of 2Methyl2Propanol-ethylPropionate
  come from, and how to regenerate them.  NO MEASURED POINT IS IN THIS TREE
  (Vitor, 2026-11-10: the measured series are not copied; only the fitted
  parameters are kept).  `bin/choupo-curate fetch <case>` writes each
  dataset into constant/archiveExtracts/ (gitignored): the article file is taken from
  the local ThermoML cache when it holds it, else from the NIST URL below,
  and BOTH sha256 sums are checked -- a mismatch refuses, an unreachable
  NIST is reported NOT RUN, never a pass.
\*-----------------------------------------------------------------------------*/

recordType    archiveDatasets;

archive
{
    tarball   "ThermoML.v2020-09-30.tgz";
    doi       "10.18434/mds2-2422";
    note      "the finding aid; each article file is also served one by one at the NIST URL";
}

datasets
(
    {
        file          "constant/archiveExtracts/ethylPropionate-2Methyl2Propanol-bubble-je0202073.dat";
        role          fit;   // C283: every laboratory is fitted
        doi           "10.1021/je0202073";
        url           "https://trc.nist.gov/ThermoML/10.1021/je0202073.xml";
        page          "https://trc.nist.gov/ThermoML/10.1021/je0202073.json";
        articleFile   "je0202073.xml";
        articleSha256 "b03e251e0109e291a7c3bfd18d61e691063a4ec1e3b2210dd23312c3ee53f9b0";
        block         25;
        filter        ( --interior-only );
        extract       "bin/choupo-thermoml extract-vle <article file> --block 25 --interior-only --into <dir>";
        sha256        "ddfea850517fddb88cd22506250e0aee27b22981ed1f637df51379a2f074dec8";
        identity
        {
            ethylPropionate { cas "105-37-3"; inchiKey "FKRCODPIKNYEAC-UHFFFAOYSA-N"; }
            2Methyl2Propanol { cas "75-65-0"; inchiKey "DKGAVHZHDRPRBM-UHFFFAOYSA-N"; }
        }
    }
);
