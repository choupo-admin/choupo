    refusal        "No independent experimental evidence remains after fitting.";

    fittedParameters
    {
        equilibrium.liquid.activityModel.binaryParameters.isopropanol-2Methoxyethanol.b_ij  357.139004807;
        equilibrium.liquid.activityModel.binaryParameters.isopropanol-2Methoxyethanol.b_ji  -217.122103214;
    }

    evidence
    {
        partitionFingerprint  "a4eea6005d251d37";   // frozen before the fit

        datasets
        (
        {
            role      fit;
            dataset   "constant/archiveExtracts/isopropanol-2Methoxyethanol-bubble-j.fluid.2007.09.014.dat";
            doi       "10.1016/j.fluid.2007.09.014";
            sha256    "1a941fcef044b10b910fb6eb431a005076144b4b9414d6581ff49e84e1c6dcdb";
            provenance measured;
            archiveFile "j.fluid.2007.09.014.xml";
            system    "isopropanol + 2Methoxyethanol";
            pressure  "101300.000000 Pa";
        }
        );

        domain
        {
            coordinate  x1;
            fit         { min 0.05; max 0.942; n 18; }
        }
    }

    metrics
    {
        //  r2InSample: not computed by this operation (it reports chi-square).
