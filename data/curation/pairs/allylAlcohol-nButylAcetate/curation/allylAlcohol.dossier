        equilibrium.liquid.activityModel.binaryParameters.allylAlcohol-nButylAcetate.b_ij  745.079161288;
        equilibrium.liquid.activityModel.binaryParameters.allylAlcohol-nButylAcetate.b_ji  -355.128474829;
    }

