            provenance measured;
            archiveFile "acs.jced.8b00063.xml";
            system    "methylAcetate + anisole";
            pressure  "93900.000000 Pa";
        }
        );

        domain
        {
            coordinate  x1;
            fit         { min 0.032; max 0.9495; n 11; }
        }
    }

    metrics
    {
