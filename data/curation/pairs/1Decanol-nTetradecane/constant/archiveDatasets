/*--------------------------------*- Choupo -*--------------------------------*\
  constant/archiveDatasets -- WHERE the measurements of 1Decanol-nTetradecane
  come from, and how to regenerate them.  NO MEASURED POINT IS IN THIS TREE
  (Vitor, 2026-11-10: the measured series are not copied; only the fitted
  parameters are kept).  `bin/choupo-curate fetch <case>` writes each
  dataset into constant/archiveExtracts/ (gitignored): the article file is taken from
  the local ThermoML cache when it holds it, else from the NIST URL below,
  and BOTH sha256 sums are checked -- a mismatch refuses, an unreachable
  NIST is reported NOT RUN, never a pass.
\*-----------------------------------------------------------------------------*/

recordType    archiveDatasets;

archive
{
    tarball   "ThermoML.v2020-09-30.tgz";
    doi       "10.18434/mds2-2422";
    note      "the finding aid; each article file is also served one by one at the NIST URL";
}

datasets
(
    {
        file          "constant/archiveExtracts/1Decanol-nTetradecane-bubble-acs.jced.8b00680.dat";
        role          fit;   // C283: every laboratory is fitted
        doi           "10.1021/acs.jced.8b00680";
        url           "https://trc.nist.gov/ThermoML/10.1021/acs.jced.8b00680.xml";
        page          "https://trc.nist.gov/ThermoML/10.1021/acs.jced.8b00680.json";
        articleFile   "acs.jced.8b00680.xml";
        articleSha256 "24e5d0a547f0ece199cef88e38a33059d446a79066ec16e532dde61242113b94";
        block         22;
        filter        ( --interior-only );
        extract       "bin/choupo-thermoml extract-vle <article file> --block 22 --interior-only --into <dir>";
        sha256        "a59987a1c4994e87472accdddfee531290b22b1ef6f7898bc403d3c277a0283b";
        identity
        {
            1Decanol       { cas "112-30-1"; inchiKey "MWKFXSUHUHTGQN-UHFFFAOYSA-N"; }
            nTetradecane   { cas "629-59-4"; inchiKey "BGHCVCJVXZWKCC-UHFFFAOYSA-N"; }
        }
    }
);
