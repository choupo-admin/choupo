            provenance measured;
            archiveFile "acs.jced.8b00680.xml";
            system    "1Decanol + nTetradecane";
            pressure  "40000.000000 Pa";
        }
        );

        domain
        {
            coordinate  x1;
            fit         { min 0.011; max 0.994; n 44; }
        }
    }

    metrics
    {
        //  r2InSample: not computed by this operation (it reports chi-square).
