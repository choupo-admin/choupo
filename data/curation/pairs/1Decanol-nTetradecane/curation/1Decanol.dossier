    {
        equilibrium.liquid.activityModel.binaryParameters.1Decanol-nTetradecane.b_ij  185.533616406;
        equilibrium.liquid.activityModel.binaryParameters.1Decanol-nTetradecane.b_ji  276.185610611;
    }

    evidence
    {
        partitionFingerprint  "f69036ce4d52f65a";   // frozen before the fit

