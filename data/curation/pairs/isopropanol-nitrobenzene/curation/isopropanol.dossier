    fittedParameters
    {
        equilibrium.liquid.activityModel.binaryParameters.isopropanol-nitrobenzene.b_ij  560.878317381;
        equilibrium.liquid.activityModel.binaryParameters.isopropanol-nitrobenzene.b_ji  -573.043158505;
    }

    evidence
    {
        partitionFingerprint  "b7353298aa054343";   // frozen before the fit

