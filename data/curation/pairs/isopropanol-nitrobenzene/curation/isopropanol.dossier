        (
        {
            role      fit;
            dataset   "constant/archiveExtracts/isopropanol-nitrobenzene-bubble-j.jct.2005.08.011.dat";
            doi       "10.1016/j.jct.2005.08.011";
            sha256    "851cdb6ff7bdf3d7c26cd45d5747115356958c2a46697532260c787131a443cd";
            provenance measured;
            archiveFile "j.jct.2005.08.011.xml";
            system    "isopropanol + nitrobenzene";
            pressure  "94950.000000 Pa";
        }
        );

        domain
        {
            coordinate  x1;
            fit         { min 0.0851; max 0.9508; n 13; }
        }
    }

    metrics
    {
