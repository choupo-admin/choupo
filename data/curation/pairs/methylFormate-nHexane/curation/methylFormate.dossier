        equilibrium.liquid.activityModel.binaryParameters.methylFormate-nHexane.b_ij  590.715270222;
        equilibrium.liquid.activityModel.binaryParameters.methylFormate-nHexane.b_ji  262.135110755;
    }

    evidence
    {
        partitionFingerprint  "f96be4050587e567";   // frozen before the fit

