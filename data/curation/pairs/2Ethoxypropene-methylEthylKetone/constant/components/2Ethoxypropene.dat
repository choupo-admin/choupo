        }
    }
    liquidHeatCapacity
    {
        origin           estimated;
        method           "Rowlinson-Bondi corresponding states, Poling, Prausnitz & O'Connell, The Properties of Gases and Liquids, 5th ed. (2001), Eq. (6-6.4): (Cp_L - Cp_ig)/R = 1.586 + 0.49/(1 - Tr) + omega [4.2775 + 6.3 (1 - Tr)^(1/3)/Tr + 0.4355/(1 - Tr)], with this record's Joback Cp_ig, Tc (Joback ESTIMATE) and omega; represented by a quadratic in T least-squares fitted to the equation over 320.98-334.67 K (the fitted vapour pressure's span within 0.40-0.80 Tc), max deviation 0.000 % from it";
        computedBy       "bin/curate/c287_new_components.py (rowlinson_bondi)";
        inputFingerprint "CH2:1,CH3:2,eC:1,eCH2:1,ether:1";
        reproducedInCase "data/curation/batches/new_components_c309";
        uncertainty      { status unquantified; reason "Poling 5e p. 6.22: 2.5 % AAD on 194 substances at 298 K, more than 10 % on 18 others, most hydrogen-bonded (C1-C4 alcohols and acids, water, amines); the archive locates no liquid Cp for this compound and no Zabransky supplement in hand recommends one"; }
        reviewStatus     autoPromoted;
        review           { by none; }   // DEV.md 4c C300 rule 4 (C297): nobody has reviewed it
    }
    idealGasHeatCapacity
