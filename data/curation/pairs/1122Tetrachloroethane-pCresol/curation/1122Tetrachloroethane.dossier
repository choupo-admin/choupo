    refusal        "No independent experimental evidence remains after fitting.";

    fittedParameters
    {
        equilibrium.liquid.activityModel.binaryParameters.1122Tetrachloroethane-pCresol.b_ij  526.206191294;
        equilibrium.liquid.activityModel.binaryParameters.1122Tetrachloroethane-pCresol.b_ji  -577.45764168;
    }

    evidence
    {
        partitionFingerprint  "d9959f49e2fd1d7d";   // frozen before the fit

        datasets
        (
        {
            role      fit;
            dataset   "constant/archiveExtracts/1122Tetrachloroethane-pCresol-bubble-j.jct.2006.12.017.dat";
            doi       "10.1016/j.jct.2006.12.017";
            sha256    "7ba8e22852100570d12f88eb467c03b133f18106c8bf1effea9bc164e0a62ed7";
            provenance measured;
            archiveFile "j.jct.2006.12.017.xml";
            system    "1122Tetrachloroethane + pCresol";
            pressure  "95230.000000 Pa";
        }
        );

        domain
        {
            coordinate  x1;
            fit         { min 0.0515; max 0.9002; n 10; }
        }
    }

    metrics
    {
        //  r2InSample: not computed by this operation (it reports chi-square).
        //  NO HELD-OUT METRIC EXISTS.  r2InSample above is exactly that --
        //  in-sample -- and must not be read as an external check.
    }
}

