            { doi "10.1016/j.tca.2014.06.031"; articleSha256 "0141a01fd2e7887bce9bc7e3ce8cd00ec751bfd03f3d7180f2a8a3a8e03a216b"; pointsKept 5; pointsDropped 0; provenance measured; }
            { doi "10.1021/acs.jced.5b00971"; articleSha256 "f7199d692a06467f6378c7a5d489850108c499f5e2003d98858ac605bfe820b1"; pointsKept 8; pointsDropped 0; provenance measured; }
            { doi "10.1021/acs.jced.8b01189"; articleSha256 "039649ae543046c2c26f18a1592a52566189cedf1f1184539b6787a9b2f8b34f"; pointsKept 1; pointsDropped 0; provenance measured; }
            { doi "10.1021/je1002829"; articleSha256 "59a2052d794132a2ceeca1ec65d7bae68f628ef032539c05a01e485b980c3afc"; pointsKept 4; pointsDropped 0; provenance measured; }
