        equilibrium.liquid.activityModel.binaryParameters.acetone-furfural.b_ij  -232.75219367;
        equilibrium.liquid.activityModel.binaryParameters.acetone-furfural.b_ji  185.64436063;
    }

    evidence
    {
        partitionFingerprint  "fcf9b313e517f272";   // frozen before the fit

        datasets
