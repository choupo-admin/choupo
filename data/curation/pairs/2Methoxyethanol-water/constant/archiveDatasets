/*--------------------------------*- Choupo -*--------------------------------*\
  constant/archiveDatasets -- WHERE the measurements of 2Methoxyethanol-water
  come from, and how to regenerate them.  NO MEASURED POINT IS IN THIS TREE
  (Vitor, 2026-11-10: the measured series are not copied; only the fitted
  parameters are kept).  `bin/choupo-curate fetch <case>` writes each
  dataset into constant/archiveExtracts/ (gitignored): the article file is taken from
  the local ThermoML cache when it holds it, else from the NIST URL below,
  and BOTH sha256 sums are checked -- a mismatch refuses, an unreachable
  NIST is reported NOT RUN, never a pass.
\*-----------------------------------------------------------------------------*/

recordType    archiveDatasets;

archive
{
    tarball   "ThermoML.v2020-09-30.tgz";
    doi       "10.18434/mds2-2422";
    note      "the finding aid; each article file is also served one by one at the NIST URL";
}

datasets
(
    {
        file          "constant/archiveExtracts/water-2Methoxyethanol-bubble-je400791n.dat";
        role          fit;   // C283: every laboratory is fitted
        doi           "10.1021/je400791n";
        url           "https://trc.nist.gov/ThermoML/10.1021/je400791n.xml";
        page          "https://trc.nist.gov/ThermoML/10.1021/je400791n.json";
        articleFile   "je400791n.xml";
        articleSha256 "1bdc9f4cb2920907919b64ec3c2c9dbcd186d090a985623891577597239b695c";
        block         8;
        filter        ( --interior-only );
        extract       "bin/choupo-thermoml extract-vle <article file> --block 8 --interior-only --into <dir>";
        sha256        "a65e49a05e975b430fea36a6a7d88989de08c0a5f71ead19fc1434166e49c5e0";
        identity
        {
            water          { cas "7732-18-5"; inchiKey "XLYOFNOQVPJJNP-UHFFFAOYSA-N"; }
            2Methoxyethanol { cas "109-86-4"; inchiKey "XNWFRZJHXBZDAG-UHFFFAOYSA-N"; }
        }
    }
    {
        file          "constant/archiveExtracts/water-2Methoxyethanol-bubble-acs.jced.6b00895.dat";
        role          fit;   // C283: every laboratory is fitted
        doi           "10.1021/acs.jced.6b00895";
        url           "https://trc.nist.gov/ThermoML/10.1021/acs.jced.6b00895.xml";
        page          "https://trc.nist.gov/ThermoML/10.1021/acs.jced.6b00895.json";
        articleFile   "acs.jced.6b00895.xml";
        articleSha256 "0ae2e355a34202e32a89a88b12de714caef2b7db39d7b78295fcb8eac63e0cd6";
        block         4;
        filter        ( --interior-only );
        xOf           water;   // the article reports the other member; x = 1 - x'
        extract       "bin/choupo-thermoml extract-vle <article file> --block 4 --interior-only --x-of water --into <dir>";
        sha256        "8cf4c41debc5cc7a17730503fd6af90af4e6ce1d52735ecd70e01c374cb341b8";
        identity
        {
            water          { cas "7732-18-5"; inchiKey "XLYOFNOQVPJJNP-UHFFFAOYSA-N"; }
            2Methoxyethanol { cas "109-86-4"; inchiKey "XNWFRZJHXBZDAG-UHFFFAOYSA-N"; }
        }
    }
);
