name        2Methoxyethanol;
CAS         109-86-4;
formula     C3H8O2;
reviewStatus autoPromoted;
humanReviewed false;
MW          76.0950;      // kg/kmol, from the formula (IUPAC standard atomic weights)
Tc          597.6;      // K, IUPAC recommended (provenance.Tc)
Pc          52.8;      // bar, IUPAC recommended (provenance.Pc)
omega       0.426839;      // [-] (provenance.omega)
Tb          397.67;      // K, measured (provenance.Tb)

standardThermochemistry
{
    dHf_298   -389700;        // J/mol, ideal gas, Joback ESTIMATE (provenance.dHf_298)
    s_298     335.03;        // J/(mol K), ideal gas, DERIVED from Joback (provenance.s_298)
}

vaporPressure
{
    model         Antoine;
    // log10(Psat [bar]) = A - B / (T[K] + C), FITTED by bin/choupo-curate vp to
    // measured vapour pressures -- see provenance.vaporPressure
    coefficients  (8.425541508  4809.159252  173.2309341);
    Trange        (336.18  416.6);   // the fit's own span; outside it the engine announces the extrapolation
}

Vliq        7.726155e-05;      // m3/mol at 25 C, FITTED (provenance.Vliq)

idealGasHeatCapacity
{
    model         polynomial;
    // Cp [J/(mol K)] = a0 + a1 T + a2 T^2 + a3 T^3, Joback ESTIMATE
    coefficients  (30.952  0.25962  -5.880000e-05  -2.050000e-08);
    Trange        (273  1000);
}

liquidHeatCapacity
{
    model         polynomial;
    // Cp [J/(mol K)] = a0 + a1 T + a2 T^2, FITTED (provenance.liquidHeatCapacity)
    coefficients  (83.94829562  0.3065411552);
    Trange        (298.15  323.15);
}

