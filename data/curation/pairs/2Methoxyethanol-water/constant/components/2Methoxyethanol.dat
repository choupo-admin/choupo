// (DEV.md 4c C294; bin/curate/uniquac_rq_from_groups.py).
uniquac
{
    r   3.0237;
    q   2.7520;
}

groups
{
    unifac ( { group CH3; count 1; } { group C2H5O2; count 1; } );
    joback ( { group CH3; count 1; } { group CH2; count 2; } { group ether; count 1; } { group OH; count 1; } );
}

