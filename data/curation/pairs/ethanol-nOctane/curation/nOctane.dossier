    fittedParameters
    {
        equilibrium.liquid.activityModel.binaryParameters.nOctane-ethanol.b_ij  506.634760599;
        equilibrium.liquid.activityModel.binaryParameters.nOctane-ethanol.b_ji  442.062129102;
    }

    evidence
    {
