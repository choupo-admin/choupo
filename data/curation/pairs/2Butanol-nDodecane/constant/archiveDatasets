/*--------------------------------*- Choupo -*--------------------------------*\
  constant/archiveDatasets -- WHERE the measurements of 2Butanol-nDodecane
  come from, and how to regenerate them.  NO MEASURED POINT IS IN THIS TREE
  (Vitor, 2026-11-10: the measured series are not copied; only the fitted
  parameters are kept).  `bin/choupo-curate fetch <case>` writes each
  dataset into constant/archiveExtracts/ (gitignored): the article file is taken from
  the local ThermoML cache when it holds it, else from the NIST URL below,
  and BOTH sha256 sums are checked -- a mismatch refuses, an unreachable
  NIST is reported NOT RUN, never a pass.  The extractor is `extract-px`
  (a bubble-PRESSURE block at a stated temperature, DEV.md 4c C291).
\*-----------------------------------------------------------------------------*/

recordType    archiveDatasets;

archive
{
    tarball   "ThermoML.v2020-09-30.tgz";
    doi       "10.18434/mds2-2422";
    note      "the finding aid; each article file is also served one by one at the NIST URL";
}

datasets
(
    {
        file          "constant/archiveExtracts/2Butanol-nDodecane-bubbleP-je201284y-b10.dat";
        role          fit;   // C283: every laboratory is fitted
        doi           "10.1021/je201284y";
        url           "https://trc.nist.gov/ThermoML/10.1021/je201284y.xml";
        page          "https://trc.nist.gov/ThermoML/10.1021/je201284y.json";
        articleFile   "je201284y.xml";
        articleSha256 "ef1706a2a3cd9237639a842b124b07d2059f542451ca22f861316c8d74a0f062";
        block         10;
        extractor     bubblePressure;
        extract       "bin/choupo-thermoml extract-px <article file> --block 10 --into <dir>";
        sha256        "7ab2281810bdce5186a2dafd8c24cd0bfac89dfbf7aefca53cc226067442fe2f";
        identity
        {
            2Butanol       { cas "78-92-2"; inchiKey "BTANRVKWQNVYAZ-UHFFFAOYSA-N"; }
            nDodecane      { cas "112-40-3"; inchiKey "SNRUBQQJIBEYMU-UHFFFAOYSA-N"; }
        }
    }
);
