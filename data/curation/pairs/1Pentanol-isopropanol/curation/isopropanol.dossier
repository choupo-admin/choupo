            dataset   "constant/archiveExtracts/isopropanol-1Pentanol-bubble-j.fluid.2012.12.020.dat";
            doi       "10.1016/j.fluid.2012.12.020";
            sha256    "5c6ee203786249cfbc857d1d06c431f4c46880db0cdc71afdc551d1ba120904d";
            provenance measured;
            archiveFile "j.fluid.2012.12.020.xml";
            system    "isopropanol + 1Pentanol";
            pressure  "101000.000000 Pa";
        }
        );

        domain
        {
            coordinate  x1;
            fit         { min 0.0156; max 0.9032; n 24; }
        }
    }

    metrics
    {
        //  r2InSample: not computed by this operation (it reports chi-square).
        //  NO HELD-OUT METRIC EXISTS.  r2InSample above is exactly that --
        //  in-sample -- and must not be read as an external check.
