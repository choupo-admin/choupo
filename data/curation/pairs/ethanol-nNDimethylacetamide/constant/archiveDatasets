/*--------------------------------*- Choupo -*--------------------------------*\
  constant/archiveDatasets -- WHERE the measurements of ethanol-nNDimethylacetamide
  come from, and how to regenerate them.  NO MEASURED POINT IS IN THIS TREE
  (Vitor, 2026-11-10: the measured series are not copied; only the fitted
  parameters are kept).  `bin/choupo-curate fetch <case>` writes each
  dataset into constant/archiveExtracts/ (gitignored): the article file is taken from
  the local ThermoML cache when it holds it, else from the NIST URL below,
  and BOTH sha256 sums are checked -- a mismatch refuses, an unreachable
  NIST is reported NOT RUN, never a pass.  The extractor is `extract-px`
  (a bubble-PRESSURE block at a stated temperature, DEV.md 4c C291).
\*-----------------------------------------------------------------------------*/

recordType    archiveDatasets;

archive
{
    tarball   "ThermoML.v2020-09-30.tgz";
    doi       "10.18434/mds2-2422";
    note      "the finding aid; each article file is also served one by one at the NIST URL";
}

datasets
(
    {
        file          "constant/archiveExtracts/ethanol-nNDimethylacetamide-bubbleP-acs.jced.7b00119-b21.dat";
        role          fit;   // C283: every laboratory is fitted
        doi           "10.1021/acs.jced.7b00119";
        url           "https://trc.nist.gov/ThermoML/10.1021/acs.jced.7b00119.xml";
        page          "https://trc.nist.gov/ThermoML/10.1021/acs.jced.7b00119.json";
        articleFile   "acs.jced.7b00119.xml";
        articleSha256 "c57dbb0a0bf3405a8a631fa0f45bc2682f03b5dd1ee020e8b3f07b3a0dafe997";
        block         21;
        extractor     bubblePressure;
        extract       "bin/choupo-thermoml extract-px <article file> --block 21 --into <dir>";
        sha256        "e381e7d06aa8ca375bf42c33bc0d89e8f48c90ccc5280b52290ae83ee0a59ab9";
        identity
        {
            ethanol        { cas "64-17-5"; inchiKey "LFQSCWFLJHTTHZ-UHFFFAOYSA-N"; }
            nNDimethylacetamide { cas "127-19-5"; inchiKey "FXHOOIRPVKKKFG-UHFFFAOYSA-N"; }
        }
    }
    {
        file          "constant/archiveExtracts/ethanol-nNDimethylacetamide-bubbleP-j.jct.2005.08.001-b7.dat";
        role          fit;   // C283: every laboratory is fitted
        doi           "10.1016/j.jct.2005.08.001";
        url           "https://trc.nist.gov/ThermoML/10.1016/j.jct.2005.08.001.xml";
        page          "https://trc.nist.gov/ThermoML/10.1016/j.jct.2005.08.001.json";
        articleFile   "j.jct.2005.08.001.xml";
        articleSha256 "5de52fee95970543a46d21a2ef0bb6beea7c54542637858dfcc7a5bebdd8252e";
        block         7;
        extractor     bubblePressure;
        xOf           ethanol;   // the article reports the other member; x = 1 - x'
        extract       "bin/choupo-thermoml extract-px <article file> --block 7 --x-of ethanol --into <dir>";
        sha256        "471a03e959c5f7a52cd8bfd71e97bca53fee58150991b35fc450aabb129b3bd3";
        identity
        {
            ethanol        { cas "64-17-5"; inchiKey "LFQSCWFLJHTTHZ-UHFFFAOYSA-N"; }
            nNDimethylacetamide { cas "127-19-5"; inchiKey "FXHOOIRPVKKKFG-UHFFFAOYSA-N"; }
        }
    }
);
