/*--------------------------------*- Choupo -*--------------------------------*\
  constant/archiveDatasets -- WHERE the measurements of furfural-water
  come from, and how to regenerate them.  NO MEASURED POINT IS IN THIS TREE
  (Vitor, 2026-11-10: the measured series are not copied; only the fitted
  parameters are kept).  `bin/choupo-curate fetch <case>` writes each
  dataset into constant/archiveExtracts/ (gitignored): the article file is taken from
  the local ThermoML cache when it holds it, else from the NIST URL below,
  and BOTH sha256 sums are checked -- a mismatch refuses, an unreachable
  NIST is reported NOT RUN, never a pass.
\*-----------------------------------------------------------------------------*/

recordType    archiveDatasets;

archive
{
    tarball   "ThermoML.v2020-09-30.tgz";
    doi       "10.18434/mds2-2422";
    note      "the finding aid; each article file is also served one by one at the NIST URL";
}

datasets
(
    {
        file          "constant/archiveExtracts/water-furfural-bubble-je020053r.dat";
        role          fit;   // C283: every laboratory is fitted
        doi           "10.1021/je020053r";
        url           "https://trc.nist.gov/ThermoML/10.1021/je020053r.xml";
        page          "https://trc.nist.gov/ThermoML/10.1021/je020053r.json";
        articleFile   "je020053r.xml";
        articleSha256 "5e67753e8631f0d0cb1cf7de5d77c2eda4b654762574f71c0762f4396ddebf8d";
        block         8;
        filter        ( --interior-only );
        extract       "bin/choupo-thermoml extract-vle <article file> --block 8 --interior-only --into <dir>";
        sha256        "836579f5accf31373daec138159e2e948c6e0a7021869e07644c20c5300900f4";
        identity
        {
            water          { cas "7732-18-5"; inchiKey "XLYOFNOQVPJJNP-UHFFFAOYSA-N"; }
            furfural       { cas "98-01-1"; inchiKey "HYBBIBNJHNGZAN-UHFFFAOYSA-N"; }
        }
    }
);
