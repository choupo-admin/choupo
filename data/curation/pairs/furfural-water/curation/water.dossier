            dataset   "constant/archiveExtracts/water-furfural-bubble-je020053r.dat";
            doi       "10.1021/je020053r";
            sha256    "5e67753e8631f0d0cb1cf7de5d77c2eda4b654762574f71c0762f4396ddebf8d";
            provenance measured;
            archiveFile "je020053r.xml";
            system    "water + furfural";
            pressure  "94600.000000 Pa";
        }
        );

        domain
        {
            coordinate  x1;
            fit         { min 0.1193; max 0.995; n 10; }
        }
    }

    metrics
    {
        //  r2InSample: not computed by this operation (it reports chi-square).
        //  NO HELD-OUT METRIC EXISTS.  r2InSample above is exactly that --
