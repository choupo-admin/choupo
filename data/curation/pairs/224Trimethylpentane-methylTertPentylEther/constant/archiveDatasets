/*--------------------------------*- Choupo -*--------------------------------*\
  constant/archiveDatasets -- WHERE the measurements of 224Trimethylpentane-methylTertPentylEther
  come from, and how to regenerate them.  NO MEASURED POINT IS IN THIS TREE
  (Vitor, 2026-11-10: the measured series are not copied; only the fitted
  parameters are kept).  `bin/choupo-curate fetch <case>` writes each
  dataset into constant/archiveExtracts/ (gitignored): the article file is taken from
  the local ThermoML cache when it holds it, else from the NIST URL below,
  and BOTH sha256 sums are checked -- a mismatch refuses, an unreachable
  NIST is reported NOT RUN, never a pass.  The extractor is `extract-px`
  (a bubble-PRESSURE block at a stated temperature, DEV.md 4c C291).
\*-----------------------------------------------------------------------------*/

recordType    archiveDatasets;

archive
{
    tarball   "ThermoML.v2020-09-30.tgz";
    doi       "10.18434/mds2-2422";
    note      "the finding aid; each article file is also served one by one at the NIST URL";
}

datasets
(
    {
        file          "constant/archiveExtracts/methylTertPentylEther-224Trimethylpentane-bubbleP-j.fluid.2009.03.026-b2.dat";
        role          fit;   // C283: every laboratory is fitted
        doi           "10.1016/j.fluid.2009.03.026";
        url           "https://trc.nist.gov/ThermoML/10.1016/j.fluid.2009.03.026.xml";
        page          "https://trc.nist.gov/ThermoML/10.1016/j.fluid.2009.03.026.json";
        articleFile   "j.fluid.2009.03.026.xml";
        articleSha256 "3acf659991a9818fba6ee5464d5875422c7070a75c372b71daabb6482fbf10d9";
        block         2;
        extractor     bubblePressure;
        extract       "bin/choupo-thermoml extract-px <article file> --block 2 --into <dir>";
        sha256        "b7483ce30d2d0ccf348e68e3b7fad53ce1c477520d3280a8c0d6390a2c4e6889";
        identity
        {
            methylTertPentylEther { cas "994-05-8"; inchiKey "HVZJRWJGKQPSFL-UHFFFAOYSA-N"; }
            224Trimethylpentane { cas "540-84-1"; inchiKey "NHTMVDHEPJAVLT-UHFFFAOYSA-N"; }
        }
    }
);
