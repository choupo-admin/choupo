    fittedParameters
    {
        equilibrium.liquid.activityModel.binaryParameters.styrene-sulfolane.b_ij  713.235266414;
        equilibrium.liquid.activityModel.binaryParameters.styrene-sulfolane.b_ji  131.098557587;
    }

    evidence
    {
        partitionFingerprint  "c460250cc25afc15";   // frozen before the fit

