        equilibrium.liquid.activityModel.binaryParameters.cyclohexane-1122Tetrachloroethane.b_ij  513.754214104;
        equilibrium.liquid.activityModel.binaryParameters.cyclohexane-1122Tetrachloroethane.b_ji  -174.728801045;
    }

    evidence
    {
        partitionFingerprint  "5c9b3e67633d6874";   // frozen before the fit

        datasets
        (
        {
            role      fit;
            dataset   "constant/archiveExtracts/cyclohexane-1122Tetrachloroethane-bubble-je020148t.dat";
            doi       "10.1021/je020148t";
            sha256    "d050eca5b9e079c12efbc563ccbe13ba0767c44a1d625df7ba1b8c73d98b46fa";
