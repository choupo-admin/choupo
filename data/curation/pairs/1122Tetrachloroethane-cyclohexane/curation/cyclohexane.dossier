            archiveFile "je020148t.xml";
            system    "cyclohexane + 1122Tetrachloroethane";
            pressure  "94700.000000 Pa";
        }
        );

        domain
        {
            coordinate  x1;
            fit         { min 0.1399; max 0.9269; n 6; }
        }
    }

    metrics
    {
        //  r2InSample: not computed by this operation (it reports chi-square).
