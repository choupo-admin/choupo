            doi       "10.1016/j.fluid.2011.10.009";
            sha256    "d87224cb001a1555a0336a273bc382d7a10ec99b3b075b40ae21b9807b9fc9db";
            provenance measured;
            archiveFile "j.fluid.2011.10.009.xml";
            system    "nNonane + mXylene";
            pressure  "101300.000000 Pa";
        }
        );

        domain
