    fittedParameters
    {
        equilibrium.liquid.activityModel.binaryParameters.tetrahydropyran-224Trimethylpentane.b_ij  106.988084895;
        equilibrium.liquid.activityModel.binaryParameters.tetrahydropyran-224Trimethylpentane.b_ji  -115.888153186;
    }

    evidence
    {
        partitionFingerprint  "0d157baa9f4a83d8";   // frozen before the fit

        datasets
        (
        {
            role      fit;
            dataset   "constant/archiveExtracts/tetrahydropyran-224Trimethylpentane-bubble-j.jct.2011.10.025.dat";
            doi       "10.1016/j.jct.2011.10.025";
            sha256    "d9f6a88060615631fce71b3187a31ace470278da59c293d2e62e44120e446882";
            provenance measured;
            archiveFile "j.jct.2011.10.025.xml";
            system    "tetrahydropyran + 224Trimethylpentane";
            pressure  "101300.000000 Pa";
        }
        );

        domain
        {
            coordinate  x1;
            fit         { min 0.078; max 0.951; n 19; }
        }
    }

    metrics
    {
        //  r2InSample: not computed by this operation (it reports chi-square).
