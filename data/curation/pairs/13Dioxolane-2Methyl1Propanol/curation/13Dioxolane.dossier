    fittedParameters
    {
        equilibrium.liquid.activityModel.binaryParameters.13Dioxolane-2Methyl1Propanol.b_ij  150.21679802;
        equilibrium.liquid.activityModel.binaryParameters.13Dioxolane-2Methyl1Propanol.b_ji  77.2671117657;
    }

    evidence
    {
        partitionFingerprint  "66ec906414b62651";   // frozen before the fit

        datasets
        (
        {
            role      fit;
            dataset   "constant/archiveExtracts/13Dioxolane-2Methyl1Propanol-bubble-j.jct.2003.09.001.dat";
            doi       "10.1016/j.jct.2003.09.001";
            sha256    "ed6d3c6e4b418beca21d9e9824b60a7dfd25c43695095885dd7f6bc8ef14dc91";
            provenance measured;
            archiveFile "j.jct.2003.09.001.xml";
            system    "13Dioxolane + 2Methyl1Propanol";
        }
        );

        domain
        {
            coordinate  x1;
            fit         { min 0.0425; max 0.9867; n 26; }
        }
    }

    metrics
    {
        //  r2InSample: not computed by this operation (it reports chi-square).
