/*--------------------------------*- Choupo -*--------------------------------*\
  constant/archiveDatasets -- WHERE the measurements of 1Pentanol-propionicAcid
  come from, and how to regenerate them.  NO MEASURED POINT IS IN THIS TREE
  (Vitor, 2026-11-10: the measured series are not copied; only the fitted
  parameters are kept).  `bin/choupo-curate fetch <case>` writes each
  dataset into constant/archiveExtracts/ (gitignored): the article file is taken from
  the local ThermoML cache when it holds it, else from the NIST URL below,
  and BOTH sha256 sums are checked -- a mismatch refuses, an unreachable
  NIST is reported NOT RUN, never a pass.
\*-----------------------------------------------------------------------------*/

recordType    archiveDatasets;

archive
{
    tarball   "ThermoML.v2020-09-30.tgz";
    doi       "10.18434/mds2-2422";
    note      "the finding aid; each article file is also served one by one at the NIST URL";
}

datasets
(
    {
        file          "constant/archiveExtracts/1Pentanol-propionicAcid-bubble-j.jct.2010.05.014.dat";
        role          fit;   // C283: every laboratory is fitted
        doi           "10.1016/j.jct.2010.05.014";
        url           "https://trc.nist.gov/ThermoML/10.1016/j.jct.2010.05.014.xml";
        page          "https://trc.nist.gov/ThermoML/10.1016/j.jct.2010.05.014.json";
        articleFile   "j.jct.2010.05.014.xml";
        articleSha256 "023f7f580895fb9ff669b698cac4e258fffe25547c1b0c6173e5181980f68c93";
        block         5;
        filter        ( --interior-only );
        extract       "bin/choupo-thermoml extract-vle <article file> --block 5 --interior-only --into <dir>";
        sha256        "4dd5a81035d68c8fc6a7e31e66d05971ec965e86e233e08f7b0e57dbef5420b4";
        identity
        {
            1Pentanol      { cas "71-41-0"; inchiKey "AMQJEAYHLZJPGS-UHFFFAOYSA-N"; }
            propionicAcid  { cas "79-09-4"; inchiKey "XBDQKXXYIPTUBI-UHFFFAOYSA-N"; }
        }
    }
);
