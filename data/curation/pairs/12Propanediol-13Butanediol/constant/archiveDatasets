/*--------------------------------*- Choupo -*--------------------------------*\
  constant/archiveDatasets -- WHERE the measurements of 12Propanediol-13Butanediol
  come from, and how to regenerate them.  NO MEASURED POINT IS IN THIS TREE
  (Vitor, 2026-11-10: the measured series are not copied; only the fitted
  parameters are kept).  `bin/choupo-curate fetch <case>` writes each
  dataset into constant/archiveExtracts/ (gitignored): the article file is taken from
  the local ThermoML cache when it holds it, else from the NIST URL below,
  and BOTH sha256 sums are checked -- a mismatch refuses, an unreachable
  NIST is reported NOT RUN, never a pass.
\*-----------------------------------------------------------------------------*/

recordType    archiveDatasets;

archive
{
    tarball   "ThermoML.v2020-09-30.tgz";
    doi       "10.18434/mds2-2422";
    note      "the finding aid; each article file is also served one by one at the NIST URL";
}

datasets
(
    {
        file          "constant/archiveExtracts/12Propanediol-13Butanediol-bubble-je400082c.dat";
        role          fit;   // C283: every laboratory is fitted
        doi           "10.1021/je400082c";
        url           "https://trc.nist.gov/ThermoML/10.1021/je400082c.xml";
        page          "https://trc.nist.gov/ThermoML/10.1021/je400082c.json";
        articleFile   "je400082c.xml";
        articleSha256 "45b473097c34d44a9a11577786b838439c05345f70703e65b8f716298765c316";
        block         4;
        filter        ( --interior-only );
        extract       "bin/choupo-thermoml extract-vle <article file> --block 4 --interior-only --into <dir>";
        sha256        "aa9f1fc334a4a6b93b926d970eb84a13d2beba14b5d0a468f4a6f2942f2e683b";
        identity
        {
            12Propanediol  { cas "57-55-6"; inchiKey "DNIAPMSPPWPWGF-UHFFFAOYSA-N"; }
            13Butanediol   { cas "107-88-0"; inchiKey "PUPZLCDOIYMWBV-UHFFFAOYSA-N"; }
        }
    }
);
