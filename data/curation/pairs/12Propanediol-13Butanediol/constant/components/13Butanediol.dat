name        13Butanediol;
CAS         107-88-0;
formula     C4H10O2;
reviewStatus autoPromoted;
humanReviewed false;
MW          90.1220;      // kg/kmol, from the formula (IUPAC standard atomic weights)
Tc          692.4;      // K, measured (provenance.Tc)
Pc          51.8;      // bar, measured (provenance.Pc)
omega       0.697184;      // [-] (provenance.omega)
//  Tb: NOT DECLARED -- the archive reports no boiling temperature at
//  101.3 kPa for it, and a Tb read back off the fitted Antoine would be
//  the curve tested against itself (the fitted normal boiling point is
//  in provenance.vaporPressure.acceptance.Tnb_fit).

standardThermochemistry
{
    dHf_298   -435630;        // J/mol, ideal gas, Joback ESTIMATE (provenance.dHf_298)
    s_298     404.07;        // J/(mol K), ideal gas, DERIVED from Joback (provenance.s_298)
}

vaporPressure
{
    model         Antoine;
    // log10(Psat [bar]) = A - B / (T[K] + C), FITTED by bin/choupo-curate vp to
    // measured vapour pressures -- see provenance.vaporPressure
    coefficients  (5.022834927  1987.112327  -87.70918359);
    Trange        (288.3  688.2);   // the fit's own span; outside it the engine announces the extrapolation
}

Vliq        8.952617e-05;      // m3/mol at 25 C, FITTED (provenance.Vliq)

idealGasHeatCapacity
{
    model         polynomial;
    // Cp [J/(mol K)] = a0 + a1 T + a2 T^2 + a3 T^3, Joback ESTIMATE
    coefficients  (8.152  0.45772  -2.578000e-04  5.550000e-08);
    Trange        (273  1000);
}

liquidHeatCapacity
{
    model         polynomial;
    // Cp [J/(mol K)] = a0 + a1 T + a2 T^2, FITTED (provenance.liquidHeatCapacity)
    coefficients  (84.81397673  0.2791071578  0.0005777759657);
    Trange        (285.15  353.15);
}

