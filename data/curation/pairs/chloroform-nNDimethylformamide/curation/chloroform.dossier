    refusal        "No independent experimental evidence remains after fitting.";

    fittedParameters
    {
        equilibrium.liquid.activityModel.binaryParameters.chloroform-nNDimethylformamide.b_ij  820.15012573;
        equilibrium.liquid.activityModel.binaryParameters.chloroform-nNDimethylformamide.b_ji  -371.79879669;
    }

    evidence
    {
        partitionFingerprint  "2271198b974fb739";   // frozen before the fit

        datasets
        (
        {
            role      fit;
            dataset   "constant/archiveExtracts/chloroform-nNDimethylformamide-bubble-j.fluid.2009.01.006.dat";
            doi       "10.1016/j.fluid.2009.01.006";
            sha256    "eaf7a06752baab1d0a6970e5d58ba2114668e13e50499653ec47bea6a9de77dc";
            provenance measured;
            archiveFile "j.fluid.2009.01.006.xml";
            system    "chloroform + nNDimethylformamide";
            pressure  "101300.000000 Pa";
        }
        );

        domain
        {
            coordinate  x1;
            fit         { min 0.0412; max 0.9158; n 14; }
        }
    }

    metrics
    {
        //  r2InSample: not computed by this operation (it reports chi-square).
