operations
(
    {
        name        fit_nrtl;
        type        fitParameters;

        parameters
        (
            { path  equilibrium.liquid.activityModel.binaryParameters.oCresol-ethanol.b_ij;  initial 0;  min -3000;  max 3000; }
            { path  equilibrium.liquid.activityModel.binaryParameters.oCresol-ethanol.b_ji;  initial 0;  min -3000;  max 3000; }
        );

        evidence
        (
            {
                dataset  "constant/archiveExtracts/oCresol-ethanol-bubble-j.fluid.2017.09.008.dat";
                role     fit;
                discard  ( 39 40 41 42 47 48 49 52 53 54 55 );   // C283 outliers, by name in the header
            }
            {
                dataset  "constant/archiveExtracts/oCresol-ethanol-bubble-j.fluid.2006.03.018.dat";
                role     fit;
            }
        );

        objective { method twoStage;  scale { T_bubble absolute; } }
        residual
        {
            kind        T_bubble;
            components  ( oCresol ethanol );
            weighting   uncertainty;
        }

        options
        {
            maxIter      80;
            tolerance    1.0e-6;
            fdStep       1.0e-4;
            lambda0      1.0e-3;
        }

        output
        {
            fit_log    fit_history.csv;
            parity     parity.csv;
            proposal   ethanol-oCresol.proposal.dat;
        }
    }
    {
        name        fit_nrtl_start2;
        type        fitParameters;

        parameters
        (
            { path  equilibrium.liquid.activityModel.binaryParameters.oCresol-ethanol.b_ij;  initial 800;  min -3000;  max 3000; }
            { path  equilibrium.liquid.activityModel.binaryParameters.oCresol-ethanol.b_ji;  initial -400;  min -3000;  max 3000; }
        );

        evidence
        (
            {
                dataset  "constant/archiveExtracts/oCresol-ethanol-bubble-j.fluid.2017.09.008.dat";
                role     fit;
                discard  ( 39 40 41 42 47 48 49 52 53 54 55 );   // C283 outliers, by name in the header
            }
            {
                dataset  "constant/archiveExtracts/oCresol-ethanol-bubble-j.fluid.2006.03.018.dat";
                role     fit;
            }
        );

        objective { method twoStage;  scale { T_bubble absolute; } }
        residual
        {
            kind        T_bubble;
            components  ( oCresol ethanol );
            weighting   uncertainty;
        }

        options
        {
            maxIter      80;
            tolerance    1.0e-6;
            fdStep       1.0e-4;
            lambda0      1.0e-3;
        }

        output
        {
            parity     parity_start2.csv;
        }
    }
    {
        name        txy_ideal;
        type        propertyScan1D;
        vary        { variable x[oCresol];  from 0.0;  to 1.0;  n 101; }
        state       { P 99.9 kPa;  composition { oCresol 0.5;  ethanol 0.5; } }
        thermo
        {
            equilibrium { liquid { activityModel { model ideal; } } }
        }
        properties  ( T_bubble  y_eq_oCresol );
        output      { file txy_ideal.csv; }
    }
    {
        name        txy_nrtl;
        type        propertyScan1D;
        vary        { variable x[oCresol];  from 0.0;  to 1.0;  n 101; }
        state       { P 99.9 kPa;  composition { oCresol 0.5;  ethanol 0.5; } }
        thermo
        {
            equilibrium { liquid { activityModel { model NRTL; /* no inline pair: the case's own record */ } } }
        }
        properties  ( T_bubble  y_eq_oCresol );
        output      { file txy_nrtl.csv; }
    }
    // @@C294-OPS-BEGIN@@ -- UNIQUAC and Wilson on the NRTL fit's own evidence (DEV.md 4c C294)
    // @@C294-OPS-END@@
);

