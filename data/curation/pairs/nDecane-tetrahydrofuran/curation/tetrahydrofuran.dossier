    refusal        "No independent experimental evidence remains after fitting.";

    fittedParameters
    {
        equilibrium.liquid.activityModel.binaryParameters.tetrahydrofuran-nDecane.b_ij  268.183734706;
        equilibrium.liquid.activityModel.binaryParameters.tetrahydrofuran-nDecane.b_ji  -274.510454024;
    }

    evidence
    {
        partitionFingerprint  "a7d520c70acfcbee";   // frozen before the fit

        datasets
        (
        {
            role      fit;
            dataset   "constant/archiveExtracts/tetrahydrofuran-nDecane-bubble-j.fluid.2004.10.027.dat";
            doi       "10.1016/j.fluid.2004.10.027";
            sha256    "dedfec1f89c424222eb64267c206a4a687646def0a2f935f68318ea9398d71d6";
            provenance measured;
            archiveFile "j.fluid.2004.10.027.xml";
            system    "tetrahydrofuran + nDecane";
            pressure  "95800.000000 Pa";
        }
        );

        domain
        {
            coordinate  x1;
            fit         { min 0.2859; max 0.9057; n 5; }
        }
    }

    metrics
    {
