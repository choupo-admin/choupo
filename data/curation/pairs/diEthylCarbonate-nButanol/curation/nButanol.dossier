        equilibrium.liquid.activityModel.binaryParameters.nButanol-diEthylCarbonate.b_ij  112.623025691;
        equilibrium.liquid.activityModel.binaryParameters.nButanol-diEthylCarbonate.b_ji  130.358678164;
    }

    evidence
