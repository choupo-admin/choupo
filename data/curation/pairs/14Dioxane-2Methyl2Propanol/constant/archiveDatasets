/*--------------------------------*- Choupo -*--------------------------------*\
  constant/archiveDatasets -- WHERE the measurements of 14Dioxane-2Methyl2Propanol
  come from, and how to regenerate them.  NO MEASURED POINT IS IN THIS TREE
  (Vitor, 2026-11-10: the measured series are not copied; only the fitted
  parameters are kept).  `bin/choupo-curate fetch <case>` writes each
  dataset into constant/archiveExtracts/ (gitignored): the article file is taken from
  the local ThermoML cache when it holds it, else from the NIST URL below,
  and BOTH sha256 sums are checked -- a mismatch refuses, an unreachable
  NIST is reported NOT RUN, never a pass.
\*-----------------------------------------------------------------------------*/

recordType    archiveDatasets;

archive
{
    tarball   "ThermoML.v2020-09-30.tgz";
    doi       "10.18434/mds2-2422";
    note      "the finding aid; each article file is also served one by one at the NIST URL";
}

datasets
(
    {
        file          "constant/archiveExtracts/2Methyl2Propanol-14Dioxane-bubble-j.fluid.2007.11.002.dat";
        role          fit;   // C283: every laboratory is fitted
        doi           "10.1016/j.fluid.2007.11.002";
        url           "https://trc.nist.gov/ThermoML/10.1016/j.fluid.2007.11.002.xml";
        page          "https://trc.nist.gov/ThermoML/10.1016/j.fluid.2007.11.002.json";
        articleFile   "j.fluid.2007.11.002.xml";
        articleSha256 "e1ebbb51f39a93296942c8d2a2ae3922399f87905cae3aa2734926e550d31c9a";
        block         21;
        filter        ( --interior-only );
        extract       "bin/choupo-thermoml extract-vle <article file> --block 21 --interior-only --into <dir>";
        sha256        "4a9824e2425f418cc62aa9347d6b0fd534a2cd98d7076fec1e5461797efd733d";
        identity
        {
            2Methyl2Propanol { cas "75-65-0"; inchiKey "DKGAVHZHDRPRBM-UHFFFAOYSA-N"; }
            14Dioxane      { cas "123-91-1"; inchiKey "RYHBNJHYFVUHQT-UHFFFAOYSA-N"; }
        }
    }
    {
        file          "constant/archiveExtracts/2Methyl2Propanol-14Dioxane-bubble-j.jct.2003.09.001.dat";
        role          fit;   // C283: every laboratory is fitted
        doi           "10.1016/j.jct.2003.09.001";
        url           "https://trc.nist.gov/ThermoML/10.1016/j.jct.2003.09.001.xml";
        page          "https://trc.nist.gov/ThermoML/10.1016/j.jct.2003.09.001.json";
        articleFile   "j.jct.2003.09.001.xml";
        articleSha256 "ed6d3c6e4b418beca21d9e9824b60a7dfd25c43695095885dd7f6bc8ef14dc91";
        block         18;
        filter        ( --interior-only );
        xOf           2Methyl2Propanol;   // the article reports the other member; x = 1 - x'
        extract       "bin/choupo-thermoml extract-vle <article file> --block 18 --interior-only --x-of 2Methyl2Propanol --into <dir>";
        sha256        "45ed79a29da75a47dc5e15134dc43cd21d8af4e4ebbfb054f372b5597ef13d46";
        identity
        {
            2Methyl2Propanol { cas "75-65-0"; inchiKey "DKGAVHZHDRPRBM-UHFFFAOYSA-N"; }
            14Dioxane      { cas "123-91-1"; inchiKey "RYHBNJHYFVUHQT-UHFFFAOYSA-N"; }
        }
    }
);
