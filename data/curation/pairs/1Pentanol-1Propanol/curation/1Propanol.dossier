    refusal        "No independent experimental evidence remains after fitting.";

    fittedParameters
    {
        equilibrium.liquid.activityModel.binaryParameters.1Propanol-1Pentanol.b_ij  800.241024773;
        equilibrium.liquid.activityModel.binaryParameters.1Propanol-1Pentanol.b_ji  -448.093935649;
    }

    evidence
    {
        partitionFingerprint  "65a4f2d237c47a00";   // frozen before the fit

        datasets
        (
        {
            role      fit;
            dataset   "constant/archiveExtracts/1Propanol-1Pentanol-bubble-j.fluid.2006.07.003.dat";
            doi       "10.1016/j.fluid.2006.07.003";
            sha256    "0c56d150e7de52e916a2a2a6f597cd4d84cd7410459522d6191e47bef7120efa";
            provenance measured;
            archiveFile "j.fluid.2006.07.003.xml";
            system    "1Propanol + 1Pentanol";
            pressure  "101300.000000 Pa";
        }
        );

        domain
        {
            coordinate  x1;
            fit         { min 0.047; max 0.974; n 19; }
        }
    }

    metrics
    {
        //  r2InSample: not computed by this operation (it reports chi-square).
