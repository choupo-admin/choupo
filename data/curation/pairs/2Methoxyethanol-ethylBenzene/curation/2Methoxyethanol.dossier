    fittedParameters
    {
        equilibrium.liquid.activityModel.binaryParameters.2Methoxyethanol-ethylBenzene.b_ij  263.817884773;
        equilibrium.liquid.activityModel.binaryParameters.2Methoxyethanol-ethylBenzene.b_ji  392.632355217;
    }

