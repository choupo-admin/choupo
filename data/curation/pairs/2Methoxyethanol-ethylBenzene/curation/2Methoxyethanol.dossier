            provenance measured;
            archiveFile "acs.jced.8b00225.xml";
            system    "2Methoxyethanol + ethylBenzene";
            pressure  "100000.000000 Pa";
        }
        );

        domain
        {
            coordinate  x1;
            fit         { min 0.0421; max 0.9806; n 16; }
        }
    }

    metrics
    {
