            provenance measured;
            archiveFile "acs.jced.5b00064.xml";
            system    "diEthylCarbonate + 12Propanediol";
            pressure  "101300.000000 Pa";
        }
        );

        domain
        {
            coordinate  x1;
            fit         { min 0.025; max 0.975; n 17; }
        }
    }

    metrics
    {
        //  r2InSample: not computed by this operation (it reports chi-square).
