    fittedParameters
    {
        equilibrium.liquid.activityModel.binaryParameters.diEthylCarbonate-12Propanediol.b_ij  385.057713579;
        equilibrium.liquid.activityModel.binaryParameters.diEthylCarbonate-12Propanediol.b_ji  271.264066986;
    }

    evidence
    {
        partitionFingerprint  "d7bf9a6de47b6850";   // frozen before the fit

