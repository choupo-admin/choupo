/*--------------------------------*- Choupo -*--------------------------------*\
  constant/archiveDatasets -- WHERE the measurements of 1Hexanol-ethylBenzene
  come from, and how to regenerate them.  NO MEASURED POINT IS IN THIS TREE
  (Vitor, 2026-11-10: the measured series are not copied; only the fitted
  parameters are kept).  `bin/choupo-curate fetch <case>` writes each
  dataset into constant/archiveExtracts/ (gitignored): the article file is taken from
  the local ThermoML cache when it holds it, else from the NIST URL below,
  and BOTH sha256 sums are checked -- a mismatch refuses, an unreachable
  NIST is reported NOT RUN, never a pass.
\*-----------------------------------------------------------------------------*/

recordType    archiveDatasets;

archive
{
    tarball   "ThermoML.v2020-09-30.tgz";
    doi       "10.18434/mds2-2422";
    note      "the finding aid; each article file is also served one by one at the NIST URL";
}

datasets
(
    {
        file          "constant/archiveExtracts/ethylBenzene-1Hexanol-bubble-j.jct.2008.05.002.dat";
        role          fit;   // C283: every laboratory is fitted
        doi           "10.1016/j.jct.2008.05.002";
        url           "https://trc.nist.gov/ThermoML/10.1016/j.jct.2008.05.002.xml";
        page          "https://trc.nist.gov/ThermoML/10.1016/j.jct.2008.05.002.json";
        articleFile   "j.jct.2008.05.002.xml";
        articleSha256 "8f94fae3c21136186bef5263f4d3713f8fbc2abf4941ba80a0b40894d792d4c9";
        block         15;
        filter        ( --interior-only );
        extract       "bin/choupo-thermoml extract-vle <article file> --block 15 --interior-only --into <dir>";
        sha256        "a35c997a2ca0fbf43fa9fb5ac48ea3ceaa11573bf9c484810bc0e56ef85a47b4";
        identity
        {
            ethylBenzene   { cas "100-41-4"; inchiKey "YNQLUTRBYVCPMQ-UHFFFAOYSA-N"; }
            1Hexanol       { cas "111-27-3"; inchiKey "ZSIAUFGUXNUGDI-UHFFFAOYSA-N"; }
        }
    }
);
