        equilibrium.liquid.activityModel.binaryParameters.tetrahydropyran-2Methyl2Propanol.b_ij  174.663961962;
        equilibrium.liquid.activityModel.binaryParameters.tetrahydropyran-2Methyl2Propanol.b_ji  -99.0106614727;
    }

    evidence
    {
