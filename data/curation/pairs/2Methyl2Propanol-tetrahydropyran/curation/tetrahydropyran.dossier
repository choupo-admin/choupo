            provenance measured;
            archiveFile "je800145h.xml";
            system    "tetrahydropyran + 2Methyl2Propanol";
        }
        );

        domain
        {
            coordinate  x1;
            fit         { min 0.0965; max 0.9035; n 54; }
        }
    }

    metrics
    {
