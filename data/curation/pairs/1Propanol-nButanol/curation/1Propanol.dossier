            doi       "10.1016/j.jct.2010.02.001";
            sha256    "7d4b6fcde914b46170bc8255b8e432b8b5dddd587ee1e32ecfd38cd4a863de66";
            provenance measured;
            archiveFile "j.jct.2010.02.001.xml";
            system    "1Propanol + nButanol";
        }
        );

        domain
        {
            coordinate  x1;
            fit         { min 0.0312; max 0.9609; n 30; }
        }
    }

    metrics
    {
        //  r2InSample: not computed by this operation (it reports chi-square).
        //  NO HELD-OUT METRIC EXISTS.  r2InSample above is exactly that --
        //  in-sample -- and must not be read as an external check.
