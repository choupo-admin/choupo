/*--------------------------------*- Choupo -*--------------------------------*\
  constant/archiveDatasets -- WHERE the measurements of nPropylMercaptan-toluene
  come from, and how to regenerate them.  NO MEASURED POINT IS IN THIS TREE
  (Vitor, 2026-11-10: the measured series are not copied; only the fitted
  parameters are kept).  `bin/choupo-curate fetch <case>` writes each
  dataset into constant/archiveExtracts/ (gitignored): the article file is taken from
  the local ThermoML cache when it holds it, else from the NIST URL below,
  and BOTH sha256 sums are checked -- a mismatch refuses, an unreachable
  NIST is reported NOT RUN, never a pass.
\*-----------------------------------------------------------------------------*/

recordType    archiveDatasets;

archive
{
    tarball   "ThermoML.v2020-09-30.tgz";
    doi       "10.18434/mds2-2422";
    note      "the finding aid; each article file is also served one by one at the NIST URL";
}

datasets
(
    {
        file          "constant/archiveExtracts/nPropylMercaptan-toluene-bubble-je060093l.dat";
        role          fit;   // C283: every laboratory is fitted
        doi           "10.1021/je060093l";
        url           "https://trc.nist.gov/ThermoML/10.1021/je060093l.xml";
        page          "https://trc.nist.gov/ThermoML/10.1021/je060093l.json";
        articleFile   "je060093l.xml";
        articleSha256 "68c2d7f7d42e29a38f1d3b2774c4563b53eefe99ada54d399e32f54193b118c3";
        block         11;
        filter        ( --interior-only );
        extract       "bin/choupo-thermoml extract-vle <article file> --block 11 --interior-only --into <dir>";
        sha256        "cc7419e76a0e241808f628c901fd84edff5ba4ad44cf82fca1ad39f2e58f4b75";
        identity
        {
            nPropylMercaptan { cas "107-03-9"; inchiKey "SUVIGLJNEAMWEG-UHFFFAOYSA-N"; }
            toluene        { cas "108-88-3"; inchiKey "YXFVVABEGXRONW-UHFFFAOYSA-N"; }
        }
    }
);
