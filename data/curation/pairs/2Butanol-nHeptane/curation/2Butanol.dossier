    refusal        "No independent experimental evidence remains after fitting.";

    fittedParameters
    {
        equilibrium.liquid.activityModel.binaryParameters.2Butanol-nHeptane.b_ij  104.092451671;
        equilibrium.liquid.activityModel.binaryParameters.2Butanol-nHeptane.b_ji  573.634248898;
    }

    evidence
    {
        partitionFingerprint  "0c8ec8e7d8415496";   // frozen before the fit

        datasets
        (
        {
            role      fit;
            dataset   "constant/archiveExtracts/2Butanol-nHeptane-bubble-je101250d.dat";
            doi       "10.1021/je101250d";
            sha256    "6669b12035e317cc29bb9ffe16bf70870f3d4766ed9b0dc05b0b6709dcfbc736";
            provenance measured;
            archiveFile "je101250d.xml";
            system    "2Butanol + nHeptane";
        }
        );

        domain
        {
            coordinate  x1;
            fit         { min 0.061; max 0.962; n 57; }
        }
    }

    metrics
    {
        //  r2InSample: not computed by this operation (it reports chi-square).
        //  NO HELD-OUT METRIC EXISTS.  r2InSample above is exactly that --
        //  in-sample -- and must not be read as an external check.
    }
}

