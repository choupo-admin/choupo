    fittedParameters
    {
        equilibrium.liquid.activityModel.binaryParameters.Dichloroethane-nNDimethylformamide.b_ij  409.261831206;
        equilibrium.liquid.activityModel.binaryParameters.Dichloroethane-nNDimethylformamide.b_ji  -397.904023629;
    }

    evidence
    {
        partitionFingerprint  "ac4a508a2e043e40";   // frozen before the fit

        datasets
        (
        {
            role      fit;
            dataset   "constant/archiveExtracts/Dichloroethane-nNDimethylformamide-bubble-j.fluid.2006.08.018.dat";
            doi       "10.1016/j.fluid.2006.08.018";
            sha256    "efd075a1a7973909792b56e5f48979fc69b4de7609c3c07c261b8ab7be59e044";
            provenance measured;
            archiveFile "j.fluid.2006.08.018.xml";
            system    "Dichloroethane + nNDimethylformamide";
            pressure  "95500.000000 Pa";
        }
        );

        domain
        {
            coordinate  x1;
            fit         { min 0.0502; max 0.9501; n 19; }
        }
    }

    metrics
    {
        //  r2InSample: not computed by this operation (it reports chi-square).
