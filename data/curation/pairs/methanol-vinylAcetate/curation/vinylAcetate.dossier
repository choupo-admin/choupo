        partitionFingerprint  "5875857550333d5a";   // frozen before the fit

        datasets
        (
        {
            role      fit;
            dataset   "constant/archiveExtracts/vinylAcetate-methanol-bubble-je300835h.dat";
            doi       "10.1021/je300835h";
            sha256    "efa08e51ef7ed709dfd311bee65e32720155050f938fdbe3224d1856cbed66f0";
            provenance measured;
            archiveFile "je300835h.xml";
            system    "vinylAcetate + methanol";
            pressure  "101300.000000 Pa";
        }
        );

        domain
        {
            coordinate  x1;
            fit         { min 0.033; max 0.782; n 11; }
        }
    }

    metrics
    {
        //  r2InSample: not computed by this operation (it reports chi-square).
        //  NO HELD-OUT METRIC EXISTS.  r2InSample above is exactly that --
        //  in-sample -- and must not be read as an external check.
    }
}

);
