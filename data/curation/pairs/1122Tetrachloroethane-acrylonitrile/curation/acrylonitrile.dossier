    refusal        "No independent experimental evidence remains after fitting.";

    fittedParameters
    {
        equilibrium.liquid.activityModel.binaryParameters.acrylonitrile-1122Tetrachloroethane.b_ij  -10.6964798277;
        equilibrium.liquid.activityModel.binaryParameters.acrylonitrile-1122Tetrachloroethane.b_ji  -75.7881426237;
    }

    evidence
    {
        partitionFingerprint  "830f5024f82fc0a9";   // frozen before the fit

        datasets
        (
        {
            role      fit;
            dataset   "constant/archiveExtracts/acrylonitrile-1122Tetrachloroethane-bubble-j.fluid.2008.03.020.dat";
            doi       "10.1016/j.fluid.2008.03.020";
            sha256    "f9762997c3a8e2caed558dc0086fcd6e432eb02b667299840a9ac1b61849bcd0";
            provenance measured;
            archiveFile "j.fluid.2008.03.020.xml";
            system    "acrylonitrile + 1122Tetrachloroethane";
            pressure  "95500.000000 Pa";
        }
        );

        domain
        {
            coordinate  x1;
            fit         { min 0.0505; max 0.94; n 14; }
        }
    }

    metrics
    {
        //  r2InSample: not computed by this operation (it reports chi-square).
        //  NO HELD-OUT METRIC EXISTS.  r2InSample above is exactly that --
        //  in-sample -- and must not be read as an external check.
    }
}

