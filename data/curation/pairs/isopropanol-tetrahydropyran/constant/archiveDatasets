/*--------------------------------*- Choupo -*--------------------------------*\
  constant/archiveDatasets -- WHERE the measurements of isopropanol-tetrahydropyran
  come from, and how to regenerate them.  NO MEASURED POINT IS IN THIS TREE
  (Vitor, 2026-11-10: the measured series are not copied; only the fitted
  parameters are kept).  `bin/choupo-curate fetch <case>` writes each
  dataset into constant/archiveExtracts/ (gitignored): the article file is taken from
  the local ThermoML cache when it holds it, else from the NIST URL below,
  and BOTH sha256 sums are checked -- a mismatch refuses, an unreachable
  NIST is reported NOT RUN, never a pass.
\*-----------------------------------------------------------------------------*/

recordType    archiveDatasets;

archive
{
    tarball   "ThermoML.v2020-09-30.tgz";
    doi       "10.18434/mds2-2422";
    note      "the finding aid; each article file is also served one by one at the NIST URL";
}

datasets
(
    {
        file          "constant/archiveExtracts/tetrahydropyran-isopropanol-bubble-je800145h.dat";
        role          fit;   // C283: every laboratory is fitted
        doi           "10.1021/je800145h";
        url           "https://trc.nist.gov/ThermoML/10.1021/je800145h.xml";
        page          "https://trc.nist.gov/ThermoML/10.1021/je800145h.json";
        articleFile   "je800145h.xml";
        articleSha256 "5dd47b3ee3daba46383121cf9b59b062c8da13cdfd2befd3f7223b52bdbfa81a";
        block         13;
        filter        ( --interior-only );
        extract       "bin/choupo-thermoml extract-vle <article file> --block 13 --interior-only --into <dir>";
        sha256        "d1d01b6a848960c15c3c57e7f8e184a20b09f844246ac8e27ae90e8b1ebdf7a1";
        identity
        {
            tetrahydropyran { cas "142-68-7"; inchiKey "DHXVGJBLRPWPCS-UHFFFAOYSA-N"; }
            isopropanol    { cas "67-63-0"; inchiKey "KFZMGEQAYNKOFK-UHFFFAOYSA-N"; }
        }
    }
    {
        file          "constant/archiveExtracts/tetrahydropyran-isopropanol-bubble-j.jct.2011.10.025.dat";
        role          fit;   // C283: every laboratory is fitted
        doi           "10.1016/j.jct.2011.10.025";
        url           "https://trc.nist.gov/ThermoML/10.1016/j.jct.2011.10.025.xml";
        page          "https://trc.nist.gov/ThermoML/10.1016/j.jct.2011.10.025.json";
        articleFile   "j.jct.2011.10.025.xml";
        articleSha256 "d9f6a88060615631fce71b3187a31ace470278da59c293d2e62e44120e446882";
        block         8;
        filter        ( --interior-only );
        xOf           tetrahydropyran;   // the article reports the other member; x = 1 - x'
        extract       "bin/choupo-thermoml extract-vle <article file> --block 8 --interior-only --x-of tetrahydropyran --into <dir>";
        sha256        "4c1376f1d5d1b1bb46c9e266d7ec6261925f0959d50ed0034a16800898c0e90d";
        identity
        {
            tetrahydropyran { cas "142-68-7"; inchiKey "DHXVGJBLRPWPCS-UHFFFAOYSA-N"; }
            isopropanol    { cas "67-63-0"; inchiKey "KFZMGEQAYNKOFK-UHFFFAOYSA-N"; }
        }
    }
);
