    refusal        "No independent experimental evidence remains after fitting.";

    fittedParameters
    {
        equilibrium.liquid.activityModel.binaryParameters.dichloromethane-2Ethoxyethanol.b_ij  -300;   // +/- 9100 (1 sigma, from the fit)
        equilibrium.liquid.activityModel.binaryParameters.dichloromethane-2Ethoxyethanol.b_ji  0;   // +/- 16000 (1 sigma, from the fit)
    }

    evidence
    {
        partitionFingerprint  "9e9ddb6c2aa6c83f";   // frozen before the fit

        datasets
        (
        {
            role      fit;
            dataset   "constant/archiveExtracts/dichloromethane-2Ethoxyethanol-bubbleP-je034153o-b6.dat";
            doi       "10.1021/je034153o";
            sha256    "2dde3b1eb81cd9f47cb0dca71f1248384d32ee8552ea15e3976666b30f7cc576";
            provenance measured;
            archiveFile "je034153o.xml";
            system    "dichloromethane + 2Ethoxyethanol";
        }
        );

        domain
        {
            coordinate  x1;
            fit         { min 0.0651; max 0.9695; n 21; }
        }
    }

    metrics
    {
        //  r2InSample: not computed by this operation (it reports chi-square).
        //  NO HELD-OUT METRIC EXISTS.  r2InSample above is exactly that --
        //  in-sample -- and must not be read as an external check.
    }
}

