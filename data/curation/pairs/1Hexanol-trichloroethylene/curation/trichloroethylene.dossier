    fittedParameters
    {
        equilibrium.liquid.activityModel.binaryParameters.trichloroethylene-1Hexanol.b_ij  176.491829476;
        equilibrium.liquid.activityModel.binaryParameters.trichloroethylene-1Hexanol.b_ji  -168.815942521;
    }

    evidence
    {
        partitionFingerprint  "f7ab54bb1f56e1f7";   // frozen before the fit

        datasets
        (
        {
            role      fit;
            dataset   "constant/archiveExtracts/trichloroethylene-1Hexanol-bubble-je9000608.dat";
