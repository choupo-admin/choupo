            sha256    "2942bff027a27269aa16e70e4f3b18e3e56cd2f178d00349a14d5eff0db0cbc5";
            provenance measured;
            archiveFile "je9000608.xml";
            system    "trichloroethylene + 1Hexanol";
            pressure  "95600.000000 Pa";
        }
        );

        domain
        {
            coordinate  x1;
            fit         { min 0.0625; max 0.9262; n 14; }
        }
    }

    metrics
    {
        //  r2InSample: not computed by this operation (it reports chi-square).
