        equilibrium.liquid.activityModel.binaryParameters.1Hexanol-13Propanediol.b_ij  2323.6485474;
        equilibrium.liquid.activityModel.binaryParameters.1Hexanol-13Propanediol.b_ji  -686.572406084;
    }

