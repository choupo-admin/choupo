            provenance measured;
            archiveFile "je500731x.xml";
            system    "nDecane + 4Heptanone";
            pressure  "40000.000000 Pa";
        }
        );

        domain
        {
            coordinate  x1;
            fit         { min 0.021; max 0.99; n 33; }
        }
    }

    metrics
    {
