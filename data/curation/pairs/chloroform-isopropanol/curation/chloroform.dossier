            doi       "10.1016/j.fluid.2018.03.011";
            sha256    "633f6456557f4cddddde84aefff1489f4f657b7e9df30c6a5f9cc56c04cbeb73";
            provenance measured;
            archiveFile "j.fluid.2018.03.011.xml";
            system    "chloroform + isopropanol";
            pressure  "101300.000000 Pa";
        }
        );

        domain
        {
            coordinate  x1;
            fit         { min 0.076; max 0.948; n 10; }
        }
    }

    metrics
    {
