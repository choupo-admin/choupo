            doi       "10.1016/j.tca.2017.12.010";
            sha256    "dcbca938bc27cae77482212e0a66c77396586bd2406e1dd043ab2bd20e2d6a7b";
            provenance measured;
            archiveFile "j.tca.2017.12.010.xml";
            system    "cyclohexane + toluene";
            pressure  "101300.000000 Pa";
        }
        );

        domain
        {
            coordinate  x1;
            fit         { min 0.0295; max 0.9839; n 14; }
        }
    }

    metrics
