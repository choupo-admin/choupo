    fittedParameters
    {
        equilibrium.liquid.activityModel.binaryParameters.cyclohexane-toluene.b_ij  638.262531285;
        equilibrium.liquid.activityModel.binaryParameters.cyclohexane-toluene.b_ji  -341.713119646;
    }

