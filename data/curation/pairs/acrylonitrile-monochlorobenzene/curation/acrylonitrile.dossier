    refusal        "No independent experimental evidence remains after fitting.";

    fittedParameters
    {
        equilibrium.liquid.activityModel.binaryParameters.acrylonitrile-monochlorobenzene.b_ij  646.785972656;
        equilibrium.liquid.activityModel.binaryParameters.acrylonitrile-monochlorobenzene.b_ji  -242.190423643;
    }

    evidence
    {
        partitionFingerprint  "8f2ac5c95e1acb8e";   // frozen before the fit

        datasets
        (
        {
            role      fit;
            dataset   "constant/archiveExtracts/acrylonitrile-monochlorobenzene-bubble-j.fluid.2008.03.020.dat";
            doi       "10.1016/j.fluid.2008.03.020";
            sha256    "f9762997c3a8e2caed558dc0086fcd6e432eb02b667299840a9ac1b61849bcd0";
            provenance measured;
            archiveFile "j.fluid.2008.03.020.xml";
            system    "acrylonitrile + monochlorobenzene";
            pressure  "95500.000000 Pa";
        }
        );

        domain
        {
            coordinate  x1;
            fit         { min 0.123; max 0.9239; n 14; }
        }
    }

    metrics
    {
        //  r2InSample: not computed by this operation (it reports chi-square).
