    refusal        "No independent experimental evidence remains after fitting.";

    fittedParameters
    {
        equilibrium.liquid.activityModel.binaryParameters.acrylonitrile-Dichloroethane.b_ij  298.728139347;
        equilibrium.liquid.activityModel.binaryParameters.acrylonitrile-Dichloroethane.b_ji  -199.811684938;
    }

    evidence
    {
        partitionFingerprint  "780f7bcfb010c114";   // frozen before the fit

        datasets
        (
        {
            role      fit;
            dataset   "constant/archiveExtracts/acrylonitrile-Dichloroethane-bubble-j.fluid.2008.03.020.dat";
            doi       "10.1016/j.fluid.2008.03.020";
            sha256    "f9762997c3a8e2caed558dc0086fcd6e432eb02b667299840a9ac1b61849bcd0";
            provenance measured;
            archiveFile "j.fluid.2008.03.020.xml";
            system    "acrylonitrile + Dichloroethane";
            pressure  "95500.000000 Pa";
        }
        );

        domain
        {
            coordinate  x1;
            fit         { min 0.1001; max 0.9002; n 14; }
        }
    }

    metrics
    {
        //  r2InSample: not computed by this operation (it reports chi-square).
