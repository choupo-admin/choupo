    refusal        "No independent experimental evidence remains after fitting.";

    fittedParameters
    {
        equilibrium.liquid.activityModel.binaryParameters.nButylAcetate-anisole.b_ij  192.479007956;
        equilibrium.liquid.activityModel.binaryParameters.nButylAcetate-anisole.b_ji  -106.453682739;
    }

    evidence
    {
        partitionFingerprint  "f480535944ad7b11";   // frozen before the fit

        datasets
        (
        {
            role      fit;
            dataset   "constant/archiveExtracts/nButylAcetate-anisole-bubble-j.jct.2015.04.003.dat";
            doi       "10.1016/j.jct.2015.04.003";
            sha256    "313eccebca5b6b06644574a09332ea628195cc1512354223f7831afe3b96c5f3";
            provenance measured;
            archiveFile "j.jct.2015.04.003.xml";
            system    "nButylAcetate + anisole";
            pressure  "101330.000000 Pa";
        }
        );

        domain
        {
            coordinate  x1;
            fit         { min 0.01; max 0.979; n 22; }
        }
    }

    metrics
    {
        //  r2InSample: not computed by this operation (it reports chi-square).
        //  NO HELD-OUT METRIC EXISTS.  r2InSample above is exactly that --
        //  in-sample -- and must not be read as an external check.
    }
}

{
