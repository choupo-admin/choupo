/*--------------------------------*- Choupo -*--------------------------------*\
  constant/archiveDatasets -- WHERE the measurements of 3Methylthiophene
  come from, and how to regenerate them.  NO MEASURED POINT IS IN THIS TREE
  (Vitor, 2026-11-10: the measured series are not copied; only the fitted
  parameters are kept).  `bin/choupo-curate fetch <case>` writes each
  dataset into constant/archiveExtracts/ (gitignored): the article file is taken from
  the local ThermoML cache when it holds it, else from the NIST URL below,
  and BOTH sha256 sums are checked -- a mismatch refuses, an unreachable
  NIST is reported NOT RUN, never a pass.
\*-----------------------------------------------------------------------------*/

recordType    archiveDatasets;

archive
{
    tarball   "ThermoML.v2020-09-30.tgz";
    doi       "10.18434/mds2-2422";
    note      "the finding aid; each article file is also served one by one at the NIST URL";
}

datasets
(
    {
        file          "constant/archiveExtracts/3Methylthiophene-vapourPressure-j.fluid.2009.02.010.dat";
        role          fit;   // informational: the operation declares it
        doi           "10.1016/j.fluid.2009.02.010";
        url           "https://trc.nist.gov/ThermoML/10.1016/j.fluid.2009.02.010.xml";
        page          "https://trc.nist.gov/ThermoML/10.1016/j.fluid.2009.02.010.json";
        articleFile   "j.fluid.2009.02.010.xml";
        articleSha256 "acb44474f8c33dd2a6c8b079b02e9e720b01f4623ff12e6c7ca7dff932a96108";
        extractor     vapourPressure;
        inchiKey      "QENGPZGAWFQWCZ-UHFFFAOYSA-N";
        extract       "bin/choupo-thermoml extract-vp <article file> --inchikey QENGPZGAWFQWCZ-UHFFFAOYSA-N --into <dir>";
        sha256        "de191164073aa477d657ed202f74c8638b1ca6bb733f4cc23cfc198b1a8a6570";
        identity
        {
            3Methylthiophene { cas "616-44-4"; inchiKey "QENGPZGAWFQWCZ-UHFFFAOYSA-N"; }
        }
    }
);
