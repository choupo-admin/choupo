(
    {
        file          "constant/archiveExtracts/nAminoethylPiperazine-vapourPressure-j.jct.2009.09.003.dat";
        role          fit;   // informational: the operation declares it
        doi           "10.1016/j.jct.2009.09.003";
        url           "https://trc.nist.gov/ThermoML/10.1016/j.jct.2009.09.003.xml";
        page          "https://trc.nist.gov/ThermoML/10.1016/j.jct.2009.09.003.json";
        articleFile   "j.jct.2009.09.003.xml";
        articleSha256 "c640d7edba1a863321a4e553b53af0caeb53909bcd6921be507a448183f31fb5";
        extractor     vapourPressure;
        inchiKey      "IMUDHTPIFIBORV-UHFFFAOYSA-N";
        extract       "bin/choupo-thermoml extract-vp <article file> --inchikey IMUDHTPIFIBORV-UHFFFAOYSA-N --into <dir>";
        sha256        "bc51866beda25e78748495ba86efe031cfff70794701346289ba98f2107504c0";
        identity
        {
            nAminoethylPiperazine { cas "140-31-8"; inchiKey "IMUDHTPIFIBORV-UHFFFAOYSA-N"; }
        }
    }
);
