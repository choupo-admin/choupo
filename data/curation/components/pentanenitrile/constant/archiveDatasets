/*--------------------------------*- Choupo -*--------------------------------*\
  constant/archiveDatasets -- WHERE the measurements of pentanenitrile
  come from, and how to regenerate them.  NO MEASURED POINT IS IN THIS TREE
  (Vitor, 2026-11-10: the measured series are not copied; only the fitted
  parameters are kept).  `bin/choupo-curate fetch <case>` writes each
  dataset into constant/archiveExtracts/ (gitignored): the article file is taken from
  the local ThermoML cache when it holds it, else from the NIST URL below,
  and BOTH sha256 sums are checked -- a mismatch refuses, an unreachable
  NIST is reported NOT RUN, never a pass.
\*-----------------------------------------------------------------------------*/

recordType    archiveDatasets;

archive
{
    tarball   "ThermoML.v2020-09-30.tgz";
    doi       "10.18434/mds2-2422";
    note      "the finding aid; each article file is also served one by one at the NIST URL";
}

datasets
(
    {
        file          "constant/archiveExtracts/pentanenitrile-vapourPressure-acs.jced.8b00590.dat";
        role          fit;   // informational: the operation declares it
        doi           "10.1021/acs.jced.8b00590";
        url           "https://trc.nist.gov/ThermoML/10.1021/acs.jced.8b00590.xml";
        page          "https://trc.nist.gov/ThermoML/10.1021/acs.jced.8b00590.json";
        articleFile   "acs.jced.8b00590.xml";
        articleSha256 "061c3de10ce2cd878e593f6bc171f64c52b1afe81a9fe473e2abcc7b4f98e03e";
        extractor     vapourPressure;
        inchiKey      "RFFFKMOABOFIDF-UHFFFAOYSA-N";
        extract       "bin/choupo-thermoml extract-vp <article file> --inchikey RFFFKMOABOFIDF-UHFFFAOYSA-N --into <dir>";
        sha256        "77ce3ccaba6c7b3354c3cfc1c32254cd5ab9a8e89ce0987a9a039b59307c97ab";
        identity
        {
            pentanenitrile { cas "110-59-8"; inchiKey "RFFFKMOABOFIDF-UHFFFAOYSA-N"; }
        }
    }
);
