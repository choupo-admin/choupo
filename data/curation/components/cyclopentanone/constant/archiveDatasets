/*--------------------------------*- Choupo -*--------------------------------*\
  constant/archiveDatasets -- WHERE the measurements of cyclopentanone
  come from, and how to regenerate them.  NO MEASURED POINT IS IN THIS TREE
  (Vitor, 2026-11-10: the measured series are not copied; only the fitted
  parameters are kept).  `bin/choupo-curate fetch <case>` writes each
  dataset into constant/archiveExtracts/ (gitignored): the article file is taken from
  the local ThermoML cache when it holds it, else from the NIST URL below,
  and BOTH sha256 sums are checked -- a mismatch refuses, an unreachable
  NIST is reported NOT RUN, never a pass.
\*-----------------------------------------------------------------------------*/

recordType    archiveDatasets;

archive
{
    tarball   "ThermoML.v2020-09-30.tgz";
    doi       "10.18434/mds2-2422";
    note      "the finding aid; each article file is also served one by one at the NIST URL";
}

datasets
(
    {
        file          "constant/archiveExtracts/cyclopentanone-vapourPressure-j.jct.2006.01.010.dat";
        role          fit;   // informational: the operation declares it
        doi           "10.1016/j.jct.2006.01.010";
        url           "https://trc.nist.gov/ThermoML/10.1016/j.jct.2006.01.010.xml";
        page          "https://trc.nist.gov/ThermoML/10.1016/j.jct.2006.01.010.json";
        articleFile   "j.jct.2006.01.010.xml";
        articleSha256 "27c844e78b3b151ebc51ac350728769f2eb96319a7c4c1f3f6b82101454c7cda";
        extractor     vapourPressure;
        inchiKey      "BGTOWKSIORTVQH-UHFFFAOYSA-N";
        extract       "bin/choupo-thermoml extract-vp <article file> --inchikey BGTOWKSIORTVQH-UHFFFAOYSA-N --into <dir>";
        sha256        "a14f09c2df251b60df5cdb41ab8ee1a758714b531444a25120f462a8931a365a";
        identity
        {
            cyclopentanone { cas "120-92-3"; inchiKey "BGTOWKSIORTVQH-UHFFFAOYSA-N"; }
        }
    }
    {
        file          "constant/archiveExtracts/cyclopentanone-vapourPressure-j.jct.2005.07.016.dat";
