/*--------------------------------*- Choupo -*--------------------------------*\
  constant/archiveDatasets -- WHERE the measurements of 2Chlorobutane
  come from, and how to regenerate them.  NO MEASURED POINT IS IN THIS TREE
  (Vitor, 2026-11-10: the measured series are not copied; only the fitted
  parameters are kept).  `bin/choupo-curate fetch <case>` writes each
  dataset into constant/archiveExtracts/ (gitignored): the article file is taken from
  the local ThermoML cache when it holds it, else from the NIST URL below,
  and BOTH sha256 sums are checked -- a mismatch refuses, an unreachable
  NIST is reported NOT RUN, never a pass.
\*-----------------------------------------------------------------------------*/

recordType    archiveDatasets;

archive
{
    tarball   "ThermoML.v2020-09-30.tgz";
    doi       "10.18434/mds2-2422";
    note      "the finding aid; each article file is also served one by one at the NIST URL";
}

datasets
(
    {
        file          "constant/archiveExtracts/2Chlorobutane-vapourPressure-j.fluid.2006.02.009.dat";
        role          fit;   // informational: the operation declares it
        doi           "10.1016/j.fluid.2006.02.009";
        url           "https://trc.nist.gov/ThermoML/10.1016/j.fluid.2006.02.009.xml";
        page          "https://trc.nist.gov/ThermoML/10.1016/j.fluid.2006.02.009.json";
        articleFile   "j.fluid.2006.02.009.xml";
        articleSha256 "294793403436783975100d8eaea9083144484e525d73d8310f0c45881e55d4a5";
        extractor     vapourPressure;
        inchiKey      "BSPCSKHALVHRSR-UHFFFAOYSA-N";
        extract       "bin/choupo-thermoml extract-vp <article file> --inchikey BSPCSKHALVHRSR-UHFFFAOYSA-N --into <dir>";
        sha256        "d360a384d33c675080c1126b57030399554bb3fbe9268dda4f9ddfc706a941ce";
        identity
        {
            2Chlorobutane  { cas "78-86-4"; inchiKey "BSPCSKHALVHRSR-UHFFFAOYSA-N"; }
        }
    }
);
