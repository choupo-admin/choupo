        extractor     vapourPressure;
        inchiKey      "NMJJFJNHVMGPGM-UHFFFAOYSA-N";
        extract       "bin/choupo-thermoml extract-vp <article file> --inchikey NMJJFJNHVMGPGM-UHFFFAOYSA-N --into <dir>";
        sha256        "1980bf35cb03cd5b8854471ba0ef51d97e4e5a9d728b1c95929da5e0813d167a";
