/*--------------------------------*- Choupo -*--------------------------------*\
  constant/archiveDatasets -- WHERE the measurements of methylLactate
  come from, and how to regenerate them.  NO MEASURED POINT IS IN THIS TREE
  (Vitor, 2026-11-10: the measured series are not copied; only the fitted
  parameters are kept).  `bin/choupo-curate fetch <case>` writes each
  dataset into constant/archiveExtracts/ (gitignored): the article file is taken from
  the local ThermoML cache when it holds it, else from the NIST URL below,
  and BOTH sha256 sums are checked -- a mismatch refuses, an unreachable
  NIST is reported NOT RUN, never a pass.
\*-----------------------------------------------------------------------------*/

recordType    archiveDatasets;

archive
{
    tarball   "ThermoML.v2020-09-30.tgz";
    doi       "10.18434/mds2-2422";
    note      "the finding aid; each article file is also served one by one at the NIST URL";
}

datasets
(
    {
        file          "constant/archiveExtracts/methylLactate-vapourPressure-j.tca.2013.11.010.dat";
        role          fit;   // informational: the operation declares it
        doi           "10.1016/j.tca.2013.11.010";
        url           "https://trc.nist.gov/ThermoML/10.1016/j.tca.2013.11.010.xml";
        page          "https://trc.nist.gov/ThermoML/10.1016/j.tca.2013.11.010.json";
        articleFile   "j.tca.2013.11.010.xml";
        articleSha256 "1258a5fe7a5af26ad3162da9bd6fc878c45644acf4f8740a4d5431a8de4e3747";
        extractor     vapourPressure;
        inchiKey      "LPEKGGXMPWTOCB-UHFFFAOYSA-N";
        extract       "bin/choupo-thermoml extract-vp <article file> --inchikey LPEKGGXMPWTOCB-UHFFFAOYSA-N --into <dir>";
        sha256        "a1c6451604a5afddb6aa7515904a5af34c1f85d85a5217ec567fa6165f49be19";
        identity
        {
            methylLactate  { cas "547-64-8"; inchiKey "LPEKGGXMPWTOCB-UHFFFAOYSA-N"; }
        }
    }
);
