/*--------------------------------*- Choupo -*--------------------------------*\
  CURATION DOSSIER -- a scientific work record, NOT runtime property data.

  NOTHING IN THIS FILE IS VISIBLE TO THE SOLVER.  Record resolution looks only
  in <case>/constant/, data/standards/ and data/local/, so a file here is out
  of its reach BY CONSTRUCTION -- not by convention.

  Nothing here has been promoted.  Curation state belongs to the evidence
  process; runtime trust belongs to the numerical record actually admitted
  to data/standards/, and only an explicit human promotion moves one there
  (bin/curate/promote-from-dossier).

  MATURITY IS PER PROPERTY, not per component: the properties below may hold
  different verdicts, and any whole-component summary is DERIVED from them
  rather than stored beside them.

  Regenerated on every run.  Hand edits are lost.
\*-----------------------------------------------------------------------------*/

component      1Methoxy2PropylAcetate;
reviewStatus   unreviewed;

properties
(
{
    property       vapourPressure;
    operation      fit_antoine;   // type vaporPressureFit
    model          "Antoine  log10(Psat[bar]) = A - B/(T + C)";
    verdict        validationRefused;
    refusal        "No independent experimental evidence remains after fitting.";

    fittedParameters
    {
        A  4.09637943217;
        B  1345.04698583;
        C  -89.9557503726;
    }

    evidence
    {
        partitionFingerprint  "81a0829e46c27019";   // frozen before the fit

        datasets
        (
        {
            role      fit;
            dataset   "constant/archiveExtracts/1Methoxy2PropylAcetate-vapourPressure-j.jct.2014.01.019.dat";
            doi       "10.1016/j.jct.2014.01.019";
            sha256    "e156cc25158f98b8e8992225503eef886c705f411dce6cee573ab5e54e6ce8fc";
            provenance measured;
            archiveFile "j.jct.2014.01.019.xml";
            system    "1Methoxy2PropylAcetate";
        }
        {
            role      fit;
            dataset   "constant/archiveExtracts/1Methoxy2PropylAcetate-vapourPressure-j.fluid.2007.06.006.dat";
            doi       "10.1016/j.fluid.2007.06.006";
            sha256    "1199da24ff6d595c35b20f12ca5001fe7bb53d23719dca5dafec2b262c84ad53";
            provenance measured;
            archiveFile "j.fluid.2007.06.006.xml";
            system    "1Methoxy2PropylAcetate";
        }
        {
            role      fit;
            dataset   "constant/archiveExtracts/1Methoxy2PropylAcetate-vapourPressure-acs.jced.6b01071.dat";
            doi       "10.1021/acs.jced.6b01071";
            sha256    "e5e3840b11d85390025771c40b7178bbd95159c167998895f14c435275dd5655";
            provenance measured;
            archiveFile "acs.jced.6b01071.xml";
            system    "1Methoxy2PropylAcetate";
        }
        );

        domain
        {
            coordinate  K;
            fit         { min 318.27; max 418.65; n 21; }
        }
    }

    metrics
    {
        r2InSample        0.999957432892;   // the model reproducing the points it was FITTED to
        //  NO HELD-OUT METRIC EXISTS.  r2InSample above is exactly that --
        //  in-sample -- and must not be read as an external check.
    }
}

);
