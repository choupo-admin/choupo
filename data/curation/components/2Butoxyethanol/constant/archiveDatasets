/*--------------------------------*- Choupo -*--------------------------------*\
  constant/archiveDatasets -- WHERE the measurements of 2Butoxyethanol
  come from, and how to regenerate them.  NO MEASURED POINT IS IN THIS TREE
  (Vitor, 2026-11-10: the measured series are not copied; only the fitted
  parameters are kept).  `bin/choupo-curate fetch <case>` writes each
  dataset into constant/archiveExtracts/ (gitignored): the article file is taken from
  the local ThermoML cache when it holds it, else from the NIST URL below,
  and BOTH sha256 sums are checked -- a mismatch refuses, an unreachable
  NIST is reported NOT RUN, never a pass.
\*-----------------------------------------------------------------------------*/

recordType    archiveDatasets;

archive
{
    tarball   "ThermoML.v2020-09-30.tgz";
    doi       "10.18434/mds2-2422";
    note      "the finding aid; each article file is also served one by one at the NIST URL";
}

datasets
(
    {
        file          "constant/archiveExtracts/2Butoxyethanol-vapourPressure-j.fluid.2012.08.030.dat";
        role          fit;   // informational: the operation declares it
        doi           "10.1016/j.fluid.2012.08.030";
        url           "https://trc.nist.gov/ThermoML/10.1016/j.fluid.2012.08.030.xml";
        page          "https://trc.nist.gov/ThermoML/10.1016/j.fluid.2012.08.030.json";
        articleFile   "j.fluid.2012.08.030.xml";
        articleSha256 "6419d37a8c040cf93cb31454cedb04ddb1f440e7ccee355d910c4b6718dc9f18";
        extractor     vapourPressure;
        inchiKey      "POAOYUHQDCAZBD-UHFFFAOYSA-N";
        extract       "bin/choupo-thermoml extract-vp <article file> --inchikey POAOYUHQDCAZBD-UHFFFAOYSA-N --into <dir>";
        sha256        "cc34045c575b90ed3c43818a8c7c642d001f4ce97d7171277e07b68f6c93b70c";
        identity
        {
            2Butoxyethanol { cas "111-76-2"; inchiKey "POAOYUHQDCAZBD-UHFFFAOYSA-N"; }
        }
    }
);
