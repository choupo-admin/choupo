/*--------------------------------*- Choupo -*--------------------------------*\
  constant/archiveDatasets -- WHERE the measurements of mNitrotoluene
  come from, and how to regenerate them.  NO MEASURED POINT IS IN THIS TREE
  (Vitor, 2026-11-10: the measured series are not copied; only the fitted
  parameters are kept).  `bin/choupo-curate fetch <case>` writes each
  dataset into constant/archiveExtracts/ (gitignored): the article file is taken from
  the local ThermoML cache when it holds it, else from the NIST URL below,
  and BOTH sha256 sums are checked -- a mismatch refuses, an unreachable
  NIST is reported NOT RUN, never a pass.
\*-----------------------------------------------------------------------------*/

recordType    archiveDatasets;

archive
{
    tarball   "ThermoML.v2020-09-30.tgz";
    doi       "10.18434/mds2-2422";
    note      "the finding aid; each article file is also served one by one at the NIST URL";
}

datasets
(
    {
        file          "constant/archiveExtracts/mNitrotoluene-vapourPressure-j.jct.2017.03.029.dat";
        role          fit;   // informational: the operation declares it
        doi           "10.1016/j.jct.2017.03.029";
        url           "https://trc.nist.gov/ThermoML/10.1016/j.jct.2017.03.029.xml";
        page          "https://trc.nist.gov/ThermoML/10.1016/j.jct.2017.03.029.json";
        articleFile   "j.jct.2017.03.029.xml";
        articleSha256 "99234f145a90ea93b06435e7e1e75588225d1242ca2bdc8c99f804ebeef86a0c";
        extractor     vapourPressure;
        inchiKey      "QZYHIOPPLUPUJF-UHFFFAOYSA-N";
        extract       "bin/choupo-thermoml extract-vp <article file> --inchikey QZYHIOPPLUPUJF-UHFFFAOYSA-N --into <dir>";
        sha256        "9607c9018f28c07e4129de39aada216d0ce8454eeb94214c43ef8525fcd372b1";
        identity
        {
            mNitrotoluene  { cas "99-08-1"; inchiKey "QZYHIOPPLUPUJF-UHFFFAOYSA-N"; }
        }
    }
);
