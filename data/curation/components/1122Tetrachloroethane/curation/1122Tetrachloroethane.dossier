            dataset   "constant/archiveExtracts/1122Tetrachloroethane-vapourPressure-j.fluid.2004.02.021.dat";
            doi       "10.1016/j.fluid.2004.02.021";
            sha256    "42886923df5836ca0d6431bd54b23f9e6b60134a57557dd8abe93b7affb46829";
            provenance measured;
            archiveFile "j.fluid.2004.02.021.xml";
            system    "1122Tetrachloroethane";
        }
        {
            role      fit;
            dataset   "constant/archiveExtracts/1122Tetrachloroethane-vapourPressure-j.fluid.2004.10.025.dat";
            doi       "10.1016/j.fluid.2004.10.025";
            sha256    "7b79c0cb959854f02f974c4ae788a2e506e2b45c26b46b2cef49bb8657b07d23";
            provenance measured;
            archiveFile "j.fluid.2004.10.025.xml";
