            archiveFile "j.jct.2005.06.003.xml";
            system    "1122Tetrachloroethane";
        }
        );

        domain
        {
            coordinate  K;
            fit         { min 283.15; max 418.95; n 40; }
        }
    }

    metrics
    {
        r2InSample        0.999976746804;   // the model reproducing the points it was FITTED to
        //  NO HELD-OUT METRIC EXISTS.  r2InSample above is exactly that --
        //  in-sample -- and must not be read as an external check.
    }
}

);
