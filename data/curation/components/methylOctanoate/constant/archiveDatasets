(
    {
        file          "constant/archiveExtracts/methylOctanoate-vapourPressure-j.jct.2016.07.024.dat";
        role          fit;   // informational: the operation declares it
        doi           "10.1016/j.jct.2016.07.024";
        url           "https://trc.nist.gov/ThermoML/10.1016/j.jct.2016.07.024.xml";
        page          "https://trc.nist.gov/ThermoML/10.1016/j.jct.2016.07.024.json";
        articleFile   "j.jct.2016.07.024.xml";
        articleSha256 "ab5f70414539ba6b3049ce1befb3819b033d81f9e8d72d2c46a028563d033bf0";
        extractor     vapourPressure;
        inchiKey      "JGHZJRVDZXSNKQ-UHFFFAOYSA-N";
        extract       "bin/choupo-thermoml extract-vp <article file> --inchikey JGHZJRVDZXSNKQ-UHFFFAOYSA-N --into <dir>";
        sha256        "b30ed59eeb025716f7b826e3f4b54b280ed0685c525a9e0684b0413f0b0cc88f";
        identity
        {
            methylOctanoate { cas "111-11-5"; inchiKey "JGHZJRVDZXSNKQ-UHFFFAOYSA-N"; }
        }
    }
);
