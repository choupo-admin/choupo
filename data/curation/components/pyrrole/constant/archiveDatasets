/*--------------------------------*- Choupo -*--------------------------------*\
  constant/archiveDatasets -- WHERE the measurements of pyrrole
  come from, and how to regenerate them.  NO MEASURED POINT IS IN THIS TREE
  (Vitor, 2026-11-10: the measured series are not copied; only the fitted
  parameters are kept).  `bin/choupo-curate fetch <case>` writes each
  dataset into constant/archiveExtracts/ (gitignored): the article file is taken from
  the local ThermoML cache when it holds it, else from the NIST URL below,
  and BOTH sha256 sums are checked -- a mismatch refuses, an unreachable
  NIST is reported NOT RUN, never a pass.
\*-----------------------------------------------------------------------------*/

recordType    archiveDatasets;

archive
{
    tarball   "ThermoML.v2020-09-30.tgz";
    doi       "10.18434/mds2-2422";
    note      "the finding aid; each article file is also served one by one at the NIST URL";
}

datasets
(
    {
        file          "constant/archiveExtracts/pyrrole-vapourPressure-je3004194.dat";
        role          fit;   // informational: the operation declares it
        doi           "10.1021/je3004194";
        url           "https://trc.nist.gov/ThermoML/10.1021/je3004194.xml";
        page          "https://trc.nist.gov/ThermoML/10.1021/je3004194.json";
        articleFile   "je3004194.xml";
        articleSha256 "41ca2327122fc9bf33e08a775a38fe4608c8dfc950b68ed867d512554fa420a1";
        extractor     vapourPressure;
        inchiKey      "KAESVJOAVNADME-UHFFFAOYSA-N";
        extract       "bin/choupo-thermoml extract-vp <article file> --inchikey KAESVJOAVNADME-UHFFFAOYSA-N --into <dir>";
        sha256        "21e54e138af78be026a9be85e4cca98bd513732b098b6bb2ff44051fd0943293";
        identity
        {
            pyrrole        { cas "109-97-7"; inchiKey "KAESVJOAVNADME-UHFFFAOYSA-N"; }
        }
    }
    {
        file          "constant/archiveExtracts/pyrrole-vapourPressure-j.fluid.2013.10.029.dat";
        role          fit;   // informational: the operation declares it
        doi           "10.1016/j.fluid.2013.10.029";
        url           "https://trc.nist.gov/ThermoML/10.1016/j.fluid.2013.10.029.xml";
        page          "https://trc.nist.gov/ThermoML/10.1016/j.fluid.2013.10.029.json";
        articleFile   "j.fluid.2013.10.029.xml";
        articleSha256 "677887c0d046d99c9b1bef648690af245277cbacea1dfa87adea33ffe1a5967f";
        extractor     vapourPressure;
        inchiKey      "KAESVJOAVNADME-UHFFFAOYSA-N";
        extract       "bin/choupo-thermoml extract-vp <article file> --inchikey KAESVJOAVNADME-UHFFFAOYSA-N --into <dir>";
        sha256        "6b1aa207b0809e2ac274e6e35fed19f10af617b4c6a67c158b8b3b76520466d2";
        identity
        {
            pyrrole        { cas "109-97-7"; inchiKey "KAESVJOAVNADME-UHFFFAOYSA-N"; }
        }
    }
);
