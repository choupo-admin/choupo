operations
(
    {
        name       fit_antoine;
        type       vaporPressureFit;
        component  dimethylethanolamine;

        evidence
        (
            {
                dataset   "constant/archiveExtracts/dimethylethanolamine-vapourPressure-je049761y.dat";
                identity  { doi "10.1021/je049761y"; }
                role      fit;
            }
            {
                dataset   "constant/archiveExtracts/dimethylethanolamine-vapourPressure-j.jct.2013.03.020.dat";
                identity  { doi "10.1016/j.jct.2013.03.020"; }
                role      fit;
            }
            {
                dataset   "constant/archiveExtracts/dimethylethanolamine-vapourPressure-je101259r.dat";
                identity  { doi "10.1021/je101259r"; }
                role      fit;
            }
        );

        objective  { method twoStage; }
        outliers   { maxRelativeError 15 percent; }
        window
        {
            pressureMax  200 kPa;
            reason       "uniform rule of DEV.md 4c C367: the full-range fit graded worse than clean and measured points lie above 2 bar, which a three-parameter Antoine cannot hold together with the low-pressure end; fitted from the lowest measured point up to 2 bar; the points above are left out and their error against the fitted curve is reported";
        }

        output     { file fit_antoine.csv; }
    }
);
