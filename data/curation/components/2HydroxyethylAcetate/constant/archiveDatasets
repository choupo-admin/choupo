        extractor     vapourPressure;
        inchiKey      "HXDLWJWIAHWIKI-UHFFFAOYSA-N";
        extract       "bin/choupo-thermoml extract-vp <article file> --inchikey HXDLWJWIAHWIKI-UHFFFAOYSA-N --into <dir>";
        sha256        "5432570a98bf188dae8475134373d2a6d77013ff1bcd29d640f814302051c275";
        identity
        {
            2HydroxyethylAcetate { cas "542-59-6"; inchiKey "HXDLWJWIAHWIKI-UHFFFAOYSA-N"; }
        }
    }
