            archiveFile "j.fluid.2018.12.005.xml";
            system    "perfluorooctane";
        }
        );

        domain
        {
            coordinate  K;
            fit         { min 277.72; max 352.86; n 25; }
        }
    }

    metrics
    {
        r2InSample        0.999424949493;   // the model reproducing the points it was FITTED to
        //  NO HELD-OUT METRIC EXISTS.  r2InSample above is exactly that --
        //  in-sample -- and must not be read as an external check.
    }
}

);
