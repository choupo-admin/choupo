/*--------------------------------*- Choupo -*--------------------------------*\
  CURATION DOSSIER -- a scientific work record, NOT runtime property data.

  NOTHING IN THIS FILE IS VISIBLE TO THE SOLVER.  Record resolution looks only
  in <case>/constant/, data/standards/ and data/local/, so a file here is out
  of its reach BY CONSTRUCTION -- not by convention.

  Nothing here has been promoted.  Curation state belongs to the evidence
  process; runtime trust belongs to the numerical record actually admitted
  to data/standards/, and only an explicit human promotion moves one there
  (bin/curate/promote-from-dossier).

  MATURITY IS PER PROPERTY, not per component: the properties below may hold
  different verdicts, and any whole-component summary is DERIVED from them
  rather than stored beside them.

  Regenerated on every run.  Hand edits are lost.
\*-----------------------------------------------------------------------------*/

component      perfluorooctane;
reviewStatus   unreviewed;

properties
(
{
    property       vapourPressure;
    operation      fit_antoine;   // type vaporPressureFit
    model          "Antoine  log10(Psat[bar]) = A - B/(T + C)";
    verdict        validationRefused;
    refusal        "No independent experimental evidence remains after fitting.";

    fittedParameters
    {
        A  4.10452520276;
        B  1306.50373469;
        C  -62.1156722769;
    }

    evidence
    {
        partitionFingerprint  "61c9d5fc96a23b38";   // frozen before the fit

        datasets
        (
        {
            role      fit;
            dataset   "constant/archiveExtracts/perfluorooctane-vapourPressure-acs.jced.6b00409.dat";
            doi       "10.1021/acs.jced.6b00409";
            sha256    "8c0b855929ff94f1a7267f051c3dddae923d80616e21bbbe7b18496c79e095a3";
            provenance measured;
            archiveFile "acs.jced.6b00409.xml";
            system    "perfluorooctane";
        }
        {
            role      fit;
            dataset   "constant/archiveExtracts/perfluorooctane-vapourPressure-j.fluid.2013.01.017.dat";
            doi       "10.1016/j.fluid.2013.01.017";
            sha256    "1733e88bbed2d0e2adc02b923cde686244a8cc4fc5d092d40e59a211f9f74011";
            provenance measured;
            archiveFile "j.fluid.2013.01.017.xml";
            system    "perfluorooctane";
        }
        {
            role      fit;
            dataset   "constant/archiveExtracts/perfluorooctane-vapourPressure-j.fluid.2015.07.054.dat";
            doi       "10.1016/j.fluid.2015.07.054";
            sha256    "a38eb226cb4251ab44919d60f6810728a662874e0520a0a9f7eb3fbf798866f1";
            provenance measured;
            archiveFile "j.fluid.2015.07.054.xml";
            system    "perfluorooctane";
        }
        {
            role      fit;
            dataset   "constant/archiveExtracts/perfluorooctane-vapourPressure-j.fluid.2018.12.005.dat";
            doi       "10.1016/j.fluid.2018.12.005";
            sha256    "b536ef0c3e1b5db9c2b4435228869122145b244285d479fd8d63d551722a8d74";
