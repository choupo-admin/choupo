/*--------------------------------*- Choupo -*--------------------------------*\
  constant/archiveDatasets -- WHERE the measurements of nEicosane
  come from, and how to regenerate them.  NO MEASURED POINT IS IN THIS TREE
  (Vitor, 2026-11-10: the measured series are not copied; only the fitted
  parameters are kept).  `bin/choupo-curate fetch <case>` writes each
  dataset into constant/archiveExtracts/ (gitignored): the article file is taken from
  the local ThermoML cache when it holds it, else from the NIST URL below,
  and BOTH sha256 sums are checked -- a mismatch refuses, an unreachable
  NIST is reported NOT RUN, never a pass.
\*-----------------------------------------------------------------------------*/

recordType    archiveDatasets;

archive
{
    tarball   "ThermoML.v2020-09-30.tgz";
    doi       "10.18434/mds2-2422";
    note      "the finding aid; each article file is also served one by one at the NIST URL";
}

datasets
(
    {
        file          "constant/archiveExtracts/nEicosane-vapourPressure-acs.jced.6b00821.dat";
        role          fit;   // informational: the operation declares it
        doi           "10.1021/acs.jced.6b00821";
        url           "https://trc.nist.gov/ThermoML/10.1021/acs.jced.6b00821.xml";
        page          "https://trc.nist.gov/ThermoML/10.1021/acs.jced.6b00821.json";
        articleFile   "acs.jced.6b00821.xml";
        articleSha256 "a17d31db0c5e1ff22c22e07a2ba0ff21e9a18b306cc731cdd558a8562347b7e5";
        extractor     vapourPressure;
        inchiKey      "CBFCDTFDPHXCNY-UHFFFAOYSA-N";
        extract       "bin/choupo-thermoml extract-vp <article file> --inchikey CBFCDTFDPHXCNY-UHFFFAOYSA-N --into <dir>";
        sha256        "4b80593a8b4a49e6125fb86d75281b8bf3ba0d10cf3e2c361a3e3e39c7062fb6";
        identity
        {
            nEicosane      { cas "112-95-8"; inchiKey "CBFCDTFDPHXCNY-UHFFFAOYSA-N"; }
        }
    }
    {
        file          "constant/archiveExtracts/nEicosane-vapourPressure-je800534x.dat";
