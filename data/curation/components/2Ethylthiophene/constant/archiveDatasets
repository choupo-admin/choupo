/*--------------------------------*- Choupo -*--------------------------------*\
  constant/archiveDatasets -- WHERE the measurements of 2Ethylthiophene
  come from, and how to regenerate them.  NO MEASURED POINT IS IN THIS TREE
  (Vitor, 2026-11-10: the measured series are not copied; only the fitted
  parameters are kept).  `bin/choupo-curate fetch <case>` writes each
  dataset into constant/archiveExtracts/ (gitignored): the article file is taken from
  the local ThermoML cache when it holds it, else from the NIST URL below,
  and BOTH sha256 sums are checked -- a mismatch refuses, an unreachable
  NIST is reported NOT RUN, never a pass.
\*-----------------------------------------------------------------------------*/

recordType    archiveDatasets;

archive
{
    tarball   "ThermoML.v2020-09-30.tgz";
    doi       "10.18434/mds2-2422";
    note      "the finding aid; each article file is also served one by one at the NIST URL";
}

datasets
(
    {
        file          "constant/archiveExtracts/2Ethylthiophene-vapourPressure-acs.jced.8b00153.dat";
        role          fit;   // informational: the operation declares it
        doi           "10.1021/acs.jced.8b00153";
        url           "https://trc.nist.gov/ThermoML/10.1021/acs.jced.8b00153.xml";
        page          "https://trc.nist.gov/ThermoML/10.1021/acs.jced.8b00153.json";
        articleFile   "acs.jced.8b00153.xml";
        articleSha256 "88303e38a72c69044fcb13953e67bc10d0ffdca052380bd8f006c153a9eb6ff2";
        extractor     vapourPressure;
        inchiKey      "JCCCMAAJYSNBPR-UHFFFAOYSA-N";
        extract       "bin/choupo-thermoml extract-vp <article file> --inchikey JCCCMAAJYSNBPR-UHFFFAOYSA-N --into <dir>";
        sha256        "328b501d507f7f04fae180e70e573000160982f69f8cec51e6695dfa0afd7950";
        identity
        {
            2Ethylthiophene { cas "872-55-9"; inchiKey "JCCCMAAJYSNBPR-UHFFFAOYSA-N"; }
        }
    }
);
