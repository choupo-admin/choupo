(
    {
        file          "constant/archiveExtracts/11Diethoxyethane-vapourPressure-je049816w.dat";
        role          fit;   // informational: the operation declares it
        doi           "10.1021/je049816w";
        url           "https://trc.nist.gov/ThermoML/10.1021/je049816w.xml";
        page          "https://trc.nist.gov/ThermoML/10.1021/je049816w.json";
        articleFile   "je049816w.xml";
        articleSha256 "8b9bb0d793b59d468c75800fc9fcc82f92c3452997c56d973749f47c2bf52ae7";
        extractor     vapourPressure;
        inchiKey      "DHKHKXVYLBGOIT-UHFFFAOYSA-N";
        extract       "bin/choupo-thermoml extract-vp <article file> --inchikey DHKHKXVYLBGOIT-UHFFFAOYSA-N --into <dir>";
        sha256        "1a8efaf1bb8c786c8d72bba77533fba87bff5e97f23b303a53803768d87c9b53";
        identity
        {
            11Diethoxyethane { cas "105-57-7"; inchiKey "DHKHKXVYLBGOIT-UHFFFAOYSA-N"; }
        }
    }
);
