        extractor     vapourPressure;
        inchiKey      "BMRWNKZVCUKKSR-UHFFFAOYSA-N";
        extract       "bin/choupo-thermoml extract-vp <article file> --inchikey BMRWNKZVCUKKSR-UHFFFAOYSA-N --into <dir>";
        sha256        "9ddaf4bdda863fd5858283b4333f5703183dbffa1d0f28f1c630f4d13abc3784";
