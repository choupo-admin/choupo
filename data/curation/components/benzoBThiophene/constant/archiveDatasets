/*--------------------------------*- Choupo -*--------------------------------*\
  constant/archiveDatasets -- WHERE the measurements of benzoBThiophene
  come from, and how to regenerate them.  NO MEASURED POINT IS IN THIS TREE
  (Vitor, 2026-11-10: the measured series are not copied; only the fitted
  parameters are kept).  `bin/choupo-curate fetch <case>` writes each
  dataset into constant/archiveExtracts/ (gitignored): the article file is taken from
  the local ThermoML cache when it holds it, else from the NIST URL below,
  and BOTH sha256 sums are checked -- a mismatch refuses, an unreachable
  NIST is reported NOT RUN, never a pass.
\*-----------------------------------------------------------------------------*/

recordType    archiveDatasets;

archive
{
    tarball   "ThermoML.v2020-09-30.tgz";
    doi       "10.18434/mds2-2422";
    note      "the finding aid; each article file is also served one by one at the NIST URL";
}

datasets
(
    {
        file          "constant/archiveExtracts/benzoBThiophene-vapourPressure-j.fluid.2011.04.024.dat";
        role          fit;   // informational: the operation declares it
        doi           "10.1016/j.fluid.2011.04.024";
        url           "https://trc.nist.gov/ThermoML/10.1016/j.fluid.2011.04.024.xml";
        page          "https://trc.nist.gov/ThermoML/10.1016/j.fluid.2011.04.024.json";
        articleFile   "j.fluid.2011.04.024.xml";
        articleSha256 "f695b9de005b0fbb1168e244bcfb9665c5663e235f5586fa47cdb2ece4699899";
        extractor     vapourPressure;
        inchiKey      "FCEHBMOGCRZNNI-UHFFFAOYSA-N";
        extract       "bin/choupo-thermoml extract-vp <article file> --inchikey FCEHBMOGCRZNNI-UHFFFAOYSA-N --into <dir>";
        sha256        "861aebb9097c650b2388e1c70fcfa92e2e3eb482a2d22222a7ad8e2b9e5ce97c";
        identity
        {
            benzoBThiophene { cas "95-15-8"; inchiKey "FCEHBMOGCRZNNI-UHFFFAOYSA-N"; }
        }
    }
);
