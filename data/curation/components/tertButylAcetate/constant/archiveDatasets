        extractor     vapourPressure;
        inchiKey      "WMOVHXAZOJBABW-UHFFFAOYSA-N";
        extract       "bin/choupo-thermoml extract-vp <article file> --inchikey WMOVHXAZOJBABW-UHFFFAOYSA-N --into <dir>";
