(
    {
        file          "constant/archiveExtracts/triethanolamine-vapourPressure-j.tca.2018.05.007.dat";
        role          fit;   // informational: the operation declares it
        doi           "10.1016/j.tca.2018.05.007";
        url           "https://trc.nist.gov/ThermoML/10.1016/j.tca.2018.05.007.xml";
        page          "https://trc.nist.gov/ThermoML/10.1016/j.tca.2018.05.007.json";
        articleFile   "j.tca.2018.05.007.xml";
        articleSha256 "79beab9731f732339a1815f12bd8ae550f31e9b330b863e04a853b971ec543cf";
        extractor     vapourPressure;
        inchiKey      "GSEJCLTVZPLZKY-UHFFFAOYSA-N";
        extract       "bin/choupo-thermoml extract-vp <article file> --inchikey GSEJCLTVZPLZKY-UHFFFAOYSA-N --into <dir>";
        sha256        "b9446b5ce8680d61c85228b634eb7a0d511dc414dd6149c816abc2f6571397bd";
        identity
        {
            triethanolamine { cas "102-71-6"; inchiKey "GSEJCLTVZPLZKY-UHFFFAOYSA-N"; }
        }
    }
);
