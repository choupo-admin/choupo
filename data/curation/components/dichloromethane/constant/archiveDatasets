/*--------------------------------*- Choupo -*--------------------------------*\
  constant/archiveDatasets -- WHERE the measurements of dichloromethane
  come from, and how to regenerate them.  NO MEASURED POINT IS IN THIS TREE
  (Vitor, 2026-11-10: the measured series are not copied; only the fitted
  parameters are kept).  `bin/choupo-curate fetch <case>` writes each
  dataset into constant/archiveExtracts/ (gitignored): the article file is taken from
  the local ThermoML cache when it holds it, else from the NIST URL below,
  and BOTH sha256 sums are checked -- a mismatch refuses, an unreachable
  NIST is reported NOT RUN, never a pass.
\*-----------------------------------------------------------------------------*/

recordType    archiveDatasets;

archive
{
    tarball   "ThermoML.v2020-09-30.tgz";
    doi       "10.18434/mds2-2422";
    note      "the finding aid; each article file is also served one by one at the NIST URL";
}

datasets
(
    {
        file          "constant/archiveExtracts/dichloromethane-vapourPressure-j.fluid.2015.11.037.dat";
        role          fit;   // informational: the operation declares it
        doi           "10.1016/j.fluid.2015.11.037";
        url           "https://trc.nist.gov/ThermoML/10.1016/j.fluid.2015.11.037.xml";
        page          "https://trc.nist.gov/ThermoML/10.1016/j.fluid.2015.11.037.json";
        articleFile   "j.fluid.2015.11.037.xml";
        articleSha256 "a1135e989178ceaed06e6ce40bee2a0fcad23b1600e4eb25d0a59802e55eed05";
        extractor     vapourPressure;
        inchiKey      "YMWUJEATGCHHMB-UHFFFAOYSA-N";
        extract       "bin/choupo-thermoml extract-vp <article file> --inchikey YMWUJEATGCHHMB-UHFFFAOYSA-N --into <dir>";
        sha256        "b9053b85973f89cf759f964d38b4f79509ff70312a76c937421d72205057f143";
        identity
        {
            dichloromethane { cas "75-09-2"; inchiKey "YMWUJEATGCHHMB-UHFFFAOYSA-N"; }
        }
    }
);
