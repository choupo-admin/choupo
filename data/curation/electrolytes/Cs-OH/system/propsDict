/*--------------------------------*- Choupo -*--------------------------------*\
  Cs-OH -- the curation case of the salt (Cs)1(OH)1 (DEV.md 4c C311).
  Fits Pitzer and eNRTL to its evaluated gamma_pm and phi at 298.15 K
  (constant/experiments/Cs-OH.dat) and writes the two proposals that
  bin/curate/check_regressed_electrolytes.py holds the catalogue records
  equal to.  Written by bin/curate/electrolytes_c311.py; the rules
  (window, held-out points, grade, cap, promotion) are stated there.
\*-----------------------------------------------------------------------------*/

operations
(
    {
        name      fit_pitzer;
        type      electrolyteFit;
        cation    Cs;   anion OH;
        model     pitzer;
        dataset   "constant/experiments/Cs-OH.dat";
        heldOut   { every 4; offset 3; }
        pitzer    { alpha1 2.0; alpha2 12.0; fitBeta2 false; }
        grade     { limits_pct ( 2 5 10 ); }
        proposal  { file "Cs-OH.pitzer.proposal.dat"; }
    }
    {
        name      fit_eNRTL;
        type      electrolyteFit;
        cation    Cs;   anion OH;
        model     eNRTL;
        dataset   "constant/experiments/Cs-OH.dat";
        heldOut   { every 4; offset 3; }
        eNRTL     { alpha 0.2; }
        grade     { limits_pct ( 2 5 10 ); }
        proposal  { file "Cs-OH.eNRTL.proposal.dat"; }
    }
);
