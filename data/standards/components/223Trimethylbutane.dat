// UNIQUAC van der Waals volume r and surface area q: the sum of the
// record's own UNIFAC groups (5 CH3 + 1 CH + 1 C), R_k/Q_k of Hansen et al. 1991
// (DEV.md 4c C294; bin/curate/uniquac_rq_from_groups.py).
uniquac
{
    r   5.1719;
    q   4.4680;
}

groups
{
    unifac ( { group CH3; count 5; } { group CH; count 1; } { group C; count 1; } );
}
