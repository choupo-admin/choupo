{
    model         chemsepCp16;
    // Cp [J/(mol.K)] = A + exp(B/T + C + D T + E T^2)
    // ChemSep states J/(kmol.K); A and the exp are scaled to per-mole here.
    coefficients  (103.08  -583.42  6.363244721  5.2348e-05  -2.126e-08);
    Trange        (150  1500);
}

