/*--------------------------------*- Choupo -*-----------------------*\
  Component: methylOctanoate  (methyl octanoate; CAS 111-11-5)
  NEW in the catalogue (DEV.md 4c C292, slice 2 of C287, 2026-11-10), built by
  bin/curate/c287_new_components.py from measurements the NIST/TRC ThermoML Archive
  locates (the articles are the sources; their DOIs are in provenance).
  MEASURED: no critical constant, no Tb.  FITTED: vapour pressure (bin/choupo-curate vp),
  Vliq, liquid Cp.  DERIVED: omega (from the fitted vapour pressure at the ESTIMATED Tc).
  ESTIMATED (Joback): Tc, Pc, ideal-gas Cp, dHf_298; s_298 derived from Joback's
  dHf and dGf.  No measured series is reproduced here.
  reviewStatus autoPromoted, humanReviewed false: NO human has read it back.
  Psat: fitted by `bin/choupo-curate vp`; its promotion replaced the
  AmbroseWalton block this tool writes (provenance.vaporPressure).
\*---------------------------------------------------------------------------*/

name        methylOctanoate;
CAS         111-11-5;
formula     C9H18O2;
reviewStatus autoPromoted;
humanReviewed false;
MW          158.2410;      // kg/kmol, from the formula (IUPAC standard atomic weights)
Tc          634.326675;      // K, Joback ESTIMATE (provenance.Tc)
Pc          23.1807246;      // bar, Joback ESTIMATE (provenance.Pc)
omega       0.618951;      // [-] (provenance.omega)
//  Tb: NOT DECLARED -- the archive reports no boiling temperature at
//  101.3 kPa for it, and a Tb read back off the fitted Antoine would be
//  the curve tested against itself (the fitted normal boiling point is
//  in provenance.vaporPressure.acceptance.Tnb_fit).  Joback's Tb is NOT stored either: the vapour-pressure
//  grade would read an estimate as a measurement (WRITE_ESTIMATED_TB in
//  the tool); the case data/curation/batches/new_components_estimated prints it.

standardThermochemistry
{
    dHf_298   -546370;        // J/mol, ideal gas, Joback ESTIMATE (provenance.dHf_298)
    s_298     557.87;        // J/(mol K), ideal gas, DERIVED from Joback (provenance.s_298)
}

vaporPressure
{
    model         Antoine;
    // log10(Psat [bar]) = A - B / (T[K] + C), FITTED by bin/choupo-curate vp to
    // measured vapour pressures -- see provenance.vaporPressure
    coefficients  (4.540473228  1810.288101  -66.4366529);
    Trange        (282.64  432.68);   // the fit's own span; outside it the engine announces the extrapolation
}

Vliq        1.800340e-04;      // m3/mol at 25 C, FITTED (provenance.Vliq)

idealGasHeatCapacity
{
    model         polynomial;
    // Cp [J/(mol K)] = a0 + a1 T + a2 T^2 + a3 T^3, Joback ESTIMATE
    coefficients  (20.116  0.80404  -3.712000e-04  3.880000e-08);
    Trange        (273  1000);
}

liquidHeatCapacity
{
    model         polynomial;
    // Cp [J/(mol K)] = a0 + a1 T + a2 T^2, FITTED (provenance.liquidHeatCapacity)
    coefficients  (332.4579556  -0.4512982306  0.001322523149);
    Trange        (240  373.15);
}

groups
{
    unifac ( { group CH3; count 2; } { group CH2; count 5; } { group CH2COO; count 1; } );
    joback ( { group CH3; count 2; } { group CH2; count 6; } { group ester; count 1; } );
}

provenance
{
    groups
    {
        origin       definition;
        method       "unifac: the original UNIFAC subgroups assigned from the structure CH3(CH2)5-CH2COO-CH3; atom count of the decomposition equals the formula C9H18O2 (checked when written, 2026-11-11) and agrees with the unifac_choupo column of data/groupEstimative/compounds.csv";
        citation     "subgroup definitions of Hansen, Rasmussen, Fredenslund, Schiller & Gmehling, Ind. Eng. Chem. Res. 30 (1991) 2352, as tabulated in data/standards/parameters/UNIFAC/groups.dat";
    }
    MW
    {
        origin        literature;
        method        "sum of IUPAC standard atomic weights over the formula";
    }
    Tc
    {
        origin           estimated;
        method           "Joback";
        methodVersion    "joback-poling5e-table2-2";
        input            joback;
        inputFingerprint "CH2:6,CH3:2,ester:1";
        reproducedInCase "data/curation/batches/new_components_estimated";
        uncertainty      { status unquantified; reason "Joback group contribution (Joback & Reid 1987); Tc within a few per cent and Pc within about 5-10 per cent for ordinary organics, worse for polyfunctional molecules"; }
        notes            "the archive carries no critical temperature for this compound; all groups of the structure are in the Joback table";
    }
    Pc
    {
        origin           estimated;
        method           "Joback";
        methodVersion    "joback-poling5e-table2-2";
        input            joback;
        inputFingerprint "CH2:6,CH3:2,ester:1";
        reproducedInCase "data/curation/batches/new_components_estimated";
        uncertainty      { status unquantified; reason "Joback group contribution (Joback & Reid 1987); Tc within a few per cent and Pc within about 5-10 per cent for ordinary organics, worse for polyfunctional molecules"; }
        notes            "the archive carries no critical pressure for this compound; all groups of the structure are in the Joback table";
    }
    omega
    {
        origin        regressed;
        method        "DERIVED from a fit: omega = -log10(Psat(0.7 Tc)/Pc) - 1 from the Antoine the vapour-pressure pipeline fitted (data/curation/components/methylOctanoate) and the measured Tc, Pc; 0.7 Tc = 444.03 K, EXTRAPOLATED +11.3 K beyond the fitted range (282.64-432.68 K)";
        derivedBy     "bin/curate/c287_new_components.py";
        reviewStatus  autoPromoted;
        humanReviewed false;
        reviewReason  "derived by a machine; read it with the fitGrade of the vapour pressure it comes from";
    }
    Vliq
    {
        origin        fitted;
        method        "one-parameter fit of the engine's own liquid density, V(T) = Vliq Rackett(T)/Rackett(298.15 K) with this record's Tc, Pc, omega (ThermoPackage::density, liquid branch), to every measured liquid mass density at or below 200 kPa; least squares in the relative density error, then its largest value minimised";
        fittedBy      "bin/curate/c287_new_components.py";
        reviewStatus  autoPromoted;
        humanReviewed false;
        fitGrade      clean;   // DEV.md 4c C285 limits 5 / 10 / 20 %
        fitGradeMaxRelativeError_pct 0.887595;
        reviewReason  "regressed by a machine from archive-transcribed measurements; not yet read back against the articles";
        reuse         "Choupo's own regression; the measured points belong to the cited articles and are not reproduced in this record or this tree";
        evidence
        (
            { doi "10.1016/j.fluid.2018.04.024"; articleSha256 "6d2b75684874acb6a37a3caacae8e11da6846c861c3d645779768293fbf11196"; pointsKept 8; pointsDropped 0; provenance measured; }
            { doi "10.1016/j.jct.2019.02.025"; articleSha256 "12cf93e3d2eaecb2f7ee5dd945261dda34b5cb45a8949d9b5629f53483205504"; pointsKept 17; pointsDropped 0; provenance measured; }
            { doi "10.1021/je100042c"; articleSha256 "92f271664a2023b27fbdee360873285acd388374992987e5ccaf93bbb3a15045"; pointsKept 15; pointsDropped 0; provenance measured; }
        );
        acceptance
        {
            rule        "the default graded acceptance of DEV.md 4c C285 on the max relative error over the kept points (clean / warning / severe up to 5 / 10 / 20 %); every laboratory fitted, points beyond 15 % after the least-squares stage discarded by name (C283 amended)";
            verdict     accepted;
            studies     3;
            pointsKept  40;
            pointsDropped 0;
            dropped     "none";
            aad_pct     0.579856;
            max_pct     0.887595;
            Trange      (283.15 453.15);   // K, the kept points
        }
    }
    liquidHeatCapacity
    {
        origin        fitted;
        method        "polynomial of degree 2 in T fitted to every measured liquid isobaric heat capacity at or below 200 kPa (specific values converted with MW); least squares in the relative error, then its largest value minimised";
        fittedBy      "bin/curate/c287_new_components.py";
        reviewStatus  autoPromoted;
        humanReviewed false;
        fitGrade      clean;   // DEV.md 4c C285 limits 5 / 10 / 20 %
        fitGradeMaxRelativeError_pct 0.446278;
        reviewReason  "regressed by a machine from archive-transcribed measurements; not yet read back against the articles";
        reuse         "Choupo's own regression; the measured points belong to the cited articles and are not reproduced in this record or this tree";
        evidence
        (
            { doi "10.1016/j.jct.2018.09.024"; articleSha256 "994bbeb1f8f7f2bb30c1e02ca7521a130ea4738ced6a1aab47258099b219029c"; pointsKept 8; pointsDropped 0; provenance measured; }
            { doi "10.1021/je0499364"; articleSha256 "3c7c6c01c9476577c1c9087959e12d9bbec124cbcc83236340e2b2450f065078"; pointsKept 12; pointsDropped 0; provenance measured; }
        );
        acceptance
        {
            rule        "the default graded acceptance of DEV.md 4c C285 on the max relative error over the kept points (clean / warning / severe up to 5 / 10 / 20 %); every laboratory fitted, points beyond 15 % after the least-squares stage discarded by name (C283 amended)";
            verdict     accepted;
            studies     2;
            pointsKept  20;
            pointsDropped 0;
            dropped     "none";
            aad_pct     0.170121;
            max_pct     0.446278;
            Trange      (240 373.15);   // K, the kept points
        }
    }
    idealGasHeatCapacity
    {
        origin           estimated;
        method           "Joback";
        methodVersion    "joback-poling5e-table2-2";
        input            joback;
        inputFingerprint "CH2:6,CH3:2,ester:1";
        reproducedInCase "data/curation/batches/new_components_estimated";
        uncertainty      { status unquantified; reason "Joback group contribution (Joback & Reid 1987); a few percent for Cp_ig of ordinary organics"; }
    }
    dHf_298
    {
        origin           estimated;
        method           "Joback";
        methodVersion    "joback-poling5e-table2-2";
        input            joback;
        inputFingerprint "CH2:6,CH3:2,ester:1";
        reproducedInCase "data/curation/batches/new_components_estimated";
        uncertainty      { status unquantified; reason "Joback group contribution (Joback & Reid 1987); several kJ/mol, more for polyfunctional molecules"; }
        notes            "the ThermoML archive carries no enthalpy of formation or combustion block for this compound (searched)";
    }
    s_298
    {
        origin           estimated;
        method           "derived from Joback: s_298 = (dHf_298 - dGf_298)/298.15 + the sum of the elements' standard entropies, with Joback's dGf_298 = -285470 J/mol (not stored: dGf derives from dHf and s_298)";
        methodVersion    "joback-poling5e-table2-2";
        input            joback;
        inputFingerprint "CH2:6,CH3:2,ester:1";
        elementEntropies "CODATA Key Values for Thermodynamics (Cox, Wagman & Medvedev, 1989): S(C, graphite) 5.74, S(H2, g) 130.680, S(O2, g) 205.152, S(N2, g) 191.609, S(F2, g) 202.791, S(Cl2, g) 223.081, S(Br2, l) 152.206, S(I2, cr) 116.139 J/(mol K)";
        reproducedInCase "data/curation/batches/new_components_estimated";
        uncertainty      { status unquantified; reason "inherits the errors of Joback's dHf_298 and dGf_298"; }
    }
    vaporPressure
    {
        origin        fitted;
        method        "vaporPressureFit (three-parameter Antoine; objective twoStage: least squares in log10 P, then the largest relative error in P minimised from it; every usable study fitted, outliers above 15 % discarded by name)";
        methodVersion "choupoProps Choupo-dev";
        fittedInCase  "data/curation/components/methylOctanoate";
        reviewStatus  autoPromoted;
        humanReviewed false;
        fitGrade      clean;   // DEV.md 4c C285: the worse of the grades below
        fitGradeMaxRelativeError_pct 1.983099;   // grade clean
        promotedBy    "bin/choupo-curate vp --promote";
        promotedDate  "2026-11-10";
        reviewReason  "regressed by bin/choupo-curate from archive-transcribed measurements; not yet read back against the articles";
        reuse         "Choupo's own regression; the measured points belong to the cited articles and are not reproduced in this record or this tree";
        uncertainty   "the fit's maximum relative error over every kept measurement, below";
        replaces      "model AmbroseWalton (a corresponding-states estimate from Tc, Pc, omega); `bin/choupo-curate revert <component>` restores it";
        evidence
        (
            {
                role      fit;
                dataset   "constant/archiveExtracts/methylOctanoate-vapourPressure-j.jct.2016.07.024.dat";
                doi       "10.1016/j.jct.2016.07.024";
                sha256    "b30ed59eeb025716f7b826e3f4b54b280ed0685c525a9e0684b0413f0b0cc88f";
                articleSha256 "ab5f70414539ba6b3049ce1befb3819b033d81f9e8d72d2c46a028563d033bf0";
                pointsKept    16;
                pointsDropped 0;
                provenance measured;
            }
        );
        acceptance
        {
            rule        "the default of DEV.md 4c C285 (graded): max relative error in P over the kept points 5 / 10 / 20 %, and |Tnb - Tb| 1 / 2 / 4 K where Tb lies outside their range, are the upper limits of clean / warning / severe; above, refused; the grade is the worse of the two";
            verdict     accepted;
            studies     1;
            pointsKept  16;
            pointsDropped 0;
            dropped     "none";
            aad_pct     1.483115;   // the fitted Antoine, every kept point
            max_pct     1.983099;
            awAad_pct   11.421833;   // the AmbroseWalton curve it replaces, the same points
            awMax_pct   30.715640;
