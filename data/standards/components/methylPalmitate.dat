name        methylPalmitate;

//  Review state, MACHINE-READABLE (AP2, 2026-08-05).  This used to
//  live only in the banner above, which the parser discards -- so the
//  engine could not announce it and a run said nothing.
reviewStatus   interim;
reviewReason   importedFromCoolProp720_notCheckedAgainstPrimaries;
formula     C17H34O2;
CAS         112-39-0;

MW          270.4507;        // kg/kmol  [CoolProp]
Tc          755.0001;        // K        [CoolProp EOS]
Pc          13.49958;        // bar      [CoolProp EOS]
omega       0.91032;        // [-]      [CoolProp EOS]
Tb          602.2689;        // K  normal boiling [CoolProp]
HvapTb      56786.6;        // J/mol  at Tb     [CoolProp]

vaporPressure
{
    model         Antoine;
    // log10(Psat [bar]) = A - B / (T[K] + C)   -- fitted to CoolProp EOS
    coefficients  (4.59981   2289.97   -103.274);
    Trange        (339.75  739.90);
}

idealGasHeatCapacity
{
    model         polynomial;
    // Cp [J/(mol.K)] = a0 + a1 T + a2 T^2 + a3 T^3   -- fitted to CoolProp cp0
    coefficients  (12.853  1.56707  -0.000806508  1.32508e-07);
    Trange        (200  1000);
}

liquidHeatCapacity
{
    model         polynomial;
    // Cp_liq [J/(mol.K)]   -- fitted to CoolProp saturated-liquid cp
    coefficients  (376.654  0.639981  -1.43446e-05  1.79158e-07);
    Trange        (378  602);
}

triplePoint
{
    T   302.7100;
    P   0.0164;
}

standardThermochemistry
{
    dHf_298   -711490;      // J/mol ideal-gas -- provenance: see the structured dHf_298 block below
    dGf_298   -218110;      // J/mol  ideal-gas [Joback]
    s_298     869.485;      // J/(mol*K) third-law [DERIVED: (dHf-dGf)/T + CODATA element S]
}

// UNIQUAC van der Waals volume r and surface area q: the sum of the
// record's own UNIFAC groups (2 CH3 + 13 CH2 + 1 CH2COO), R_k/Q_k of Hansen et al. 1991
// (DEV.md 4c C294; bin/curate/uniquac_rq_from_groups.py).
uniquac
{
    r   12.2458;
    q   10.1360;
}

groups { unifac ( { group CH3; count 2; } { group CH2; count 13; } { group CH2COO; count 1; } ); joback ( { group CH3; count 2; } { group CH2; count 14; } { group ester; count 1; } ); }

liquidViscosity
{
    chemsepEq101
    {
        A     -116.318675;
        B     7146.769509;
        C     15.29411262;
        D     0;
        E     0;
        Tmin  308.15;
        Tmax  363.15;
    }
}

provenance
{
    uniquac
    {
        origin        definition;
        method        "sum of UNIFAC group R_k/Q_k: r = sum nu_k R_k = 12.2458, q = sum nu_k Q_k = 10.1360 over the record's unifac groups (2 CH3 + 13 CH2 + 1 CH2COO)";
        citation      "R_k and Q_k of Hansen, Rasmussen, Fredenslund, Schiller & Gmehling, Ind. Eng. Chem. Res. 30 (1991) 2352, as tabulated in data/standards/parameters/UNIFAC/groups.dat; the group sum of Fredenslund, Jones & Prausnitz, AIChE J. 21 (1975) 1086";
    }
    dHf_298
    {
        origin           estimated;
        method           "Joback";
        methodVersion    "joback-poling5e-table2-2";
        input            joback;
        inputFingerprint "CH2:14,CH3:2,ester:1";
        uncertainty      { status unquantified; reason "bulk-import band ~9 kJ/mol, primary basis not verified"; }
    }

    constants      "CoolProp 7.2.0 -- Huber-EF-2009";
    vaporPressure  "Antoine fitted to CoolProp EOS saturation, AAD 1.34%";
    idealGasCp     "polynomial fitted to CoolProp cp0, maxerr 0.06%";
    liquidCp       "polynomial fitted to CoolProp sat-liquid cp, maxerr 0.02%";
    triplePoint    "CoolProp reference EOS triple-point T,P";
    preserved      "from prior proposal (NOT CoolProp): standardThermochemistry, groups";
    liquidViscosity
    {
        origin        fitted;
        method        "least squares on ln y of ln(mu/Pa.s) = A + B/T + C ln T (chemsepEq101 with D = 0), 3 parameter(s), then the largest relative error minimised; every laboratory the archive holds for the pure liquid at <= 200 kPa; points beyond 15 % after the first stage discarded by name";
        fittedBy      "bin/curate/transport_fit.py";
        reviewStatus  autoPromoted;
        review        { by none; }   // DEV.md 4c C300 rule 4: nobody has reviewed it
        fitGrade      clean;   // DEV.md 4c C285 limits 5 / 10 / 20 % on the max relative error
        fitGradeBasis inSample;   // DEV.md 4c C300 rule 1
        fitGradeMaxRelativeError_pct 4.065760;
        Trange        (308.15 363.15);   // K, the kept points -- outside it the engine announces an extrapolation
        reviewReason  "regressed by a machine from archive-transcribed measurements; not yet read back against the articles";
        reuse         "Choupo's own regression; the measured points belong to the cited articles and are not reproduced in this record or this tree (DEV.md 4c C327)";
        evidence
        (
                { doi "10.1021/je100042c"; articleSha256 "92f271664a2023b27fbdee360873285acd388374992987e5ccaf93bbb3a15045"; pointsKept 12; pointsDropped 0; provenance measured; }
                { doi "10.1021/je600552b"; articleSha256 "b924c391214570485ed5ebb680643e42a26763ea8d6d0949e79ef6d445dd9739"; pointsKept 4; pointsDropped 0; provenance measured; }
        );
        acceptance
