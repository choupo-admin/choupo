/*--------------------------------*- Choupo -*-----------------------*\
  Component: Acetaldehyde CH3CHO (partial-oxidation intermediate; GAS-PHASE combustion entry -- liquid/Psat blocks pending curation for process use)
  Ideal-gas formation data and heat capacity READ from
  NASA/TP-2002-211556 (McBride, Zehe & Gordon 2002, "NASA Glenn
  Coefficients for Calculating Thermodynamic Properties of Individual
  Species"), a US government work in the public domain: entry
  "CH3CHO,ethanal", appendix D p. 91 (dHf_298 and the NASA-9 Cp coefficients,
  as printed) and Table B1 p. 15 (s_298).  The report's own sources
  for this species: Hf:TRC (6/78) w5300. Chao,1986.
  No liquid phase at process conditions -- the entry is tagged
  `role nonvolatile;` so vapour-pressure routines never get called.
  Transcribed 2026-10-25 by bin/curate/nasa_tp2002_to_choupo.py (DEV.md
  4c C164), which holds H and S at 298.15 K recomputed from the printed
  coefficients to the printed values; not yet read back by a curator.
\*---------------------------------------------------------------------------*/

name           acetaldehyde;
formula        C2H4O;
CAS            75-07-0;

MW             44.053;       // kg/kmol
role        nonvolatile;
tags           ( gasPhase combustion );
reviewStatus   interim;
reviewReason   "transcribed by machine from NASA/TP-2002-211556 and checked against the report itself; not yet read back against the page by a curator";

standardThermochemistry
{
    dHf_298    -166190.000;   // J/mol  -- ideal gas; NASA/TP-2002-211556 appendix D, p. 91, entry CH3CHO,ethanal
    s_298      263.952;     // J/(mol·K) -- third-law absolute; Table B1, p. 15
}

idealGasHeatCapacity
{
    //  NASA/TP-2002-211556 eq. (1), Cp/R = a1/T^2 + a2/T + a3 + a4 T + a5 T^2
    //  + a6 T^3 + a7 T^4; appendix D, p. 91, entry CH3CHO,ethanal, a1..a7 as printed.
    model    NASA9;
    Tlow     200;
    Tcommon  1000;
    Thigh    6000;
    low      ( -1.373904369e+05 2.559937679e+03 -1.340470172e+01 5.922128620e-02 -6.240006050e-05 3.703324410e-08 -9.342697410e-12 );
    high     ( 3.321176590e+06 -1.449719957e+04 2.708421279e+01 -2.879320054e-03 5.556309920e-07 -5.732674880e-11 2.443965239e-15 );
}

groups
{
    unifac ( { group CH3; count 1; } { group CHO; count 1; } );   // added from data/groupEstimative (UNIFAC decomposition; vocab-checked vs groups.dat)
}

cosmo
{
    VT2005
    {
        model       COSMOSAC;
        variant     "2002";
        source      "VT-2005 sigma-profile database (Mullins et al., Ind. Eng. Chem. Res. 45 (2006) 4389; DFT-COSMO), file VT2005-0406-PROF.txt bundled in usnistgov/COSMOSAC; CAS 75-07-0";
        licence     externalRestricted;   // VT-2005: redistribution NOT confirmed -- values NOT shipped
        installed   false;                 // install your own copy: bin/choupo-import-cosmo (-> data/local/cosmo/VT2005/)
    }
}

provenance
{
    dHf_298
    {
        origin        literature;
        method        "NASA/TP-2002-211556 appendix D, p. 91, entry CH3CHO,ethanal, record-line H(298.15) (elements reference, so = dHf)";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "Table B1 p. 15 prints -166.19 kJ/mol; the report's own sources: Hf:TRC (6/78) w5300. Chao,1986.";
    }
    s_298
    {
        origin        literature;
        method        "NASA/TP-2002-211556 Table B1, p. 15, entry CH3CHO,ethanal";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "appendix D's coefficients with b2 integrate to 263.952";
    }
    idealGasHeatCapacity
    {
        origin        literature;
        method        "NASA/TP-2002-211556 appendix D, p. 91, entry CH3CHO,ethanal, a1..a7 of the 200-1000 K and 1000-6000 K intervals, as printed";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "read by bin/curate/nasa_tp2002_to_choupo.py, which holds H and S at 298.15 K to the printed values";
    }
    source   "McBride, Zehe & Gordon, NASA Glenn Coefficients for Calculating Thermodynamic Properties of Individual Species, NASA/TP-2002-211556 (2002)";
    licence  publicDomain;    // US government work (NASA), 17 U.S.C. 105
}
