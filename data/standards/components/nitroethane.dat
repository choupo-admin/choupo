//  HANSEN solubility-parameter triple (DEV.md 4c C428 (b); a model's fact about
//  the pure liquid, read by `hansenMixture` and the Explorer's solvent lens).
//  Hansen 1967 thesis, Table 2.1 row 40 "Nitroethane", revised placements:
//  delta_d = 7.80, delta_p = 7.6, delta_h = 2.2 (cal/cm3)^0.5, x sqrt(4.184e6) = 2045.4828.
hansen
{
    dD    15954.8;        // Pa^0.5   = 7.80 (cal/cm3)^0.5, thesis Table 2.1 row 40
    dP    15545.7;        // Pa^0.5   = 7.6
    dH    4500.1;        // Pa^0.5   = 2.2
    Tref  298.15 K;       // adopted: the thesis prints no temperature beside Table 2.1
}

// UNIQUAC van der Waals volume r and surface area q: the sum of the
// record's own UNIFAC groups (1 CH2NO2 + 1 CH3), R_k/Q_k of Hansen et al. 1991
// (DEV.md 4c C294; bin/curate/uniquac_rq_from_groups.py).
uniquac
{
    r   2.6829;
    q   2.4080;
}

groups
{
    unifac ( { group CH2NO2; count 1; } { group CH3; count 1; } );   // derived from structure CCN(=O)=O by bin/curate/unifac_groups.py
}

provenance
{
    uniquac
    {
        origin        definition;
        method        "sum of UNIFAC group R_k/Q_k: r = sum nu_k R_k = 2.6829, q = sum nu_k Q_k = 2.4080 over the record's unifac groups (1 CH2NO2 + 1 CH3)";
        citation      "R_k and Q_k of Hansen, Rasmussen, Fredenslund, Schiller & Gmehling, Ind. Eng. Chem. Res. 30 (1991) 2352, as tabulated in data/standards/parameters/UNIFAC/groups.dat; the group sum of Fredenslund, Jones & Prausnitz, AIChE J. 21 (1975) 1086";
    }
    unifacGroups
    {
        origin        derived;
        method        "cut from the molecular structure CCN(=O)=O (atom count reproduces the record's formula) into 1 CH2NO2 + 1 CH3 by the rules of bin/curate/unifac_groups.py; no table of decompositions was consulted";
        citation      "Hansen, Rasmussen, Fredenslund, Schiller & Gmehling, Ind. Eng. Chem. Res. 30 (1991) 2352 (the subgroup definitions, data/standards/parameters/UNIFAC/groups.dat)";
        reviewStatus  interim;
    }
    hansen
    {
        origin        literature;
        method        "Hansen 1967 thesis, Table 2.1 row 40 (Nitroethane), revised placements; (cal/cm3)^0.5 x 2045.4828 -> Pa^0.5";
        citation      "Hansen, C. M., The Three Dimensional Solubility Parameter and Solvent Diffusion Coefficient, doctoral dissertation, Danish Technical Press, Copenhagen (1967), Table 2.1 (pages 18-19), row 40; no DOI";
        reviewStatus  interim;
        notes         "transcribed from the page image 2026-10-21; Tref 298.15 K adopted, the thesis states no temperature beside the table";
    }
    MW
    {
        origin        literature;
        method        "ChemSep database import";
        methodVersion "chemsep-pcd-8.3";
        uncertainty   "not quantified by source";
        notes         "ChemSep v8.3 record; Artistic-2.0";
    }
    Tc
    {
        origin        literature;
        method        "ChemSep database import";
        methodVersion "chemsep-pcd-8.3";
        uncertainty   "not quantified by source";
        notes         "ChemSep v8.3 record; Artistic-2.0";
    }
    Pc
    {
        origin        literature;
        method        "ChemSep database import";
