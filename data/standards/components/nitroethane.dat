name        nitroethane;
CAS         79-24-3;
formula     C2H5NO2;      // counted from the ChemSep v8.3 structure formula "CH3CH2NO2" (derived 2026-09-03; reproduces MW to 0.001 %)
reviewStatus interim;
MW          75.0666;      // kg/kmol [origin=ChemSep v8.3]
Tc          557.15;      // K [origin=ChemSep v8.3]
Pc          51.6;      // bar; source Pa / 1e5 [origin=ChemSep v8.3]
omega       0.672348;      // [-] [origin=ChemSep v8.3]
Tb          387.22;      // K [origin=ChemSep v8.3]

standardThermochemistry
{
    dHf_298   -102200;        // J/mol   [ChemSep v8.3, ideal gas]
    s_298     315.4;        // J/(mol.K)  third-law absolute
}

vaporPressure
{
    model         Antoine;
    // log10(Psat [bar]) = A - B / (T[K] + C)
    // converted EXACTLY from ChemSep eqno 10, Psat[Pa] = exp(a - b/(T+c))
    coefficients  (4.328645471  1468.740508  -47.509);
    Trange        (334.45  500);
}

Vliq        7.19984e-05;      // m3/mol at 25 C  [ChemSep eqno 105]
HvapTb      35683.4;      // J/mol at Tb  [ChemSep eqno 106]

idealGasHeatCapacity
{
    model         chemsepCp16;
    // Cp [J/(mol.K)] = A + exp(B/T + C + D T + E T^2)
    // ChemSep states J/(kmol.K); A and the exp are scaled to per-mole here.
    coefficients  (48.198  -581.79  5.375244721  2.3838e-05  -2.2739e-08);
    Trange        (150  1500);
}

liquidHeatCapacity
{
    model         chemsepCp16;
    // Cp [J/(mol.K)] = A + exp(B/T + C + D T + E T^2)
    coefficients  (67.99  798.52  -4.420355279  0.02816  -2.7001e-05);
    Trange        (183.63  387.22);
}

liquidViscosity
{
    chemsepEq101
    {
        A     15.403;
        B     194.75;
        C     -4.2217;
        D     7.8126e-06;
        E     2;
        Tmin  200;
        Tmax  457;
    }
}

liquidThermalConductivity
{
    chemsepEq16
    {
        A     -0.1486;
        B     6.324;
        C     -1.0708;
        D     9.663e-05;
        E     -1.5981e-06;
        Tmin  183.63;
        Tmax  387.22;
    }
}
solubilityParameter 23090;   // Pa^0.5  [ANCHOR, ChemSep v8.3 -- checked against, never used]

source
