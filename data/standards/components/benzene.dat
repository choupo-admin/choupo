/*--------------------------------*- Choupo -*-----------------------*\
  Component: Benzene  (C6H6, CAS 71-43-2)
  Sources:   constants (Tc/Pc/omega/MW/Tb) + vapour pressure cross-checked
             against CoolProp 7.2.0 (MIT); ideal-gas formation enthalpy/
             entropy against the NASA polynomial database (NASA TM-4513).
             Latent heat at Tb is an individual literature value --
             primary re-citation pending (IST review).
\*---------------------------------------------------------------------------*/

name        benzene;
formula     C6H6;
CAS         71-43-2;



MW          78.114;        // kg/kmol
Tc          562.05;        // K
Pc          48.95;         // bar
omega       0.2103;        // [-]   acentric factor
Tb          353.24;        // K     normal boiling point
HvapTb      30720;         // J/mol latent heat at Tb
Vliq        8.943e-5;      // m³/mol liquid molar volume at 25 °C  (= 89.43 cm³/mol)
//  ANCHOR, never an input.  The engine DERIVES the Hildebrand
//  parameter from HvapTb and Vliq (the tree stores no derivative);
//  this is what ChemSep v8.3 computed independently, so the
//  derivation has something to be wrong against.
solubilityParameter 18700;   // Pa^0.5  [anchor, ChemSep v8.3, Artistic-2.0]


standardThermochemistry
{
    dHf_298   82930.0;        // J/mol  -- ideal-gas reference
    s_298     269.310;         // J/(mol·K)  -- third-law absolute
}
vaporPressure
{
    model         Antoine;
    // log10(Psat [bar]) = A - B / (T[K] + C)
    coefficients  (4.01814   1203.835   -53.226);
    Trange        (287.7  354.07);
}

idealGasHeatCapacity
{
    model         polynomial;
    // Cp [J/(mol·K)] = a0 + a1*T + a2*T^2 + a3*T^3
    coefficients  (-31.368   0.4746   -3.117e-4   8.523e-8);
    Trange        (200  1500);
}

liquidHeatCapacity
{
    model         polynomial;
    // Approximate average over 280–370 K  (individual literature value)
    coefficients  (135.4);
    Trange        (278  350);
}

// Liquid transport (v0.62+).  associationFactor = Wilke-Chang phi (solvent).
// liquidViscosity: ln(mu/Pa.s) = A + B/T (Andrade) or A + B/(T-C) (Vogel),
// fitted to literature mu(T) over ~10-100 degC.
associationFactor  1.0;
liquidViscosity
{
    andrade { A -11.5804; B 1243.3; }
    vogel   { A -10.7929; B 794.4; C 63.0; }
}

// UNIQUAC van der Waals volume r and surface area q: the sum of the
// record's own UNIFAC groups (6 ACH), R_k/Q_k of Hansen et al. 1991
// (DEV.md 4c C294; bin/curate/uniquac_rq_from_groups.py).
uniquac
{
    r   3.1878;
    q   2.4000;
}

groups
{
    joback ( { group arCH; count 6; } );
    unifac ( { group ACH; count 6; } );
}

// ---- Aqueous-speciation FACTS (substance-level, classifier-read) ----
// Curated fact: benzene does NOT participate in the aqueous speciation
// network.  An aromatic hydrocarbon has no ionisable proton in water at
// any pH the network describes.  It says nothing about benzene's aqueous
// behaviour in general -- its solubility is tiny and its activity
// coefficient enormous, which is why it forms a SECOND LIQUID rather than
// dissolving; that is phase behaviour, not speciation.
aqueousSpeciation  none;

cosmo
{
    VT2005
    {
        model       COSMOSAC;
        variant     "2002";
        source      "VT-2005 sigma-profile database (Mullins et al., Ind. Eng. Chem. Res. 45 (2006) 4389; DFT-COSMO), file VT2005-0242-PROF.txt bundled in usnistgov/COSMOSAC; CAS 71-43-2";
        licence     externalRestricted;   // VT-2005: redistribution NOT confirmed -- values NOT shipped
        installed   false;                 // install your own copy: bin/choupo-import-cosmo (-> data/local/cosmo/VT2005/)
    }
    LVPP-HFTZVP-2018
    {
        model       COSMOSAC;
        variant     "LVPP-HFTZVP-2018";
        protocol    "LVPP-18.07 GAMESS HF/TZVP; r_av 1.4 A; f_decay 3.57; d in A; sigma = q/a";
        source      "LVPP sigma-profile database release 18.07 (github.com/lvpp/sigma, asset HF_TZVP.zip, sha256 bd17aaeebb430641...), file BENZENE.gout; MIT License, Copyright (c) 2017 LVPP; cite Ferrarini, Flores, Muniz & Soares, AIChE J. 64 (2018) 3443, doi:10.1002/aic.16194, and doi:10.5281/zenodo.3613786; identity: InChIKey UHOVQNZJYSORNB-UHFFFAOYSA-N (full match); formula C6H6; resolved by thirdParty/thermoml/identity.json (PubChem and CACTUS agree)";
        derivation  "segment areas, charges and the cavity volume are LVPP's (GAMESS HF/TZVP COSMO output); `area` is the sum of LVPP's segment areas as binned (GAMESS's printed cavity area agrees within its 2-decimal rounding); the 51-point profile is COMPUTED BY CHOUPO from LVPP's surface segments by bin/curate/lvpp_sigma_profile.py under the protocol above (Bell et al. 2020 Eq. 4 averaging, sigma = q/a, area split linearly between grid nodes)";
        licence     MIT;
        installed   true;
        area        121.201008;   // sum of the profile below; GAMESS prints 121.20
        volume      109.00;
        sigmaProfile  (
               0.000000     0.000000     0.000000     0.000000     0.000000     0.000000
               0.000000     0.000000     0.000000     0.000000     0.000000     0.000000
               0.000000     0.000000     0.000000     0.000000     0.000000     1.907506
               6.024615    15.800766    10.215076     7.598853     6.344052     7.273782
               6.154883     3.734009     5.151725     7.531253     8.160612     3.715055
              12.387264     9.834518     9.367039     0.000000     0.000000     0.000000
               0.000000     0.000000     0.000000     0.000000     0.000000     0.000000
               0.000000     0.000000     0.000000     0.000000     0.000000     0.000000
               0.000000     0.000000     0.000000
        );
    }
}

liquidThermalConductivity
{
    chemsepEq16
    {
        A     0;
        B     -153.6175505;
        C     -0.2496313938;
        D     -0.0039916846;
        E     0;
        Tmin  281.1774;
        Tmax  392.16;
    }
}

surfaceTension
{
    A     0.05938721632;
    B     0;
    Tc    562.05;
    n     0.9857290218;
    Tmin  279.73;
    Tmax  313.7;
}

provenance
{
    uniquac
    {
        origin        definition;
        method        "sum of UNIFAC group R_k/Q_k: r = sum nu_k R_k = 3.1878, q = sum nu_k Q_k = 2.4000 over the record's unifac groups (6 ACH)";
        citation      "R_k and Q_k of Hansen, Rasmussen, Fredenslund, Schiller & Gmehling, Ind. Eng. Chem. Res. 30 (1991) 2352, as tabulated in data/standards/parameters/UNIFAC/groups.dat; the group sum of Fredenslund, Jones & Prausnitz, AIChE J. 21 (1975) 1086";
    }
    liquidThermalConductivity
    {
        origin        fitted;
        method        "least squares on ln y of ln(k/(W/m/K)) = C + B/T + D T (chemsepEq16 with A = 0, E = 0), 3 parameter(s), then the largest relative error minimised; every laboratory the archive holds for the pure liquid at <= 200 kPa; points beyond 15 % after the first stage discarded by name";
        fittedBy      "bin/curate/transport_fit.py";
        reviewStatus  autoPromoted;
        review        { by none; }   // DEV.md 4c C300 rule 4: nobody has reviewed it
        fitGrade      clean;   // DEV.md 4c C285 limits 5 / 10 / 20 % on the max relative error
        fitGradeBasis inSample;   // DEV.md 4c C300 rule 1
        fitGradeMaxRelativeError_pct 0.579943;
        Trange        (281.1774 392.16);   // K, the kept points -- outside it the engine announces an extrapolation
        reviewReason  "regressed by a machine from archive-transcribed measurements; not yet read back against the articles";
        reuse         "Choupo's own regression; the measured points belong to the cited articles and are not reproduced in this record or this tree (DEV.md 4c C327)";
        evidence
        (
                { doi "10.1021/je034162x"; articleSha256 "f6b4f99d31c9534eb4d0ae76af37ded12a05324f864606e6863ff6eec20b5b01"; pointsKept 12; pointsDropped 0; provenance measured; }
                { doi "10.1021/je900641w"; articleSha256 "2e43042fad703f40cff64f8a6249b706a173842698d0304d7834dae4c4033257"; pointsKept 4; pointsDropped 0; provenance measured; }
        );
        acceptance
        {
            verdict     accepted;
            studies     2;
            pointsKept  16;
            pointsDropped 0;
            dropped     "none";
            aad_pct     0.462073;
            max_pct     0.579943;
        }
    }
    surfaceTension
    {
        origin        fitted;
        method        "least squares on ln sigma of sigma/(N/m) = A tau^n, tau = 1 - T/Tc (A, n; B = 0; Tc the record's own), then the largest relative error minimised; every laboratory the archive holds for the pure liquid at <= 200 kPa; points beyond 15 % after the first stage discarded by name";
        fittedBy      "bin/curate/transport_fit.py";
        reviewStatus  autoPromoted;
        review        { by none; }   // DEV.md 4c C300 rule 4: nobody has reviewed it
        fitGrade      clean;   // DEV.md 4c C285 limits 5 / 10 / 20 % on the max relative error
        fitGradeBasis inSample;   // DEV.md 4c C300 rule 1
        fitGradeMaxRelativeError_pct 1.891316;
        Trange        (279.73 313.7);   // K, the kept points -- outside it the engine announces an extrapolation
        reviewReason  "regressed by a machine from archive-transcribed measurements; not yet read back against the articles";
        reuse         "Choupo's own regression; the measured points belong to the cited articles and are not reproduced in this record or this tree (DEV.md 4c C328)";
        evidence
        (
                { doi "10.1016/j.fluid.2013.07.053"; articleSha256 "844d0a167ca7135148715208b23e8ed1b7cf5871bd0c3741a05459ecf433f582"; pointsKept 37; pointsDropped 0; provenance measured; }
                { doi "10.1016/j.jct.2008.10.009"; articleSha256 "bb420be152933e5642aaeecc55da6bf001e0008baa99ec86e389ae7d641c304b"; pointsKept 1; pointsDropped 0; provenance measured; }
                { doi "10.1016/j.tca.2005.08.034"; articleSha256 "85ab06dd41987ee9db73642fd32c5e132c393f2483e43e7f2051ed47072d8438"; pointsKept 1; pointsDropped 0; provenance measured; }
                { doi "10.1021/acs.jced.5b00009"; articleSha256 "31f2078c9a4b979c9c64d3b710bf903e856ded41ab16773a6cfa88510d02ead2"; pointsKept 5; pointsDropped 0; provenance measured; }
                { doi "10.1021/je500205z"; articleSha256 "de6213bfca9b4754a45493cf576de2d8280b507501a96f8997111b9e6268070c"; pointsKept 1; pointsDropped 0; provenance measured; }
        );
        acceptance
        {
            verdict     accepted;
            studies     5;
            pointsKept  45;
            pointsDropped 0;
            dropped     "none";
            aad_pct     0.955650;
            max_pct     1.891316;
        }
    }
