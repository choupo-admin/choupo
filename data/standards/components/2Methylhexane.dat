HvapTb      30816.6;      // J/mol at Tb  [ChemSep eqno 106]

idealGasHeatCapacity
{
    model         chemsepCp16;
    // Cp [J/(mol.K)] = A + exp(B/T + C + D T + E T^2)
    // ChemSep states J/(kmol.K); A and the exp are scaled to per-mole here.
    coefficients  (88.324  -552.27  6.136244721  0.00017909  -6.2753e-08);
    Trange        (200  1500);
}

