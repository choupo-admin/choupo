    coefficients  (4.843254969  2057.065156  -81.55267619);
    Trange        (365.15  703.4);   // the fit's own span; outside it the engine announces the extrapolation
}

Vliq        1.306010e-04;      // m3/mol at 25 C, FITTED (provenance.Vliq)

idealGasHeatCapacity
{
    model         polynomial;
