// (DEV.md 4c C294; bin/curate/uniquac_rq_from_groups.py).
uniquac
{
    r   9.2779;
    q   7.8160;
}

groups
{
    unifac ( { group CH3; count 2; } { group CH2; count 7; } { group CH2O; count 3; } );
    joback ( { group CH3; count 2; } { group CH2; count 10; } { group ether; count 3; } );
}

provenance
{
