uniquac
{
    r   13.5946;
    q   11.2160;
}

groups { unifac ( { group CH3; count 2; } { group CH2; count 15; } { group CH2COO; count 1; } ); joback ( { group CH3; count 2; } { group CH2; count 16; } { group ester; count 1; } ); }

