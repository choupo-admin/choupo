/*--------------------------------*- Choupo -*-----------------------*\
  Component: epichlorohydrin  (1-chloro-2,3-epoxypropane (epichlorohydrin, racemic); CAS 106-89-8)
  NEW in the catalogue (DEV.md 4c C309, slice 3 of C287, 2026-11-11), built by
  bin/curate/c287_new_components.py from the IUPAC critical-property series, the
  Zabransky liquid heat-capacity review and the measurements the NIST/TRC
  ThermoML Archive locates (the articles are the sources; every value's
  citation or DOIs are in provenance).
  FITTED: vapour pressure (bin/choupo-curate vp), Vliq.
  DERIVED: omega (from the fitted vapour pressure).
  ESTIMATED (Joback): Tc, Pc, ideal-gas Cp, dHf_298; s_298 derived from Joback's dHf and dGf.
  ESTIMATED (Rowlinson-Bondi, Poling 5e Eq. 6-6.4): liquid Cp -- no measurement or recommended correlation in hand.
  No measured series is reproduced here.
  reviewStatus autoPromoted, review by none: NO human has read it back.
  Psat: fitted by `bin/choupo-curate vp`; its promotion replaced the
  AmbroseWalton block this tool writes (provenance.vaporPressure).
\*---------------------------------------------------------------------------*/

name        epichlorohydrin;
CAS         106-89-8;
formula     C3H5ClO;
reviewStatus autoPromoted;
review      { by none; }   // DEV.md 4c C300 rule 4 (C297): nobody has reviewed it
MW          92.5220;      // kg/kmol, from the formula (IUPAC standard atomic weights)
Tc          530.680315;      // K, Joback ESTIMATE (provenance.Tc)
Pc          49.4539297;      // bar, Joback ESTIMATE (provenance.Pc)
omega       0.931641;      // [-] (provenance.omega)
//  Tb: NOT DECLARED -- the archive reports no boiling temperature at
//  101.3 kPa for it, and a Tb read back off the fitted Antoine would be
//  the curve tested against itself (the fitted normal boiling point is
//  in provenance.vaporPressure.acceptance.Tnb_fit).  Joback's Tb is NOT stored either: the vapour-pressure
//  grade would read an estimate as a measurement (WRITE_ESTIMATED_TB in
//  the tool); the case data/curation/batches/new_components_c309 prints it.

standardThermochemistry
{
    dHf_298   -180190;        // J/mol, ideal gas, Joback ESTIMATE (provenance.dHf_298)
    s_298     164.71;        // J/(mol K), ideal gas, DERIVED from Joback (provenance.s_298)
}

vaporPressure
{
    model         Antoine;
    // log10(Psat [bar]) = A - B / (T[K] + C), FITTED by bin/choupo-curate vp to
    // measured vapour pressures -- see provenance.vaporPressure
    coefficients  (4.312110813  1420.47504  -59.25310494);
    Trange        (315.67  388.29);   // the fit's own span; outside it the engine announces the extrapolation
}

Vliq        7.878407e-05;      // m3/mol at 25 C, FITTED (provenance.Vliq)

idealGasHeatCapacity
{
    model         polynomial;
    // Cp [J/(mol K)] = a0 + a1 T + a2 T^2 + a3 T^3, Joback ESTIMATE
    coefficients  (-19.869  0.4435  -3.661000e-04  1.241000e-07);
    Trange        (273  1000);
}

liquidHeatCapacity
{
    model         polynomial;
    // Cp [J/(mol K)] = a0 + a1 T + a2 T^2, Rowlinson-Bondi ESTIMATE (provenance.liquidHeatCapacity)
    coefficients  (298.1915377  -0.5840707641  0.0009952403427);
    Trange        (315.67  388.29);
}

groups
{
    joback ( { group rCH2; count 1; } { group rCH; count 1; } { group etherRing; count 1; } { group CH2; count 1; } { group Cl; count 1; } );
}

provenance
{
    MW
    {
        origin        literature;
        method        "sum of IUPAC standard atomic weights over the formula";
    }
    Tc
    {
        origin           estimated;
        method           "Joback";
        methodVersion    "joback-poling5e-table2-2";
        input            joback;
        inputFingerprint "CH2:1,Cl:1,etherRing:1,rCH:1,rCH2:1";
        reproducedInCase "data/curation/batches/new_components_c309";
        uncertainty      { status unquantified; reason "Joback group contribution (Joback & Reid 1987); Tc within a few per cent and Pc within about 5-10 per cent for ordinary organics, worse for polyfunctional molecules"; }
        notes            "neither the IUPAC series (Parts 7-10, 12) nor the archive gives a critical temperature for this compound; all groups of the structure are in the Joback table";
    }
    Pc
    {
        origin           estimated;
        method           "Joback";
        methodVersion    "joback-poling5e-table2-2";
        input            joback;
        inputFingerprint "CH2:1,Cl:1,etherRing:1,rCH:1,rCH2:1";
        reproducedInCase "data/curation/batches/new_components_c309";
        uncertainty      { status unquantified; reason "Joback group contribution (Joback & Reid 1987); Tc within a few per cent and Pc within about 5-10 per cent for ordinary organics, worse for polyfunctional molecules"; }
        notes            "neither the IUPAC series (Parts 7-10, 12) nor the archive gives a critical pressure for this compound; all groups of the structure are in the Joback table";
    }
    omega
    {
        origin        regressed;
        method        "DERIVED from a fit: omega = -log10(Psat(0.7 Tc)/Pc) - 1 from the Antoine the vapour-pressure pipeline fitted (data/curation/components/epichlorohydrin) and the Joback-estimated Tc, Pc; 0.7 Tc = 371.48 K, inside the fitted range";
        derivedBy     "bin/curate/c287_new_components.py";
        reviewStatus  autoPromoted;
        review        { by none; }   // DEV.md 4c C300 rule 4 (C297): nobody has reviewed it
        reviewReason  "derived by a machine; read it with the fitGrade of the vapour pressure it comes from";
    }
    Vliq
    {
        origin        fitted;
        method        "one-parameter fit of the engine's own liquid density, V(T) = Vliq Rackett(T)/Rackett(298.15 K) with this record's Tc, Pc, omega (ThermoPackage::density, liquid branch), to every measured liquid mass density at or below 200 kPa; least squares in the relative density error, then its largest value minimised";
        fittedBy      "bin/curate/c287_new_components.py";
        reviewStatus  autoPromoted;
        review        { by none; }   // DEV.md 4c C300 rule 4 (C297): nobody has reviewed it
        fitGrade      clean;   // DEV.md 4c C285 limits 5 / 10 / 20 %
        fitGradeBasis inSample;   // DEV.md 4c C300 rule 1: the residual of the points it was fitted to
        fitGradeMaxRelativeError_pct 0.129733;
        reviewReason  "regressed by a machine from archive-transcribed measurements; not yet read back against the articles";
        reuse         "Choupo's own regression; the measured points belong to the cited articles and are not reproduced in this record or this tree";
        evidence
        (
            { doi "10.1016/j.jct.2004.11.015"; articleSha256 "0b0ecaf961c36dd7300bf4c0ee8640cbba1c9a07e2d75b74fedbd59150174849"; pointsKept 1; pointsDropped 0; provenance measured; }
            { doi "10.1016/j.jct.2012.01.005"; articleSha256 "b4093188bea017059df1dd0ccf8616e62d567f6c7371120653d7b24b2d0deec8"; pointsKept 1; pointsDropped 0; provenance measured; }
            { doi "10.1021/je020148t"; articleSha256 "d050eca5b9e079c12efbc563ccbe13ba0767c44a1d625df7ba1b8c73d98b46fa"; pointsKept 1; pointsDropped 0; provenance measured; }
            { doi "10.1021/je034018b"; articleSha256 "e8a1b945d9fc93b639c6e64feba7af44d160bae105cf53a184941664924d061a"; pointsKept 1; pointsDropped 0; provenance measured; }
        );
        acceptance
        {
            rule        "the default graded acceptance of DEV.md 4c C285 on the max relative error over the kept points (clean / warning / severe up to 5 / 10 / 20 %); every laboratory fitted, points beyond 15 % after the least-squares stage discarded by name (C283 amended)";
            verdict     accepted;
            studies     4;
            pointsKept  4;
            pointsDropped 0;
            dropped     "none";
            aad_pct     0.074467;
            max_pct     0.129733;
            Trange      (293 298.15);   // K, the kept points
        }
    }
    liquidHeatCapacity
    {
        origin           estimated;
        method           "Rowlinson-Bondi corresponding states, Poling, Prausnitz & O'Connell, The Properties of Gases and Liquids, 5th ed. (2001), Eq. (6-6.4): (Cp_L - Cp_ig)/R = 1.586 + 0.49/(1 - Tr) + omega [4.2775 + 6.3 (1 - Tr)^(1/3)/Tr + 0.4355/(1 - Tr)], with this record's Joback Cp_ig, Tc (Joback ESTIMATE) and omega; represented by a quadratic in T least-squares fitted to the equation over 315.67-388.29 K (the fitted vapour pressure's span within 0.40-0.80 Tc), max deviation 0.021 % from it";
        computedBy       "bin/curate/c287_new_components.py (rowlinson_bondi)";
        inputFingerprint "CH2:1,Cl:1,etherRing:1,rCH:1,rCH2:1";
        reproducedInCase "data/curation/batches/new_components_c309";
        uncertainty      { status unquantified; reason "Poling 5e p. 6.22: 2.5 % AAD on 194 substances at 298 K, more than 10 % on 18 others, most hydrogen-bonded (C1-C4 alcohols and acids, water, amines); the archive locates no liquid Cp for this compound and no Zabransky supplement in hand recommends one"; }
        reviewStatus     autoPromoted;
        review           { by none; }   // DEV.md 4c C300 rule 4 (C297): nobody has reviewed it
    }
    idealGasHeatCapacity
    {
        origin           estimated;
        method           "Joback";
        methodVersion    "joback-poling5e-table2-2";
        input            joback;
        inputFingerprint "CH2:1,Cl:1,etherRing:1,rCH:1,rCH2:1";
        reproducedInCase "data/curation/batches/new_components_c309";
        uncertainty      { status unquantified; reason "Joback group contribution (Joback & Reid 1987); a few percent for Cp_ig of ordinary organics"; }
    }
    dHf_298
    {
        origin           estimated;
        method           "Joback";
        methodVersion    "joback-poling5e-table2-2";
        input            joback;
        inputFingerprint "CH2:1,Cl:1,etherRing:1,rCH:1,rCH2:1";
        reproducedInCase "data/curation/batches/new_components_c309";
        uncertainty      { status unquantified; reason "Joback group contribution (Joback & Reid 1987); several kJ/mol, more for polyfunctional molecules"; }
        notes            "the ThermoML archive carries no enthalpy of formation or combustion block for this compound (searched)";
    }
    s_298
    {
        origin           estimated;
        method           "derived from Joback: s_298 = (dHf_298 - dGf_298)/298.15 + the sum of the elements' standard entropies, with Joback's dGf_298 = -62920 J/mol (not stored: dGf derives from dHf and s_298)";
        methodVersion    "joback-poling5e-table2-2";
        input            joback;
        inputFingerprint "CH2:1,Cl:1,etherRing:1,rCH:1,rCH2:1";
        elementEntropies "CODATA Key Values for Thermodynamics (Cox, Wagman & Medvedev, 1989): S(C, graphite) 5.74, S(H2, g) 130.680, S(O2, g) 205.152, S(N2, g) 191.609, S(F2, g) 202.791, S(Cl2, g) 223.081, S(Br2, l) 152.206, S(I2, cr) 116.139 J/(mol K)";
        reproducedInCase "data/curation/batches/new_components_c309";
        uncertainty      { status unquantified; reason "inherits the errors of Joback's dHf_298 and dGf_298"; }
    }
    vaporPressure
    {
        origin        fitted;
        method        "vaporPressureFit (three-parameter Antoine; objective twoStage: least squares in log10 P, then the largest relative error in P minimised from it; every usable study fitted, outliers above 15 % discarded by name)";
        methodVersion "choupoProps Choupo-dev";
        fittedInCase  "data/curation/components/epichlorohydrin";
        reviewStatus  autoPromoted;
        review        { by none; }   // DEV.md 4c C300 rule 4 (C297): nobody has reviewed it
        fitGrade      clean;   // DEV.md 4c C285: the worse of the grades below
        fitGradeBasis inSample;   // DEV.md 4c C300 rule 1: the residual of the points it was fitted to
        fitGradeMaxRelativeError_pct 0.086020;   // grade clean
        promotedBy    "bin/choupo-curate vp --promote";
        promotedDate  "2026-11-11";
        reviewReason  "regressed by bin/choupo-curate from archive-transcribed measurements; not yet read back against the articles";
        reuse         "Choupo's own regression; the measured points belong to the cited articles and are not reproduced in this record or this tree";
        uncertainty   "the fit's maximum relative error over every kept measurement, below";
        replaces      "model AmbroseWalton (a corresponding-states estimate from Tc, Pc, omega); `bin/choupo-curate revert <component>` restores it";
        evidence
        (
            {
                role      fit;
                dataset   "constant/archiveExtracts/epichlorohydrin-vapourPressure-je700398k.dat";
                doi       "10.1021/je700398k";
                sha256    "8fb0a42398876b3b1d042a639376ba4846f3a4efdb208e79c856005ed844d304";
                articleSha256 "0fa8def301d87ad7133114d7a5b2f59be2246969898aa71e0b968d61fc7111e3";
                pointsKept    24;
                pointsDropped 0;
                provenance measured;
            }
        );
        acceptance
        {
            rule        "the default of DEV.md 4c C285 (graded): max relative error in P over the kept points 5 / 10 / 20 %, and |Tnb - Tb| 1 / 2 / 4 K where Tb lies outside their range, are the upper limits of clean / warning / severe; above, refused; the grade is the worse of the two";
            verdict     accepted;
            studies     1;
            pointsKept  24;
            pointsDropped 0;
            dropped     "none";
            aad_pct     0.039134;   // the fitted Antoine, every kept point
            max_pct     0.086020;
            awAad_pct   26.982644;   // the AmbroseWalton curve it replaces, the same points
            awMax_pct   52.044550;
            Tnb_fit     389.1056;   // K, the fitted curve at 101.325 kPa
        }
    }
}
