  AmbroseWalton block this tool writes (provenance.vaporPressure).
\*---------------------------------------------------------------------------*/

name        methylDecanoate;
CAS         110-42-9;
formula     C11H22O2;
reviewStatus autoPromoted;
humanReviewed false;
MW          186.2950;      // kg/kmol, from the formula (IUPAC standard atomic weights)
Tc          675;      // K, IUPAC recommended (provenance.Tc)
Pc          19.3;      // bar, IUPAC recommended (provenance.Pc)
omega       0.590107;      // [-] (provenance.omega)
//  Tb: NOT DECLARED -- the archive reports no boiling temperature at
//  101.3 kPa for it, and a Tb read back off the fitted Antoine would be
//  the curve tested against itself (the fitted normal boiling point is
//  in provenance.vaporPressure.acceptance.Tnb_fit).  Joback's Tb is NOT stored either: the vapour-pressure
//  grade would read an estimate as a measurement (WRITE_ESTIMATED_TB in
//  the tool); the case data/curation/batches/new_components_estimated prints it.

standardThermochemistry
{
    dHf_298   -587650;        // J/mol, ideal gas, Joback ESTIMATE (provenance.dHf_298)
    s_298     635.77;        // J/(mol K), ideal gas, DERIVED from Joback (provenance.s_298)
}

vaporPressure
{
    model         Antoine;
    // log10(Psat [bar]) = A - B / (T[K] + C), FITTED by bin/choupo-curate vp to
    // measured vapour pressures -- see provenance.vaporPressure
    coefficients  (5.080368384  2219.894215  -60.25711065);
    Trange        (273.35  432.65);   // the fit's own span; outside it the engine announces the extrapolation
}

Vliq        2.142275e-04;      // m3/mol at 25 C, FITTED (provenance.Vliq)

idealGasHeatCapacity
{
    model         polynomial;
    // Cp [J/(mol K)] = a0 + a1 T + a2 T^2 + a3 T^3, Joback ESTIMATE
    coefficients  (18.298  0.99404  -4.800000e-04  6.260000e-08);
    Trange        (273  1000);
}

liquidHeatCapacity
{
    model         polynomial;
    // Cp [J/(mol K)] = a0 + a1 T + a2 T^2, FITTED (provenance.liquidHeatCapacity)
    coefficients  (282.6634986  0.158971295  0.0005406141844);
    Trange        (270  373.15);
}

groups
{
    unifac ( { group CH3; count 2; } { group CH2; count 7; } { group CH2COO; count 1; } );
    joback ( { group CH3; count 2; } { group CH2; count 8; } { group ester; count 1; } );
