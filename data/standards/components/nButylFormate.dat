/*--------------------------------*- Choupo -*-----------------------*\
  Component: nButylFormate  (butyl methanoate (butyl formate); CAS 592-84-7)
  NEW in the catalogue (DEV.md 4c C309, slice 3 of C287, 2026-11-11), built by
  bin/curate/c287_new_components.py from the IUPAC critical-property series, the
  Zabransky liquid heat-capacity review and the measurements the NIST/TRC
  ThermoML Archive locates (the articles are the sources; every value's
  citation or DOIs are in provenance).
  IUPAC RECOMMENDED (critically evaluated measurements): Tc.
  MEASURED (archive median): Tb.
  RECOMMENDED (Zabransky): liquid Cp.
  FITTED: vapour pressure (bin/choupo-curate vp), Vliq.
  DERIVED: omega (from the fitted vapour pressure).
  ESTIMATED (Joback): Pc, ideal-gas Cp, dHf_298; s_298 derived from Joback's dHf and dGf.
  No measured series is reproduced here.
  reviewStatus autoPromoted, review by none: NO human has read it back.
  Psat: fitted by `bin/choupo-curate vp`; its promotion replaced the
  AmbroseWalton block this tool writes (provenance.vaporPressure).
\*---------------------------------------------------------------------------*/

name        nButylFormate;
CAS         592-84-7;
formula     C5H10O2;
reviewStatus autoPromoted;
review      { by none; }   // DEV.md 4c C300 rule 4 (C297): nobody has reviewed it
MW          102.1330;      // kg/kmol, from the formula (IUPAC standard atomic weights)
Tc          566;      // K, IUPAC recommended (provenance.Tc)
Pc          37.1349495;      // bar, Joback ESTIMATE (provenance.Pc)
omega       0.349231;      // [-] (provenance.omega)
Tb          380.13;      // K, measured (provenance.Tb)

standardThermochemistry
{
    dHf_298   -364330;        // J/mol, ideal gas, Joback ESTIMATE (provenance.dHf_298)
    s_298     380.69;        // J/(mol K), ideal gas, DERIVED from Joback (provenance.s_298)
}

vaporPressure
{
    model         Antoine;
    // log10(Psat [bar]) = A - B / (T[K] + C), FITTED by bin/choupo-curate vp to
    // measured vapour pressures -- see provenance.vaporPressure
    coefficients  (4.730316301  1658.742622  -28.38861466);
    Trange        (313.16  395.48);   // the fit's own span; outside it the engine announces the extrapolation
}

Vliq        1.149813e-04;      // m3/mol at 25 C, FITTED (provenance.Vliq)

idealGasHeatCapacity
{
    model         polynomial;
    // Cp [J/(mol K)] = a0 + a1 T + a2 T^2 + a3 T^3, Joback ESTIMATE
    coefficients  (35.243  0.39012  -1.302000e-04  -8.600000e-09);
    Trange        (273  1000);
}

liquidHeatCapacity
{
    model         polynomial;
    // Cp [J/(mol K)] = a0, Zabransky RECOMMENDED (provenance.liquidHeatCapacity)
    coefficients  (200.4761393);
    Trange        unknown;   // ONE temperature (298.1 K) in the review: no interval can be claimed
}

// UNIQUAC van der Waals volume r and surface area q: the sum of the
// record's own UNIFAC groups (1 CH3 + 3 CH2 + 1 HCOO), R_k/Q_k of Hansen et al. 1991
// (DEV.md 4c C294; bin/curate/uniquac_rq_from_groups.py).
uniquac
{
    r   4.1663;
    q   3.6560;
}

groups
{
    unifac ( { group CH3; count 1; } { group CH2; count 3; } { group HCOO; count 1; } );
    joback ( { group CH3; count 1; } { group CH2; count 3; } { group aldehyde; count 1; } { group ether; count 1; } );
}

provenance
{
    uniquac
    {
        origin        definition;
        method        "sum of UNIFAC group R_k/Q_k: r = sum nu_k R_k = 4.1663, q = sum nu_k Q_k = 3.6560 over the record's unifac groups (1 CH3 + 3 CH2 + 1 HCOO)";
        citation      "R_k and Q_k of Hansen, Rasmussen, Fredenslund, Schiller & Gmehling, Ind. Eng. Chem. Res. 30 (1991) 2352, as tabulated in data/standards/parameters/UNIFAC/groups.dat; the group sum of Fredenslund, Jones & Prausnitz, AIChE J. 21 (1975) 1086";
    }
    MW
    {
        origin        literature;
        method        "sum of IUPAC standard atomic weights over the formula";
    }
    Tc
    {
        origin        measured;
        method        "IUPAC recommended value: the critical evaluation of every published measurement by the IUPAC critical-properties group (566 K)";
        uncertainty   "+-2 K, the evaluators' estimate";
        source        "Ambrose, D.; Tsonopoulos, C.; Nikitin, E.D.; Morton, D.W.; Marsh, K.N. Vapor-Liquid Critical Properties of Elements and Compounds. 12. Review of Recent Data for Hydrocarbons and Non-hydrocarbons. J. Chem. Eng. Data (2015, the ASAP article; volume and pages not in the file), Table 1 (recommended values, revising Parts 1-11)";
        doi           "10.1021/acs.jced.5b00571";
        transcribedBy "bin/curate/c287_new_components.py (IUPAC table, hand-transcribed from the PDF, one row per compound)";
        reviewStatus  autoPromoted;
        review        { by none; }   // DEV.md 4c C300 rule 4 (C297): nobody has reviewed it
        reviewReason  "transcribed by a model from the article's Table 1 and re-read once; not yet read back by a human";
    }
    Pc
    {
        origin           estimated;
        method           "Joback";
        methodVersion    "joback-poling5e-table2-2";
        input            joback;
        inputFingerprint "CH2:3,CH3:1,aldehyde:1,ether:1";
        reproducedInCase "data/curation/batches/new_components_c309";
        uncertainty      { status unquantified; reason "Joback group contribution (Joback & Reid 1987); Tc within a few per cent and Pc within about 5-10 per cent for ordinary organics, worse for polyfunctional molecules"; }
        notes            "neither the IUPAC series (Parts 7-10, 12) nor the archive gives a critical pressure for this compound; all groups of the structure are in the Joback table";
    }
    Tb
    {
        origin        measured;
        method        "median of the per-article medians of every value the ThermoML archive locates (1 value(s), 1 article(s)); boiling temperatures reported at 100 - 102.5 kPa";
        uncertainty   "spread of the reported values 380.13 - 380.13 K";
        doi           "10.1016/j.fluid.2015.05.031";
        combinedBy    "bin/curate/c287_new_components.py";
        reviewStatus  autoPromoted;
        review        { by none; }   // DEV.md 4c C300 rule 4 (C297): nobody has reviewed it
        reviewReason  "combined by a machine from archive-transcribed values; not yet read back against the articles";
    }
    omega
    {
        origin        regressed;
        method        "DERIVED from a fit: omega = -log10(Psat(0.7 Tc)/Pc) - 1 from the Antoine the vapour-pressure pipeline fitted (data/curation/components/nButylFormate) and the IUPAC-recommended and Joback-estimated Tc, Pc; 0.7 Tc = 396.20 K, EXTRAPOLATED +0.7 K beyond the fitted range (313.16-395.48 K); cross-check (C309): omega 0.3492 from the Antoine at 0.7 Tc against Lee-Kesler 0.3624 from the measured Tb 380.13 K, Tc and Pc (difference -0.0131)";
        derivedBy     "bin/curate/c287_new_components.py";
        reviewStatus  autoPromoted;
        review        { by none; }   // DEV.md 4c C300 rule 4 (C297): nobody has reviewed it
        reviewReason  "derived by a machine; read it with the fitGrade of the vapour pressure it comes from";
    }
    Vliq
    {
        origin        fitted;
        method        "one-parameter fit of the engine's own liquid density, V(T) = Vliq Rackett(T)/Rackett(298.15 K) with this record's Tc, Pc, omega (ThermoPackage::density, liquid branch), to every measured liquid mass density at or below 200 kPa; least squares in the relative density error, then its largest value minimised";
        fittedBy      "bin/curate/c287_new_components.py";
        reviewStatus  autoPromoted;
        review        { by none; }   // DEV.md 4c C300 rule 4 (C297): nobody has reviewed it
        fitGrade      clean;   // DEV.md 4c C285 limits 5 / 10 / 20 %
        fitGradeBasis inSample;   // DEV.md 4c C300 rule 1: the residual of the points it was fitted to
        fitGradeMaxRelativeError_pct 0.062853;
        reviewReason  "regressed by a machine from archive-transcribed measurements; not yet read back against the articles";
        reuse         "Choupo's own regression; the measured points belong to the cited articles and are not reproduced in this record or this tree";
        evidence
        (
            { doi "10.1016/j.fluid.2013.11.026"; articleSha256 "093841154a7555a678c3c4ff1d598b0b05cfecef67ac957e458e3e49dfcdd11c"; pointsKept 2; pointsDropped 0; provenance measured; }
            { doi "10.1016/j.fluid.2015.05.031"; articleSha256 "158321c69e485f4cb23d9f6346a82af145358b10b4c855edf8e5631ce607974f"; pointsKept 4; pointsDropped 0; provenance measured; }
            { doi "10.1016/j.jct.2005.11.003"; articleSha256 "2ded984525e7b5ba4f3057feb25bef95b1b626bdc478923d4f37f89144369b47"; pointsKept 1; pointsDropped 0; provenance measured; }
            { doi "10.1021/je0497350"; articleSha256 "325ac7b566e0f982b9d7b134a65b05f8f3d5fcc0fd84a2e8115ffc0dbb38fc30"; pointsKept 2; pointsDropped 0; provenance measured; }
            { doi "10.1021/je060355j"; articleSha256 "bba746eeb35ea6aef15b23e8c9324b9c61d47c99fdd6decb9735500c22150490"; pointsKept 4; pointsDropped 0; provenance measured; }
        );
        acceptance
        {
            rule        "the default graded acceptance of DEV.md 4c C285 on the max relative error over the kept points (clean / warning / severe up to 5 / 10 / 20 %); every laboratory fitted, points beyond 15 % after the least-squares stage discarded by name (C283 amended)";
            verdict     accepted;
            studies     5;
            pointsKept  13;
            pointsDropped 0;
            dropped     "none";
            aad_pct     0.034452;
            max_pct     0.062853;
            Trange      (291.15 318.15);   // K, the kept points
        }
    }
    liquidHeatCapacity
    {
        origin        literature;
        method        "Zabransky et al. recommended isobaric heat capacity, their Eq. 19, C/R = sum_j A(j+1) (T/100)^j with R = 8.31451 J/(mol K): A1 = 24.1116, converted to the record's polynomial in T (a_j = R A(j+1) / 100^j)";
        source        "Zabransky, M.; Ruzicka, V., Jr.; Domalski, E.S. Heat Capacity of Liquids: Critical Review and Recommended Values. Supplement I. J. Phys. Chem. Ref. Data 30 (2001) 1199, Table 45.12.3 (regression polynomial)";
        doi           "10.1063/1.1407866";
        uncertainty   "level IV (below 1 %), the evaluators' assignment over 298.1-298.1 K";
        notes         "ONE temperature, 298.1 K: a constant, no temperature dependence";
        transcribedBy "bin/curate/c287_new_components.py (hand-transcribed from the PDF, one row per compound)";
        reviewStatus  autoPromoted;
        review        { by none; }   // DEV.md 4c C300 rule 4 (C297): nobody has reviewed it
        reviewReason  "transcribed by a model from the review's parameter table and re-read once; not yet read back by a human";
    }
    idealGasHeatCapacity
    {
        origin           estimated;
        method           "Joback";
        methodVersion    "joback-poling5e-table2-2";
        input            joback;
        inputFingerprint "CH2:3,CH3:1,aldehyde:1,ether:1";
        reproducedInCase "data/curation/batches/new_components_c309";
        uncertainty      { status unquantified; reason "Joback group contribution (Joback & Reid 1987); a few percent for Cp_ig of ordinary organics"; }
    }
    dHf_298
    {
        origin           estimated;
        method           "Joback";
        methodVersion    "joback-poling5e-table2-2";
        input            joback;
        inputFingerprint "CH2:3,CH3:1,aldehyde:1,ether:1";
        reproducedInCase "data/curation/batches/new_components_c309";
        uncertainty      { status unquantified; reason "Joback group contribution (Joback & Reid 1987); several kJ/mol, more for polyfunctional molecules"; }
        notes            "the ThermoML archive carries no enthalpy of formation or combustion block for this compound (searched)";
    }
    s_298
    {
        origin           estimated;
        method           "derived from Joback: s_298 = (dHf_298 - dGf_298)/298.15 + the sum of the elements' standard entropies, with Joback's dGf_298 = -213300 J/mol (not stored: dGf derives from dHf and s_298)";
        methodVersion    "joback-poling5e-table2-2";
        input            joback;
        inputFingerprint "CH2:3,CH3:1,aldehyde:1,ether:1";
        elementEntropies "CODATA Key Values for Thermodynamics (Cox, Wagman & Medvedev, 1989): S(C, graphite) 5.74, S(H2, g) 130.680, S(O2, g) 205.152, S(N2, g) 191.609, S(F2, g) 202.791, S(Cl2, g) 223.081, S(Br2, l) 152.206, S(I2, cr) 116.139 J/(mol K)";
        reproducedInCase "data/curation/batches/new_components_c309";
        uncertainty      { status unquantified; reason "inherits the errors of Joback's dHf_298 and dGf_298"; }
    }
    vaporPressure
    {
        origin        fitted;
        method        "vaporPressureFit (three-parameter Antoine; objective twoStage: least squares in log10 P, then the largest relative error in P minimised from it; every usable study fitted, outliers above 15 % discarded by name)";
        methodVersion "choupoProps Choupo-dev";
        fittedInCase  "data/curation/components/nButylFormate";
        reviewStatus  autoPromoted;
        review        { by none; }   // DEV.md 4c C300 rule 4 (C297): nobody has reviewed it
        fitGrade      clean;   // DEV.md 4c C285: the worse of the grades below
        fitGradeBasis inSample;   // DEV.md 4c C300 rule 1: the residual of the points it was fitted to
        fitGradeMaxRelativeError_pct 0.832451;   // grade clean
        promotedBy    "bin/choupo-curate vp --promote";
        promotedDate  "2026-11-11";
        reviewReason  "regressed by bin/choupo-curate from archive-transcribed measurements; not yet read back against the articles";
        reuse         "Choupo's own regression; the measured points belong to the cited articles and are not reproduced in this record or this tree";
        uncertainty   "the fit's maximum relative error over every kept measurement, below";
        replaces      "model AmbroseWalton (a corresponding-states estimate from Tc, Pc, omega); `bin/choupo-curate revert <component>` restores it";
        evidence
        (
            {
                role      fit;
                dataset   "constant/archiveExtracts/nButylFormate-vapourPressure-je0497350.dat";
                doi       "10.1021/je0497350";
                sha256    "1980bf35cb03cd5b8854471ba0ef51d97e4e5a9d728b1c95929da5e0813d167a";
                articleSha256 "325ac7b566e0f982b9d7b134a65b05f8f3d5fcc0fd84a2e8115ffc0dbb38fc30";
                pointsKept    93;
                pointsDropped 0;
                provenance measured;
            }
            {
                role      fit;
                dataset   "constant/archiveExtracts/nButylFormate-vapourPressure-je025566c.dat";
                doi       "10.1021/je025566c";
                sha256    "946f214937a192eb9517d4265510cd910fb895023cf095b1714a19c6bbb7b2f2";
                articleSha256 "d4d208e9b33eeba94acafc540387dbf4487aeebc45e174786e4cfb5cffe91e1e";
                pointsKept    11;
                pointsDropped 0;
                provenance measured;
            }
        );
        acceptance
        {
            rule        "the default of DEV.md 4c C285 (graded): max relative error in P over the kept points 5 / 10 / 20 %, and |Tnb - Tb| 1 / 2 / 4 K where Tb lies outside their range, are the upper limits of clean / warning / severe; above, refused; the grade is the worse of the two";
            verdict     accepted;
            studies     2;
            pointsKept  104;
            pointsDropped 0;
            dropped     "none";
            aad_pct     0.522533;   // the fitted Antoine, every kept point
            max_pct     0.832451;
            awAad_pct   2.373467;   // the AmbroseWalton curve it replaces, the same points
            awMax_pct   7.538178;
            Tnb_fit     379.4750;   // K, the fitted curve at 101.325 kPa
        }
    }
