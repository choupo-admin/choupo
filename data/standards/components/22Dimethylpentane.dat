// UNIQUAC van der Waals volume r and surface area q: the sum of the
// record's own UNIFAC groups (4 CH3 + 2 CH2 + 1 C), R_k/Q_k of Hansen et al. 1991
// (DEV.md 4c C294; bin/curate/uniquac_rq_from_groups.py).
uniquac
{
    r   5.1727;
    q   4.4720;
}

groups
{
    unifac ( { group CH3; count 4; } { group CH2; count 2; } { group C; count 1; } );
}
