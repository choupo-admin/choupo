    coefficients  (4.01551915  1236.045525  -44.131);
    Trange        (313.48  463.15);
}

Vliq        0.000148799;      // m3/mol at 25 C  [ChemSep eqno 105]
HvapTb      29143.7;      // J/mol at Tb  [ChemSep eqno 106]

idealGasHeatCapacity
{
    model         chemsepCp16;
    // Cp [J/(mol.K)] = A + exp(B/T + C + D T + E T^2)
    // ChemSep states J/(kmol.K); A and the exp are scaled to per-mole here.
    coefficients  (80.553  -507.91  6.082244721  0.00027095  -7.6982e-08);
    Trange        (200  1500);
}

liquidHeatCapacity
{
