/*--------------------------------*- Choupo -*-----------------------*\
  Component: Toluene  (C7H8, CAS 108-88-3)
  Sources: critical constants (Tc/Pc/omega/Tb/HvapTb/Vliq), Antoine
           coefficients, Cp polynomials and the ideal-gas formation datum
           (dHf_298/s_298, JANAF convention) are individual literature
           values -- primary re-citation pending (IST review).  Viscosity:
           Andrade/Vogel fits to literature mu(T); diffusionVolume 111.5
           from the revised Fuller-Schettler-Giddings increments.
\*---------------------------------------------------------------------------*/

name        toluene;
formula     C7H8;
CAS         108-88-3;



MW          92.141;
Tc          591.75;
Pc          41.08;
omega       0.2640;
Tb          383.78;
HvapTb      33180;
Vliq        1.069e-4;
//  ANCHOR, never an input.  The engine DERIVES the Hildebrand
//  parameter from HvapTb and Vliq (the tree stores no derivative);
//  this is what ChemSep v8.3 computed independently, so the
//  derivation has something to be wrong against.
solubilityParameter 18250;   // Pa^0.5  [anchor, ChemSep v8.3, Artistic-2.0]


standardThermochemistry
{
    dHf_298   50170.0;        // J/mol  -- ideal-gas reference
    s_298     320.740;         // J/(mol·K)  -- third-law absolute
}
vaporPressure
{
    model         Antoine;
    coefficients  (4.07827   1343.943   -53.773);
    Trange        (273  380);
}

idealGasHeatCapacity
{
    model         polynomial;
    coefficients  (-24.355   0.5125   -2.765e-4   4.911e-8);
    Trange        (200  1500);
}

liquidHeatCapacity
{
    model         polynomial;
    coefficients  (157.0);
    Trange        (280  380);
}

// Liquid transport (v0.62+).  associationFactor = Wilke-Chang phi (solvent).
// liquidViscosity: ln(mu/Pa.s) = A + B/T (Andrade) or A + B/(T-C) (Vogel),
// fitted to literature mu(T) over ~10-100 degC.
associationFactor  1.0;
liquidViscosity
{
    andrade { A -11.0586; B 1062.3; }
    vogel   { A -11.0586; B 1062.3; C 0.0; }
}

diffusionVolume  111.5;  // Fuller (FSG revised: 7C+8H - aromatic ring)

// UNIQUAC van der Waals volume r and surface area q: the sum of the
// record's own UNIFAC groups (5 ACH + 1 ACCH3), R_k/Q_k of Hansen et al. 1991
// (DEV.md 4c C294; bin/curate/uniquac_rq_from_groups.py).
uniquac
{
    r   3.9228;
    q   2.9680;
}

groups
{
    unifac ( { group ACH; count 5; } { group ACCH3; count 1; } );
    joback ( { group arCH; count 5; } { group arC; count 1; } { group CH3; count 1; } );
}

cosmo
{
    VT2005
    {
        model       COSMOSAC;
        variant     "2002";
        source      "VT-2005 sigma-profile database (Mullins et al., Ind. Eng. Chem. Res. 45 (2006) 4389; DFT-COSMO), file VT2005-0243-PROF.txt bundled in usnistgov/COSMOSAC; CAS 108-88-3";
        licence     externalRestricted;   // VT-2005: redistribution NOT confirmed -- values NOT shipped
        installed   false;                 // install your own copy: bin/choupo-import-cosmo (-> data/local/cosmo/VT2005/)
    }
    LVPP-HFTZVP-2018
    {
        model       COSMOSAC;
        variant     "LVPP-HFTZVP-2018";
        protocol    "LVPP-18.07 GAMESS HF/TZVP; r_av 1.4 A; f_decay 3.57; d in A; sigma = q/a";
        source      "LVPP sigma-profile database release 18.07 (github.com/lvpp/sigma, asset HF_TZVP.zip, sha256 bd17aaeebb430641...), file TOLUENE.gout; MIT License, Copyright (c) 2017 LVPP; cite Ferrarini, Flores, Muniz & Soares, AIChE J. 64 (2018) 3443, doi:10.1002/aic.16194, and doi:10.5281/zenodo.3613786; identity: InChIKey YXFVVABEGXRONW-UHFFFAOYSA-N (full match); formula C7H8; resolved by thirdParty/thermoml/identity.json (PubChem and CACTUS agree)";
        derivation  "segment areas, charges and the cavity volume are LVPP's (GAMESS HF/TZVP COSMO output); `area` is the sum of LVPP's segment areas as binned (GAMESS's printed cavity area agrees within its 2-decimal rounding); the 51-point profile is COMPUTED BY CHOUPO from LVPP's surface segments by bin/curate/lvpp_sigma_profile.py under the protocol above (Bell et al. 2020 Eq. 4 averaging, sigma = q/a, area split linearly between grid nodes)";
        licence     MIT;
        installed   true;
        area        139.957049;   // sum of the profile below; GAMESS prints 139.96
        volume      131.37;
        sigmaProfile  (
               0.000000     0.000000     0.000000     0.000000     0.000000     0.000000
               0.000000     0.000000     0.000000     0.000000     0.000000     0.000000
               0.000000     0.000000     0.000000     0.000000     0.000000     0.785826
               4.287236    10.932064    12.795829    13.239664    11.160605     7.980029
               9.669945     8.673779    13.306048     4.689327     8.265661     5.806983
               5.942143    10.498845    10.129556     1.793509     0.000000     0.000000
               0.000000     0.000000     0.000000     0.000000     0.000000     0.000000
               0.000000     0.000000     0.000000     0.000000     0.000000     0.000000
               0.000000     0.000000     0.000000
        );
    }
}

liquidThermalConductivity
{
    chemsepEq16
    {
        A     0;
        B     -82.76305535;
        C     -0.8479911564;
        D     -0.003026819492;
        E     0;
        Tmin  234.6;
        Tmax  375.71;
    }
}

surfaceTension
{
    A     0.06759539319;
    B     0;
    Tc    591.75;
    n     1.254502849;
    Tmin  277.85;
    Tmax  368.139;
}

provenance
{
    uniquac
    {
        origin        definition;
        method        "sum of UNIFAC group R_k/Q_k: r = sum nu_k R_k = 3.9228, q = sum nu_k Q_k = 2.9680 over the record's unifac groups (5 ACH + 1 ACCH3)";
        citation      "R_k and Q_k of Hansen, Rasmussen, Fredenslund, Schiller & Gmehling, Ind. Eng. Chem. Res. 30 (1991) 2352, as tabulated in data/standards/parameters/UNIFAC/groups.dat; the group sum of Fredenslund, Jones & Prausnitz, AIChE J. 21 (1975) 1086";
    }
    liquidThermalConductivity
    {
        origin        fitted;
        method        "least squares on ln y of ln(k/(W/m/K)) = C + B/T + D T (chemsepEq16 with A = 0, E = 0), 3 parameter(s), then the largest relative error minimised; every laboratory the archive holds for the pure liquid at <= 200 kPa; points beyond 15 % after the first stage discarded by name";
        fittedBy      "bin/curate/transport_fit.py";
        reviewStatus  autoPromoted;
        review        { by none; }   // DEV.md 4c C300 rule 4: nobody has reviewed it
        fitGrade      clean;   // DEV.md 4c C285 limits 5 / 10 / 20 % on the max relative error
        fitGradeBasis inSample;   // DEV.md 4c C300 rule 1
        fitGradeMaxRelativeError_pct 2.878126;
        Trange        (234.6 375.71);   // K, the kept points -- outside it the engine announces an extrapolation
        reviewReason  "regressed by a machine from archive-transcribed measurements; not yet read back against the articles";
        reuse         "Choupo's own regression; the measured points belong to the cited articles and are not reproduced in this record or this tree (DEV.md 4c C327)";
        evidence
        (
                { doi "10.1007/s10765-007-0241-8"; articleSha256 "b555aa645a407d9a0bb958a2e49256b03b48384df14097ea9eaf5580b2622c0d"; pointsKept 3; pointsDropped 0; provenance measured; }
                { doi "10.1007/s10765-008-0549-z"; articleSha256 "9ed6e7d127f1e6f841303a5132aa333bc6121544e15ce62722ed05dc004bebfa"; pointsKept 38; pointsDropped 0; provenance measured; }
                { doi "10.1016/j.fluid.2014.04.038"; articleSha256 "81abe0ea2a74247a4d208d911f53b3b93e73013599843d131324a83c81f89a05"; pointsKept 11; pointsDropped 0; provenance measured; }
                { doi "10.1016/j.fluid.2018.12.025"; articleSha256 "a37f822d0cb7343b1455c683500d29b94c45c6102aebf1d63a9cd273f8ef79e2"; pointsKept 15; pointsDropped 0; provenance measured; }
                { doi "10.1016/j.jct.2019.01.028"; articleSha256 "bb2356605cfd70b13276b4195dece9c2f46d385ab0b99f7d0f4a64cc80de6334"; pointsKept 10; pointsDropped 0; provenance measured; }
                { doi "10.1021/je049818g"; articleSha256 "574155ac97da3d0303154bea57f4378323b492bfa3b20b40968d47f6f7e11df0"; pointsKept 8; pointsDropped 0; provenance measured; }
        );
        acceptance
        {
            verdict     accepted;
            studies     6;
            pointsKept  85;
            pointsDropped 0;
            dropped     "none";
            aad_pct     0.977325;
            max_pct     2.878126;
        }
    }
    surfaceTension
    {
        origin        fitted;
        method        "least squares on ln sigma of sigma/(N/m) = A tau^n, tau = 1 - T/Tc (A, n; B = 0; Tc the record's own), then the largest relative error minimised; every laboratory the archive holds for the pure liquid at <= 200 kPa; points beyond 15 % after the first stage discarded by name";
        fittedBy      "bin/curate/transport_fit.py";
        reviewStatus  autoPromoted;
        review        { by none; }   // DEV.md 4c C300 rule 4: nobody has reviewed it
        fitGrade      clean;   // DEV.md 4c C285 limits 5 / 10 / 20 % on the max relative error
        fitGradeBasis inSample;   // DEV.md 4c C300 rule 1
        fitGradeMaxRelativeError_pct 1.340445;
        Trange        (277.85 368.139);   // K, the kept points -- outside it the engine announces an extrapolation
        reviewReason  "regressed by a machine from archive-transcribed measurements; not yet read back against the articles";
        reuse         "Choupo's own regression; the measured points belong to the cited articles and are not reproduced in this record or this tree (DEV.md 4c C328)";
        evidence
