                { doi "10.1016/j.fluid.2017.08.016"; articleSha256 "460b193062d5c91821ed4305a16a3875334899e0852f489d6b7bf0771f37eada"; pointsKept 14; pointsDropped 0; provenance measured; }
                { doi "10.1016/j.jct.2005.10.008"; articleSha256 "313726b85b2b5df2b67ce32d823f62e224ce6850ddccde82cd8ee4620a721d81"; pointsKept 3; pointsDropped 0; provenance measured; }
