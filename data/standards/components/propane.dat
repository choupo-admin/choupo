/*--------------------------------*- Choupo -*-----------------------*\
  Component: Propane  (C3H8, CAS 74-98-6)
  Sources:   vaporPressure  -- Rips 1963 (primary measured set)
             constants  -- cross-checked vs CoolProp 7.2.0 reference EOS;
                           Cp -- individual literature value, primary
                           re-citation pending (IST review)
             standardThermochemistry  -- NASA TM-4513 (McBride-Gordon-Reno 1993),
                                ideal-gas, 298 K
\*---------------------------------------------------------------------------*/

name        propane;
formula     C3H8;
CAS         74-98-6;

MW          44.096;        // kg/kmol
Tc          369.83;        // K
Pc          42.48;         // bar
omega       0.1520;        // [-]
Tb          231.02;        // K     normal boiling point
HvapTb      19040;         // J/mol latent heat at Tb
Vliq        8.42e-5;       // m³/mol saturated-liquid molar volume (84.2 cm³/mol)
//  ANCHOR, never an input.  The engine DERIVES the Hildebrand
//  parameter from HvapTb and Vliq (the tree stores no derivative);
//  this is what ChemSep v8.3 computed independently, so the
//  derivation has something to be wrong against.
solubilityParameter 13100;   // Pa^0.5  [anchor, ChemSep v8.3, Artistic-2.0]

standardThermochemistry
{
    dHf_298   -104700.0;      // J/mol  -- ideal-gas reference
    s_298     270.30;         // J/(mol·K)
}
vaporPressure
{
    model         Antoine;
    // log10(Psat [bar]) = A - B / (T[K] + C)   -- Psat(Tb) ~ 1.04 bar (3% at the
    // lower range edge; the Rips set covers the practical 231-321 K window)
    coefficients  (3.98292   819.296   -24.417);
    Trange        (230.6  320.7);
}

idealGasHeatCapacity
{
    model         polynomial;
    // Cp [J/(mol·K)] = a0 + a1*T + a2*T^2 + a3*T^3   -- Cp(298) = 73.8
    coefficients  (-4.224   0.3063   -1.586e-4   3.215e-8);
    Trange        (200  1500);
}

liquidHeatCapacity
{
    model         polynomial;
    // approximate constant ~100 J/(mol·K); a real liquid only below ~231 K (1 atm)
    // or under pressure (refrigerant duty)
    coefficients  (100.0);
    Trange        (170  300);
}

surfaceTension
{
    A     0.05398792659;
    B     0;
    Tc    369.83;
    n     1.247934208;
    Tmin  253.08;
    Tmax  333.3;
}

provenance
{
    uniquac
    {
        origin        definition;
        method        "sum of UNIFAC group R_k/Q_k: r = sum nu_k R_k = 2.4766, q = sum nu_k Q_k = 2.2360 over the record's unifac groups (2 CH3 + 1 CH2)";
        citation      "R_k and Q_k of Hansen, Rasmussen, Fredenslund, Schiller & Gmehling, Ind. Eng. Chem. Res. 30 (1991) 2352, as tabulated in data/standards/parameters/UNIFAC/groups.dat; the group sum of Fredenslund, Jones & Prausnitz, AIChE J. 21 (1975) 1086";
    }
    vaporPressure  "Rips 1963 (primary measured set)";
    constants      "cross-checked vs CoolProp 7.2.0 reference EOS";
    standardThermochemistry "NASA TM-4513 (McBride-Gordon-Reno 1993), ideal-gas, 298 K";
}

// UNIQUAC van der Waals volume r and surface area q: the sum of the
// record's own UNIFAC groups (2 CH3 + 1 CH2), R_k/Q_k of Hansen et al. 1991
// (DEV.md 4c C294; bin/curate/uniquac_rq_from_groups.py).
uniquac
{
    r   2.4766;
    q   2.2360;
}

groups
{
    unifac ( { group CH3; count 2; } { group CH2; count 1; } );
    joback ( { group CH3; count 2; } { group CH2; count 1; } );
}

cosmo
{
    VT2005
    {
        model       COSMOSAC;
        variant     "2002";
        source      "VT-2005 sigma-profile database (Mullins et al., Ind. Eng. Chem. Res. 45 (2006) 4389; DFT-COSMO), file VT2005-0003-PROF.txt bundled in usnistgov/COSMOSAC; CAS 74-98-6";
        licence     externalRestricted;   // VT-2005: redistribution NOT confirmed -- values NOT shipped
        installed   false;                 // install your own copy: bin/choupo-import-cosmo (-> data/local/cosmo/VT2005/)
    }
    LVPP-HFTZVP-2018
    {
        model       COSMOSAC;
        variant     "LVPP-HFTZVP-2018";
        protocol    "LVPP-18.07 GAMESS HF/TZVP; r_av 1.4 A; f_decay 3.57; d in A; sigma = q/a";
        source      "LVPP sigma-profile database release 18.07 (github.com/lvpp/sigma, asset HF_TZVP.zip, sha256 bd17aaeebb430641...), file PROPANE.gout; MIT License, Copyright (c) 2017 LVPP; cite Ferrarini, Flores, Muniz & Soares, AIChE J. 64 (2018) 3443, doi:10.1002/aic.16194, and doi:10.5281/zenodo.3613786; identity: InChIKey ATUOYWHBWRKTHZ-UHFFFAOYSA-N (full match); formula C3H8; resolved by thirdParty/thermoml/identity.json (PubChem and CACTUS agree)";
        derivation  "segment areas, charges and the cavity volume are LVPP's (GAMESS HF/TZVP COSMO output); `area` is the sum of LVPP's segment areas as binned (GAMESS's printed cavity area agrees within its 2-decimal rounding); the 51-point profile is COMPUTED BY CHOUPO from LVPP's surface segments by bin/curate/lvpp_sigma_profile.py under the protocol above (Bell et al. 2020 Eq. 4 averaging, sigma = q/a, area split linearly between grid nodes)";
        licence     MIT;
        installed   true;
        area        96.151156;   // sum of the profile below; GAMESS prints 96.15
        volume      79.96;
        sigmaProfile  (
               0.000000     0.000000     0.000000     0.000000     0.000000     0.000000
               0.000000     0.000000     0.000000     0.000000     0.000000     0.000000
               0.000000     0.000000     0.000000     0.000000     0.000000     0.000000
               0.000000     0.000000     0.000000     2.132469    10.594835    19.791204
              14.568376    12.304797    14.046009    15.190888     7.522578     0.000000
               0.000000     0.000000     0.000000     0.000000     0.000000     0.000000
               0.000000     0.000000     0.000000     0.000000     0.000000     0.000000
               0.000000     0.000000     0.000000     0.000000     0.000000     0.000000
               0.000000     0.000000     0.000000
        );
    }
}

// PC-SAFT non-associating segment parameters (Gross & Sadowski, IECR 40
// (2001) 1244, Table 1 -- the pure n-alkane fit to vapour pressure + liquid
// density).  m segments, sigma [Angstrom], epsilon/k [K].
pcsaft
{
    m        2.0020;
    sigma    3.6184;
    epsilonK 208.11;
    source   "Gross & Sadowski, Ind. Eng. Chem. Res. 40 (2001) 1244, Table 1";
    surfaceTension
    {
        origin        fitted;
        method        "least squares on ln sigma of sigma/(N/m) = A tau^n, tau = 1 - T/Tc (A, n; B = 0; Tc the record's own), then the largest relative error minimised; every laboratory the archive holds for the pure liquid at <= 200 kPa; points beyond 15 % after the first stage discarded by name";
        fittedBy      "bin/curate/transport_fit.py";
        reviewStatus  autoPromoted;
        review        { by none; }   // DEV.md 4c C300 rule 4: nobody has reviewed it
        fitGrade      clean;   // DEV.md 4c C285 limits 5 / 10 / 20 % on the max relative error
        fitGradeBasis inSample;   // DEV.md 4c C300 rule 1
        fitGradeMaxRelativeError_pct 2.172868;
        Trange        (253.08 333.3);   // K, the kept points -- outside it the engine announces an extrapolation
        reviewReason  "regressed by a machine from archive-transcribed measurements; not yet read back against the articles";
        reuse         "Choupo's own regression; the measured points belong to the cited articles and are not reproduced in this record or this tree (DEV.md 4c C328)";
        evidence
        (
                { doi "10.1016/j.fluid.2010.07.026"; articleSha256 "3d18d9acb30e1dea4d922b3bc76382bce1a4afd0dd41d0ee3ec47c64b4bb6506"; pointsKept 6; pointsDropped 0; provenance measured; }
                { doi "10.1016/j.jct.2017.03.002"; articleSha256 "653a04ec2657b34a91caceae0ff36bdfdb77a5500e5b43776648eae03511707f"; pointsKept 11; pointsDropped 0; provenance measured; }
                { doi "10.1021/je034093m"; articleSha256 "bc6f29c146c8521b0ebf864ba8776b4ea9fa354f594f002da9db280d0ce08ad8"; pointsKept 72; pointsDropped 0; provenance measured; }
                { doi "10.1021/je901085t"; articleSha256 "5770c8a90d194ef0de88df7fb97e34491bf75ed4015290674c328386bf2d8bbc"; pointsKept 5; pointsDropped 0; provenance measured; }
        );
        acceptance
        {
            verdict     accepted;
            studies     4;
            pointsKept  94;
            pointsDropped 0;
            dropped     "none";
            aad_pct     0.986691;
            max_pct     2.172868;
        }
    }
}
