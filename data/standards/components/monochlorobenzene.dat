// UNIQUAC van der Waals volume r and surface area q: the sum of the
// record's own UNIFAC groups (1 ACCl + 5 ACH), R_k/Q_k of Hansen et al. 1991
// (DEV.md 4c C294; bin/curate/uniquac_rq_from_groups.py).
uniquac
{
    r   3.8127;
    q   2.8440;
}

groups
{
    unifac ( { group ACCl; count 1; } { group ACH; count 5; } );   // derived from structure c1ccccc1([Cl]) by bin/curate/unifac_groups.py
}

//  HANSEN solubility-parameter triple (DEV.md 4c C428; read by `hansenMixture`
//  and the Explorer's solvent lens).  Hansen 1969, Table I row H09 "Chlorobenzene":
//  delta_d = 9.28, delta_p = 2.1, delta_h = 1.0 (cal/cm3)^0.5, x sqrt(4.184e6) = 2045.4828.
hansen
{
    dD    18982.1;        // Pa^0.5   = 9.28 (cal/cm3)^0.5, Table I row H09
    dP    4295.5;        // Pa^0.5   = 2.1
    dH    2045.5;        // Pa^0.5   = 1.0
    Tref  298.15 K;       // adopted: the paper prints no temperature beside Table I
}

