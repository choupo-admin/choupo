name        monochlorobenzene;
CAS         108-90-7;
formula     C6H5Cl;      // counted from the ChemSep v8.3 structure formula "C6H5Cl" (derived 2026-09-03; reproduces MW to 0.001 %)
reviewStatus interim;
MW          112.5569;      // kg/kmol [origin=ChemSep v8.3]
Tc          632.4;      // K [origin=ChemSep v8.3]
Pc          45.2;      // bar; source Pa / 1e5 [origin=ChemSep v8.3]
omega       0.251;      // [-] [origin=ChemSep v8.3]
Tb          404.91;      // K [origin=ChemSep v8.3]

standardThermochemistry
{
    dHf_298   51090;        // J/mol   [ChemSep v8.3, ideal gas]
    s_298     314.03;        // J/(mol.K)  third-law absolute
}

vaporPressure
{
    model         Antoine;
    // log10(Psat [bar]) = A - B / (T[K] + C)
    // converted EXACTLY from ChemSep eqno 10, Psat[Pa] = exp(a - b/(T+c))
    coefficients  (4.211820256  1511.431656  -45.686);
    Trange        (383.15  568.5);
}

Vliq        0.000102333;      // m3/mol at 25 C  [ChemSep eqno 105]
HvapTb      35568.7;      // J/mol at Tb  [ChemSep eqno 106]

idealGasHeatCapacity
{
    model         chemsepCp16;
    // Cp [J/(mol.K)] = A + exp(B/T + C + D T + E T^2)
    // ChemSep states J/(kmol.K); A and the exp are scaled to per-mole here.
    coefficients  (74.68  -1001.5  6.919244721  -0.0014014  4.6413e-07);
    Trange        (200  1500);
}

liquidHeatCapacity
{
    model         chemsepCp16;
    // Cp [J/(mol.K)] = A + exp(B/T + C + D T + E T^2)
    coefficients  (139.15  -333.42  3.998244721  -0.018036  5.4846e-05);
    Trange        (227.95  360);
}

