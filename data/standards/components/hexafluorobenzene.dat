            { doi "10.1021/je050056e"; articleSha256 "dac8ea38ea8c1c85de34f3074ca3b0e7e923679796fa91160586aa7171f251d7"; pointsKept 6; pointsDropped 0; provenance measured; }
        );
        acceptance
        {
            rule        "the default graded acceptance of DEV.md 4c C285 on the max relative error over the kept points (clean / warning / severe up to 5 / 10 / 20 %); every laboratory fitted, points beyond 15 % after the least-squares stage discarded by name (C283 amended)";
            verdict     accepted;
            studies     2;
            pointsKept  19;
            pointsDropped 5;
            dropped     "10.1007/s10765-006-0092-8 T=513.91 K rho=744.6 err +16.1 %; 10.1007/s10765-006-0092-8 T=513.92 K rho=746.3 err +15.8 %; 10.1007/s10765-006-0092-8 T=515.98 K rho=670.3 err +27.4 %; 10.1007/s10765-006-0092-8 T=516.28 K rho=644.8 err +32.3 %; 10.1007/s10765-006-0092-8 T=516.57 K rho=610.1 err +39.5 %";
            aad_pct     8.301765;
            max_pct     10.837569;
            Trange      (288.15 508.9);   // K, the kept points
        }
    }
    liquidHeatCapacity
    {
        origin        fitted;
        method        "polynomial of degree 0 in T fitted to every measured liquid isobaric heat capacity at or below 200 kPa (specific values converted with MW); least squares in the relative error, then its largest value minimised";
        fittedBy      "bin/curate/c287_new_components.py";
        reviewStatus  autoPromoted;
        humanReviewed false;
        fitGrade      clean;   // DEV.md 4c C285 limits 5 / 10 / 20 %
        fitGradeMaxRelativeError_pct 0.000000;
        reviewReason  "regressed by a machine from archive-transcribed measurements; not yet read back against the articles";
