/*--------------------------------*- Choupo -*-----------------------*\
  Component: hexafluorobenzene  (hexafluorobenzene; CAS 392-56-3)
  NEW in the catalogue (DEV.md 4c C292, slice 2 of C287, 2026-11-10), built by
  bin/curate/c287_new_components.py from measurements the NIST/TRC ThermoML Archive
  locates (the articles are the sources; their DOIs are in provenance).
  MEASURED: no critical constant, no Tb.  FITTED: vapour pressure (bin/choupo-curate vp),
  Vliq, liquid Cp.  DERIVED: omega (from the fitted vapour pressure at the ESTIMATED Tc).
  ESTIMATED (Joback): Tc, Pc, ideal-gas Cp, dHf_298; s_298 derived from Joback's
  dHf and dGf.  No measured series is reproduced here.
  reviewStatus autoPromoted, humanReviewed false: NO human has read it back.
  Psat: fitted by `bin/choupo-curate vp`; its promotion replaced the
  AmbroseWalton block this tool writes (provenance.vaporPressure).
\*---------------------------------------------------------------------------*/

name        hexafluorobenzene;
CAS         392-56-3;
formula     C6F6;
reviewStatus autoPromoted;
humanReviewed false;
MW          186.0540;      // kg/kmol, from the formula (IUPAC standard atomic weights)
Tc          542.608315;      // K, Joback ESTIMATE (provenance.Tc)
Pc          30.5916673;      // bar, Joback ESTIMATE (provenance.Pc)
omega       0.118889;      // [-] (provenance.omega)
//  Tb: NOT DECLARED -- the archive reports no boiling temperature at
//  101.3 kPa for it, and a Tb read back off the fitted Antoine would be
//  the curve tested against itself (the fitted normal boiling point is
//  in provenance.vaporPressure.acceptance.Tnb_fit).  Joback's Tb is NOT stored either: the vapour-pressure
//  grade would read an estimate as a measurement (WRITE_ESTIMATED_TB in
//  the tool); the case curate699 prints it.

standardThermochemistry
{
    dHf_298   -1164650;        // J/mol, ideal gas, Joback ESTIMATE (provenance.dHf_298)
    s_298     442.61;        // J/(mol K), ideal gas, DERIVED from Joback (provenance.s_298)
}

vaporPressure
{
    model         Antoine;
    // log10(Psat [bar]) = A - B / (T[K] + C), FITTED by bin/choupo-curate vp to
    // measured vapour pressures -- see provenance.vaporPressure
    coefficients  (4.678195365  1507.943472  -30.07506355);
    Trange        (288.23  333.01);   // the fit's own span; outside it the engine announces the extrapolation
}

Vliq        1.296082e-04;      // m3/mol at 25 C, FITTED (provenance.Vliq)

idealGasHeatCapacity
{
    model         polynomial;
    // Cp [J/(mol K)] = a0 + a1 T + a2 T^2 + a3 T^3, Joback ESTIMATE
    coefficients  (71.57  0.2682  -9.700000e-05  -5.200000e-09);
    Trange        (273  1000);
}

liquidHeatCapacity
{
    model         polynomial;
    // Cp [J/(mol K)] = a0 + a1 T + a2 T^2, FITTED (provenance.liquidHeatCapacity)
    coefficients  (221.42);
    Trange        unknown;   // ONE measurement temperature (298.15 K): no interval can be claimed
}

groups
{
    joback ( { group arC; count 6; } { group F; count 6; } );
}

provenance
{
    MW
    {
        origin        literature;
        method        "sum of IUPAC standard atomic weights over the formula";
    }
    Tc
    {
        origin           estimated;
        method           "Joback";
        methodVersion    "joback-poling5e-table2-2";
        input            joback;
        inputFingerprint "F:6,arC:6";
        reproducedInCase "tutorials/props/curation/curate699_new_components_estimated";
        uncertainty      { status unquantified; reason "Joback group contribution (Joback & Reid 1987); Tc within a few per cent and Pc within about 5-10 per cent for ordinary organics, worse for polyfunctional molecules"; }
        notes            "the archive carries no critical temperature for this compound; all groups of the structure are in the Joback table";
    }
    Pc
    {
        origin           estimated;
        method           "Joback";
        methodVersion    "joback-poling5e-table2-2";
        input            joback;
        inputFingerprint "F:6,arC:6";
        reproducedInCase "tutorials/props/curation/curate699_new_components_estimated";
        uncertainty      { status unquantified; reason "Joback group contribution (Joback & Reid 1987); Tc within a few per cent and Pc within about 5-10 per cent for ordinary organics, worse for polyfunctional molecules"; }
        notes            "the archive carries no critical pressure for this compound; all groups of the structure are in the Joback table";
    }
    omega
    {
        origin        regressed;
        method        "DERIVED from a fit: omega = -log10(Psat(0.7 Tc)/Pc) - 1 from the Antoine the vapour-pressure pipeline fitted (tutorials/props/curation/curate639_vp_hexafluorobenzene) and the measured Tc, Pc; 0.7 Tc = 379.83 K, EXTRAPOLATED +46.8 K beyond the fitted range (288.23-333.01 K)";
        derivedBy     "bin/curate/c287_new_components.py";
        reviewStatus  autoPromoted;
        humanReviewed false;
        reviewReason  "derived by a machine; read it with the fitGrade of the vapour pressure it comes from";
    }
    Vliq
    {
        origin        fitted;
        method        "one-parameter fit of the engine's own liquid density, V(T) = Vliq Rackett(T)/Rackett(298.15 K) with this record's Tc, Pc, omega (ThermoPackage::density, liquid branch), to every measured liquid mass density at or below 200 kPa; least squares in the relative density error, then its largest value minimised";
        fittedBy      "bin/curate/c287_new_components.py";
        reviewStatus  autoPromoted;
        humanReviewed false;
        fitGrade      severe;   // DEV.md 4c C285 limits 5 / 10 / 20 %
        fitGradeMaxRelativeError_pct 10.837569;
        reviewReason  "regressed by a machine from archive-transcribed measurements; not yet read back against the articles";
