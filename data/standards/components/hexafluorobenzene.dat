            verdict     accepted;
            studies     1;
            pointsKept  1;
            pointsDropped 0;
            dropped     "none";
            aad_pct     0.000000;
            max_pct     0.000000;
            measuredAt  298.15;   // K: ONE measurement -- the parameter reproduces it exactly and the grade says nothing about its temperature dependence
        }
    }
    idealGasHeatCapacity
    {
        origin           estimated;
        method           "Joback";
        methodVersion    "joback-poling5e-table2-2";
        input            joback;
        inputFingerprint "F:6,arC:6";
        reproducedInCase "tutorials/props/curation/curate699_new_components_estimated";
        uncertainty      { status unquantified; reason "Joback group contribution (Joback & Reid 1987); a few percent for Cp_ig of ordinary organics"; }
    }
    dHf_298
    {
        origin           estimated;
        method           "Joback";
        methodVersion    "joback-poling5e-table2-2";
        input            joback;
        inputFingerprint "F:6,arC:6";
