/*--------------------------------*- Choupo -*-----------------------*\
  Component: Acetylene  (C2H2, CAS 74-86-2)

  Triple bond C=C; the lightest endothermic hydrocarbon
  (dHf_298 = +228 kJ/mol).  Burns with a sooty oxy-acetylene flame
  near 3100 K --- the textbook high-T combustion species.
  Sources: ideal-gas formation properties (dHf_298, s_298) cross-checked
  against NASA TM-4513 (McBride-Gordon-Reno 1993); constants (Tc, Pc,
  omega, Tb, Antoine) are individual literature values -- primary
  re-citation pending (IST review).
\*---------------------------------------------------------------------------*/

name        acetylene;
formula     C2H2;
CAS         74-86-2;

MW          26.038;           // kg/kmol
Tc          308.30;            // K
Pc          61.40;             // bar
omega       0.190;             // [-]
Tb          188.40;            // K  (sublimation point at 1 atm; metastable liquid above 192 K)
HvapTb      16700;             // J/mol
Vliq        4.20e-5;           // m^3/mol
VliqT       188.40;      // K -- the anchor temperature of Vliq: NOT a liquid state (188.40 K is the 1 atm SUBLIMATION point, see Tb)
//  What the datum is, as far as anything in hand shows: batch vliq_datum_temperature
//  (evidence.tsv) carried a handbook liquid volume at 203.15 K down to 188.40 K with
//  Rackett and found the stored value within 0.3 % of it.  So 188.40 K is where the
//  engine's Rackett curve through this volume is anchored, an extrapolation below the
//  triple point, not a measured state.  The ThermoML archive holds NO liquid volume of
//  acetylene (searched by InChIKey, 2026-11-13: one solubility article only), so no
//  measurement in hand can place this volume on a temperature.  Kept, not changed:
//  removing it would make the engine read 42.0 cm³/mol AT 25 C (Tr 0.967), 620 kg/m³,
//  where the Rackett curve through this anchor gives 376 kg/m³.  What would settle
//  it: a measured saturated-liquid density of acetylene with its temperature.
//  ANCHOR, never an input.  The engine DERIVES the Hildebrand
//  parameter from HvapTb and Vliq (the tree stores no derivative);
//  this is what ChemSep v8.3 computed independently, so the
//  derivation has something to be wrong against.
solubilityParameter 7921;   // Pa^0.5  [anchor, ChemSep v8.3, Artistic-2.0]

standardThermochemistry
{
    dHf_298    228200.0;       // J/mol  -- ideal-gas reference
    s_298      200.93;         // J/(mol·K)  -- third-law absolute
}

vaporPressure
{
    model         Antoine;
    coefficients  (4.66248   909.79   -7.947);
    Trange        (192  308);
}

idealGasHeatCapacity
{
    model         polynomial;
    coefficients  (26.82   7.578e-2   -5.007e-5   1.412e-8);
    Trange        (250  1500);
}

groups
{
    joback ( { group yneCH; count 2; } );
}

// Friendly-name aliases -- resolved to this file via the generated ALIASES index.
aliases ( ethyne C2H2 );

cosmo
{
    VT2005
    {
        model       COSMOSAC;
        variant     "2002";
        source      "VT-2005 sigma-profile database (Mullins et al., Ind. Eng. Chem. Res. 45 (2006) 4389; DFT-COSMO), file VT2005-0224-PROF.txt bundled in usnistgov/COSMOSAC; CAS 74-86-2";
        licence     externalRestricted;   // VT-2005: redistribution NOT confirmed -- values NOT shipped
        installed   false;                 // install your own copy: bin/choupo-import-cosmo (-> data/local/cosmo/VT2005/)
    }
}
