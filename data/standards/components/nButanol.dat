                { doi "10.1016/j.jct.2013.04.009"; articleSha256 "d4e7fcc6168a8d3984a48d9f9884f68fb1cc4e966655f491a5ab6e0b3274b837"; pointsKept 5; pointsDropped 0; provenance measured; }
