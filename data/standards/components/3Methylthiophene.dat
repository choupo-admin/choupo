/*--------------------------------*- Choupo -*-----------------------*\
  Component: 3Methylthiophene  (3-methylthiophene; CAS 616-44-4)
  NEW in the catalogue (DEV.md 4c C309, slice 3 of C287, 2026-11-11), built by
  bin/curate/c287_new_components.py from the IUPAC critical-property series, the
  Zabransky liquid heat-capacity review and the measurements the NIST/TRC
  ThermoML Archive locates (the articles are the sources; every value's
  citation or DOIs are in provenance).
  MEASURED (archive median): Tc, Pc, Tb.
  FITTED: vapour pressure (bin/choupo-curate vp), Vliq.
  DERIVED: omega (from the fitted vapour pressure).
  ESTIMATED (Joback): ideal-gas Cp, dHf_298; s_298 derived from Joback's dHf and dGf.
  ESTIMATED (Rowlinson-Bondi, Poling 5e Eq. 6-6.4): liquid Cp -- no measurement or recommended correlation in hand.
  No measured series is reproduced here.
  reviewStatus autoPromoted, review by none: NO human has read it back.
  Psat: fitted by `bin/choupo-curate vp`; its promotion replaced the
  AmbroseWalton block this tool writes (provenance.vaporPressure).
\*---------------------------------------------------------------------------*/

name        3Methylthiophene;
CAS         616-44-4;
formula     C5H6S;
reviewStatus autoPromoted;
review      { by none; }   // DEV.md 4c C300 rule 4 (C297): nobody has reviewed it
MW          98.1630;      // kg/kmol, from the formula (IUPAC standard atomic weights)
Tc          607.3;      // K, measured (provenance.Tc)
Pc          46.2;      // bar, measured (provenance.Pc)
omega       0.241130;      // [-] (provenance.omega)
Tb          388.35;      // K, measured (provenance.Tb)

standardThermochemistry
{
    dHf_298   83640;        // J/mol, ideal gas, Joback ESTIMATE (provenance.dHf_298)
    s_298     311.96;        // J/(mol K), ideal gas, DERIVED from Joback (provenance.s_298)
}

vaporPressure
{
    model         Antoine;
    // log10(Psat [bar]) = A - B / (T[K] + C), FITTED by bin/choupo-curate vp to
    // measured vapour pressures -- see provenance.vaporPressure
    coefficients  (4.52327564  1628.789543  -27.82137125);
    Trange        (333.15  387.89);   // the fit's own span; outside it the engine announces the extrapolation
}

Vliq        9.664508e-05;      // m3/mol at 25 C, FITTED (provenance.Vliq)

idealGasHeatCapacity
{
    model         polynomial;
    // Cp [J/(mol K)] = a0 + a1 T + a2 T^2 + a3 T^3, Joback ESTIMATE
    coefficients  (-16.4  0.47993  -3.572200e-04  1.083000e-07);
    Trange        (273  1000);
}

liquidHeatCapacity
{
    model         polynomial;
    // Cp [J/(mol K)] = a0 + a1 T + a2 T^2, Rowlinson-Bondi ESTIMATE (provenance.liquidHeatCapacity)
    coefficients  (90.02114765  0.166624506  0.0001144306318);
    Trange        (333.15  387.89);
}

// UNIQUAC van der Waals volume r and surface area q: the sum of the
// record's own UNIFAC groups (1 CH3 + 1 C4H3S), R_k/Q_k of Hansen et al. 1991
// (DEV.md 4c C294; bin/curate/uniquac_rq_from_groups.py).
uniquac
{
    r   3.5919;
    q   2.7080;
}

groups
{
    unifac ( { group CH3; count 1; } { group C4H3S; count 1; } );
    joback ( { group CH3; count 1; } { group arCH; count 3; } { group arC; count 1; } { group rS; count 1; } );
}

provenance
{
    uniquac
    {
        origin        definition;
        method        "sum of UNIFAC group R_k/Q_k: r = sum nu_k R_k = 3.5919, q = sum nu_k Q_k = 2.7080 over the record's unifac groups (1 CH3 + 1 C4H3S)";
        citation      "R_k and Q_k of Hansen, Rasmussen, Fredenslund, Schiller & Gmehling, Ind. Eng. Chem. Res. 30 (1991) 2352, as tabulated in data/standards/parameters/UNIFAC/groups.dat; the group sum of Fredenslund, Jones & Prausnitz, AIChE J. 21 (1975) 1086";
    }
    MW
    {
        origin        literature;
        method        "sum of IUPAC standard atomic weights over the formula";
    }
    Tc
    {
        origin        measured;
        method        "median of the per-article medians of every value the ThermoML archive locates (1 value(s), 1 article(s))";
        uncertainty   "spread of the reported values 607.3 - 607.3 K";
        doi           "10.1021/acs.jced.8b00298";
        combinedBy    "bin/curate/c287_new_components.py";
        reviewStatus  autoPromoted;
        review        { by none; }   // DEV.md 4c C300 rule 4 (C297): nobody has reviewed it
        reviewReason  "combined by a machine from archive-transcribed values; not yet read back against the articles";
    }
    Pc
    {
        origin        measured;
        method        "median of the per-article medians of every value the ThermoML archive locates (1 value(s), 1 article(s)); the archive reports kPa, divided by 100";
        uncertainty   "spread of the reported values 46.2 - 46.2 bar";
        doi           "10.1021/acs.jced.8b00298";
        combinedBy    "bin/curate/c287_new_components.py";
        reviewStatus  autoPromoted;
        review        { by none; }   // DEV.md 4c C300 rule 4 (C297): nobody has reviewed it
        reviewReason  "combined by a machine from archive-transcribed values; not yet read back against the articles";
    }
    Tb
    {
        origin        measured;
        method        "median of the per-article medians of every value the ThermoML archive locates (1 value(s), 1 article(s)); boiling temperatures reported at 100 - 102.5 kPa";
        uncertainty   "spread of the reported values 388.35 - 388.35 K";
        doi           "10.1016/j.fluid.2013.05.019";
        combinedBy    "bin/curate/c287_new_components.py";
        reviewStatus  autoPromoted;
        review        { by none; }   // DEV.md 4c C300 rule 4 (C297): nobody has reviewed it
        reviewReason  "combined by a machine from archive-transcribed values; not yet read back against the articles";
    }
    omega
    {
        origin        regressed;
        method        "DERIVED from a fit: omega = -log10(Psat(0.7 Tc)/Pc) - 1 from the Antoine the vapour-pressure pipeline fitted (data/curation/components/3Methylthiophene) and the measured Tc, Pc; 0.7 Tc = 425.11 K, EXTRAPOLATED +37.2 K beyond the fitted range (333.15-387.89 K); cross-check (C309): omega 0.2411 from the Antoine at 0.7 Tc against Lee-Kesler 0.2482 from the measured Tb 388.35 K, Tc and Pc (difference -0.0071)";
        derivedBy     "bin/curate/c287_new_components.py";
        reviewStatus  autoPromoted;
        review        { by none; }   // DEV.md 4c C300 rule 4 (C297): nobody has reviewed it
        reviewReason  "derived by a machine; read it with the fitGrade of the vapour pressure it comes from";
    }
    Vliq
    {
        origin        fitted;
        method        "one-parameter fit of the engine's own liquid density, V(T) = Vliq Rackett(T)/Rackett(298.15 K) with this record's Tc, Pc, omega (ThermoPackage::density, liquid branch), to every measured liquid mass density at or below 200 kPa; least squares in the relative density error, then its largest value minimised";
        fittedBy      "bin/curate/c287_new_components.py";
        reviewStatus  autoPromoted;
        review        { by none; }   // DEV.md 4c C300 rule 4 (C297): nobody has reviewed it
        fitGrade      clean;   // DEV.md 4c C285 limits 5 / 10 / 20 %
        fitGradeBasis inSample;   // DEV.md 4c C300 rule 1: the residual of the points it was fitted to
        fitGradeMaxRelativeError_pct 0.100045;
        reviewReason  "regressed by a machine from archive-transcribed measurements; not yet read back against the articles";
