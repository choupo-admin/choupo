    coefficients  (4.069371666  1427.004809  -64.914);
    Trange        (362.76  521.83);
}

Vliq        0.000177474;      // m3/mol at 25 C  [ChemSep eqno 105]
HvapTb      36135.8;      // J/mol at Tb  [ChemSep eqno 106]

idealGasHeatCapacity
{
    model         chemsepCp16;
    // Cp [J/(mol.K)] = A + exp(B/T + C + D T + E T^2)
    // ChemSep states J/(kmol.K); A and the exp are scaled to per-mole here.
    coefficients  (137.36  -689.88  6.678244721  -0.00018791  5.2355e-08);
    Trange        (150  1500);
}

liquidHeatCapacity
{
    model         chemsepCp16;
    // Cp [J/(mol.K)] = A + exp(B/T + C + D T + E T^2)
    coefficients  (29.546  -3.2521  4.478244721  0.0045932  -3.5582e-06);
    Trange        (158.25  416.35);
}

