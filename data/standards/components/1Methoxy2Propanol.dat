// (DEV.md 4c C294; bin/curate/uniquac_rq_from_groups.py).
uniquac
{
    r   3.6974;
    q   3.2880;
}

groups
{
    unifac ( { group CH3; count 2; } { group C2H4O2; count 1; } );
    joback ( { group CH3; count 2; } { group CH2; count 1; } { group CH; count 1; } { group ether; count 1; } { group OH; count 1; } );
}

