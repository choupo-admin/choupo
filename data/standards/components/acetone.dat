                { doi "10.1021/je0341763"; articleSha256 "b135448fe54dad323af363adc5b1a5dbdb35d7950ac4f6e40fc7eda945bb01c3"; pointsKept 1; pointsDropped 0; provenance measured; }
                { doi "10.1021/je500205z"; articleSha256 "de6213bfca9b4754a45493cf576de2d8280b507501a96f8997111b9e6268070c"; pointsKept 1; pointsDropped 0; provenance measured; }
                { doi "10.1021/je7000182"; articleSha256 "a357c52d16273d9ff1cb88313d92333d4bea38227942a55660db17e8c1bced54"; pointsKept 5; pointsDropped 0; provenance measured; }
        );
        acceptance
        {
