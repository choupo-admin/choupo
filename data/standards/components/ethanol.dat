        fitGradeMaxRelativeError_pct 1.023833;
        Trange        (276.51 342.82);   // K, the kept points -- outside it the engine announces an extrapolation
        reviewReason  "regressed by a machine from archive-transcribed measurements; not yet read back against the articles";
