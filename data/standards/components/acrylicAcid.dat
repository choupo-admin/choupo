// UNIQUAC van der Waals volume r and surface area q: the sum of the
// record's own UNIFAC groups (1 CH2=CH + 1 COOH), R_k/Q_k of Hansen et al. 1991
// (DEV.md 4c C294; bin/curate/uniquac_rq_from_groups.py).
uniquac
{
    r   2.6467;
    q   2.4000;
}

groups
{
    unifac ( { group CH2=CH; count 1; } { group COOH; count 1; } );
}
