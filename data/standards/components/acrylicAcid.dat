    coefficients  (4.722116272  1624.695657  -69.977);
    Trange        (393.15  582.16);
}

Vliq        6.88663e-05;      // m3/mol at 25 C  [ChemSep eqno 105]
HvapTb      27961.5;      // J/mol at Tb  [ChemSep eqno 106]

idealGasHeatCapacity
{
    model         chemsepCp16;
    // Cp [J/(mol.K)] = A + exp(B/T + C + D T + E T^2)
    // ChemSep states J/(kmol.K); A and the exp are scaled to per-mole here.
    coefficients  (49.916  -589.6  5.351244721  -0.00013536  3.0855e-08);
    Trange        (250  1500);
}

liquidHeatCapacity
{
    model         chemsepCp16;
    // Cp [J/(mol.K)] = A + exp(B/T + C + D T + E T^2)
    coefficients  (142.25  1837.1  -45.28075528  0.21763  -0.00027035);
    Trange        (252.65  375);
}

