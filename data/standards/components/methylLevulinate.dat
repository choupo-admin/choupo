// (DEV.md 4c C294; bin/curate/uniquac_rq_from_groups.py).
uniquac
{
    r   4.9243;
    q   4.2960;
}

groups
{
    unifac ( { group CH3CO; count 1; } { group CH2; count 1; } { group CH2COO; count 1; } { group CH3; count 1; } );
    joback ( { group CH3; count 2; } { group CH2; count 2; } { group ketone; count 1; } { group ester; count 1; } );
}

