  Component: methylLevulinate  (methyl levulinate (methyl 4-oxopentanoate); CAS 624-45-3)
  NEW in the catalogue (DEV.md 4c C287, 2026-11-10), built by
  bin/curate/c287_new_components.py from measurements the NIST/TRC ThermoML Archive
  locates (the articles are the sources; their DOIs are in provenance).
  MEASURED: Tc, Pc.  FITTED: vapour pressure (bin/choupo-curate vp),
  Vliq, liquid Cp.  DERIVED: omega (from the fitted vapour pressure).
  ESTIMATED (Joback): ideal-gas Cp, dHf_298; s_298 derived from Joback's
  dHf and dGf.  No measured series is reproduced here.
  reviewStatus autoPromoted, humanReviewed false: NO human has read it back.
  Psat: fitted by `bin/choupo-curate vp`; its promotion replaced the
  AmbroseWalton block this tool writes (provenance.vaporPressure).
\*---------------------------------------------------------------------------*/

name        methylLevulinate;
CAS         624-45-3;
formula     C6H10O3;
reviewStatus autoPromoted;
humanReviewed false;
MW          130.1430;      // kg/kmol, from the formula (IUPAC standard atomic weights)
Tc          668;      // K, measured (provenance.Tc)
Pc          32.7;      // bar, measured (provenance.Pc)
omega       0.507415;      // [-] (provenance.omega)
//  Tb: NOT DECLARED -- the archive reports no boiling temperature at
//  101.3 kPa for it, and a Tb read back off the fitted Antoine would be
//  the curve tested against itself (the fitted normal boiling point is
//  in provenance.vaporPressure.acceptance.Tnb_fit).

standardThermochemistry
{
    dHf_298   -597030;        // J/mol, ideal gas, Joback ESTIMATE (provenance.dHf_298)
    s_298     467.71;        // J/(mol K), ideal gas, DERIVED from Joback (provenance.s_298)
}

vaporPressure
{
    model         Antoine;
    // log10(Psat [bar]) = A - B / (T[K] + C), FITTED by bin/choupo-curate vp to
    // measured vapour pressures -- see provenance.vaporPressure
    coefficients  (4.618302704  1844.875917  -67.51164888);
    Trange        (293.5  453.15);   // the fit's own span; outside it the engine announces the extrapolation
}

Vliq        1.244884e-04;      // m3/mol at 25 C, FITTED (provenance.Vliq)

idealGasHeatCapacity
{
    model         polynomial;
    // Cp [J/(mol K)] = a0 + a1 T + a2 T^2 + a3 T^3, Joback ESTIMATE
    coefficients  (30.202  0.49104  -1.893000e-04  -5.940000e-09);
    Trange        (273  1000);
}

liquidHeatCapacity
{
    model         polynomial;
    // Cp [J/(mol K)] = a0 + a1 T + a2 T^2, FITTED (provenance.liquidHeatCapacity)
    coefficients  (377.302105  -0.8874669489  0.001638199221);
    Trange        (302.68  373.68);
}

