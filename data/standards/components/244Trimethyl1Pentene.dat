            max_pct     0.042194;
            measuredAt  298.15;   // K: ONE measurement -- the parameter reproduces it exactly and the grade says nothing about its temperature dependence
        }
    }
    liquidHeatCapacity
    {
        origin           estimated;
        method           "Rowlinson-Bondi corresponding states, Poling, Prausnitz & O'Connell, The Properties of Gases and Liquids, 5th ed. (2001), Eq. (6-6.4): (Cp_L - Cp_ig)/R = 1.586 + 0.49/(1 - Tr) + omega [4.2775 + 6.3 (1 - Tr)^(1/3)/Tr + 0.4355/(1 - Tr)], with this record's Joback Cp_ig, Tc (thermoml) and omega; represented by a quadratic in T least-squares fitted to the equation over 306.23-356.24 K (the fitted vapour pressure's span within 0.40-0.80 Tc), max deviation 0.002 % from it";
