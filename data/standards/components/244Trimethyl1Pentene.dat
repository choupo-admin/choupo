    }
    s_298
    {
        origin           estimated;
        method           "derived from Joback: s_298 = (dHf_298 - dGf_298)/298.15 + the sum of the elements' standard entropies, with Joback's dGf_298 = 98610 J/mol (not stored: dGf derives from dHf and s_298)";
