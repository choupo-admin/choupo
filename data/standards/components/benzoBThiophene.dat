            { doi "10.1016/j.jct.2014.04.025"; articleSha256 "bfa22642070baadca42983bb1bf275e5cf2bf483f189a43eb2d44f7f69d07cc0"; pointsKept 3; pointsDropped 0; provenance measured; }
            { doi "10.1016/j.jct.2014.12.005"; articleSha256 "b53ded439e6dd183a082fa7d954f4678129f9f998cea64aa0ab06799acec3ba2"; pointsKept 1; pointsDropped 0; provenance measured; }
        );
        acceptance
        {
            rule        "the default graded acceptance of DEV.md 4c C285 on the max relative error over the kept points (clean / warning / severe up to 5 / 10 / 20 %); every laboratory fitted, points beyond 15 % after the least-squares stage discarded by name (C283 amended)";
            verdict     accepted;
            studies     4;
            pointsKept  17;
            pointsDropped 1;
            dropped     "10.1016/j.jct.2013.12.029 T=298.15 K rho=1427 err -18.2 %";
            aad_pct     0.085953;
            max_pct     0.153624;
            Trange      (308.15 363.15);   // K, the kept points
        }
    }
    liquidHeatCapacity
    {
        origin           estimated;
        method           "Rowlinson-Bondi corresponding states, Poling, Prausnitz & O'Connell, The Properties of Gases and Liquids, 5th ed. (2001), Eq. (6-6.4): (Cp_L - Cp_ig)/R = 1.586 + 0.49/(1 - Tr) + omega [4.2775 + 6.3 (1 - Tr)^(1/3)/Tr + 0.4355/(1 - Tr)], with this record's Joback Cp_ig, Tc (iupac) and omega; represented by a quadratic in T least-squares fitted to the equation over 434.26-493.8 K (the fitted vapour pressure's span within 0.40-0.80 Tc), max deviation 0.002 % from it";
        computedBy       "bin/curate/c287_new_components.py (rowlinson_bondi)";
        inputFingerprint "arC:2,arCH:6,rS:1";
        reproducedInCase "data/curation/batches/new_components_c309";
        uncertainty      { status unquantified; reason "Poling 5e p. 6.22: 2.5 % AAD on 194 substances at 298 K, more than 10 % on 18 others, most hydrogen-bonded (C1-C4 alcohols and acids, water, amines); the archive locates no liquid Cp for this compound and no Zabransky supplement in hand recommends one"; }
        reviewStatus     autoPromoted;
        review           { by none; }   // DEV.md 4c C300 rule 4 (C297): nobody has reviewed it
    }
    idealGasHeatCapacity
    {
        origin           estimated;
        method           "Joback";
        methodVersion    "joback-poling5e-table2-2";
        input            joback;
        inputFingerprint "arC:2,arCH:6,rS:1";
        reproducedInCase "data/curation/batches/new_components_c309";
        uncertainty      { status unquantified; reason "Joback group contribution (Joback & Reid 1987); a few percent for Cp_ig of ordinary organics"; }
    }
    dHf_298
    {
        origin           estimated;
        method           "Joback";
        methodVersion    "joback-poling5e-table2-2";
        input            joback;
        inputFingerprint "arC:2,arCH:6,rS:1";
        reproducedInCase "data/curation/batches/new_components_c309";
        uncertainty      { status unquantified; reason "Joback group contribution (Joback & Reid 1987); several kJ/mol, more for polyfunctional molecules"; }
