    s_298     265.4;        // J/(mol.K)  third-law absolute
}

vaporPressure
{
    model AmbroseWalton;  // [origin=estimated method=Ambrose-Walton]
}

Vliq        8.19409e-05;      // m3/mol at 25 C  [ChemSep eqno 105]
HvapTb      23981.8;      // J/mol at Tb  [ChemSep eqno 106]

idealGasHeatCapacity
{
    model         chemsepCp16;
    // Cp [J/(mol.K)] = A + exp(B/T + C + D T + E T^2)
    // ChemSep states J/(kmol.K); A and the exp are scaled to per-mole here.
    coefficients  (37.38005  -673.6637  5.813364721  -6.3263e-05  1.539025e-09);
    Trange        (200  1500);
}

liquidHeatCapacity
{
    model         chemsepCp16;
    // Cp [J/(mol.K)] = A + exp(B/T + C + D T + E T^2)
    coefficients  (-3.355973  25.71519  4.242004721  -1.99586e-05  4.55626e-06);
    Trange        (190  298.15);
}

liquidThermalConductivity
{
    chemsepEq16
    {
        A     0.0169674;
        B     14.7154;
        C     -1.831383;
        D     -0.000155026;
        E     -4.8849e-06;
        Tmin  182.48;
        Tmax  285.66;
    }
}

// UNIQUAC van der Waals volume r and surface area q: the sum of the
// record's own UNIFAC groups (4 CH2), R_k/Q_k of Hansen et al. 1991
// (DEV.md 4c C294; bin/curate/uniquac_rq_from_groups.py).
uniquac
{
    r   2.6976;
    q   2.1600;
}

groups
{
    unifac ( { group CH2; count 4; } );
}
