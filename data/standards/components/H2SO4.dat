/*--------------------------------*- Choupo -*-----------------------*\
  Component: Sulfuric acid (H2SO4), pure liquid.  CAS 7664-93-9.

  THE archetypal strong mineral acid.  This is the MOLECULAR component
  (pure-liquid formation datum).  It carries NO `role nonvolatile`: a case
  that treats it as a dissolved acid (neutralisation duty, sulfate-salt
  precipitation, pickling, acid balances) declares nonvolatility locally, and
  the dissociation (H2SO4 -> H+ + HSO4- -> H+ + SO4--) is electrolyte
  chemistry -- not a universal component role.

  Carries the LIQUID-phase formation datum and a real liquid heat capacity,
  so its heat of neutralisation closes from the elements reference.

  PRIMARY: Wagman et al., NBS Tables of Chemical Thermodynamic Properties,
  J. Phys. Chem. Ref. Data 11, Suppl. 2 (1982) -- PUBLIC DOMAIN.
  Density: ~1.830 g/cm^3 (pure liquid, 25 C) -> Vliq below.
\*---------------------------------------------------------------------------*/

name        H2SO4;
formula     H2SO4;
CAS         7664-93-9;

MW          98.079;            // kg/kmol


Vliq        5.360e-5;          // m^3/mol  (= MW / 1830 kg/m^3)

standardThermochemistry
{
    dHf_298   -813989;         // J/mol  liquid H2SO4 [Wagman et al. NBS Tables 1982]
    s_298     156.90;          // J/(mol*K) [Wagman 1982]
    referenceState     pureLiquid;
}

liquidHeatCapacity
{
    model         polynomial;          // Cp = a0  [J/(mol*K)], constant
    coefficients  ( 138.91 );          // Cp(298) [Wagman et al. NBS Tables 1982]
    Trange        ( 283  330 );        // constant-Cp validity flag (liquid, near ambient)
}

provenance
{
    standardThermochemistry { origin literature; method "Wagman et al. NBS Tables 1982 (liquid H2SO4)"; }
    liquidHeatCapacity { origin literature; method "Wagman et al. NBS Tables 1982 (Cp298, carried constant)"; }
    Vliq { origin literature; method "pure-liquid density ~1.830 g/cm3 at 25 C"; }
}

cosmo
{
    LVPP-HFTZVP-2018
    {
        model       COSMOSAC;
        variant     "LVPP-HFTZVP-2018";
        protocol    "LVPP-18.07 GAMESS HF/TZVP; r_av 1.4 A; f_decay 3.57; d in A; sigma = q/a";
        source      "LVPP sigma-profile database release 18.07 (github.com/lvpp/sigma, asset HF_TZVP.zip, sha256 bd17aaeebb430641...), file SULFURIC_ACID.gout; MIT License, Copyright (c) 2017 LVPP; cite Ferrarini, Flores, Muniz & Soares, AIChE J. 64 (2018) 3443, doi:10.1002/aic.16194, and doi:10.5281/zenodo.3613786; identity: InChIKey QAOWNCQODCNURD-UHFFFAOYSA-N (full match); formula H2O4S; resolved by thirdParty/thermoml/identity.json (PubChem and CACTUS agree)";
        derivation  "segment areas, charges and the cavity volume are LVPP's (GAMESS HF/TZVP COSMO output); `area` is the sum of LVPP's segment areas as binned (GAMESS's printed cavity area agrees within its 2-decimal rounding); the 51-point profile is COMPUTED BY CHOUPO from LVPP's surface segments by bin/curate/lvpp_sigma_profile.py under the protocol above (Bell et al. 2020 Eq. 4 averaging, sigma = q/a, area split linearly between grid nodes)";
        licence     MIT;
        installed   true;
        area        97.806898;   // sum of the profile below; GAMESS prints 97.81
        volume      80.76;
        sigmaProfile  (
               0.670540     2.204379     3.028385     0.309597     0.720362     3.785350
               1.915081     1.207885     0.773775     1.685626     0.746861     0.285479
               0.460200     1.074021     0.887683     0.143711     0.602125     1.617473
               2.328610     2.432201     3.325876     1.421085     1.901821     2.971551
               1.382225     2.250494     3.374961     2.639736     3.974013     3.004918
               2.275322     3.157311     6.740456     4.656788     6.100328     1.434891
               7.851755    11.547009     0.917014     0.000000     0.000000     0.000000
               0.000000     0.000000     0.000000     0.000000     0.000000     0.000000
               0.000000     0.000000     0.000000
        );
    }
}
