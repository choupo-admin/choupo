}

Vliq        0.000363155;      // m3/mol at 25 C  [ChemSep eqno 105]
HvapTb      57261.5;      // J/mol at Tb  [ChemSep eqno 106]

idealGasHeatCapacity
{
    model         chemsepCp16;
    // Cp [J/(mol.K)] = A + exp(B/T + C + D T + E T^2)
