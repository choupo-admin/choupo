{
    dHf_298   -229090;      // J/mol ideal-gas -- provenance: see the structured dHf_298 block below
    dGf_298   24900;      // J/mol  ideal-gas [Joback]
    s_298     506.573;      // J/(mol*K) third-law [DERIVED: (dHf-dGf)/T + CODATA element S]
}

