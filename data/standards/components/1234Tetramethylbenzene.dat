// UNIQUAC van der Waals volume r and surface area q: the sum of the
// record's own UNIFAC groups (2 ACH + 4 ACCH3), R_k/Q_k of Hansen et al. 1991
// (DEV.md 4c C294; bin/curate/uniquac_rq_from_groups.py).
uniquac
{
    r   6.1278;
    q   4.6720;
}

groups
{
    unifac ( { group ACH; count 2; } { group ACCH3; count 4; } );
}
