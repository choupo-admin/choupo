/*--------------------------------*- Choupo -*-----------------------*\
  Component: Hypochlorous acid, gas (chlorine hydrolysis)
  Ideal-gas formation data and heat capacity READ from
  NASA/TP-2002-211556 (McBride, Zehe & Gordon 2002, "NASA Glenn
  Coefficients for Calculating Thermodynamic Properties of Individual
  Species"), a US government work in the public domain: entry
  "HOCL", appendix D p. 130 (dHf_298 and the NASA-9 Cp coefficients,
  as printed) and Table B1 p. 21 (s_298).  The report's own sources
  for this species: Hf:Gurvich,1989 pt1 p187. Jacox,1998 p155.
  No liquid phase at process conditions -- the entry is tagged
  `role nonvolatile;` so vapour-pressure routines never get called.
  Re-sourced 2026-11-12 (DEV.md 4c C335) by
  bin/curate/nasa_tp2002_to_choupo.py from the NonCommercial compilation
  this record was first generated from (its old numbers
  are not kept here: they were that compilation's); not yet read back by
  a curator.
\*---------------------------------------------------------------------------*/

name           HOCl;
formula        HOCL;
CAS            7790-92-3;

MW             52.457;       // kg/kmol
role        nonvolatile;
tags           ( gasPhase combustion chlorine );
reviewStatus   interim;
reviewReason   "transcribed by machine from NASA/TP-2002-211556 and checked against the report itself; not yet read back against the page by a curator";

standardThermochemistry
{
    dHf_298    -75740.032;   // J/mol  -- ideal gas; NASA/TP-2002-211556 appendix D, p. 130, entry HOCL
    s_298      236.567;     // J/(mol·K) -- third-law absolute; Table B1, p. 21
}

idealGasHeatCapacity
{
    //  NASA/TP-2002-211556 eq. (1), Cp/R = a1/T^2 + a2/T + a3 + a4 T + a5 T^2
    //  + a6 T^3 + a7 T^4; appendix D, p. 130, entry HOCL, a1..a7 as printed.
    model    NASA9;
    Tlow     200;
    Tcommon  1000;
    Thigh    6000;
    low      ( -9.739307430e+03 3.547569520e+02 1.539514254e-01 1.617051795e-02 -2.179693631e-05 1.509103049e-08 -4.125383510e-12 );
    high     ( 8.530457810e+05 -2.847760552e+03 7.948329040e+00 -1.048782013e-04 -1.482405043e-08 4.591678270e-12 -3.060073987e-16 );
}

provenance
{
    dHf_298
    {
        origin        literature;
        method        "NASA/TP-2002-211556 appendix D, p. 130, entry HOCL, record-line H(298.15) (elements reference, so = dHf)";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "Table B1 p. 21 prints -75.74 kJ/mol; the report's own sources: Hf:Gurvich,1989 pt1 p187. Jacox,1998 p155.";
    }
    s_298
    {
        origin        literature;
        method        "NASA/TP-2002-211556 Table B1, p. 21, entry HOCL";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "appendix D's coefficients with b2 integrate to 236.567";
    }
    idealGasHeatCapacity
    {
        origin        literature;
        method        "NASA/TP-2002-211556 appendix D, p. 130, entry HOCL, a1..a7 of the 200-1000 K and 1000-6000 K intervals, as printed";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "read by bin/curate/nasa_tp2002_to_choupo.py, which holds H and S at 298.15 K to the printed values";
    }
    source   "McBride, Zehe & Gordon, NASA Glenn Coefficients for Calculating Thermodynamic Properties of Individual Species, NASA/TP-2002-211556 (2002)";
    licence  publicDomain;    // US government work (NASA), 17 U.S.C. 105
}
