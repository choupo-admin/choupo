            { doi "10.1021/je100693c"; articleSha256 "e91cb0fc6aa0e916cc75d732eede369cb9b7ecd78903a0d243ff6359ce90c8f9"; pointsKept 11; pointsDropped 0; provenance measured; }
            { doi "10.1021/je700034q"; articleSha256 "f934e4899fe92182f72dcd09ae76b7672c6003fbf989fb046b23b01aec379264"; pointsKept 1; pointsDropped 0; provenance measured; }
            { doi "10.1021/je700103k"; articleSha256 "8556ab6c69567fe31d1850a9e3f3bf11d93b114c5105bf54204d253fd3973fd0"; pointsKept 1; pointsDropped 0; provenance measured; }
            { doi "10.1021/je700741x"; articleSha256 "c9baaac1f611c90f795a3d57c9620d7ed64d2d3333d34eb0a643d18e85faf5f5"; pointsKept 1; pointsDropped 0; provenance measured; }
            { doi "10.1021/je8001688"; articleSha256 "b2dd114eca2463614a308957df2dcab9a1f2c384c081dfea3014d3d4f86530a8"; pointsKept 1; pointsDropped 0; provenance measured; }
            { doi "10.1021/je8002964"; articleSha256 "c0ebd2a234501764cb9e5066b86569cc99e6e7c79d9917bd7962713b1ea85be1"; pointsKept 1; pointsDropped 0; provenance measured; }
        );
        acceptance
        {
            rule        "the default graded acceptance of DEV.md 4c C285 on the max relative error over the kept points (clean / warning / severe up to 5 / 10 / 20 %); every laboratory fitted, points beyond 15 % after the least-squares stage discarded by name (C283 amended)";
            verdict     accepted;
            studies     14;
            pointsKept  58;
            pointsDropped 0;
            dropped     "none";
            aad_pct     1.031657;
            max_pct     2.311917;
            Trange      (273.15 343.15);   // K, the kept points
        }
    }
    liquidHeatCapacity
    {
        origin        literature;
        method        "Zabransky et al. recommended isobaric heat capacity, their Eq. 19, C/R = sum_j A(j+1) (T/100)^j with R = 8.31451 J/(mol K): A1 = 4.42059, A2 = 5.68885, converted to the record's polynomial in T (a_j = R A(j+1) / 100^j)";
        source        "Zabransky, M.; Ruzicka, V., Jr.; Domalski, E.S. Heat Capacity of Liquids: Critical Review and Recommended Values. Supplement I. J. Phys. Chem. Ref. Data 30 (2001) 1199, Table 61.8.3 (regression polynomial)";
        doi           "10.1063/1.1407866";
        uncertainty   "level III (below 0.5 %), the evaluators' assignment over 298.1-308.1 K";
