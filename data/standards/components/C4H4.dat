/*--------------------------------*- Choupo -*-----------------------*\
  Component: Vinylacetylene (1-buten-3-yne, H2C=CH-C#CH; C4 soot-growth intermediate)
  Ideal-gas thermochemistry COMPUTED, not tabulated: the enthalpy of formation
  is the ab initio ANL0 value of Klippenstein, Harding & Ruscic, J. Phys. Chem. A 121
  (2017) 6580, Table 2 (0 K, converted to 298.15 K), the entropy and heat capacity are
  rigid-rotor / harmonic-oscillator values from the measured rotational constants
  and calculated, scaled vibrations (bin/curate/rrho_thermo.py, inputs in
  bin/curate/rrho_species.json, `component_records`; the gate check_rrho_thermo arm (e)
  holds the three blocks below equal to the tool's output).
  Re-sourced 2026-11-24 (DEV.md 4c C335).  The record used to carry 431.7 kJ/mol,
  an enthalpy about 135 kJ/mol too high for this molecule (cyclobutadiene class),
  from a NonCommercial compilation; none of its numbers is kept.
  No liquid phase at process conditions ---
  the entry is tagged `role nonvolatile;` so vapour-pressure routines
  never get called.
\*---------------------------------------------------------------------------*/

name           C4H4;
formula        C4H4;
CAS            689-97-4;

MW             52.076;       // kg/kmol
role        nonvolatile;
tags           ( gasPhase combustion soot );
reviewStatus   interim;
reviewReason   "enthalpy of formation read from the paper's Table 2 (accepted manuscript); entropy and heat capacity computed from calculated vibrations (no measured fundamental was readable); not read back by a curator";

standardThermochemistry
{
    dHf_298    289037.325;   // J/mol  -- ideal gas; Klippenstein, Harding & Ruscic, J. Phys. Chem. A 121 (2017) 6580, Table 2: ANL0 0 K value 295.7 kJ/mol, +-1.4 kJ/mol (2 sigma, their Sec. 4.1); converted to 298.15 K here
    s_298      278.486;     // J/(mol K) -- RRHO at 298.15 K, P0 = 1 bar (rrho_thermo.py)
}

idealGasHeatCapacity
{
    //  Cp/R = a1/T^2 + a2/T + a3 + a4 T + a5 T^2 + a6 T^3 + a7 T^4 (NASA9 form, as the
    //  NASA/TP-2002-211556 records), LEAST-SQUARES FIT to the RRHO Cp(T) curve of
    //  rrho_thermo.py on 200-1000 K (10 K) and 1000-6000 K (50 K).
    //  Worst relative Cp error of the fit: 2.70e-04 at 1000 K (low), 4.70e-05 at 1000 K (high).
    model    NASA9;
    Tlow     200;
    Tcommon  1000;
    Thigh    6000;
    low      ( 2.227281071e+04 2.157775030e+02 -3.428271244e+00 5.398680444e-02 -6.779203957e-05 4.696702458e-08 -1.330566818e-11 );
    high     ( 3.691643259e+06 -1.517513358e+04 3.033036059e+01 -2.602070272e-03 4.702602617e-07 -4.572220173e-11 1.848373812e-15 );
}

// UNIQUAC van der Waals volume r and surface area q: the sum of the
// record's own UNIFAC groups (1 CH2=CH + 1 CH_C), R_k/Q_k of Hansen et al. 1991
// (DEV.md 4c C294; bin/curate/uniquac_rq_from_groups.py).
uniquac
{
    r   2.6374;
    q   2.2640;
}

groups
{
    unifac ( { group CH2=CH; count 1; } { group CH_C; count 1; } );   // derived from structure C=CC#C by bin/curate/unifac_groups.py
}

provenance
{
    uniquac
    {
        origin        definition;
        method        "sum of UNIFAC group R_k/Q_k: r = sum nu_k R_k = 2.6374, q = sum nu_k Q_k = 2.2640 over the record's unifac groups (1 CH2=CH + 1 CH_C)";
        citation      "R_k and Q_k of Hansen, Rasmussen, Fredenslund, Schiller & Gmehling, Ind. Eng. Chem. Res. 30 (1991) 2352, as tabulated in data/standards/parameters/UNIFAC/groups.dat; the group sum of Fredenslund, Jones & Prausnitz, AIChE J. 21 (1975) 1086";
    }
    unifacGroups
    {
        origin        derived;
        method        "cut from the molecular structure C=CC#C (atom count reproduces the record's formula) into 1 CH2=CH + 1 CH_C by the rules of bin/curate/unifac_groups.py; no table of decompositions was consulted";
        citation      "Hansen, Rasmussen, Fredenslund, Schiller & Gmehling, Ind. Eng. Chem. Res. 30 (1991) 2352 (the subgroup definitions, data/standards/parameters/UNIFAC/groups.dat)";
        reviewStatus  interim;
    }
    dHf_298
    {
        origin        derived;
        method        "ab initio ANL0 composite (CCSD(T) with higher-order, core-valence, relativistic and anharmonic-ZPE corrections), enthalpy of formation at 0 K, ideal gas; Table 2 lists species NOT in the ATcT data set; 0 K value converted to 298.15 K as dHf(0) + [H(298.15)-H(0)] of the molecule (this tool's RRHO) - sum of the element increments (CODATA Key Values: graphite C 1.050, H2 8.468 kJ/mol)";
        methodVersion "J. Phys. Chem. A 121, 6580 (2017); accepted manuscript OSTI 1389058, Table 2, row CH2CHCCH, read 2026-11-24";
        inputs
        (
            { quantity "Delta_f H at 0 K (ab initio ANL0, paper label CH2CHCCH, Table 2; 2 sigma +-1.4 kJ/mol)"; value 295.7; unit kJ/mol; doi "10.1021/acs.jpca.7b05945"; }
        );
        uncertainty   "+-1.4 kJ/mol (2 sigma, the ANL0 scheme's estimate, Sec. 4.1); the same row's ANL0-F12 and ANL1 values differ by -0.3 and -0.1 kJ/mol";
        notes         "Replaces 431.7 kJ/mol, which belonged to a cyclobutadiene-class C4H4, not to vinylacetylene (C335, 2026-11-24). A computed value, no measurement was read; the NIST WebBook lists 295 kJ/mol (298.15 K, Roth et al. 1991, a force-field resonance-energy paper, not independent) for the same species.";
    }
    s_298
    {
        origin        derived;
        method        "RRHO from molecular constants via bin/curate/rrho_thermo.py with the inputs of bin/curate/rrho_species.json (Sackur-Tetrode translation, rigid rotor, harmonic oscillator, electronic levels), 1 bar";
        methodVersion "rrho_thermo.py rrho_species.json";
        inputs
        (
            { quantity "vibrational wavenumber 1 (calc)"; value 220.2; unit cm-1; doi "10.1063/5.0006074"; }
            { quantity "vibrational wavenumber 2 (calc)"; value 311.1; unit cm-1; doi "10.1063/5.0006074"; }
            { quantity "vibrational wavenumber 3 (calc)"; value 540.8; unit cm-1; doi "10.1063/5.0006074"; }
            { quantity "vibrational wavenumber 4 (calc)"; value 624.5; unit cm-1; doi "10.1063/5.0006074"; }
            { quantity "vibrational wavenumber 5 (calc)"; value 651.1; unit cm-1; doi "10.1063/5.0006074"; }
            { quantity "vibrational wavenumber 6 (calc)"; value 681.3; unit cm-1; doi "10.1063/5.0006074"; }
            { quantity "vibrational wavenumber 7 (calc)"; value 862; unit cm-1; doi "10.1063/5.0006074"; }
            { quantity "vibrational wavenumber 8 (calc)"; value 926.7; unit cm-1; doi "10.1063/5.0006074"; }
            { quantity "vibrational wavenumber 9 (calc)"; value 973; unit cm-1; doi "10.1063/5.0006074"; }
            { quantity "vibrational wavenumber 10 (calc)"; value 1074.7; unit cm-1; doi "10.1063/5.0006074"; }
            { quantity "vibrational wavenumber 11 (calc)"; value 1277.9; unit cm-1; doi "10.1063/5.0006074"; }
            { quantity "vibrational wavenumber 12 (calc)"; value 1397.9; unit cm-1; doi "10.1063/5.0006074"; }
            { quantity "vibrational wavenumber 13 (calc)"; value 1609.3; unit cm-1; doi "10.1063/5.0006074"; }
            { quantity "vibrational wavenumber 14 (calc)"; value 2124.4; unit cm-1; doi "10.1063/5.0006074"; }
            { quantity "vibrational wavenumber 15 (calc)"; value 3028.1; unit cm-1; doi "10.1063/5.0006074"; }
            { quantity "vibrational wavenumber 16 (calc)"; value 3040; unit cm-1; doi "10.1063/5.0006074"; }
            { quantity "vibrational wavenumber 17 (calc)"; value 3124.4; unit cm-1; doi "10.1063/5.0006074"; }
            { quantity "vibrational wavenumber 18 (calc)"; value 3346.8; unit cm-1; doi "10.1063/5.0006074"; }
            { quantity "rotational constant A (exp)"; value 1.67754; unit cm-1; doi "10.18434/T47C7Z"; }
            { quantity "rotational constant B (exp)"; value 0.15827; unit cm-1; doi "10.18434/T47C7Z"; }
            { quantity "rotational constant C (exp)"; value 0.14442; unit cm-1; doi "10.18434/T47C7Z"; }
            { quantity "rotational symmetry number (point group of the cited structure)"; value 1; unit 1; doi "10.18434/T47C7Z"; }
            { quantity "electronic level 1 energy (cited state table)"; value 0; unit cm-1; doi "10.18434/T47C7Z"; }
            { quantity "electronic level 1 degeneracy (cited state table)"; value 1; unit 1; doi "10.18434/T47C7Z"; }
        );
        uncertainty   "+-0.7 J/(mol K) (every frequency moved by its 1.7 % rms scale error; the measured rotational constants add less than 0.1); plus 1.0 for the two lowest bends treated as harmonic (judgement, as for the other computed records)";
        notes         "constants: rotational constants A, B, C: NIST CCCBDB release 22 (cccbdb.nist.gov, SRD 101) experimental page, fetched 2026-11-24, source listed there as NISThydrocarbon (microwave); taken from CCCBDB as the ROUTE, the microwave paper itself was NOT read; NO measured fundamental is tabulated there or in the WebBook (the fundamentals of Stamm 1949, J. Chem. Phys. 17, 104, were not readable): the 18 vibrations are CALCULATED: B3LYP/def2-TZVP (density fitted, DFT grid level 3) harmonic frequencies (PySCF, bin/curate/rrho_abinitio_constants.py C4H4) x 0.9642 (the single factor fitted on 23 measured fundamentals, the scale_calibration block of rrho_species.json, rms 1.7 %), raw harmonic frequencies 228.4, 322.6, 560.9, 647.6, 675.3, 706.6, 894.0, 961.1, 1009.2, 1114.6, 1325.4, 1449.8, 1669.0, 2203.3, 3140.5, 3152.9, 3240.4, 3471.0 cm-1; the B3LYP equilibrium rotational constants 1.742, 0.1584, 0.1452 cm-1 agree with the measured ones to 3.9, 0.1, 0.5 %";
    }
    idealGasHeatCapacity
    {
        origin        derived;
        method        "RRHO from molecular constants via bin/curate/rrho_thermo.py with the inputs of bin/curate/rrho_species.json, then a 7-term NASA9 least-squares fit (200-1000 K and 1000-6000 K)";
        methodVersion "rrho_thermo.py rrho_species.json";
        inputs
        (
            { quantity "vibrational wavenumber 1 (calc)"; value 220.2; unit cm-1; doi "10.1063/5.0006074"; }
            { quantity "vibrational wavenumber 2 (calc)"; value 311.1; unit cm-1; doi "10.1063/5.0006074"; }
            { quantity "vibrational wavenumber 3 (calc)"; value 540.8; unit cm-1; doi "10.1063/5.0006074"; }
            { quantity "vibrational wavenumber 4 (calc)"; value 624.5; unit cm-1; doi "10.1063/5.0006074"; }
            { quantity "vibrational wavenumber 5 (calc)"; value 651.1; unit cm-1; doi "10.1063/5.0006074"; }
            { quantity "vibrational wavenumber 6 (calc)"; value 681.3; unit cm-1; doi "10.1063/5.0006074"; }
            { quantity "vibrational wavenumber 7 (calc)"; value 862; unit cm-1; doi "10.1063/5.0006074"; }
            { quantity "vibrational wavenumber 8 (calc)"; value 926.7; unit cm-1; doi "10.1063/5.0006074"; }
            { quantity "vibrational wavenumber 9 (calc)"; value 973; unit cm-1; doi "10.1063/5.0006074"; }
            { quantity "vibrational wavenumber 10 (calc)"; value 1074.7; unit cm-1; doi "10.1063/5.0006074"; }
            { quantity "vibrational wavenumber 11 (calc)"; value 1277.9; unit cm-1; doi "10.1063/5.0006074"; }
            { quantity "vibrational wavenumber 12 (calc)"; value 1397.9; unit cm-1; doi "10.1063/5.0006074"; }
            { quantity "vibrational wavenumber 13 (calc)"; value 1609.3; unit cm-1; doi "10.1063/5.0006074"; }
            { quantity "vibrational wavenumber 14 (calc)"; value 2124.4; unit cm-1; doi "10.1063/5.0006074"; }
            { quantity "vibrational wavenumber 15 (calc)"; value 3028.1; unit cm-1; doi "10.1063/5.0006074"; }
            { quantity "vibrational wavenumber 16 (calc)"; value 3040; unit cm-1; doi "10.1063/5.0006074"; }
            { quantity "vibrational wavenumber 17 (calc)"; value 3124.4; unit cm-1; doi "10.1063/5.0006074"; }
            { quantity "vibrational wavenumber 18 (calc)"; value 3346.8; unit cm-1; doi "10.1063/5.0006074"; }
            { quantity "rotational constant A (exp)"; value 1.67754; unit cm-1; doi "10.18434/T47C7Z"; }
            { quantity "rotational constant B (exp)"; value 0.15827; unit cm-1; doi "10.18434/T47C7Z"; }
            { quantity "rotational constant C (exp)"; value 0.14442; unit cm-1; doi "10.18434/T47C7Z"; }
            { quantity "rotational symmetry number (point group of the cited structure)"; value 1; unit 1; doi "10.18434/T47C7Z"; }
            { quantity "electronic level 1 energy (cited state table)"; value 0; unit cm-1; doi "10.18434/T47C7Z"; }
            { quantity "electronic level 1 degeneracy (cited state table)"; value 1; unit 1; doi "10.18434/T47C7Z"; }
        );
        uncertainty   "+-0.9 J/(mol K) at 298 K and at 1000 K from the same propagation; plus 0.5 for the two lowest bends; above ~1500 K the harmonic model under-counts (anharmonicity, validated deficit up to -3 % at 1500 K and -7 % at 3000 K)";
        notes         "Cp(298.15) = 72.786, Cp(1500) = 156.844 J/(mol K) from the RRHO curve; fit error 2.7e-04 (<1000 K) and 4.7e-05 (>=1000 K), relative. Approximations: rigid rotor, harmonic oscillator, all 18 vibrations calculated and scaled; Cs, sigma 1; the two lowest modes (about 220 and 311 cm-1, CCC and CCH bends) are large-amplitude; cross-check, information only and not an origin: the NIST WebBook lists Cp 73.18 J/(mol K) at 298.15 K and 138.74 at 1000 K (Stamm 1949 and the Glushko Thermocenter, a statistical calculation whose compiler warns of 4-7 J/(mol K)), against 72.79 and 138.61 here";
    }
    source   "Choupo RRHO computation (bin/curate/rrho_thermo.py) from the molecular constants and enthalpy of formation cited in the record's provenance";
    licence  publicDomain;    // the computation is Choupo's own; the 0 K enthalpy is a number cited from a peer-reviewed paper (a fact, not its text); rotational constants are NIST (US government) CCCBDB values, the microwave paper itself not read
}

cosmo
{
    VT2005
    {
        model       COSMOSAC;
        variant     "2002";
        source      "VT-2005 sigma-profile database (Mullins et al., Ind. Eng. Chem. Res. 45 (2006) 4389; DFT-COSMO), file VT2005-0235-PROF.txt bundled in usnistgov/COSMOSAC; CAS 689-97-4";
        licence     externalRestricted;   // VT-2005: redistribution NOT confirmed -- values NOT shipped
        installed   false;                 // install your own copy: bin/choupo-import-cosmo (-> data/local/cosmo/VT2005/)
    }
    LVPP-HFTZVP-2018
    {
        model       COSMOSAC;
        variant     "LVPP-HFTZVP-2018";
        protocol    "LVPP-18.07 GAMESS HF/TZVP; r_av 1.4 A; f_decay 3.57; d in A; sigma = q/a";
        source      "LVPP sigma-profile database release 18.07 (github.com/lvpp/sigma, asset HF_TZVP.zip, sha256 bd17aaeebb430641...), file VINYLACETYLENE.gout; MIT License, Copyright (c) 2017 LVPP; cite Ferrarini, Flores, Muniz & Soares, AIChE J. 64 (2018) 3443, doi:10.1002/aic.16194, and doi:10.5281/zenodo.3613786; identity: InChIKey WFYPICNXBKQZGB-UHFFFAOYSA-N (full match); formula C4H4; resolved by thirdParty/thermoml/identity.json (PubChem and CACTUS agree)";
        derivation  "segment areas, charges and the cavity volume are LVPP's (GAMESS HF/TZVP COSMO output); `area` is the sum of LVPP's segment areas as binned (GAMESS's printed cavity area agrees within its 2-decimal rounding); the 51-point profile is COMPUTED BY CHOUPO from LVPP's surface segments by bin/curate/lvpp_sigma_profile.py under the protocol above (Bell et al. 2020 Eq. 4 averaging, sigma = q/a, area split linearly between grid nodes)";
        licence     MIT;
        installed   true;
        area        104.432657;   // sum of the profile below; GAMESS prints 104.43
        volume      85.75;
        sigmaProfile  (
               0.000000     0.000000     0.000000     0.000000     0.000000     0.000000
               0.000000     0.000000     0.000000     0.000000     0.028051     0.600035
               0.904949     2.254734     1.060271     0.238818     2.345376     4.349908
               7.658021     4.450079     3.245999     5.795732     4.938604     3.387803
               3.493550     7.442290     6.154124     3.624792     6.782868     8.049094
              10.007896     4.699737     7.552179     5.255324     0.112423     0.000000
               0.000000     0.000000     0.000000     0.000000     0.000000     0.000000
               0.000000     0.000000     0.000000     0.000000     0.000000     0.000000
               0.000000     0.000000     0.000000
        );
    }
}
