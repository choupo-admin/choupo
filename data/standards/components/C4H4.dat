/*--------------------------------*- Choupo -*-----------------------*\
  Component: Vinylacetylene (C4 soot-growth intermediate)
  Generated by bin/import_nasa.py from NASA-7 polynomial data
  (BURCAT.THR).  No liquid phase at process conditions ---
  the entry is tagged `role nonvolatile;` so vapour-pressure routines
  never get called.  dHf_298 and s_298 from NASA-7 integration
  constants at T = 298.15 K.
\*---------------------------------------------------------------------------*/

name           C4H4;
formula        C4H4;
CAS            689-97-4;

MW             52.076;       // kg/kmol
role        nonvolatile;
tags           ( gasPhase combustion soot );

standardThermochemistry
{
    dHf_298    431719.5396;            // J/mol  -- ideal-gas reference
    s_298      251.0727;           // J/(mol·K)  -- third-law absolute
}

idealGasHeatCapacity
{
    model         polynomial;
    coefficients  (-4.611098e+00   2.542045e-01   -1.557073e-04   3.731179e-08);
    //  the window is the FIT's range (fit_cp_poly3, 250-1500 K).
    //  It used to say 3000: 1500 K of validity nobody regressed.
    Trange        (250  1500);
}

cosmo
{
    VT2005
    {
        model       COSMOSAC;
        variant     "2002";
        source      "VT-2005 sigma-profile database (Mullins et al., Ind. Eng. Chem. Res. 45 (2006) 4389; DFT-COSMO), file VT2005-0235-PROF.txt bundled in usnistgov/COSMOSAC; CAS 689-97-4";
        licence     externalRestricted;   // VT-2005: redistribution NOT confirmed -- values NOT shipped
        installed   false;                 // install your own copy: bin/choupo-import-cosmo (-> data/local/cosmo/VT2005/)
    }
    LVPP-HFTZVP-2018
    {
        model       COSMOSAC;
        variant     "LVPP-HFTZVP-2018";
        protocol    "LVPP-18.07 GAMESS HF/TZVP; r_av 1.4 A; f_decay 3.57; d in A; sigma = q/a";
        source      "LVPP sigma-profile database release 18.07 (github.com/lvpp/sigma, asset HF_TZVP.zip, sha256 bd17aaeebb430641...), file VINYLACETYLENE.gout; MIT License, Copyright (c) 2017 LVPP; cite Ferrarini, Flores, Muniz & Soares, AIChE J. 64 (2018) 3443, doi:10.1002/aic.16194, and doi:10.5281/zenodo.3613786; identity: InChIKey WFYPICNXBKQZGB-UHFFFAOYSA-N (full match); formula C4H4; resolved by thirdParty/thermoml/identity.json (PubChem and CACTUS agree)";
        derivation  "segment areas, charges and the cavity volume are LVPP's (GAMESS HF/TZVP COSMO output); `area` is the sum of LVPP's segment areas as binned (GAMESS's printed cavity area agrees within its 2-decimal rounding); the 51-point profile is COMPUTED BY CHOUPO from LVPP's surface segments by bin/curate/lvpp_sigma_profile.py under the protocol above (Bell et al. 2020 Eq. 4 averaging, sigma = q/a, area split linearly between grid nodes)";
        licence     MIT;
        installed   true;
        area        104.432657;   // sum of the profile below; GAMESS prints 104.43
        volume      85.75;
        sigmaProfile  (
               0.000000     0.000000     0.000000     0.000000     0.000000     0.000000
               0.000000     0.000000     0.000000     0.000000     0.028051     0.600035
               0.904949     2.254734     1.060271     0.238818     2.345376     4.349908
               7.658021     4.450079     3.245999     5.795732     4.938604     3.387803
               3.493550     7.442290     6.154124     3.624792     6.782868     8.049094
              10.007896     4.699737     7.552179     5.255324     0.112423     0.000000
               0.000000     0.000000     0.000000     0.000000     0.000000     0.000000
               0.000000     0.000000     0.000000     0.000000     0.000000     0.000000
               0.000000     0.000000     0.000000
        );
    }
}
