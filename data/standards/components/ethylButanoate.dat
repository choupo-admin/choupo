  AmbroseWalton block this tool writes (provenance.vaporPressure).
\*---------------------------------------------------------------------------*/

name        ethylButanoate;
CAS         105-54-4;
formula     C6H12O2;
reviewStatus autoPromoted;
review      { by none; }   // DEV.md 4c C300 rule 4 (C297): nobody has reviewed it
MW          116.1600;      // kg/kmol, from the formula (IUPAC standard atomic weights)
Tc          569.6;      // K, IUPAC recommended (provenance.Tc)
Pc          29;      // bar, IUPAC recommended (provenance.Pc)
omega       0.398830;      // [-] (provenance.omega)
//  Tb: NOT DECLARED -- the archive reports no boiling temperature at
//  101.3 kPa for it, and a Tb read back off the fitted Antoine would be
//  the curve tested against itself (the fitted normal boiling point is
//  in provenance.vaporPressure.acceptance.Tnb_fit).

standardThermochemistry
{
    dHf_298   -484450;        // J/mol, ideal gas, Joback ESTIMATE (provenance.dHf_298)
    s_298     441.01;        // J/(mol K), ideal gas, DERIVED from Joback (provenance.s_298)
}

vaporPressure
{
    model         Antoine;
    // log10(Psat [bar]) = A - B / (T[K] + C), FITTED by bin/choupo-curate vp to
    // measured vapour pressures -- see provenance.vaporPressure
    coefficients  (4.510140858  1596.041711  -39.7824879);
    Trange        (348.97  433);   // the fit's own span; outside it the engine announces the extrapolation
}

Vliq        1.314465e-04;      // m3/mol at 25 C, FITTED (provenance.Vliq)

idealGasHeatCapacity
{
    model         polynomial;
    // Cp [J/(mol K)] = a0 + a1 T + a2 T^2 + a3 T^3, Joback ESTIMATE
    coefficients  (22.843  0.51904  -2.080000e-04  3.100000e-09);
    Trange        (273  1000);
}

liquidHeatCapacity
{
    model         polynomial;
    // Cp [J/(mol K)] = a0 + a1 T + a2 T^2, Rowlinson-Bondi ESTIMATE (provenance.liquidHeatCapacity)
    coefficients  (198.5148853  -0.05424148717  0.0005396831362);
    Trange        (348.97  433);
}

