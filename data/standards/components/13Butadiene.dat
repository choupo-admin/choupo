    coefficients  (4.056342831  964.7417621  -30.643);
    Trange        (255.37  381);
}

Vliq        8.7985e-05;      // m3/mol at 25 C  [ChemSep eqno 105]
HvapTb      22428.8;      // J/mol at Tb  [ChemSep eqno 106]

idealGasHeatCapacity
{
    model         chemsepCp16;
    // Cp [J/(mol.K)] = A + exp(B/T + C + D T + E T^2)
    // ChemSep states J/(kmol.K); A and the exp are scaled to per-mole here.
    coefficients  (38.23849  -511.235  5.485624721  -0.000121482  4.39211e-08);
    Trange        (80  1500);
}

