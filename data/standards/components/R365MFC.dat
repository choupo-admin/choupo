/*--------------------------------*- Choupo -*-----------------------*\
  Component: R365MFC  (C4F5H5, CAS 406-58-6)
  PROPOSAL TIER -- UNVERIFIED.  Imported from CoolProp 7.2.0 (MIT);
  pure-fluid properties from the published reference EOS below.
  Reference EOS: Lemmon-JCED-2016-365227
  NOTE: formation properties (dHf, s_298) and group decompositions
  are NOT provided by CoolProp -> omitted here (a gap, not fabricated).
\*---------------------------------------------------------------------------*/

name        R365MFC;

//  Review state, MACHINE-READABLE (AP2, 2026-08-05).  This used to
//  live only in the banner above, which the parser discards -- so the
//  engine could not announce it and a run said nothing.
reviewStatus   interim;
reviewReason   importedFromCoolProp720_notCheckedAgainstPrimaries;
formula     C4F5H5;
CAS         406-58-6;

MW          148.0745;        // kg/kmol  [CoolProp]
Tc          460.0032;        // K        [CoolProp EOS]
Pc          32.66392;        // bar      [CoolProp EOS]
omega       0.37745;        // [-]      [CoolProp EOS]
Tb          313.3431;        // K  normal boiling [CoolProp]
HvapTb      27865.4;        // J/mol  at Tb     [CoolProp]
Vliq        1.1780e-04;        // m3/mol @298K     [CoolProp]

vaporPressure
{
    model         Antoine;
    // log10(Psat [bar]) = A - B / (T[K] + C)   -- fitted to CoolProp EOS
    coefficients  (4.25882   1154.69   -41.976);
    Trange        (239.50  450.80);
}

idealGasHeatCapacity
{
    model         polynomial;
    // Cp [J/(mol.K)] = a0 + a1 T + a2 T^2 + a3 T^3   -- fitted to CoolProp cp0
    coefficients  (33.2  0.453273  -0.000288752  6.80129e-08);
    Trange        (200  1000);
}

liquidHeatCapacity
{
    model         polynomial;
    // Cp_liq [J/(mol.K)]   -- fitted to CoolProp saturated-liquid cp
    coefficients  (183.294  -0.157346  0.000772277  -4.36639e-08);
    Trange        (244  313);
}

triplePoint
{
    T   239.0000;
    P   2478.4153;
}

standardThermochemistry
{
    dHf_298   -1.12394e+06;      // J/mol ideal-gas -- provenance: see the structured dHf_298 block below
    dGf_298   -985570;      // J/mol  ideal-gas [Joback]
    s_298     392.565;      // J/(mol*K) third-law [DERIVED: (dHf-dGf)/T + CODATA element S]
}

// UNIQUAC van der Waals volume r and surface area q: the sum of the
// record's own UNIFAC groups (1 CH3 + 1 CH2 + 1 CF3 + 1 CF2), R_k/Q_k of Hansen et al. 1991
// (DEV.md 4c C294; bin/curate/uniquac_rq_from_groups.py).
uniquac
{
    r   3.9920;
    q   3.6880;
}

groups { unifac ( { group CH3; count 1; } { group CH2; count 1; } { group CF3; count 1; } { group CF2; count 1; } ); joback ( { group CH3; count 1; } { group CH2; count 1; } { group C; count 2; } { group F; count 5; } ); }

surfaceTension
{
    A     0.04983352597;
    B     0;
    Tc    460.0032;
    n     1.096738047;
    Tmin  261.8;
    Tmax  308.31;
}

provenance
{
    uniquac
    {
        origin        definition;
        method        "sum of UNIFAC group R_k/Q_k: r = sum nu_k R_k = 3.9920, q = sum nu_k Q_k = 3.6880 over the record's unifac groups (1 CH3 + 1 CH2 + 1 CF3 + 1 CF2)";
        citation      "R_k and Q_k of Hansen, Rasmussen, Fredenslund, Schiller & Gmehling, Ind. Eng. Chem. Res. 30 (1991) 2352, as tabulated in data/standards/parameters/UNIFAC/groups.dat; the group sum of Fredenslund, Jones & Prausnitz, AIChE J. 21 (1975) 1086";
    }
    dHf_298
    {
        origin           estimated;
        method           "Joback";
        methodVersion    "joback-poling5e-table2-2";
        input            joback;
        inputFingerprint "C:2,CH2:1,CH3:1,F:5";
        uncertainty      { status unquantified; reason "bulk-import band ~9 kJ/mol, primary basis not verified"; }
    }

    constants      "CoolProp 7.2.0 -- Lemmon-JCED-2016-365227";
    vaporPressure  "Antoine fitted to CoolProp EOS saturation, AAD 0.60%";
    idealGasCp     "polynomial fitted to CoolProp cp0, maxerr 2.09%";
    liquidCp       "polynomial fitted to CoolProp sat-liquid cp, maxerr 0.00%";
    triplePoint    "CoolProp reference EOS triple-point T,P";
    preserved      "from prior proposal (NOT CoolProp): standardThermochemistry, groups";
    surfaceTension
    {
        origin        fitted;
        method        "least squares on ln sigma of sigma/(N/m) = A tau^n, tau = 1 - T/Tc (A, n; B = 0; Tc the record's own), then the largest relative error minimised; every laboratory the archive holds for the pure liquid at <= 200 kPa; points beyond 15 % after the first stage discarded by name";
        fittedBy      "bin/curate/transport_fit.py";
        reviewStatus  autoPromoted;
        review        { by none; }   // DEV.md 4c C300 rule 4: nobody has reviewed it
        fitGrade      warning;   // DEV.md 4c C285 limits 5 / 10 / 20 % on the max relative error
        fitGradeBasis inSample;   // DEV.md 4c C300 rule 1
        fitGradeCap   ( singleLaboratory );   // DEV.md 4c C300 rule 2
        fitGradeMaxRelativeError_pct 0.835301;
        Trange        (261.8 308.31);   // K, the kept points -- outside it the engine announces an extrapolation
        reviewReason  "regressed by a machine from archive-transcribed measurements; not yet read back against the articles";
        reuse         "Choupo's own regression; the measured points belong to the cited articles and are not reproduced in this record or this tree (DEV.md 4c C328)";
        evidence
        (
                { doi "10.1021/je4004542"; articleSha256 "a23ed110c883d5a55e2dafe76be0de2b8b4bef998839603fe0e27f935f169fe0"; pointsKept 20; pointsDropped 0; provenance measured; }
        );
        acceptance
        {
            verdict     accepted;
            studies     1;
            pointsKept  20;
            pointsDropped 0;
            dropped     "none";
            aad_pct     0.412071;
            max_pct     0.835301;
        }
    }
}
