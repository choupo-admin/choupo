}

vaporPressure
{
    model         Antoine;
    // log10(Psat [bar]) = A - B / (T[K] + C)
    // converted EXACTLY from ChemSep eqno 10, Psat[Pa] = exp(a - b/(T+c))
    coefficients  (4.341240011  1601.808338  -56.603);
    Trange        (364.15  535.33);
}

Vliq        0.000140259;      // m3/mol at 25 C  [ChemSep eqno 105]
HvapTb      38954.8;      // J/mol at Tb  [ChemSep eqno 106]

idealGasHeatCapacity
{
    model         chemsepCp16;
    // Cp [J/(mol.K)] = A + exp(B/T + C + D T + E T^2)
    // ChemSep states J/(kmol.K); A and the exp are scaled to per-mole here.
    coefficients  (131.66  -858.87  6.688244721  -0.00041213  8.8955e-08);
    Trange        (200  1500);
}

liquidHeatCapacity
{
    model         chemsepCp16;
    // Cp [J/(mol.K)] = A + exp(B/T + C + D T + E T^2)
    coefficients  (200.22  128.23  0.566244721  0.012008  -8.0423e-06);
    Trange        (229.8  462.75);
}

