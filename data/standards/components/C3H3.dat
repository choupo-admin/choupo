/*--------------------------------*- Choupo -*-----------------------*\
  Component: PROPARGYL radical -- THE soot gateway (C3H3 + C3H3 -> benzene ring)
  Ideal-gas formation data and heat capacity READ from
  NASA/TP-2002-211556 (McBride, Zehe & Gordon 2002, "NASA Glenn
  Coefficients for Calculating Thermodynamic Properties of Individual
  Species"), a US government work in the public domain: entry
  "C3H3,2-propynl", appendix D p. 94 (dHf_298 and the NASA-9 Cp coefficients,
  as printed) and Table B1 p. 16 (s_298).  The report's own sources
  for this species: TRC(4/98) tuvw3140.
  No liquid phase at process conditions -- the entry is tagged
  `role nonvolatile;` so vapour-pressure routines never get called.
  Re-sourced 2026-11-12 (DEV.md 4c C335) by
  bin/curate/nasa_tp2002_to_choupo.py from the NonCommercial compilation
  this record was first generated from (its old numbers
  are not kept here: they were that compilation's); not yet read back by
  a curator.
  IDENTITY: this record names PROPARGYL (2-propynyl, HCCCH2), the report's
  entry `C3H3,2-propynl`.  The value the record held before was not
  propargyl's -- it belongs to a 1-propynyl-type isomer --
  so the change of number is a correction of identity as well as of source.
\*---------------------------------------------------------------------------*/

name           C3H3;
formula        C3H3;
CAS            n/a;        // radical registry number: pending curation

MW             39.057;       // kg/kmol
role        nonvolatile;
tags           ( radical gasPhase combustion soot );
reviewStatus   interim;
reviewReason   "transcribed by machine from NASA/TP-2002-211556 and checked against the report itself; not yet read back against the page by a curator";

standardThermochemistry
{
    dHf_298    331800.000;   // J/mol  -- ideal gas; NASA/TP-2002-211556 appendix D, p. 94, entry C3H3,2-propynl
    s_298      254.520;     // J/(mol·K) -- third-law absolute; Table B1, p. 16
}

idealGasHeatCapacity
{
    //  NASA/TP-2002-211556 eq. (1), Cp/R = a1/T^2 + a2/T + a3 + a4 T + a5 T^2
    //  + a6 T^3 + a7 T^4; appendix D, p. 94, entry C3H3,2-propynl, a1..a7 as printed.
    model    NASA9;
    Tlow     200;
    Tcommon  1000;
    Thigh    6000;
    low      ( 6.188578320e+04 -8.909578670e+02 6.347558820e+00 1.633173115e-02 -1.949975695e-05 1.417349778e-08 -4.199866320e-12 );
    high     ( 2.989723833e+06 -1.118954446e+04 2.222225052e+01 -2.068106902e-03 4.121883640e-07 -4.438980590e-11 1.970824701e-15 );
}

provenance
{
    dHf_298
    {
        origin        literature;
        method        "NASA/TP-2002-211556 appendix D, p. 94, entry C3H3,2-propynl, record-line H(298.15) (elements reference, so = dHf)";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "Table B1 p. 16 prints 331.8 kJ/mol; the report's own sources: TRC(4/98) tuvw3140.";
    }
    s_298
    {
        origin        literature;
        method        "NASA/TP-2002-211556 Table B1, p. 16, entry C3H3,2-propynl";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "appendix D's coefficients with b2 integrate to 254.520";
    }
    idealGasHeatCapacity
    {
        origin        literature;
        method        "NASA/TP-2002-211556 appendix D, p. 94, entry C3H3,2-propynl, a1..a7 of the 200-1000 K and 1000-6000 K intervals, as printed";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "read by bin/curate/nasa_tp2002_to_choupo.py, which holds H and S at 298.15 K to the printed values";
    }
    source   "McBride, Zehe & Gordon, NASA Glenn Coefficients for Calculating Thermodynamic Properties of Individual Species, NASA/TP-2002-211556 (2002)";
    licence  publicDomain;    // US government work (NASA), 17 U.S.C. 105
}
