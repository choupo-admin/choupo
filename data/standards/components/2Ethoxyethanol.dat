formula     C4H10O2;
reviewStatus autoPromoted;
humanReviewed false;
MW          90.1220;      // kg/kmol, from the formula (IUPAC standard atomic weights)
Tc          598.9;      // K, measured (provenance.Tc)
Pc          42;      // bar, measured (provenance.Pc)
omega       0.414582;      // [-] (provenance.omega)
Tb          408.405;      // K, measured (provenance.Tb)

standardThermochemistry
{
    dHf_298   -410340;        // J/mol, ideal gas, Joback ESTIMATE (provenance.dHf_298)
    s_298     373.98;        // J/(mol K), ideal gas, DERIVED from Joback (provenance.s_298)
}

vaporPressure
{
