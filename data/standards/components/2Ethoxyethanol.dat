uniquac
{
    r   3.6981;
    q   3.2920;
}

groups
{
    unifac ( { group CH3; count 1; } { group CH2; count 1; } { group C2H5O2; count 1; } );
    joback ( { group CH3; count 1; } { group CH2; count 3; } { group ether; count 1; } { group OH; count 1; } );
}

