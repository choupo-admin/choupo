    coefficients  (54.03197569  182574.837  2972.884655);
    Trange        (345.63  407.95);   // the fit's own span; outside it the engine announces the extrapolation
}

Vliq        9.693207e-05;      // m3/mol at 25 C, FITTED (provenance.Vliq)

idealGasHeatCapacity
{
    model         polynomial;
    // Cp [J/(mol K)] = a0 + a1 T + a2 T^2 + a3 T^3, Joback ESTIMATE
    coefficients  (30.043  0.35462  -1.132000e-04  -8.600000e-09);
    Trange        (273  1000);
}

liquidHeatCapacity
{
    model         polynomial;
    // Cp [J/(mol K)] = a0 + a1 T + a2 T^2, FITTED (provenance.liquidHeatCapacity)
    coefficients  (161.6216174  -0.01954859235  0.0006218279579);
    Trange        (275.15  339.15);
}

