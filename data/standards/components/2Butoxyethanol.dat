\*---------------------------------------------------------------------------*/

name        2Butoxyethanol;
CAS         111-76-2;
formula     C6H14O2;
reviewStatus autoPromoted;
humanReviewed false;
MW          118.1760;      // kg/kmol, from the formula (IUPAC standard atomic weights)
Tc          612.827;      // K, Joback ESTIMATE (provenance.Tc)
Pc          33.8414;      // bar, Joback ESTIMATE (provenance.Pc)
omega       0.739668;      // [-] (provenance.omega)
Tb          451.48;      // K, Joback ESTIMATE (provenance.Tb)

standardThermochemistry
{
    dHf_298   -451620;        // J/mol, ideal gas, Joback ESTIMATE (provenance.dHf_298)
    s_298     451.89;        // J/(mol K), ideal gas, DERIVED from Joback (provenance.s_298)
}

vaporPressure
{
    model         Antoine;
    // log10(Psat [bar]) = A - B / (T[K] + C), FITTED by bin/choupo-curate vp to
    // measured vapour pressures -- see provenance.vaporPressure
    coefficients  (5.411570096  2180.159699  -41.17339503);
    Trange        (406.8  442.49);   // the fit's own span; outside it the engine announces the extrapolation
}

Vliq        1.305423e-04;      // m3/mol at 25 C, FITTED (provenance.Vliq)

idealGasHeatCapacity
{
    model         polynomial;
    // Cp [J/(mol K)] = a0 + a1 T + a2 T^2 + a3 T^3, Joback ESTIMATE
    coefficients  (28.225  0.54462  -2.220000e-04  1.520000e-08);
    Trange        (273  1000);
}

liquidHeatCapacity
{
    model         polynomial;
    // Cp [J/(mol K)] = a0 + a1 T + a2 T^2, FITTED (provenance.liquidHeatCapacity)
    coefficients  (139.158894  0.4012666775  0.0001597730746);
    Trange        (275.15  339.15);
}

