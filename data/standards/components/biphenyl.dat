// UNIQUAC van der Waals volume r and surface area q: the sum of the
// record's own UNIFAC groups (2 AC + 10 ACH), R_k/Q_k of Hansen et al. 1991
// (DEV.md 4c C294; bin/curate/uniquac_rq_from_groups.py).
uniquac
{
    r   6.0434;
    q   4.2400;
}

groups
{
    unifac ( { group AC; count 2; } { group ACH; count 10; } );   // derived from structure c1ccccc1(c2ccccc2) by bin/curate/unifac_groups.py
}

