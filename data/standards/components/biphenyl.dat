name        biphenyl;
CAS         92-52-4;
formula     C12H10;      // counted from the ChemSep v8.3 structure formula "(C6H5)2" (derived 2026-09-03; reproduces MW to 0.003 %)
reviewStatus interim;
MW          154.2078;      // kg/kmol [origin=ChemSep v8.3]
Tc          780;      // K [origin=ChemSep v8.3]
Pc          38.4727;      // bar; source Pa / 1e5 [origin=ChemSep v8.3]
omega       0.3643;      // [-] [origin=ChemSep v8.3]
Tb          528.15;      // K [origin=ChemSep v8.3]

standardThermochemistry
{
    dHf_298   182088;        // J/mol   [ChemSep v8.3, ideal gas]
    s_298     392.668;        // J/(mol.K)  third-law absolute
}

vaporPressure
{
    model         Antoine;
    // log10(Psat [bar]) = A - B / (T[K] + C)
    // converted EXACTLY from ChemSep eqno 10, Psat[Pa] = exp(a - b/(T+c))
    coefficients  (4.068503077  1747.861572  -97.95);
    Trange        (474.02  707.15);
}

Vliq        0.000150742;      // m3/mol at 25 C  [ChemSep eqno 105]
HvapTb      47686.8;      // J/mol at Tb  [ChemSep eqno 106]

idealGasHeatCapacity
{
    model         chemsepCp16;
    // Cp [J/(mol.K)] = A + exp(B/T + C + D T + E T^2)
    // ChemSep states J/(kmol.K); A and the exp are scaled to per-mole here.
    coefficients  (79.583  -635.84  6.666244721  -0.00034935  9.291e-08);
    Trange        (200  1500);
}

liquidHeatCapacity
{
    model         chemsepCp16;
    // Cp [J/(mol.K)] = A + exp(B/T + C + D T + E T^2)
    coefficients  (24.132  -12.395  4.677244721  0.0029407  -1.4331e-06);
    Trange        (342.2  623.15);
}

