/*--------------------------------*- Choupo -*-----------------------*\
  Component: Acetyl radical (acetaldehyde oxidation)
  Ideal-gas formation data and heat capacity READ from
  NASA/TP-2002-211556 (McBride, Zehe & Gordon 2002, "NASA Glenn
  Coefficients for Calculating Thermodynamic Properties of Individual
  Species"), a US government work in the public domain: entry
  "CH3CO,acetyl", appendix D p. 91 (dHf_298 and the NASA-9 Cp coefficients,
  as printed) and Table B1 p. 15 (s_298).  The report's own sources
  for this species: Radical. Hf:Niiranen,1992. Nimlos,1989.
  No liquid phase at process conditions -- the entry is tagged
  `role nonvolatile;` so vapour-pressure routines never get called.
  Re-sourced 2026-11-12 (DEV.md 4c C335) by
  bin/curate/nasa_tp2002_to_choupo.py from the NonCommercial compilation
  this record was first generated from (its old numbers
  are not kept here: they were that compilation's); not yet read back by
  a curator.
  IDENTITY: the report's entry `CH3CO,acetyl`.
\*---------------------------------------------------------------------------*/

name           CH3CO;
formula        CH3CO;
CAS            n/a;        // radical registry number: pending curation

MW             43.045;       // kg/kmol
role        nonvolatile;
tags           ( radical gasPhase combustion lowT );
reviewStatus   interim;
reviewReason   "transcribed by machine from NASA/TP-2002-211556 and checked against the report itself; not yet read back against the page by a curator";

standardThermochemistry
{
    dHf_298    -10000.000;   // J/mol  -- ideal gas; NASA/TP-2002-211556 appendix D, p. 91, entry CH3CO,acetyl
    s_298      270.320;     // J/(mol·K) -- third-law absolute; Table B1, p. 15
}

idealGasHeatCapacity
{
    //  NASA/TP-2002-211556 eq. (1), Cp/R = a1/T^2 + a2/T + a3 + a4 T + a5 T^2
    //  + a6 T^3 + a7 T^4; appendix D, p. 91, entry CH3CO,acetyl, a1..a7 as printed.
    model    NASA9;
    Tlow     200;
    Tcommon  1000;
    Thigh    6000;
    low      ( -7.193894130e+04 1.464465167e+03 -6.632276130e+00 4.108468380e-02 -4.226256640e-05 2.485766819e-08 -6.292558480e-12 );
    high     ( 2.485388150e+06 -1.120714204e+04 2.277525438e+01 -2.314260550e-03 4.536189170e-07 -4.742635550e-11 2.044663903e-15 );
}

provenance
{
    dHf_298
    {
        origin        literature;
        method        "NASA/TP-2002-211556 appendix D, p. 91, entry CH3CO,acetyl, record-line H(298.15) (elements reference, so = dHf)";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "Table B1 p. 15 prints -10.0 kJ/mol; the report's own sources: Radical. Hf:Niiranen,1992. Nimlos,1989.";
    }
    s_298
    {
        origin        literature;
        method        "NASA/TP-2002-211556 Table B1, p. 15, entry CH3CO,acetyl";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "appendix D's coefficients with b2 integrate to 270.320";
    }
    idealGasHeatCapacity
    {
        origin        literature;
        method        "NASA/TP-2002-211556 appendix D, p. 91, entry CH3CO,acetyl, a1..a7 of the 200-1000 K and 1000-6000 K intervals, as printed";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "read by bin/curate/nasa_tp2002_to_choupo.py, which holds H and S at 298.15 K to the printed values";
    }
    source   "McBride, Zehe & Gordon, NASA Glenn Coefficients for Calculating Thermodynamic Properties of Individual Species, NASA/TP-2002-211556 (2002)";
    licence  publicDomain;    // US government work (NASA), 17 U.S.C. 105
}
