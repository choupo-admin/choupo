name        indane;
CAS         496-11-7;
formula     C9H10;      // counted from the ChemSep v8.3 structure formula "C6H4(CH2)3" (derived 2026-09-03; reproduces MW to 0.003 %)
reviewStatus interim;
MW          118.1757;      // kg/kmol [origin=ChemSep v8.3]
Tc          684.9;      // K [origin=ChemSep v8.3]
Pc          39.5;      // bar; source Pa / 1e5 [origin=ChemSep v8.3]
omega       0.309213;      // [-] [origin=ChemSep v8.3]
Tb          451;      // K [origin=ChemSep v8.3]

standardThermochemistry
{
    dHf_298   60700;        // J/mol   [ChemSep v8.3, ideal gas]
    s_298     348.91;        // J/(mol.K)  third-law absolute
}

vaporPressure
{
    model         Antoine;
    // log10(Psat [bar]) = A - B / (T[K] + C)
    // converted EXACTLY from ChemSep eqno 10, Psat[Pa] = exp(a - b/(T+c))
    coefficients  (4.210517372  1657.832326  -56.866);
    Trange        (412  611.77);
}

Vliq        0.000123138;      // m3/mol at 25 C  [ChemSep eqno 105]
HvapTb      39730.3;      // J/mol at Tb  [ChemSep eqno 106]

idealGasHeatCapacity
{
    model         chemsepCp16;
    // Cp [J/(mol.K)] = A + exp(B/T + C + D T + E T^2)
    // ChemSep states J/(kmol.K); A and the exp are scaled to per-mole here.
    coefficients  (60.321  -643.06  6.429244721  -0.00018807  3.6677e-08);
    Trange        (200  1500);
}

liquidHeatCapacity
{
    model         chemsepCp16;
    // Cp [J/(mol.K)] = A + exp(B/T + C + D T + E T^2)
    coefficients  (136.38  -29.478  1.153044721  0.01305  -1.0993e-05);
    Trange        (221.74  451.12);
}

liquidViscosity
{
    chemsepEq101
    {
        A     -151.95;
        B     6810.2;
        C     21.863;
        D     -2.342e-05;
        E     2;
        Tmin  221.74;
        Tmax  547.92;
    }
}

liquidThermalConductivity
{
    chemsepEq16
    {
        A     -0.041318;
        B     5.7098;
        C     -1.5369;
        D     -0.00043639;
        E     -1.0195e-06;
        Tmin  221.74;
        Tmax  451.12;
    }
}

// UNIQUAC van der Waals volume r and surface area q: the sum of the
// record's own UNIFAC groups (1 CH2 + 4 ACH + 2 ACCH2), R_k/Q_k of Hansen et al. 1991
// (DEV.md 4c C294; bin/curate/uniquac_rq_from_groups.py).
uniquac
{
    r   4.8788;
    q   3.4600;
}

groups
{
    unifac ( { group CH2; count 1; } { group ACH; count 4; } { group ACCH2; count 2; } );
}
solubilityParameter 19420;   // Pa^0.5  [ANCHOR, ChemSep v8.3 -- checked against, never used]

