// UNIQUAC van der Waals volume r and surface area q: the sum of the
// record's own UNIFAC groups (6 CH3 + 1 CH2 + 2 C), R_k/Q_k of Hansen et al. 1991
// (DEV.md 4c C294; bin/curate/uniquac_rq_from_groups.py).
uniquac
{
    r   6.5200;
    q   5.6280;
}

groups
{
    unifac ( { group CH3; count 6; } { group CH2; count 1; } { group C; count 2; } );
}
