// UNIQUAC van der Waals volume r and surface area q: the sum of the
// record's own UNIFAC groups (5 ACH + 1 ACNO2), R_k/Q_k of Hansen et al. 1991
// (DEV.md 4c C294; bin/curate/uniquac_rq_from_groups.py).
uniquac
{
    r   4.0764;
    q   3.1040;
}

groups
{
    unifac ( { group ACH; count 5; } { group ACNO2; count 1; } );   // derived from structure c1(N(=O)=O)ccccc1 by bin/curate/unifac_groups.py
}

//  HANSEN solubility-parameter triple (DEV.md 4c C428; read by `hansenMixture`
//  and the Explorer's solvent lens).  Hansen 1969, Table I row N06 "Nitrobenzene":
//  delta_d = 8.60, delta_p = 6.0, delta_h = 2.0 (cal/cm3)^0.5, x sqrt(4.184e6) = 2045.4828.
hansen
{
    dD    17591.2;        // Pa^0.5   = 8.60 (cal/cm3)^0.5, Table I row N06
    dP    12272.9;        // Pa^0.5   = 6.0
    dH    4091.0;        // Pa^0.5   = 2.0
    Tref  298.15 K;       // adopted: the paper prints no temperature beside Table I
}

