  Vliq, liquid Cp.  DERIVED: omega (from the fitted vapour pressure at the ESTIMATED Tc).
  ESTIMATED (Joback): Tc, Pc, ideal-gas Cp, dHf_298; s_298 derived from Joback's
  dHf and dGf.  No measured series is reproduced here.
  reviewStatus autoPromoted, humanReviewed false: NO human has read it back.
  Psat: fitted by `bin/choupo-curate vp`; its promotion replaced the
  AmbroseWalton block this tool writes (provenance.vaporPressure).
\*---------------------------------------------------------------------------*/

name        methylHeptanoate;
CAS         106-73-0;
formula     C8H16O2;
reviewStatus autoPromoted;
humanReviewed false;
MW          144.2140;      // kg/kmol, from the formula (IUPAC standard atomic weights)
Tc          612.603894;      // K, Joback ESTIMATE (provenance.Tc)
Pc          25.4818555;      // bar, Joback ESTIMATE (provenance.Pc)
omega       0.573501;      // [-] (provenance.omega)
Tb          443.63;      // K, measured (provenance.Tb)

standardThermochemistry
{
    dHf_298   -525730;        // J/mol, ideal gas, Joback ESTIMATE (provenance.dHf_298)
    s_298     518.92;        // J/(mol K), ideal gas, DERIVED from Joback (provenance.s_298)
}

vaporPressure
{
    model         Antoine;
    // log10(Psat [bar]) = A - B / (T[K] + C), FITTED by bin/choupo-curate vp to
    // measured vapour pressures -- see provenance.vaporPressure
    coefficients  (4.356233137  1614.767089  -71.85000567);
    Trange        (278.1  443.94);   // the fit's own span; outside it the engine announces the extrapolation
}

Vliq        1.635873e-04;      // m3/mol at 25 C, FITTED (provenance.Vliq)

idealGasHeatCapacity
{
    model         polynomial;
    // Cp [J/(mol K)] = a0 + a1 T + a2 T^2 + a3 T^3, Joback ESTIMATE
    coefficients  (21.025  0.70904  -3.168000e-04  2.690000e-08);
    Trange        (273  1000);
}

liquidHeatCapacity
{
    model         polynomial;
    // Cp [J/(mol K)] = a0 + a1 T + a2 T^2, FITTED (provenance.liquidHeatCapacity)
    coefficients  (242.6612273  -0.0486523822  0.0006649555115);
    Trange        (303.15  373.15);
}

groups
{
    joback ( { group CH3; count 2; } { group CH2; count 5; } { group ester; count 1; } );
}

