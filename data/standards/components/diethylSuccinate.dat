// (DEV.md 4c C294; bin/curate/uniquac_rq_from_groups.py).
uniquac
{
    r   6.5038;
    q   5.6160;
}

groups
{
    unifac ( { group CH3; count 2; } { group CH2; count 2; } { group CH2COO; count 2; } );
    joback ( { group CH3; count 2; } { group CH2; count 4; } { group ester; count 2; } );
}

