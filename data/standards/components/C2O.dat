/*--------------------------------*- Choupo -*-----------------------*\
  Component: Dicarbon monoxide radical (ketenyl decomposition)
  Ideal-gas formation data and heat capacity READ from
  NASA/TP-2002-211556 (McBride, Zehe & Gordon 2002, "NASA Glenn
  Coefficients for Calculating Thermodynamic Properties of Individual
  Species"), a US government work in the public domain: entry
  "C2O", appendix D p. 93 (dHf_298 and the NASA-9 Cp coefficients,
  as printed) and Table B1 p. 16 (s_298).  The report's own sources
  for this species: Hf:Gurvich,1991 pt1 p31. Jacox,1998.
  No liquid phase at process conditions -- the entry is tagged
  `role nonvolatile;` so vapour-pressure routines never get called.
  Re-sourced 2026-11-12 (DEV.md 4c C335) by
  bin/curate/nasa_tp2002_to_choupo.py from the NonCommercial compilation
  this record was first generated from (its old numbers
  are not kept here: they were that compilation's); not yet read back by
  a curator.
  THE OLD VALUE AND THE REPORT DISAGREE, and the report's is the older
  number: the report prints dHf_298 = 291.04 kJ/mol (from Gurvich 1991),
  about 88 kJ/mol below the value the record held, and modern network
  determinations sit near the old value.  The report is the only
  redistributable source in hand, so its value stands here, marked interim with that reason; a
  curator with a clean modern primary should replace it.  No shipped case
  reads this record (measured 2026-11-12).
\*---------------------------------------------------------------------------*/

name           C2O;
formula        C2O;
CAS            n/a;        // radical registry number: pending curation

MW             40.021;       // kg/kmol
role        nonvolatile;
tags           ( radical gasPhase combustion );
reviewStatus   interim;
reviewReason   "NASA/TP-2002-211556's dHf_298 (291.04 kJ/mol, Gurvich 1991) is about 88 kJ/mol below the value this record held and below modern network determinations; the report's value is kept as the only redistributable one in hand -- replace it from a clean modern primary";

standardThermochemistry
{
    dHf_298    291038.666;   // J/mol  -- ideal gas; NASA/TP-2002-211556 appendix D, p. 93, entry C2O
    s_298      233.624;     // J/(mol·K) -- third-law absolute; Table B1, p. 16
}

idealGasHeatCapacity
{
    //  NASA/TP-2002-211556 eq. (1), Cp/R = a1/T^2 + a2/T + a3 + a4 T + a5 T^2
    //  + a6 T^3 + a7 T^4; appendix D, p. 93, entry C2O, a1..a7 as printed.
    model    NASA9;
    Tlow     200;
    Tcommon  1000;
    Thigh    6000;
    low      ( -3.959929420e+03 -1.117516348e+02 4.593960060e+00 3.710602020e-03 -7.014760180e-07 -1.371129839e-09 7.123854000e-13 );
    high     ( -6.348056590e+05 1.184133091e+03 4.879173340e+00 1.757538773e-03 -3.957552270e-07 3.989179940e-11 -1.546043135e-15 );
}

provenance
{
    dHf_298
    {
        origin        literature;
        method        "NASA/TP-2002-211556 appendix D, p. 93, entry C2O, record-line H(298.15) (elements reference, so = dHf)";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "Table B1 p. 16 prints 291.039 kJ/mol; the report's own sources: Hf:Gurvich,1991 pt1 p31. Jacox,1998.";
    }
    s_298
    {
        origin        literature;
        method        "NASA/TP-2002-211556 Table B1, p. 16, entry C2O";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "appendix D's coefficients with b2 integrate to 233.624";
    }
    idealGasHeatCapacity
    {
        origin        literature;
        method        "NASA/TP-2002-211556 appendix D, p. 93, entry C2O, a1..a7 of the 200-1000 K and 1000-6000 K intervals, as printed";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "read by bin/curate/nasa_tp2002_to_choupo.py, which holds H and S at 298.15 K to the printed values";
    }
    source   "McBride, Zehe & Gordon, NASA Glenn Coefficients for Calculating Thermodynamic Properties of Individual Species, NASA/TP-2002-211556 (2002)";
    licence  publicDomain;    // US government work (NASA), 17 U.S.C. 105
}
