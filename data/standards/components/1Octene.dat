}

vaporPressure
{
    model         Antoine;
    // log10(Psat [bar]) = A - B / (T[K] + C)
    // converted EXACTLY from ChemSep eqno 10, Psat[Pa] = exp(a - b/(T+c))
    coefficients  (3.996844487  1316.954587  -64.529);
    Trange        (340.25  504.46);
}

Vliq        0.000157458;      // m3/mol at 25 C  [ChemSep eqno 105]
HvapTb      33807.5;      // J/mol at Tb  [ChemSep eqno 106]

idealGasHeatCapacity
{
    model         chemsepCp16;
    // Cp [J/(mol.K)] = A + exp(B/T + C + D T + E T^2)
    // ChemSep states J/(kmol.K); A and the exp are scaled to per-mole here.
    coefficients  (106.43  -593.77  6.246244721  6.689e-05  -2.6274e-08);
    Trange        (200  1500);
}

liquidHeatCapacity
{
    model         chemsepCp16;
    // Cp [J/(mol.K)] = A + exp(B/T + C + D T + E T^2)
    coefficients  (-24.253  87.834  4.442244721  0.0032002  -1.2467e-06);
    Trange        (171  454);
}

