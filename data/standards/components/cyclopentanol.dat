/*--------------------------------*- Choupo -*-----------------------*\
  Component: cyclopentanol  (cyclopentanol; CAS 96-41-3)
  NEW in the catalogue (DEV.md 4c C292, slice 2 of C287, 2026-11-10), built by
  bin/curate/c287_new_components.py from measurements the NIST/TRC ThermoML Archive
  locates (the articles are the sources; their DOIs are in provenance).
  MEASURED: Tb.  FITTED: vapour pressure (bin/choupo-curate vp),
  Vliq, liquid Cp.  DERIVED: omega (from the fitted vapour pressure at the ESTIMATED Tc).
  ESTIMATED (Joback): Tc, Pc, ideal-gas Cp, dHf_298; s_298 derived from Joback's
  dHf and dGf.  No measured series is reproduced here.
  reviewStatus autoPromoted, humanReviewed false: NO human has read it back.
  Psat: fitted by `bin/choupo-curate vp`; its promotion replaced the
  AmbroseWalton block this tool writes (provenance.vaporPressure).
\*---------------------------------------------------------------------------*/

name        cyclopentanol;
CAS         96-41-3;
formula     C5H10O;
reviewStatus autoPromoted;
humanReviewed false;
MW          86.1340;      // kg/kmol, from the formula (IUPAC standard atomic weights)
Tc          610.875506;      // K, Joback ESTIMATE (provenance.Tc)
Pc          49.1768774;      // bar, Joback ESTIMATE (provenance.Pc)
omega       0.484120;      // [-] (provenance.omega)
Tb          413.38;      // K, measured (provenance.Tb)

standardThermochemistry
{
    dHf_298   -238280;        // J/mol, ideal gas, Joback ESTIMATE (provenance.dHf_298)
    s_298     351.24;        // J/(mol K), ideal gas, DERIVED from Joback (provenance.s_298)
}

vaporPressure
{
    model         Antoine;
    // log10(Psat [bar]) = A - B / (T[K] + C), FITTED by bin/choupo-curate vp to
    // measured vapour pressures -- see provenance.vaporPressure
    coefficients  (5.014603075  1711.885528  -71.4865906);
    Trange        (279.84  413.4);   // the fit's own span; outside it the engine announces the extrapolation
}

Vliq        9.099362e-05;      // m3/mol at 25 C, FITTED (provenance.Vliq)

idealGasHeatCapacity
{
    model         polynomial;
    // Cp [J/(mol K)] = a0 + a1 T + a2 T^2 + a3 T^3, Joback ESTIMATE
    coefficients  (-56.85  0.6445  -4.060000e-04  9.760000e-08);
    Trange        (273  1000);
}

liquidHeatCapacity
{
    model         polynomial;
    // Cp [J/(mol K)] = a0 + a1 T + a2 T^2, FITTED (provenance.liquidHeatCapacity)
    coefficients  (48.19654923  0.08305458329  0.001230878008);
    Trange        (265.06  357.78);
}

groups
{
    unifac ( { group CH2; count 4; } { group CH; count 1; } { group OH; count 1; } );
    joback ( { group rCH2; count 4; } { group rCH; count 1; } { group OH; count 1; } );
}

liquidViscosity
{
    chemsepEq101
    {
        A     -37.07829218;
        B     4201.100764;
        C     3.219160347;
        D     0;
        E     0;
        Tmin  293.15;
        Tmax  373.15;
    }
}

