uniquac
{
    r   4.7437;
    q   4.0960;
}

groups
{
    unifac ( { group CH3; count 2; } { group CH2; count 3; } { group CH2O; count 1; } );
    joback ( { group CH3; count 2; } { group CH2; count 4; } { group ether; count 1; } );
}

