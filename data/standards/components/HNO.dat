/*--------------------------------*- Choupo -*-----------------------*\
  Component: Nitroxyl (HNO; NOx recombination chemistry)
  Ideal-gas formation data and heat capacity READ from
  NASA/TP-2002-211556 (McBride, Zehe & Gordon 2002, "NASA Glenn
  Coefficients for Calculating Thermodynamic Properties of Individual
  Species"), a US government work in the public domain: entry
  "HNO", appendix D p. 129 (dHf_298 and the NASA-9 Cp coefficients,
  as printed) and Table B1 p. 21 (s_298).  The report's own sources
  for this species: Gurvich,1989 pt1 p362 pt2 p227. Jacox,1998 p151.
  No liquid phase at process conditions -- the entry is tagged
  `role nonvolatile;` so vapour-pressure routines never get called.
  Transcribed 2026-10-25 by bin/curate/nasa_tp2002_to_choupo.py (DEV.md
  4c C164), which holds H and S at 298.15 K recomputed from the printed
  coefficients to the printed values; not yet read back by a curator.
\*---------------------------------------------------------------------------*/

name           HNO;
formula        HNO;
CAS            n/a;        // radical registry number: pending curation

MW             31.014;       // kg/kmol
role        nonvolatile;
tags           ( radical gasPhase combustion );
reviewStatus   interim;
reviewReason   "transcribed by machine from NASA/TP-2002-211556 and checked against the report itself; not yet read back against the page by a curator";

standardThermochemistry
{
    dHf_298    102032.725;   // J/mol  -- ideal gas; NASA/TP-2002-211556 appendix D, p. 129, entry HNO
    s_298      220.920;     // J/(mol·K) -- third-law absolute; Table B1, p. 21
}

idealGasHeatCapacity
{
    //  NASA/TP-2002-211556 eq. (1), Cp/R = a1/T^2 + a2/T + a3 + a4 T + a5 T^2
    //  + a6 T^3 + a7 T^4; appendix D, p. 129, entry HNO, a1..a7 as printed.
    model    NASA9;
    Tlow     200;
    Tcommon  1000;
    Thigh    6000;
    low      ( -6.854764860e+04 9.551627200e+02 -6.000720210e-01 7.995176750e-03 -6.547079160e-07 -3.670513400e-09 1.783392519e-12 );
    high     ( -5.795614980e+06 1.945457427e+04 -2.152568374e+01 1.797428992e-02 -4.976040670e-06 6.397924170e-10 -3.142619368e-14 );
}

provenance
{
    dHf_298
    {
        origin        literature;
        method        "NASA/TP-2002-211556 appendix D, p. 129, entry HNO, record-line H(298.15) (elements reference, so = dHf)";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "Table B1 p. 21 prints 102.033 kJ/mol; the report's own sources: Gurvich,1989 pt1 p362 pt2 p227. Jacox,1998 p151.";
    }
    s_298
    {
        origin        literature;
        method        "NASA/TP-2002-211556 Table B1, p. 21, entry HNO";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "appendix D's coefficients with b2 integrate to 220.920";
    }
    idealGasHeatCapacity
    {
        origin        literature;
        method        "NASA/TP-2002-211556 appendix D, p. 129, entry HNO, a1..a7 of the 200-1000 K and 1000-6000 K intervals, as printed";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "read by bin/curate/nasa_tp2002_to_choupo.py, which holds H and S at 298.15 K to the printed values";
    }
    source   "McBride, Zehe & Gordon, NASA Glenn Coefficients for Calculating Thermodynamic Properties of Individual Species, NASA/TP-2002-211556 (2002)";
    licence  publicDomain;    // US government work (NASA), 17 U.S.C. 105
}
