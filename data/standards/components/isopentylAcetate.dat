    // measured vapour pressures -- see provenance.vaporPressure
    coefficients  (3.621585262  1095.740462  -111.6484878);
    Trange        (368.15  416.45);   // the fit's own span; outside it the engine announces the extrapolation
}

Vliq        1.479876e-04;      // m3/mol at 25 C, FITTED (provenance.Vliq)

idealGasHeatCapacity
{
    model         polynomial;
    // Cp [J/(mol K)] = a0 + a1 T + a2 T^2 + a3 T^3, Joback ESTIMATE
    coefficients  (20.252  0.61996  -2.656000e-04  1.450000e-08);
    Trange        (273  1000);
}

liquidHeatCapacity
{
    model         polynomial;
    // Cp [J/(mol K)] = a0 + a1 T, Zabransky RECOMMENDED (provenance.liquidHeatCapacity)
    coefficients  (126.9293097  0.4176577921);
    Trange        (310  385);
}

groups
{
    unifac ( { group CH3; count 2; } { group CH; count 1; } { group CH2; count 2; } { group CH3COO; count 1; } );
    joback ( { group CH3; count 3; } { group CH; count 1; } { group CH2; count 2; } { group ester; count 1; } );
}

