MW          130.1870;      // kg/kmol, from the formula (IUPAC standard atomic weights)
Tc          586.1;      // K, IUPAC recommended (provenance.Tc)
Pc          27.6;      // bar, IUPAC recommended (provenance.Pc)
omega       0.488653;      // [-] (provenance.omega)
Tb          414.78;      // K, measured (provenance.Tb)

standardThermochemistry
{
    dHf_298   -510370;        // J/mol, ideal gas, Joback ESTIMATE (provenance.dHf_298)
