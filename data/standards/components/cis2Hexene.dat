    coefficients  (4.011176205  1171.205359  -49.605);
    Trange        (310.54  451.5);
}

Vliq        0.0001234;      // m3/mol at 25 C  [ChemSep eqno 105]
HvapTb      29182.1;      // J/mol at Tb  [ChemSep eqno 106]

idealGasHeatCapacity
{
    model         chemsepCp16;
    // Cp [J/(mol.K)] = A + exp(B/T + C + D T + E T^2)
    // ChemSep states J/(kmol.K); A and the exp are scaled to per-mole here.
    coefficients  (88.576  -789.82  6.378244721  -0.00034537  1.0091e-07);
    Trange        (200  1500);
}

liquidHeatCapacity
{
    model         chemsepCp16;
    // Cp [J/(mol.K)] = A + exp(B/T + C + D T + E T^2)
    coefficients  (135.61  570.7  -5.268555279  0.033591  -3.2605e-05);
    Trange        (132.03  342.03);
}

