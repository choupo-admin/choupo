/*--------------------------------*- Choupo -*-----------------------*\
  Component: Chlorine monoxide radical (Deacon/chlorination chemistry)
  Ideal-gas formation data and heat capacity READ from
  NASA/TP-2002-211556 (McBride, Zehe & Gordon 2002, "NASA Glenn
  Coefficients for Calculating Thermodynamic Properties of Individual
  Species"), a US government work in the public domain: entry
  "CLO", appendix D p. 107 (dHf_298 and the NASA-9 Cp coefficients,
  as printed) and Table B1 p. 18 (s_298).  The report's own sources
  for this species: Gurvich,1989 pt1 p180 pt2 p90.
  No liquid phase at process conditions -- the entry is tagged
  `role nonvolatile;` so vapour-pressure routines never get called.
  Re-sourced 2026-11-12 (DEV.md 4c C335) by
  bin/curate/nasa_tp2002_to_choupo.py from the NonCommercial compilation
  this record was first generated from (its old numbers
  are not kept here: they were that compilation's); not yet read back by
  a curator.
\*---------------------------------------------------------------------------*/

name           ClO;
formula        ClO;
CAS            n/a;        // radical registry number: pending curation

MW             51.449;       // kg/kmol
role        nonvolatile;
tags           ( radical gasPhase combustion chlorine );
reviewStatus   interim;
reviewReason   "transcribed by machine from NASA/TP-2002-211556 and checked against the report itself; not yet read back against the page by a curator";

standardThermochemistry
{
    dHf_298    101621.115;   // J/mol  -- ideal gas; NASA/TP-2002-211556 appendix D, p. 107, entry CLO
    s_298      225.104;     // J/(mol·K) -- third-law absolute; Table B1, p. 18
}

idealGasHeatCapacity
{
    //  NASA/TP-2002-211556 eq. (1), Cp/R = a1/T^2 + a2/T + a3 + a4 T + a5 T^2
    //  + a6 T^3 + a7 T^4; appendix D, p. 107, entry CLO, a1..a7 as printed.
    model    NASA9;
    Tlow     200;
    Tcommon  1000;
    Thigh    6000;
    low      ( -1.687268145e+04 2.573812247e+02 2.175846120e+00 6.432061130e-03 -8.568249500e-06 5.764971250e-09 -1.545771209e-12 );
    high     ( 4.093760520e+05 -1.765985112e+03 7.087900630e+00 -1.828450169e-03 7.103818100e-07 -1.209332942e-10 7.076441040e-15 );
}

provenance
{
    dHf_298
    {
        origin        literature;
        method        "NASA/TP-2002-211556 appendix D, p. 107, entry CLO, record-line H(298.15) (elements reference, so = dHf)";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "Table B1 p. 18 prints 101.621 kJ/mol; the report's own sources: Gurvich,1989 pt1 p180 pt2 p90.";
    }
    s_298
    {
        origin        literature;
        method        "NASA/TP-2002-211556 Table B1, p. 18, entry CLO";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "appendix D's coefficients with b2 integrate to 225.104";
    }
    idealGasHeatCapacity
    {
        origin        literature;
        method        "NASA/TP-2002-211556 appendix D, p. 107, entry CLO, a1..a7 of the 200-1000 K and 1000-6000 K intervals, as printed";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "read by bin/curate/nasa_tp2002_to_choupo.py, which holds H and S at 298.15 K to the printed values";
    }
    source   "McBride, Zehe & Gordon, NASA Glenn Coefficients for Calculating Thermodynamic Properties of Individual Species, NASA/TP-2002-211556 (2002)";
    licence  publicDomain;    // US government work (NASA), 17 U.S.C. 105
}
