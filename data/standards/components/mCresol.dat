// UNIQUAC van der Waals volume r and surface area q: the sum of the
// record's own UNIFAC groups (1 ACCH3 + 4 ACH + 1 ACOH), R_k/Q_k of Hansen et al. 1991
// (DEV.md 4c C294; bin/curate/uniquac_rq_from_groups.py).
uniquac
{
    r   4.2867;
    q   3.2480;
}

groups
{
    unifac ( { group ACCH3; count 1; } { group ACH; count 4; } { group ACOH; count 1; } );   // derived from structure c1(O)cc(C)ccc1 by bin/curate/unifac_groups.py
}

//  HANSEN solubility-parameter triple (DEV.md 4c C428; read by `hansenMixture`
//  and the Explorer's solvent lens).  Hansen 1969, Table I row A16 "m-Cresol":
//  delta_d = 8.82, delta_p = 2.5, delta_h = 6.3 (cal/cm3)^0.5, x sqrt(4.184e6) = 2045.4828.
hansen
{
    dD    18041.2;        // Pa^0.5   = 8.82 (cal/cm3)^0.5, Table I row A16
    dP    5113.7;        // Pa^0.5   = 2.5
    dH    12886.5;        // Pa^0.5   = 6.3
    Tref  298.15 K;       // adopted: the paper prints no temperature beside Table I
}

