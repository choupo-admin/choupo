vaporPressure
{
    model         Antoine;
    // log10(Psat [bar]) = A - B / (T[K] + C)
    // converted EXACTLY from ChemSep eqno 10, Psat[Pa] = exp(a - b/(T+c))
    coefficients  (4.024639334  1259.801433  -53.334);
    Trange        (324.12  476.88);
}

Vliq        0.000141309;      // m3/mol at 25 C  [ChemSep eqno 105]
HvapTb      31382.3;      // J/mol at Tb  [ChemSep eqno 106]

idealGasHeatCapacity
{
    model         chemsepCp16;
    // Cp [J/(mol.K)] = A + exp(B/T + C + D T + E T^2)
    // ChemSep states J/(kmol.K); A and the exp are scaled to per-mole here.
    coefficients  (94.067  -609.56  6.135244721  4.6316e-05  -2.1105e-08);
    Trange        (200  1500);
}

liquidHeatCapacity
{
    model         chemsepCp16;
    // Cp [J/(mol.K)] = A + exp(B/T + C + D T + E T^2)
    coefficients  (58.419  89.259  3.641244721  0.0039271  -8.6181e-07);
    Trange        (151.79  430);
}

