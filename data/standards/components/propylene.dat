/*--------------------------------*- Choupo -*-----------------------*\
  Component: Propene / Propylene  (C3H6, CAS 115-07-1)

  Second-largest petrochemical building block (polypropylene,
  propylene oxide, cumene).  Co-product of steam cracking and
  catalytic cracking.
  Sources: constants (Tc/Pc/omega/MW/Tb) cross-checked vs CoolProp 7.2.0
  reference EOS; standardThermochemistry cross-checked vs NASA TM-4513
  (McBride-Gordon-Reno 1993); idealGasHeatCapacity -- individual
  literature value, primary re-citation pending (IST review).
\*---------------------------------------------------------------------------*/

name        propylene;
formula     C3H6;
CAS         115-07-1;

MW          42.081;            // kg/kmol
Tc          365.57;             // K
Pc          46.65;              // bar
omega       0.142;              // [-]
Tb          225.46;             // K
HvapTb      18420;              // J/mol
Vliq        6.81e-5;            // m^3/mol
VliqT       225.46;      // K -- the temperature Vliq belongs to: the boiling-point class, read at the record's own Tb
//  Evidence: the measured saturated-liquid volume equals the stored 68.1 cm³/mol at
//  219.12 K, 6.34 K below Tb (ln V linear in T between the 210 K and 220 K points);
//  at Tb the measured volume is 68.98 cm³/mol, the stored value 1.27 % below it --
//  inside the 2.1 % band of the other boiling-point-class records (batch
//  vliq_datum_temperature).  One article: Glos, Kleinrahm & Wagner, J. Chem.
//  Thermodyn. 2004, doi:10.1016/j.jct.2004.07.017, located through the ThermoML
//  archive, values transcribedNotCheckedAgainstArticle.  Review VT-06 (2026-11-13).
//  ANCHOR, never an input.  The engine DERIVES the Hildebrand
//  parameter from HvapTb and Vliq (the tree stores no derivative);
//  this is what ChemSep v8.3 computed independently, so the
//  derivation has something to be wrong against.
solubilityParameter 11890;   // Pa^0.5  [anchor, ChemSep v8.3, Artistic-2.0]

standardThermochemistry
{
    dHf_298    20410.0;         // J/mol  -- ideal-gas reference
    s_298      266.94;          // J/(mol·K)
}

vaporPressure
{
    model         Antoine;
    // log10(Psat [bar]) = A - B / (T[K] + C)
    // Poling 5e App. A (via the MIT-licensed `chemicals` 1.5.2 data
    // distribution; INTERIM pending primary review (Vitor))
    coefficients  (3.95606   789.624   -25.57);
    Trange        (165.2  241.61);    // clamped to the source fit range (review 2026-08-24)
}

idealGasHeatCapacity
{
    model         polynomial;
    coefficients  (3.710   0.2345   -1.160e-4   2.205e-8);
    Trange        (250  1500);
}

// UNIQUAC van der Waals volume r and surface area q: the sum of the
// record's own UNIFAC groups (1 CH3 + 1 CH2=CH), R_k/Q_k of Hansen et al. 1991
// (DEV.md 4c C294; bin/curate/uniquac_rq_from_groups.py).
uniquac
{
    r   2.2465;
    q   2.0240;
}

groups
{
    unifac ( { group CH3; count 1; } { group CH2=CH; count 1; } );
    joback ( { group CH3; count 1; } { group eCH; count 1; } { group eCH2; count 1; } );
}

// Friendly-name aliases -- resolved to this file via the generated ALIASES index.
aliases ( propene C3H6 );

cosmo
{
    VT2005
    {
        model       COSMOSAC;
        variant     "2002";
        source      "VT-2005 sigma-profile database (Mullins et al., Ind. Eng. Chem. Res. 45 (2006) 4389; DFT-COSMO), file VT2005-0125-PROF.txt bundled in usnistgov/COSMOSAC; CAS 115-07-1";
        licence     externalRestricted;   // VT-2005: redistribution NOT confirmed -- values NOT shipped
        installed   false;                 // install your own copy: bin/choupo-import-cosmo (-> data/local/cosmo/VT2005/)
    }
    LVPP-HFTZVP-2018
    {
        model       COSMOSAC;
        variant     "LVPP-HFTZVP-2018";
        protocol    "LVPP-18.07 GAMESS HF/TZVP; r_av 1.4 A; f_decay 3.57; d in A; sigma = q/a";
        source      "LVPP sigma-profile database release 18.07 (github.com/lvpp/sigma, asset HF_TZVP.zip, sha256 bd17aaeebb430641...), file PROPYLENE.gout; MIT License, Copyright (c) 2017 LVPP; cite Ferrarini, Flores, Muniz & Soares, AIChE J. 64 (2018) 3443, doi:10.1002/aic.16194, and doi:10.5281/zenodo.3613786; identity: InChIKey QQONPFPTGQHPMA-UHFFFAOYSA-N (full match); formula C3H6; resolved by thirdParty/thermoml/identity.json (PubChem and CACTUS agree)";
        derivation  "segment areas, charges and the cavity volume are LVPP's (GAMESS HF/TZVP COSMO output); `area` is the sum of LVPP's segment areas as binned (GAMESS's printed cavity area agrees within its 2-decimal rounding); the 51-point profile is COMPUTED BY CHOUPO from LVPP's surface segments by bin/curate/lvpp_sigma_profile.py under the protocol above (Bell et al. 2020 Eq. 4 averaging, sigma = q/a, area split linearly between grid nodes)";
        licence     MIT;
        installed   true;
        area        92.229287;   // sum of the profile below; GAMESS prints 92.23
        volume      74.75;
        sigmaProfile  (
               0.000000     0.000000     0.000000     0.000000     0.000000     0.000000
               0.000000     0.000000     0.000000     0.000000     0.000000     0.000000
               0.000000     0.000000     0.000000     0.000000     0.000000     0.000000
               0.585445     2.675877     8.418282    11.345240    10.512673     7.619545
               7.038495     7.125213    11.037722     5.278220     4.403832     3.776647
               1.918719     3.088401     3.451252     1.086952     2.552864     0.313908
               0.000000     0.000000     0.000000     0.000000     0.000000     0.000000
               0.000000     0.000000     0.000000     0.000000     0.000000     0.000000
               0.000000     0.000000     0.000000
        );
    }
}

provenance
{
    uniquac
    {
        origin        definition;
        method        "sum of UNIFAC group R_k/Q_k: r = sum nu_k R_k = 2.2465, q = sum nu_k Q_k = 2.0240 over the record's unifac groups (1 CH3 + 1 CH2=CH)";
        citation      "R_k and Q_k of Hansen, Rasmussen, Fredenslund, Schiller & Gmehling, Ind. Eng. Chem. Res. 30 (1991) 2352, as tabulated in data/standards/parameters/UNIFAC/groups.dat; the group sum of Fredenslund, Jones & Prausnitz, AIChE J. 21 (1975) 1086";
    }
}
