// (DEV.md 4c C294; bin/curate/uniquac_rq_from_groups.py).
uniquac
{
    r   7.5250;
    q   6.3560;
}

groups
{
    unifac ( { group CH3; count 2; } { group CH2; count 6; } { group CH2COO; count 1; } );
    joback ( { group CH3; count 2; } { group CH2; count 7; } { group ester; count 1; } );
}

