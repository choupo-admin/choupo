}

Vliq        7.225838e-05;      // m3/mol at 25 C, FITTED (provenance.Vliq)

idealGasHeatCapacity
{
    model         polynomial;
    // Cp [J/(mol K)] = a0 + a1 T + a2 T^2 + a3 T^3, Joback ESTIMATE
    coefficients  (10.743  0.3568  -2.002000e-04  4.410000e-08);
    Trange        (273  1000);
}

liquidHeatCapacity
{
    model         polynomial;
    // Cp [J/(mol K)] = a0 + a1 T + a2 T^2, FITTED (provenance.liquidHeatCapacity)
    coefficients  (56.73550899  0.3241085067  0.0002633023779);
    Trange        (283.15  353.15);
}

groups
{
    unifac ( { group CH2; count 3; } { group OH; count 2; } );
    joback ( { group CH2; count 3; } { group OH; count 2; } );
}

