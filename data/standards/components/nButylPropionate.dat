/*--------------------------------*- Choupo -*-----------------------*\
  Component: nButylPropionate  (butyl propanoate; CAS 590-01-2)
  NEW in the catalogue (DEV.md 4c C309, slice 3 of C287, 2026-11-11), built by
  bin/curate/c287_new_components.py from the IUPAC critical-property series, the
  Zabransky liquid heat-capacity review and the measurements the NIST/TRC
  ThermoML Archive locates (the articles are the sources; every value's
  citation or DOIs are in provenance).
  IUPAC RECOMMENDED (critically evaluated measurements): Tc.
  MEASURED (archive median): Tb.
  FITTED: vapour pressure (bin/choupo-curate vp), Vliq.
  DERIVED: omega (from the fitted vapour pressure).
  ESTIMATED (Joback): Pc, ideal-gas Cp, dHf_298; s_298 derived from Joback's dHf and dGf.
  ESTIMATED (Rowlinson-Bondi, Poling 5e Eq. 6-6.4): liquid Cp -- no measurement or recommended correlation in hand.
  No measured series is reproduced here.
  reviewStatus autoPromoted, review by none: NO human has read it back.
  Psat: fitted by `bin/choupo-curate vp`; its promotion replaced the
  AmbroseWalton block this tool writes (provenance.vaporPressure).
\*---------------------------------------------------------------------------*/

name        nButylPropionate;
CAS         590-01-2;
formula     C7H14O2;
reviewStatus autoPromoted;
review      { by none; }   // DEV.md 4c C300 rule 4 (C297): nobody has reviewed it
MW          130.1870;      // kg/kmol, from the formula (IUPAC standard atomic weights)
Tc          594.5;      // K, IUPAC recommended (provenance.Tc)
Pc          28.1434472;      // bar, Joback ESTIMATE (provenance.Pc)
omega       0.470408;      // [-] (provenance.omega)
Tb          418.25;      // K, measured (provenance.Tb)

standardThermochemistry
{
    dHf_298   -505090;        // J/mol, ideal gas, Joback ESTIMATE (provenance.dHf_298)
    s_298     479.96;        // J/(mol K), ideal gas, DERIVED from Joback (provenance.s_298)
}

vaporPressure
{
    model         Antoine;
    // log10(Psat [bar]) = A - B / (T[K] + C), FITTED by bin/choupo-curate vp to
    // measured vapour pressures -- see provenance.vaporPressure
    coefficients  (3.61597722  1106.480015  -111.9218781);
    Trange        (351.45  436.43);   // the fit's own span; outside it the engine announces the extrapolation
}

Vliq        1.494867e-04;      // m3/mol at 25 C, FITTED (provenance.Vliq)

idealGasHeatCapacity
{
    model         polynomial;
    // Cp [J/(mol K)] = a0 + a1 T + a2 T^2 + a3 T^3, Joback ESTIMATE
    coefficients  (21.934  0.61404  -2.624000e-04  1.500000e-08);
    Trange        (273  1000);
}

liquidHeatCapacity
{
    model         polynomial;
    // Cp [J/(mol K)] = a0 + a1 T + a2 T^2, Rowlinson-Bondi ESTIMATE (provenance.liquidHeatCapacity)
    coefficients  (205.217528  0.0730584118  0.0004056407254);
    Trange        (351.45  436.43);
}

// UNIQUAC van der Waals volume r and surface area q: the sum of the
// record's own UNIFAC groups (2 CH3 + 3 CH2 + 1 CH2COO), R_k/Q_k of Hansen et al. 1991
// (DEV.md 4c C294; bin/curate/uniquac_rq_from_groups.py).
uniquac
{
    r   5.5018;
    q   4.7360;
}

groups
{
    unifac ( { group CH3; count 2; } { group CH2; count 3; } { group CH2COO; count 1; } );
    joback ( { group CH3; count 2; } { group CH2; count 4; } { group ester; count 1; } );
}

provenance
{
    uniquac
    {
        origin        definition;
        method        "sum of UNIFAC group R_k/Q_k: r = sum nu_k R_k = 5.5018, q = sum nu_k Q_k = 4.7360 over the record's unifac groups (2 CH3 + 3 CH2 + 1 CH2COO)";
        citation      "R_k and Q_k of Hansen, Rasmussen, Fredenslund, Schiller & Gmehling, Ind. Eng. Chem. Res. 30 (1991) 2352, as tabulated in data/standards/parameters/UNIFAC/groups.dat; the group sum of Fredenslund, Jones & Prausnitz, AIChE J. 21 (1975) 1086";
    }
    MW
    {
        origin        literature;
        method        "sum of IUPAC standard atomic weights over the formula";
    }
    Tc
    {
        origin        measured;
        method        "IUPAC recommended value: the critical evaluation of every published measurement by the IUPAC critical-properties group (594.5 K)";
        uncertainty   "+-1 K, the evaluators' estimate";
        source        "Kudchadker, A.P.; Ambrose, D.; Tsonopoulos, C. Vapor-Liquid Critical Properties of Elements and Compounds. 7. Oxygen Compounds Other Than Alkanols and Cycloalkanols. J. Chem. Eng. Data 46 (2001) 457-479, Table 1 (recommended values)";
        doi           "10.1021/je0001680";
        transcribedBy "bin/curate/c287_new_components.py (IUPAC table, hand-transcribed from the PDF, one row per compound)";
        reviewStatus  autoPromoted;
        review        { by none; }   // DEV.md 4c C300 rule 4 (C297): nobody has reviewed it
        reviewReason  "transcribed by a model from the article's Table 1 and re-read once; not yet read back by a human";
    }
    Pc
    {
        origin           estimated;
        method           "Joback";
        methodVersion    "joback-poling5e-table2-2";
        input            joback;
        inputFingerprint "CH2:4,CH3:2,ester:1";
        reproducedInCase "data/curation/batches/new_components_c309";
        uncertainty      { status unquantified; reason "Joback group contribution (Joback & Reid 1987); Tc within a few per cent and Pc within about 5-10 per cent for ordinary organics, worse for polyfunctional molecules"; }
        notes            "neither the IUPAC series (Parts 7-10, 12) nor the archive gives a critical pressure for this compound; all groups of the structure are in the Joback table";
    }
    Tb
    {
        origin        measured;
        method        "median of the per-article medians of every value the ThermoML archive locates (1 value(s), 1 article(s)); boiling temperatures reported at 100 - 102.5 kPa";
        uncertainty   "spread of the reported values 418.25 - 418.25 K";
        doi           "10.1021/acs.jced.7b01024";
        combinedBy    "bin/curate/c287_new_components.py";
        reviewStatus  autoPromoted;
        review        { by none; }   // DEV.md 4c C300 rule 4 (C297): nobody has reviewed it
        reviewReason  "combined by a machine from archive-transcribed values; not yet read back against the articles";
    }
    omega
    {
        origin        regressed;
        method        "DERIVED from a fit: omega = -log10(Psat(0.7 Tc)/Pc) - 1 from the Antoine the vapour-pressure pipeline fitted (data/curation/components/nButylPropionate) and the IUPAC-recommended and Joback-estimated Tc, Pc; 0.7 Tc = 416.15 K, inside the fitted range; cross-check (C309): omega 0.4704 from the Antoine at 0.7 Tc against Lee-Kesler 0.4696 from the measured Tb 418.25 K, Tc and Pc (difference +0.0008)";
        derivedBy     "bin/curate/c287_new_components.py";
        reviewStatus  autoPromoted;
        review        { by none; }   // DEV.md 4c C300 rule 4 (C297): nobody has reviewed it
        reviewReason  "derived by a machine; read it with the fitGrade of the vapour pressure it comes from";
    }
    Vliq
    {
        origin        fitted;
        method        "one-parameter fit of the engine's own liquid density, V(T) = Vliq Rackett(T)/Rackett(298.15 K) with this record's Tc, Pc, omega (ThermoPackage::density, liquid branch), to every measured liquid mass density at or below 200 kPa; least squares in the relative density error, then its largest value minimised";
        fittedBy      "bin/curate/c287_new_components.py";
        reviewStatus  autoPromoted;
        review        { by none; }   // DEV.md 4c C300 rule 4 (C297): nobody has reviewed it
        fitGrade      clean;   // DEV.md 4c C285 limits 5 / 10 / 20 %
        fitGradeBasis inSample;   // DEV.md 4c C300 rule 1: the residual of the points it was fitted to
        fitGradeMaxRelativeError_pct 0.021435;
        reviewReason  "regressed by a machine from archive-transcribed measurements; not yet read back against the articles";
        reuse         "Choupo's own regression; the measured points belong to the cited articles and are not reproduced in this record or this tree";
        evidence
        (
            { doi "10.1016/j.fluid.2005.09.015"; articleSha256 "7c88936a12308a0cff09556562a3e040c3e808b37d91fe1a96692b16fbc613da"; pointsKept 1; pointsDropped 0; provenance measured; }
            { doi "10.1016/j.jct.2004.12.014"; articleSha256 "b5f6f3f67e1e1fafd2ca759fdee295ec2d6ccb92bdd352235c4a033158623722"; pointsKept 1; pointsDropped 0; provenance measured; }
            { doi "10.1016/j.jct.2005.11.003"; articleSha256 "2ded984525e7b5ba4f3057feb25bef95b1b626bdc478923d4f37f89144369b47"; pointsKept 1; pointsDropped 0; provenance measured; }
            { doi "10.1021/je0497350"; articleSha256 "325ac7b566e0f982b9d7b134a65b05f8f3d5fcc0fd84a2e8115ffc0dbb38fc30"; pointsKept 2; pointsDropped 0; provenance measured; }
            { doi "10.1021/je060314n"; articleSha256 "2bbc1a3641f316657a804637abbbf5dcced2385d3e6af03aebcd2deb615c40ae"; pointsKept 1; pointsDropped 0; provenance measured; }
            { doi "10.1021/je900042q"; articleSha256 "24b48c6ab87106a67d360f631d3b2dcecac90ca6aa13c1e75116a149412d0965"; pointsKept 1; pointsDropped 0; provenance measured; }
            { doi "10.1021/je900470r"; articleSha256 "a6ee55023acb46567bf5b4d4428b2cb043a3aa630039c7a528377cc129e89b54"; pointsKept 1; pointsDropped 0; provenance measured; }
        );
        acceptance
        {
            rule        "the default graded acceptance of DEV.md 4c C285 on the max relative error over the kept points (clean / warning / severe up to 5 / 10 / 20 %); every laboratory fitted, points beyond 15 % after the least-squares stage discarded by name (C283 amended)";
            verdict     accepted;
            studies     7;
            pointsKept  8;
            pointsDropped 0;
            dropped     "none";
            aad_pct     0.009416;
            max_pct     0.021435;
            Trange      (298.15 318.15);   // K, the kept points
        }
    }
    liquidHeatCapacity
    {
        origin           estimated;
        method           "Rowlinson-Bondi corresponding states, Poling, Prausnitz & O'Connell, The Properties of Gases and Liquids, 5th ed. (2001), Eq. (6-6.4): (Cp_L - Cp_ig)/R = 1.586 + 0.49/(1 - Tr) + omega [4.2775 + 6.3 (1 - Tr)^(1/3)/Tr + 0.4355/(1 - Tr)], with this record's Joback Cp_ig, Tc (iupac) and omega; represented by a quadratic in T least-squares fitted to the equation over 351.45-436.43 K (the fitted vapour pressure's span within 0.40-0.80 Tc), max deviation 0.016 % from it";
        computedBy       "bin/curate/c287_new_components.py (rowlinson_bondi)";
        inputFingerprint "CH2:4,CH3:2,ester:1";
        reproducedInCase "data/curation/batches/new_components_c309";
        uncertainty      { status unquantified; reason "Poling 5e p. 6.22: 2.5 % AAD on 194 substances at 298 K, more than 10 % on 18 others, most hydrogen-bonded (C1-C4 alcohols and acids, water, amines); the archive locates no liquid Cp for this compound and no Zabransky supplement in hand recommends one"; }
        reviewStatus     autoPromoted;
        review           { by none; }   // DEV.md 4c C300 rule 4 (C297): nobody has reviewed it
    }
    idealGasHeatCapacity
    {
        origin           estimated;
        method           "Joback";
        methodVersion    "joback-poling5e-table2-2";
        input            joback;
        inputFingerprint "CH2:4,CH3:2,ester:1";
        reproducedInCase "data/curation/batches/new_components_c309";
        uncertainty      { status unquantified; reason "Joback group contribution (Joback & Reid 1987); a few percent for Cp_ig of ordinary organics"; }
    }
    dHf_298
    {
        origin           estimated;
        method           "Joback";
        methodVersion    "joback-poling5e-table2-2";
        input            joback;
        inputFingerprint "CH2:4,CH3:2,ester:1";
