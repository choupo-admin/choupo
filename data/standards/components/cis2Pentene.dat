        C     -1.1883;
        D     -0.0013351;
        E     -7.8623e-07;
        Tmin  120;
        Tmax  310.08;
    }
}

// UNIQUAC van der Waals volume r and surface area q: the sum of the
// record's own UNIFAC groups (2 CH3 + 1 CH2 + 1 CH=CH), R_k/Q_k of Hansen et al. 1991
// (DEV.md 4c C294; bin/curate/uniquac_rq_from_groups.py).
uniquac
{
    r   3.5933;
    q   3.1030;
}

groups
{
    unifac ( { group CH3; count 2; } { group CH2; count 1; } { group CH=CH; count 1; } );
}
solubilityParameter 15060;   // Pa^0.5  [ANCHOR, ChemSep v8.3 -- checked against, never used]

