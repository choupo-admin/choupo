name        cis2Pentene;
CAS         627-20-3;
formula     C5H10;      // counted from the ChemSep v8.3 structure formula "CH3CHCHCH2CH3" (derived 2026-09-03; reproduces MW to 0.003 %)
reviewStatus interim;
MW          70.1329;      // kg/kmol [origin=ChemSep v8.3]
Tc          475;      // K [origin=ChemSep v8.3]
Pc          36.9;      // bar; source Pa / 1e5 [origin=ChemSep v8.3]
omega       0.253;      // [-] [origin=ChemSep v8.3]
Tb          310.07;      // K [origin=ChemSep v8.3]

standardThermochemistry
{
    dHf_298   -26300;        // J/mol   [ChemSep v8.3, ideal gas]
    s_298     346.3;        // J/(mol.K)  third-law absolute
}

vaporPressure
{
    model         Antoine;
    // log10(Psat [bar]) = A - B / (T[K] + C)
    // converted EXACTLY from ChemSep eqno 10, Psat[Pa] = exp(a - b/(T+c))
    coefficients  (4.067200193  1104.888591  -38.058);
    Trange        (285.51  419.22);
}

Vliq        0.000107697;      // m3/mol at 25 C  [ChemSep eqno 105]
HvapTb      26222.6;      // J/mol at Tb  [ChemSep eqno 106]

idealGasHeatCapacity
{
    model         chemsepCp16;
    // Cp [J/(mol.K)] = A + exp(B/T + C + D T + E T^2)
    // ChemSep states J/(kmol.K); A and the exp are scaled to per-mole here.
    coefficients  (68.358  -741.07  6.015244721  -0.00013529  3.1324e-08);
    Trange        (200  1500);
}

liquidHeatCapacity
{
    model         chemsepCp16;
    // Cp [J/(mol.K)] = A + exp(B/T + C + D T + E T^2)
    coefficients  (132.08  -10569  105.7322447  -0.34846  0.00041161);
    Trange        (121.75  310.08);
}

