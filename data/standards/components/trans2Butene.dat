/*--------------------------------*- Choupo -*-----------------------*\
  Component: trans2Butene  (C4H8, CAS 624-64-6)
  PROPOSAL TIER -- UNVERIFIED.  Imported from CoolProp 7.2.0 (MIT);
  pure-fluid properties from the published reference EOS below.
  Reference EOS: Lemmon-FPE-2005
  NOTE: formation properties (dHf, s_298) and group decompositions
  are NOT provided by CoolProp -> omitted here (a gap, not fabricated).
\*---------------------------------------------------------------------------*/

name        trans2Butene;

//  Review state, MACHINE-READABLE (AP2, 2026-08-05).  This used to
//  live only in the banner above, which the parser discards -- so the
//  engine could not announce it and a run said nothing.
reviewStatus   interim;
reviewReason   importedFromCoolProp720_notCheckedAgainstPrimaries;
formula     C4H8;
CAS         624-64-6;

MW          56.1063;        // kg/kmol  [CoolProp]
Tc          428.6105;        // K        [CoolProp EOS]
Pc          40.19095;        // bar      [CoolProp EOS]
omega       0.21008;        // [-]      [CoolProp EOS]
Tb          274.0299;        // K  normal boiling [CoolProp]
HvapTb      22733.8;        // J/mol  at Tb     [CoolProp]
Vliq        9.3737e-05;        // m3/mol @298K     [CoolProp]
//  ANCHOR, never an input.  The engine DERIVES the Hildebrand
//  parameter from HvapTb and Vliq (the tree stores no derivative);
//  this is what ChemSep v8.3 computed independently, so the
//  derivation has something to be wrong against.
solubilityParameter 14210;   // Pa^0.5  [anchor, ChemSep v8.3, Artistic-2.0]

vaporPressure
{
    model         Antoine;
    // log10(Psat [bar]) = A - B / (T[K] + C)   -- fitted to CoolProp EOS
    coefficients  (4.10375   1008.38   -28.076);
    Trange        (192.87  420.04);
}

idealGasHeatCapacity
{
    model         polynomial;
    // Cp [J/(mol.K)] = a0 + a1 T + a2 T^2 + a3 T^3   -- fitted to CoolProp cp0
    coefficients  (23.7403  0.224988  -1.44296e-05  -3.93722e-08);
    Trange        (200  1000);
}

liquidHeatCapacity
{
    model         polynomial;
    // Cp_liq [J/(mol.K)]   -- fitted to CoolProp saturated-liquid cp
    coefficients  (100.104  0.0769478  -0.000401261  1.63432e-06);
    Trange        (214  274);
}

triplePoint
{
    T   167.6000;
    P   74.8167;
}

standardThermochemistry
{
    dHf_298   -8670;      // J/mol ideal-gas -- provenance: see the structured dHf_298 block below
    dGf_298   63020;      // J/mol  ideal-gas [Joback]
    s_298     305.231;      // J/(mol*K) third-law [DERIVED: (dHf-dGf)/T + CODATA element S]
}

// UNIQUAC van der Waals volume r and surface area q: the sum of the
// record's own UNIFAC groups (2 CH3 + 1 CH=CH), R_k/Q_k of Hansen et al. 1991
// (DEV.md 4c C294; bin/curate/uniquac_rq_from_groups.py).
uniquac
{
    r   2.9189;
    q   2.5630;
}

groups { unifac ( { group CH3; count 2; } { group CH=CH; count 1; } ); joback ( { group CH3; count 2; } { group eCH; count 2; } ); }

provenance
{
    uniquac
    {
        origin        definition;
        method        "sum of UNIFAC group R_k/Q_k: r = sum nu_k R_k = 2.9189, q = sum nu_k Q_k = 2.5630 over the record's unifac groups (2 CH3 + 1 CH=CH)";
        citation      "R_k and Q_k of Hansen, Rasmussen, Fredenslund, Schiller & Gmehling, Ind. Eng. Chem. Res. 30 (1991) 2352, as tabulated in data/standards/parameters/UNIFAC/groups.dat; the group sum of Fredenslund, Jones & Prausnitz, AIChE J. 21 (1975) 1086";
    }
    dHf_298
    {
        origin           estimated;
        method           "Joback";
        methodVersion    "joback-poling5e-table2-2";
        input            joback;
        inputFingerprint "CH3:2,eCH:2";
        uncertainty      { status unquantified; reason "bulk-import band ~9 kJ/mol, primary basis not verified"; }
    }

    constants      "CoolProp 7.2.0 -- Lemmon-FPE-2005";
    vaporPressure  "Antoine fitted to CoolProp EOS saturation, AAD 0.65%";
    idealGasCp     "polynomial fitted to CoolProp cp0, maxerr 2.45%";
    liquidCp       "polynomial fitted to CoolProp sat-liquid cp, maxerr 0.00%";
    triplePoint    "CoolProp reference EOS triple-point T,P";
    preserved      "from prior proposal (NOT CoolProp): standardThermochemistry, groups";
}

cosmo
{
    VT2005
    {
        model       COSMOSAC;
        variant     "2002";
        source      "VT-2005 sigma-profile database (Mullins et al., Ind. Eng. Chem. Res. 45 (2006) 4389; DFT-COSMO), file VT2005-0128-PROF.txt bundled in usnistgov/COSMOSAC; CAS 624-64-6";
        licence     externalRestricted;   // VT-2005: redistribution NOT confirmed -- values NOT shipped
        installed   false;                 // install your own copy: bin/choupo-import-cosmo (-> data/local/cosmo/VT2005/)
    }
    LVPP-HFTZVP-2018
    {
        model       COSMOSAC;
        variant     "LVPP-HFTZVP-2018";
        protocol    "LVPP-18.07 GAMESS HF/TZVP; r_av 1.4 A; f_decay 3.57; d in A; sigma = q/a";
        source      "LVPP sigma-profile database release 18.07 (github.com/lvpp/sigma, asset HF_TZVP.zip, sha256 bd17aaeebb430641...), file TRANS-2-BUTENE.gout; MIT License, Copyright (c) 2017 LVPP; cite Ferrarini, Flores, Muniz & Soares, AIChE J. 64 (2018) 3443, doi:10.1002/aic.16194, and doi:10.5281/zenodo.3613786; identity: InChIKey IAQRGUVFOMOMEM-ONEGZZNKSA-N (full match); formula C4H8; resolved by thirdParty/thermoml/identity.json (PubChem and CACTUS agree)";
        derivation  "segment areas, charges and the cavity volume are LVPP's (GAMESS HF/TZVP COSMO output); `area` is the sum of LVPP's segment areas as binned (GAMESS's printed cavity area agrees within its 2-decimal rounding); the 51-point profile is COMPUTED BY CHOUPO from LVPP's surface segments by bin/curate/lvpp_sigma_profile.py under the protocol above (Bell et al. 2020 Eq. 4 averaging, sigma = q/a, area split linearly between grid nodes)";
        licence     MIT;
        installed   true;
        area        112.273710;   // sum of the profile below; GAMESS prints 112.27
        volume      95.23;
        sigmaProfile  (
               0.000000     0.000000     0.000000     0.000000     0.000000     0.000000
               0.000000     0.000000     0.000000     0.000000     0.000000     0.000000
               0.000000     0.000000     0.000000     0.000000     0.000000     0.000000
               0.000000     0.899470     5.340620    11.508822    18.455764    10.344983
              11.687436     9.739111    13.560025    11.856183     4.631785     3.073674
               3.329134     2.223217     1.794786     2.189135     1.316420     0.323145
               0.000000     0.000000     0.000000     0.000000     0.000000     0.000000
               0.000000     0.000000     0.000000     0.000000     0.000000     0.000000
               0.000000     0.000000     0.000000
        );
    }
}
