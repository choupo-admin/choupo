    s_298     397;        // J/(mol.K)  third-law absolute
}

vaporPressure
{
    model         Antoine;
    // log10(Psat [bar]) = A - B / (T[K] + C)
    // converted EXACTLY from ChemSep eqno 10, Psat[Pa] = exp(a - b/(T+c))
    coefficients  (4.03593099  1241.604494  -45.57);
    Trange        (314.93  463.15);
}

Vliq        0.000149957;      // m3/mol at 25 C  [ChemSep eqno 105]
HvapTb      29515;      // J/mol at Tb  [ChemSep eqno 106]

idealGasHeatCapacity
{
    model         chemsepCp16;
    // Cp [J/(mol.K)] = A + exp(B/T + C + D T + E T^2)
    // ChemSep states J/(kmol.K); A and the exp are scaled to per-mole here.
    coefficients  (66.1  -427.67  5.968244721  0.00036594  -1.1245e-07);
    Trange        (200  1500);
}

liquidHeatCapacity
{
    model         chemsepCp16;
    // Cp [J/(mol.K)] = A + exp(B/T + C + D T + E T^2)
    coefficients  (90.283  22.117  3.385244721  0.0058192  -3.3296e-06);
    Trange        (153.91  353.64);
}

