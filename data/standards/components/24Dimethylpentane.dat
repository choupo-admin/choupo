// UNIQUAC van der Waals volume r and surface area q: the sum of the
// record's own UNIFAC groups (4 CH3 + 1 CH2 + 2 CH), R_k/Q_k of Hansen et al. 1991
// (DEV.md 4c C294; bin/curate/uniquac_rq_from_groups.py).
uniquac
{
    r   5.1726;
    q   4.3880;
}

groups
{
    unifac ( { group CH3; count 4; } { group CH2; count 1; } { group CH; count 2; } );
}
solubilityParameter 14290;   // Pa^0.5  [ANCHOR, ChemSep v8.3 -- checked against, never used]

