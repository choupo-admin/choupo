name        24Dimethylpentane;
CAS         108-08-7;
formula     C7H16;      // counted from the ChemSep v8.3 structure formula "(CH3)2CHCH2CH(CH3)2" (derived 2026-09-03; reproduces MW to 0.003 %)
reviewStatus interim;
MW          100.202;      // kg/kmol [origin=ChemSep v8.3]
Tc          519.7;      // K [origin=ChemSep v8.3]
Pc          27.4;      // bar; source Pa / 1e5 [origin=ChemSep v8.3]
omega       0.304;      // [-] [origin=ChemSep v8.3]
