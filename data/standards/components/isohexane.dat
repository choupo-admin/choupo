/*--------------------------------*- Choupo -*-----------------------*\
  Component: isohexane  (C6H14, CAS 107-83-5)
  PROPOSAL TIER -- UNVERIFIED.  Imported from CoolProp 7.2.0 (MIT);
  pure-fluid properties from the published reference EOS below.
  Reference EOS: Lemmon-JCED-2006
  NOTE: formation properties (dHf, s_298) and group decompositions
  are NOT provided by CoolProp -> omitted here (a gap, not fabricated).
\*---------------------------------------------------------------------------*/

name        isohexane;

//  Review state, MACHINE-READABLE (AP2, 2026-08-05).  This used to
//  live only in the banner above, which the parser discards -- so the
//  engine could not announce it and a run said nothing.
reviewStatus   interim;
reviewReason   importedFromCoolProp720_notCheckedAgainstPrimaries;
formula     C6H14;
CAS         107-83-5;

MW          86.1754;        // kg/kmol  [CoolProp]
Tc          497.7009;        // K        [CoolProp EOS]
Pc          30.42659;        // bar      [CoolProp EOS]
omega       0.27970;        // [-]      [CoolProp EOS]
Tb          333.3621;        // K  normal boiling [CoolProp]
HvapTb      27840.2;        // J/mol  at Tb     [CoolProp]
Vliq        1.3288e-04;        // m3/mol @298K     [CoolProp]
//  ANCHOR, never an input.  The engine DERIVES the Hildebrand
//  parameter from HvapTb and Vliq (the tree stores no derivative);
//  this is what ChemSep v8.3 computed independently, so the
//  derivation has something to be wrong against.
solubilityParameter 14400;   // Pa^0.5  [anchor, ChemSep v8.3, Artistic-2.0]

vaporPressure
{
    model         Antoine;
    // log10(Psat [bar]) = A - B / (T[K] + C)   -- fitted to CoolProp EOS
    coefficients  (4.06854   1188.14   -40.9916);
    Trange        (223.97  487.75);
}

idealGasHeatCapacity
{
    model         polynomial;
    // Cp [J/(mol.K)] = a0 + a1 T + a2 T^2 + a3 T^3   -- fitted to CoolProp cp0
    coefficients  (-3.68584  0.565774  -0.000253366  2.72101e-08);
    Trange        (200  1000);
}

liquidHeatCapacity
{
    model         polynomial;
    // Cp_liq [J/(mol.K)]   -- fitted to CoolProp saturated-liquid cp
    coefficients  (130.883  -0.0458741  0.00100991  -5.40672e-07);
    Trange        (249  333);
}

triplePoint
{
    T   119.6000;
    P   0.0000;
}

standardThermochemistry
{
    dHf_298   -172450;      // J/mol ideal-gas -- provenance: see the structured dHf_298 block below
    dGf_298   -2800;      // J/mol  ideal-gas [Joback]
    s_298     380.191;      // J/(mol*K) third-law [DERIVED: (dHf-dGf)/T + CODATA element S]
}

// UNIQUAC van der Waals volume r and surface area q: the sum of the
// record's own UNIFAC groups (3 CH3 + 2 CH2 + 1 CH), R_k/Q_k of Hansen et al. 1991
// (DEV.md 4c C294; bin/curate/uniquac_rq_from_groups.py).
uniquac
{
    r   4.4990;
    q   3.8520;
}

groups
{
    joback ( { group CH3; count 3; } { group CH2; count 2; } { group CH; count 1; } );
    unifac ( { group CH3; count 3; } { group CH2; count 2; } { group CH; count 1; } );
}
liquidThermalConductivity
{
    chemsepEq16
    {
        A     0;
        B     12.15474272;
        C     -1.470898204;
        D     -0.002773639903;
        E     0;
        Tmin  256.5647;
        Tmax  329.1529;
    }
}

provenance
{
    uniquac
    {
        origin        definition;
        method        "sum of UNIFAC group R_k/Q_k: r = sum nu_k R_k = 4.4990, q = sum nu_k Q_k = 3.8520 over the record's unifac groups (3 CH3 + 2 CH2 + 1 CH)";
        citation      "R_k and Q_k of Hansen, Rasmussen, Fredenslund, Schiller & Gmehling, Ind. Eng. Chem. Res. 30 (1991) 2352, as tabulated in data/standards/parameters/UNIFAC/groups.dat; the group sum of Fredenslund, Jones & Prausnitz, AIChE J. 21 (1975) 1086";
    }
    dHf_298
    {
        origin           estimated;
        method           "Joback";
        methodVersion    "joback-poling5e-table2-2";
        input            joback;
        inputFingerprint "CH:1,CH2:2,CH3:3";
        uncertainty      { status unquantified; reason "bulk-import band ~9 kJ/mol, primary basis not verified"; }
    }

    constants      "CoolProp 7.2.0 -- Lemmon-JCED-2006";
    vaporPressure  "Antoine fitted to CoolProp EOS saturation, AAD 0.54%";
    idealGasCp     "polynomial fitted to CoolProp cp0, maxerr 1.72%";
    liquidCp       "polynomial fitted to CoolProp sat-liquid cp, maxerr 0.01%";
    triplePoint    "CoolProp reference EOS triple-point T,P";
    preserved      "from prior proposal (NOT CoolProp): standardThermochemistry, groups";
}
cosmo
{
    VT2005
    {
        model       COSMOSAC;
        variant     "2002";
        source      "VT-2005 sigma-profile database (Mullins et al., Ind. Eng. Chem. Res. 45 (2006) 4389; DFT-COSMO), file VT2005-0010-PROF.txt bundled in usnistgov/COSMOSAC; CAS 107-83-5";
        licence     externalRestricted;   // VT-2005: redistribution NOT confirmed -- values NOT shipped
        installed   false;                 // install your own copy: bin/choupo-import-cosmo (-> data/local/cosmo/VT2005/)
    }
    LVPP-HFTZVP-2018
    {
        model       COSMOSAC;
        variant     "LVPP-HFTZVP-2018";
        protocol    "LVPP-18.07 GAMESS HF/TZVP; r_av 1.4 A; f_decay 3.57; d in A; sigma = q/a";
        source      "LVPP sigma-profile database release 18.07 (github.com/lvpp/sigma, asset HF_TZVP.zip, sha256 bd17aaeebb430641...), file 2-METHYLPENTANE.gout; MIT License, Copyright (c) 2017 LVPP; cite Ferrarini, Flores, Muniz & Soares, AIChE J. 64 (2018) 3443, doi:10.1002/aic.16194, and doi:10.5281/zenodo.3613786; identity: InChIKey AFABGHUZZDYHJO-UHFFFAOYSA-N (full match); formula C6H14; resolved by thirdParty/thermoml/identity.json (PubChem and CACTUS agree)";
        derivation  "segment areas, charges and the cavity volume are LVPP's (GAMESS HF/TZVP COSMO output); `area` is the sum of LVPP's segment areas as binned (GAMESS's printed cavity area agrees within its 2-decimal rounding); the 51-point profile is COMPUTED BY CHOUPO from LVPP's surface segments by bin/curate/lvpp_sigma_profile.py under the protocol above (Bell et al. 2020 Eq. 4 averaging, sigma = q/a, area split linearly between grid nodes)";
        licence     MIT;
        installed   true;
        area        147.996466;   // sum of the profile below; GAMESS prints 148.00
        volume      143.51;
        sigmaProfile  (
               0.000000     0.000000     0.000000     0.000000     0.000000     0.000000
               0.000000     0.000000     0.000000     0.000000     0.000000     0.000000
               0.000000     0.000000     0.000000     0.000000     0.000000     0.000000
               0.000000     0.000000     0.507984     4.931458    13.884454    26.206498
              25.747251    20.594744    19.641681    21.326809    15.142015     0.013572
               0.000000     0.000000     0.000000     0.000000     0.000000     0.000000
               0.000000     0.000000     0.000000     0.000000     0.000000     0.000000
               0.000000     0.000000     0.000000     0.000000     0.000000     0.000000
               0.000000     0.000000     0.000000
        );
    }
    liquidThermalConductivity
    {
        origin        fitted;
        method        "least squares on ln y of ln(k/(W/m/K)) = C + B/T + D T (chemsepEq16 with A = 0, E = 0), 3 parameter(s), then the largest relative error minimised; every laboratory the archive holds for the pure liquid at <= 200 kPa; points beyond 15 % after the first stage discarded by name";
        fittedBy      "bin/curate/transport_fit.py";
        reviewStatus  autoPromoted;
        review        { by none; }   // DEV.md 4c C300 rule 4: nobody has reviewed it
        fitGrade      warning;   // DEV.md 4c C285 limits 5 / 10 / 20 % on the max relative error
        fitGradeBasis inSample;   // DEV.md 4c C300 rule 1
        fitGradeCap   ( singleLaboratory );   // DEV.md 4c C300 rule 2
        fitGradeMaxRelativeError_pct 0.071822;
        Trange        (256.5647 329.1529);   // K, the kept points -- outside it the engine announces an extrapolation
        reviewReason  "regressed by a machine from archive-transcribed measurements; not yet read back against the articles";
        reuse         "Choupo's own regression; the measured points belong to the cited articles and are not reproduced in this record or this tree (DEV.md 4c C327)";
        evidence
        (
                { doi "10.1021/je020125e"; articleSha256 "54bd893201b0cfa28476dd089b1ed51a3c3d2bba1394e9095fcf0a09eafe2fd8"; pointsKept 15; pointsDropped 0; provenance measured; }
        );
        acceptance
        {
            verdict     accepted;
            studies     1;
            pointsKept  15;
            pointsDropped 0;
            dropped     "none";
            aad_pct     0.038852;
            max_pct     0.071822;
        }
    }
}
