/*--------------------------------*- Choupo -*-----------------------*\
  Component: Diacetylene (polyyne soot precursor)
  Ideal-gas formation data and heat capacity READ from
  NASA/TP-2002-211556 (McBride, Zehe & Gordon 2002, "NASA Glenn
  Coefficients for Calculating Thermodynamic Properties of Individual
  Species"), a US government work in the public domain: entry
  "C4H2,butadiyne", appendix D p. 96 (dHf_298 and the NASA-9 Cp coefficients,
  as printed) and Table B1 p. 16 (s_298).  The report's own sources
  for this species: 1,3-Butadiyne. Dorofeeva,1991.
  No liquid phase at process conditions -- the entry is tagged
  `role nonvolatile;` so vapour-pressure routines never get called.
  Re-sourced 2026-11-12 (DEV.md 4c C335) by
  bin/curate/nasa_tp2002_to_choupo.py from the NonCommercial compilation
  this record was first generated from (its old numbers
  are not kept here: they were that compilation's); not yet read back by
  a curator.
  IDENTITY: the report's entry `C4H2,butadiyne` (1,3-butadiyne = diacetylene).
\*---------------------------------------------------------------------------*/

name           C4H2;
formula        C4H2;
CAS            460-12-8;

MW             50.06;       // kg/kmol
role        nonvolatile;
tags           ( gasPhase combustion soot );
reviewStatus   interim;
reviewReason   "transcribed by machine from NASA/TP-2002-211556 and checked against the report itself; not yet read back against the page by a curator";

standardThermochemistry
{
    dHf_298    450000.000;   // J/mol  -- ideal gas; NASA/TP-2002-211556 appendix D, p. 96, entry C4H2,butadiyne
    s_298      250.251;     // J/(mol·K) -- third-law absolute; Table B1, p. 16
}

idealGasHeatCapacity
{
    //  NASA/TP-2002-211556 eq. (1), Cp/R = a1/T^2 + a2/T + a3 + a4 T + a5 T^2
    //  + a6 T^3 + a7 T^4; appendix D, p. 96, entry C4H2,butadiyne, a1..a7 as printed.
    model    NASA9;
    Tlow     200;
    Tcommon  1000;
    Thigh    6000;
    low      ( 2.467542569e+05 -3.897855640e+03 2.366080456e+01 -2.208077805e-02 2.781101140e-05 -1.577340010e-08 3.423165460e-12 );
    high     ( 2.328179913e+06 -8.925186090e+03 2.114326883e+01 -1.368871276e-03 2.327503159e-07 -2.124517624e-11 8.053313020e-16 );
}

provenance
{
    dHf_298
    {
        origin        literature;
        method        "NASA/TP-2002-211556 appendix D, p. 96, entry C4H2,butadiyne, record-line H(298.15) (elements reference, so = dHf)";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "Table B1 p. 16 prints 450.0 kJ/mol; the report's own sources: 1,3-Butadiyne. Dorofeeva,1991.";
    }
    s_298
    {
        origin        literature;
        method        "NASA/TP-2002-211556 Table B1, p. 16, entry C4H2,butadiyne";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "appendix D's coefficients with b2 integrate to 250.251";
    }
    idealGasHeatCapacity
    {
        origin        literature;
        method        "NASA/TP-2002-211556 appendix D, p. 96, entry C4H2,butadiyne, a1..a7 of the 200-1000 K and 1000-6000 K intervals, as printed";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "read by bin/curate/nasa_tp2002_to_choupo.py, which holds H and S at 298.15 K to the printed values";
    }
    source   "McBride, Zehe & Gordon, NASA Glenn Coefficients for Calculating Thermodynamic Properties of Individual Species, NASA/TP-2002-211556 (2002)";
    licence  publicDomain;    // US government work (NASA), 17 U.S.C. 105
}
