// record's own UNIFAC groups (1 CH2 + 1 CH3 + 1 CH_C), R_k/Q_k of Hansen et al. 1991
// (DEV.md 4c C294; bin/curate/uniquac_rq_from_groups.py).
uniquac
{
    r   2.8675;
    q   2.4760;
}

groups
{
    unifac ( { group CH2; count 1; } { group CH3; count 1; } { group CH_C; count 1; } );   // derived from structure CCC#C by bin/curate/unifac_groups.py
}

