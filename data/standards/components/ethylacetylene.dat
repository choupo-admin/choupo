    s_298     290.39;        // J/(mol.K)  third-law absolute
}

vaporPressure
{
    model         Antoine;
    // log10(Psat [bar]) = A - B / (T[K] + C)
    // converted EXACTLY from ChemSep eqno 10, Psat[Pa] = exp(a - b/(T+c))
    coefficients  (4.194882771  1034.18545  -34.36);
    Trange        (264.46  393.8);
}

Vliq        8.3555e-05;      // m3/mol at 25 C  [ChemSep eqno 105]
HvapTb      24495;      // J/mol at Tb  [ChemSep eqno 106]

idealGasHeatCapacity
{
    model         chemsepCp16;
    // Cp [J/(mol.K)] = A + exp(B/T + C + D T + E T^2)
    // ChemSep states J/(kmol.K); A and the exp are scaled to per-mole here.
    coefficients  (44.709  -441.89  4.981244721  0.00039371  -1.2645e-07);
    Trange        (150  1500);
}

