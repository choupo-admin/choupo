    // measured vapour pressures -- see provenance.vaporPressure
    coefficients  (5.195104285  2142.913839  -46.82344612);
    Trange        (363.15  453.15);   // the fit's own span; outside it the engine announces the extrapolation
}

Vliq        1.781258e-04;      // m3/mol at 25 C, FITTED (provenance.Vliq)

idealGasHeatCapacity
{
    model         polynomial;
    // Cp [J/(mol K)] = a0 + a1 T + a2 T^2 + a3 T^3, Joback ESTIMATE
    coefficients  (72.116  0.57424  -7.840000e-05  -8.040000e-08);
    Trange        (273  1000);
}

liquidHeatCapacity
{
    model         polynomial;
    // Cp [J/(mol K)] = a0 + a1 T + a2 T^2, FITTED (provenance.liquidHeatCapacity)
    coefficients  (419.7579891  -0.6474563232  0.001343021878);
    Trange        (312.57  421.48);
}

groups
{
    unifac ( { group CH3; count 2; } { group CH2; count 3; } { group CH2O; count 3; } );
    joback ( { group CH3; count 2; } { group CH2; count 6; } { group ether; count 3; } );
}

