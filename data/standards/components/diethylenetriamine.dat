// UNIQUAC van der Waals volume r and surface area q: the sum of the
// record's own UNIFAC groups (1 CH2 + 1 CH2NH + 2 CH2NH2), R_k/Q_k of Hansen et al. 1991
// (DEV.md 4c C294; bin/curate/uniquac_rq_from_groups.py).
uniquac
{
    r   4.6198;
    q   3.9480;
}

groups
{
    unifac ( { group CH2; count 1; } { group CH2NH; count 1; } { group CH2NH2; count 2; } );   // derived from structure NCCNCCN by bin/curate/unifac_groups.py
}

//  HANSEN solubility-parameter triple (DEV.md 4c C428; read by `hansenMixture`
//  and the Explorer's solvent lens).  Hansen 1969, Table I row N16 "Diethylenetriamine":
//  delta_d = 8.15, delta_p = 6.5, delta_h = 7.0 (cal/cm3)^0.5, x sqrt(4.184e6) = 2045.4828.
hansen
{
    dD    16670.7;        // Pa^0.5   = 8.15 (cal/cm3)^0.5, Table I row N16
    dP    13295.6;        // Pa^0.5   = 6.5
    dH    14318.4;        // Pa^0.5   = 7.0
    Tref  298.15 K;       // adopted: the paper prints no temperature beside Table I
}

