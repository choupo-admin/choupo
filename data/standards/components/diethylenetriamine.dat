    s_298     444;        // J/(mol.K)  third-law absolute
}

vaporPressure
{
    model         Antoine;
    // log10(Psat [bar]) = A - B / (T[K] + C)
    // converted EXACTLY from ChemSep eqno 10, Psat[Pa] = exp(a - b/(T+c))
    coefficients  (5.046968544  2236.573152  -36.704);
    Trange        (420.19  606.23);
}

Vliq        0.000108153;      // m3/mol at 25 C  [ChemSep eqno 105]
HvapTb      47544.7;      // J/mol at Tb  [ChemSep eqno 106]

idealGasHeatCapacity
{
    model         chemsepCp16;
    // Cp [J/(mol.K)] = A + exp(B/T + C + D T + E T^2)
    // ChemSep states J/(kmol.K); A and the exp are scaled to per-mole here.
    coefficients  (73.737  -451.7  5.797244721  0.00030197  -1.0181e-07);
    Trange        (273  1500);
}

liquidHeatCapacity
{
    model         chemsepCp16;
    // Cp [J/(mol.K)] = A + exp(B/T + C + D T + E T^2)
    coefficients  (42.291  -130.86  4.788244721  0.0024243  -1.1576e-06);
    Trange        (338  498);
}

