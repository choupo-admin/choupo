// UNIQUAC van der Waals volume r and surface area q: the sum of the
// record's own UNIFAC groups (1 CH3 + 4 CH2 + 1 CH), R_k/Q_k of Hansen et al. 1991
// (DEV.md 4c C294; bin/curate/uniquac_rq_from_groups.py).
uniquac
{
    r   4.0456;
    q   3.2360;
}

groups
{
    unifac ( { group CH3; count 1; } { group CH2; count 4; } { group CH; count 1; } );
}
