Pc          52.26121;        // bar      [CoolProp EOS]
omega       0.26858;        // [-]      [CoolProp EOS]
Tb          356.6496;        // K  normal boiling [CoolProp]
HvapTb      32090.3;        // J/mol  at Tb     [CoolProp]
Vliq        7.9463e-05;        // m3/mol @298K     [CoolProp]
