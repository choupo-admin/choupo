\*---------------------------------------------------------------------------*/

name        2Methyltetrahydrofuran;
CAS         96-47-9;
formula     C5H10O;
reviewStatus autoPromoted;
humanReviewed false;
MW          86.1340;      // kg/kmol, from the formula (IUPAC standard atomic weights)
Tc          553.653;      // K, Joback ESTIMATE (provenance.Tc)
Pc          42.8866;      // bar, Joback ESTIMATE (provenance.Pc)
omega       0.206016;      // [-] (provenance.omega)
Tb          356.23;      // K, Joback ESTIMATE (provenance.Tb)

standardThermochemistry
{
    dHf_298   -218050;        // J/mol, ideal gas, Joback ESTIMATE (provenance.dHf_298)
    s_298     249.04;        // J/(mol K), ideal gas, DERIVED from Joback (provenance.s_298)
}

vaporPressure
{
    model         Antoine;
    // log10(Psat [bar]) = A - B / (T[K] + C), FITTED by bin/choupo-curate vp to
    // measured vapour pressures -- see provenance.vaporPressure
    coefficients  (4.17668046  1289.165475  -43.81402278);
    Trange        (279  508.21);   // the fit's own span; outside it the engine announces the extrapolation
}

Vliq        1.014866e-04;      // m3/mol at 25 C, FITTED (provenance.Vliq)

idealGasHeatCapacity
{
    model         polynomial;
    // Cp [J/(mol K)] = a0 + a1 T + a2 T^2 + a3 T^3, Joback ESTIMATE
    coefficients  (-44.82  0.60752  -3.617000e-04  7.910000e-08);
    Trange        (273  1000);
}

liquidHeatCapacity
{
    model         polynomial;
    // Cp [J/(mol K)] = a0 + a1 T + a2 T^2, FITTED (provenance.liquidHeatCapacity)
    coefficients  (172.7629055  -0.4422711401  0.00130440223);
    Trange        (288.15  323.15);
}

