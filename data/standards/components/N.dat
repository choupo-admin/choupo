/*--------------------------------*- Choupo -*-----------------------*\
  Component: Atomic nitrogen radical (Zeldovich chain carrier for thermal NOx)
  Ideal-gas formation data and heat capacity READ from
  NASA/TP-2002-211556 (McBride, Zehe & Gordon 2002, "NASA Glenn
  Coefficients for Calculating Thermodynamic Properties of Individual
  Species"), a US government work in the public domain: entry
  "N", appendix D p. 152 (dHf_298 and the NASA-9 Cp coefficients,
  as printed) and Table B1 p. 24 (s_298).  The report's own sources
  for this species: Hf:Cox,1989. Moore,1975. Gordon,1999.
  No liquid phase at process conditions -- the entry is tagged
  `role nonvolatile;` so vapour-pressure routines never get called.
  Re-sourced 2026-11-01 (DEV.md 4c C170 item 4) by
  bin/curate/nasa_tp2002_to_choupo.py from the NonCommercial compilation
  this record was first generated from: the report's values
  agree with the old ones to within dHf 0.5 kJ/mol, s 0.02 J/(mol K)
  and Cp 2 % (the record's own old Trange), and replace them; not yet
  read back by a curator.
\*---------------------------------------------------------------------------*/

name           N;
formula        N;
CAS            17778-88-0;

MW             14.007;       // kg/kmol
role        nonvolatile;
tags           ( radical gasPhase combustion );
reviewStatus   interim;
reviewReason   "transcribed by machine from NASA/TP-2002-211556 and checked against the report itself; not yet read back against the page by a curator";

standardThermochemistry
{
    dHf_298    472680.000;   // J/mol  -- ideal gas; NASA/TP-2002-211556 appendix D, p. 152, entry N
    s_298      153.302;     // J/(mol·K) -- third-law absolute; Table B1, p. 24
}


idealGasHeatCapacity
{
    //  NASA/TP-2002-211556 eq. (1), Cp/R = a1/T^2 + a2/T + a3 + a4 T + a5 T^2
    //  + a6 T^3 + a7 T^4; appendix D, p. 152, entry N, a1..a7 as printed.
    //  The report's 6000-20000 K interval is not transcribed.
    model    NASA9;
    Tlow     200;
    Tcommon  1000;
    Thigh    6000;
    low      ( 0.000000000e+00 0.000000000e+00 2.500000000e+00 0.000000000e+00 0.000000000e+00 0.000000000e+00 0.000000000e+00 );
    high     ( 8.876501380e+04 -1.071231500e+02 2.362188287e+00 2.916720081e-04 -1.729515100e-07 4.012657880e-11 -2.677227571e-15 );
}

provenance
{
    dHf_298
    {
        origin        literature;
        method        "NASA/TP-2002-211556 appendix D, p. 152, entry N, record-line H(298.15) (elements reference, so = dHf)";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "Table B1 p. 24 prints 472.68 kJ/mol; the report's own sources: Hf:Cox,1989. Moore,1975. Gordon,1999.";
    }
    s_298
    {
        origin        literature;
        method        "NASA/TP-2002-211556 Table B1, p. 24, entry N";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "appendix D's coefficients with b2 integrate to 153.302";
    }
    idealGasHeatCapacity
    {
        origin        literature;
        method        "NASA/TP-2002-211556 appendix D, p. 152, entry N, a1..a7 of the 200-1000 K and 1000-6000 K intervals, as printed";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "read by bin/curate/nasa_tp2002_to_choupo.py, which holds H and S at 298.15 K to the printed values";
    }
    source   "McBride, Zehe & Gordon, NASA Glenn Coefficients for Calculating Thermodynamic Properties of Individual Species, NASA/TP-2002-211556 (2002)";
    licence  publicDomain;    // US government work (NASA), 17 U.S.C. 105
}
