// UNIQUAC van der Waals volume r and surface area q: the sum of the
// record's own UNIFAC groups (1 CH3 + 6 CH2 + 1 CH2=CH), R_k/Q_k of Hansen et al. 1991
// (DEV.md 4c C294; bin/curate/uniquac_rq_from_groups.py).
uniquac
{
    r   6.2929;
    q   5.2640;
}

groups
{
    unifac ( { group CH3; count 1; } { group CH2; count 6; } { group CH2=CH; count 1; } );
}
