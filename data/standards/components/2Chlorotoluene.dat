/*--------------------------------*- Choupo -*-----------------------*\
  Component: 2Chlorotoluene  (2-chlorotoluene; CAS 95-49-8)
  NEW in the catalogue (DEV.md 4c C292, slice 2 of C287, 2026-11-10), built by
  bin/curate/c287_new_components.py from measurements the NIST/TRC ThermoML Archive
  locates (the articles are the sources; their DOIs are in provenance).
  MEASURED: no critical constant, no Tb.  FITTED: vapour pressure (bin/choupo-curate vp),
  Vliq, liquid Cp.  DERIVED: omega (from the fitted vapour pressure at the ESTIMATED Tc).
  ESTIMATED (Joback): Tc, Pc, ideal-gas Cp, dHf_298; s_298 derived from Joback's
  dHf and dGf.  No measured series is reproduced here.
  reviewStatus autoPromoted, humanReviewed false: NO human has read it back.
  Psat: fitted by `bin/choupo-curate vp`; its promotion replaced the
  AmbroseWalton block this tool writes (provenance.vaporPressure).
\*---------------------------------------------------------------------------*/

name        2Chlorotoluene;
CAS         95-49-8;
formula     C7H7Cl;
reviewStatus autoPromoted;
humanReviewed false;
MW          126.5830;      // kg/kmol, from the formula (IUPAC standard atomic weights)
Tc          650.172682;      // K, Joback ESTIMATE (provenance.Tc)
Pc          38.5308792;      // bar, Joback ESTIMATE (provenance.Pc)
omega       0.316820;      // [-] (provenance.omega)
//  Tb: NOT DECLARED -- the archive reports no boiling temperature at
//  101.3 kPa for it, and a Tb read back off the fitted Antoine would be
//  the curve tested against itself (the fitted normal boiling point is
//  in provenance.vaporPressure.acceptance.Tnb_fit).  Joback's Tb is NOT stored either: the vapour-pressure
//  grade would read an estimate as a measurement (WRITE_ESTIMATED_TB in
//  the tool); the case data/curation/batches/new_components_estimated prints it.

standardThermochemistry
{
    dHf_298   21510;        // J/mol, ideal gas, Joback ESTIMATE (provenance.dHf_298)
    s_298     349.50;        // J/(mol K), ideal gas, DERIVED from Joback (provenance.s_298)
}

vaporPressure
{
    model         Antoine;
    // log10(Psat [bar]) = A - B / (T[K] + C), FITTED by bin/choupo-curate vp to
    // measured vapour pressures -- see provenance.vaporPressure
    coefficients  (4.327301002  1624.839183  -54.74771296);
    Trange        (274.2  428.76);   // the fit's own span; outside it the engine announces the extrapolation
}

Vliq        1.174601e-04;      // m3/mol at 25 C, FITTED (provenance.Vliq)

idealGasHeatCapacity
{
    model         polynomial;
    // Cp [J/(mol K)] = a0 + a1 T + a2 T^2 + a3 T^3, Joback ESTIMATE
    coefficients  (-10.19  0.53722  -3.415600e-04  8.170000e-08);
    Trange        (273  1000);
}

liquidHeatCapacity
{
    model         polynomial;
    // Cp [J/(mol K)] = a0 + a1 T + a2 T^2, FITTED (provenance.liquidHeatCapacity)
    coefficients  (73.25340822  0.3520586732);
    Trange        (293.15  308.15);
}

groups
{
    joback ( { group CH3; count 1; } { group arC; count 2; } { group arCH; count 4; } { group Cl; count 1; } );
}

