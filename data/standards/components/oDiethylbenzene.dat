// UNIQUAC van der Waals volume r and surface area q: the sum of the
// record's own UNIFAC groups (2 CH3 + 4 ACH + 2 ACCH2), R_k/Q_k of Hansen et al. 1991
// (DEV.md 4c C294; bin/curate/uniquac_rq_from_groups.py).
uniquac
{
    r   6.0066;
    q   4.6160;
}

groups
{
    unifac ( { group CH3; count 2; } { group ACH; count 4; } { group ACCH2; count 2; } );
}
