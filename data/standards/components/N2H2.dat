/*--------------------------------*- Choupo -*-----------------------*\
  Component: Diazene/diimide (NH2 recombination; DeNOx ladder)
  Ideal-gas formation data and heat capacity READ from
  NASA/TP-2002-211556 (McBride, Zehe & Gordon 2002, "NASA Glenn
  Coefficients for Calculating Thermodynamic Properties of Individual
  Species"), a US government work in the public domain: entry
  "N2H2", appendix D p. 157 (dHf_298 and the NASA-9 Cp coefficients,
  as printed) and Table B1 p. 25 (s_298).  The report's own sources
  for this species: Gurvich,1989 pt1 p356.Trans,cis,& 1,1 in equilibrium.
  No liquid phase at process conditions -- the entry is tagged
  `role nonvolatile;` so vapour-pressure routines never get called.
  Re-sourced 2026-11-12 (DEV.md 4c C335) by
  bin/curate/nasa_tp2002_to_choupo.py from the NonCommercial compilation
  this record was first generated from (its old numbers
  are not kept here: they were that compilation's); not yet read back by
  a curator.
  IDENTITY: this record names DIAZENE (HN=NH), the report's entry `N2H2`
  (its note: trans, cis and 1,1 in equilibrium).  The value the record held
  before was isodiazene's (H2N=N); the change of number is a correction of identity as well as of source.
\*---------------------------------------------------------------------------*/

name           N2H2;
formula        N2H2;
CAS            n/a;        // radical registry number: pending curation

MW             30.03;       // kg/kmol
role        nonvolatile;
tags           ( radical gasPhase combustion nox );
reviewStatus   interim;
reviewReason   "transcribed by machine from NASA/TP-2002-211556 and checked against the report itself; not yet read back against the page by a curator";

standardThermochemistry
{
    dHf_298    211858.756;   // J/mol  -- ideal gas; NASA/TP-2002-211556 appendix D, p. 157, entry N2H2
    s_298      218.333;     // J/(mol·K) -- third-law absolute; Table B1, p. 25
}

idealGasHeatCapacity
{
    //  NASA/TP-2002-211556 eq. (1), Cp/R = a1/T^2 + a2/T + a3 + a4 T + a5 T^2
    //  + a6 T^3 + a7 T^4; appendix D, p. 157, entry N2H2, a1..a7 as printed.
    model    NASA9;
    Tlow     200;
    Tcommon  1000;
    Thigh    6000;
    low      ( -1.504005163e+05 2.346687716e+03 -9.405430290e+00 3.284299800e-02 -3.121920401e-05 1.721283190e-08 -4.014537220e-12 );
    high     ( 6.217567870e+06 -1.753952096e+04 2.022730509e+01 -9.757297660e-04 -4.208416740e-07 1.117921171e-10 -7.627102210e-15 );
}

provenance
{
    dHf_298
    {
        origin        literature;
        method        "NASA/TP-2002-211556 appendix D, p. 157, entry N2H2, record-line H(298.15) (elements reference, so = dHf)";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "Table B1 p. 25 prints 211.859 kJ/mol; the report's own sources: Gurvich,1989 pt1 p356.Trans,cis,& 1,1 in equilibrium.";
    }
    s_298
    {
        origin        literature;
        method        "NASA/TP-2002-211556 Table B1, p. 25, entry N2H2";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "appendix D's coefficients with b2 integrate to 218.333";
    }
    idealGasHeatCapacity
    {
        origin        literature;
        method        "NASA/TP-2002-211556 appendix D, p. 157, entry N2H2, a1..a7 of the 200-1000 K and 1000-6000 K intervals, as printed";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "read by bin/curate/nasa_tp2002_to_choupo.py, which holds H and S at 298.15 K to the printed values";
    }
    source   "McBride, Zehe & Gordon, NASA Glenn Coefficients for Calculating Thermodynamic Properties of Individual Species, NASA/TP-2002-211556 (2002)";
    licence  publicDomain;    // US government work (NASA), 17 U.S.C. 105
}
