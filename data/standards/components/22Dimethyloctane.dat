    coefficients  (4.314313753  1635.596448  -50.805);
    Trange        (225  602);
}

Vliq        0.000197441;      // m3/mol at 25 C  [ChemSep eqno 105]
HvapTb      37304.6;      // J/mol at Tb  [ChemSep eqno 106]

idealGasHeatCapacity
{
    model         chemsepCp16;
    // Cp [J/(mol.K)] = A + exp(B/T + C + D T + E T^2)
    // ChemSep states J/(kmol.K); A and the exp are scaled to per-mole here.
    coefficients  (133.3  -582.81  6.582244721  4.9115e-05  -1.5637e-08);
    Trange        (150  1500);
}

