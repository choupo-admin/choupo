/*--------------------------------*- Choupo -*-----------------------*\
  Component: Ethane  (C2H6, CAS 74-84-0)

  Second-largest component of natural gas after methane.  The classic
  feedstock for the steam cracker; the C2H6 / C2H4 / H2 / C / CO2 /
  H2O equilibrium at ~1100 K is a standard GibbsReactor exercise.
  Sources: constants (Tc/Pc/omega/MW/Tb) cross-checked vs CoolProp 7.2.0
  reference EOS; standardThermochemistry cross-checked vs NASA TM-4513
  (McBride-Gordon-Reno 1993); idealGasHeatCapacity -- individual
  literature value, primary re-citation pending (IST review).
\*---------------------------------------------------------------------------*/

name        ethane;
formula     C2H6;
CAS         74-84-0;

MW          30.070;            // kg/kmol
Tc          305.32;             // K
Pc          48.72;              // bar
omega       0.099;              // [-]
Tb          184.55;             // K
HvapTb      14690;              // J/mol
Vliq        5.51e-5;            // m^3/mol
//  ANCHOR, never an input.  The engine DERIVES the Hildebrand
//  parameter from HvapTb and Vliq (the tree stores no derivative);
//  this is what ChemSep v8.3 computed independently, so the
//  derivation has something to be wrong against.
solubilityParameter 12400;   // Pa^0.5  [anchor, ChemSep v8.3, Artistic-2.0]

standardThermochemistry
{
    dHf_298    -84680.0;        // J/mol  -- ideal-gas reference
    s_298      229.16;          // J/(mol·K)
}

vaporPressure
{
    model         Antoine;
    coefficients  (3.93835   659.739   -16.719);
    Trange        (168  305);
}

idealGasHeatCapacity
{
    model         polynomial;
    coefficients  (5.409   0.1781   -6.938e-5   8.713e-9);
    Trange        (250  1500);
}

groups
{
    unifac ( { group CH3; count 2; } );
    joback ( { group CH3; count 2; } );
}

// Friendly-name aliases -- resolved to this file via the generated ALIASES index.
aliases ( C2H6 );

cosmo
{
    VT2005
    {
        model       COSMOSAC;
        variant     "2002";
        source      "VT-2005 sigma-profile database (Mullins et al., Ind. Eng. Chem. Res. 45 (2006) 4389; DFT-COSMO), file VT2005-0002-PROF.txt bundled in usnistgov/COSMOSAC; CAS 74-84-0";
        licence     externalRestricted;   // VT-2005: redistribution NOT confirmed -- values NOT shipped
        installed   false;                 // install your own copy: bin/choupo-import-cosmo (-> data/local/cosmo/VT2005/)
    }
    LVPP-HFTZVP-2018
    {
        model       COSMOSAC;
        variant     "LVPP-HFTZVP-2018";
        protocol    "LVPP-18.07 GAMESS HF/TZVP; r_av 1.4 A; f_decay 3.57; d in A; sigma = q/a";
        source      "LVPP sigma-profile database release 18.07 (github.com/lvpp/sigma, asset HF_TZVP.zip, sha256 bd17aaeebb430641...), file ETHANE.gout; MIT License, Copyright (c) 2017 LVPP; cite Ferrarini, Flores, Muniz & Soares, AIChE J. 64 (2018) 3443, doi:10.1002/aic.16194, and doi:10.5281/zenodo.3613786; identity: InChIKey OTMSDBZUPAUEDD-UHFFFAOYSA-N (full match); formula C2H6; resolved by thirdParty/thermoml/identity.json (PubChem and CACTUS agree)";
        derivation  "segment areas, charges and the cavity volume are LVPP's (GAMESS HF/TZVP COSMO output); `area` is the sum of LVPP's segment areas as binned (GAMESS's printed cavity area agrees within its 2-decimal rounding); the 51-point profile is COMPUTED BY CHOUPO from LVPP's surface segments by bin/curate/lvpp_sigma_profile.py under the protocol above (Bell et al. 2020 Eq. 4 averaging, sigma = q/a, area split linearly between grid nodes)";
        licence     MIT;
        installed   true;
        area        77.011530;   // sum of the profile below; GAMESS prints 77.01
        volume      58.51;
        sigmaProfile  (
               0.000000     0.000000     0.000000     0.000000     0.000000     0.000000
               0.000000     0.000000     0.000000     0.000000     0.000000     0.000000
               0.000000     0.000000     0.000000     0.000000     0.000000     0.000000
               0.000000     0.000000     0.000000     2.603228    10.406542    13.950171
               8.940157     9.281528    12.683448    15.490854     3.655602     0.000000
               0.000000     0.000000     0.000000     0.000000     0.000000     0.000000
               0.000000     0.000000     0.000000     0.000000     0.000000     0.000000
               0.000000     0.000000     0.000000     0.000000     0.000000     0.000000
               0.000000     0.000000     0.000000
        );
    }
}
