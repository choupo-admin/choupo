/*--------------------------------*- Choupo -*-----------------------*\
  Component: Nitrous acid, gas (NOx reservoir; deNOx chemistry)
  Ideal-gas formation data and heat capacity READ from
  NASA/TP-2002-211556 (McBride, Zehe & Gordon 2002, "NASA Glenn
  Coefficients for Calculating Thermodynamic Properties of Individual
  Species"), a US government work in the public domain: entry
  "HNO2", appendix D p. 129 (dHf_298 and the NASA-9 Cp coefficients,
  as printed) and Table B1 p. 21 (s_298).  The report's own sources
  for this species: Cis-trans. Gurvich,1989 pt1 p363 pt2 p228.
  No liquid phase at process conditions -- the entry is tagged
  `role nonvolatile;` so vapour-pressure routines never get called.
  Re-sourced 2026-11-12 (DEV.md 4c C335) by
  bin/curate/nasa_tp2002_to_choupo.py from the NonCommercial compilation
  this record was first generated from (its old numbers
  are not kept here: they were that compilation's); not yet read back by
  a curator.
  IDENTITY: the report files nitrous acid under the formula `HNO2`
  (its note: cis-trans); this record keeps its name HONO.
\*---------------------------------------------------------------------------*/

name           HONO;
formula        HONO;
CAS            7782-77-6;

MW             47.013;       // kg/kmol
role        nonvolatile;
tags           ( gasPhase combustion nox );
reviewStatus   interim;
reviewReason   "transcribed by machine from NASA/TP-2002-211556 and checked against the report itself; not yet read back against the page by a curator";

standardThermochemistry
{
    dHf_298    -78451.922;   // J/mol  -- ideal gas; NASA/TP-2002-211556 appendix D, p. 129, entry HNO2
    s_298      254.071;     // J/(mol·K) -- third-law absolute; Table B1, p. 21
}

idealGasHeatCapacity
{
    //  NASA/TP-2002-211556 eq. (1), Cp/R = a1/T^2 + a2/T + a3 + a4 T + a5 T^2
    //  + a6 T^3 + a7 T^4; appendix D, p. 129, entry HNO2, a1..a7 as printed.
    model    NASA9;
    Tlow     200;
    Tcommon  1000;
    Thigh    6000;
    low      ( 8.591985060e+03 1.203644046e+02 9.412979120e-01 1.942891839e-02 -2.253174194e-05 1.384587594e-08 -3.473550460e-12 );
    high     ( 8.787904130e+05 -3.990455030e+03 1.187349269e+01 -4.881900610e-04 7.133636790e-08 -5.376303340e-12 1.581778986e-16 );
}

cosmo
{
    LVPP-HFTZVP-2018
    {
        model       COSMOSAC;
        variant     "LVPP-HFTZVP-2018";
        protocol    "LVPP-18.07 GAMESS HF/TZVP; r_av 1.4 A; f_decay 3.57; d in A; sigma = q/a";
        source      "LVPP sigma-profile database release 18.07 (github.com/lvpp/sigma, asset HF_TZVP.zip, sha256 bd17aaeebb430641...), file NITROUS_ACID.gout; MIT License, Copyright (c) 2017 LVPP; cite Ferrarini, Flores, Muniz & Soares, AIChE J. 64 (2018) 3443, doi:10.1002/aic.16194, and doi:10.5281/zenodo.3613786; identity: InChIKey IOVCWXUNBOPUCH-UHFFFAOYSA-N (full match); formula HNO2; resolved by thirdParty/thermoml/identity.json (PubChem and CACTUS agree)";
        derivation  "segment areas, charges and the cavity volume are LVPP's (GAMESS HF/TZVP COSMO output); `area` is the sum of LVPP's segment areas as binned (GAMESS's printed cavity area agrees within its 2-decimal rounding); the 51-point profile is COMPUTED BY CHOUPO from LVPP's surface segments by bin/curate/lvpp_sigma_profile.py under the protocol above (Bell et al. 2020 Eq. 4 averaging, sigma = q/a, area split linearly between grid nodes)";
        licence     MIT;
        installed   true;
        area        67.043140;   // sum of the profile below; GAMESS prints 67.04
        volume      47.73;
        sigmaProfile  (
               0.000000     0.000000     0.000000     0.766037     2.295669     0.455273
               0.958114     1.779541     1.015052     0.335436     0.331310     0.433976
               0.394166     0.071297     0.531666     0.776094     0.789290     0.971759
               1.925037     2.150624     2.419655     1.467024     1.683041     1.905561
               2.611967     1.999007     1.834636     2.902274     3.416631     2.959714
               5.059593     5.164230     5.059590     3.603466     5.215171     1.485612
               1.727917     0.547710     0.000000     0.000000     0.000000     0.000000
               0.000000     0.000000     0.000000     0.000000     0.000000     0.000000
               0.000000     0.000000     0.000000
        );
    }
}

provenance
{
    dHf_298
    {
        origin        literature;
        method        "NASA/TP-2002-211556 appendix D, p. 129, entry HNO2, record-line H(298.15) (elements reference, so = dHf)";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "Table B1 p. 21 prints -78.452 kJ/mol; the report's own sources: Cis-trans. Gurvich,1989 pt1 p363 pt2 p228.";
    }
    s_298
    {
        origin        literature;
        method        "NASA/TP-2002-211556 Table B1, p. 21, entry HNO2";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "appendix D's coefficients with b2 integrate to 254.071";
    }
    idealGasHeatCapacity
    {
        origin        literature;
        method        "NASA/TP-2002-211556 appendix D, p. 129, entry HNO2, a1..a7 of the 200-1000 K and 1000-6000 K intervals, as printed";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "read by bin/curate/nasa_tp2002_to_choupo.py, which holds H and S at 298.15 K to the printed values";
    }
    source   "McBride, Zehe & Gordon, NASA Glenn Coefficients for Calculating Thermodynamic Properties of Individual Species, NASA/TP-2002-211556 (2002)";
