// UNIQUAC van der Waals volume r and surface area q: the sum of the
// record's own UNIFAC groups (3 CH3 + 4 CH2 + 1 CH), R_k/Q_k of Hansen et al. 1991
// (DEV.md 4c C294; bin/curate/uniquac_rq_from_groups.py).
uniquac
{
    r   5.8478;
    q   4.9320;
}

groups
{
    unifac ( { group CH3; count 3; } { group CH2; count 4; } { group CH; count 1; } );
}
