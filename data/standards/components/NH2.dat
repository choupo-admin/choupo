/*--------------------------------*- Choupo -*-----------------------*\
  Component: Amidogen radical (intermediate in fuel-NOx and SCR pathways)
  Ideal-gas formation data and heat capacity READ from
  NASA/TP-2002-211556 (McBride, Zehe & Gordon 2002, "NASA Glenn
  Coefficients for Calculating Thermodynamic Properties of Individual
  Species"), a US government work in the public domain: entry
  "NH2", appendix D p. 154 (dHf_298 and the NASA-9 Cp coefficients,
  as printed) and Table B1 p. 24 (s_298).  The report's own sources
  for this species: Hf:Anderson,1989. Gurvich,1989 pt1 p349.Jacox,1998 p133.
  No liquid phase at process conditions -- the entry is tagged
  `role nonvolatile;` so vapour-pressure routines never get called.
  Re-sourced 2026-11-12 (DEV.md 4c C335) by
  bin/curate/nasa_tp2002_to_choupo.py from the NonCommercial compilation
  this record was first generated from (its old numbers
  are not kept here: they were that compilation's); not yet read back by
  a curator.
\*---------------------------------------------------------------------------*/

name           NH2;
formula        NH2;
CAS            13770-40-6;

MW             16.0226;       // kg/kmol
role        nonvolatile;
tags           ( radical gasPhase combustion );
reviewStatus   interim;
reviewReason   "transcribed by machine from NASA/TP-2002-211556 and checked against the report itself; not yet read back against the page by a curator";

standardThermochemistry
{
    dHf_298    189134.713;   // J/mol  -- ideal gas; NASA/TP-2002-211556 appendix D, p. 154, entry NH2
    s_298      194.996;     // J/(mol·K) -- third-law absolute; Table B1, p. 24
}

idealGasHeatCapacity
{
    //  NASA/TP-2002-211556 eq. (1), Cp/R = a1/T^2 + a2/T + a3 + a4 T + a5 T^2
    //  + a6 T^3 + a7 T^4; appendix D, p. 154, entry NH2, a1..a7 as printed.
    model    NASA9;
    Tlow     200;
    Tcommon  1000;
    Thigh    6000;
    low      ( -3.118240659e+04 4.754243390e+02 1.372395176e+00 6.306429720e-03 -5.987893560e-06 4.492752340e-09 -1.414073548e-12 );
    high     ( 2.111053740e+06 -6.880627230e+03 1.132305924e+01 -1.829236741e-03 5.643890090e-07 -7.886452480e-11 4.078593450e-15 );
}

provenance
{
    dHf_298
    {
        origin        literature;
        method        "NASA/TP-2002-211556 appendix D, p. 154, entry NH2, record-line H(298.15) (elements reference, so = dHf)";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "Table B1 p. 24 prints 189.135 kJ/mol; the report's own sources: Hf:Anderson,1989. Gurvich,1989 pt1 p349.Jacox,1998 p133.";
    }
    s_298
    {
        origin        literature;
        method        "NASA/TP-2002-211556 Table B1, p. 24, entry NH2";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "appendix D's coefficients with b2 integrate to 194.996";
    }
    idealGasHeatCapacity
    {
        origin        literature;
        method        "NASA/TP-2002-211556 appendix D, p. 154, entry NH2, a1..a7 of the 200-1000 K and 1000-6000 K intervals, as printed";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "read by bin/curate/nasa_tp2002_to_choupo.py, which holds H and S at 298.15 K to the printed values";
    }
    source   "McBride, Zehe & Gordon, NASA Glenn Coefficients for Calculating Thermodynamic Properties of Individual Species, NASA/TP-2002-211556 (2002)";
    licence  publicDomain;    // US government work (NASA), 17 U.S.C. 105
}
