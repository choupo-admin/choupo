{
    chemsepEq101
    {
        A     -23.973;
        B     1681.2;
        C     1.9315;
        D     6.328e-08;
        E     2;
        Tmin  220;
        Tmax  435.16;
    }
}

liquidThermalConductivity
{
    chemsepEq16
    {
        A     -0.065655;
        B     1.2156;
        C     -1.4285;
        D     -0.00047761;
        E     -9.6417e-07;
        Tmin  210.83;
        Tmax  435.16;
    }
}

// UNIQUAC van der Waals volume r and surface area q: the sum of the
// record's own UNIFAC groups (1 CH3 + 4 ACH + 1 ACCH3 + 1 ACCH2), R_k/Q_k of Hansen et al. 1991
// (DEV.md 4c C294; bin/curate/uniquac_rq_from_groups.py).
uniquac
{
    r   5.3322;
    q   4.0760;
}

groups
{
    unifac ( { group CH3; count 1; } { group ACH; count 4; } { group ACCH3; count 1; } { group ACCH2; count 1; } );
}
solubilityParameter 17710;   // Pa^0.5  [ANCHOR, ChemSep v8.3 -- checked against, never used]

