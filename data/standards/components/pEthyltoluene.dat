name        pEthyltoluene;
CAS         622-96-8;
formula     C9H12;      // counted from the ChemSep v8.3 structure formula "CH3(C6H4)CH2CH3" (derived 2026-09-03; reproduces MW to 0.003 %)
reviewStatus interim;
MW          120.1916;      // kg/kmol [origin=ChemSep v8.3]
Tc          640.2;      // K [origin=ChemSep v8.3]
Pc          32.3;      // bar; source Pa / 1e5 [origin=ChemSep v8.3]
omega       0.364;      // [-] [origin=ChemSep v8.3]
Tb          435.13;      // K [origin=ChemSep v8.3]

standardThermochemistry
{
    dHf_298   -3260;        // J/mol   [ChemSep v8.3, ideal gas]
    s_298     398.9;        // J/(mol.K)  third-law absolute
}

vaporPressure
{
    model         Antoine;
    // log10(Psat [bar]) = A - B / (T[K] + C)
    // converted EXACTLY from ChemSep eqno 10, Psat[Pa] = exp(a - b/(T+c))
    coefficients  (4.147978967  1550.4313  -60.902);
    Trange        (385.57  573.2);
}

Vliq        0.000140263;      // m3/mol at 25 C  [ChemSep eqno 105]
HvapTb      38120.9;      // J/mol at Tb  [ChemSep eqno 106]

idealGasHeatCapacity
{
    model         chemsepCp16;
    // Cp [J/(mol.K)] = A + exp(B/T + C + D T + E T^2)
    // ChemSep states J/(kmol.K); A and the exp are scaled to per-mole here.
    coefficients  (75.636  -568.13  6.195244721  8.2441e-05  -4.4902e-08);
    Trange        (200  1500);
}

liquidHeatCapacity
{
    model         chemsepCp16;
    // Cp [J/(mol.K)] = A + exp(B/T + C + D T + E T^2)
    coefficients  (30.748  -85.511  4.631244721  0.0037389  -3.0029e-06);
    Trange        (210.83  435.16);
}

