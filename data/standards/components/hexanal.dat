}

vaporPressure
{
    model         Antoine;
    // log10(Psat [bar]) = A - B / (T[K] + C)
    // converted EXACTLY from ChemSep eqno 10, Psat[Pa] = exp(a - b/(T+c))
    coefficients  (4.048959825  1335.021237  -71.172);
    Trange        (352.15  512.29);
}

Vliq        0.000123313;      // m3/mol at 25 C  [ChemSep eqno 105]
HvapTb      35986.7;      // J/mol at Tb  [ChemSep eqno 106]

idealGasHeatCapacity
{
    model         chemsepCp16;
    // Cp [J/(mol.K)] = A + exp(B/T + C + D T + E T^2)
    // ChemSep states J/(kmol.K); A and the exp are scaled to per-mole here.
    coefficients  (115.82  -867.39  6.514244721  -0.00036658  7.4569e-08);
    Trange        (200  1500);
}

liquidHeatCapacity
{
    model         chemsepCp16;
    // Cp [J/(mol.K)] = A + exp(B/T + C + D T + E T^2)
    coefficients  (175.48  98.975  -0.181055279  0.013876  -8.1365e-06);
    Trange        (214.94  443.25);
}

