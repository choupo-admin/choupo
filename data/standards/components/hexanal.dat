name        hexanal;
CAS         66-25-1;
formula     C6H12O;      // counted from the ChemSep v8.3 structure formula "CH3(CH2)4CHO" (derived 2026-09-03; reproduces MW to 0.002 %)
reviewStatus interim;
MW          100.1589;      // kg/kmol [origin=ChemSep v8.3]
Tc          579;      // K [origin=ChemSep v8.3]
Pc          31.1;      // bar; source Pa / 1e5 [origin=ChemSep v8.3]
omega       0.439121;      // [-] [origin=ChemSep v8.3]
