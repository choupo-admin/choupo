// UNIQUAC van der Waals volume r and surface area q: the sum of the
// record's own UNIFAC groups (2 CH2 + 4 CH + 2 CH=CH), R_k/Q_k of Hansen et al. 1991
// (DEV.md 4c C294; bin/curate/uniquac_rq_from_groups.py).
uniquac
{
    r   5.3698;
    q   3.7260;
}

groups
{
    unifac ( { group CH2; count 2; } { group CH; count 4; } { group CH=CH; count 2; } );
}
