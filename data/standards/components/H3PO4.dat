/*--------------------------------*- Choupo -*-----------------------*\
  Component: Phosphoric acid (H3PO4, orthophosphoric).  CAS 7664-38-2.

  A triprotic mineral acid.  Pure H3PO4 MELTS at ~42 C, so at the 25 C
  reference the pure compound is a CRYSTALLINE SOLID -- this entry carries the
  SOLID-phase formation datum (referenceState pureSolid) + a real solid heat
  capacity.  It carries NO `role nonvolatile`: a case that dissolves the acid
  declares nonvolatility locally, and its dissociation (H3PO4 -> H+ + H2PO4- ->
  ...) is electrolyte chemistry, not a universal component role.

  SOURCE (re-sourced 2026-11-12, DEV.md 4c C335): NASA/TP-2002-211556
  (McBride, Zehe & Gordon 2002), a US government work in the public domain,
  Table B2 p. 35, entry H3PO4(cr): dfH(298.15) -1284.488 kJ/mol, S(298.15)
  110.544 J/(mol K), Cp(298.15) 106.064 J/(mol K); the report's own source
  is Chase 1998 pp. 1345-7.  Appendix D p. 233 carries the crystal's Cp
  polynomial over 200-315.5 K; it is not transcribed (the constant Cp(298)
  below is what this record has always carried).
  CROSS-CHECK, entering no value: the NBS Tables (Wagman et al., J. Phys.
  Chem. Ref. Data 11, Suppl. 2 (1982), Table 19P p. 2-73, read 2026-11-12
  at https://srd.nist.gov/JPCRD/jpcrdS2Vol11.pdf) print dfH -1279.0 kJ/mol,
  S 110.50 and Cp 106.06 for the crystal -- the ~5 kJ/mol spread on dfH is
  between two primaries, and a precise heat of reaction hinging on it
  should say which one it took.  (That journal issue is NOT public domain:
  it carries a 1982 copyright of the U.S. Secretary of Commerce, assigned to
  AIP and ACS, with permission to quote with acknowledgement.)
\*---------------------------------------------------------------------------*/

name        H3PO4;
formula     H3PO4;
CAS         7664-38-2;

MW          97.995;            // kg/kmol


solid
{
    rho_p   1834.0;            // crystalline H3PO4 density [kg/m^3]
}

standardThermochemistry
{
    dHf_298   -1284488;        // J/mol  crystalline; NASA/TP-2002-211556 Table B2, p. 35, entry H3PO4(cr)
    s_298     110.544;         // J/(mol*K); Table B2, p. 35
    referenceState     pureSolid;
}

solidHeatCapacity
{
    model         polynomial;          // Cp = a0  [J/(mol*K)], constant
    coefficients  ( 106.064 );         // Cp(298.15); NASA/TP-2002-211556 Table B2, p. 35
    Trange        ( 298  315 );        // constant-Cp validity flag (solid; melts ~315 K)
}

provenance
{
    standardThermochemistry { origin literature; method "NASA/TP-2002-211556 Table B2, p. 35, entry H3PO4(cr): dfH(298.15) and S(298.15) as printed (the report's source: Chase 1998 pp. 1345-7)"; notes "cross-checked against Wagman et al. 1982 Table 19P, which prints dfH -1279.0 kJ/mol -- see the header"; }
    solidHeatCapacity { origin literature; method "NASA/TP-2002-211556 Table B2, p. 35, entry H3PO4(cr): Cp(298.15), carried constant"; }
    rho_p { origin literature; method "crystalline H3PO4 density ~1.834 g/cm3"; }
    source   "McBride, Zehe & Gordon, NASA Glenn Coefficients for Calculating Thermodynamic Properties of Individual Species, NASA/TP-2002-211556 (2002)";
    licence  publicDomain;    // US government work (NASA), 17 U.S.C. 105 -- the thermochemistry and Cp above
}

cosmo
{
    VT2005
    {
        model       COSMOSAC;
        variant     "2002";
        source      "VT-2005 sigma-profile database (Mullins et al., Ind. Eng. Chem. Res. 45 (2006) 4389; DFT-COSMO), file VT2005-1062-PROF.txt bundled in usnistgov/COSMOSAC; CAS 7664-38-2";
        licence     externalRestricted;   // VT-2005: redistribution NOT confirmed -- values NOT shipped
        installed   false;                 // install your own copy: bin/choupo-import-cosmo (-> data/local/cosmo/VT2005/)
    }
    LVPP-HFTZVP-2018
    {
        model       COSMOSAC;
        variant     "LVPP-HFTZVP-2018";
        protocol    "LVPP-18.07 GAMESS HF/TZVP; r_av 1.4 A; f_decay 3.57; d in A; sigma = q/a";
        source      "LVPP sigma-profile database release 18.07 (github.com/lvpp/sigma, asset HF_TZVP.zip, sha256 bd17aaeebb430641...), file PHOSPHORIC_ACID.gout; MIT License, Copyright (c) 2017 LVPP; cite Ferrarini, Flores, Muniz & Soares, AIChE J. 64 (2018) 3443, doi:10.1002/aic.16194, and doi:10.5281/zenodo.3613786; identity: InChIKey NBIIXXVUZAFLBC-UHFFFAOYSA-N (full match); formula H3O4P; resolved by thirdParty/thermoml/identity.json (PubChem and CACTUS agree)";
        derivation  "segment areas, charges and the cavity volume are LVPP's (GAMESS HF/TZVP COSMO output); `area` is the sum of LVPP's segment areas as binned (GAMESS's printed cavity area agrees within its 2-decimal rounding); the 51-point profile is COMPUTED BY CHOUPO from LVPP's surface segments by bin/curate/lvpp_sigma_profile.py under the protocol above (Bell et al. 2020 Eq. 4 averaging, sigma = q/a, area split linearly between grid nodes)";
        licence     MIT;
        installed   true;
        area        102.691406;   // sum of the profile below; GAMESS prints 102.69
        volume      85.35;
        sigmaProfile  (
               0.000000     0.000000     0.767424     2.382704     4.476259     2.890268
               0.389957     1.938609     5.074548     3.349773     1.324461     0.455289
               1.665212     1.952157     1.161998     0.227863     0.786493     2.038779
               1.370058     1.222628     0.842161     0.476942     2.211899     2.975053
               3.733414     3.470556     2.823526     2.232808     2.441495     2.268327
               3.875810     3.489415     5.101130     2.830370     2.968821     2.895588
               5.653836     2.754355     2.166411     1.595583     0.578297     0.622111
               2.768212     7.148286     1.292520     0.000000     0.000000     0.000000
               0.000000     0.000000     0.000000
        );
    }
}
