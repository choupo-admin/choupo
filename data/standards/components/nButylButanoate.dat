/*--------------------------------*- Choupo -*-----------------------*\
  Component: nButylButanoate  (butyl butanoate; CAS 109-21-7)
  NEW in the catalogue (DEV.md 4c C309, slice 3 of C287, 2026-11-11), built by
  bin/curate/c287_new_components.py from the IUPAC critical-property series, the
  Zabransky liquid heat-capacity review and the measurements the NIST/TRC
  ThermoML Archive locates (the articles are the sources; every value's
  citation or DOIs are in provenance).
  IUPAC RECOMMENDED (critically evaluated measurements): Tc.
  FITTED: vapour pressure (bin/choupo-curate vp), Vliq.
  DERIVED: omega (from the fitted vapour pressure).
  ESTIMATED (Joback): Pc, ideal-gas Cp, dHf_298; s_298 derived from Joback's dHf and dGf.
  ESTIMATED (Rowlinson-Bondi, Poling 5e Eq. 6-6.4): liquid Cp -- no measurement or recommended correlation in hand.
  No measured series is reproduced here.
  reviewStatus autoPromoted, review by none: NO human has read it back.
  Psat: fitted by `bin/choupo-curate vp`; its promotion replaced the
  AmbroseWalton block this tool writes (provenance.vaporPressure).
\*---------------------------------------------------------------------------*/

name        nButylButanoate;
CAS         109-21-7;
formula     C8H16O2;
reviewStatus autoPromoted;
review      { by none; }   // DEV.md 4c C300 rule 4 (C297): nobody has reviewed it
MW          144.2140;      // kg/kmol, from the formula (IUPAC standard atomic weights)
Tc          612.1;      // K, IUPAC recommended (provenance.Tc)
Pc          25.4818555;      // bar, Joback ESTIMATE (provenance.Pc)
omega       0.512611;      // [-] (provenance.omega)
//  Tb: NOT DECLARED -- the archive reports no boiling temperature at
//  101.3 kPa for it, and a Tb read back off the fitted Antoine would be
//  the curve tested against itself (the fitted normal boiling point is
//  in provenance.vaporPressure.acceptance.Tnb_fit).  Joback's Tb is NOT stored either: the vapour-pressure
//  grade would read an estimate as a measurement (WRITE_ESTIMATED_TB in
//  the tool); the case data/curation/batches/new_components_c309 prints it.

standardThermochemistry
{
    dHf_298   -525730;        // J/mol, ideal gas, Joback ESTIMATE (provenance.dHf_298)
    s_298     518.92;        // J/(mol K), ideal gas, DERIVED from Joback (provenance.s_298)
}

vaporPressure
{
    model         Antoine;
    // log10(Psat [bar]) = A - B / (T[K] + C), FITTED by bin/choupo-curate vp to
    // measured vapour pressures -- see provenance.vaporPressure
    coefficients  (4.600180256  1865.506659  -32.10693914);
    Trange        (405.54  457.47);   // the fit's own span; outside it the engine announces the extrapolation
}

Vliq        1.648959e-04;      // m3/mol at 25 C, FITTED (provenance.Vliq)

idealGasHeatCapacity
{
    model         polynomial;
    // Cp [J/(mol K)] = a0 + a1 T + a2 T^2 + a3 T^3, Joback ESTIMATE
    coefficients  (21.025  0.70904  -3.168000e-04  2.690000e-08);
    Trange        (273  1000);
}

liquidHeatCapacity
{
    model         polynomial;
    // Cp [J/(mol K)] = a0 + a1 T + a2 T^2, Rowlinson-Bondi ESTIMATE (provenance.liquidHeatCapacity)
    coefficients  (243.5279373  0.02208398601  0.000504679165);
    Trange        (405.54  457.47);
}

// UNIQUAC van der Waals volume r and surface area q: the sum of the
// record's own UNIFAC groups (2 CH3 + 4 CH2 + 1 CH2COO), R_k/Q_k of Hansen et al. 1991
// (DEV.md 4c C294; bin/curate/uniquac_rq_from_groups.py).
uniquac
{
    r   6.1762;
    q   5.2760;
}

groups
{
    unifac ( { group CH3; count 2; } { group CH2; count 4; } { group CH2COO; count 1; } );
    joback ( { group CH3; count 2; } { group CH2; count 5; } { group ester; count 1; } );
}

liquidViscosity
{
    chemsepEq101
    {
        A     -19.96217295;
        B     1735.966026;
        C     1.246387191;
        D     0;
        E     0;
        Tmin  293.15;
        Tmax  343.15;
    }
}

