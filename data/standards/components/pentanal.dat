name        pentanal;
CAS         110-62-3;
formula     C5H10O;      // counted from the ChemSep v8.3 structure formula "CH3(CH2)3CHO" (derived 2026-09-03; reproduces MW to 0.002 %)
reviewStatus interim;
MW          86.1323;      // kg/kmol [origin=ChemSep v8.3]
Tc          554;      // K [origin=ChemSep v8.3]
Pc          35;      // bar; source Pa / 1e5 [origin=ChemSep v8.3]
omega       0.390803;      // [-] [origin=ChemSep v8.3]
Tb          376.15;      // K [origin=ChemSep v8.3]

standardThermochemistry
{
    dHf_298   -226690;        // J/mol   [ChemSep v8.3, ideal gas]
    s_298     382.89;        // J/(mol.K)  third-law absolute
}

vaporPressure
{
    model         Antoine;
    // log10(Psat [bar]) = A - B / (T[K] + C)
    // converted EXACTLY from ChemSep eqno 10, Psat[Pa] = exp(a - b/(T+c))
    coefficients  (4.166219335  1322.774133  -58.174);
    Trange        (337.15  485.24);
}

Vliq        0.000107022;      // m3/mol at 25 C  [ChemSep eqno 105]
HvapTb      33679.5;      // J/mol at Tb  [ChemSep eqno 106]

idealGasHeatCapacity
{
    model         chemsepCp16;
    // Cp [J/(mol.K)] = A + exp(B/T + C + D T + E T^2)
    // ChemSep states J/(kmol.K); A and the exp are scaled to per-mole here.
    coefficients  (101.56  -929.74  6.483244721  -0.0005525  1.6606e-07);
    Trange        (200  1500);
}

liquidHeatCapacity
{
    model         chemsepCp16;
    // Cp [J/(mol.K)] = A + exp(B/T + C + D T + E T^2)
    coefficients  (156.77  199.89  -2.650655279  0.024547  -2.2679e-05);
    Trange        (200  424.57);
}

liquidViscosity
{
    chemsepEq101
    {
        A     -10.884;
        B     982.07;
        C     -0.00046989;
        D     2.2767e-08;
        E     2;
        Tmin  182;
        Tmax  450;
    }
}

liquidThermalConductivity
{
    chemsepEq16
    {
        A     0.010965;
        B     -0.28239;
        C     -1.5585;
        D     -0.0012856;
        E     -1.3221e-06;
        Tmin  182;
        Tmax  513.15;
    }
}

// UNIQUAC van der Waals volume r and surface area q: the sum of the
// record's own UNIFAC groups (1 CH3 + 3 CH2 + 1 CHO), R_k/Q_k of Hansen et al. 1991
// (DEV.md 4c C294; bin/curate/uniquac_rq_from_groups.py).
uniquac
{
    r   3.9223;
    q   3.4160;
}

groups
{
    unifac ( { group CH3; count 1; } { group CH2; count 3; } { group CHO; count 1; } );
}
solubilityParameter 18440;   // Pa^0.5  [ANCHOR, ChemSep v8.3 -- checked against, never used]

