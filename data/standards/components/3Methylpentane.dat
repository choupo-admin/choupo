    coefficients  (4.046788353  1196.481298  -40.41);
    Trange        (304.91  442.33);
}

Vliq        0.000130331;      // m3/mol at 25 C  [ChemSep eqno 105]
HvapTb      28056.7;      // J/mol at Tb  [ChemSep eqno 106]

idealGasHeatCapacity
{
    model         chemsepCp16;
    // Cp [J/(mol.K)] = A + exp(B/T + C + D T + E T^2)
    // ChemSep states J/(kmol.K); A and the exp are scaled to per-mole here.
    coefficients  (66.323  -479.35  5.805244721  0.00041058  -1.3725e-07);
    Trange        (200  1500);
}

liquidHeatCapacity
{
    model         chemsepCp16;
    // Cp [J/(mol.K)] = A + exp(B/T + C + D T + E T^2)
    coefficients  (124.87  37.47  1.590844721  0.010489  -7.4005e-06);
    Trange        (79.81  336.43);
}

