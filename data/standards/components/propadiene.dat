standardThermochemistry
{
    dHf_298   190500;        // J/mol   [ChemSep v8.3, ideal gas]
    s_298     243.9;        // J/(mol.K)  third-law absolute
}

vaporPressure
{
    model         Antoine;
    // log10(Psat [bar]) = A - B / (T[K] + C)
    // converted EXACTLY from ChemSep eqno 10, Psat[Pa] = exp(a - b/(T+c))
    coefficients  (4.134950132  895.254645  -22.057);
    Trange        (236.75  353.4);
}

Vliq        6.82851e-05;      // m3/mol at 25 C  [ChemSep eqno 105]
HvapTb      20400.6;      // J/mol at Tb  [ChemSep eqno 106]

idealGasHeatCapacity
{
    model         chemsepCp16;
    // Cp [J/(mol.K)] = A + exp(B/T + C + D T + E T^2)
    // ChemSep states J/(kmol.K); A and the exp are scaled to per-mole here.
    coefficients  (34.67152  -447.4983  4.557804721  0.000444481  -1.470826e-07);
    Trange        (80  1500);
}

liquidHeatCapacity
{
    model         chemsepCp16;
    // Cp [J/(mol.K)] = A + exp(B/T + C + D T + E T^2)
    coefficients  (78.665  -12422  144.1722447  -0.53356  0.00065986);
    Trange        (137.6  362.6);
}

