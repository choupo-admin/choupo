// UNIQUAC van der Waals volume r and surface area q: the sum of the
// record's own UNIFAC groups (1 CH2 + 1 CH2=C), R_k/Q_k of Hansen et al. 1991
// (DEV.md 4c C294; bin/curate/uniquac_rq_from_groups.py).
uniquac
{
    r   1.7917;
    q   1.5280;
}

groups
{
    unifac ( { group CH2; count 1; } { group CH2=C; count 1; } );
}
