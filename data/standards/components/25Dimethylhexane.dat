    coefficients  (4.023336451  1304.012611  -57.773);
    Trange        (333.13  491.89);
}

Vliq        0.000165564;      // m3/mol at 25 C  [ChemSep eqno 105]
HvapTb      32482.9;      // J/mol at Tb  [ChemSep eqno 106]

idealGasHeatCapacity
{
    model         chemsepCp16;
    // Cp [J/(mol.K)] = A + exp(B/T + C + D T + E T^2)
    // ChemSep states J/(kmol.K); A and the exp are scaled to per-mole here.
    coefficients  (66.542  -399.08  5.992244721  0.00049831  -1.6255e-07);
    Trange        (200  1500);
}

