// (DEV.md 4c C294; bin/curate/uniquac_rq_from_groups.py).
uniquac
{
    r   6.0909;
    q   5.1680;
}

groups
{
    unifac ( { group CH3; count 4; } { group CH2; count 1; } { group CH; count 2; } { group CH2O; count 1; } );
    joback ( { group CH3; count 4; } { group CH; count 2; } { group CH2; count 2; } { group ether; count 1; } );
}

