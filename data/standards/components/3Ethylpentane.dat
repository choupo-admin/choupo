// UNIQUAC van der Waals volume r and surface area q: the sum of the
// record's own UNIFAC groups (3 CH3 + 3 CH2 + 1 CH), R_k/Q_k of Hansen et al. 1991
// (DEV.md 4c C294; bin/curate/uniquac_rq_from_groups.py).
uniquac
{
    r   5.1734;
    q   4.3920;
}

groups
{
    unifac ( { group CH3; count 3; } { group CH2; count 3; } { group CH; count 1; } );
}
