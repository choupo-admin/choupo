    coefficients  (4.065028721  1292.112943  -48.333);
    Trange        (326.9  479.64);
}

Vliq        0.000144022;      // m3/mol at 25 C  [ChemSep eqno 105]
HvapTb      31090.5;      // J/mol at Tb  [ChemSep eqno 106]

idealGasHeatCapacity
{
    model         chemsepCp16;
    // Cp [J/(mol.K)] = A + exp(B/T + C + D T + E T^2)
    // ChemSep states J/(kmol.K); A and the exp are scaled to per-mole here.
    coefficients  (102.98  -630.04  6.242244721  5.8616e-05  -2.6799e-08);
    Trange        (200  1500);
}

liquidHeatCapacity
{
    model         chemsepCp16;
    // Cp [J/(mol.K)] = A + exp(B/T + C + D T + E T^2)
    coefficients  (152.59  204.56  -0.975955279  0.021701  -2.2224e-05);
    Trange        (250  300);
}

