/*--------------------------------*- Choupo -*-----------------------*\
  Component: Mercapto radical (H2S oxidation chain carrier)
  Ideal-gas formation data and heat capacity READ from
  NASA/TP-2002-211556 (McBride, Zehe & Gordon 2002, "NASA Glenn
  Coefficients for Calculating Thermodynamic Properties of Individual
  Species"), a US government work in the public domain: entry
  "SH", appendix D p. 182 (dHf_298 and the NASA-9 Cp coefficients,
  as printed) and Table B1 p. 28 (s_298).  The report's own sources
  for this species: D0:Continetti,1991. Gurvich,1989 pt1 p296 pt2 p179.
  No liquid phase at process conditions -- the entry is tagged
  `role nonvolatile;` so vapour-pressure routines never get called.
  Re-sourced 2026-11-12 (DEV.md 4c C335) by
  bin/curate/nasa_tp2002_to_choupo.py from the NonCommercial compilation
  this record was first generated from (its old numbers
  are not kept here: they were that compilation's); not yet read back by
  a curator.
\*---------------------------------------------------------------------------*/

name           SH;
formula        SH;
CAS            n/a;        // radical registry number: pending curation

MW             33.068;       // kg/kmol
role        nonvolatile;
tags           ( radical gasPhase combustion sulfur );
reviewStatus   interim;
reviewReason   "transcribed by machine from NASA/TP-2002-211556 and checked against the report itself; not yet read back against the page by a curator";

standardThermochemistry
{
    dHf_298    142135.309;   // J/mol  -- ideal gas; NASA/TP-2002-211556 appendix D, p. 182, entry SH
    s_298      195.554;     // J/(mol·K) -- third-law absolute; Table B1, p. 28
}

idealGasHeatCapacity
{
    //  NASA/TP-2002-211556 eq. (1), Cp/R = a1/T^2 + a2/T + a3 + a4 T + a5 T^2
    //  + a6 T^3 + a7 T^4; appendix D, p. 182, entry SH, a1..a7 as printed.
    model    NASA9;
    Tlow     200;
    Tcommon  1000;
    Thigh    6000;
    low      ( 6.389434680e+03 -3.747960920e+02 7.548145770e+00 -1.288875477e-02 1.907786343e-05 -1.265033728e-08 3.235158690e-12 );
    high     ( 1.682631601e+06 -5.177152210e+03 9.198168520e+00 -2.323550224e-03 6.543914780e-07 -8.468470420e-11 3.864741550e-15 );
}

provenance
{
    dHf_298
    {
        origin        literature;
        method        "NASA/TP-2002-211556 appendix D, p. 182, entry SH, record-line H(298.15) (elements reference, so = dHf)";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "Table B1 p. 28 prints 142.135 kJ/mol; the report's own sources: D0:Continetti,1991. Gurvich,1989 pt1 p296 pt2 p179.";
    }
    s_298
    {
        origin        literature;
        method        "NASA/TP-2002-211556 Table B1, p. 28, entry SH";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "appendix D's coefficients with b2 integrate to 195.554";
    }
    idealGasHeatCapacity
    {
        origin        literature;
        method        "NASA/TP-2002-211556 appendix D, p. 182, entry SH, a1..a7 of the 200-1000 K and 1000-6000 K intervals, as printed";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "read by bin/curate/nasa_tp2002_to_choupo.py, which holds H and S at 298.15 K to the printed values";
    }
    source   "McBride, Zehe & Gordon, NASA Glenn Coefficients for Calculating Thermodynamic Properties of Individual Species, NASA/TP-2002-211556 (2002)";
    licence  publicDomain;    // US government work (NASA), 17 U.S.C. 105
}
