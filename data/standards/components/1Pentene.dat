vaporPressure
{
    model         Antoine;
    // log10(Psat [bar]) = A - B / (T[K] + C)
    // converted EXACTLY from ChemSep eqno 10, Psat[Pa] = exp(a - b/(T+c))
    coefficients  (4.147978967  1142.02077  -27.471);
    Trange        (283.15  413.6);
}

Vliq        0.000110529;      // m3/mol at 25 C  [ChemSep eqno 105]
HvapTb      25192.5;      // J/mol at Tb  [ChemSep eqno 106]

idealGasHeatCapacity
{
    model         chemsepCp16;
    // Cp [J/(mol.K)] = A + exp(B/T + C + D T + E T^2)
    // ChemSep states J/(kmol.K); A and the exp are scaled to per-mole here.
    coefficients  (66.52  -609.44  5.775244721  6.2395e-05  -2.5354e-08);
    Trange        (200  1500);
}

liquidHeatCapacity
{
    model         chemsepCp16;
    // Cp [J/(mol.K)] = A + exp(B/T + C + D T + E T^2)
    coefficients  (92.753  117.21  1.745944721  0.007447  -2.6759e-06);
    Trange        (107.9  372);
}

