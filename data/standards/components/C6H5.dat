/*--------------------------------*- Choupo -*-----------------------*\
  Component: PHENYL radical -- the aromatic growth radical (HACA)
  Ideal-gas formation data and heat capacity READ from
  NASA/TP-2002-211556 (McBride, Zehe & Gordon 2002, "NASA Glenn
  Coefficients for Calculating Thermodynamic Properties of Individual
  Species"), a US government work in the public domain: entry
  "C6H5,phenyl", appendix D p. 100 (dHf_298 and the NASA-9 Cp coefficients,
  as printed) and Table B1 p. 17 (s_298).  The report's own sources
  for this species: Radical.Hf:TRC(10/89) w4270. Jacox,1989. NASA ab initio.
  No liquid phase at process conditions -- the entry is tagged
  `role nonvolatile;` so vapour-pressure routines never get called.
  Re-sourced 2026-11-12 (DEV.md 4c C335) by
  bin/curate/nasa_tp2002_to_choupo.py from the NonCommercial compilation
  this record was first generated from (its old numbers
  are not kept here: they were that compilation's); not yet read back by
  a curator.
  IDENTITY: the report's entry `C6H5,phenyl`.
\*---------------------------------------------------------------------------*/

name           C6H5;
formula        C6H5;
CAS            2396-01-2;

MW             77.106;       // kg/kmol
role        nonvolatile;
tags           ( radical gasPhase combustion soot );
reviewStatus   interim;
reviewReason   "transcribed by machine from NASA/TP-2002-211556 and checked against the report itself; not yet read back against the page by a curator";

standardThermochemistry
{
    dHf_298    337200.000;   // J/mol  -- ideal gas; NASA/TP-2002-211556 appendix D, p. 100, entry C6H5,phenyl
    s_298      288.868;     // J/(mol·K) -- third-law absolute; Table B1, p. 17
}

idealGasHeatCapacity
{
    //  NASA/TP-2002-211556 eq. (1), Cp/R = a1/T^2 + a2/T + a3 + a4 T + a5 T^2
    //  + a6 T^3 + a7 T^4; appendix D, p. 100, entry C6H5,phenyl, a1..a7 as printed.
    model    NASA9;
    Tlow     200;
    Tcommon  1000;
    Thigh    6000;
    low      ( -1.211278245e+05 3.529045580e+03 -3.116903422e+01 1.467550630e-01 -1.831398296e-04 1.192576957e-07 -3.149265860e-11 );
    high     ( 3.670279230e+06 -1.894601209e+04 4.180581820e+01 -3.503914150e-03 6.561821740e-07 -6.594714450e-11 2.748094212e-15 );
}

provenance
{
    dHf_298
    {
        origin        literature;
        method        "NASA/TP-2002-211556 appendix D, p. 100, entry C6H5,phenyl, record-line H(298.15) (elements reference, so = dHf)";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "Table B1 p. 17 prints 337.2 kJ/mol; the report's own sources: Radical.Hf:TRC(10/89) w4270. Jacox,1989. NASA ab initio.";
    }
    s_298
    {
        origin        literature;
        method        "NASA/TP-2002-211556 Table B1, p. 17, entry C6H5,phenyl";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "appendix D's coefficients with b2 integrate to 288.868";
    }
    idealGasHeatCapacity
    {
        origin        literature;
        method        "NASA/TP-2002-211556 appendix D, p. 100, entry C6H5,phenyl, a1..a7 of the 200-1000 K and 1000-6000 K intervals, as printed";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "read by bin/curate/nasa_tp2002_to_choupo.py, which holds H and S at 298.15 K to the printed values";
    }
    source   "McBride, Zehe & Gordon, NASA Glenn Coefficients for Calculating Thermodynamic Properties of Individual Species, NASA/TP-2002-211556 (2002)";
    licence  publicDomain;    // US government work (NASA), 17 U.S.C. 105
}
