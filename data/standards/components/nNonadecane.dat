// UNIQUAC van der Waals volume r and surface area q: the sum of the
// record's own UNIFAC groups (2 CH3 + 17 CH2), R_k/Q_k of Hansen et al. 1991
// (DEV.md 4c C294; bin/curate/uniquac_rq_from_groups.py).
uniquac
{
    r   13.2670;
    q   10.8760;
}

groups
{
    unifac ( { group CH3; count 2; } { group CH2; count 17; } );
}
