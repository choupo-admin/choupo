/*--------------------------------*- Choupo -*-----------------------*\
  Component: Ethylene  (C2H4, CAS 74-85-1)

  Largest-volume organic feedstock worldwide --- the building block of
  polyethylene, ethylene oxide, ethylbenzene.  Produced by steam
  cracking of ethane/naphtha; an obvious target for the Choupo
  GibbsReactor when modelling thermal cracking equilibria.
  Sources: constants (Tc/Pc/omega/MW/Tb) cross-checked vs CoolProp 7.2.0
  reference EOS; standardThermochemistry cross-checked vs NASA TM-4513
  (McBride-Gordon-Reno 1993); idealGasHeatCapacity -- individual
  literature value, primary re-citation pending (IST review).
\*---------------------------------------------------------------------------*/

name        ethylene;
formula     C2H4;
CAS         74-85-1;

MW          28.054;            // kg/kmol
Tc          282.34;             // K
Pc          50.41;              // bar
omega       0.087;              // [-]
Tb          169.42;             // K
HvapTb      13530;              // J/mol
Vliq        4.91e-5;            // m^3/mol
VliqT       169.42;      // K -- the temperature Vliq belongs to: the stored value is a volume at the normal boiling point: batch vliq_datum_temperature (evidence.tsv; the value is unchanged)
//  ANCHOR, never an input.  The engine DERIVES the Hildebrand
//  parameter from HvapTb and Vliq (the tree stores no derivative);
//  this is what ChemSep v8.3 computed independently, so the
//  derivation has something to be wrong against.
solubilityParameter 12440;   // Pa^0.5  [anchor, ChemSep v8.3, Artistic-2.0]

standardThermochemistry
{
    dHf_298    52280.0;         // J/mol  -- ideal-gas reference
    s_298      219.32;          // J/(mol·K)
}

vaporPressure
{
    model         Antoine;
    coefficients  (3.91382   596.526   -16.844);
    Trange        (150  283);
}

idealGasHeatCapacity
{
    model         polynomial;
    coefficients  (3.806   0.1566   -8.348e-5   1.755e-8);
    Trange        (250  1500);
}

groups
{
    joback ( { group eCH2; count 2; } );
}

// Friendly-name aliases -- resolved to this file via the generated ALIASES index.
aliases ( ethene C2H4 );

cosmo
{
    VT2005
    {
        model       COSMOSAC;
        variant     "2002";
        source      "VT-2005 sigma-profile database (Mullins et al., Ind. Eng. Chem. Res. 45 (2006) 4389; DFT-COSMO), file VT2005-0124-PROF.txt bundled in usnistgov/COSMOSAC; CAS 74-85-1";
        licence     externalRestricted;   // VT-2005: redistribution NOT confirmed -- values NOT shipped
        installed   false;                 // install your own copy: bin/choupo-import-cosmo (-> data/local/cosmo/VT2005/)
    }
    LVPP-HFTZVP-2018
    {
        model       COSMOSAC;
        variant     "LVPP-HFTZVP-2018";
        protocol    "LVPP-18.07 GAMESS HF/TZVP; r_av 1.4 A; f_decay 3.57; d in A; sigma = q/a";
        source      "LVPP sigma-profile database release 18.07 (github.com/lvpp/sigma, asset HF_TZVP.zip, sha256 bd17aaeebb430641...), file ETHYLENE.gout; MIT License, Copyright (c) 2017 LVPP; cite Ferrarini, Flores, Muniz & Soares, AIChE J. 64 (2018) 3443, doi:10.1002/aic.16194, and doi:10.5281/zenodo.3613786; identity: InChIKey VGGSQFUCUMXWEO-UHFFFAOYSA-N (full match); formula C2H4; resolved by thirdParty/thermoml/identity.json (PubChem and CACTUS agree)";
        derivation  "segment areas, charges and the cavity volume are LVPP's (GAMESS HF/TZVP COSMO output); `area` is the sum of LVPP's segment areas as binned (GAMESS's printed cavity area agrees within its 2-decimal rounding); the 51-point profile is COMPUTED BY CHOUPO from LVPP's surface segments by bin/curate/lvpp_sigma_profile.py under the protocol above (Bell et al. 2020 Eq. 4 averaging, sigma = q/a, area split linearly between grid nodes)";
        licence     MIT;
        installed   true;
        area        71.866536;   // sum of the profile below; GAMESS prints 71.87
        volume      53.50;
        sigmaProfile  (
               0.000000     0.000000     0.000000     0.000000     0.000000     0.000000
               0.000000     0.000000     0.000000     0.000000     0.000000     0.000000
               0.000000     0.000000     0.000000     0.000000     0.000000     0.000000
               2.372177     6.693909     8.832808     4.404664     4.879607     3.364276
               5.043279     6.880366     4.295864     4.721418     4.154899     3.130342
               4.465590     2.224886     2.429509     2.717692     1.255250     0.000000
               0.000000     0.000000     0.000000     0.000000     0.000000     0.000000
               0.000000     0.000000     0.000000     0.000000     0.000000     0.000000
               0.000000     0.000000     0.000000
        );
    }
}
