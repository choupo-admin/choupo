  locates (the articles are the sources; their DOIs are in provenance).
  UPGRADED by DEV.md 4c C309 (2026-11-11): Tc and Pc replaced by the IUPAC
  recommended value (critically evaluated measurements; citation in
  provenance) and omega re-derived from them.  Nothing else refitted: Vliq
  is the C292 fit, made with the Joback Tc/Pc, kept as it was.
  MEASURED: no Tb (critical constants: UPGRADED above).  FITTED: vapour pressure (bin/choupo-curate vp),
  Vliq, liquid Cp.  DERIVED: omega (from the fitted vapour pressure).
  ESTIMATED (Joback): ideal-gas Cp, dHf_298; s_298 derived from Joback's
  dHf and dGf.  No measured series is reproduced here.
  reviewStatus autoPromoted, humanReviewed false: NO human has read it back.
  Psat: fitted by `bin/choupo-curate vp`; its promotion replaced the
  AmbroseWalton block this tool writes (provenance.vaporPressure).
\*---------------------------------------------------------------------------*/

name        12Propanediol;
CAS         57-55-6;
formula     C3H8O2;
reviewStatus autoPromoted;
humanReviewed false;
MW          76.0950;      // kg/kmol, from the formula (IUPAC standard atomic weights)
Tc          676.4;      // K, IUPAC recommended (provenance.Tc)
Pc          60;      // bar, IUPAC recommended (provenance.Pc)
omega       0.612713;      // [-] (provenance.omega)
//  Tb: NOT DECLARED -- the archive reports no boiling temperature at
//  101.3 kPa for it, and a Tb read back off the fitted Antoine would be
//  the curve tested against itself (the fitted normal boiling point is
//  in provenance.vaporPressure.acceptance.Tnb_fit).  Joback's Tb is NOT stored either: the vapour-pressure
//  grade would read an estimate as a measurement (WRITE_ESTIMATED_TB in
//  the tool); the case data/curation/batches/new_components_estimated prints it.

standardThermochemistry
{
    dHf_298   -414990;        // J/mol, ideal gas, Joback ESTIMATE (provenance.dHf_298)
    s_298     365.12;        // J/(mol K), ideal gas, DERIVED from Joback (provenance.s_298)
}

vaporPressure
{
    model         Antoine;
    // log10(Psat [bar]) = A - B / (T[K] + C), FITTED by bin/choupo-curate vp to
    // measured vapour pressures -- see provenance.vaporPressure
    coefficients  (5.072896103  1943.082688  -77.53513767);
    Trange        (345.15  460.87);   // the fit's own span; outside it the engine announces the extrapolation
}

Vliq        7.055635e-05;      // m3/mol at 25 C, FITTED (provenance.Vliq)

idealGasHeatCapacity
{
    model         polynomial;
    // Cp [J/(mol K)] = a0 + a1 T + a2 T^2 + a3 T^3, Joback ESTIMATE
    coefficients  (9.061  0.36272  -2.034000e-04  4.360000e-08);
    Trange        (273  1000);
}

liquidHeatCapacity
{
    model         polynomial;
    // Cp [J/(mol K)] = a0 + a1 T + a2 T^2, FITTED (provenance.liquidHeatCapacity)
    coefficients  (-9.520106202  0.8867689446  -0.0007143524997);
    Trange        (283.15  353.15);
}

groups
{
    unifac ( { group CH3; count 1; } { group CH2; count 1; } { group CH; count 1; } { group OH; count 2; } );
    joback ( { group CH3; count 1; } { group CH2; count 1; } { group CH; count 1; } { group OH; count 2; } );
}

liquidThermalConductivity
{
    chemsepEq16
    {
        A     0;
        B     -72.43066328;
        C     -0.9972316382;
        D     -0.001180851717;
        E     0;
        Tmin  283.15;
        Tmax  450.8;
    }
}

