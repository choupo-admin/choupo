// UNIQUAC van der Waals volume r and surface area q: the sum of the
// record's own UNIFAC groups (2 CH3 + 3 CH2 + 2 CH), R_k/Q_k of Hansen et al. 1991
// (DEV.md 4c C294; bin/curate/uniquac_rq_from_groups.py).
uniquac
{
    r   4.7192;
    q   3.7720;
}

groups
{
    unifac ( { group CH3; count 2; } { group CH2; count 3; } { group CH; count 2; } );
}
