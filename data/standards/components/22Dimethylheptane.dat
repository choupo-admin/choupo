    coefficients  (3.916934302  1311.17847  -70.648);
    Trange        (346.85  510.93);
}

Vliq        0.00018127;      // m3/mol at 25 C  [ChemSep eqno 105]
HvapTb      34357.6;      // J/mol at Tb  [ChemSep eqno 106]

idealGasHeatCapacity
{
    model         chemsepCp16;
    // Cp [J/(mol.K)] = A + exp(B/T + C + D T + E T^2)
    // ChemSep states J/(kmol.K); A and the exp are scaled to per-mole here.
    coefficients  (119.34  -582.53  6.478244721  6.7675e-05  -2.1229e-08);
    Trange        (150  1500);
}

liquidHeatCapacity
{
    model         chemsepCp16;
    // Cp [J/(mol.K)] = A + exp(B/T + C + D T + E T^2)
    coefficients  (188.49  -126.2  3.253244721  0.0065361  -3.3154e-06);
    Trange        (160.15  405.84);
}

