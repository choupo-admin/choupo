                pointsDropped 1;
                provenance measured;
            }
            {
                role      fit;
                dataset   "constant/archiveExtracts/tetradecanoicAcid-vapourPressure-j.tca.2012.07.034.dat";
                doi       "10.1016/j.tca.2012.07.034";
                sha256    "9629a6014a63330246ead307d04c51071a148f6565956f7ffc49eeb983905397";
                articleSha256 "67ed0c1fb2f3b0bb6e4d7950215f89360a7c5f9bb25f99ec3d259673312de2f2";
                pointsKept    7;
                pointsDropped 0;
                provenance measured;
            }
        );
        acceptance
        {
            rule        "the default of DEV.md 4c C285 (graded): max relative error in P over the kept points 5 / 10 / 20 %, and |Tnb - Tb| 1 / 2 / 4 K where Tb lies outside their range, are the upper limits of clean / warning / severe; above, refused; the grade is the worse of the two";
            verdict     accepted;
            studies     2;
            pointsKept  28;
            pointsDropped 1;
