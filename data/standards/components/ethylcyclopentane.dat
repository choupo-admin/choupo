    coefficients  (4.10368093  1360.166888  -44.732);
    Trange        (343.06  510.93);
}

Vliq        0.000128754;      // m3/mol at 25 C  [ChemSep eqno 105]
HvapTb      31947.7;      // J/mol at Tb  [ChemSep eqno 106]

idealGasHeatCapacity
{
    model         chemsepCp16;
    // Cp [J/(mol.K)] = A + exp(B/T + C + D T + E T^2)
    // ChemSep states J/(kmol.K); A and the exp are scaled to per-mole here.
    coefficients  (61.352  -623.48  6.367244721  -6.8613e-05  9.3089e-09);
    Trange        (200  1500);
}

liquidHeatCapacity
{
