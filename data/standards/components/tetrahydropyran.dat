name        tetrahydropyran;
CAS         142-68-7;
formula     C5H10O;
reviewStatus autoPromoted;
humanReviewed false;
MW          86.1340;      // kg/kmol, from the formula (IUPAC standard atomic weights)
Tc          572;      // K, IUPAC recommended (provenance.Tc)
Pc          47.7;      // bar, IUPAC recommended (provenance.Pc)
omega       0.200147;      // [-] (provenance.omega)
Tb          361.36;      // K, measured (provenance.Tb)

standardThermochemistry
{
    dHf_298   -203870;        // J/mol, ideal gas, Joback ESTIMATE (provenance.dHf_298)
    s_298     311.32;        // J/(mol K), ideal gas, DERIVED from Joback (provenance.s_298)
}

vaporPressure
{
    model         Antoine;
    // log10(Psat [bar]) = A - B / (T[K] + C), FITTED by bin/choupo-curate vp to
    // measured vapour pressures -- see provenance.vaporPressure
    coefficients  (4.304361203  1385.253222  -38.33604469);
    Trange        (257.96  361.55);   // the fit's own span; outside it the engine announces the extrapolation
}

Vliq        9.777306e-05;      // m3/mol at 25 C, FITTED (provenance.Vliq)

idealGasHeatCapacity
{
    model         polynomial;
    // Cp [J/(mol K)] = a0 + a1 T + a2 T^2 + a3 T^3, Joback ESTIMATE
    coefficients  (-55.88  0.6244  -3.707000e-04  7.740000e-08);
    Trange        (273  1000);
}

liquidHeatCapacity
{
    model         polynomial;
    // Cp [J/(mol K)] = a0 + a1 T + a2 T^2, FITTED (provenance.liquidHeatCapacity)
    coefficients  (29.39728827  0.3663913913  0.00011399546);
    Trange        (288.15  333.15);
}

groups
{
    joback ( { group rCH2; count 5; } { group etherRing; count 1; } );
}

