    {
        name     ammoniaToNO;
        kind     reaction;
        target   NO;
        family   oxidation;
        era      incumbent;
        description "The Ostwald first step: ammonia burned over Pt/Rh gauze in milliseconds to NO -- the one reaction that opens the whole nitrogen-oxide chain (nitric acid, hydroxylamine).";
