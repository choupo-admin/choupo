    {
        name     glucoseFermentationLactic;
        kind     reaction;
        target   lacticAcid;
        family   fermentation;
        era      transition;
        description "Glucose to lactic acid with NO carbon lost by stoichiometry -- the platform chemical of PLA.";
        stoichiometry
        (
            { component glucose;               nu -1; }
            { component lacticAcid;            nu 2; }
        );
        yield
        {
            basis   carbon;
            band    ( 0.85 0.95 );
