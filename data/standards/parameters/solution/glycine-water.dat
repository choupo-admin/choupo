/*--------------------------------*- Choupo -*-----------------------*\
  Solution thermo: GLYCINE dissolved in liquid WATER (arity-2, the aqueous-solution tier; the molecular-solute sibling of
  parameters/solution/citricAcid-water.dat).

  PAIR data: a heat of solution is defined as `crystal -> species dissolved in WATER`, so it lives HERE, keyed by the (solute,
  solvent) pair, never inside glycine.dat.  h_aq(T) = Hf_crystal + dHsoln + INT_298^T cp_aq dT'.

  The dissolved species is the zwitterion at infinite dilution: Miller & Smith-Magowan's dHf(aq) = -514.36 +/- 0.50 kJ/mol
  (Table 3, p. 1054) is dHf(cr) + dH(soln) to the printed digits, and it is the `hfAq` of the zwitterion species of the
  glycine ladder.  NOT carried: the aqueous heat capacity (no work in hand prints it), so the cp_aq rung refuses by name.
\*---------------------------------------------------------------------------*/

solute      glycine;
solvent     water;

// Standard enthalpy of solution, crystal -> aqueous (infinite dilution), 298.15 K: +14.16 +/- 0.01 kJ/mol, endothermic.
dHsoln      14160 J/mol;
dHsoln_provenance
{
    origin   literature;
    method   "Miller & Smith-Magowan, J. Phys. Chem. Ref. Data 19 (1990) 1049, Table 3, p. 1054, row dH(soln) (+14.16 +/- 0.01 kJ/mol; their source 75SPI/WAD; read from a page image); dHf(cr) -528.52 +/- 0.50 kJ/mol and dHf(aq) -514.36 +/- 0.50 kJ/mol from the same table.";
}
