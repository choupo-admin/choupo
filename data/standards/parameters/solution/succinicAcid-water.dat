/*--------------------------------*- Choupo -*-----------------------*\
  Solution thermo: SUCCINIC ACID dissolved in liquid WATER (arity-2, the aqueous-solution tier -- the
  molecular-solute sibling of parameters/solution/citricAcid-water.dat, written the same way).

  PAIR data: a heat of solution is defined as `crystal -> species dissolved in WATER`, so it names a
  second species and lives HERE, keyed by the (solute, solvent) pair, never inside succinicAcid.dat.

  The engine reads dHsoln for the dissolved-vs-crystalline enthalpy rung:

      h_aq(T) = Hf_crystal + dHsoln + INT_298^T cp_aq dT'

  The dissolved species is the molecular, non-dissociated acid at infinite dilution: Miller & Smith-Magowan's
  dHf(aq acid) = -912.11 +/- 0.42 kJ/mol (Table 2, p. 1059) is dHf(cr) + dH(soln) to the printed digits, so the pair
  reproduces the aqueous acid the succinate ions are referred to (their hfAq are that value plus the Table 6
  ionisation enthalpies).  The dissociated route is the succinate family (see species/ and chemistry/).

  NOT carried: the aqueous heat capacity `Cp`.  No work in hand prints it for this acid, so the cp_aq rung
  refuses by name when a duty reaches the sensible heat of the solution; the formation-level (298.15 K)
  balance is complete.
\*---------------------------------------------------------------------------*/

solute      succinicAcid;
solvent     water;

// Standard enthalpy of solution, crystal -> aqueous (infinite dilution), 298.15 K: 28.70 kJ/mol, endothermic.
dHsoln      28700 J/mol;
dHsoln_provenance
{
    origin   literature;
    method   "Miller & Smith-Magowan, J. Phys. Chem. Ref. Data 19 (1990) 1049, Table 2, p. 1059, row dsolH (read from a page image): dH(soln) = 28.70 kJ/mol (their source 72VAN/MANb); dHf(cr) -940.81 +/- 0.42 kJ/mol and dHf(aq acid) -912.11 +/- 0.42 kJ/mol from the same table(s).";
}
