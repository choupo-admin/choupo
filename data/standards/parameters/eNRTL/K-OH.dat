/*--------------------------------*- Choupo -*--------------------------------*\
  Electrolyte-NRTL binary energy parameters --- (K)1(OH)1 in water.
  Role: the water / (K)(OH) pair taus of the Chen local-composition model,
  alpha 0.2 fixed, consumed by the eNRTL activity engine.
  REGRESSED BY CHOUPO (DEV.md 4c C311) to the evaluated gamma_pm and phi
  of W. J. Hamer and Y.-C. Wu, Osmotic Coefficients and Mean Activity Coefficients of Uni-univalent Electrolytes in Water at 25 C, J. Phys. Chem. Ref. Data 1 (1972) 1047-1100, doi:10.1063/1.3253108 (Table 31, p. 1075 (m, phi, gamma), the recommended values) -- the evaluation is the
  primary source of those recommended values.  The PARAMETERS are
  Choupo's own work.  Window: 0.2-6 mol/kg at 298.15 K
  (16 points fitted, 4 interleaved points held out).
  Outside it the record is an extrapolation; off 25 C it carries no
  temperature extension of its own.
  GRADE: in-sample max error 4.25 % -> warning;
  the held-out points 3.89 % (warning).  No human has
  reviewed it.  REPRODUCE: run data/curation/electrolytes/K-OH; its proposal is held equal to this
  record by bin/curate/check_regressed_electrolytes.py.
\*-----------------------------------------------------------------------------*/
recordType electrolyteNRTLParameters;
schemaVersion 1;

model eNRTL;

pair { cation K; anion OH; }

parameters
{
    tau_m_ca 9.96965541;
    tau_ca_m -5.095614217;
    alpha    0.2;
}

source "REGRESSED by Choupo (C311) to W. J. Hamer and Y.-C. Wu, Osmotic Coefficients and Mean Activity Coefficients of Uni-univalent Electrolytes in Water at 25 C, J. Phys. Chem. Ref. Data 1 (1972) 1047-1100, doi:10.1063/1.3253108, Table 31, p. 1075 (m, phi, gamma), the recommended values";

provenance
{
    origin        regressed;
    method        "electrolyteFit(eNRTL): ln gamma_pm and phi, equal weight, Levenberg-Marquardt from 4 starts";
    methodVersion "choupoProps Choupo-dev";
    fittedInCase  "data/curation/electrolytes/K-OH";
    reviewStatus  autoPromoted;
    fitGrade      warning;   // DEV.md 4c C311: max relative error of gamma_pm or phi over the fitted points, graded 2 / 5 / 10 %
    fitGradeBasis inSample;   // DEV.md 4c C300 rule 1: the residual of the points it was fitted to
    fitGradeMaxRelativeError_pct 4.2538;
    promotedBy    "bin/curate/electrolytes_c311.py promote";
    promotedDate  "2026-11-11";
    reviewReason  "regressed by bin/curate/electrolytes_c311.py from a hand-checked transcription of an evaluated table; not yet read back by a human";
    reuse         "Choupo's own regression; the evaluated values belong to the cited compilation";
    fitDate       "2026-11-11";
    evidence
    (
        {
            role      fit;
            dataset   "constant/experiments/K-OH.dat";
            doi       "10.1063/1.3253108";
            provenance evaluated;
        }
    );
    inSample
    {
        gammaAAD_pct 2.0491;
        phiAAD_pct   1.1996;
        max_pct      4.2538;
        nPoints      16;
    }
    heldOut
    {
        kind         interleavedSameSource;   // every 4th point of the same evaluation: NOT a validation
        gammaAAD_pct 2.1632;
        phiAAD_pct   1.1833;
        max_pct      3.8893;
        nPoints      4;
        grade        warning;
    }
    validity
    {
        temperature { min 298.15 K; max 298.15 K; }
        molality    { min 0.2; max 6; }   // mol/kg
        note        "the span of the fitted evaluated values; outside it the salt is an extrapolation";
    }
    review
    {
        by none;
    }
}
