/*--------------------------------*- Choupo -*-----------------------*\
  Henry's-law constant for O2 in liquid methylChloride (infinite dilution).

  Source DATA: the measurements of
    Shirono, K.[Katsuhiro]; Morimatsu, T.[Tatsumasa]; Takemura, F.[Fumio] (2008) J. Chem. Eng. Data 53, 1867-1871, doi:10.1021/je800200j
  located through the NIST/TRC ThermoML Archive (doi 10.18434/mds2-2422);
  the values belong to those articles.  NO measured point is reproduced here
  or anywhere in this tree; data/curation/henry/O2-methylChloride
  declares each dataset by DOI, block and sha256 and regenerates it.

  FIT (DEV.md 4c C321 part 2): van't Hoff in 1/T, every laboratory together,
  least squares then minimax on the relative residual of H; points above
  20 % after the least-squares stage discarded by name (0 here).
  9 kept points, 283.15-323.15 K; max relative error
  0.03 % in-sample (graded 10 / 20 / 30 %, C336 class B).
  Regressed by Choupo, NOT read by a human; the archive's transcription has
  not been read back against the articles.

  NOTE: INFINITE-DILUTION coefficient at the solvent's own vapour pressure;
  validity 283-324 K (the measured span; outside it an extrapolation).
\*---------------------------------------------------------------------------*/

solute      O2;
solvent     methylChloride;

gasSpecies        O2;
dissolvedSpecies  O2;
convention        Sander-Hxp-v1;

model       vantHoff;
H_ref       1.36002e+08 Pa;
T_ref       298.15 K;
enthalpy    2134  J/mol;
Trange      ( 283  324 );

reviewStatus autoPromoted;
review      { by none; }

provenance
{
    origin        fitted;
    source        "doi:10.1021/je800200j (located through ThermoML, doi 10.18434/mds2-2422)";
    method        "van't Hoff fit, least squares then minimax on H_model/H - 1, bin/curate/henry_organic.py";
    CAS           7782-44-7;
    fittedInCase  "data/curation/henry/O2-methylChloride";
    fitGrade      warning;   // DEV.md 4c C285: max |H_model - H|/H over the kept points, graded 10 / 20 / 30 % (C336 class B)
    fitGradeBasis inSample;   // DEV.md 4c C300 rule 1
    fitGradeCap   ( singleLaboratory );   // DEV.md 4c C300 rule 2
    fitGradeMaxRelativeError_pct 0.0329;
    pointsKept    9;
    pointsDiscarded 0;
    fingerprint   "dbfdad7ddefd4a06";   // of the declaration, frozen before the fit
    evidence
    (
        {
            doi           "10.1021/je800200j";
            block         7;
            archiveFile   "je800200j.xml";
            articleSha256 "21559d776526df9f9420b8981c1bbfae2ea69af7da96f538ce1afffef55307d8";
            sha256        "1e41c5a688f1ec9c650653990c46c8747e3cd1bf807db8e37b5f32b00adfe33d";
        }
    );
}
