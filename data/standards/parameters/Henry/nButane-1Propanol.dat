/*--------------------------------*- Choupo -*-----------------------*\
  Henry's-law constant for nButane in liquid 1Propanol (infinite dilution).

  Source DATA: the measurements of
    Miyano, Y.[Yoshimori] (2004) J. Chem. Thermodyn. 36, 101-106, doi:10.1016/j.jct.2003.08.018
  located through the NIST/TRC ThermoML Archive (doi 10.18434/mds2-2422);
  the values belong to those articles.  NO measured point is reproduced here
  or anywhere in this tree; data/curation/henry/nButane-1Propanol
  declares each dataset by DOI, block and sha256 and regenerates it.

  FIT (DEV.md 4c C321 part 2): van't Hoff in 1/T, every laboratory together,
  least squares then minimax on the relative residual of H; points above
  20 % after the least-squares stage discarded by name (0 here).
  5 kept points, 260.05-340.04 K; max relative error
  3.40 % in-sample (graded 5 / 10 / 20 %).
  Regressed by Choupo, NOT read by a human; the archive's transcription has
  not been read back against the articles.

  NOTE: INFINITE-DILUTION coefficient at the solvent's own vapour pressure;
  validity 260-341 K (the measured span; outside it an extrapolation).
\*---------------------------------------------------------------------------*/

solute      nButane;
solvent     1Propanol;

gasSpecies        nButane;
dissolvedSpecies  nButane;
convention        Sander-Hxp-v1;

model       vantHoff;
H_ref       1.09539e+06 Pa;
T_ref       298.15 K;
enthalpy    -20846  J/mol;
Trange      ( 260  341 );

reviewStatus autoPromoted;
review      { by none; }

provenance
{
    origin        fitted;
    source        "doi:10.1016/j.jct.2003.08.018 (located through ThermoML, doi 10.18434/mds2-2422)";
    method        "van't Hoff fit, least squares then minimax on H_model/H - 1, bin/curate/henry_organic.py";
    CAS           106-97-8;
    fittedInCase  "data/curation/henry/nButane-1Propanol";
    fitGrade      warning;   // DEV.md 4c C285: max |H_model - H|/H over the kept points, graded 5 / 10 / 20 %
    fitGradeBasis inSample;   // DEV.md 4c C300 rule 1
    fitGradeCap   ( singleLaboratory );   // DEV.md 4c C300 rule 2
    fitGradeMaxRelativeError_pct 3.4031;
    pointsKept    5;
    pointsDiscarded 0;
    fingerprint   "0ee3f3e79c4e4580";   // of the declaration, frozen before the fit
    evidence
    (
        {
            doi           "10.1016/j.jct.2003.08.018";
            block         1;
            archiveFile   "j.jct.2003.08.018.xml";
            articleSha256 "e8e963199f3d54ff7077b9dfe335da211f615c47185523bf9a8a1d60542bacad";
            sha256        "b1ff52085191946a29587083dc07aca39accdbf16666d3ffd88c614f13780ad0";
        }
    );
}
