/*--------------------------------*- Choupo -*-----------------------*\
  Henry's-law constant for R32 in liquid nButanol (infinite dilution).

  Source DATA: the measurements of
    Sousa, J. M. M. V.; Almeida, J. P. B.; Ferreira, A. G. M. et al. (2011) Fluid Phase Equilib. 303, 115-119, doi:10.1016/j.fluid.2011.01.003
  located through the NIST/TRC ThermoML Archive (doi 10.18434/mds2-2422);
  the values belong to those articles.  NO measured point is reproduced here
  or anywhere in this tree; data/curation/henry/R32-nButanol
  declares each dataset by DOI, block and sha256 and regenerates it.

  FIT (DEV.md 4c C321 part 2): van't Hoff in 1/T, every laboratory together,
  least squares then minimax on the relative residual of H; points above
  20 % after the least-squares stage discarded by name (0 here).
  7 kept points, 287.35-309.02 K; max relative error
  1.95 % in-sample (graded 5 / 10 / 20 %).
  Regressed by Choupo, NOT read by a human; the archive's transcription has
  not been read back against the articles.

  NOTE: INFINITE-DILUTION coefficient at the solvent's own vapour pressure;
  validity 287-310 K (the measured span; outside it an extrapolation).
\*---------------------------------------------------------------------------*/

solute      R32;
solvent     nButanol;

gasSpecies        R32;
dissolvedSpecies  R32;
convention        Sander-Hxp-v1;

model       vantHoff;
H_ref       3.01453e+06 Pa;
T_ref       298.15 K;
enthalpy    -7399  J/mol;
Trange      ( 287  310 );

reviewStatus autoPromoted;
review      { by none; }

provenance
{
    origin        fitted;
    source        "doi:10.1016/j.fluid.2011.01.003 (located through ThermoML, doi 10.18434/mds2-2422)";
    method        "van't Hoff fit, least squares then minimax on H_model/H - 1, bin/curate/henry_organic.py";
    CAS           75-10-5;
    fittedInCase  "data/curation/henry/R32-nButanol";
    fitGrade      warning;   // DEV.md 4c C285: max |H_model - H|/H over the kept points, graded 5 / 10 / 20 %
    fitGradeBasis inSample;   // DEV.md 4c C300 rule 1
    fitGradeCap   ( singleLaboratory );   // DEV.md 4c C300 rule 2
    fitGradeMaxRelativeError_pct 1.9539;
    pointsKept    7;
    pointsDiscarded 0;
    fingerprint   "7404f46f03bbbf27";   // of the declaration, frozen before the fit
    evidence
    (
        {
            doi           "10.1016/j.fluid.2011.01.003";
            block         14;
            archiveFile   "j.fluid.2011.01.003.xml";
            articleSha256 "534bcac60b4e2e947928bd710232d1388d10239a59a2baaab4d82db273f39835";
            sha256        "4431354d139874fae88cd5a64d1c9e8db30655976c2f40d8e95410b8bdbb4f23";
        }
    );
}
