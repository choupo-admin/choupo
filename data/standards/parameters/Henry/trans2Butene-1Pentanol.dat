/*--------------------------------*- Choupo -*-----------------------*\
  Henry's-law constant for trans2Butene in liquid 1Pentanol (infinite dilution).

  Source DATA: the measurements of
    Miyano, Y.[Yoshimori] (2005) J. Chem. Thermodyn. 37, 459-465, doi:10.1016/j.jct.2004.11.005
  located through the NIST/TRC ThermoML Archive (doi 10.18434/mds2-2422);
  the values belong to those articles.  NO measured point is reproduced here
  or anywhere in this tree; data/curation/henry/trans2Butene-1Pentanol
  declares each dataset by DOI, block and sha256 and regenerates it.

  FIT (DEV.md 4c C321 part 2): van't Hoff in 1/T, every laboratory together,
  least squares then minimax on the relative residual of H; points above
  20 % after the least-squares stage discarded by name (0 here).
  5 kept points, 249.96-330 K; max relative error
  2.76 % in-sample (graded 10 / 20 / 30 %, C336 class B).
  Regressed by Choupo, NOT read by a human; the archive's transcription has
  not been read back against the articles.

  NOTE: INFINITE-DILUTION coefficient at the solvent's own vapour pressure;
  validity 249-330 K (the measured span; outside it an extrapolation).
\*---------------------------------------------------------------------------*/

solute      trans2Butene;
solvent     1Pentanol;

gasSpecies        trans2Butene;
dissolvedSpecies  trans2Butene;
convention        Sander-Hxp-v1;

model       vantHoff;
H_ref       5.84153e+05 Pa;
T_ref       298.15 K;
enthalpy    -22216  J/mol;
Trange      ( 249  330 );

reviewStatus autoPromoted;
review      { by none; }

provenance
{
    origin        fitted;
    source        "doi:10.1016/j.jct.2004.11.005 (located through ThermoML, doi 10.18434/mds2-2422)";
    method        "van't Hoff fit, least squares then minimax on H_model/H - 1, bin/curate/henry_organic.py";
    CAS           624-64-6;
    fittedInCase  "data/curation/henry/trans2Butene-1Pentanol";
    fitGrade      warning;   // DEV.md 4c C285: max |H_model - H|/H over the kept points, graded 10 / 20 / 30 % (C336 class B)
    fitGradeBasis inSample;   // DEV.md 4c C300 rule 1
    fitGradeCap   ( singleLaboratory );   // DEV.md 4c C300 rule 2
    fitGradeMaxRelativeError_pct 2.7639;
    pointsKept    5;
    pointsDiscarded 0;
    fingerprint   "6755d26c4b631356";   // of the declaration, frozen before the fit
    evidence
    (
        {
            doi           "10.1016/j.jct.2004.11.005";
            block         13;
            archiveFile   "j.jct.2004.11.005.xml";
            articleSha256 "5d3cccfce76800259a6797c36fd2745e32e6bfdb8b31aa691e55b1197b8626f5";
            sha256        "ef5593765562369acd8b9a379d747fcb5333f701c4850c9fdb94c4eddb2fcad2";
        }
    );
}
