/*--------------------------------*- Choupo -*-----------------------*\
  Henry's-law constant for nButane in liquid nButanol (infinite dilution).

  Source DATA: the measurements of
    Miyano, Y.[Yoshimori] (2004) J. Chem. Eng. Data 49, 1285-1289, doi:10.1021/je034265f
  located through the NIST/TRC ThermoML Archive (doi 10.18434/mds2-2422);
  the values belong to those articles.  NO measured point is reproduced here
  or anywhere in this tree; data/curation/henry/nButane-nButanol
  declares each dataset by DOI, block and sha256 and regenerates it.

  FIT (DEV.md 4c C321 part 2): van't Hoff in 1/T, every laboratory together,
  least squares then minimax on the relative residual of H; points above
  20 % after the least-squares stage discarded by name (0 here).
  5 kept points, 250.01-330 K; max relative error
  3.06 % in-sample (graded 10 / 20 / 30 %, C336 class B).
  Regressed by Choupo, NOT read by a human; the archive's transcription has
  not been read back against the articles.

  NOTE: INFINITE-DILUTION coefficient at the solvent's own vapour pressure;
  validity 250-330 K (the measured span; outside it an extrapolation).
\*---------------------------------------------------------------------------*/

solute      nButane;
solvent     nButanol;

gasSpecies        nButane;
dissolvedSpecies  nButane;
convention        Sander-Hxp-v1;

model       vantHoff;
H_ref       8.87986e+05 Pa;
T_ref       298.15 K;
enthalpy    -21756  J/mol;
Trange      ( 250  330 );

reviewStatus autoPromoted;
review      { by none; }

provenance
{
    origin        fitted;
    source        "doi:10.1021/je034265f (located through ThermoML, doi 10.18434/mds2-2422)";
    method        "van't Hoff fit, least squares then minimax on H_model/H - 1, bin/curate/henry_organic.py";
    CAS           106-97-8;
    fittedInCase  "data/curation/henry/nButane-nButanol";
    fitGrade      warning;   // DEV.md 4c C285: max |H_model - H|/H over the kept points, graded 10 / 20 / 30 % (C336 class B)
    fitGradeBasis inSample;   // DEV.md 4c C300 rule 1
    fitGradeCap   ( singleLaboratory );   // DEV.md 4c C300 rule 2
    fitGradeMaxRelativeError_pct 3.0584;
    pointsKept    5;
    pointsDiscarded 0;
    fingerprint   "7fad5c5b3c4e387d";   // of the declaration, frozen before the fit
    evidence
    (
        {
            doi           "10.1021/je034265f";
            block         5;
            archiveFile   "je034265f.xml";
            articleSha256 "ab848132b30950401a393e0a808e38cb29f0ff43e0f9bedbe37955154bbd470b";
            sha256        "d7ae9e51c6c7bc054470f24a4b6190f713630d8ef559f2251e35ec41e7798ecb";
        }
    );
}
