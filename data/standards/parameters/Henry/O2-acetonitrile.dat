/*--------------------------------*- Choupo -*-----------------------*\
  Henry's-law constant for O2 in liquid acetonitrile (infinite dilution).

  Source DATA: the measurements of
    Horstmann, S.[Sven]; Grybat, A.[Andreas]; Kato, R.[Ryo] (2004) J. Chem. Thermodyn. 36, 1015-1018, doi:10.1016/j.jct.2004.07.014
  located through the NIST/TRC ThermoML Archive (doi 10.18434/mds2-2422);
  the values belong to those articles.  NO measured point is reproduced here
  or anywhere in this tree; data/curation/henry/O2-acetonitrile
  declares each dataset by DOI, block and sha256 and regenerates it.

  FIT (DEV.md 4c C321 part 2): van't Hoff in 1/T, every laboratory together,
  least squares then minimax on the relative residual of H; points above
  20 % after the least-squares stage discarded by name (0 here).
  3 kept points, 305.51-353.13 K; max relative error
  0.22 % in-sample (graded 5 / 10 / 20 %).
  Regressed by Choupo, NOT read by a human; the archive's transcription has
  not been read back against the articles.

  NOTE: INFINITE-DILUTION coefficient at the solvent's own vapour pressure;
  validity 305-354 K (the measured span; outside it an extrapolation).
\*---------------------------------------------------------------------------*/

solute      O2;
solvent     acetonitrile;

gasSpecies        O2;
dissolvedSpecies  O2;
convention        Sander-Hxp-v1;

model       vantHoff;
H_ref       2.08451e+08 Pa;
T_ref       298.15 K;
enthalpy    2550  J/mol;
Trange      ( 305  354 );

reviewStatus autoPromoted;
review      { by none; }

provenance
{
    origin        fitted;
    source        "doi:10.1016/j.jct.2004.07.014 (located through ThermoML, doi 10.18434/mds2-2422)";
    method        "van't Hoff fit, least squares then minimax on H_model/H - 1, bin/curate/henry_organic.py";
    CAS           7782-44-7;
    fittedInCase  "data/curation/henry/O2-acetonitrile";
    fitGrade      warning;   // DEV.md 4c C285: max |H_model - H|/H over the kept points, graded 5 / 10 / 20 %
    fitGradeBasis inSample;   // DEV.md 4c C300 rule 1
    fitGradeCap   ( singleLaboratory );   // DEV.md 4c C300 rule 2
    fitGradeMaxRelativeError_pct 0.2210;
    pointsKept    3;
    pointsDiscarded 0;
    fingerprint   "187a3a01946c8403";   // of the declaration, frozen before the fit
    evidence
    (
        {
            doi           "10.1016/j.jct.2004.07.014";
            block         1;
            archiveFile   "j.jct.2004.07.014.xml";
            articleSha256 "3f4487a455e9f520c1f5ea8f63c4455c932fd17d3d25a66d60efd74bd618434f";
            sha256        "b2f8a0689dfb93eb14fdd871c706306d3ccf7b94fa587380caee168a7af1385e";
        }
    );
}
