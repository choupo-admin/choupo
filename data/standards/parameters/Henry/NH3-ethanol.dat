/*--------------------------------*- Choupo -*-----------------------*\
  Henry's-law constant for NH3 in liquid ethanol (infinite dilution).

  Source DATA: the measurements of
    Huang, L.-J.[Liang-Jie]; Xue, W.-L.[Wei-Lan]; Zeng, Z.-X.[Zuo-Xiang] (2011) Fluid Phase Equilib. 303, 80-84, doi:10.1016/j.fluid.2011.01.006
  located through the NIST/TRC ThermoML Archive (doi 10.18434/mds2-2422);
  the values belong to those articles.  NO measured point is reproduced here
  or anywhere in this tree; data/curation/henry/NH3-ethanol
  declares each dataset by DOI, block and sha256 and regenerates it.

  FIT (DEV.md 4c C321 part 2): van't Hoff in 1/T, every laboratory together,
  least squares then minimax on the relative residual of H; points above
  20 % after the least-squares stage discarded by name (2 here).
  4 kept points, 288.65-328.15 K; max relative error
  8.00 % in-sample (graded 5 / 10 / 20 %).
  Regressed by Choupo, NOT read by a human; the archive's transcription has
  not been read back against the articles.

  NOTE: INFINITE-DILUTION coefficient at the solvent's own vapour pressure;
  validity 288-329 K (the measured span; outside it an extrapolation).
\*---------------------------------------------------------------------------*/

solute      NH3;
solvent     ethanol;

gasSpecies        NH3;
dissolvedSpecies  NH3;
convention        Sander-Hxp-v1;

model       vantHoff;
H_ref       6.66030e+05 Pa;
T_ref       298.15 K;
enthalpy    -34324  J/mol;
Trange      ( 288  329 );

reviewStatus autoPromoted;
review      { by none; }

provenance
{
    origin        fitted;
    source        "doi:10.1016/j.fluid.2011.01.006 (located through ThermoML, doi 10.18434/mds2-2422)";
    method        "van't Hoff fit, least squares then minimax on H_model/H - 1, bin/curate/henry_organic.py";
    CAS           7664-41-7;
    fittedInCase  "data/curation/henry/NH3-ethanol";
    fitGrade      warning;   // DEV.md 4c C285: max |H_model - H|/H over the kept points, graded 5 / 10 / 20 %
    fitGradeBasis inSample;   // DEV.md 4c C300 rule 1
    fitGradeMaxRelativeError_pct 7.9963;
    pointsKept    4;
    pointsDiscarded 2;
    fingerprint   "8934846c7a161bb7";   // of the declaration, frozen before the fit
    evidence
    (
        {
            doi           "10.1016/j.fluid.2011.01.006";
            block         1;
            archiveFile   "j.fluid.2011.01.006.xml";
            articleSha256 "4fdf233a095729f94e3dc3a06b1336e1efd9eb5579a6c60778cfb5d5e2e10840";
            sha256        "406b4b37a12ce834f7da95ee303d8a78efd3d7c1920bed99fe73a1e874a319bc";
        }
    );
}
