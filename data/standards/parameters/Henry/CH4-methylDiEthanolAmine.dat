/*--------------------------------*- Choupo -*-----------------------*\
  Henry's-law constant for CH4 in liquid methylDiEthanolAmine (infinite dilution).

  Source DATA: the measurements of
    Jou, F.-Y.[Fang-Yuan]; Mather, A. E.[Alan E.] (2006) J. Chem. Eng. Data 51, 1429-1430, doi:10.1021/je060118g
  located through the NIST/TRC ThermoML Archive (doi 10.18434/mds2-2422);
  the values belong to those articles.  NO measured point is reproduced here
  or anywhere in this tree; data/curation/henry/CH4-methylDiEthanolAmine
  declares each dataset by DOI, block and sha256 and regenerates it.

  FIT (DEV.md 4c C321 part 2): van't Hoff in 1/T, every laboratory together,
  least squares then minimax on the relative residual of H; points above
  20 % after the least-squares stage discarded by name (0 here).
  5 kept points, 298.15-403.15 K; max relative error
  2.71 % in-sample (graded 10 / 20 / 30 %, C336 class B).
  Regressed by Choupo, NOT read by a human; the archive's transcription has
  not been read back against the articles.

  NOTE: INFINITE-DILUTION coefficient at the solvent's own vapour pressure;
  validity 298-404 K (the measured span; outside it an extrapolation).
\*---------------------------------------------------------------------------*/

solute      CH4;
solvent     methylDiEthanolAmine;

gasSpecies        CH4;
dissolvedSpecies  CH4;
convention        Sander-Hxp-v1;

model       vantHoff;
H_ref       1.62998e+08 Pa;
T_ref       298.15 K;
enthalpy    -131  J/mol;
Trange      ( 298  404 );

reviewStatus autoPromoted;
review      { by none; }

provenance
{
    origin        fitted;
    source        "doi:10.1021/je060118g (located through ThermoML, doi 10.18434/mds2-2422)";
    method        "van't Hoff fit, least squares then minimax on H_model/H - 1, bin/curate/henry_organic.py";
    CAS           74-82-8;
    fittedInCase  "data/curation/henry/CH4-methylDiEthanolAmine";
    fitGrade      warning;   // DEV.md 4c C285: max |H_model - H|/H over the kept points, graded 10 / 20 / 30 % (C336 class B)
    fitGradeBasis inSample;   // DEV.md 4c C300 rule 1
    fitGradeCap   ( singleLaboratory );   // DEV.md 4c C300 rule 2
    fitGradeMaxRelativeError_pct 2.7081;
    pointsKept    5;
    pointsDiscarded 0;
    fingerprint   "860f3161af50a250";   // of the declaration, frozen before the fit
    evidence
    (
        {
            doi           "10.1021/je060118g";
            block         0;
            archiveFile   "je060118g.xml";
            articleSha256 "d90db00d721d5f105a64bd55220242b5061ec12e7bdc2e5fe404f17eceeb2263";
            sha256        "7cb46959d7bed540b910378b1edb45406a20bbf0346bd97ab1b1f5b1283acc8b";
        }
    );
}
