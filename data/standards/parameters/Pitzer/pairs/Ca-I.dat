/*--------------------------------*- Choupo -*--------------------------------*\
  Pitzer binary ion-interaction parameters --- (Ca)1(I)2 in water.
  Role: the beta0 / beta1 / Cphi set (alpha1 2, b 1.2) of the Pitzer virial
  expansion, consumed by the pitzer (single-salt) and pitzerHMW
  (multi-ion) activity engines.
  REGRESSED BY CHOUPO (DEV.md 4c C311) to the evaluated gamma_pm and phi
  of R. N. Goldberg and R. L. Nuttall, Evaluated Activity and Osmotic Coefficients for Aqueous Solutions: The Alkaline Earth Metal Halides, J. Phys. Chem. Ref. Data 7 (1978) 263-310, doi:10.1063/1.555569 (Table 22, p. 293 (m, gamma, phi, a_w), the recommended values) -- the evaluation is the
  primary source of those recommended values.  The PARAMETERS are
  Choupo's own work.  Window: 0.1-1.9 mol/kg at 298.15 K
  (15 points fitted, 4 interleaved points held out).
  Outside it the record is an extrapolation; off 25 C it carries no
  temperature extension of its own.
  GRADE: in-sample max error 0.32 % -> clean (capped at warning: one temperature, one evaluation);
  the held-out points 0.227 % (clean).  No human has
  reviewed it.  REPRODUCE: run data/curation/electrolytes/Ca-I; its proposal is held equal to this
  record by bin/curate/check_regressed_electrolytes.py.
\*-----------------------------------------------------------------------------*/
recordType electrolytePairParameters;
schemaVersion 1;

model pitzer;

pair { cation Ca; anion I; }

parameters
{
    beta0   0.4313962684;
    beta1   1.876698418;
    beta2   0;
    Cphi    0.001082762324;
    alpha1  2;
    alpha2  12;
}

source "REGRESSED by Choupo (C311) to R. N. Goldberg and R. L. Nuttall, Evaluated Activity and Osmotic Coefficients for Aqueous Solutions: The Alkaline Earth Metal Halides, J. Phys. Chem. Ref. Data 7 (1978) 263-310, doi:10.1063/1.555569, Table 22, p. 293 (m, gamma, phi, a_w), the recommended values";

provenance
{
    origin        regressed;
    method        "electrolyteFit(pitzer): ln gamma_pm and phi, equal weight, Levenberg-Marquardt";
    methodVersion "choupoProps Choupo-dev";
    fittedInCase  "data/curation/electrolytes/Ca-I";
    reviewStatus  autoPromoted;
    fitGrade      warning;   // DEV.md 4c C311: max relative error of gamma_pm or phi over the fitted points, graded 2 / 5 / 10 %
    fitGradeBasis inSample;   // DEV.md 4c C300 rule 1: the residual of the points it was fitted to
    fitGradeCap   ( singleTemperature singleLaboratory );   // DEV.md 4c C300 rule 2: in-sample clean, capped -- one temperature, one evaluation
    fitGradeMaxRelativeError_pct 0.3201;
    promotedBy    "bin/curate/electrolytes_c311.py promote";
    promotedDate  "2026-11-11";
    reviewReason  "regressed by bin/curate/electrolytes_c311.py from a hand-checked transcription of an evaluated table; not yet read back by a human";
    reuse         "Choupo's own regression; the evaluated values belong to the cited compilation";
    fitDate       "2026-11-11";
    evidence
    (
        {
            role      fit;
            dataset   "constant/experiments/Ca-I.dat";
            doi       "10.1063/1.555569";
            provenance evaluated;
        }
    );
    inSample
    {
        gammaAAD_pct 0.1533;
        phiAAD_pct   0.1497;
        max_pct      0.3201;
        nPoints      15;
    }
    heldOut
    {
        kind         interleavedSameSource;   // every 4th point of the same evaluation: NOT a validation
        gammaAAD_pct 0.1425;
        phiAAD_pct   0.1074;
        max_pct      0.2268;
        nPoints      4;
        grade        clean;
    }
    validity
    {
        temperature { min 298.15 K; max 298.15 K; }
        molality    { min 0.1; max 1.9; }   // mol/kg
        note        "the span of the fitted evaluated values; outside it the salt is an extrapolation";
    }
    review
    {
        by none;
    }
}
