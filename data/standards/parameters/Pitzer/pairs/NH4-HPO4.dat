/*--------------------------------*- Choupo -*--------------------------------*\
  Pitzer binary ion-interaction parameters --- (NH4)2(HPO4)1 in water.
  Role: the beta0 / beta1 / Cphi set (alpha1 2, b 1.2) of the Pitzer virial
  expansion, consumed by the pitzer (single-salt) and pitzerHMW
  (multi-ion) activity engines.
  REGRESSED BY CHOUPO (DEV.md 4c C311) to the evaluated gamma_pm and phi
  of R. N. Goldberg, Evaluated Activity and Osmotic Coefficients for Aqueous Solutions: Thirty-Six Uni-Bivalent Electrolytes, J. Phys. Chem. Ref. Data 10 (1981) 671-764, doi:10.1063/1.555646 (the (NH4)2HPO4 table of recommended values, p. 674 (m, gamma, phi, a_w)) -- the evaluation is the
  primary source of those recommended values.  The PARAMETERS are
  Choupo's own work.  Window: 0.1-2 mol/kg at 298.15 K
  (11 points fitted, 3 interleaved points held out).
  Outside it the record is an extrapolation; off 25 C it carries no
  temperature extension of its own.
  GRADE: in-sample max error 0.308 % -> clean (capped at warning: one temperature, one evaluation);
  the held-out points 0.303 % (clean).  No human has
  reviewed it.  REPRODUCE: run data/curation/electrolytes/NH4-HPO4; its proposal is held equal to this
  record by bin/curate/check_regressed_electrolytes.py.
\*-----------------------------------------------------------------------------*/
recordType electrolytePairParameters;
schemaVersion 1;

model pitzer;

pair { cation NH4; anion HPO4; }

parameters
{
    beta0   -0.0499062057;
    beta1   -0.6414355338;
    beta2   0;
    Cphi    0.008262241868;
    alpha1  2;
    alpha2  12;
}

source "REGRESSED by Choupo (C311) to R. N. Goldberg, Evaluated Activity and Osmotic Coefficients for Aqueous Solutions: Thirty-Six Uni-Bivalent Electrolytes, J. Phys. Chem. Ref. Data 10 (1981) 671-764, doi:10.1063/1.555646, the (NH4)2HPO4 table of recommended values, p. 674 (m, gamma, phi, a_w)";

provenance
{
    origin        regressed;
    method        "electrolyteFit(pitzer): ln gamma_pm and phi, equal weight, Levenberg-Marquardt";
    methodVersion "choupoProps Choupo-dev";
    fittedInCase  "data/curation/electrolytes/NH4-HPO4";
    reviewStatus  autoPromoted;
    fitGrade      warning;   // DEV.md 4c C311: max relative error of gamma_pm or phi over the fitted points, graded 2 / 5 / 10 %
    fitGradeBasis inSample;   // DEV.md 4c C300 rule 1: the residual of the points it was fitted to
    fitGradeCap   ( singleTemperature singleLaboratory );   // DEV.md 4c C300 rule 2: in-sample clean, capped -- one temperature, one evaluation
    fitGradeMaxRelativeError_pct 0.3080;
    promotedBy    "bin/curate/electrolytes_c311.py promote";
    promotedDate  "2026-11-11";
    reviewReason  "regressed by bin/curate/electrolytes_c311.py from a hand-checked transcription of an evaluated table; not yet read back by a human";
    reuse         "Choupo's own regression; the evaluated values belong to the cited compilation";
    fitDate       "2026-11-11";
    evidence
    (
        {
            role      fit;
            dataset   "constant/experiments/NH4-HPO4.dat";
            doi       "10.1063/1.555646";
            provenance evaluated;
        }
    );
    inSample
    {
        gammaAAD_pct 0.0686;
        phiAAD_pct   0.1325;
        max_pct      0.3080;
        nPoints      11;
    }
    heldOut
    {
        kind         interleavedSameSource;   // every 4th point of the same evaluation: NOT a validation
        gammaAAD_pct 0.0834;
        phiAAD_pct   0.1710;
        max_pct      0.3027;
        nPoints      3;
        grade        clean;
    }
    validity
    {
        temperature { min 298.15 K; max 298.15 K; }
        molality    { min 0.1; max 2; }   // mol/kg
        note        "the span of the fitted evaluated values; outside it the salt is an extrapolation";
    }
    review
    {
        by none;
    }
}
