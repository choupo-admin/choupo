/*--------------------------------*- Choupo -*--------------------------------*\
  Pitzer binary ion-interaction parameters --- (Zn)1(I)2 in water.
  Role: the beta0 / beta1 / Cphi set (alpha1 2, b 1.2) of the Pitzer virial
  expansion, consumed by the pitzer (single-salt) and pitzerHMW
  (multi-ion) activity engines.
  REGRESSED BY CHOUPO (DEV.md 4c C311) to the evaluated gamma_pm and phi
  of R. N. Goldberg, Evaluated Activity and Osmotic Coefficients for Aqueous Solutions: Bi-Univalent Compounds of Zinc, Cadmium, and Ethylene Bis(Trimethylammonium) Chloride and Iodide, J. Phys. Chem. Ref. Data 10 (1981) 1-55, doi:10.1063/1.555639 (the ZnI2 table of recommended values, p. 29 (m, gamma, phi, a_w)) -- the evaluation is the
  primary source of those recommended values.  The PARAMETERS are
  Choupo's own work.  Window: 0.1-2 mol/kg at 298.15 K
  (11 points fitted, 3 interleaved points held out).
  Outside it the record is an extrapolation; off 25 C it carries no
  temperature extension of its own.
  GRADE: in-sample max error 3.73 % -> warning;
  the held-out points 2.74 % (warning).  No human has
  reviewed it.  REPRODUCE: run data/curation/electrolytes/Zn-I; its proposal is held equal to this
  record by bin/curate/check_regressed_electrolytes.py.
\*-----------------------------------------------------------------------------*/
recordType electrolytePairParameters;
schemaVersion 1;

model pitzer;

pair { cation Zn; anion I; }

parameters
{
    beta0   0.5956777904;
    beta1   1.938846213;
    beta2   0;
    Cphi    -0.1144773841;
    alpha1  2;
    alpha2  12;
}

source "REGRESSED by Choupo (C311) to R. N. Goldberg, Evaluated Activity and Osmotic Coefficients for Aqueous Solutions: Bi-Univalent Compounds of Zinc, Cadmium, and Ethylene Bis(Trimethylammonium) Chloride and Iodide, J. Phys. Chem. Ref. Data 10 (1981) 1-55, doi:10.1063/1.555639, the ZnI2 table of recommended values, p. 29 (m, gamma, phi, a_w)";

provenance
{
    origin        regressed;
    method        "electrolyteFit(pitzer): ln gamma_pm and phi, equal weight, Levenberg-Marquardt";
    methodVersion "choupoProps Choupo-dev";
    fittedInCase  "data/curation/electrolytes/Zn-I";
    reviewStatus  autoPromoted;
    fitGrade      warning;   // DEV.md 4c C311: max relative error of gamma_pm or phi over the fitted points, graded 2 / 5 / 10 %
    fitGradeBasis inSample;   // DEV.md 4c C300 rule 1: the residual of the points it was fitted to
    fitGradeMaxRelativeError_pct 3.7309;
    promotedBy    "bin/curate/electrolytes_c311.py promote";
    promotedDate  "2026-11-11";
    reviewReason  "regressed by bin/curate/electrolytes_c311.py from a hand-checked transcription of an evaluated table; not yet read back by a human";
    reuse         "Choupo's own regression; the evaluated values belong to the cited compilation";
    fitDate       "2026-11-11";
    evidence
    (
        {
            role      fit;
            dataset   "constant/experiments/Zn-I.dat";
            doi       "10.1063/1.555639";
            provenance evaluated;
        }
    );
    inSample
    {
        gammaAAD_pct 1.0857;
        phiAAD_pct   1.0526;
        max_pct      3.7309;
        nPoints      11;
    }
    heldOut
    {
        kind         interleavedSameSource;   // every 4th point of the same evaluation: NOT a validation
        gammaAAD_pct 1.0136;
        phiAAD_pct   1.3168;
        max_pct      2.7374;
        nPoints      3;
        grade        warning;
    }
    validity
    {
        temperature { min 298.15 K; max 298.15 K; }
        molality    { min 0.1; max 2; }   // mol/kg
        note        "the span of the fitted evaluated values; outside it the salt is an extrapolation";
    }
    review
    {
        by none;
    }
}
