/*--------------------------------*- Choupo -*--------------------------------*\
  Pitzer neutral-cation-anion triplet zeta(H3BO3,Na,SO4) --- dissolved boric acid with Na and SO4.
  Role: the higher-order neutral term of boric acid with a cation and an anion together, in the pitzerHMW engine.
  Source: Felmy & Weare, Geochim. Cosmochim. Acta 50 (1986) 2771-2783, Table 5, p. 2774, read from the page image.
  Fitted by the authors at 25 C: in-sample.  No temperature dependence is given.
\*-----------------------------------------------------------------------------*/
recordType electrolyteMixingParameter;
schemaVersion 1;
kind zeta;
n H3BO3;
c Na;
a SO4;
value 0.046;
source "Felmy & Weare, Geochim. Cosmochim. Acta 50 (1986) 2771-2783, Table 5, p. 2774 (25 C)";

provenance
{
    origin        literature;
    source        "Felmy & Weare, Geochim. Cosmochim. Acta 50 (1986) 2771-2783, Table 5, p. 2774";
    method        "value transcribed from the paper's table; no calculation";
    readings      "zeta02: read three times (text layer, page image at 200 dpi, page image at 300 dpi), data/curation/batches/boron_c198/readings.tsv";
    fitBasis      inSample;   // the paper's own fit: these values reproduce the paper, they do not test it
    validity
    {
        temperature { min 298.15 K; max 298.15 K; }
        note        "25 C: the paper gives no temperature dependence for any of these terms";
    }
}
