{
    origin  literature;
    source  "Gmehling, Li & Schiller, Ind. Eng. Chem. Res. 32 (1993) 178, Table IV, pp. 184-190";
    reuse   "values transcribed from the printed table; the later licensed Dortmund revisions are not entered";
}

