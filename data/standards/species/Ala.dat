aqueousThermo
{
source "hfAq [kJ/mol] -508.52: dHf(aq alanine) -553.75 + dH_ion2 +45.23 -- Miller & Smith-Magowan, J. Phys. Chem. Ref. Data 19 (1990) 1049, Table 3, p. 1054, and Table 6, p. 1057 (read from a page image) ## sAq [J/mol/K] 122.60: S(aq alanine) 159.80 + dS_ion2 (-37.2) -- Miller & Smith-Magowan, J. Phys. Chem. Ref. Data 19 (1990) 1049, Table 3, p. 1054, and Table 6, p. 1057 (read from a page image)";
hfAq { value -508520; unit J/mol;}
sAq  { value 122.6; unit J/mol/K;}
}
