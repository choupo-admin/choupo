/*--------------------------------*- Choupo -*--------------------------------*\
  species/Fe.dat -- ONE model species, ONE typed file (the 2026-07-18
  structural decision: the aqueous monolith dismantled; a sealed case copies
  exactly the species it reaches, so the student sees the facts in use).
  Body fields verbatim from the curated catalogue record (citations ride).
\*-----------------------------------------------------------------------------*/
recordType modelSpecies;
schemaVersion 1;

name    FeII;
formula     "Fe+2";
charge  +2;
MW { value 55.845; unit g/mol;}
aqueousThermo
{
hfAq { value -89100; unit J/mol;}
sAq  { value -137.7;  unit J/mol/K;}
}

transport
{
    //  `radius` is the HYDRATED radius r_H of Nightingale, J. Phys. Chem. 63 (1959) 1381, Table I -- the convention
    //  of every DSPM-DE pore fitted against it -- with its own provenance below.  `D0` is the 25 C limiting
    //  diffusivity read at the page of Li & Gregory 1974 (DEV.md 4c C403; its own provenance below); before: a value
    //  transcribed by machine from a geochemical database.
    radius { value 4.28e-10; unit m; }   // 4.28 A
    D0 { value 7.19e-10; unit m2/s; }
    provenance
    {
        radius
        {
            source        "E. R. Nightingale, Jr., Phenomenological Theory of Ion Solvation. Effective Radii of Hydrated Ions, J. Phys. Chem. 63 (1959) 1381-1387, doi:10.1021/j150579a011, Table I (p. 1383), row Fe+2, column r_H at 25 C: 4.28 A";
            origin        literature;
            method        "read from the primary page (Table I, the effective hydrated radius r_H) and cross-checked against the scan's text layer, 2026-10-25 (DEV.md 4c C157/C161)";
            reviewStatus  interim;
            notes         "The tier's radius convention: Nightingale's hydrated radius, the one the eight master ions carry and DSPM-DE pores are fitted on -- not a Stokes radius from D0 (his r_s column is a different quantity).";
        }
        //  Cross-check, entering no value: the CRC Handbook of Chemistry and Physics, 82nd ed., table
        //  'Ionic Conductivity and Diffusion at Infinite Dilution' (PDF pp. 304-306 of the folder copy), read at its page
        //  as a second opinion on this ion at 25 C; it is a compilation and is not this value's origin.
        D0
        {
            source        "Y.-H. Li and S. Gregory, Diffusion of ions in sea water and in deep-sea sediments, Geochim. Cosmochim. Acta 38 (1974) 703-714, Table 1 (p. 705: tracer and self-diffusion coefficients of ions at infinite dilution, 10^-6 cm2/s at 0, 18 and 25 C), row Fe2+, column 25 C: 7.19 x 10^-6 cm2/s";
            origin        literature;
            method        "read at the page, 2026-11-15 (DEV.md 4c C403): the scan's text layer of this table is garbled, so the row was read from the page image; the 25 C entry converted (1 x 10^-6 cm2/s = 1 x 10^-10 m2/s) to 7.19e-10 m2/s";
            reviewStatus  interim;
            notes         "Li & Gregory give, for the same row, 0 C 3.41 x 1e-10 m2/s; 18 C 5.82 x 1e-10 m2/s; 25 C 7.19 x 1e-10 m2/s (kept here for the later check of the Stokes-Einstein correction to the run temperature, thermo/transport/StokesEinstein.H, which is applied by the consumer). A second compiled table (named in the comment above) gives 7.19e-10 m2/s for this ion at 25 C (-0.0 %).";
        }
    }
}
