/*--------------------------------*- Choupo -*--------------------------------*\
  species/Malic.dat -- ONE model species, ONE typed file: the fully dissociated form of d,l-malic acid.
  Made by bin/curate/species_c373.py from data/curation/batches/species_c373/*.tsv, which holds every
  reading (source, table, page, whether read from a page image).  Standard state: ideal solution at
  1 mol/kg, 298.15 K, H+ = 0.
  The formation values are DERIVED from printed numbers; the arithmetic, tables and pages are in the
  source line below and in formation.tsv.
\*-----------------------------------------------------------------------------*/
recordType modelSpecies;
schemaVersion 1;

name    Malic;
formula     "C4H4O5-2";
charge  -2;
MW { value 132.071; unit g/mol;}
aqueousThermo
{
source "hfAq [kJ/mol] -1082.04: dHf(aq acid, DL) -1083.81 + 2.95 - 1.18 -- Miller & Smith-Magowan, J. Phys. Chem. Ref. Data 19 (1990) 1049, Table 5 p. 1056 and Table 6 p. 1057 (read from a page image), no entropy: Miller prints no S of malic acid or malate";
hfAq { value -1082040; unit J/mol;}
}
