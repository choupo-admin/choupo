/*--------------------------------*- Choupo -*--------------------------------*\
  species/Hydrazine.dat -- ONE model species, ONE typed file: hydrazine in the form a case declares (the compound as weighed), the speciation MASTER of its family.
  Made by bin/curate/species_c373.py from data/curation/batches/species_c373/*.tsv, which holds every
  reading (source, table, page, whether read from a page image).  Standard state: ideal solution at
  1 mol/kg, 298.15 K, H+ = 0.
  The formation values are the PRINTED numbers of the source; the table, page and row are in the
  source line below and in formation.tsv.
\*-----------------------------------------------------------------------------*/
recordType modelSpecies;
schemaVersion 1;

name    Hydrazine;
formula     "N2H4";
charge  0;
MW { value 32.046; unit g/mol;}
aqueousThermo
{
source "hfAq [kJ/mol] 34.31: printed dfH -- Wagman, Evans, Parker, Schumm, Halow, Bailey, Churney & Nuttall, The NBS tables of chemical thermodynamic properties, J. Phys. Chem. Ref. Data 11 (1982) Suppl. 2, Table 18:N, p. 2-65 (PDF p. 73), row N2H4 ao (read from a page image) ## sAq [J/mol/K] 138.: printed S -- Wagman, Evans, Parker, Schumm, Halow, Bailey, Churney & Nuttall, The NBS tables of chemical thermodynamic properties, J. Phys. Chem. Ref. Data 11 (1982) Suppl. 2, Table 18:N, p. 2-65 (PDF p. 73), row N2H4 ao (read from a page image)";
hfAq { value 34310; unit J/mol;}
sAq  { value 138; unit J/mol/K;}
}
