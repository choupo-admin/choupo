/*--------------------------------*- Choupo -*--------------------------------*\
  species/ClO4.dat -- the aqueous species ClO4- (C320, DEV.md 4c).  ONE model species, ONE
  typed file.  Made by bin/curate/species_c320.py from
  data/curation/batches/species_c320/species.tsv, which holds every reading (NBS table, page, row;
  the CRC second reading; the CODATA key value where the species has one) and the chosen value.
  Standard state: ideal solution at 1 mol/kg, 298.15 K, H+ = 0 (NBS convention).  The chosen
  value is NBS (Wagman et al. 1982) unless CODATA (Cox, Wagman & Medvedev 1989) carries the species.
\*-----------------------------------------------------------------------------*/
recordType modelSpecies;
schemaVersion 1;

name    ClO4;
formula     "ClO4-";
charge  -1;
MW { value 99.446; unit g/mol;}
aqueousThermo
{
source "NBS = Wagman et al. 1982, J. Phys. Chem. Ref. Data 11 Suppl. 2, Table 10:Cl, p. 2-47 (PDF p. 55), row ClO4- ao ## second reading, enters no value -- the NBS table as reprinted, read via CRC = CRC Handbook, Thermodynamic Properties of Aqueous Systems, p. 5-86 (TeamLRN_5_1_CODATA_KEY_VALUES_FOR_THERMO.pdf), row ClO4- ## CODATA = CODATA Key Values for Thermodynamics (Cox, Wagman & Medvedev 1989), p. 5-1 (TeamLRN_5_1_CODATA_KEY_VALUES_FOR_THERMO.pdf), row ClO4- aq, the 5-page Codata-key-values-for-thermodynamics.pdf reads the same ## hfAq [kJ/mol] chosen -128.1 (CODATA): NBS -129.33, CRC -129.3, CODATA -128.1 ## sAq [J/mol/K] chosen 184.0 (CODATA): NBS 182.0, CRC 182.0, CODATA 184.0";
hfAq { value -128100; unit J/mol;}
sAq  { value 184.0;  unit J/mol/K;}
}

transport
{
    //  D0 ONLY (DEV.md 4c C403).  No `radius` is curated for this ion: the tier's radius is the HYDRATED radius of
    //  Nightingale, J. Phys. Chem. 63 (1959) 1381, Table I, and it was not read for this record.  A Stokes radius
    //  computed from D0 would be a different convention under the same key, so none is written: DSPM-DE still
    //  refuses this ion by name, while the multi-ionic polarisation film and the electrodialysis units read D0 alone.
    D0 { value 1.794e-09; unit m2/s; }
    provenance
    {
        //  Cross-check, entering no value: the CRC Handbook of Chemistry and Physics, 82nd ed., table
        //  'Ionic Conductivity and Diffusion at Infinite Dilution' (PDF pp. 304-306 of the folder copy), read at its page
        //  as a second opinion on this ion at 25 C; it is a compilation and is not this value's origin.
        D0
        {
            source        "R. A. Robinson and R. H. Stokes, Electrolyte Solutions, 2nd ed., Butterworths, London, 1959, read in the Russian translation (R. Robinson, R. Stoks, Rastvory elektrolitov, ed. A. N. Frumkin, Izdatel'stvo Inostrannoi Literatury, Moskva, 1963), Appendix 6.1 (Predel'naya ekvivalentnaya elektroprovodnost' ionov pri 25 C v vode), p. 534 (PDF p. 531 of the folder copy), row ClO4-: lambda0 = 67.36 S cm2/eq at 25 C; the book's own literature reference for the row: no. 13, J. H. Jones, J. Am. Chem. Soc. 67, 855 (1945)";
            origin        literature;
            method        "read at the page image, 2026-11-15 (DEV.md 4c C403): lambda0 = 67.36 S cm2/eq (x 1e-4 = 0.006736 S m2/eq), converted by the Nernst relation D = R T lambda0 / (|z| F^2) with R = 8.314462618 J/mol/K, F = 96485.33212 C/mol, T = 298.15 K (RT/F^2 = 2.662848e-07), |z| = 1, to 1.794e-09 m2/s";
            reviewStatus  interim;
            notes         "The same conversion applied to the book's Na+ row (lambda0 50.10) gives 1.334e-09 m2/s, +0.3 % against Li & Gregory's 1.33e-9 for Na+ (the conductance and tracer routes differ by that much).  No page of the English edition was seen: every page named here is the Russian translation's.  The book's Appendix 6.2 (p. 537) also gives lambda0 for this ion at 0 C 36.9 and 18 C 58.8 S cm2/eq (0 and 18 C taken by the book from Landolt-Bornstein). A second compiled table (named in the comment above) gives 1.792e-09 m2/s for this ion at 25 C (-0.09 %).";
        }
    }
}
