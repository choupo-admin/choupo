/*--------------------------------*- Choupo -*--------------------------------*\
  species/IO3.dat -- the aqueous species IO3- (C320, DEV.md 4c).  ONE model species, ONE
  typed file.  Made by bin/curate/species_c320.py from
  data/curation/batches/species_c320/species.tsv, which holds every reading (NBS table, page, row;
  the CRC second reading; the CODATA key value where the species has one) and the chosen value.
  Standard state: ideal solution at 1 mol/kg, 298.15 K, H+ = 0 (NBS convention).  The chosen
  value is NBS (Wagman et al. 1982) unless CODATA (Cox, Wagman & Medvedev 1989) carries the species.
\*-----------------------------------------------------------------------------*/
recordType modelSpecies;
schemaVersion 1;

name    IO3;
formula     "IO3-";
charge  -1;
MW { value 174.901; unit g/mol;}
aqueousThermo
{
source "NBS = Wagman et al. 1982, J. Phys. Chem. Ref. Data 11 Suppl. 2, Table 12:I, p. 2-52 (PDF p. 60), row IO3- ao ## CRC = CRC Handbook, Thermodynamic Properties of Aqueous Systems, p. 5-86 (TeamLRN_5_1_CODATA_KEY_VALUES_FOR_THERMO.pdf), row IO3- ## hfAq [kJ/mol] chosen -221.3 (NBS): NBS -221.3, CRC -221.3 ## sAq [J/mol/K] chosen 118.4 (NBS): NBS 118.4, CRC 118.4";
hfAq { value -221300; unit J/mol;}
sAq  { value 118.4;  unit J/mol/K;}
}
