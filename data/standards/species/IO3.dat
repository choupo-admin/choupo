/*--------------------------------*- Choupo -*--------------------------------*\
  species/IO3.dat -- the aqueous species IO3- (C320, DEV.md 4c).  ONE model species, ONE
  typed file.  Made by bin/curate/species_c320.py from
  data/curation/batches/species_c320/species.tsv, which holds every reading (NBS table, page, row;
  the CRC second reading; the CODATA key value where the species has one) and the chosen value.
  Standard state: ideal solution at 1 mol/kg, 298.15 K, H+ = 0 (NBS convention).  The chosen
  value is NBS (Wagman et al. 1982) unless CODATA (Cox, Wagman & Medvedev 1989) carries the species.
\*-----------------------------------------------------------------------------*/
recordType modelSpecies;
schemaVersion 1;

name    IO3;
formula     "IO3-";
charge  -1;
MW { value 174.901; unit g/mol;}
aqueousThermo
{
source "NBS = Wagman et al. 1982, J. Phys. Chem. Ref. Data 11 Suppl. 2, Table 12:I, p. 2-52 (PDF p. 60), row IO3- ao ## second reading, enters no value -- the NBS table as reprinted, read via CRC = CRC Handbook, Thermodynamic Properties of Aqueous Systems, p. 5-86 (TeamLRN_5_1_CODATA_KEY_VALUES_FOR_THERMO.pdf), row IO3- ## hfAq [kJ/mol] chosen -221.3 (NBS): NBS -221.3, CRC -221.3 ## sAq [J/mol/K] chosen 118.4 (NBS): NBS 118.4, CRC 118.4";
hfAq { value -221300; unit J/mol;}
sAq  { value 118.4;  unit J/mol/K;}
}

transport
{
    //  D0 ONLY (DEV.md 4c C403).  No `radius` is curated for this ion: the tier's radius is the HYDRATED radius of
    //  Nightingale, J. Phys. Chem. 63 (1959) 1381, Table I, and it was not read for this record.  A Stokes radius
    //  computed from D0 would be a different convention under the same key, so none is written: DSPM-DE still
    //  refuses this ion by name, while the multi-ionic polarisation film and the electrodialysis units read D0 alone.
    D0 { value 1.06e-09; unit m2/s; }
    provenance
    {
        //  Cross-check, entering no value: the CRC Handbook of Chemistry and Physics, 82nd ed., table
        //  'Ionic Conductivity and Diffusion at Infinite Dilution' (PDF pp. 304-306 of the folder copy), read at its page
        //  as a second opinion on this ion at 25 C; it is a compilation and is not this value's origin.
        D0
        {
            source        "Y.-H. Li and S. Gregory, Diffusion of ions in sea water and in deep-sea sediments, Geochim. Cosmochim. Acta 38 (1974) 703-714, Table 1 (p. 705: tracer and self-diffusion coefficients of ions at infinite dilution, 10^-6 cm2/s at 0, 18 and 25 C), row IO3-, column 25 C: 10.6 x 10^-6 cm2/s";
            origin        literature;
            method        "read at the page, 2026-11-15 (DEV.md 4c C403): the scan's text layer of this table is garbled, so the row was read from the page image; the 25 C entry converted (1 x 10^-6 cm2/s = 1 x 10^-10 m2/s) to 1.06e-09 m2/s";
            reviewStatus  interim;
            notes         "Li & Gregory give, for the same row, 0 C 5.05 x 1e-10 m2/s; 18 C 8.79 x 1e-10 m2/s; 25 C 10.6 x 1e-10 m2/s (kept here for the later check of the Stokes-Einstein correction to the run temperature, thermo/transport/StokesEinstein.H, which is applied by the consumer). A second compiled table (named in the comment above) gives 1.078e-09 m2/s for this ion at 25 C (+1.7 %).";
        }
    }
}
