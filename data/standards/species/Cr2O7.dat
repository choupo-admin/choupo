/*--------------------------------*- Choupo -*--------------------------------*\
  species/Cr2O7.dat -- the aqueous species Cr2O7-2 (C320, DEV.md 4c).  ONE model species, ONE
  typed file.  Made by bin/curate/species_c320.py from
  data/curation/batches/species_c320/species.tsv, which holds every reading (NBS table, page, row;
  the CRC second reading; the CODATA key value where the species has one) and the chosen value.
  Standard state: ideal solution at 1 mol/kg, 298.15 K, H+ = 0 (NBS convention).  The chosen
  value is NBS (Wagman et al. 1982) unless CODATA (Cox, Wagman & Medvedev 1989) carries the species.
\*-----------------------------------------------------------------------------*/
recordType modelSpecies;
schemaVersion 1;

name    Cr2O7;
formula     "Cr2O7-2";
charge  -2;
MW { value 215.985; unit g/mol;}
aqueousThermo
{
source "NBS = Wagman et al. 1982, J. Phys. Chem. Ref. Data 11 Suppl. 2, Table 51:Cr, p. 2-197 (PDF p. 205), row Cr2O7 2- ao ## CRC = CRC Handbook, Thermodynamic Properties of Aqueous Systems, p. 5-86 (TeamLRN_5_1_CODATA_KEY_VALUES_FOR_THERMO.pdf), row Cr2O7-2 ## hfAq [kJ/mol] chosen -1490.3 (NBS): NBS -1490.3, CRC -1490.3 ## sAq [J/mol/K] chosen 261.9 (NBS): NBS 261.9, CRC 261.9";
hfAq { value -1490300; unit J/mol;}
sAq  { value 261.9;  unit J/mol/K;}
}
