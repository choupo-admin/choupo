/*--------------------------------*- Choupo -*--------------------------------*\
  species/Ox.dat -- ONE model species, ONE typed file: the doubly charged anion of oxalic acid.

  hfAq: Wagman et al. 1982, J. Phys. Chem. Ref. Data 11 Suppl. 2, Table 23:C, p. 2-93 (HC2O4-, ao: -818.4 kJ/mol, S 149.4 J/mol/K) and p. 2-92 (C2O4--, ao: -825.1 kJ/mol, S 45.6 J/mol/K).
\*-----------------------------------------------------------------------------*/
recordType modelSpecies;
schemaVersion 1;

name    Ox;
formula     "C2O4-2";
charge  -2;
MW { value 88.018; unit g/mol;}
aqueousThermo
{
source "Wagman et al. 1982, J. Phys. Chem. Ref. Data 11 Suppl. 2, Table 23:C, p. 2-93 (HC2O4-, ao: -818.4 kJ/mol, S 149.4 J/mol/K) and p. 2-92 (C2O4--, ao: -825.1 kJ/mol, S 45.6 J/mol/K)";
hfAq { value -825100; unit J/mol;}
sAq  { value 45.6; unit J/mol/K;}
}

transport
{
    //  D0 ONLY (DEV.md 4c C403).  No `radius` is curated for this ion: the tier's radius is the HYDRATED radius of
    //  Nightingale, J. Phys. Chem. 63 (1959) 1381, Table I, and it was not read for this record.  A Stokes radius
    //  computed from D0 would be a different convention under the same key, so none is written: DSPM-DE still
    //  refuses this ion by name, while the multi-ionic polarisation film and the electrodialysis units read D0 alone.
    D0 { value 9.866e-10; unit m2/s; }
    provenance
    {
        //  Cross-check, entering no value: the CRC Handbook of Chemistry and Physics, 82nd ed., table
        //  'Ionic Conductivity and Diffusion at Infinite Dilution' (PDF pp. 304-306 of the folder copy), read at its page
        //  as a second opinion on this ion at 25 C; it is a compilation and is not this value's origin.
        D0
        {
            source        "R. A. Robinson and R. H. Stokes, Electrolyte Solutions, 2nd ed., Butterworths, London, 1959, read in the Russian translation (R. Robinson, R. Stoks, Rastvory elektrolitov, ed. A. N. Frumkin, Izdatel'stvo Inostrannoi Literatury, Moskva, 1963), Appendix 6.1 (Predel'naya ekvivalentnaya elektroprovodnost' ionov pri 25 C v vode), p. 535 (PDF p. 532 of the folder copy), row C2O4 2-: lambda0 = 74.1 S cm2/eq at 25 C; the book's own literature reference for the row: no. 23, L. S. Darken, J. Am. Chem. Soc. 63, 1007 (1941)";
            origin        literature;
            method        "read at the page image, 2026-11-15 (DEV.md 4c C403): lambda0 = 74.1 S cm2/eq (x 1e-4 = 0.00741 S m2/eq), converted by the Nernst relation D = R T lambda0 / (|z| F^2) with R = 8.314462618 J/mol/K, F = 96485.33212 C/mol, T = 298.15 K (RT/F^2 = 2.662848e-07), |z| = 2, to 9.866e-10 m2/s";
            reviewStatus  interim;
            notes         "The same conversion applied to the book's Na+ row (lambda0 50.10) gives 1.334e-09 m2/s, +0.3 % against Li & Gregory's 1.33e-9 for Na+ (the conductance and tracer routes differ by that much).  No page of the English edition was seen: every page named here is the Russian translation's. A second compiled table (named in the comment above) gives 9.87e-10 m2/s for this ion at 25 C (+0.04 %).";
        }
    }
}
