/*--------------------------------*- Choupo -*--------------------------------*\
  species/H3Aspt.dat -- ONE model species, ONE typed file: the most protonated form of L-aspartic acid, the speciation MASTER of its family.
  Made by bin/curate/species_c373.py from data/curation/batches/species_c373/*.tsv, which holds every
  reading (source, table, page, whether read from a page image).  Standard state: ideal solution at
  1 mol/kg, 298.15 K, H+ = 0.
  The formation values are DERIVED from printed numbers; the arithmetic, tables and pages are in the
  source line below and in formation.tsv.
\*-----------------------------------------------------------------------------*/
recordType modelSpecies;
schemaVersion 1;

name    H3Aspt;
formula     "C4H8NO4+";
charge  +1;
MW { value 134.111; unit g/mol;}
aqueousThermo
{
source "hfAq [kJ/mol] -954.96: dHf(aq L-aspartic acid) -947.50 - dH_ion1 +7.46 -- Miller & Smith-Magowan, J. Phys. Chem. Ref. Data 19 (1990) 1049, Table 3, p. 1054, and Table 6, p. 1057 (read from a page image), the aqueous acid is dHf(cr) -973.32 +/- 0.92 plus dH(soln) +25.82 ## sAq [J/mol/K] 242.49: S(aq aspartic acid) 229.49 - dS_ion1 (-13.0) -- Miller & Smith-Magowan, J. Phys. Chem. Ref. Data 19 (1990) 1049, Table 3, p. 1054, and Table 6, p. 1057 (read from a page image)";
hfAq { value -954960; unit J/mol;}
sAq  { value 242.49; unit J/mol/K;}
}
