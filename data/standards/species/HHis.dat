/*--------------------------------*- Choupo -*--------------------------------*\
  species/HHis.dat -- ONE model species, ONE typed file: L-histidine in the form a case declares (the compound as weighed), the speciation MASTER of its family.
  Made by bin/curate/species_c373.py from data/curation/batches/species_c373/*.tsv, which holds every
  reading (source, table, page, whether read from a page image).  Standard state: ideal solution at
  1 mol/kg, 298.15 K, H+ = 0.
  The formation values are the PRINTED numbers of the source; the table, page and row are in the
  source line below and in formation.tsv.
\*-----------------------------------------------------------------------------*/
recordType modelSpecies;
schemaVersion 1;

name    HHis;
formula     "C6H9N3O2";
charge  0;
MW { value 155.157; unit g/mol;}
aqueousThermo
{
source "hfAq [kJ/mol] -452.71: printed dfH(aq) His -108.20 kcal/mol x 4.184 -- Amend & Helgeson, Calculation of the standard molal thermodynamic properties of aqueous biomolecules at elevated temperatures and pressures. Part 1. L-alpha-Amino acids, J. Chem. Soc., Faraday Trans. 93 (1997) 1927-1941, Table 1, p. 1929, row His, Amend & Helgeson state this value as calculated from the crystal's formation enthalpy and heat of solution (neutral) or from the neutral and the printed ionisation enthalpy (charged), Table 1 footnotes d-s ## sAq [J/mol/K] 276.14: printed S His 66.00 cal/mol/K x 4.184 -- Amend & Helgeson, Calculation of the standard molal thermodynamic properties of aqueous biomolecules at elevated temperatures and pressures. Part 1. L-alpha-Amino acids, J. Chem. Soc., Faraday Trans. 93 (1997) 1927-1941, Table 1, p. 1929, row His, calculated by the authors from the printed DfG and DfH with the elements' entropies (Table 1 footnote c), H+ = 0";
hfAq { value -452710; unit J/mol;}
sAq  { value 276.14; unit J/mol/K;}
}
