/*--------------------------------*- Choupo -*--------------------------------*\
  species/H2Cit.dat -- ONE model species, ONE typed file: the singly charged anion of citric acid.

  hfAq: Kochergina, Volkov, Krutov & Krutova, Russ. J. Phys. Chem. 80 (2006) 899-903, Table 4 (weighted mean of two calorimetric procedures; the species are the hypothetical non-dissociated H2Cit-/HCit2- and Cit3- of the paper's reference state).
\*-----------------------------------------------------------------------------*/
recordType modelSpecies;
schemaVersion 1;

name    H2Cit;
formula     "H2C6H5O7-";
charge  -1;
MW { value 191.115; unit g/mol;}
aqueousThermo
{
source "Kochergina, Volkov, Krutov & Krutova, Russ. J. Phys. Chem. 80 (2006) 899-903, Table 4 (weighted mean of two calorimetric procedures; the species are the hypothetical non-dissociated H2Cit-/HCit2- and Cit3- of the paper's reference state)";
hfAq { value -1529700; unit J/mol;}
}

transport
{
    //  D0 ONLY (DEV.md 4c C403).  No `radius` is curated for this ion: the tier's radius is the HYDRATED radius of
    //  Nightingale, J. Phys. Chem. 63 (1959) 1381, Table I, and it was not read for this record.  A Stokes radius
    //  computed from D0 would be a different convention under the same key, so none is written: DSPM-DE still
    //  refuses this ion by name, while the multi-ionic polarisation film and the electrodialysis units read D0 alone.
    D0 { value 9.773e-10; unit m2/s; }
    provenance
    {
        //  Cross-check, entering no value: the CRC Handbook of Chemistry and Physics, 82nd ed., table
        //  'Ionic Conductivity and Diffusion at Infinite Dilution' (PDF pp. 304-306 of the folder copy), read at its page
        //  as a second opinion on this ion at 25 C; it is a compilation and is not this value's origin.
        D0
        {
            source        "A. Apelblat and J. Barthel, Conductance Studies on Aqueous Citric Acid, Z. Naturforsch. 46a (1991) 131-140, Table 9 (p. 138), row H2Cit-: lambda0 = 36.70 S cm2/eq at 25 C (A FIT RESULT, not a measurement: the Quint-Viallard equations solved with the measured citric acid conductance, the first dissociation constant and lambda0(H+) = 349.85, giving lambda0(H2Cit-) at each temperature)";
            origin        literature;
            method        "read at the page image, 2026-11-15 (DEV.md 4c C403): lambda0 = 36.70 S cm2/eq (x 1e-4 = 0.00367 S m2/eq), converted by the Nernst relation D = R T lambda0 / (|z| F^2) with R = 8.314462618 J/mol/K, F = 96485.33212 C/mol, T = 298.15 K (RT/F^2 = 2.662848e-07), |z| = 1, to 9.773e-10 m2/s";
            reviewStatus  interim;
            notes         "The same row at 278.15 to 308.15 K (7 temperatures): 21.62, 25.08, 28.69, 32.56, 36.70, 41.03, 45.56 S cm2/eq (Table 9).  It depends on the assumed distance of closest approach and on the dissociation constant, so it carries more uncertainty than the trivalent anion.  The same table assigns lambda0(1/2 HCit2-) = 46.00 from a fixed ratio to lambda0(H2Cit-) and lambda0(1/3 Cit3-) (an assumption, not a measurement): NOT entered here. A second compiled table (named in the comment above) gives 7.99e-10 m2/s for this ion at 25 C (-18.2 %).";
        }
    }
}
