/*--------------------------------*- Choupo -*--------------------------------*\
  species/N2H5.dat -- ONE model species, ONE typed file: an intermediate ionisation state of hydrazine.
  Made by bin/curate/species_c373.py from data/curation/batches/species_c373/*.tsv, which holds every
  reading (source, table, page, whether read from a page image).  Standard state: ideal solution at
  1 mol/kg, 298.15 K, H+ = 0.
  The formation values are the PRINTED numbers of the source; the table, page and row are in the
  source line below and in formation.tsv.
\*-----------------------------------------------------------------------------*/
recordType modelSpecies;
schemaVersion 1;

name    N2H5;
formula     "N2H5+";
charge  +1;
MW { value 33.054; unit g/mol;}
aqueousThermo
{
source "hfAq [kJ/mol] -7.5: printed dfH -- Wagman, Evans, Parker, Schumm, Halow, Bailey, Churney & Nuttall, The NBS tables of chemical thermodynamic properties, J. Phys. Chem. Ref. Data 11 (1982) Suppl. 2, Table 18:N, p. 2-65 (PDF p. 73), row N2H5+ ao (read from a page image) ## sAq [J/mol/K] 151.: printed S -- Wagman, Evans, Parker, Schumm, Halow, Bailey, Churney & Nuttall, The NBS tables of chemical thermodynamic properties, J. Phys. Chem. Ref. Data 11 (1982) Suppl. 2, Table 18:N, p. 2-65 (PDF p. 73), row N2H5+ ao (read from a page image)";
hfAq { value -7500; unit J/mol;}
sAq  { value 151; unit J/mol/K;}
}
