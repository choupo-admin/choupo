/*--------------------------------*- Choupo -*--------------------------------*\
  species/NO3.dat -- ONE model species, ONE typed file (the 2026-07-18
  structural decision: the aqueous monolith dismantled; a sealed case copies
  exactly the species it reaches, so the student sees the facts in use).
  Body fields verbatim from the curated catalogue record (citations ride).
\*-----------------------------------------------------------------------------*/
recordType modelSpecies;
schemaVersion 1;

name    NO3;
formula     "NO3-";
charge  -1;
MW { value 62.004; unit g/mol;}
aqueousThermo
{
hfAq { value -207360; unit J/mol;}
sAq  { value 146.4;  unit J/mol/K;}
        // Criss-Cobble 1964 (JACS 86, 5390, Table II, verbatim):
// T-AVERAGED partial molal heat capacity Cp-bar]_298^T,
// cal/mol/K on the CC ABSOLUTE single-ion scale (Cp(H+) =
// 28 cal at 25 C -- cancels in any NEUTRAL salt sum, the
// only thing the engine consumes).
cpAvg298
{
    model  crissCobble1964;
    scale  crissCobbleAbsolute;
    units  "cal/mol/K";
    averageFrom298
    (
        { T 298.15; value -56; }
        { T 333.15; value -49; }
        { T 373.15; value -63; }
        { T 423.15; value -55; }
        { T 473.15; value -57; }
    );
    source "Criss & Cobble, JACS 86 (1964) 5390, Table II";
}
}

transport
{
    //  `radius` is the HYDRATED radius r_H of Nightingale, J. Phys. Chem. 63
    //  (1959) 1381, Table I -- the convention of the eight master ions and
    //  of every DSPM-DE pore fitted against them -- read from the primary
    //  page on 2026-10-25 (DEV.md 4c C161; its own provenance below).
    //  `D0` is from the PHREEQC database (DEV.md 4c C157), whose source line
    //  is the record-level `source`.
    radius { value 3.35e-10; unit m; }   // 3.35 A
    D0 { value 1.9e-09; unit m2/s; }
    provenance
    {
        source  "USGS PHREEQC database phreeqc.dat (usgs-coupled/phreeqc3, branch master, fetched 2026-10-25, sha256 5b80d45c989cd1db7aab485e198321ba550d5902be8097c8be26d85ba03da278), SOLUTION_SPECIES `NO3- = NO3-` (line 148), `-dw` line 152: the 25 C tracer diffusion coefficient Dw is its first field; the further fields (temperature and ionic-strength dependence) are not used.  The database names no per-value reference on this line; its file-level references are Appelo, Parkhurst and Post, Geochim. Cosmochim. Acta 125 (2014) 49-67 (its ref. 1) and Appelo, Cem. Concr. Res. 101 (2017) 102-113 (its ref. 3)";
        licence publicDomain;
        radius
        {
            source        "E. R. Nightingale, Jr., Phenomenological Theory of Ion Solvation. Effective Radii of Hydrated Ions, J. Phys. Chem. 63 (1959) 1381-1387, doi:10.1021/j150579a011, Table I (p. 1383), row NO3-, column r_H at 25 C: 3.35 A";
            origin        literature;
            method        "read from the primary page (Table I, the effective hydrated radius r_H) and cross-checked against the scan's text layer, 2026-10-25 (DEV.md 4c C157/C161)";
            reviewStatus  interim;
            notes         "The tier's radius convention: Nightingale's hydrated radius, the one the eight master ions carry and DSPM-DE pores are fitted on -- not a Stokes radius from D0 (his r_s column is a different quantity).  The source line above is the radius's; the record-level `source` is the D0's.";
        }
        D0
        {
            origin        literature;
            method        "read from the cited database line by a parse that checks the species equation above it (Dw at 25 C, infinite dilution)";
            reviewStatus  interim;
            notes         "Transcribed by machine from the cited public-domain database, not read back against a primary measurement of this ion's limiting conductance; the Stokes-Einstein correction to the run temperature is applied by the consumer (thermo/transport/StokesEinstein.H).";
        }
    }
}

volumetric
{
    //  STANDARD-STATE (infinite-dilution) partial molar volume,
    //  CONVENTIONAL scale V0(H+) = 0 (see the convention profile:
    //  only electroneutral sums are physical).
    V0          { value 29.0; unit cm3/mol; }
    convention  MilleroConventional-v1;
    Trange      ( 293 303 );   // 25 C table; +-5 K working band, extrapolation announced by the consumer's domain refusals
    source      "Millero, Chem. Rev. 71 (1971) 147, Table III (Conventional Partial Molal Volumes of Ions in Water at 0, 25 and 50 degC), 25 degC block, p. 162 -- PRIMARY PAGE READ 2026-08-24 (delegated review, docs/design/interim-review-2026-08-24.md).  Millero states the table is itself taken from the compilation of his ref 81";
}
