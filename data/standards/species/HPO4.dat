/*--------------------------------*- Choupo -*--------------------------------*\
  species/HPO4.dat -- ONE model species, ONE typed file (the 2026-07-18
  structural decision: the aqueous monolith dismantled; a sealed case copies
  exactly the species it reaches, so the student sees the facts in use).
  Body fields verbatim from the curated catalogue record (citations ride).
\*-----------------------------------------------------------------------------*/
recordType modelSpecies;
schemaVersion 1;

name    HPO4;
formula     "HPO4-2";
charge  -2;
MW { value 95.979; unit g/mol;}
aqueousThermo
{
// BEGIN C376 formation data (generated by bin/curate/species_c373.py from data/curation/batches/species_c373/*.tsv; do not edit)
source "hfAq [kJ/mol] -1292.14: printed dfH -- Wagman, Evans, Parker, Schumm, Halow, Bailey, Churney & Nuttall, The NBS tables of chemical thermodynamic properties, J. Phys. Chem. Ref. Data 11 (1982) Suppl. 2, Table 19:P, p. 2-73 (PDF p. 81), row HPO4 2- ao (read from a page image) ## sAq [J/mol/K] -33.5: printed S -- Wagman, Evans, Parker, Schumm, Halow, Bailey, Churney & Nuttall, The NBS tables of chemical thermodynamic properties, J. Phys. Chem. Ref. Data 11 (1982) Suppl. 2, Table 19:P, p. 2-73 (PDF p. 81), row HPO4 2- ao (read from a page image), the sign of the entropy is a minus (page image)";
hfAq { value -1292140; unit J/mol;}
sAq  { value -33.5; unit J/mol/K;}
// END C376
// Criss-Cobble 1964 (JACS 86, 5390, Table II, verbatim):
// T-AVERAGED partial molal heat capacity Cp-bar]_298^T,
// cal/mol/K on the CC ABSOLUTE single-ion scale.
cpAvg298
{
    model  crissCobble1964;
    scale  crissCobbleAbsolute;
    units  "cal/mol/K";
    averageFrom298
    (
        { T 298.15; value -132; }
        { T 333.15; value -118; }
        { T 373.15; value -129; }
        { T 423.15; value -138; }
        { T 473.15; value -146; }
    );
    source "Criss & Cobble, JACS 86 (1964) 5390, Table II";
}
}

transport
{
    //  D0 ONLY (DEV.md 4c C157).  No `radius` is curated for this ion: the
    //  tier's radius is the HYDRATED radius of Nightingale, J. Phys. Chem. 63
    //  (1959) 1381 -- the convention of the eight master ions and of every
    //  DSPM-DE pore fitted against them -- and that table was not read back
    //  in the session that wrote this block.  A Stokes radius computed from
    //  D0 would be a different convention under the same key, so none is
    //  written: DSPM-DE still refuses this ion by name, while the multi-ionic
    //  polarisation film and the electrodialysis units read D0 alone.
    D0 { value 7.34e-10; unit m2/s; }
    provenance
    {
        //  Cross-check, entering no value: the CRC Handbook of Chemistry and Physics, 82nd ed., table
        //  'Ionic Conductivity and Diffusion at Infinite Dilution' (PDF pp. 304-306 of the folder copy), read at its page
        //  as a second opinion on this ion at 25 C; it is a compilation and is not this value's origin.
        D0
        {
            source        "Y.-H. Li and S. Gregory, Diffusion of ions in sea water and in deep-sea sediments, Geochim. Cosmochim. Acta 38 (1974) 703-714, Table 1 (p. 705: tracer and self-diffusion coefficients of ions at infinite dilution, 10^-6 cm2/s at 0, 18 and 25 C), row HPO4 2-, column 25 C: 7.34 x 10^-6 cm2/s";
            origin        literature;
            method        "read at the page, 2026-11-15 (DEV.md 4c C403): the scan's text layer of this table is garbled, so the row was read from the page image; the 25 C entry converted (1 x 10^-6 cm2/s = 1 x 10^-10 m2/s) to 7.34e-10 m2/s";
            reviewStatus  interim;
            notes         "Li & Gregory give, for the same row, 0 C not given; 18 C not given; 25 C 7.34 x 1e-10 m2/s (kept here for the later check of the Stokes-Einstein correction to the run temperature, thermo/transport/StokesEinstein.H, which is applied by the consumer). A second compiled table (named in the comment above) gives 7.59e-10 m2/s for this ion at 25 C (+3.4 %).";
        }
    }
}
