/*--------------------------------*- Choupo -*--------------------------------*\
  species/HTart.dat -- ONE model species, ONE typed file (the 2026-07-18
  structural decision: the aqueous monolith dismantled; a sealed case copies
  exactly the species it reaches, so the student sees the facts in use).
  Body fields verbatim from the curated catalogue record (citations ride).
\*-----------------------------------------------------------------------------*/
recordType modelSpecies;
schemaVersion 1;

name    HTart;
formula     "HC4H4O6-";
charge  -1;
MW { value 149.08; unit g/mol;}
aqueousThermo
{
hfAq { value -1292100; unit J/mol;}
}

transport
{
    //  D0 ONLY (DEV.md 4c C403).  No `radius` is curated for this ion: the tier's radius is the HYDRATED radius of
    //  Nightingale, J. Phys. Chem. 63 (1959) 1381, Table I, and it was not read for this record.  A Stokes radius
    //  computed from D0 would be a different convention under the same key, so none is written: DSPM-DE still
    //  refuses this ion by name, while the multi-ionic polarisation film and the electrodialysis units read D0 alone.
    D0 { value 8.455e-10; unit m2/s; }
    provenance
    {
        D0
        {
            source        "M. Bester-Rogac, R. Neueder, J. Barthel and A. Apelblat, Conductivity Studies of Aqueous Solutions of Stereoisomers of Tartaric Acids and Tartrates. Part II: D-, L-, and Meso-Tartaric Acids, J. Solution Chem. 26 (1997) 537-550, Table III (p. 545); the same values in Part III, Table II (p. 304), J. Solution Chem. 27 (1998) 299-307, row HTar-: lambda0 = 31.75 S cm2/eq at 25 C (A FIT RESULT, not a direct measurement: lambda0(HTar-) that makes the calculated conductivity of D-, L- and meso-tartaric acid agree with the measured one, with K1 = 5.3e-4 mol/dm3 and K2 = 1.21e-5 mol/dm3 and lambda0(1/2 Tar2-) = 60.49)";
            origin        literature;
            method        "read at the page image, 2026-11-15 (DEV.md 4c C403): lambda0 = 31.75 S cm2/eq (x 1e-4 = 0.003175 S m2/eq), converted by the Nernst relation D = R T lambda0 / (|z| F^2) with R = 8.314462618 J/mol/K, F = 96485.33212 C/mol, T = 298.15 K (RT/F^2 = 2.662848e-07), |z| = 1, to 8.455e-10 m2/s";
            reviewStatus  interim;
            notes         "The same row at 278.15, 283.15, 288.15, 293.15, 298.15, 303.15, 308.15 K: 19.75, 22.51, 25.42, 28.45, 31.75, 35.06, 38.61 S cm2/eq (Part II Table III; Part III Table II p. 304 prints the same row).  The authors quote 38.89 for the same ion from Dippy et al.; that value is not used.  The CRC table has no hydrogen tartrate row.";
        }
    }
}
