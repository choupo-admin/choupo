/*--------------------------------*- Choupo -*--------------------------------*\
  species/HGlyc.dat -- ONE model species, ONE typed file: the most protonated form of glycolic acid, the speciation MASTER of its family.
  Made by bin/curate/species_c373.py from data/curation/batches/species_c373/*.tsv, which holds every
  reading (source, table, page, whether read from a page image).  Standard state: ideal solution at
  1 mol/kg, 298.15 K, H+ = 0.
  The formation values are the PRINTED numbers of the source; the table, page and row are in the
  source line below and in formation.tsv.
\*-----------------------------------------------------------------------------*/
recordType modelSpecies;
schemaVersion 1;

name    HGlyc;
formula     "HC2H3O3";
charge  0;
MW { value 76.051; unit g/mol;}
aqueousThermo
{
source "hfAq [kJ/mol] -648.06: printed DfH(aq) -154890 cal/mol x 4.184 -- Shock, Organic acids in hydrothermal solutions: standard molal thermodynamic properties of carboxylic acids, and estimates of dissociation constants at high temperatures and pressures, Am. J. Sci. 295 (1995) 496-580, Table 8, p. 538 (PDF p. 43), and Table 10, p. 544 (PDF p. 49), row glycolic acid (read from a page image), Table 8 footnote a: Miller & Smith-Magowan's value 'corrected in present study', it equals Miller's own crystal -664.0 + heat of solution +15.94 = -648.06 (Miller's printed aqueous -651.0 does not close with them) ## sAq [J/mol/K] 180.33: printed S 43.1 cal/mol/K x 4.184 -- Shock, Organic acids in hydrothermal solutions: standard molal thermodynamic properties of carboxylic acids, and estimates of dissociation constants at high temperatures and pressures, Am. J. Sci. 295 (1995) 496-580, Table 10, p. 544, row glycolic acid (read from a page image), the paper marks it estimated (Table 10 footnote g, eq 39)";
hfAq { value -648060; unit J/mol;}
sAq  { value 180.33; unit J/mol/K;}
provenance
{
    sAq
    {
        origin  estimated;
        method  "Shock (1995) Table 10 footnote g: S of the aqueous hydroxyacid estimated with the author's eq (39)";
    }
}
}
