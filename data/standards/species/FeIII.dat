/*--------------------------------*- Choupo -*--------------------------------*\
  species/Fep3.dat -- ONE model species, ONE typed file (the 2026-07-18
  structural decision: the aqueous monolith dismantled; a sealed case copies
  exactly the species it reaches, so the student sees the facts in use).
  Body fields verbatim from the curated catalogue record (citations ride).
\*-----------------------------------------------------------------------------*/
recordType modelSpecies;
schemaVersion 1;

name    FeIII;
formula     "Fe+3";
charge  +3;
MW { value 55.845; unit g/mol;}
aqueousThermo
{
hfAq { value -48500; unit J/mol;}
sAq  { value -315.9;  unit J/mol/K;}
}

transport
{
    //  D0 ONLY (DEV.md 4c C403).  No `radius` is curated for this ion: the tier's radius is the HYDRATED radius of
    //  Nightingale, J. Phys. Chem. 63 (1959) 1381, Table I, and it was not read for this record.  A Stokes radius
    //  computed from D0 would be a different convention under the same key, so none is written: DSPM-DE still
    //  refuses this ion by name, while the multi-ionic polarisation film and the electrodialysis units read D0 alone.
    D0 { value 6.07e-10; unit m2/s; }
    provenance
    {
        //  Cross-check, entering no value: the CRC Handbook of Chemistry and Physics, 82nd ed., table
        //  'Ionic Conductivity and Diffusion at Infinite Dilution' (PDF pp. 304-306 of the folder copy), read at its page
        //  as a second opinion on this ion at 25 C; it is a compilation and is not this value's origin.
        D0
        {
            source        "Y.-H. Li and S. Gregory, Diffusion of ions in sea water and in deep-sea sediments, Geochim. Cosmochim. Acta 38 (1974) 703-714, Table 1 (p. 705: tracer and self-diffusion coefficients of ions at infinite dilution, 10^-6 cm2/s at 0, 18 and 25 C), row Fe3+, column 25 C: 6.07 x 10^-6 cm2/s";
            origin        literature;
            method        "read at the page, 2026-11-15 (DEV.md 4c C403): the scan's text layer of this table is garbled, so the row was read from the page image; the 25 C entry converted (1 x 10^-6 cm2/s = 1 x 10^-10 m2/s) to 6.07e-10 m2/s";
            reviewStatus  interim;
            notes         "Li & Gregory give, for the same row, 0 C not given; 18 C 5.28 x 1e-10 m2/s; 25 C 6.07 x 1e-10 m2/s (kept here for the later check of the Stokes-Einstein correction to the run temperature, thermo/transport/StokesEinstein.H, which is applied by the consumer). A second compiled table (named in the comment above) gives 6.04e-10 m2/s for this ion at 25 C (-0.5 %).";
        }
    }
}
