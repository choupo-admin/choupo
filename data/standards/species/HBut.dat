/*--------------------------------*- Choupo -*--------------------------------*\
  species/HBut.dat -- ONE model species, ONE typed file: the most protonated form of n-butyric acid, the speciation MASTER of its family.
  Made by bin/curate/species_c373.py from data/curation/batches/species_c373/*.tsv, which holds every
  reading (source, table, page, whether read from a page image).  Standard state: ideal solution at
  1 mol/kg, 298.15 K, H+ = 0.
  The formation values are the PRINTED numbers of the source; the table, page and row are in the
  source line below and in formation.tsv.
\*-----------------------------------------------------------------------------*/
recordType modelSpecies;
schemaVersion 1;

name    HBut;
formula     "HC4H7O2";
charge  0;
MW { value 88.106; unit g/mol;}
aqueousThermo
{
source "hfAq [kJ/mol] -535.34: printed DfH -127950 cal/mol x 4.184 -- Shock, Organic acids in hydrothermal solutions: standard molal thermodynamic properties of carboxylic acids, and estimates of dissociation constants at high temperatures and pressures, Am. J. Sci. 295 (1995) 496-580, Table 4, p. 518 (PDF p. 23), row butanoic acid (read from a page image), Table 2 / Table 4: from the heat of solution and the formation enthalpy of the liquid or the hydration reaction (experimental quantities), DfG printed -91210 ## sAq [J/mol/K] 234.72: printed S 56.1 cal/mol/K x 4.184 -- Shock, Organic acids in hydrothermal solutions: standard molal thermodynamic properties of carboxylic acids, and estimates of dissociation constants at high temperatures and pressures, Am. J. Sci. 295 (1995) 496-580, Table 4, p. 518 (PDF p. 23), row butanoic acid (read from a page image), the paper marks this S as estimated (Table 4 footnote i (eq 13))";
hfAq { value -535340; unit J/mol;}
sAq  { value 234.72; unit J/mol/K;}
provenance
{
    sAq
    {
        origin  estimated;
        method  "Shock (1995) S of the aqueous acid is an ESTIMATE of the author (i (eq 13)), not a measurement (Table 4, footnote i (eq 13))";
    }
}
}
