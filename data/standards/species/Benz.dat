/*--------------------------------*- Choupo -*--------------------------------*\
  species/Benz.dat -- ONE model species, ONE typed file: the fully dissociated form of benzoic acid.
  Made by bin/curate/species_c373.py from data/curation/batches/species_c373/*.tsv, which holds every
  reading (source, table, page, whether read from a page image).  Standard state: ideal solution at
  1 mol/kg, 298.15 K, H+ = 0.
  The formation values are the PRINTED numbers of the source; the table, page and row are in the
  source line below and in formation.tsv.
\*-----------------------------------------------------------------------------*/
recordType modelSpecies;
schemaVersion 1;

name    Benz;
formula     "C7H5O2-";
charge  -1;
MW { value 121.115; unit g/mol;}
aqueousThermo
{
source "hfAq [kJ/mol] -355.60: printed DfH -84990 cal/mol x 4.184 -- Shock, Organic acids in hydrothermal solutions: standard molal thermodynamic properties of carboxylic acids, and estimates of dissociation constants at high temperatures and pressures, Am. J. Sci. 295 (1995) 496-580, Table 4, p. 518 (PDF p. 23), row benzoate (read from a page image), calculated by the paper from the acid's DfH and the selected dissociation enthalpy (Table 4 footnote x or ab) ## sAq [J/mol/K] 151.46: printed S 36.2 cal/mol/K x 4.184 -- Shock, Organic acids in hydrothermal solutions: standard molal thermodynamic properties of carboxylic acids, and estimates of dissociation constants at high temperatures and pressures, Am. J. Sci. 295 (1995) 496-580, Table 4, p. 518 (PDF p. 23), row benzoate (read from a page image), acid's experimental S plus the selected dissociation entropy (footnote s)";
hfAq { value -355600; unit J/mol;}
sAq  { value 151.46; unit J/mol/K;}
}

transport
{
    //  D0 ONLY (DEV.md 4c C403).  No `radius` is curated for this ion: the tier's radius is the HYDRATED radius of
    //  Nightingale, J. Phys. Chem. 63 (1959) 1381, Table I, and it was not read for this record.  A Stokes radius
    //  computed from D0 would be a different convention under the same key, so none is written: DSPM-DE still
    //  refuses this ion by name, while the multi-ionic polarisation film and the electrodialysis units read D0 alone.
    D0 { value 8.622e-10; unit m2/s; }
    provenance
    {
        //  Cross-check, entering no value: the CRC Handbook of Chemistry and Physics, 82nd ed., table
        //  'Ionic Conductivity and Diffusion at Infinite Dilution' (PDF pp. 304-306 of the folder copy), read at its page
        //  as a second opinion on this ion at 25 C; it is a compilation and is not this value's origin.
        D0
        {
            source        "R. A. Robinson and R. H. Stokes, Electrolyte Solutions, 2nd ed., Butterworths, London, 1959, read in the Russian translation (R. Robinson, R. Stoks, Rastvory elektrolitov, ed. A. N. Frumkin, Izdatel'stvo Inostrannoi Literatury, Moskva, 1963), Appendix 6.1 (Predel'naya ekvivalentnaya elektroprovodnost' ionov pri 25 C v vode), p. 534 (PDF p. 531 of the folder copy), row Benzoat (benzoate): lambda0 = 32.38 S cm2/eq at 25 C; the book's own literature reference for the row: no. 20, Brockman and Kilpatrick, J. Am. Chem. Soc. 56, 1483 (1934)";
            origin        literature;
            method        "read at the page image, 2026-11-15 (DEV.md 4c C403): lambda0 = 32.38 S cm2/eq (x 1e-4 = 0.003238 S m2/eq), converted by the Nernst relation D = R T lambda0 / (|z| F^2) with R = 8.314462618 J/mol/K, F = 96485.33212 C/mol, T = 298.15 K (RT/F^2 = 2.662848e-07), |z| = 1, to 8.622e-10 m2/s";
            reviewStatus  interim;
            notes         "The same conversion applied to the book's Na+ row (lambda0 50.10) gives 1.334e-09 m2/s, +0.3 % against Li & Gregory's 1.33e-9 for Na+ (the conductance and tracer routes differ by that much).  No page of the English edition was seen: every page named here is the Russian translation's. A second compiled table (named in the comment above) gives 8.63e-10 m2/s for this ion at 25 C (+0.09 %).";
        }
    }
}
