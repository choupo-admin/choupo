/*--------------------------------*- Choupo -*--------------------------------*\
  species/HCit.dat -- ONE model species, ONE typed file: the doubly charged anion of citric acid.

  hfAq: Kochergina, Volkov, Krutov & Krutova, Russ. J. Phys. Chem. 80 (2006) 899-903, Table 4 (weighted mean of two calorimetric procedures; the species are the hypothetical non-dissociated H2Cit-/HCit2- and Cit3- of the paper's reference state).
\*-----------------------------------------------------------------------------*/
recordType modelSpecies;
schemaVersion 1;

name    HCit;
formula     "HC6H5O7-2";
charge  -2;
MW { value 190.107; unit g/mol;}
aqueousThermo
{
source "Kochergina, Volkov, Krutov & Krutova, Russ. J. Phys. Chem. 80 (2006) 899-903, Table 4 (weighted mean of two calorimetric procedures; the species are the hypothetical non-dissociated H2Cit-/HCit2- and Cit3- of the paper's reference state)";
hfAq { value -1526200; unit J/mol;}
}
