/*--------------------------------*- Choupo -*--------------------------------*\
  species/Succ.dat -- ONE model species, ONE typed file: the fully dissociated form of succinic acid.
  Made by bin/curate/species_c373.py from data/curation/batches/species_c373/*.tsv, which holds every
  reading (source, table, page, whether read from a page image).  Standard state: ideal solution at
  1 mol/kg, 298.15 K, H+ = 0.
  The formation values are the PRINTED numbers of the source; the table, page and row are in the
  source line below and in formation.tsv.
\*-----------------------------------------------------------------------------*/
recordType modelSpecies;
schemaVersion 1;

name    Succ;
formula     "C4H4O4-2";
charge  -2;
MW { value 116.072; unit g/mol;}
aqueousThermo
{
source "hfAq [kJ/mol] -909.37: printed dHf(aq ion 2-) in the succinic column, equals -912.11 + 3.18 - 0.45 -- Miller & Smith-Magowan, J. Phys. Chem. Ref. Data 19 (1990) 1049, Table 2, p. 1059 (read from a page image), the two Table 6 enthalpies sum to 2.73, the printed dH_ion (both steps) ## sAq [J/mol/K] 81.5: printed S(aq ion 2-), equals 260.62 - 69.9 - 109.2 = 81.52 -- Miller & Smith-Magowan, J. Phys. Chem. Ref. Data 19 (1990) 1049, Table 2, p. 1059 (read from a page image)";
hfAq { value -909370; unit J/mol;}
sAq  { value 81.5; unit J/mol/K;}
}
