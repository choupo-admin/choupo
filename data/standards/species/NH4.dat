/*--------------------------------*- Choupo -*--------------------------------*\
  species/NH4.dat -- ONE model species, ONE typed file (the 2026-07-18
  structural decision: the aqueous monolith dismantled; a sealed case copies
  exactly the species it reaches, so the student sees the facts in use).
  Body fields verbatim from the curated catalogue record (citations ride).
\*-----------------------------------------------------------------------------*/
recordType modelSpecies;
schemaVersion 1;

name    NH4;
formula     "NH4+";
charge  +1;
MW { value 18.039; unit g/mol;}
aqueousThermo
{
hfAq { value -132510; unit J/mol;}
sAq  { value 113.4;  unit J/mol/K;}
}

transport
{
    //  D0 ONLY (DEV.md 4c C157).  No `radius` is curated for this ion: the
    //  tier's radius is the HYDRATED radius of Nightingale, J. Phys. Chem. 63
    //  (1959) 1381 -- the convention of the eight master ions and of every
    //  DSPM-DE pore fitted against them -- and that table was not read back
    //  in the session that wrote this block.  A Stokes radius computed from
    //  D0 would be a different convention under the same key, so none is
    //  written: DSPM-DE still refuses this ion by name, while the multi-ionic
    //  polarisation film and the electrodialysis units read D0 alone.
    D0 { value 1.98e-09; unit m2/s; }
    provenance
    {
        source  "USGS PHREEQC database phreeqc.dat (usgs-coupled/phreeqc3, branch master, fetched 2026-10-25, sha256 5b80d45c989cd1db7aab485e198321ba550d5902be8097c8be26d85ba03da278), SOLUTION_SPECIES `NO3- + 10 H+ + 8 e- = NH4+ + 3 H2O` (line 298), `-dw` line 304: the 25 C tracer diffusion coefficient Dw is its first field; the further fields (temperature and ionic-strength dependence) are not used.  The database names no per-value reference on this line; its file-level references are Appelo, Parkhurst and Post, Geochim. Cosmochim. Acta 125 (2014) 49-67 (its ref. 1) and Appelo, Cem. Concr. Res. 101 (2017) 102-113 (its ref. 3)";
        licence publicDomain;
        D0
        {
            origin        literature;
            method        "read from the cited database line by a parse that checks the species equation above it (Dw at 25 C, infinite dilution)";
            reviewStatus  interim;
            notes         "Transcribed by machine from the cited public-domain database, not read back against a primary measurement of this ion's limiting conductance; the Stokes-Einstein correction to the run temperature is applied by the consumer (thermo/transport/StokesEinstein.H).";
        }
    }
}

volumetric
{
    //  STANDARD-STATE (infinite-dilution) partial molar volume,
    //  CONVENTIONAL scale V0(H+) = 0 (see the convention profile:
    //  only electroneutral sums are physical).
    V0          { value 17.86; unit cm3/mol; }
    convention  MilleroConventional-v1;
    Trange      ( 293 303 );   // 25 C table; +-5 K working band, extrapolation announced by the consumer's domain refusals
    source      "Millero, Chem. Rev. 71 (1971) 147, Table III (Conventional Partial Molal Volumes of Ions in Water at 0, 25 and 50 degC), 25 degC block, p. 162 -- PRIMARY PAGE READ 2026-08-24 (delegated review, docs/design/interim-review-2026-08-24.md).  Millero states the table is itself taken from the compilation of his ref 81";
}
