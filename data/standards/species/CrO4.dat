/*--------------------------------*- Choupo -*--------------------------------*\
  species/CrO4.dat -- the aqueous species CrO4-2 (C320, DEV.md 4c).  ONE model species, ONE
  typed file.  Made by bin/curate/species_c320.py from
  data/curation/batches/species_c320/species.tsv, which holds every reading (NBS table, page, row;
  the CRC second reading; the CODATA key value where the species has one) and the chosen value.
  Standard state: ideal solution at 1 mol/kg, 298.15 K, H+ = 0 (NBS convention).  The chosen
  value is NBS (Wagman et al. 1982) unless CODATA (Cox, Wagman & Medvedev 1989) carries the species.
\*-----------------------------------------------------------------------------*/
recordType modelSpecies;
schemaVersion 1;

name    CrO4;
formula     "CrO4-2";
charge  -2;
MW { value 115.992; unit g/mol;}
aqueousThermo
{
source "NBS = Wagman et al. 1982, J. Phys. Chem. Ref. Data 11 Suppl. 2, Table 51:Cr, p. 2-197 (PDF p. 205), row CrO4 2- ao ## CRC = CRC Handbook, Thermodynamic Properties of Aqueous Systems, p. 5-86 (TeamLRN_5_1_CODATA_KEY_VALUES_FOR_THERMO.pdf), row CrO4-2 ## hfAq [kJ/mol] chosen -881.15 (NBS): NBS -881.15, CRC -881.2 ## sAq [J/mol/K] chosen 50.21 (NBS): NBS 50.21, CRC 50.2";
hfAq { value -881150; unit J/mol;}
sAq  { value 50.21;  unit J/mol/K;}
}
