/*--------------------------------*- Choupo -*--------------------------------*\
  species/I.dat -- ONE model species, ONE typed file (the 2026-07-18
  structural decision: the aqueous monolith dismantled; a sealed case copies
  exactly the species it reaches, so the student sees the facts in use).
  Body fields verbatim from the curated catalogue record (citations ride).
\*-----------------------------------------------------------------------------*/
recordType modelSpecies;
schemaVersion 1;

// CURATION STUB (Criss-Cobble migration 2026-07-18): the ion's
// T-averaged Cp is PRIMARY-cited below; hfAq/sAq are NOT curated
// yet -- a package consuming this ion's formation data must wait
// for that curation (the loud-absence doctrine), the CC heat-
// capacity tier alone is served.
name    I;
formula     "I-";
charge  -1;
MW { value 126.904; unit g/mol;}
aqueousThermo
{
// Criss-Cobble 1964 (JACS 86, 5390, Table II, verbatim):
// T-AVERAGED partial molal heat capacity Cp-bar]_298^T,
// cal/mol/K on the CC ABSOLUTE single-ion scale.
cpAvg298
{
    model  crissCobble1964;
    scale  crissCobbleAbsolute;
    units  "cal/mol/K";
    averageFrom298
    (
        { T 298.15; value -62; }
        { T 333.15; value -55; }
        { T 373.15; value -58; }
        { T 423.15; value -61; }
        { T 473.15; value -64; }
    );
    source "Criss & Cobble, JACS 86 (1964) 5390, Table II";
}
}

transport
{
    //  `radius` ONLY (DEV.md 4c C161): the HYDRATED radius r_H of
    //  Nightingale, J. Phys. Chem. 63 (1959) 1381, Table I -- the
    //  convention of the eight master ions and of every DSPM-DE pore fitted
    //  against them.  No `D0`: no PHREEQC database carries one for I-
    //  (DEV.md 4c C157), so DSPM-DE still refuses this ion by name, on D0.
    radius { value 3.31e-10; unit m; }   // 3.31 A
    provenance
    {
        radius
        {
            source        "E. R. Nightingale, Jr., Phenomenological Theory of Ion Solvation. Effective Radii of Hydrated Ions, J. Phys. Chem. 63 (1959) 1381-1387, doi:10.1021/j150579a011, Table I (p. 1383), row I-, column r_H at 25 C: 3.31 A";
            origin        literature;
            method        "read from the primary page (Table I, the effective hydrated radius r_H) and cross-checked against the scan's text layer, 2026-10-25 (DEV.md 4c C157/C161)";
            reviewStatus  interim;
            notes         "The tier's radius convention: Nightingale's hydrated radius, the one the eight master ions carry and DSPM-DE pores are fitted on -- not a Stokes radius from D0 (his r_s column is a different quantity).";
        }
    }
}
