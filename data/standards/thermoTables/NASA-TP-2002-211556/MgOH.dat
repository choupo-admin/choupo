/*--------------------------------*- Choupo -*-----------------------*\
  Species MgOH (NASA/TP-2002-211556 appendix D entry "MgOH"):
  ideal-gas formation data and heat capacity transcribed by machine with
  bin/curate/nasa_tp2002_to_choupo.py table, which holds H and S at
  298.15 K recomputed from the printed coefficients to the printed
  values.  Not read back against the page by a curator.
  The report's own description and sources: Gurvich,1996a pt1 p404 pt2 p322.
\*---------------------------------------------------------------------------*/
name           MgOH;
formula        MgOH;
CAS            n/a;
MW             41.31234;       // kg/kmol, appendix D record line
role           gasOnly;       // free radical (odd electron count 21)
tags           ( gasPhase thermoTable );
nasaEntry      "MgOH";
reviewStatus   interim;
reviewReason   "transcribed by machine from NASA/TP-2002-211556 into the thermoTables home and checked against the report itself; not yet read back against the page by a curator";
standardThermochemistry
{
    dHf_298    -132428.980;   // J/mol  -- ideal gas; NASA/TP-2002-211556 appendix D, p. 150, entry MgOH
    s_298      232.622;     // J/(mol·K) -- third-law absolute; Table B1, p. 24
}

idealGasHeatCapacity
{
    //  NASA/TP-2002-211556 eq. (1), Cp/R = a1/T^2 + a2/T + a3 + a4 T + a5 T^2
    //  + a6 T^3 + a7 T^4; appendix D, p. 150, entry MgOH, a1..a7 as printed.
    model    NASA9;
    Tlow     200;
    Tcommon  1000;
    Thigh    6000;
    low      ( 3.839851620e+04 -7.367383640e+02 7.920664460e+00 -5.950940590e-04 -2.112941162e-06 3.228282110e-09 -1.214159329e-12 );
    high     ( 6.648664750e+05 -1.770750355e+03 7.269999270e+00 5.336842760e-04 -1.980894443e-07 3.025677088e-11 -1.554849476e-15 );
}

provenance
{
    dHf_298
    {
        origin        literature;
        method        "NASA/TP-2002-211556 appendix D, p. 150, entry MgOH, record-line H(298.15) (elements reference, so = dHf)";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "Table B1 p. 24 prints -132.429 kJ/mol; the report's own sources: Gurvich,1996a pt1 p404 pt2 p322.";
    }
    s_298
    {
        origin        literature;
        method        "NASA/TP-2002-211556 Table B1, p. 24, entry MgOH";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "appendix D's coefficients with b2 integrate to 232.622";
    }
    idealGasHeatCapacity
    {
        origin        literature;
        method        "NASA/TP-2002-211556 appendix D, p. 150, entry MgOH, a1..a7 of the 200-1000 K and 1000-6000 K intervals, as printed";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "read by bin/curate/nasa_tp2002_to_choupo.py, which holds H and S at 298.15 K to the printed values";
    }
    source   "McBride, Zehe & Gordon, NASA Glenn Coefficients for Calculating Thermodynamic Properties of Individual Species, NASA/TP-2002-211556 (2002)";
    licence  publicDomain;    // US government work (NASA), 17 U.S.C. 105
}
