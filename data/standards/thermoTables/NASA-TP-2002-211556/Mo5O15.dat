/*--------------------------------*- Choupo -*-----------------------*\
  Species Mo5O15 (NASA/TP-2002-211556 appendix D entry "Mo5O15"):
  ideal-gas formation data and heat capacity transcribed by machine with
  bin/curate/nasa_tp2002_to_choupo.py table, which holds H and S at
  298.15 K recomputed from the printed coefficients to the printed
  values.  Not read back against the page by a curator.
  The report's own description and sources: Gurvich,1982 pt1 p38 pt2 p40.
\*---------------------------------------------------------------------------*/
name           Mo5O15;
formula        Mo5O15;
CAS            n/a;
MW             719.691;       // kg/kmol, appendix D record line
role           nonvolatile;   // ideal-gas species: no vapour pressure is asked of it
tags           ( gasPhase thermoTable );
nasaEntry      "Mo5O15";
reviewStatus   interim;
reviewReason   "transcribed by machine from NASA/TP-2002-211556 into the thermoTables home and checked against the report itself; not yet read back against the page by a curator";
standardThermochemistry
{
    dHf_298    -3329108.437;   // J/mol  -- ideal gas; NASA/TP-2002-211556 appendix D, p. 152, entry Mo5O15
    s_298      709.311;     // J/(mol·K) -- third-law absolute; Table B1, p. 24
}

idealGasHeatCapacity
{
    //  NASA/TP-2002-211556 eq. (1), Cp/R = a1/T^2 + a2/T + a3 + a4 T + a5 T^2
    //  + a6 T^3 + a7 T^4; appendix D, p. 152, entry Mo5O15, a1..a7 as printed.
    model    NASA9;
    Tlow     200;
    Tcommon  1000;
    Thigh    6000;
    low      ( 2.768903251e+05 -3.757933100e+03 3.408197760e+01 9.485414960e-02 -1.442672100e-04 1.031163900e-07 -2.868600013e-11 );
    high     ( -1.535389516e+06 -1.710367122e+03 5.927125780e+01 -5.066836290e-04 1.116223706e-07 -1.276562233e-11 5.902318910e-16 );
}

provenance
{
    dHf_298
    {
        origin        literature;
        method        "NASA/TP-2002-211556 appendix D, p. 152, entry Mo5O15, record-line H(298.15) (elements reference, so = dHf)";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "Table B1 p. 24 prints -3329.108 kJ/mol; the report's own sources: Gurvich,1982 pt1 p38 pt2 p40.";
    }
    s_298
    {
        origin        literature;
        method        "NASA/TP-2002-211556 Table B1, p. 24, entry Mo5O15";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "appendix D's coefficients with b2 integrate to 709.311";
    }
    idealGasHeatCapacity
    {
        origin        literature;
        method        "NASA/TP-2002-211556 appendix D, p. 152, entry Mo5O15, a1..a7 of the 200-1000 K and 1000-6000 K intervals, as printed";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "read by bin/curate/nasa_tp2002_to_choupo.py, which holds H and S at 298.15 K to the printed values";
    }
    source   "McBride, Zehe & Gordon, NASA Glenn Coefficients for Calculating Thermodynamic Properties of Individual Species, NASA/TP-2002-211556 (2002)";
    licence  publicDomain;    // US government work (NASA), 17 U.S.C. 105
}
