/*--------------------------------*- Choupo -*-----------------------*\
  Species OCCN (NASA/TP-2002-211556 appendix D entry "OCCN"):
  ideal-gas formation data and heat capacity transcribed by machine with
  bin/curate/nasa_tp2002_to_choupo.py table, which holds H and S at
  298.15 K recomputed from the printed coefficients to the printed
  values.  Not read back against the page by a curator.
  The report's own description and sources: Cyanooxomethyl radical. Dorofeeva,2001.
\*---------------------------------------------------------------------------*/
name           OCCN;
formula        C2NO;
CAS            n/a;
MW             54.02754;       // kg/kmol, appendix D record line
role           gasOnly;       // free radical (odd electron count 27)
tags           ( gasPhase thermoTable );
nasaEntry      "OCCN";
reviewStatus   interim;
reviewReason   "transcribed by machine from NASA/TP-2002-211556 into the thermoTables home and checked against the report itself; not yet read back against the page by a curator";
standardThermochemistry
{
    dHf_298    210000.000;   // J/mol  -- ideal gas; NASA/TP-2002-211556 appendix D, p. 93, entry OCCN
    s_298      278.187;     // J/(mol·K) -- third-law absolute; Table B1, p. 16
}

idealGasHeatCapacity
{
    //  NASA/TP-2002-211556 eq. (1), Cp/R = a1/T^2 + a2/T + a3 + a4 T + a5 T^2
    //  + a6 T^3 + a7 T^4; appendix D, p. 93, entry OCCN, a1..a7 as printed.
    model    NASA9;
    Tlow     200;
    Tcommon  1000;
    Thigh    6000;
    low      ( 2.428801276e+04 -5.525864620e+02 8.587838170e+00 -3.379387770e-03 1.119841826e-05 -1.008408077e-08 3.086448824e-12 );
    high     ( 9.359131680e+05 -4.441082290e+03 1.368959297e+01 -1.647530917e-03 3.819873440e-07 -3.945161000e-11 1.509598839e-15 );
}

provenance
{
    dHf_298
    {
        origin        literature;
        method        "NASA/TP-2002-211556 appendix D, p. 93, entry OCCN, record-line H(298.15) (elements reference, so = dHf)";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "Table B1 p. 16 prints 210.0 kJ/mol; the report's own sources: Cyanooxomethyl radical. Dorofeeva,2001.";
    }
    s_298
    {
        origin        literature;
        method        "NASA/TP-2002-211556 Table B1, p. 16, entry OCCN";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "appendix D's coefficients with b2 integrate to 278.187";
    }
    idealGasHeatCapacity
    {
        origin        literature;
        method        "NASA/TP-2002-211556 appendix D, p. 93, entry OCCN, a1..a7 of the 200-1000 K and 1000-6000 K intervals, as printed";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "read by bin/curate/nasa_tp2002_to_choupo.py, which holds H and S at 298.15 K to the printed values";
    }
    source   "McBride, Zehe & Gordon, NASA Glenn Coefficients for Calculating Thermodynamic Properties of Individual Species, NASA/TP-2002-211556 (2002)";
    licence  publicDomain;    // US government work (NASA), 17 U.S.C. 105
}
