/*--------------------------------*- Choupo -*-----------------------*\
  Species SF5 (NASA/TP-2002-211556 appendix D entry "SF5"):
  ideal-gas formation data and heat capacity transcribed by machine with
  bin/curate/nasa_tp2002_to_choupo.py table, which holds H and S at
  298.15 K recomputed from the printed coefficients to the printed
  values.  Not read back against the page by a curator.
  The report's own description and sources: Gurvich,1989 pt1 p308 pt2 p189.
\*---------------------------------------------------------------------------*/
name           SF5;
formula        SF5;
CAS            n/a;
MW             127.057;       // kg/kmol, appendix D record line
role           gasOnly;       // free radical (odd electron count 61)
tags           ( gasPhase thermoTable );
nasaEntry      "SF5";
reviewStatus   interim;
reviewReason   "transcribed by machine from NASA/TP-2002-211556 into the thermoTables home and checked against the report itself; not yet read back against the page by a curator";
standardThermochemistry
{
    dHf_298    -902663.287;   // J/mol  -- ideal gas; NASA/TP-2002-211556 appendix D, p. 181, entry SF5
    s_298      322.275;     // J/(mol·K) -- third-law absolute; Table B1, p. 28
}

idealGasHeatCapacity
{
    //  NASA/TP-2002-211556 eq. (1), Cp/R = a1/T^2 + a2/T + a3 + a4 T + a5 T^2
    //  + a6 T^3 + a7 T^4; appendix D, p. 181, entry SF5, a1..a7 as printed.
    model    NASA9;
    Tlow     200;
    Tcommon  1000;
    Thigh    6000;
    low      ( 2.224176850e+05 -4.043991750e+03 2.707196786e+01 -1.744176604e-02 1.604198715e-05 -7.997243020e-09 1.667968061e-12 );
    high     ( -3.892426370e+05 -1.825826536e+02 1.613765057e+01 -5.544834230e-05 1.231433706e-08 -1.417173409e-12 6.584889400e-17 );
}

provenance
{
    dHf_298
    {
        origin        literature;
        method        "NASA/TP-2002-211556 appendix D, p. 181, entry SF5, record-line H(298.15) (elements reference, so = dHf)";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "Table B1 p. 28 prints -902.663 kJ/mol; the report's own sources: Gurvich,1989 pt1 p308 pt2 p189.";
    }
    s_298
    {
        origin        literature;
        method        "NASA/TP-2002-211556 Table B1, p. 28, entry SF5";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "appendix D's coefficients with b2 integrate to 322.275";
    }
    idealGasHeatCapacity
    {
        origin        literature;
        method        "NASA/TP-2002-211556 appendix D, p. 181, entry SF5, a1..a7 of the 200-1000 K and 1000-6000 K intervals, as printed";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "read by bin/curate/nasa_tp2002_to_choupo.py, which holds H and S at 298.15 K to the printed values";
    }
    source   "McBride, Zehe & Gordon, NASA Glenn Coefficients for Calculating Thermodynamic Properties of Individual Species, NASA/TP-2002-211556 (2002)";
    licence  publicDomain;    // US government work (NASA), 17 U.S.C. 105
}
