/*--------------------------------*- Choupo -*-----------------------*\
  Species C4H9_tbutyl (NASA/TP-2002-211556 appendix D entry "C4H9,t-butyl"):
  ideal-gas formation data and heat capacity transcribed by machine with
  bin/curate/nasa_tp2002_to_choupo.py table, which holds H and S at
  298.15 K recomputed from the printed coefficients to the printed
  values.  Not read back against the page by a curator.
  The report's own description and sources: 1,1dimethylethyl radical. Tsang,1985.
\*---------------------------------------------------------------------------*/
name           C4H9_tbutyl;
formula        C4H9;
CAS            n/a;
MW             57.11426;       // kg/kmol, appendix D record line
role           nonvolatile;   // ideal-gas species: no vapour pressure is asked of it
tags           ( gasPhase thermoTable );
nasaEntry      "C4H9,t-butyl";
reviewStatus   interim;
reviewReason   "transcribed by machine from NASA/TP-2002-211556 into the thermoTables home and checked against the report itself; not yet read back against the page by a curator";
standardThermochemistry
{
    dHf_298    51700.000;   // J/mol  -- ideal gas; NASA/TP-2002-211556 appendix D, p. 98, entry C4H9,t-butyl
    s_298      319.719;     // J/(mol·K) -- third-law absolute; Table B1, p. 16
}

idealGasHeatCapacity
{
    //  NASA/TP-2002-211556 eq. (1), Cp/R = a1/T^2 + a2/T + a3 + a4 T + a5 T^2
    //  + a6 T^3 + a7 T^4; appendix D, p. 98, entry C4H9,t-butyl, a1..a7 as printed.
    model    NASA9;
    Tlow     200;
    Tcommon  1000;
    Thigh    6000;
    low      ( -4.723461950e+05 8.090198770e+03 -4.683675340e+01 1.575300095e-01 -1.686559436e-04 9.981040130e-08 -2.487608823e-11 );
    high     ( 7.151064950e+06 -3.171224410e+04 5.442510320e+01 -6.392331160e-03 1.241097612e-06 -1.287248300e-10 5.512618740e-15 );
}

provenance
{
    dHf_298
    {
        origin        literature;
        method        "NASA/TP-2002-211556 appendix D, p. 98, entry C4H9,t-butyl, record-line H(298.15) (elements reference, so = dHf)";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "Table B1 p. 16 prints 51.7 kJ/mol; the report's own sources: 1,1dimethylethyl radical. Tsang,1985.";
    }
    s_298
    {
        origin        literature;
        method        "NASA/TP-2002-211556 Table B1, p. 16, entry C4H9,t-butyl";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "appendix D's coefficients with b2 integrate to 319.719";
    }
    idealGasHeatCapacity
    {
        origin        literature;
        method        "NASA/TP-2002-211556 appendix D, p. 98, entry C4H9,t-butyl, a1..a7 of the 200-1000 K and 1000-6000 K intervals, as printed";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "read by bin/curate/nasa_tp2002_to_choupo.py, which holds H and S at 298.15 K to the printed values";
    }
    source   "McBride, Zehe & Gordon, NASA Glenn Coefficients for Calculating Thermodynamic Properties of Individual Species, NASA/TP-2002-211556 (2002)";
    licence  publicDomain;    // US government work (NASA), 17 U.S.C. 105
}
