/*--------------------------------*- Choupo -*-----------------------*\
  Species Be (NASA/TP-2002-211556 appendix D entry "Be"):
  ideal-gas formation data and heat capacity transcribed by machine with
  bin/curate/nasa_tp2002_to_choupo.py table, which holds H and S at
  298.15 K recomputed from the printed coefficients to the printed
  values.  Not read back against the page by a curator.
  The report's own description and sources: Hf:Cox,1989. Kramida,1997. Gordon,1999.
\*---------------------------------------------------------------------------*/
name           Be;
formula        Be;
CAS            n/a;
MW             9.012182;       // kg/kmol, appendix D record line
role           gasData;       // free metal atom: a liquid or solid metal exists, no liquid model here
tags           ( gasPhase thermoTable );
nasaEntry      "Be";
reviewStatus   interim;
reviewReason   "transcribed by machine from NASA/TP-2002-211556 into the thermoTables home and checked against the report itself; not yet read back against the page by a curator";
standardThermochemistry
{
    dHf_298    324000.000;   // J/mol  -- ideal gas; NASA/TP-2002-211556 appendix D, p. 69, entry Be
    s_298      136.276;     // J/(mol·K) -- third-law absolute; Table B1, p. 12
}

idealGasHeatCapacity
{
    //  NASA/TP-2002-211556 eq. (1), Cp/R = a1/T^2 + a2/T + a3 + a4 T + a5 T^2
    //  + a6 T^3 + a7 T^4; appendix D, p. 69, entry Be, a1..a7 as printed.
    //  The report's 6000-20000 K interval is not transcribed.
    model    NASA9;
    Tlow     200;
    Tcommon  1000;
    Thigh    6000;
    low      ( -4.112901520e-04 5.364967360e-06 2.499999972e+00 7.569203690e-11 -1.097852652e-13 8.002110240e-17 -2.303022777e-20 );
    high     ( -6.926285840e+05 2.466773005e+03 -9.776613340e-01 2.458939515e-03 -9.047950420e-07 1.587880407e-10 -9.415600603e-15 );
}

provenance
{
    dHf_298
    {
        origin        literature;
        method        "NASA/TP-2002-211556 appendix D, p. 69, entry Be, record-line H(298.15) (elements reference, so = dHf)";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "Table B1 p. 12 prints 324.0 kJ/mol; the report's own sources: Hf:Cox,1989. Kramida,1997. Gordon,1999.";
    }
    s_298
    {
        origin        literature;
        method        "NASA/TP-2002-211556 Table B1, p. 12, entry Be";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "appendix D's coefficients with b2 integrate to 136.276";
    }
    idealGasHeatCapacity
    {
        origin        literature;
        method        "NASA/TP-2002-211556 appendix D, p. 69, entry Be, a1..a7 of the 200-1000 K and 1000-6000 K intervals, as printed";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "read by bin/curate/nasa_tp2002_to_choupo.py, which holds H and S at 298.15 K to the printed values";
    }
    source   "McBride, Zehe & Gordon, NASA Glenn Coefficients for Calculating Thermodynamic Properties of Individual Species, NASA/TP-2002-211556 (2002)";
    licence  publicDomain;    // US government work (NASA), 17 U.S.C. 105
}
