/*--------------------------------*- Choupo -*-----------------------*\
  Species Na2F2 (NASA/TP-2002-211556 appendix D entry "Na2F2"):
  ideal-gas formation data and heat capacity transcribed by machine with
  bin/curate/nasa_tp2002_to_choupo.py table, which holds H and S at
  298.15 K recomputed from the printed coefficients to the printed
  values.  Not read back against the page by a curator.
  The report's own description and sources: Gurvich,1982 pt1 p333 pt2 p372.
\*---------------------------------------------------------------------------*/
name           Na2F2;
formula        Na2F2;
CAS            n/a;
MW             83.97635;       // kg/kmol, appendix D record line
role           gasData;       // closed-shell molecule (or noble gas): ideal-gas data only, no liquid model
tags           ( gasPhase thermoTable );
nasaEntry      "Na2F2";
reviewStatus   interim;
reviewReason   "transcribed by machine from NASA/TP-2002-211556 into the thermoTables home and checked against the report itself; not yet read back against the page by a curator";
standardThermochemistry
{
    dHf_298    -834062.776;   // J/mol  -- ideal gas; NASA/TP-2002-211556 appendix D, p. 161, entry Na2F2
    s_298      297.907;     // J/(mol·K) -- third-law absolute; Table B1, p. 25
}

idealGasHeatCapacity
{
    //  NASA/TP-2002-211556 eq. (1), Cp/R = a1/T^2 + a2/T + a3 + a4 T + a5 T^2
    //  + a6 T^3 + a7 T^4; appendix D, p. 161, entry Na2F2, a1..a7 as printed.
    model    NASA9;
    Tlow     200;
    Tcommon  1000;
    Thigh    6000;
    low      ( 2.351580802e+04 -1.000737062e+03 1.375845076e+01 -7.838346980e-03 9.276288700e-06 -5.813612970e-09 1.495354820e-12 );
    high     ( -9.030750690e+04 -1.893938035e+01 1.001535518e+01 -6.539675450e-06 1.516333603e-09 -1.804877459e-13 8.613474920e-18 );
}

provenance
{
    dHf_298
    {
        origin        literature;
        method        "NASA/TP-2002-211556 appendix D, p. 161, entry Na2F2, record-line H(298.15) (elements reference, so = dHf)";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "Table B1 p. 25 prints -834.063 kJ/mol; the report's own sources: Gurvich,1982 pt1 p333 pt2 p372.";
    }
    s_298
    {
        origin        literature;
        method        "NASA/TP-2002-211556 Table B1, p. 25, entry Na2F2";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "appendix D's coefficients with b2 integrate to 297.907";
    }
    idealGasHeatCapacity
    {
        origin        literature;
        method        "NASA/TP-2002-211556 appendix D, p. 161, entry Na2F2, a1..a7 of the 200-1000 K and 1000-6000 K intervals, as printed";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "read by bin/curate/nasa_tp2002_to_choupo.py, which holds H and S at 298.15 K to the printed values";
    }
    source   "McBride, Zehe & Gordon, NASA Glenn Coefficients for Calculating Thermodynamic Properties of Individual Species, NASA/TP-2002-211556 (2002)";
    licence  publicDomain;    // US government work (NASA), 17 U.S.C. 105
}
