/*--------------------------------*- Choupo -*-----------------------*\
  Species C4H9_sbutyl (NASA/TP-2002-211556 appendix D entry "C4H9,s-butyl"):
  ideal-gas formation data and heat capacity transcribed by machine with
  bin/curate/nasa_tp2002_to_choupo.py table, which holds H and S at
  298.15 K recomputed from the printed coefficients to the printed
  values.  Not read back against the page by a curator.
  The report's own description and sources: 1-methylpropyl radical. Tsang,1985.
\*---------------------------------------------------------------------------*/
name           C4H9_sbutyl;
formula        C4H9;
CAS            n/a;
MW             57.11426;       // kg/kmol, appendix D record line
role           radical;       // gas-only (DEV.md 4c C458): stays in the vapour, refused where no vapour holds it
tags           ( gasPhase thermoTable );
nasaEntry      "C4H9,s-butyl";
reviewStatus   interim;
reviewReason   "transcribed by machine from NASA/TP-2002-211556 into the thermoTables home and checked against the report itself; not yet read back against the page by a curator";
standardThermochemistry
{
    dHf_298    71000.000;   // J/mol  -- ideal gas; NASA/TP-2002-211556 appendix D, p. 98, entry C4H9,s-butyl
    s_298      334.126;     // J/(mol·K) -- third-law absolute; Table B1, p. 16
}

idealGasHeatCapacity
{
    //  NASA/TP-2002-211556 eq. (1), Cp/R = a1/T^2 + a2/T + a3 + a4 T + a5 T^2
    //  + a6 T^3 + a7 T^4; appendix D, p. 98, entry C4H9,s-butyl, a1..a7 as printed.
    model    NASA9;
    Tlow     200;
    Tcommon  1000;
    Thigh    6000;
    low      ( -3.351062890e+05 6.312945950e+03 -4.003025260e+01 1.563875047e-01 -1.842331788e-04 1.182727848e-07 -3.131156589e-11 );
    high     ( 7.224744350e+06 -3.035291099e+04 5.288551830e+01 -5.652083550e-03 1.060032692e-06 -1.066129835e-10 4.443810960e-15 );
}

provenance
{
    dHf_298
    {
        origin        literature;
        method        "NASA/TP-2002-211556 appendix D, p. 98, entry C4H9,s-butyl, record-line H(298.15) (elements reference, so = dHf)";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "Table B1 p. 16 prints 71.0 kJ/mol; the report's own sources: 1-methylpropyl radical. Tsang,1985.";
    }
    s_298
    {
        origin        literature;
        method        "NASA/TP-2002-211556 Table B1, p. 16, entry C4H9,s-butyl";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "appendix D's coefficients with b2 integrate to 334.126";
    }
    idealGasHeatCapacity
    {
        origin        literature;
        method        "NASA/TP-2002-211556 appendix D, p. 98, entry C4H9,s-butyl, a1..a7 of the 200-1000 K and 1000-6000 K intervals, as printed";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "read by bin/curate/nasa_tp2002_to_choupo.py, which holds H and S at 298.15 K to the printed values";
    }
    source   "McBride, Zehe & Gordon, NASA Glenn Coefficients for Calculating Thermodynamic Properties of Individual Species, NASA/TP-2002-211556 (2002)";
    licence  publicDomain;    // US government work (NASA), 17 U.S.C. 105
}
