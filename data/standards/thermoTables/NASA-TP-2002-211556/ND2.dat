/*--------------------------------*- Choupo -*-----------------------*\
  Species ND2 (NASA/TP-2002-211556 appendix D entry "ND2"):
  ideal-gas formation data and heat capacity transcribed by machine with
  bin/curate/nasa_tp2002_to_choupo.py table, which holds H and S at
  298.15 K recomputed from the printed coefficients to the printed
  values.  Not read back against the page by a curator.
  The report's own description and sources: Hf:est. from NH2,H,&D data. Jacox,1998 p133.
\*---------------------------------------------------------------------------*/
name           ND2;
formula        ND2;
CAS            n/a;
MW             18.0349;       // kg/kmol, appendix D record line
role           gasOnly;       // free radical (odd electron count 9)
tags           ( gasPhase thermoTable );
nasaEntry      "ND2";
reviewStatus   interim;
reviewReason   "transcribed by machine from NASA/TP-2002-211556 into the thermoTables home and checked against the report itself; not yet read back against the page by a curator";
standardThermochemistry
{
    dHf_298    184836.570;   // J/mol  -- ideal gas; NASA/TP-2002-211556 appendix D, p. 153, entry ND2
    s_298      204.335;     // J/(mol·K) -- third-law absolute; Table B1, p. 24
}

idealGasHeatCapacity
{
    //  NASA/TP-2002-211556 eq. (1), Cp/R = a1/T^2 + a2/T + a3 + a4 T + a5 T^2
    //  + a6 T^3 + a7 T^4; appendix D, p. 153, entry ND2, a1..a7 as printed.
    model    NASA9;
    Tlow     200;
    Tcommon  1000;
    Thigh    6000;
    low      ( 1.935222164e+04 -2.130631713e+02 4.844017600e+00 -2.516949288e-03 7.616381540e-06 -5.464501770e-09 1.292736999e-12 );
    high     ( 1.631308357e+06 -6.564637490e+03 1.280547961e+01 -3.094456779e-03 9.181660230e-07 -1.241119284e-10 6.226299860e-15 );
}

provenance
{
    dHf_298
    {
        origin        literature;
        method        "NASA/TP-2002-211556 appendix D, p. 153, entry ND2, record-line H(298.15) (elements reference, so = dHf)";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "Table B1 p. 24 prints 184.837 kJ/mol; the report's own sources: Hf:est. from NH2,H,&D data. Jacox,1998 p133.";
    }
    s_298
    {
        origin        literature;
        method        "NASA/TP-2002-211556 Table B1, p. 24, entry ND2";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "appendix D's coefficients with b2 integrate to 204.335";
    }
    idealGasHeatCapacity
    {
        origin        literature;
        method        "NASA/TP-2002-211556 appendix D, p. 153, entry ND2, a1..a7 of the 200-1000 K and 1000-6000 K intervals, as printed";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "read by bin/curate/nasa_tp2002_to_choupo.py, which holds H and S at 298.15 K to the printed values";
    }
    source   "McBride, Zehe & Gordon, NASA Glenn Coefficients for Calculating Thermodynamic Properties of Individual Species, NASA/TP-2002-211556 (2002)";
    licence  publicDomain;    // US government work (NASA), 17 U.S.C. 105
}
