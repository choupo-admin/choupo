/*--------------------------------*- Choupo -*-----------------------*\
  Species C7H7_benzyl (NASA/TP-2002-211556 appendix D entry "C7H7,benzyl"):
  ideal-gas formation data and heat capacity transcribed by machine with
  bin/curate/nasa_tp2002_to_choupo.py table, which holds H and S at
  298.15 K recomputed from the printed coefficients to the printed
  values.  Not read back against the page by a curator.
  The report's own description and sources: Radical. Brouwer,1988. Hippler,1990.
\*---------------------------------------------------------------------------*/
name           C7H7_benzyl;
formula        C7H7;
CAS            n/a;
MW             91.13048;       // kg/kmol, appendix D record line
role           gasOnly;       // free radical (odd electron count 49)
tags           ( gasPhase thermoTable );
nasaEntry      "C7H7,benzyl";
reviewStatus   interim;
reviewReason   "transcribed by machine from NASA/TP-2002-211556 into the thermoTables home and checked against the report itself; not yet read back against the page by a curator";
standardThermochemistry
{
    dHf_298    210500.000;   // J/mol  -- ideal gas; NASA/TP-2002-211556 appendix D, p. 101, entry C7H7,benzyl
    s_298      321.133;     // J/(mol·K) -- third-law absolute; Table B1, p. 17
}

idealGasHeatCapacity
{
    //  NASA/TP-2002-211556 eq. (1), Cp/R = a1/T^2 + a2/T + a3 + a4 T + a5 T^2
    //  + a6 T^3 + a7 T^4; appendix D, p. 101, entry C7H7,benzyl, a1..a7 as printed.
    model    NASA9;
    Tlow     200;
    Tcommon  1000;
    Thigh    6000;
    low      ( -1.836764826e+05 4.102465660e+03 -3.202406100e+01 1.588249575e-01 -1.894466924e-04 1.203649671e-07 -3.136589637e-11 );
    high     ( 5.297322160e+06 -2.599909398e+04 5.509750790e+01 -4.977661470e-03 9.463152430e-07 -9.639008860e-11 4.064470420e-15 );
}

provenance
{
    dHf_298
    {
        origin        literature;
        method        "NASA/TP-2002-211556 appendix D, p. 101, entry C7H7,benzyl, record-line H(298.15) (elements reference, so = dHf)";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "Table B1 p. 17 prints 210.5 kJ/mol; the report's own sources: Radical. Brouwer,1988. Hippler,1990.";
    }
    s_298
    {
        origin        literature;
        method        "NASA/TP-2002-211556 Table B1, p. 17, entry C7H7,benzyl";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "appendix D's coefficients with b2 integrate to 321.133";
    }
    idealGasHeatCapacity
    {
        origin        literature;
        method        "NASA/TP-2002-211556 appendix D, p. 101, entry C7H7,benzyl, a1..a7 of the 200-1000 K and 1000-6000 K intervals, as printed";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "read by bin/curate/nasa_tp2002_to_choupo.py, which holds H and S at 298.15 K to the printed values";
    }
    source   "McBride, Zehe & Gordon, NASA Glenn Coefficients for Calculating Thermodynamic Properties of Individual Species, NASA/TP-2002-211556 (2002)";
    licence  publicDomain;    // US government work (NASA), 17 U.S.C. 105
}
