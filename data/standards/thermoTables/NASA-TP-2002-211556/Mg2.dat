/*--------------------------------*- Choupo -*-----------------------*\
  Species Mg2 (NASA/TP-2002-211556 appendix D entry "Mg2"):
  ideal-gas formation data and heat capacity transcribed by machine with
  bin/curate/nasa_tp2002_to_choupo.py table, which holds H and S at
  298.15 K recomputed from the printed coefficients to the printed
  values.  Not read back against the page by a curator.
  The report's own description and sources: Gurvich,1996a pt1 p393 pt2 p316.
\*---------------------------------------------------------------------------*/
name           Mg2;
formula        Mg2;
CAS            n/a;
MW             48.61;       // kg/kmol, appendix D record line
role           nonvolatile;   // ideal-gas species: no vapour pressure is asked of it
tags           ( gasPhase thermoTable );
nasaEntry      "Mg2";
reviewStatus   interim;
reviewReason   "transcribed by machine from NASA/TP-2002-211556 into the thermoTables home and checked against the report itself; not yet read back against the page by a curator";
standardThermochemistry
{
    dHf_298    286513.315;   // J/mol  -- ideal gas; NASA/TP-2002-211556 appendix D, p. 150, entry Mg2
    s_298      240.843;     // J/(mol·K) -- third-law absolute; Table B1, p. 24
}

idealGasHeatCapacity
{
    //  NASA/TP-2002-211556 eq. (1), Cp/R = a1/T^2 + a2/T + a3 + a4 T + a5 T^2
    //  + a6 T^3 + a7 T^4; appendix D, p. 150, entry Mg2, a1..a7 as printed.
    model    NASA9;
    Tlow     200;
    Tcommon  1000;
    Thigh    6000;
    low      ( 4.545195590e+03 4.115850040e+02 4.841196170e-01 4.891969650e-03 -6.395536840e-06 4.299764550e-09 -1.164624418e-12 );
    high     ( 3.038224994e+04 5.945240460e+01 2.352706666e+00 1.378537924e-04 -5.895692040e-08 1.104045317e-11 -6.558868290e-16 );
}

provenance
{
    dHf_298
    {
        origin        literature;
        method        "NASA/TP-2002-211556 appendix D, p. 150, entry Mg2, record-line H(298.15) (elements reference, so = dHf)";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "Table B1 p. 24 prints 286.513 kJ/mol; the report's own sources: Gurvich,1996a pt1 p393 pt2 p316.";
    }
    s_298
    {
        origin        literature;
        method        "NASA/TP-2002-211556 Table B1, p. 24, entry Mg2";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "appendix D's coefficients with b2 integrate to 240.843";
    }
    idealGasHeatCapacity
    {
        origin        literature;
        method        "NASA/TP-2002-211556 appendix D, p. 150, entry Mg2, a1..a7 of the 200-1000 K and 1000-6000 K intervals, as printed";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "read by bin/curate/nasa_tp2002_to_choupo.py, which holds H and S at 298.15 K to the printed values";
    }
    source   "McBride, Zehe & Gordon, NASA Glenn Coefficients for Calculating Thermodynamic Properties of Individual Species, NASA/TP-2002-211556 (2002)";
    licence  publicDomain;    // US government work (NASA), 17 U.S.C. 105
}
