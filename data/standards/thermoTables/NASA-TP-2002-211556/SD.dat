/*--------------------------------*- Choupo -*-----------------------*\
  Species SD (NASA/TP-2002-211556 appendix D entry "SD"):
  ideal-gas formation data and heat capacity transcribed by machine with
  bin/curate/nasa_tp2002_to_choupo.py table, which holds H and S at
  298.15 K recomputed from the printed coefficients to the printed
  values.  Not read back against the page by a curator.
  The report's own description and sources: Chase,1998 p1039.
\*---------------------------------------------------------------------------*/
name           SD;
formula        SD;
CAS            n/a;
MW             34.0791;       // kg/kmol, appendix D record line
role           nonvolatile;   // ideal-gas species: no vapour pressure is asked of it
tags           ( gasPhase thermoTable );
nasaEntry      "SD";
reviewStatus   interim;
reviewReason   "transcribed by machine from NASA/TP-2002-211556 into the thermoTables home and checked against the report itself; not yet read back against the page by a curator";
standardThermochemistry
{
    dHf_298    138490.892;   // J/mol  -- ideal gas; NASA/TP-2002-211556 appendix D, p. 179, entry SD
    s_298      201.488;     // J/(mol·K) -- third-law absolute; Table B1, p. 28
}

idealGasHeatCapacity
{
    //  NASA/TP-2002-211556 eq. (1), Cp/R = a1/T^2 + a2/T + a3 + a4 T + a5 T^2
    //  + a6 T^3 + a7 T^4; appendix D, p. 179, entry SD, a1..a7 as printed.
    model    NASA9;
    Tlow     200;
    Tcommon  1000;
    Thigh    6000;
    low      ( -3.295574990e+04 1.647104687e+02 4.978984550e+00 -8.031585710e-03 1.653766397e-05 -1.345197981e-08 4.000431530e-12 );
    high     ( 2.456732490e+05 -1.180034105e+03 5.284690050e+00 -2.384319882e-04 6.009960290e-08 -7.131163640e-12 4.035858700e-16 );
}

provenance
{
    dHf_298
    {
        origin        literature;
        method        "NASA/TP-2002-211556 appendix D, p. 179, entry SD, record-line H(298.15) (elements reference, so = dHf)";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "Table B1 p. 28 prints 138.491 kJ/mol; the report's own sources: Chase,1998 p1039.";
    }
    s_298
    {
        origin        literature;
        method        "NASA/TP-2002-211556 Table B1, p. 28, entry SD";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "appendix D's coefficients with b2 integrate to 201.488";
    }
    idealGasHeatCapacity
    {
        origin        literature;
        method        "NASA/TP-2002-211556 appendix D, p. 179, entry SD, a1..a7 of the 200-1000 K and 1000-6000 K intervals, as printed";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "read by bin/curate/nasa_tp2002_to_choupo.py, which holds H and S at 298.15 K to the printed values";
    }
    source   "McBride, Zehe & Gordon, NASA Glenn Coefficients for Calculating Thermodynamic Properties of Individual Species, NASA/TP-2002-211556 (2002)";
    licence  publicDomain;    // US government work (NASA), 17 U.S.C. 105
}
