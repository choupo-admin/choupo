/*--------------------------------*- Choupo -*-----------------------*\
  Species C3OS (NASA/TP-2002-211556 appendix D entry "C3OS"):
  ideal-gas formation data and heat capacity transcribed by machine with
  bin/curate/nasa_tp2002_to_choupo.py table, which holds H and S at
  298.15 K recomputed from the printed coefficients to the printed
  values.  Not read back against the page by a curator.
  The report's own description and sources: TRC(6/01) p8150, tuvw-8150.
\*---------------------------------------------------------------------------*/
name           C3OS;
formula        C3OS;
CAS            n/a;
MW             84.0965;       // kg/kmol, appendix D record line
role           radical;       // gas-only (DEV.md 4c C458): stays in the vapour, refused where no vapour holds it
tags           ( gasPhase thermoTable );
nasaEntry      "C3OS";
reviewStatus   interim;
reviewReason   "transcribed by machine from NASA/TP-2002-211556 into the thermoTables home and checked against the report itself; not yet read back against the page by a curator";
standardThermochemistry
{
    dHf_298    157330.000;   // J/mol  -- ideal gas; NASA/TP-2002-211556 appendix D, p. 96, entry C3OS
    s_298      289.180;     // J/(mol·K) -- third-law absolute; Table B1, p. 16
}

idealGasHeatCapacity
{
    //  NASA/TP-2002-211556 eq. (1), Cp/R = a1/T^2 + a2/T + a3 + a4 T + a5 T^2
    //  + a6 T^3 + a7 T^4; appendix D, p. 96, entry C3OS, a1..a7 as printed.
    model    NASA9;
    Tlow     200;
    Tcommon  1000;
    Thigh    6000;
    low      ( 1.173396837e+05 -2.154246274e+03 1.739096818e+01 -1.606951508e-02 2.815913738e-05 -2.144517776e-08 6.117883960e-12 );
    high     ( 4.650964090e+05 -3.653583100e+03 1.589374854e+01 -7.274431680e-04 1.507932631e-07 -1.250975180e-11 2.879103391e-16 );
}

provenance
{
    dHf_298
    {
        origin        literature;
        method        "NASA/TP-2002-211556 appendix D, p. 96, entry C3OS, record-line H(298.15) (elements reference, so = dHf)";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "Table B1 p. 16 prints 157.33 kJ/mol; the report's own sources: TRC(6/01) p8150, tuvw-8150.";
    }
    s_298
    {
        origin        literature;
        method        "NASA/TP-2002-211556 Table B1, p. 16, entry C3OS";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "appendix D's coefficients with b2 integrate to 289.180";
    }
    idealGasHeatCapacity
    {
        origin        literature;
        method        "NASA/TP-2002-211556 appendix D, p. 96, entry C3OS, a1..a7 of the 200-1000 K and 1000-6000 K intervals, as printed";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "read by bin/curate/nasa_tp2002_to_choupo.py, which holds H and S at 298.15 K to the printed values";
    }
    source   "McBride, Zehe & Gordon, NASA Glenn Coefficients for Calculating Thermodynamic Properties of Individual Species, NASA/TP-2002-211556 (2002)";
    licence  publicDomain;    // US government work (NASA), 17 U.S.C. 105
}
