/*--------------------------------*- Choupo -*-----------------------*\
  Species SnI3 (NASA/TP-2002-211556 appendix D entry "SnI3"):
  ideal-gas formation data and heat capacity transcribed by machine with
  bin/curate/nasa_tp2002_to_choupo.py table, which holds H and S at
  298.15 K recomputed from the printed coefficients to the printed
  values.  Not read back against the page by a curator.
  The report's own description and sources: Gurvich,1991 pt1 p388 pt2 p330.
\*---------------------------------------------------------------------------*/
name           SnI3;
formula        SnI3;
CAS            n/a;
MW             499.4234;       // kg/kmol, appendix D record line
role           nonvolatile;   // ideal-gas species: no vapour pressure is asked of it
tags           ( gasPhase thermoTable );
nasaEntry      "SnI3";
reviewStatus   interim;
reviewReason   "transcribed by machine from NASA/TP-2002-211556 into the thermoTables home and checked against the report itself; not yet read back against the page by a curator";
standardThermochemistry
{
    dHf_298    -8017.540;   // J/mol  -- ideal gas; NASA/TP-2002-211556 appendix D, p. 194, entry SnI3
    s_298      398.029;     // J/(mol·K) -- third-law absolute; Table B1, p. 30
}

idealGasHeatCapacity
{
    //  NASA/TP-2002-211556 eq. (1), Cp/R = a1/T^2 + a2/T + a3 + a4 T + a5 T^2
    //  + a6 T^3 + a7 T^4; appendix D, p. 194, entry SnI3, a1..a7 as printed.
    model    NASA9;
    Tlow     200;
    Tcommon  1000;
    Thigh    6000;
    low      ( -1.069978099e+04 -1.387693540e+02 1.055637633e+01 -1.216435658e-03 1.490873499e-06 -9.594499630e-10 2.518810438e-13 );
    high     ( -2.517534870e+04 -2.348282890e+00 1.000199130e+01 -8.752764840e-07 2.076464980e-10 -2.514060336e-14 1.215482266e-18 );
}

provenance
{
    dHf_298
    {
        origin        literature;
        method        "NASA/TP-2002-211556 appendix D, p. 194, entry SnI3, record-line H(298.15) (elements reference, so = dHf)";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "Table B1 p. 30 prints -8.018 kJ/mol; the report's own sources: Gurvich,1991 pt1 p388 pt2 p330.";
    }
    s_298
    {
        origin        literature;
        method        "NASA/TP-2002-211556 Table B1, p. 30, entry SnI3";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "appendix D's coefficients with b2 integrate to 398.029";
    }
    idealGasHeatCapacity
    {
        origin        literature;
        method        "NASA/TP-2002-211556 appendix D, p. 194, entry SnI3, a1..a7 of the 200-1000 K and 1000-6000 K intervals, as printed";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "read by bin/curate/nasa_tp2002_to_choupo.py, which holds H and S at 298.15 K to the printed values";
    }
    source   "McBride, Zehe & Gordon, NASA Glenn Coefficients for Calculating Thermodynamic Properties of Individual Species, NASA/TP-2002-211556 (2002)";
    licence  publicDomain;    // US government work (NASA), 17 U.S.C. 105
}
