/*--------------------------------*- Choupo -*-----------------------*\
  Species ALS2 (NASA/TP-2002-211556 appendix D entry "ALS2"):
  ideal-gas formation data and heat capacity transcribed by machine with
  bin/curate/nasa_tp2002_to_choupo.py table, which holds H and S at
  298.15 K recomputed from the printed coefficients to the printed
  values.  Not read back against the page by a curator.
  The report's own description and sources: Gurvich,1996a pt1 p198 pt2 p159.
\*---------------------------------------------------------------------------*/
name           ALS2;
formula        AlS2;
CAS            n/a;
MW             91.11154;       // kg/kmol, appendix D record line
role           gasOnly;       // free radical (odd electron count 45)
tags           ( gasPhase thermoTable );
nasaEntry      "ALS2";
reviewStatus   interim;
reviewReason   "transcribed by machine from NASA/TP-2002-211556 into the thermoTables home and checked against the report itself; not yet read back against the page by a curator";
standardThermochemistry
{
    dHf_298    248535.279;   // J/mol  -- ideal gas; NASA/TP-2002-211556 appendix D, p. 53, entry ALS2
    s_298      294.462;     // J/(mol·K) -- third-law absolute; Table B1, p. 10
}

idealGasHeatCapacity
{
    //  NASA/TP-2002-211556 eq. (1), Cp/R = a1/T^2 + a2/T + a3 + a4 T + a5 T^2
    //  + a6 T^3 + a7 T^4; appendix D, p. 53, entry ALS2, a1..a7 as printed.
    model    NASA9;
    Tlow     200;
    Tcommon  1000;
    Thigh    6000;
    low      ( 4.252335410e+04 -7.764603300e+02 9.801068960e+00 -3.910680090e-03 3.875695970e-06 -2.082025593e-09 4.682935890e-13 );
    high     ( -6.852563540e+04 -2.671667739e+01 7.520193860e+00 -8.148565100e-06 1.811865152e-09 -2.086958125e-13 9.703246380e-18 );
}

provenance
{
    dHf_298
    {
        origin        literature;
        method        "NASA/TP-2002-211556 appendix D, p. 53, entry ALS2, record-line H(298.15) (elements reference, so = dHf)";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "Table B1 p. 10 prints 248.535 kJ/mol; the report's own sources: Gurvich,1996a pt1 p198 pt2 p159.";
    }
    s_298
    {
        origin        literature;
        method        "NASA/TP-2002-211556 Table B1, p. 10, entry ALS2";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "appendix D's coefficients with b2 integrate to 294.462";
    }
    idealGasHeatCapacity
    {
        origin        literature;
        method        "NASA/TP-2002-211556 appendix D, p. 53, entry ALS2, a1..a7 of the 200-1000 K and 1000-6000 K intervals, as printed";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "read by bin/curate/nasa_tp2002_to_choupo.py, which holds H and S at 298.15 K to the printed values";
    }
    source   "McBride, Zehe & Gordon, NASA Glenn Coefficients for Calculating Thermodynamic Properties of Individual Species, NASA/TP-2002-211556 (2002)";
    licence  publicDomain;    // US government work (NASA), 17 U.S.C. 105
}
