/*--------------------------------*- Choupo -*-----------------------*\
  Species Ge (NASA/TP-2002-211556 appendix D entry "Ge"):
  ideal-gas formation data and heat capacity transcribed by machine with
  bin/curate/nasa_tp2002_to_choupo.py table, which holds H and S at
  298.15 K recomputed from the printed coefficients to the printed
  values.  Not read back against the page by a curator.
  The report's own description and sources: Hf:Gurvich,1991 pt1 p311. Sugar,1993. Gordon,1999.
\*---------------------------------------------------------------------------*/
name           Ge;
formula        Ge;
CAS            n/a;
MW             72.64;       // kg/kmol, appendix D record line
role           nonvolatile;   // ideal-gas species: no vapour pressure is asked of it
tags           ( gasPhase thermoTable );
nasaEntry      "Ge";
reviewStatus   interim;
reviewReason   "transcribed by machine from NASA/TP-2002-211556 into the thermoTables home and checked against the report itself; not yet read back against the page by a curator";
standardThermochemistry
{
    dHf_298    367800.000;   // J/mol  -- ideal gas; NASA/TP-2002-211556 appendix D, p. 123, entry Ge
    s_298      167.914;     // J/(mol·K) -- third-law absolute; Table B1, p. 20
}

idealGasHeatCapacity
{
    //  NASA/TP-2002-211556 eq. (1), Cp/R = a1/T^2 + a2/T + a3 + a4 T + a5 T^2
    //  + a6 T^3 + a7 T^4; appendix D, p. 123, entry Ge, a1..a7 as printed.
    //  The report's 6000-20000 K interval is not transcribed.
    model    NASA9;
    Tlow     200;
    Tcommon  1000;
    Thigh    6000;
    low      ( -2.059215242e+04 -1.432022103e+02 4.506002330e+00 1.547187840e-03 -8.518296550e-06 8.243824460e-09 -2.566167305e-12 );
    high     ( -8.565413840e+05 3.917958660e+03 -1.809888212e+00 2.276482224e-03 -5.365627550e-07 5.984958090e-11 -2.541700646e-15 );
}

provenance
{
    dHf_298
    {
        origin        literature;
        method        "NASA/TP-2002-211556 appendix D, p. 123, entry Ge, record-line H(298.15) (elements reference, so = dHf)";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "Table B1 p. 20 prints 367.8 kJ/mol; the report's own sources: Hf:Gurvich,1991 pt1 p311. Sugar,1993. Gordon,1999.";
    }
    s_298
    {
        origin        literature;
        method        "NASA/TP-2002-211556 Table B1, p. 20, entry Ge";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "appendix D's coefficients with b2 integrate to 167.914";
    }
    idealGasHeatCapacity
    {
        origin        literature;
        method        "NASA/TP-2002-211556 appendix D, p. 123, entry Ge, a1..a7 of the 200-1000 K and 1000-6000 K intervals, as printed";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "read by bin/curate/nasa_tp2002_to_choupo.py, which holds H and S at 298.15 K to the printed values";
    }
    source   "McBride, Zehe & Gordon, NASA Glenn Coefficients for Calculating Thermodynamic Properties of Individual Species, NASA/TP-2002-211556 (2002)";
    licence  publicDomain;    // US government work (NASA), 17 U.S.C. 105
}
