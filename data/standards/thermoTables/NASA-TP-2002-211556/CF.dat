/*--------------------------------*- Choupo -*-----------------------*\
  Species CF (NASA/TP-2002-211556 appendix D entry "CF"):
  ideal-gas formation data and heat capacity transcribed by machine with
  bin/curate/nasa_tp2002_to_choupo.py table, which holds H and S at
  298.15 K recomputed from the printed coefficients to the printed
  values.  Not read back against the page by a curator.
  The report's own description and sources: Hf:TRC(6/88) w6950. Gurvich,1991 pt1 p74 pt2 p55.
\*---------------------------------------------------------------------------*/
name           CF;
formula        CF;
CAS            n/a;
MW             31.0091;       // kg/kmol, appendix D record line
role           gasOnly;       // free radical (odd electron count 15)
tags           ( gasPhase thermoTable );
nasaEntry      "CF";
reviewStatus   interim;
reviewReason   "transcribed by machine from NASA/TP-2002-211556 into the thermoTables home and checked against the report itself; not yet read back against the page by a curator";
standardThermochemistry
{
    dHf_298    242300.000;   // J/mol  -- ideal gas; NASA/TP-2002-211556 appendix D, p. 76, entry CF
    s_298      213.034;     // J/(mol·K) -- third-law absolute; Table B1, p. 13
}

idealGasHeatCapacity
{
    //  NASA/TP-2002-211556 eq. (1), Cp/R = a1/T^2 + a2/T + a3 + a4 T + a5 T^2
    //  + a6 T^3 + a7 T^4; appendix D, p. 76, entry CF, a1..a7 as printed.
    model    NASA9;
    Tlow     200;
    Tcommon  1000;
    Thigh    6000;
    low      ( -4.582786680e+04 7.972635890e+02 -1.364936319e+00 1.312359375e-02 -1.457012892e-05 8.253276680e-09 -1.896351845e-12 );
    high     ( -1.329807100e+05 -1.214340891e+02 4.452413620e+00 1.293786948e-04 -3.670550590e-08 6.590212390e-12 -3.731261610e-16 );
}

provenance
{
    dHf_298
    {
        origin        literature;
        method        "NASA/TP-2002-211556 appendix D, p. 76, entry CF, record-line H(298.15) (elements reference, so = dHf)";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "Table B1 p. 13 prints 242.3 kJ/mol; the report's own sources: Hf:TRC(6/88) w6950. Gurvich,1991 pt1 p74 pt2 p55.";
    }
    s_298
    {
        origin        literature;
        method        "NASA/TP-2002-211556 Table B1, p. 13, entry CF";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "appendix D's coefficients with b2 integrate to 213.034";
    }
    idealGasHeatCapacity
    {
        origin        literature;
        method        "NASA/TP-2002-211556 appendix D, p. 76, entry CF, a1..a7 of the 200-1000 K and 1000-6000 K intervals, as printed";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "read by bin/curate/nasa_tp2002_to_choupo.py, which holds H and S at 298.15 K to the printed values";
    }
    source   "McBride, Zehe & Gordon, NASA Glenn Coefficients for Calculating Thermodynamic Properties of Individual Species, NASA/TP-2002-211556 (2002)";
    licence  publicDomain;    // US government work (NASA), 17 U.S.C. 105
}
