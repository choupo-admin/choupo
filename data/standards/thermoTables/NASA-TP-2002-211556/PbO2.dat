/*--------------------------------*- Choupo -*-----------------------*\
  Species PbO2 (NASA/TP-2002-211556 appendix D entry "PbO2"):
  ideal-gas formation data and heat capacity transcribed by machine with
  bin/curate/nasa_tp2002_to_choupo.py table, which holds H and S at
  298.15 K recomputed from the printed coefficients to the printed
  values.  Not read back against the page by a curator.
  The report's own description and sources: Gurvich,1991 pt1 p416 pt2 p347.
\*---------------------------------------------------------------------------*/
name           PbO2;
formula        PbO2;
CAS            n/a;
MW             239.1988;       // kg/kmol, appendix D record line
role           radical;       // gas-only (DEV.md 4c C458): stays in the vapour, refused where no vapour holds it
tags           ( gasPhase thermoTable );
nasaEntry      "PbO2";
reviewStatus   interim;
reviewReason   "transcribed by machine from NASA/TP-2002-211556 into the thermoTables home and checked against the report itself; not yet read back against the page by a curator";
standardThermochemistry
{
    dHf_298    136152.734;   // J/mol  -- ideal gas; NASA/TP-2002-211556 appendix D, p. 175, entry PbO2
    s_298      261.093;     // J/(mol·K) -- third-law absolute; Table B1, p. 27
}

idealGasHeatCapacity
{
    //  NASA/TP-2002-211556 eq. (1), Cp/R = a1/T^2 + a2/T + a3 + a4 T + a5 T^2
    //  + a6 T^3 + a7 T^4; appendix D, p. 175, entry PbO2, a1..a7 as printed.
    model    NASA9;
    Tlow     200;
    Tcommon  1000;
    Thigh    6000;
    low      ( 7.071058290e+04 -1.076757462e+03 9.401711730e+00 -1.003861584e-03 -1.233815617e-06 1.858386979e-09 -6.834621210e-13 );
    high     ( -1.307796670e+05 -7.314361450e+01 7.554083410e+00 -2.143421561e-05 4.696464000e-09 -5.344972180e-13 2.460760535e-17 );
}

provenance
{
    dHf_298
    {
        origin        literature;
        method        "NASA/TP-2002-211556 appendix D, p. 175, entry PbO2, record-line H(298.15) (elements reference, so = dHf)";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "Table B1 p. 27 prints 136.153 kJ/mol; the report's own sources: Gurvich,1991 pt1 p416 pt2 p347.";
    }
    s_298
    {
        origin        literature;
        method        "NASA/TP-2002-211556 Table B1, p. 27, entry PbO2";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "appendix D's coefficients with b2 integrate to 261.093";
    }
    idealGasHeatCapacity
    {
        origin        literature;
        method        "NASA/TP-2002-211556 appendix D, p. 175, entry PbO2, a1..a7 of the 200-1000 K and 1000-6000 K intervals, as printed";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "read by bin/curate/nasa_tp2002_to_choupo.py, which holds H and S at 298.15 K to the printed values";
    }
    source   "McBride, Zehe & Gordon, NASA Glenn Coefficients for Calculating Thermodynamic Properties of Individual Species, NASA/TP-2002-211556 (2002)";
    licence  publicDomain;    // US government work (NASA), 17 U.S.C. 105
}
