/*--------------------------------*- Choupo -*-----------------------*\
  Species ZrN (NASA/TP-2002-211556 appendix D entry "ZrN"):
  ideal-gas formation data and heat capacity transcribed by machine with
  bin/curate/nasa_tp2002_to_choupo.py table, which holds H and S at
  298.15 K recomputed from the printed coefficients to the printed
  values.  Not read back against the page by a curator.
  The report's own description and sources: Chase,1998 p1620.
\*---------------------------------------------------------------------------*/
name           ZrN;
formula        ZrN;
CAS            n/a;
MW             105.2307;       // kg/kmol, appendix D record line
role           gasData;       // odd-electron d-block/actinide compound: stable, has condensed phases (not a radical)
tags           ( gasPhase thermoTable );
nasaEntry      "ZrN";
reviewStatus   interim;
reviewReason   "transcribed by machine from NASA/TP-2002-211556 into the thermoTables home and checked against the report itself; not yet read back against the page by a curator";
standardThermochemistry
{
    dHf_298    713372.000;   // J/mol  -- ideal gas; NASA/TP-2002-211556 appendix D, p. 210, entry ZrN
    s_298      233.491;     // J/(mol·K) -- third-law absolute; Table B1, p. 32
}

idealGasHeatCapacity
{
    //  NASA/TP-2002-211556 eq. (1), Cp/R = a1/T^2 + a2/T + a3 + a4 T + a5 T^2
    //  + a6 T^3 + a7 T^4; appendix D, p. 210, entry ZrN, a1..a7 as printed.
    model    NASA9;
    Tlow     200;
    Tcommon  1000;
    Thigh    6000;
    low      ( 2.259109156e+04 -1.802590198e+02 3.130058377e+00 5.427709280e-03 -8.264614840e-06 5.958438220e-09 -1.670274535e-12 );
    high     ( -7.255790890e+04 -8.126796600e+01 4.559924400e+00 1.291161650e-05 5.203830770e-09 -5.927436670e-13 2.731548854e-17 );
}

provenance
{
    dHf_298
    {
        origin        literature;
        method        "NASA/TP-2002-211556 appendix D, p. 210, entry ZrN, record-line H(298.15) (elements reference, so = dHf)";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "Table B1 p. 32 prints 713.372 kJ/mol; the report's own sources: Chase,1998 p1620.";
    }
    s_298
    {
        origin        literature;
        method        "NASA/TP-2002-211556 Table B1, p. 32, entry ZrN";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "appendix D's coefficients with b2 integrate to 233.491";
    }
    idealGasHeatCapacity
    {
        origin        literature;
        method        "NASA/TP-2002-211556 appendix D, p. 210, entry ZrN, a1..a7 of the 200-1000 K and 1000-6000 K intervals, as printed";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "read by bin/curate/nasa_tp2002_to_choupo.py, which holds H and S at 298.15 K to the printed values";
    }
    source   "McBride, Zehe & Gordon, NASA Glenn Coefficients for Calculating Thermodynamic Properties of Individual Species, NASA/TP-2002-211556 (2002)";
    licence  publicDomain;    // US government work (NASA), 17 U.S.C. 105
}
