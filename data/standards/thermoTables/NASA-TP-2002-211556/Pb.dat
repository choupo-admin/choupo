/*--------------------------------*- Choupo -*-----------------------*\
  Species Pb (NASA/TP-2002-211556 appendix D entry "Pb"):
  ideal-gas formation data and heat capacity transcribed by machine with
  bin/curate/nasa_tp2002_to_choupo.py table, which holds H and S at
  298.15 K recomputed from the printed coefficients to the printed
  values.  Not read back against the page by a curator.
  The report's own description and sources: Hf:Gurvich,1991. Moore,1971. Moore,1970a. Gordon,1999.
\*---------------------------------------------------------------------------*/
name           Pb;
formula        Pb;
CAS            n/a;
MW             207.2;       // kg/kmol, appendix D record line
role           radical;       // gas-only (DEV.md 4c C458): stays in the vapour, refused where no vapour holds it
tags           ( gasPhase thermoTable );
nasaEntry      "Pb";
reviewStatus   interim;
reviewReason   "transcribed by machine from NASA/TP-2002-211556 into the thermoTables home and checked against the report itself; not yet read back against the page by a curator";
standardThermochemistry
{
    dHf_298    195200.000;   // J/mol  -- ideal gas; NASA/TP-2002-211556 appendix D, p. 172, entry Pb
    s_298      175.377;     // J/(mol·K) -- third-law absolute; Table B1, p. 27
}

idealGasHeatCapacity
{
    //  NASA/TP-2002-211556 eq. (1), Cp/R = a1/T^2 + a2/T + a3 + a4 T + a5 T^2
    //  + a6 T^3 + a7 T^4; appendix D, p. 172, entry Pb, a1..a7 as printed.
    //  The report's 6000-20000 K interval is not transcribed.
    model    NASA9;
    Tlow     200;
    Tcommon  1000;
    Thigh    6000;
    low      ( 1.213382285e+03 -1.906116019e+01 2.619299546e+00 -3.829519610e-04 6.688180450e-07 -6.061231080e-10 2.240022429e-13 );
    high     ( -9.084313070e+06 2.672673180e+04 -2.626244039e+01 1.358282305e-02 -2.685523566e-06 2.352432800e-10 -7.324114532e-15 );
}

provenance
{
    dHf_298
    {
        origin        literature;
        method        "NASA/TP-2002-211556 appendix D, p. 172, entry Pb, record-line H(298.15) (elements reference, so = dHf)";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "Table B1 p. 27 prints 195.2 kJ/mol; the report's own sources: Hf:Gurvich,1991. Moore,1971. Moore,1970a. Gordon,1999.";
    }
    s_298
    {
        origin        literature;
        method        "NASA/TP-2002-211556 Table B1, p. 27, entry Pb";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "appendix D's coefficients with b2 integrate to 175.377";
    }
    idealGasHeatCapacity
    {
        origin        literature;
        method        "NASA/TP-2002-211556 appendix D, p. 172, entry Pb, a1..a7 of the 200-1000 K and 1000-6000 K intervals, as printed";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "read by bin/curate/nasa_tp2002_to_choupo.py, which holds H and S at 298.15 K to the printed values";
    }
    source   "McBride, Zehe & Gordon, NASA Glenn Coefficients for Calculating Thermodynamic Properties of Individual Species, NASA/TP-2002-211556 (2002)";
    licence  publicDomain;    // US government work (NASA), 17 U.S.C. 105
}
