/*--------------------------------*- Choupo -*-----------------------*\
  Species NOCL (NASA/TP-2002-211556 appendix D entry "NOCL"):
  ideal-gas formation data and heat capacity transcribed by machine with
  bin/curate/nasa_tp2002_to_choupo.py table, which holds H and S at
  298.15 K recomputed from the printed coefficients to the printed
  values.  Not read back against the page by a curator.
  The report's own description and sources: Gurvich,1989 pt1 p389. McBride,1992 METHOD PANDK.
\*---------------------------------------------------------------------------*/
name           NOCL;
formula        NOCl;
CAS            n/a;
MW             65.4591;       // kg/kmol, appendix D record line
role           radical;       // gas-only (DEV.md 4c C458): stays in the vapour, refused where no vapour holds it
tags           ( gasPhase thermoTable );
nasaEntry      "NOCL";
reviewStatus   interim;
reviewReason   "transcribed by machine from NASA/TP-2002-211556 into the thermoTables home and checked against the report itself; not yet read back against the page by a curator";
standardThermochemistry
{
    dHf_298    52698.828;   // J/mol  -- ideal gas; NASA/TP-2002-211556 appendix D, p. 155, entry NOCL
    s_298      261.590;     // J/(mol·K) -- third-law absolute; Table B1, p. 24
}

idealGasHeatCapacity
{
    //  NASA/TP-2002-211556 eq. (1), Cp/R = a1/T^2 + a2/T + a3 + a4 T + a5 T^2
    //  + a6 T^3 + a7 T^4; appendix D, p. 155, entry NOCL, a1..a7 as printed.
    model    NASA9;
    Tlow     200;
    Tcommon  1000;
    Thigh    6000;
    low      ( 2.308835209e+04 -5.495983840e+02 7.730463360e+00 -5.073910900e-03 1.062996184e-05 -8.793249700e-09 2.648180166e-12 );
    high     ( -6.133413330e+05 -3.919298830e+02 9.138917220e+00 -2.605664613e-03 1.295687247e-06 -2.215378352e-10 1.280394898e-14 );
}

provenance
{
    dHf_298
    {
        origin        literature;
        method        "NASA/TP-2002-211556 appendix D, p. 155, entry NOCL, record-line H(298.15) (elements reference, so = dHf)";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "Table B1 p. 24 prints 52.699 kJ/mol; the report's own sources: Gurvich,1989 pt1 p389. McBride,1992 METHOD PANDK.";
    }
    s_298
    {
        origin        literature;
        method        "NASA/TP-2002-211556 Table B1, p. 24, entry NOCL";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "appendix D's coefficients with b2 integrate to 261.590";
    }
    idealGasHeatCapacity
    {
        origin        literature;
        method        "NASA/TP-2002-211556 appendix D, p. 155, entry NOCL, a1..a7 of the 200-1000 K and 1000-6000 K intervals, as printed";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "read by bin/curate/nasa_tp2002_to_choupo.py, which holds H and S at 298.15 K to the printed values";
    }
    source   "McBride, Zehe & Gordon, NASA Glenn Coefficients for Calculating Thermodynamic Properties of Individual Species, NASA/TP-2002-211556 (2002)";
    licence  publicDomain;    // US government work (NASA), 17 U.S.C. 105
}
