/*--------------------------------*- Choupo -*-----------------------*\
  Species ALOHF (NASA/TP-2002-211556 appendix D entry "ALOHF"):
  ideal-gas formation data and heat capacity transcribed by machine with
  bin/curate/nasa_tp2002_to_choupo.py table, which holds H and S at
  298.15 K recomputed from the printed coefficients to the printed
  values.  Not read back against the page by a curator.
  The report's own description and sources: Gurvich,1996a pt1 p166 pt2 p128.
\*---------------------------------------------------------------------------*/
name           ALOHF;
formula        AlOHF;
CAS            n/a;
MW             62.98728;       // kg/kmol, appendix D record line
role           gasOnly;       // free radical (odd electron count 31)
tags           ( gasPhase thermoTable );
nasaEntry      "ALOHF";
reviewStatus   interim;
reviewReason   "transcribed by machine from NASA/TP-2002-211556 into the thermoTables home and checked against the report itself; not yet read back against the page by a curator";
standardThermochemistry
{
    dHf_298    -574211.575;   // J/mol  -- ideal gas; NASA/TP-2002-211556 appendix D, p. 52, entry ALOHF
    s_298      282.240;     // J/(mol·K) -- third-law absolute; Table B1, p. 10
}

idealGasHeatCapacity
{
    //  NASA/TP-2002-211556 eq. (1), Cp/R = a1/T^2 + a2/T + a3 + a4 T + a5 T^2
    //  + a6 T^3 + a7 T^4; appendix D, p. 52, entry ALOHF, a1..a7 as printed.
    model    NASA9;
    Tlow     200;
    Tcommon  1000;
    Thigh    6000;
    low      ( -1.556003336e+03 2.886581999e+02 7.703793290e-01 2.450406329e-02 -3.417811010e-05 2.388932902e-08 -6.570480510e-12 );
    high     ( 7.557113130e+05 -2.936702803e+03 1.102455104e+01 -1.373078030e-04 -7.432816160e-09 3.729981220e-12 -2.657027781e-16 );
}

provenance
{
    dHf_298
    {
        origin        literature;
        method        "NASA/TP-2002-211556 appendix D, p. 52, entry ALOHF, record-line H(298.15) (elements reference, so = dHf)";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "Table B1 p. 10 prints -574.212 kJ/mol; the report's own sources: Gurvich,1996a pt1 p166 pt2 p128.";
    }
    s_298
    {
        origin        literature;
        method        "NASA/TP-2002-211556 Table B1, p. 10, entry ALOHF";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "appendix D's coefficients with b2 integrate to 282.240";
    }
    idealGasHeatCapacity
    {
        origin        literature;
        method        "NASA/TP-2002-211556 appendix D, p. 52, entry ALOHF, a1..a7 of the 200-1000 K and 1000-6000 K intervals, as printed";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "read by bin/curate/nasa_tp2002_to_choupo.py, which holds H and S at 298.15 K to the printed values";
    }
    source   "McBride, Zehe & Gordon, NASA Glenn Coefficients for Calculating Thermodynamic Properties of Individual Species, NASA/TP-2002-211556 (2002)";
    licence  publicDomain;    // US government work (NASA), 17 U.S.C. 105
}
