/*--------------------------------*- Choupo -*-----------------------*\
  Species BI2 (NASA/TP-2002-211556 appendix D entry "BI2"):
  ideal-gas formation data and heat capacity transcribed by machine with
  bin/curate/nasa_tp2002_to_choupo.py table, which holds H and S at
  298.15 K recomputed from the printed coefficients to the printed
  values.  Not read back against the page by a curator.
  The report's own description and sources: Gurvich,1996a pt1 p95 pt2 p74.
\*---------------------------------------------------------------------------*/
name           BI2;
formula        BI2;
CAS            n/a;
MW             264.6199;       // kg/kmol, appendix D record line
role           gasOnly;       // free radical (odd electron count 111)
tags           ( gasPhase thermoTable );
nasaEntry      "BI2";
reviewStatus   interim;
reviewReason   "transcribed by machine from NASA/TP-2002-211556 into the thermoTables home and checked against the report itself; not yet read back against the page by a curator";
standardThermochemistry
{
    dHf_298    238096.324;   // J/mol  -- ideal gas; NASA/TP-2002-211556 appendix D, p. 60, entry BI2
    s_298      311.115;     // J/(mol·K) -- third-law absolute; Table B1, p. 11
}

idealGasHeatCapacity
{
    //  NASA/TP-2002-211556 eq. (1), Cp/R = a1/T^2 + a2/T + a3 + a4 T + a5 T^2
    //  + a6 T^3 + a7 T^4; appendix D, p. 60, entry BI2, a1..a7 as printed.
    model    NASA9;
    Tlow     200;
    Tcommon  1000;
    Thigh    6000;
    low      ( 6.640975900e+04 -1.044411994e+03 9.734197240e+00 -3.952557540e-03 3.165567780e-06 -1.273764644e-09 1.879968132e-13 );
    high     ( -3.924022230e+05 4.422902350e+02 7.129623580e+00 -5.619634060e-04 3.180760520e-07 -5.537079720e-11 3.183959700e-15 );
}

provenance
{
    dHf_298
    {
        origin        literature;
        method        "NASA/TP-2002-211556 appendix D, p. 60, entry BI2, record-line H(298.15) (elements reference, so = dHf)";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "Table B1 p. 11 prints 238.096 kJ/mol; the report's own sources: Gurvich,1996a pt1 p95 pt2 p74.";
    }
    s_298
    {
        origin        literature;
        method        "NASA/TP-2002-211556 Table B1, p. 11, entry BI2";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "appendix D's coefficients with b2 integrate to 311.115";
    }
    idealGasHeatCapacity
    {
        origin        literature;
        method        "NASA/TP-2002-211556 appendix D, p. 60, entry BI2, a1..a7 of the 200-1000 K and 1000-6000 K intervals, as printed";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "read by bin/curate/nasa_tp2002_to_choupo.py, which holds H and S at 298.15 K to the printed values";
    }
    source   "McBride, Zehe & Gordon, NASA Glenn Coefficients for Calculating Thermodynamic Properties of Individual Species, NASA/TP-2002-211556 (2002)";
    licence  publicDomain;    // US government work (NASA), 17 U.S.C. 105
}
