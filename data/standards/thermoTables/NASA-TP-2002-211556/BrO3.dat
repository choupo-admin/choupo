/*--------------------------------*- Choupo -*-----------------------*\
  Species BrO3 (NASA/TP-2002-211556 appendix D entry "BrO3"):
  ideal-gas formation data and heat capacity transcribed by machine with
  bin/curate/nasa_tp2002_to_choupo.py table, which holds H and S at
  298.15 K recomputed from the printed coefficients to the printed
  values.  Not read back against the page by a curator.
  The report's own description and sources: Chase,1996a.
\*---------------------------------------------------------------------------*/
name           BrO3;
formula        BrO3;
CAS            n/a;
MW             127.9022;       // kg/kmol, appendix D record line
role           gasOnly;       // free radical (odd electron count 59)
tags           ( gasPhase thermoTable );
nasaEntry      "BrO3";
reviewStatus   interim;
reviewReason   "transcribed by machine from NASA/TP-2002-211556 into the thermoTables home and checked against the report itself; not yet read back against the page by a curator";
standardThermochemistry
{
    dHf_298    220820.685;   // J/mol  -- ideal gas; NASA/TP-2002-211556 appendix D, p. 74, entry BrO3
    s_298      284.509;     // J/(mol·K) -- third-law absolute; Table B1, p. 13
}

idealGasHeatCapacity
{
    //  NASA/TP-2002-211556 eq. (1), Cp/R = a1/T^2 + a2/T + a3 + a4 T + a5 T^2
    //  + a6 T^3 + a7 T^4; appendix D, p. 74, entry BrO3, a1..a7 as printed.
    model    NASA9;
    Tlow     200;
    Tcommon  1000;
    Thigh    6000;
    low      ( 1.063901881e+05 -1.501928813e+03 9.703657430e+00 8.133000760e-03 -1.531857845e-05 1.199117619e-08 -3.512747870e-12 );
    high     ( -2.822851113e+05 -2.358973461e+02 1.017525279e+01 -6.978451050e-05 1.535701661e-08 -1.754454950e-12 8.104100150e-17 );
}

provenance
{
    dHf_298
    {
        origin        literature;
        method        "NASA/TP-2002-211556 appendix D, p. 74, entry BrO3, record-line H(298.15) (elements reference, so = dHf)";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "Table B1 p. 13 prints 220.821 kJ/mol; the report's own sources: Chase,1996a.";
    }
    s_298
    {
        origin        literature;
        method        "NASA/TP-2002-211556 Table B1, p. 13, entry BrO3";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "appendix D's coefficients with b2 integrate to 284.509";
    }
    idealGasHeatCapacity
    {
        origin        literature;
        method        "NASA/TP-2002-211556 appendix D, p. 74, entry BrO3, a1..a7 of the 200-1000 K and 1000-6000 K intervals, as printed";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "read by bin/curate/nasa_tp2002_to_choupo.py, which holds H and S at 298.15 K to the printed values";
    }
    source   "McBride, Zehe & Gordon, NASA Glenn Coefficients for Calculating Thermodynamic Properties of Individual Species, NASA/TP-2002-211556 (2002)";
    licence  publicDomain;    // US government work (NASA), 17 U.S.C. 105
}
