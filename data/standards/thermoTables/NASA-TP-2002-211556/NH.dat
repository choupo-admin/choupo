/*--------------------------------*- Choupo -*-----------------------*\
  Species NH (NASA/TP-2002-211556 appendix D entry "NH"):
  ideal-gas formation data and heat capacity transcribed by machine with
  bin/curate/nasa_tp2002_to_choupo.py table, which holds H and S at
  298.15 K recomputed from the printed coefficients to the printed
  values.  Not read back against the page by a curator.
  The report's own description and sources: Hf:Anderson,1989. Gurvich,1978 pt2 p223.
\*---------------------------------------------------------------------------*/
name           NH;
formula        NH;
CAS            n/a;
MW             15.01464;       // kg/kmol, appendix D record line
role           gasOnly;       // listed (biradical or transient): imidogen, triplet ground state
tags           ( gasPhase thermoTable );
nasaEntry      "NH";
reviewStatus   interim;
reviewReason   "transcribed by machine from NASA/TP-2002-211556 into the thermoTables home and checked against the report itself; not yet read back against the page by a curator";
standardThermochemistry
{
    dHf_298    357032.001;   // J/mol  -- ideal gas; NASA/TP-2002-211556 appendix D, p. 154, entry NH
    s_298      181.227;     // J/(mol·K) -- third-law absolute; Table B1, p. 24
}

idealGasHeatCapacity
{
    //  NASA/TP-2002-211556 eq. (1), Cp/R = a1/T^2 + a2/T + a3 + a4 T + a5 T^2
    //  + a6 T^3 + a7 T^4; appendix D, p. 154, entry NH, a1..a7 as printed.
    //  The report's 6000-20000 K interval is not transcribed.
    model    NASA9;
    Tlow     200;
    Tcommon  1000;
    Thigh    6000;
    low      ( 1.359651320e+04 -1.900296604e+02 4.518496790e+00 -2.432776899e-03 2.377587464e-06 -2.592797084e-10 -2.659680792e-13 );
    high     ( 1.958141991e+06 -5.782861300e+03 9.335742020e+00 -2.292910311e-03 6.076092480e-07 -6.647942750e-11 2.384234783e-15 );
}

provenance
{
    dHf_298
    {
        origin        literature;
        method        "NASA/TP-2002-211556 appendix D, p. 154, entry NH, record-line H(298.15) (elements reference, so = dHf)";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "Table B1 p. 24 prints 357.032 kJ/mol; the report's own sources: Hf:Anderson,1989. Gurvich,1978 pt2 p223.";
    }
    s_298
    {
        origin        literature;
        method        "NASA/TP-2002-211556 Table B1, p. 24, entry NH";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "appendix D's coefficients with b2 integrate to 181.227";
    }
    idealGasHeatCapacity
    {
        origin        literature;
        method        "NASA/TP-2002-211556 appendix D, p. 154, entry NH, a1..a7 of the 200-1000 K and 1000-6000 K intervals, as printed";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "read by bin/curate/nasa_tp2002_to_choupo.py, which holds H and S at 298.15 K to the printed values";
    }
    source   "McBride, Zehe & Gordon, NASA Glenn Coefficients for Calculating Thermodynamic Properties of Individual Species, NASA/TP-2002-211556 (2002)";
    licence  publicDomain;    // US government work (NASA), 17 U.S.C. 105
}
