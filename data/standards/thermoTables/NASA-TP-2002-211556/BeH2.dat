/*--------------------------------*- Choupo -*-----------------------*\
  Species BeH2 (NASA/TP-2002-211556 appendix D entry "BeH2"):
  ideal-gas formation data and heat capacity transcribed by machine with
  bin/curate/nasa_tp2002_to_choupo.py table, which holds H and S at
  298.15 K recomputed from the printed coefficients to the printed
  values.  Not read back against the page by a curator.
  The report's own description and sources: Martin,1992. Martin,1997.
\*---------------------------------------------------------------------------*/
name           BeH2;
formula        BeH2;
CAS            n/a;
MW             11.02806;       // kg/kmol, appendix D record line
role           nonvolatile;   // ideal-gas species: no vapour pressure is asked of it
tags           ( gasPhase thermoTable );
nasaEntry      "BeH2";
reviewStatus   interim;
reviewReason   "transcribed by machine from NASA/TP-2002-211556 into the thermoTables home and checked against the report itself; not yet read back against the page by a curator";
standardThermochemistry
{
    dHf_298    161098.903;   // J/mol  -- ideal gas; NASA/TP-2002-211556 appendix D, p. 70, entry BeH2
    s_298      175.235;     // J/(mol·K) -- third-law absolute; Table B1, p. 12
}

idealGasHeatCapacity
{
    //  NASA/TP-2002-211556 eq. (1), Cp/R = a1/T^2 + a2/T + a3 + a4 T + a5 T^2
    //  + a6 T^3 + a7 T^4; appendix D, p. 70, entry BeH2, a1..a7 as printed.
    model    NASA9;
    Tlow     200;
    Tcommon  1000;
    Thigh    6000;
    low      ( 9.065314900e+04 -1.320657220e+03 9.901308060e+00 -1.255772231e-02 2.205704068e-05 -1.633609388e-08 4.505103240e-12 );
    high     ( 6.074262010e+05 -3.407534250e+03 9.792370360e+00 -8.254614820e-04 1.915656246e-07 -1.962774813e-11 8.929908660e-16 );
}

provenance
{
    dHf_298
    {
        origin        literature;
        method        "NASA/TP-2002-211556 appendix D, p. 70, entry BeH2, record-line H(298.15) (elements reference, so = dHf)";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "Table B1 p. 12 prints 161.099 kJ/mol; the report's own sources: Martin,1992. Martin,1997.";
    }
    s_298
    {
        origin        literature;
        method        "NASA/TP-2002-211556 Table B1, p. 12, entry BeH2";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "appendix D's coefficients with b2 integrate to 175.235";
    }
    idealGasHeatCapacity
    {
        origin        literature;
        method        "NASA/TP-2002-211556 appendix D, p. 70, entry BeH2, a1..a7 of the 200-1000 K and 1000-6000 K intervals, as printed";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "read by bin/curate/nasa_tp2002_to_choupo.py, which holds H and S at 298.15 K to the printed values";
    }
    source   "McBride, Zehe & Gordon, NASA Glenn Coefficients for Calculating Thermodynamic Properties of Individual Species, NASA/TP-2002-211556 (2002)";
    licence  publicDomain;    // US government work (NASA), 17 U.S.C. 105
}
