/*--------------------------------*- Choupo -*-----------------------*\
  Species SF (NASA/TP-2002-211556 appendix D entry "SF"):
  ideal-gas formation data and heat capacity transcribed by machine with
  bin/curate/nasa_tp2002_to_choupo.py table, which holds H and S at
  298.15 K recomputed from the printed coefficients to the printed
  values.  Not read back against the page by a curator.
  The report's own description and sources: Gurvich,1989 pt1 p302 pt2 p183.
\*---------------------------------------------------------------------------*/
name           SF;
formula        SF;
CAS            n/a;
MW             51.0634;       // kg/kmol, appendix D record line
role           gasOnly;       // free radical (odd electron count 25)
tags           ( gasPhase thermoTable );
nasaEntry      "SF";
reviewStatus   interim;
reviewReason   "transcribed by machine from NASA/TP-2002-211556 into the thermoTables home and checked against the report itself; not yet read back against the page by a curator";
standardThermochemistry
{
    dHf_298    15445.561;   // J/mol  -- ideal gas; NASA/TP-2002-211556 appendix D, p. 180, entry SF
    s_298      225.281;     // J/(mol·K) -- third-law absolute; Table B1, p. 28
}

idealGasHeatCapacity
{
    //  NASA/TP-2002-211556 eq. (1), Cp/R = a1/T^2 + a2/T + a3 + a4 T + a5 T^2
    //  + a6 T^3 + a7 T^4; appendix D, p. 180, entry SF, a1..a7 as printed.
    model    NASA9;
    Tlow     200;
    Tcommon  1000;
    Thigh    6000;
    low      ( 1.206456774e+04 -2.910270770e+02 5.480101570e+00 -1.975880235e-03 2.473685990e-06 -1.610904623e-09 4.310038540e-13 );
    high     ( 7.634580750e+05 -2.423638430e+03 7.352198710e+00 -1.598026079e-03 4.868515020e-07 -6.478000530e-11 2.980297310e-15 );
}

provenance
{
    dHf_298
    {
        origin        literature;
        method        "NASA/TP-2002-211556 appendix D, p. 180, entry SF, record-line H(298.15) (elements reference, so = dHf)";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "Table B1 p. 28 prints 15.446 kJ/mol; the report's own sources: Gurvich,1989 pt1 p302 pt2 p183.";
    }
    s_298
    {
        origin        literature;
        method        "NASA/TP-2002-211556 Table B1, p. 28, entry SF";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "appendix D's coefficients with b2 integrate to 225.281";
    }
    idealGasHeatCapacity
    {
        origin        literature;
        method        "NASA/TP-2002-211556 appendix D, p. 180, entry SF, a1..a7 of the 200-1000 K and 1000-6000 K intervals, as printed";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "read by bin/curate/nasa_tp2002_to_choupo.py, which holds H and S at 298.15 K to the printed values";
    }
    source   "McBride, Zehe & Gordon, NASA Glenn Coefficients for Calculating Thermodynamic Properties of Individual Species, NASA/TP-2002-211556 (2002)";
    licence  publicDomain;    // US government work (NASA), 17 U.S.C. 105
}
