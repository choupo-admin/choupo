/*--------------------------------*- Choupo -*-----------------------*\
  Species B4H12 (NASA/TP-2002-211556 appendix D entry "B4H12"):
  ideal-gas formation data and heat capacity transcribed by machine with
  bin/curate/nasa_tp2002_to_choupo.py table, which holds H and S at
  298.15 K recomputed from the printed coefficients to the printed
  values.  Not read back against the page by a curator.
  The report's own description and sources: Shen,1993. Yu,1998.
\*---------------------------------------------------------------------------*/
name           B4H12;
formula        B4H12;
CAS            n/a;
MW             55.33928;       // kg/kmol, appendix D record line
role           nonvolatile;   // ideal-gas species: no vapour pressure is asked of it
tags           ( gasPhase thermoTable );
nasaEntry      "B4H12";
reviewStatus   interim;
reviewReason   "transcribed by machine from NASA/TP-2002-211556 into the thermoTables home and checked against the report itself; not yet read back against the page by a curator";
standardThermochemistry
{
    dHf_298    188236.114;   // J/mol  -- ideal gas; NASA/TP-2002-211556 appendix D, p. 66, entry B4H12
    s_298      315.870;     // J/(mol·K) -- third-law absolute; Table B1, p. 12
}

idealGasHeatCapacity
{
    //  NASA/TP-2002-211556 eq. (1), Cp/R = a1/T^2 + a2/T + a3 + a4 T + a5 T^2
    //  + a6 T^3 + a7 T^4; appendix D, p. 66, entry B4H12, a1..a7 as printed.
    model    NASA9;
    Tlow     200;
    Tcommon  1000;
    Thigh    6000;
    low      ( 7.152170300e+04 -1.590351575e+02 -4.719771660e+00 8.811228900e-02 -8.604946880e-05 5.123535510e-08 -1.379865250e-11 );
    high     ( 6.158360800e+06 -3.202086730e+04 6.660443600e+01 -7.406369280e-03 1.512993908e-06 -1.635619071e-10 7.245385140e-15 );
}

provenance
{
    dHf_298
    {
        origin        literature;
        method        "NASA/TP-2002-211556 appendix D, p. 66, entry B4H12, record-line H(298.15) (elements reference, so = dHf)";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "Table B1 p. 12 prints 188.236 kJ/mol; the report's own sources: Shen,1993. Yu,1998.";
    }
    s_298
    {
        origin        literature;
        method        "NASA/TP-2002-211556 Table B1, p. 12, entry B4H12";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "appendix D's coefficients with b2 integrate to 315.870";
    }
    idealGasHeatCapacity
    {
        origin        literature;
        method        "NASA/TP-2002-211556 appendix D, p. 66, entry B4H12, a1..a7 of the 200-1000 K and 1000-6000 K intervals, as printed";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "read by bin/curate/nasa_tp2002_to_choupo.py, which holds H and S at 298.15 K to the printed values";
    }
    source   "McBride, Zehe & Gordon, NASA Glenn Coefficients for Calculating Thermodynamic Properties of Individual Species, NASA/TP-2002-211556 (2002)";
    licence  publicDomain;    // US government work (NASA), 17 U.S.C. 105
}
