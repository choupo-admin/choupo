/*--------------------------------*- Choupo -*-----------------------*\
  Species CaF (NASA/TP-2002-211556 appendix D entry "CaF"):
  ideal-gas formation data and heat capacity transcribed by machine with
  bin/curate/nasa_tp2002_to_choupo.py table, which holds H and S at
  298.15 K recomputed from the printed coefficients to the printed
  values.  Not read back against the page by a curator.
  The report's own description and sources: Gurvich,1996a pt1 p456 pt2 p359.
\*---------------------------------------------------------------------------*/
name           CaF;
formula        CaF;
CAS            n/a;
MW             59.0764;       // kg/kmol, appendix D record line
role           gasOnly;       // free radical (odd electron count 29)
tags           ( gasPhase thermoTable );
nasaEntry      "CaF";
reviewStatus   interim;
reviewReason   "transcribed by machine from NASA/TP-2002-211556 into the thermoTables home and checked against the report itself; not yet read back against the page by a curator";
standardThermochemistry
{
    dHf_298    -276403.790;   // J/mol  -- ideal gas; NASA/TP-2002-211556 appendix D, p. 104, entry CaF
    s_298      229.138;     // J/(mol·K) -- third-law absolute; Table B1, p. 17
}

idealGasHeatCapacity
{
    //  NASA/TP-2002-211556 eq. (1), Cp/R = a1/T^2 + a2/T + a3 + a4 T + a5 T^2
    //  + a6 T^3 + a7 T^4; appendix D, p. 104, entry CaF, a1..a7 as printed.
    model    NASA9;
    Tlow     200;
    Tcommon  1000;
    Thigh    6000;
    low      ( 3.184235400e+04 -4.918235090e+02 5.701120890e+00 -1.465138218e-03 9.092930810e-07 -1.367585222e-10 -5.106323380e-14 );
    high     ( 5.195882670e+05 -1.512321567e+03 5.869276250e+00 -3.882524480e-04 -2.484582298e-08 3.749915960e-11 -3.470976450e-15 );
}

provenance
{
    dHf_298
    {
        origin        literature;
        method        "NASA/TP-2002-211556 appendix D, p. 104, entry CaF, record-line H(298.15) (elements reference, so = dHf)";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "Table B1 p. 17 prints -276.404 kJ/mol; the report's own sources: Gurvich,1996a pt1 p456 pt2 p359.";
    }
    s_298
    {
        origin        literature;
        method        "NASA/TP-2002-211556 Table B1, p. 17, entry CaF";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "appendix D's coefficients with b2 integrate to 229.138";
    }
    idealGasHeatCapacity
    {
        origin        literature;
        method        "NASA/TP-2002-211556 appendix D, p. 104, entry CaF, a1..a7 of the 200-1000 K and 1000-6000 K intervals, as printed";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "read by bin/curate/nasa_tp2002_to_choupo.py, which holds H and S at 298.15 K to the printed values";
    }
    source   "McBride, Zehe & Gordon, NASA Glenn Coefficients for Calculating Thermodynamic Properties of Individual Species, NASA/TP-2002-211556 (2002)";
    licence  publicDomain;    // US government work (NASA), 17 U.S.C. 105
}
