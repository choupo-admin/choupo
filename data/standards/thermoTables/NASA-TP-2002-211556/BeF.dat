/*--------------------------------*- Choupo -*-----------------------*\
  Species BeF (NASA/TP-2002-211556 appendix D entry "BeF"):
  ideal-gas formation data and heat capacity transcribed by machine with
  bin/curate/nasa_tp2002_to_choupo.py table, which holds H and S at
  298.15 K recomputed from the printed coefficients to the printed
  values.  Not read back against the page by a curator.
  The report's own description and sources: Gurvich,1996a pt1 p363, pt2 p291.
\*---------------------------------------------------------------------------*/
name           BeF;
formula        BeF;
CAS            n/a;
MW             28.01059;       // kg/kmol, appendix D record line
role           gasOnly;       // free radical (odd electron count 13)
tags           ( gasPhase thermoTable );
nasaEntry      "BeF";
reviewStatus   interim;
reviewReason   "transcribed by machine from NASA/TP-2002-211556 into the thermoTables home and checked against the report itself; not yet read back against the page by a curator";
standardThermochemistry
{
    dHf_298    -170624.795;   // J/mol  -- ideal gas; NASA/TP-2002-211556 appendix D, p. 70, entry BeF
    s_298      205.754;     // J/(mol·K) -- third-law absolute; Table B1, p. 12
}

idealGasHeatCapacity
{
    //  NASA/TP-2002-211556 eq. (1), Cp/R = a1/T^2 + a2/T + a3 + a4 T + a5 T^2
    //  + a6 T^3 + a7 T^4; appendix D, p. 70, entry BeF, a1..a7 as printed.
    model    NASA9;
    Tlow     200;
    Tcommon  1000;
    Thigh    6000;
    low      ( -4.664497230e+04 7.887178850e+02 -1.463363201e+00 1.381790494e-02 -1.591299964e-05 9.352931520e-09 -2.229211181e-12 );
    high     ( -1.857941543e+05 4.776082770e+01 4.269986020e+00 2.310668473e-04 -6.657214920e-08 1.152149888e-11 -6.335586440e-16 );
}

provenance
{
    dHf_298
    {
        origin        literature;
        method        "NASA/TP-2002-211556 appendix D, p. 70, entry BeF, record-line H(298.15) (elements reference, so = dHf)";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "Table B1 p. 12 prints -170.625 kJ/mol; the report's own sources: Gurvich,1996a pt1 p363, pt2 p291.";
    }
    s_298
    {
        origin        literature;
        method        "NASA/TP-2002-211556 Table B1, p. 12, entry BeF";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "appendix D's coefficients with b2 integrate to 205.754";
    }
    idealGasHeatCapacity
    {
        origin        literature;
        method        "NASA/TP-2002-211556 appendix D, p. 70, entry BeF, a1..a7 of the 200-1000 K and 1000-6000 K intervals, as printed";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "read by bin/curate/nasa_tp2002_to_choupo.py, which holds H and S at 298.15 K to the printed values";
    }
    source   "McBride, Zehe & Gordon, NASA Glenn Coefficients for Calculating Thermodynamic Properties of Individual Species, NASA/TP-2002-211556 (2002)";
    licence  publicDomain;    // US government work (NASA), 17 U.S.C. 105
}
