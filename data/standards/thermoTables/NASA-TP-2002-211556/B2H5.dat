/*--------------------------------*- Choupo -*-----------------------*\
  Species B2H5 (NASA/TP-2002-211556 appendix D entry "B2H5"):
  ideal-gas formation data and heat capacity transcribed by machine with
  bin/curate/nasa_tp2002_to_choupo.py table, which holds H and S at
  298.15 K recomputed from the printed coefficients to the printed
  values.  Not read back against the page by a curator.
  The report's own description and sources: 1-Bridge. Ruscic,1989a. Trachtman,1989.
\*---------------------------------------------------------------------------*/
name           B2H5;
formula        B2H5;
CAS            n/a;
MW             26.6617;       // kg/kmol, appendix D record line
role           nonvolatile;   // ideal-gas species: no vapour pressure is asked of it
tags           ( gasPhase thermoTable );
nasaEntry      "B2H5";
reviewStatus   interim;
reviewReason   "transcribed by machine from NASA/TP-2002-211556 into the thermoTables home and checked against the report itself; not yet read back against the page by a curator";
standardThermochemistry
{
    dHf_298    254783.889;   // J/mol  -- ideal gas; NASA/TP-2002-211556 appendix D, p. 63, entry B2H5
    s_298      243.502;     // J/(mol·K) -- third-law absolute; Table B1, p. 11
}

idealGasHeatCapacity
{
    //  NASA/TP-2002-211556 eq. (1), Cp/R = a1/T^2 + a2/T + a3 + a4 T + a5 T^2
    //  + a6 T^3 + a7 T^4; appendix D, p. 63, entry B2H5, a1..a7 as printed.
    model    NASA9;
    Tlow     200;
    Tcommon  1000;
    Thigh    6000;
    low      ( 3.830965450e+04 -4.066148050e+01 -1.422523787e+00 3.674595270e-02 -3.851989710e-05 2.444494440e-08 -6.821722940e-12 );
    high     ( 2.696691012e+06 -1.320019835e+04 2.735260413e+01 -2.961879012e-03 5.984999430e-07 -6.413748550e-11 2.821187823e-15 );
}

provenance
{
    dHf_298
    {
        origin        literature;
        method        "NASA/TP-2002-211556 appendix D, p. 63, entry B2H5, record-line H(298.15) (elements reference, so = dHf)";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "Table B1 p. 11 prints 254.784 kJ/mol; the report's own sources: 1-Bridge. Ruscic,1989a. Trachtman,1989.";
    }
    s_298
    {
        origin        literature;
        method        "NASA/TP-2002-211556 Table B1, p. 11, entry B2H5";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "appendix D's coefficients with b2 integrate to 243.502";
    }
    idealGasHeatCapacity
    {
        origin        literature;
        method        "NASA/TP-2002-211556 appendix D, p. 63, entry B2H5, a1..a7 of the 200-1000 K and 1000-6000 K intervals, as printed";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "read by bin/curate/nasa_tp2002_to_choupo.py, which holds H and S at 298.15 K to the printed values";
    }
    source   "McBride, Zehe & Gordon, NASA Glenn Coefficients for Calculating Thermodynamic Properties of Individual Species, NASA/TP-2002-211556 (2002)";
    licence  publicDomain;    // US government work (NASA), 17 U.S.C. 105
}
