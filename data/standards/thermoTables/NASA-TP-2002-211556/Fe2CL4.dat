/*--------------------------------*- Choupo -*-----------------------*\
  Species Fe2CL4 (NASA/TP-2002-211556 appendix D entry "Fe2CL4"):
  ideal-gas formation data and heat capacity transcribed by machine with
  bin/curate/nasa_tp2002_to_choupo.py table, which holds H and S at
  298.15 K recomputed from the printed coefficients to the printed
  values.  Not read back against the page by a curator.
  The report's own description and sources: Chase,1998 p891.
\*---------------------------------------------------------------------------*/
name           Fe2CL4;
formula        Fe2Cl4;
CAS            n/a;
MW             253.502;       // kg/kmol, appendix D record line
role           radical;       // gas-only (DEV.md 4c C458): stays in the vapour, refused where no vapour holds it
tags           ( gasPhase thermoTable );
nasaEntry      "Fe2CL4";
reviewStatus   interim;
reviewReason   "transcribed by machine from NASA/TP-2002-211556 into the thermoTables home and checked against the report itself; not yet read back against the page by a curator";
standardThermochemistry
{
    dHf_298    -431370.400;   // J/mol  -- ideal gas; NASA/TP-2002-211556 appendix D, p. 119, entry Fe2CL4
    s_298      464.506;     // J/(mol·K) -- third-law absolute; Table B1, p. 19
}

idealGasHeatCapacity
{
    //  NASA/TP-2002-211556 eq. (1), Cp/R = a1/T^2 + a2/T + a3 + a4 T + a5 T^2
    //  + a6 T^3 + a7 T^4; appendix D, p. 119, entry Fe2CL4, a1..a7 as printed.
    model    NASA9;
    Tlow     200;
    Tcommon  1000;
    Thigh    6000;
    low      ( 1.501308814e+03 -6.617096510e+02 1.826924882e+01 -4.181494660e-03 4.196535050e-06 -2.188670747e-09 5.395194700e-13 );
    high     ( 1.402450973e+05 6.936064410e+02 1.313800410e+01 2.754333070e-03 -8.623996010e-07 1.170782491e-10 -5.937778080e-15 );
}

provenance
{
    dHf_298
    {
        origin        literature;
        method        "NASA/TP-2002-211556 appendix D, p. 119, entry Fe2CL4, record-line H(298.15) (elements reference, so = dHf)";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "Table B1 p. 19 prints -431.37 kJ/mol; the report's own sources: Chase,1998 p891.";
    }
    s_298
    {
        origin        literature;
        method        "NASA/TP-2002-211556 Table B1, p. 19, entry Fe2CL4";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "appendix D's coefficients with b2 integrate to 464.506";
    }
    idealGasHeatCapacity
    {
        origin        literature;
        method        "NASA/TP-2002-211556 appendix D, p. 119, entry Fe2CL4, a1..a7 of the 200-1000 K and 1000-6000 K intervals, as printed";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "read by bin/curate/nasa_tp2002_to_choupo.py, which holds H and S at 298.15 K to the printed values";
    }
    source   "McBride, Zehe & Gordon, NASA Glenn Coefficients for Calculating Thermodynamic Properties of Individual Species, NASA/TP-2002-211556 (2002)";
    licence  publicDomain;    // US government work (NASA), 17 U.S.C. 105
}
