/*--------------------------------*- Choupo -*-----------------------*\
  Species C9H19_nnonyl (NASA/TP-2002-211556 appendix D entry "C9H19,n-nonyl"):
  ideal-gas formation data and heat capacity transcribed by machine with
  bin/curate/nasa_tp2002_to_choupo.py table, which holds H and S at
  298.15 K recomputed from the printed coefficients to the printed
  values.  Not read back against the page by a curator.
  The report's own description and sources: TRC (10/83) tuvw1930.
\*---------------------------------------------------------------------------*/
name           C9H19_nnonyl;
formula        C9H19;
CAS            n/a;
MW             127.2472;       // kg/kmol, appendix D record line
role           gasOnly;       // free radical (odd electron count 73)
tags           ( gasPhase thermoTable );
nasaEntry      "C9H19,n-nonyl";
reviewStatus   interim;
reviewReason   "transcribed by machine from NASA/TP-2002-211556 into the thermoTables home and checked against the report itself; not yet read back against the page by a curator";
standardThermochemistry
{
    dHf_298    -37030.000;   // J/mol  -- ideal gas; NASA/TP-2002-211556 appendix D, p. 103, entry C9H19,n-nonyl
    s_298      527.419;     // J/(mol·K) -- third-law absolute; Table B1, p. 17
}

idealGasHeatCapacity
{
    //  NASA/TP-2002-211556 eq. (1), Cp/R = a1/T^2 + a2/T + a3 + a4 T + a5 T^2
    //  + a6 T^3 + a7 T^4; appendix D, p. 103, entry C9H19,n-nonyl, a1..a7 as printed.
    model    NASA9;
    Tlow     200;
    Tcommon  1000;
    Thigh    6000;
    low      ( -2.194880612e+06 3.468565780e+04 -2.009261419e+02 6.580503110e-01 -8.525930010e-04 5.794638960e-07 -1.597637099e-10 );
    high     ( 5.277361740e+06 -4.025701960e+04 9.457296720e+01 -2.940301447e-03 6.978106990e-09 6.805250240e-11 -5.907095330e-15 );
}

provenance
{
    dHf_298
    {
        origin        literature;
        method        "NASA/TP-2002-211556 appendix D, p. 103, entry C9H19,n-nonyl, record-line H(298.15) (elements reference, so = dHf)";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "Table B1 p. 17 prints -37.03 kJ/mol; the report's own sources: TRC (10/83) tuvw1930.";
    }
    s_298
    {
        origin        literature;
        method        "NASA/TP-2002-211556 Table B1, p. 17, entry C9H19,n-nonyl";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "appendix D's coefficients with b2 integrate to 527.419";
    }
    idealGasHeatCapacity
    {
        origin        literature;
        method        "NASA/TP-2002-211556 appendix D, p. 103, entry C9H19,n-nonyl, a1..a7 of the 200-1000 K and 1000-6000 K intervals, as printed";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "read by bin/curate/nasa_tp2002_to_choupo.py, which holds H and S at 298.15 K to the printed values";
    }
    source   "McBride, Zehe & Gordon, NASA Glenn Coefficients for Calculating Thermodynamic Properties of Individual Species, NASA/TP-2002-211556 (2002)";
    licence  publicDomain;    // US government work (NASA), 17 U.S.C. 105
}
