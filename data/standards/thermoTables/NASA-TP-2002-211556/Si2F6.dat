/*--------------------------------*- Choupo -*-----------------------*\
  Species Si2F6 (NASA/TP-2002-211556 appendix D entry "Si2F6"):
  ideal-gas formation data and heat capacity transcribed by machine with
  bin/curate/nasa_tp2002_to_choupo.py table, which holds H and S at
  298.15 K recomputed from the printed coefficients to the printed
  values.  Not read back against the page by a curator.
  The report's own description and sources: Lyman,2001.
\*---------------------------------------------------------------------------*/
name           Si2F6;
formula        Si2F6;
CAS            n/a;
MW             170.1614;       // kg/kmol, appendix D record line
role           nonvolatile;   // ideal-gas species: no vapour pressure is asked of it
tags           ( gasPhase thermoTable );
nasaEntry      "Si2F6";
reviewStatus   interim;
reviewReason   "transcribed by machine from NASA/TP-2002-211556 into the thermoTables home and checked against the report itself; not yet read back against the page by a curator";
standardThermochemistry
{
    dHf_298    -2383290.080;   // J/mol  -- ideal gas; NASA/TP-2002-211556 appendix D, p. 192, entry Si2F6
    s_298      391.386;     // J/(mol·K) -- third-law absolute; Table B1, p. 29
}

idealGasHeatCapacity
{
    //  NASA/TP-2002-211556 eq. (1), Cp/R = a1/T^2 + a2/T + a3 + a4 T + a5 T^2
    //  + a6 T^3 + a7 T^4; appendix D, p. 192, entry Si2F6, a1..a7 as printed.
    model    NASA9;
    Tlow     200;
    Tcommon  1000;
    Thigh    6000;
    low      ( 1.580767450e+04 -2.975292881e+02 7.512591500e+00 4.552796230e-02 -6.421876840e-05 4.357408730e-08 -1.166762282e-11 );
    high     ( -9.186303140e+05 1.573948683e+02 2.141256129e+01 -2.681898667e-04 7.212280110e-08 -9.184252660e-12 4.537238360e-16 );
}

provenance
{
    dHf_298
    {
        origin        literature;
        method        "NASA/TP-2002-211556 appendix D, p. 192, entry Si2F6, record-line H(298.15) (elements reference, so = dHf)";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "Table B1 p. 29 prints -2383.29 kJ/mol; the report's own sources: Lyman,2001.";
    }
    s_298
    {
        origin        literature;
        method        "NASA/TP-2002-211556 Table B1, p. 29, entry Si2F6";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "appendix D's coefficients with b2 integrate to 391.386";
    }
    idealGasHeatCapacity
    {
        origin        literature;
        method        "NASA/TP-2002-211556 appendix D, p. 192, entry Si2F6, a1..a7 of the 200-1000 K and 1000-6000 K intervals, as printed";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "read by bin/curate/nasa_tp2002_to_choupo.py, which holds H and S at 298.15 K to the printed values";
    }
    source   "McBride, Zehe & Gordon, NASA Glenn Coefficients for Calculating Thermodynamic Properties of Individual Species, NASA/TP-2002-211556 (2002)";
    licence  publicDomain;    // US government work (NASA), 17 U.S.C. 105
}
