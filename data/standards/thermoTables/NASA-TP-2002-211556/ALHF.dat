/*--------------------------------*- Choupo -*-----------------------*\
  Species ALHF (NASA/TP-2002-211556 appendix D entry "ALHF"):
  ideal-gas formation data and heat capacity transcribed by machine with
  bin/curate/nasa_tp2002_to_choupo.py table, which holds H and S at
  298.15 K recomputed from the printed coefficients to the printed
  values.  Not read back against the page by a curator.
  The report's own description and sources: Gurvich,1996a pt1 p164 pt2 p125.
\*---------------------------------------------------------------------------*/
name           ALHF;
formula        AlHF;
CAS            n/a;
MW             46.98788;       // kg/kmol, appendix D record line
role           nonvolatile;   // ideal-gas species: no vapour pressure is asked of it
tags           ( gasPhase thermoTable );
nasaEntry      "ALHF";
reviewStatus   interim;
reviewReason   "transcribed by machine from NASA/TP-2002-211556 into the thermoTables home and checked against the report itself; not yet read back against the page by a curator";
standardThermochemistry
{
    dHf_298    -182614.484;   // J/mol  -- ideal gas; NASA/TP-2002-211556 appendix D, p. 49, entry ALHF
    s_298      245.469;     // J/(mol·K) -- third-law absolute; Table B1, p. 9
}

idealGasHeatCapacity
{
    //  NASA/TP-2002-211556 eq. (1), Cp/R = a1/T^2 + a2/T + a3 + a4 T + a5 T^2
    //  + a6 T^3 + a7 T^4; appendix D, p. 49, entry ALHF, a1..a7 as printed.
    model    NASA9;
    Tlow     200;
    Tcommon  1000;
    Thigh    6000;
    low      ( -9.289545100e+03 1.335515868e+02 2.772448680e+00 6.751415030e-03 -4.133846140e-06 5.865704070e-10 2.276158011e-13 );
    high     ( 7.342169250e+05 -3.462164130e+03 1.039714588e+01 -1.750737965e-03 4.615687860e-07 -5.390414740e-11 2.340478515e-15 );
}

provenance
{
    dHf_298
    {
        origin        literature;
        method        "NASA/TP-2002-211556 appendix D, p. 49, entry ALHF, record-line H(298.15) (elements reference, so = dHf)";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "Table B1 p. 9 prints -182.614 kJ/mol; the report's own sources: Gurvich,1996a pt1 p164 pt2 p125.";
    }
    s_298
    {
        origin        literature;
        method        "NASA/TP-2002-211556 Table B1, p. 9, entry ALHF";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "appendix D's coefficients with b2 integrate to 245.469";
    }
    idealGasHeatCapacity
    {
        origin        literature;
        method        "NASA/TP-2002-211556 appendix D, p. 49, entry ALHF, a1..a7 of the 200-1000 K and 1000-6000 K intervals, as printed";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "read by bin/curate/nasa_tp2002_to_choupo.py, which holds H and S at 298.15 K to the printed values";
    }
    source   "McBride, Zehe & Gordon, NASA Glenn Coefficients for Calculating Thermodynamic Properties of Individual Species, NASA/TP-2002-211556 (2002)";
    licence  publicDomain;    // US government work (NASA), 17 U.S.C. 105
}
