/*--------------------------------*- Choupo -*-----------------------*\
  Species PF4CL (NASA/TP-2002-211556 appendix D entry "PF4CL"):
  ideal-gas formation data and heat capacity transcribed by machine with
  bin/curate/nasa_tp2002_to_choupo.py table, which holds H and S at
  298.15 K recomputed from the printed coefficients to the printed
  values.  Not read back against the page by a curator.
  The report's own description and sources: Gurvich,1989 pt1 p439 pt2 p291.
\*---------------------------------------------------------------------------*/
name           PF4CL;
formula        PF4Cl;
CAS            n/a;
MW             142.4204;       // kg/kmol, appendix D record line
role           radical;       // gas-only (DEV.md 4c C458): stays in the vapour, refused where no vapour holds it
tags           ( gasPhase thermoTable );
nasaEntry      "PF4CL";
reviewStatus   interim;
reviewReason   "transcribed by machine from NASA/TP-2002-211556 into the thermoTables home and checked against the report itself; not yet read back against the page by a curator";
standardThermochemistry
{
    dHf_298    -1364909.395;   // J/mol  -- ideal gas; NASA/TP-2002-211556 appendix D, p. 169, entry PF4CL
    s_298      326.834;     // J/(mol·K) -- third-law absolute; Table B1, p. 26
}

idealGasHeatCapacity
{
    //  NASA/TP-2002-211556 eq. (1), Cp/R = a1/T^2 + a2/T + a3 + a4 T + a5 T^2
    //  + a6 T^3 + a7 T^4; appendix D, p. 169, entry PF4CL, a1..a7 as printed.
    model    NASA9;
    Tlow     200;
    Tcommon  1000;
    Thigh    6000;
    low      ( 1.804240323e+05 -2.741096618e+03 1.680192838e+01 9.919315250e-03 -2.025636171e-05 1.617979147e-08 -4.772611520e-12 );
    high     ( -4.781140040e+05 -4.264812830e+02 1.631812121e+01 -1.271374903e-04 2.806715254e-08 -3.215166300e-12 1.488512118e-16 );
}

provenance
{
    dHf_298
    {
        origin        literature;
        method        "NASA/TP-2002-211556 appendix D, p. 169, entry PF4CL, record-line H(298.15) (elements reference, so = dHf)";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "Table B1 p. 26 prints -1364.909 kJ/mol; the report's own sources: Gurvich,1989 pt1 p439 pt2 p291.";
    }
    s_298
    {
        origin        literature;
        method        "NASA/TP-2002-211556 Table B1, p. 26, entry PF4CL";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "appendix D's coefficients with b2 integrate to 326.834";
    }
    idealGasHeatCapacity
    {
        origin        literature;
        method        "NASA/TP-2002-211556 appendix D, p. 169, entry PF4CL, a1..a7 of the 200-1000 K and 1000-6000 K intervals, as printed";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "read by bin/curate/nasa_tp2002_to_choupo.py, which holds H and S at 298.15 K to the printed values";
    }
    source   "McBride, Zehe & Gordon, NASA Glenn Coefficients for Calculating Thermodynamic Properties of Individual Species, NASA/TP-2002-211556 (2002)";
    licence  publicDomain;    // US government work (NASA), 17 U.S.C. 105
}
