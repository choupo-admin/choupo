/*--------------------------------*- Choupo -*-----------------------*\
  Species HCHO_formaldehy (NASA/TP-2002-211556 appendix D entry "HCHO,formaldehy"):
  ideal-gas formation data and heat capacity transcribed by machine with
  bin/curate/nasa_tp2002_to_choupo.py table, which holds H and S at
  298.15 K recomputed from the printed coefficients to the printed
  values.  Not read back against the page by a curator.
  The report's own description and sources: Hf:TRC(6/78) w-5300. Gurvich,1991 pt1 p62 pt2 p47.
\*---------------------------------------------------------------------------*/
name           HCHO_formaldehy;
formula        H2CO;
CAS            n/a;
MW             30.02598;       // kg/kmol, appendix D record line
role           gasData;       // closed-shell molecule (or noble gas): ideal-gas data only, no liquid model
tags           ( gasPhase thermoTable );
nasaEntry      "HCHO,formaldehy";
reviewStatus   interim;
reviewReason   "transcribed by machine from NASA/TP-2002-211556 into the thermoTables home and checked against the report itself; not yet read back against the page by a curator";
standardThermochemistry
{
    dHf_298    -108580.000;   // J/mol  -- ideal gas; NASA/TP-2002-211556 appendix D, p. 131, entry HCHO,formaldehy
    s_298      218.764;     // J/(mol·K) -- third-law absolute; Table B1, p. 21
}

idealGasHeatCapacity
{
    //  NASA/TP-2002-211556 eq. (1), Cp/R = a1/T^2 + a2/T + a3 + a4 T + a5 T^2
    //  + a6 T^3 + a7 T^4; appendix D, p. 131, entry HCHO,formaldehy, a1..a7 as printed.
    model    NASA9;
    Tlow     200;
    Tcommon  1000;
    Thigh    6000;
    low      ( -1.173916343e+05 1.873628846e+03 -6.890288570e+00 2.641561665e-02 -2.186389299e-05 1.005693006e-08 -2.023476949e-12 );
    high     ( 1.700825405e+06 -7.620853840e+03 1.472447547e+01 -1.649111754e-03 3.292144720e-07 -3.495049770e-11 1.526135000e-15 );
}

provenance
{
    dHf_298
    {
        origin        literature;
        method        "NASA/TP-2002-211556 appendix D, p. 131, entry HCHO,formaldehy, record-line H(298.15) (elements reference, so = dHf)";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "Table B1 p. 21 prints -108.58 kJ/mol; the report's own sources: Hf:TRC(6/78) w-5300. Gurvich,1991 pt1 p62 pt2 p47.";
    }
    s_298
    {
        origin        literature;
        method        "NASA/TP-2002-211556 Table B1, p. 21, entry HCHO,formaldehy";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "appendix D's coefficients with b2 integrate to 218.764";
    }
    idealGasHeatCapacity
    {
        origin        literature;
        method        "NASA/TP-2002-211556 appendix D, p. 131, entry HCHO,formaldehy, a1..a7 of the 200-1000 K and 1000-6000 K intervals, as printed";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "read by bin/curate/nasa_tp2002_to_choupo.py, which holds H and S at 298.15 K to the printed values";
    }
    source   "McBride, Zehe & Gordon, NASA Glenn Coefficients for Calculating Thermodynamic Properties of Individual Species, NASA/TP-2002-211556 (2002)";
    licence  publicDomain;    // US government work (NASA), 17 U.S.C. 105
}
