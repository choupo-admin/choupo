/*--------------------------------*- Choupo -*-----------------------*\
  Species BeOH (NASA/TP-2002-211556 appendix D entry "BeOH"):
  ideal-gas formation data and heat capacity transcribed by machine with
  bin/curate/nasa_tp2002_to_choupo.py table, which holds H and S at
  298.15 K recomputed from the printed coefficients to the printed
  values.  Not read back against the page by a curator.
  The report's own description and sources: Gurvich,1996a pt1 p358 pt2 p288.
\*---------------------------------------------------------------------------*/
name           BeOH;
formula        BeOH;
CAS            n/a;
MW             26.01952;       // kg/kmol, appendix D record line
role           gasOnly;       // free radical (odd electron count 13)
tags           ( gasPhase thermoTable );
nasaEntry      "BeOH";
reviewStatus   interim;
reviewReason   "transcribed by machine from NASA/TP-2002-211556 into the thermoTables home and checked against the report itself; not yet read back against the page by a curator";
standardThermochemistry
{
    dHf_298    -99717.721;   // J/mol  -- ideal gas; NASA/TP-2002-211556 appendix D, p. 71, entry BeOH
    s_298      217.058;     // J/(mol·K) -- third-law absolute; Table B1, p. 13
}

idealGasHeatCapacity
{
    //  NASA/TP-2002-211556 eq. (1), Cp/R = a1/T^2 + a2/T + a3 + a4 T + a5 T^2
    //  + a6 T^3 + a7 T^4; appendix D, p. 71, entry BeOH, a1..a7 as printed.
    model    NASA9;
    Tlow     200;
    Tcommon  1000;
    Thigh    6000;
    low      ( -3.853024520e+04 4.498059290e+02 1.532096459e+00 1.299912603e-02 -1.708979996e-05 1.169968182e-08 -3.163183710e-12 );
    high     ( 8.550330310e+05 -2.646537838e+03 8.204784630e+00 1.110814513e-05 -4.265364000e-08 7.926511920e-12 -4.645419520e-16 );
}

provenance
{
    dHf_298
    {
        origin        literature;
        method        "NASA/TP-2002-211556 appendix D, p. 71, entry BeOH, record-line H(298.15) (elements reference, so = dHf)";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "Table B1 p. 13 prints -99.718 kJ/mol; the report's own sources: Gurvich,1996a pt1 p358 pt2 p288.";
    }
    s_298
    {
        origin        literature;
        method        "NASA/TP-2002-211556 Table B1, p. 13, entry BeOH";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "appendix D's coefficients with b2 integrate to 217.058";
    }
    idealGasHeatCapacity
    {
        origin        literature;
        method        "NASA/TP-2002-211556 appendix D, p. 71, entry BeOH, a1..a7 of the 200-1000 K and 1000-6000 K intervals, as printed";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "read by bin/curate/nasa_tp2002_to_choupo.py, which holds H and S at 298.15 K to the printed values";
    }
    source   "McBride, Zehe & Gordon, NASA Glenn Coefficients for Calculating Thermodynamic Properties of Individual Species, NASA/TP-2002-211556 (2002)";
    licence  publicDomain;    // US government work (NASA), 17 U.S.C. 105
}
