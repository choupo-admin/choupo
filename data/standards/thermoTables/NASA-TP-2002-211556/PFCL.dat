/*--------------------------------*- Choupo -*-----------------------*\
  Species PFCL (NASA/TP-2002-211556 appendix D entry "PFCL"):
  ideal-gas formation data and heat capacity transcribed by machine with
  bin/curate/nasa_tp2002_to_choupo.py table, which holds H and S at
  298.15 K recomputed from the printed coefficients to the printed
  values.  Not read back against the page by a curator.
  The report's own description and sources: Gurvich,1989 pt1 p437 pt2 p288.
\*---------------------------------------------------------------------------*/
name           PFCL;
formula        PFCl;
CAS            n/a;
MW             85.42516;       // kg/kmol, appendix D record line
role           gasOnly;       // free radical (odd electron count 41)
tags           ( gasPhase thermoTable );
nasaEntry      "PFCL";
reviewStatus   interim;
reviewReason   "transcribed by machine from NASA/TP-2002-211556 into the thermoTables home and checked against the report itself; not yet read back against the page by a curator";
standardThermochemistry
{
    dHf_298    -283184.119;   // J/mol  -- ideal gas; NASA/TP-2002-211556 appendix D, p. 168, entry PFCL
    s_298      279.494;     // J/(mol·K) -- third-law absolute; Table B1, p. 26
}

idealGasHeatCapacity
{
    //  NASA/TP-2002-211556 eq. (1), Cp/R = a1/T^2 + a2/T + a3 + a4 T + a5 T^2
    //  + a6 T^3 + a7 T^4; appendix D, p. 168, entry PFCL, a1..a7 as printed.
    model    NASA9;
    Tlow     200;
    Tcommon  1000;
    Thigh    6000;
    low      ( 5.490188530e+04 -8.658679480e+02 7.944467650e+00 9.503779100e-04 -3.339090210e-06 3.023977817e-09 -9.450377540e-13 );
    high     ( -1.282143211e+05 -9.739043550e+01 7.072661660e+00 -2.903614134e-05 6.408504490e-09 -7.338993770e-13 3.396723170e-17 );
}

provenance
{
    dHf_298
    {
        origin        literature;
        method        "NASA/TP-2002-211556 appendix D, p. 168, entry PFCL, record-line H(298.15) (elements reference, so = dHf)";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "Table B1 p. 26 prints -283.184 kJ/mol; the report's own sources: Gurvich,1989 pt1 p437 pt2 p288.";
    }
    s_298
    {
        origin        literature;
        method        "NASA/TP-2002-211556 Table B1, p. 26, entry PFCL";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "appendix D's coefficients with b2 integrate to 279.494";
    }
    idealGasHeatCapacity
    {
        origin        literature;
        method        "NASA/TP-2002-211556 appendix D, p. 168, entry PFCL, a1..a7 of the 200-1000 K and 1000-6000 K intervals, as printed";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "read by bin/curate/nasa_tp2002_to_choupo.py, which holds H and S at 298.15 K to the printed values";
    }
    source   "McBride, Zehe & Gordon, NASA Glenn Coefficients for Calculating Thermodynamic Properties of Individual Species, NASA/TP-2002-211556 (2002)";
    licence  publicDomain;    // US government work (NASA), 17 U.S.C. 105
}
