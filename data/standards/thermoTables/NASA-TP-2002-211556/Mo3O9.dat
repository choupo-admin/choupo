/*--------------------------------*- Choupo -*-----------------------*\
  Species Mo3O9 (NASA/TP-2002-211556 appendix D entry "Mo3O9"):
  ideal-gas formation data and heat capacity transcribed by machine with
  bin/curate/nasa_tp2002_to_choupo.py table, which holds H and S at
  298.15 K recomputed from the printed coefficients to the printed
  values.  Not read back against the page by a curator.
  The report's own description and sources: Gurvich,1982 pt1 p34 pt2 p38.
\*---------------------------------------------------------------------------*/
name           Mo3O9;
formula        Mo3O9;
CAS            n/a;
MW             431.8146;       // kg/kmol, appendix D record line
role           nonvolatile;   // ideal-gas species: no vapour pressure is asked of it
tags           ( gasPhase thermoTable );
nasaEntry      "Mo3O9";
reviewStatus   interim;
reviewReason   "transcribed by machine from NASA/TP-2002-211556 into the thermoTables home and checked against the report itself; not yet read back against the page by a curator";
standardThermochemistry
{
    dHf_298    -1902031.349;   // J/mol  -- ideal gas; NASA/TP-2002-211556 appendix D, p. 152, entry Mo3O9
    s_298      508.711;     // J/(mol·K) -- third-law absolute; Table B1, p. 24
}

idealGasHeatCapacity
{
    //  NASA/TP-2002-211556 eq. (1), Cp/R = a1/T^2 + a2/T + a3 + a4 T + a5 T^2
    //  + a6 T^3 + a7 T^4; appendix D, p. 152, entry Mo3O9, a1..a7 as printed.
    model    NASA9;
    Tlow     200;
    Tcommon  1000;
    Thigh    6000;
    low      ( 1.483386187e+05 -1.863895133e+03 1.738405871e+01 6.233012320e-02 -9.328441350e-05 6.613638790e-08 -1.830607518e-11 );
    high     ( -9.230290540e+05 -1.076171759e+03 3.480007260e+01 -3.189633800e-04 7.028397040e-08 -8.039642640e-12 3.717879530e-16 );
}

provenance
{
    dHf_298
    {
        origin        literature;
        method        "NASA/TP-2002-211556 appendix D, p. 152, entry Mo3O9, record-line H(298.15) (elements reference, so = dHf)";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "Table B1 p. 24 prints -1902.031 kJ/mol; the report's own sources: Gurvich,1982 pt1 p34 pt2 p38.";
    }
    s_298
    {
        origin        literature;
        method        "NASA/TP-2002-211556 Table B1, p. 24, entry Mo3O9";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "appendix D's coefficients with b2 integrate to 508.711";
    }
    idealGasHeatCapacity
    {
        origin        literature;
        method        "NASA/TP-2002-211556 appendix D, p. 152, entry Mo3O9, a1..a7 of the 200-1000 K and 1000-6000 K intervals, as printed";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "read by bin/curate/nasa_tp2002_to_choupo.py, which holds H and S at 298.15 K to the printed values";
    }
    source   "McBride, Zehe & Gordon, NASA Glenn Coefficients for Calculating Thermodynamic Properties of Individual Species, NASA/TP-2002-211556 (2002)";
    licence  publicDomain;    // US government work (NASA), 17 U.S.C. 105
}
