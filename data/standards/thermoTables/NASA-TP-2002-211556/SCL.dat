/*--------------------------------*- Choupo -*-----------------------*\
  Species SCL (NASA/TP-2002-211556 appendix D entry "SCL"):
  ideal-gas formation data and heat capacity transcribed by machine with
  bin/curate/nasa_tp2002_to_choupo.py table, which holds H and S at
  298.15 K recomputed from the printed coefficients to the printed
  values.  Not read back against the page by a curator.
  The report's own description and sources: Chase,1998 p803.
\*---------------------------------------------------------------------------*/
name           SCL;
formula        SCl;
CAS            n/a;
MW             67.51;       // kg/kmol, = sum of the engine's atomic weights (C517; was 67.518)
role           gasOnly;       // free radical (odd electron count 33)
tags           ( gasPhase thermoTable );
nasaEntry      "SCL";
reviewStatus   interim;
reviewReason   "transcribed by machine from NASA/TP-2002-211556 into the thermoTables home and checked against the report itself; not yet read back against the page by a curator";
standardThermochemistry
{
    dHf_298    156465.000;   // J/mol  -- ideal gas; NASA/TP-2002-211556 appendix D, p. 179, entry SCL
    s_298      237.328;     // J/(mol·K) -- third-law absolute; Table B1, p. 28
}

idealGasHeatCapacity
{
    //  NASA/TP-2002-211556 eq. (1), Cp/R = a1/T^2 + a2/T + a3 + a4 T + a5 T^2
    //  + a6 T^3 + a7 T^4; appendix D, p. 179, entry SCL, a1..a7 as printed.
    model    NASA9;
    Tlow     200;
    Tcommon  1000;
    Thigh    6000;
    low      ( 1.613051454e+04 -5.606249550e+02 8.064931130e+00 -9.186326400e-03 1.224205395e-05 -8.209562020e-09 2.205087197e-12 );
    high     ( -9.405123450e+04 3.629760850e+02 4.069959360e+00 3.034029742e-04 -8.248301390e-08 1.252700734e-11 -6.417463650e-16 );
}

provenance
{
    dHf_298
    {
        origin        literature;
        method        "NASA/TP-2002-211556 appendix D, p. 179, entry SCL, record-line H(298.15) (elements reference, so = dHf)";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "Table B1 p. 28 prints 156.465 kJ/mol; the report's own sources: Chase,1998 p803.";
    }
    s_298
    {
        origin        literature;
        method        "NASA/TP-2002-211556 Table B1, p. 28, entry SCL";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "appendix D's coefficients with b2 integrate to 237.328";
    }
    idealGasHeatCapacity
    {
        origin        literature;
        method        "NASA/TP-2002-211556 appendix D, p. 179, entry SCL, a1..a7 of the 200-1000 K and 1000-6000 K intervals, as printed";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "read by bin/curate/nasa_tp2002_to_choupo.py, which holds H and S at 298.15 K to the printed values";
    }
    source   "McBride, Zehe & Gordon, NASA Glenn Coefficients for Calculating Thermodynamic Properties of Individual Species, NASA/TP-2002-211556 (2002)";
    licence  publicDomain;    // US government work (NASA), 17 U.S.C. 105
}
