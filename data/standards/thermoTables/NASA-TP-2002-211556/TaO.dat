/*--------------------------------*- Choupo -*-----------------------*\
  Species TaO (NASA/TP-2002-211556 appendix D entry "TaO"):
  ideal-gas formation data and heat capacity transcribed by machine with
  bin/curate/nasa_tp2002_to_choupo.py table, which holds H and S at
  298.15 K recomputed from the printed coefficients to the printed
  values.  Not read back against the page by a curator.
  The report's own description and sources: Gurvich,1982 pt1 p86 pt2 p89.
\*---------------------------------------------------------------------------*/
name           TaO;
formula        TaO;
CAS            n/a;
MW             196.9473;       // kg/kmol, appendix D record line
role           gasData;       // odd-electron d-block/actinide compound: stable, has condensed phases (not a radical)
tags           ( gasPhase thermoTable );
nasaEntry      "TaO";
reviewStatus   interim;
reviewReason   "transcribed by machine from NASA/TP-2002-211556 into the thermoTables home and checked against the report itself; not yet read back against the page by a curator";
standardThermochemistry
{
    dHf_298    242534.705;   // J/mol  -- ideal gas; NASA/TP-2002-211556 appendix D, p. 199, entry TaO
    s_298      241.118;     // J/(mol·K) -- third-law absolute; Table B1, p. 30
}

idealGasHeatCapacity
{
    //  NASA/TP-2002-211556 eq. (1), Cp/R = a1/T^2 + a2/T + a3 + a4 T + a5 T^2
    //  + a6 T^3 + a7 T^4; appendix D, p. 199, entry TaO, a1..a7 as printed.
    //  The report's 6000-20000 K interval is not transcribed.
    model    NASA9;
    Tlow     200;
    Tcommon  1000;
    Thigh    6000;
    low      ( -1.395738049e+04 3.945236990e+02 -6.301696410e-02 1.308595441e-02 -1.862339730e-05 1.366155583e-08 -3.924551230e-12 );
    high     ( 6.106591120e+06 -1.984135246e+04 2.815797433e+01 -1.330045882e-02 3.876807490e-06 -5.068872770e-10 2.443666035e-14 );
}

provenance
{
    dHf_298
    {
        origin        literature;
        method        "NASA/TP-2002-211556 appendix D, p. 199, entry TaO, record-line H(298.15) (elements reference, so = dHf)";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "Table B1 p. 30 prints 242.535 kJ/mol; the report's own sources: Gurvich,1982 pt1 p86 pt2 p89.";
    }
    s_298
    {
        origin        literature;
        method        "NASA/TP-2002-211556 Table B1, p. 30, entry TaO";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "appendix D's coefficients with b2 integrate to 241.118";
    }
    idealGasHeatCapacity
    {
        origin        literature;
        method        "NASA/TP-2002-211556 appendix D, p. 199, entry TaO, a1..a7 of the 200-1000 K and 1000-6000 K intervals, as printed";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "read by bin/curate/nasa_tp2002_to_choupo.py, which holds H and S at 298.15 K to the printed values";
    }
    source   "McBride, Zehe & Gordon, NASA Glenn Coefficients for Calculating Thermodynamic Properties of Individual Species, NASA/TP-2002-211556 (2002)";
    licence  publicDomain;    // US government work (NASA), 17 U.S.C. 105
}
