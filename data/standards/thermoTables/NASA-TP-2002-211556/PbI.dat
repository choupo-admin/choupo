/*--------------------------------*- Choupo -*-----------------------*\
  Species PbI (NASA/TP-2002-211556 appendix D entry "PbI"):
  ideal-gas formation data and heat capacity transcribed by machine with
  bin/curate/nasa_tp2002_to_choupo.py table, which holds H and S at
  298.15 K recomputed from the printed coefficients to the printed
  values.  Not read back against the page by a curator.
  The report's own description and sources: Gurvich,1991 pt1 p440 pt2 p365.
\*---------------------------------------------------------------------------*/
name           PbI;
formula        PbI;
CAS            n/a;
MW             334.1045;       // kg/kmol, appendix D record line
role           gasOnly;       // free radical (odd electron count 135)
tags           ( gasPhase thermoTable );
nasaEntry      "PbI";
reviewStatus   interim;
reviewReason   "transcribed by machine from NASA/TP-2002-211556 into the thermoTables home and checked against the report itself; not yet read back against the page by a curator";
standardThermochemistry
{
    dHf_298    108904.324;   // J/mol  -- ideal gas; NASA/TP-2002-211556 appendix D, p. 174, entry PbI
    s_298      280.413;     // J/(mol·K) -- third-law absolute; Table B1, p. 27
}

idealGasHeatCapacity
{
    //  NASA/TP-2002-211556 eq. (1), Cp/R = a1/T^2 + a2/T + a3 + a4 T + a5 T^2
    //  + a6 T^3 + a7 T^4; appendix D, p. 174, entry PbI, a1..a7 as printed.
    model    NASA9;
    Tlow     200;
    Tcommon  1000;
    Thigh    6000;
    low      ( -2.717334060e+03 -1.542541996e+01 4.565327900e+00 -1.061215818e-04 2.414841342e-07 -1.876070301e-10 6.460614270e-14 );
    high     ( -3.901070250e+06 1.147976718e+04 -8.176109020e+00 6.523454700e-03 -1.522611682e-06 1.626692202e-10 -6.553328880e-15 );
}

provenance
{
    dHf_298
    {
        origin        literature;
        method        "NASA/TP-2002-211556 appendix D, p. 174, entry PbI, record-line H(298.15) (elements reference, so = dHf)";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "Table B1 p. 27 prints 108.904 kJ/mol; the report's own sources: Gurvich,1991 pt1 p440 pt2 p365.";
    }
    s_298
    {
        origin        literature;
        method        "NASA/TP-2002-211556 Table B1, p. 27, entry PbI";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "appendix D's coefficients with b2 integrate to 280.413";
    }
    idealGasHeatCapacity
    {
        origin        literature;
        method        "NASA/TP-2002-211556 appendix D, p. 174, entry PbI, a1..a7 of the 200-1000 K and 1000-6000 K intervals, as printed";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "read by bin/curate/nasa_tp2002_to_choupo.py, which holds H and S at 298.15 K to the printed values";
    }
    source   "McBride, Zehe & Gordon, NASA Glenn Coefficients for Calculating Thermodynamic Properties of Individual Species, NASA/TP-2002-211556 (2002)";
    licence  publicDomain;    // US government work (NASA), 17 U.S.C. 105
}
