/*--------------------------------*- Choupo -*-----------------------*\
  Species Ga2Br6 (NASA/TP-2002-211556 appendix D entry "Ga2Br6"):
  ideal-gas formation data and heat capacity transcribed by machine with
  bin/curate/nasa_tp2002_to_choupo.py table, which holds H and S at
  298.15 K recomputed from the printed coefficients to the printed
  values.  Not read back against the page by a curator.
  The report's own description and sources: Gurvich,1996a pt1 p246 pt2 p199.
\*---------------------------------------------------------------------------*/
name           Ga2Br6;
formula        Ga2Br6;
CAS            n/a;
MW             618.87;       // kg/kmol, appendix D record line
role           nonvolatile;   // ideal-gas species: no vapour pressure is asked of it
tags           ( gasPhase thermoTable );
nasaEntry      "Ga2Br6";
reviewStatus   interim;
reviewReason   "transcribed by machine from NASA/TP-2002-211556 into the thermoTables home and checked against the report itself; not yet read back against the page by a curator";
standardThermochemistry
{
    dHf_298    -673688.732;   // J/mol  -- ideal gas; NASA/TP-2002-211556 appendix D, p. 122, entry Ga2Br6
    s_298      568.127;     // J/(mol·K) -- third-law absolute; Table B1, p. 20
}

idealGasHeatCapacity
{
    //  NASA/TP-2002-211556 eq. (1), Cp/R = a1/T^2 + a2/T + a3 + a4 T + a5 T^2
    //  + a6 T^3 + a7 T^4; appendix D, p. 122, entry Ga2Br6, a1..a7 as printed.
    model    NASA9;
    Tlow     200;
    Tcommon  1000;
    Thigh    6000;
    low      ( -6.725116890e+03 -8.067526550e+02 2.511671424e+01 -6.636514570e-03 7.977555700e-06 -5.059685210e-09 1.313546388e-12 );
    high     ( -9.526173000e+04 -1.444681880e+01 2.201192546e+01 -5.145006740e-06 1.204348449e-09 -1.443806473e-13 6.928270740e-18 );
}

provenance
{
    dHf_298
    {
        origin        literature;
        method        "NASA/TP-2002-211556 appendix D, p. 122, entry Ga2Br6, record-line H(298.15) (elements reference, so = dHf)";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "Table B1 p. 20 prints -673.689 kJ/mol; the report's own sources: Gurvich,1996a pt1 p246 pt2 p199.";
    }
    s_298
    {
        origin        literature;
        method        "NASA/TP-2002-211556 Table B1, p. 20, entry Ga2Br6";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "appendix D's coefficients with b2 integrate to 568.127";
    }
    idealGasHeatCapacity
    {
        origin        literature;
        method        "NASA/TP-2002-211556 appendix D, p. 122, entry Ga2Br6, a1..a7 of the 200-1000 K and 1000-6000 K intervals, as printed";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "read by bin/curate/nasa_tp2002_to_choupo.py, which holds H and S at 298.15 K to the printed values";
    }
    source   "McBride, Zehe & Gordon, NASA Glenn Coefficients for Calculating Thermodynamic Properties of Individual Species, NASA/TP-2002-211556 (2002)";
    licence  publicDomain;    // US government work (NASA), 17 U.S.C. 105
}
