/*--------------------------------*- Choupo -*-----------------------*\
  Species PbF3 (NASA/TP-2002-211556 appendix D entry "PbF3"):
  ideal-gas formation data and heat capacity transcribed by machine with
  bin/curate/nasa_tp2002_to_choupo.py table, which holds H and S at
  298.15 K recomputed from the printed coefficients to the printed
  values.  Not read back against the page by a curator.
  The report's own description and sources: Gurvich,1991 pt1 p425 pt2 p353.
\*---------------------------------------------------------------------------*/
name           PbF3;
formula        PbF3;
CAS            n/a;
MW             264.1952;       // kg/kmol, appendix D record line
role           gasOnly;       // free radical (odd electron count 109)
tags           ( gasPhase thermoTable );
nasaEntry      "PbF3";
reviewStatus   interim;
reviewReason   "transcribed by machine from NASA/TP-2002-211556 into the thermoTables home and checked against the report itself; not yet read back against the page by a curator";
standardThermochemistry
{
    dHf_298    -489572.613;   // J/mol  -- ideal gas; NASA/TP-2002-211556 appendix D, p. 174, entry PbF3
    s_298      316.287;     // J/(mol·K) -- third-law absolute; Table B1, p. 27
}

idealGasHeatCapacity
{
    //  NASA/TP-2002-211556 eq. (1), Cp/R = a1/T^2 + a2/T + a3 + a4 T + a5 T^2
    //  + a6 T^3 + a7 T^4; appendix D, p. 174, entry PbF3, a1..a7 as printed.
    model    NASA9;
    Tlow     200;
    Tcommon  1000;
    Thigh    6000;
    low      ( 8.553090870e+04 -1.731036694e+03 1.556596150e+01 -1.022225919e-02 1.089984998e-05 -6.269998820e-09 1.502616508e-12 );
    high     ( -1.459704258e+05 -4.820396430e+01 1.003685845e+01 -1.501095764e-05 3.362474990e-09 -3.896020710e-13 1.820152103e-17 );
}

provenance
{
    dHf_298
    {
        origin        literature;
        method        "NASA/TP-2002-211556 appendix D, p. 174, entry PbF3, record-line H(298.15) (elements reference, so = dHf)";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "Table B1 p. 27 prints -489.573 kJ/mol; the report's own sources: Gurvich,1991 pt1 p425 pt2 p353.";
    }
    s_298
    {
        origin        literature;
        method        "NASA/TP-2002-211556 Table B1, p. 27, entry PbF3";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "appendix D's coefficients with b2 integrate to 316.287";
    }
    idealGasHeatCapacity
    {
        origin        literature;
        method        "NASA/TP-2002-211556 appendix D, p. 174, entry PbF3, a1..a7 of the 200-1000 K and 1000-6000 K intervals, as printed";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "read by bin/curate/nasa_tp2002_to_choupo.py, which holds H and S at 298.15 K to the printed values";
    }
    source   "McBride, Zehe & Gordon, NASA Glenn Coefficients for Calculating Thermodynamic Properties of Individual Species, NASA/TP-2002-211556 (2002)";
    licence  publicDomain;    // US government work (NASA), 17 U.S.C. 105
}
