/*--------------------------------*- Choupo -*-----------------------*\
  Species ZrO2 (NASA/TP-2002-211556 appendix D entry "ZrO2"):
  ideal-gas formation data and heat capacity transcribed by machine with
  bin/curate/nasa_tp2002_to_choupo.py table, which holds H and S at
  298.15 K recomputed from the printed coefficients to the printed
  values.  Not read back against the page by a curator.
  The report's own description and sources: Gurvich,1982 pt1 p125. Chase,1998 p1772 12/65.
\*---------------------------------------------------------------------------*/
name           ZrO2;
formula        ZrO2;
CAS            n/a;
MW             123.2228;       // kg/kmol, appendix D record line
role           gasData;       // closed-shell molecule (or noble gas): ideal-gas data only, no liquid model
tags           ( gasPhase thermoTable );
nasaEntry      "ZrO2";
reviewStatus   interim;
reviewReason   "transcribed by machine from NASA/TP-2002-211556 into the thermoTables home and checked against the report itself; not yet read back against the page by a curator";
standardThermochemistry
{
    dHf_298    -317042.737;   // J/mol  -- ideal gas; NASA/TP-2002-211556 appendix D, p. 210, entry ZrO2
    s_298      273.750;     // J/(mol·K) -- third-law absolute; Table B1, p. 32
}

idealGasHeatCapacity
{
    //  NASA/TP-2002-211556 eq. (1), Cp/R = a1/T^2 + a2/T + a3 + a4 T + a5 T^2
    //  + a6 T^3 + a7 T^4; appendix D, p. 210, entry ZrO2, a1..a7 as printed.
    model    NASA9;
    Tlow     200;
    Tcommon  1000;
    Thigh    6000;
    low      ( 3.637649000e+04 -2.620658297e+02 3.692866870e+00 1.214524156e-02 -1.822445342e-05 1.299215204e-08 -3.615900110e-12 );
    high     ( 2.854363887e+06 -8.738589890e+03 1.621315114e+01 -4.417922830e-03 8.959096920e-07 -4.054667110e-11 -2.147732083e-15 );
}

provenance
{
    dHf_298
    {
        origin        literature;
        method        "NASA/TP-2002-211556 appendix D, p. 210, entry ZrO2, record-line H(298.15) (elements reference, so = dHf)";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "Table B1 p. 32 prints -317.043 kJ/mol; the report's own sources: Gurvich,1982 pt1 p125. Chase,1998 p1772 12/65.";
    }
    s_298
    {
        origin        literature;
        method        "NASA/TP-2002-211556 Table B1, p. 32, entry ZrO2";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "appendix D's coefficients with b2 integrate to 273.750";
    }
    idealGasHeatCapacity
    {
        origin        literature;
        method        "NASA/TP-2002-211556 appendix D, p. 210, entry ZrO2, a1..a7 of the 200-1000 K and 1000-6000 K intervals, as printed";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "read by bin/curate/nasa_tp2002_to_choupo.py, which holds H and S at 298.15 K to the printed values";
    }
    source   "McBride, Zehe & Gordon, NASA Glenn Coefficients for Calculating Thermodynamic Properties of Individual Species, NASA/TP-2002-211556 (2002)";
    licence  publicDomain;    // US government work (NASA), 17 U.S.C. 105
}
