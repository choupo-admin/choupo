/*--------------------------------*- Choupo -*-----------------------*\
  Species BOCL2 (NASA/TP-2002-211556 appendix D entry "BOCL2"):
  ideal-gas formation data and heat capacity transcribed by machine with
  bin/curate/nasa_tp2002_to_choupo.py table, which holds H and S at
  298.15 K recomputed from the printed coefficients to the printed
  values.  Not read back against the page by a curator.
  The report's own description and sources: Gurvich,1996a pt1 p79 pt2 p56.
\*---------------------------------------------------------------------------*/
name           BOCL2;
formula        BOCl2;
CAS            n/a;
MW             97.7164;       // kg/kmol, appendix D record line
role           gasOnly;       // free radical (odd electron count 47)
tags           ( gasPhase thermoTable );
nasaEntry      "BOCL2";
reviewStatus   interim;
reviewReason   "transcribed by machine from NASA/TP-2002-211556 into the thermoTables home and checked against the report itself; not yet read back against the page by a curator";
standardThermochemistry
{
    dHf_298    -361565.512;   // J/mol  -- ideal gas; NASA/TP-2002-211556 appendix D, p. 61, entry BOCL2
    s_298      292.296;     // J/(mol·K) -- third-law absolute; Table B1, p. 11
}

idealGasHeatCapacity
{
    //  NASA/TP-2002-211556 eq. (1), Cp/R = a1/T^2 + a2/T + a3 + a4 T + a5 T^2
    //  + a6 T^3 + a7 T^4; appendix D, p. 61, entry BOCL2, a1..a7 as printed.
    model    NASA9;
    Tlow     200;
    Tcommon  1000;
    Thigh    6000;
    low      ( 7.322667360e+03 -2.027726965e+02 4.161924090e+00 1.733309456e-02 -2.263908718e-05 1.452275190e-08 -3.719593120e-12 );
    high     ( -2.297527041e+05 -6.194567930e+02 1.046075518e+01 -1.841620739e-04 4.071215430e-08 -4.672246550e-12 2.167237536e-16 );
}

provenance
{
    dHf_298
    {
        origin        literature;
        method        "NASA/TP-2002-211556 appendix D, p. 61, entry BOCL2, record-line H(298.15) (elements reference, so = dHf)";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "Table B1 p. 11 prints -361.566 kJ/mol; the report's own sources: Gurvich,1996a pt1 p79 pt2 p56.";
    }
    s_298
    {
        origin        literature;
        method        "NASA/TP-2002-211556 Table B1, p. 11, entry BOCL2";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "appendix D's coefficients with b2 integrate to 292.296";
    }
    idealGasHeatCapacity
    {
        origin        literature;
        method        "NASA/TP-2002-211556 appendix D, p. 61, entry BOCL2, a1..a7 of the 200-1000 K and 1000-6000 K intervals, as printed";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "read by bin/curate/nasa_tp2002_to_choupo.py, which holds H and S at 298.15 K to the printed values";
    }
    source   "McBride, Zehe & Gordon, NASA Glenn Coefficients for Calculating Thermodynamic Properties of Individual Species, NASA/TP-2002-211556 (2002)";
    licence  publicDomain;    // US government work (NASA), 17 U.S.C. 105
}
