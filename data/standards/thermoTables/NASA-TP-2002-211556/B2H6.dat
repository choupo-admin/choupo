/*--------------------------------*- Choupo -*-----------------------*\
  Species B2H6 (NASA/TP-2002-211556 appendix D entry "B2H6"):
  ideal-gas formation data and heat capacity transcribed by machine with
  bin/curate/nasa_tp2002_to_choupo.py table, which holds H and S at
  298.15 K recomputed from the printed coefficients to the printed
  values.  Not read back against the page by a curator.
  The report's own description and sources: Hf:Gurvich,1996a pt1 p37. Yu,1998. Duncan,1985.
\*---------------------------------------------------------------------------*/
name           B2H6;
formula        B2H6;
CAS            n/a;
MW             27.66964;       // kg/kmol, appendix D record line
role           gasData;       // closed-shell molecule (or noble gas): ideal-gas data only, no liquid model
tags           ( gasPhase thermoTable );
nasaEntry      "B2H6";
reviewStatus   interim;
reviewReason   "transcribed by machine from NASA/TP-2002-211556 into the thermoTables home and checked against the report itself; not yet read back against the page by a curator";
standardThermochemistry
{
    dHf_298    36600.000;   // J/mol  -- ideal gas; NASA/TP-2002-211556 appendix D, p. 64, entry B2H6
    s_298      232.027;     // J/(mol·K) -- third-law absolute; Table B1, p. 11
}

idealGasHeatCapacity
{
    //  NASA/TP-2002-211556 eq. (1), Cp/R = a1/T^2 + a2/T + a3 + a4 T + a5 T^2
    //  + a6 T^3 + a7 T^4; appendix D, p. 64, entry B2H6, a1..a7 as printed.
    model    NASA9;
    Tlow     200;
    Tcommon  1000;
    Thigh    6000;
    low      ( -1.052844558e+04 1.041795556e+03 -8.960518860e+00 5.492480880e-02 -5.305197050e-05 3.011904756e-08 -7.688768300e-12 );
    high     ( 2.835765414e+06 -1.567600163e+04 3.226122330e+01 -3.738609730e-03 7.718806460e-07 -8.414454540e-11 3.752223380e-15 );
}

provenance
{
    dHf_298
    {
        origin        literature;
        method        "NASA/TP-2002-211556 appendix D, p. 64, entry B2H6, record-line H(298.15) (elements reference, so = dHf)";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "Table B1 p. 11 prints 36.6 kJ/mol; the report's own sources: Hf:Gurvich,1996a pt1 p37. Yu,1998. Duncan,1985.";
    }
    s_298
    {
        origin        literature;
        method        "NASA/TP-2002-211556 Table B1, p. 11, entry B2H6";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "appendix D's coefficients with b2 integrate to 232.027";
    }
    idealGasHeatCapacity
    {
        origin        literature;
        method        "NASA/TP-2002-211556 appendix D, p. 64, entry B2H6, a1..a7 of the 200-1000 K and 1000-6000 K intervals, as printed";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "read by bin/curate/nasa_tp2002_to_choupo.py, which holds H and S at 298.15 K to the printed values";
    }
    source   "McBride, Zehe & Gordon, NASA Glenn Coefficients for Calculating Thermodynamic Properties of Individual Species, NASA/TP-2002-211556 (2002)";
    licence  publicDomain;    // US government work (NASA), 17 U.S.C. 105
}
