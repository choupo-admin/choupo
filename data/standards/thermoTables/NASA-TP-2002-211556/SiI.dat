/*--------------------------------*- Choupo -*-----------------------*\
  Species SiI (NASA/TP-2002-211556 appendix D entry "SiI"):
  ideal-gas formation data and heat capacity transcribed by machine with
  bin/curate/nasa_tp2002_to_choupo.py table, which holds H and S at
  298.15 K recomputed from the printed coefficients to the printed
  values.  Not read back against the page by a curator.
  The report's own description and sources: Gurvich,1991 pt1 p284 pt2 p253.
\*---------------------------------------------------------------------------*/
name           SiI;
formula        SiI;
CAS            n/a;
MW             154.99;       // kg/kmol, appendix D record line
role           gasOnly;       // free radical (odd electron count 67)
tags           ( gasPhase thermoTable );
nasaEntry      "SiI";
reviewStatus   interim;
reviewReason   "transcribed by machine from NASA/TP-2002-211556 into the thermoTables home and checked against the report itself; not yet read back against the page by a curator";
standardThermochemistry
{
    dHf_298    262953.420;   // J/mol  -- ideal gas; NASA/TP-2002-211556 appendix D, p. 191, entry SiI
    s_298      253.881;     // J/(mol·K) -- third-law absolute; Table B1, p. 29
}

idealGasHeatCapacity
{
    //  NASA/TP-2002-211556 eq. (1), Cp/R = a1/T^2 + a2/T + a3 + a4 T + a5 T^2
    //  + a6 T^3 + a7 T^4; appendix D, p. 191, entry SiI, a1..a7 as printed.
    model    NASA9;
    Tlow     200;
    Tcommon  1000;
    Thigh    6000;
    low      ( 9.492081340e+04 -1.573960062e+03 1.237908109e+01 -1.593864820e-02 1.692049005e-05 -9.215558320e-09 2.046186848e-12 );
    high     ( 8.529402790e+05 -2.442039471e+03 7.722977520e+00 -1.985601243e-03 6.542866630e-07 -9.494158290e-11 4.890041370e-15 );
}

provenance
{
    dHf_298
    {
        origin        literature;
        method        "NASA/TP-2002-211556 appendix D, p. 191, entry SiI, record-line H(298.15) (elements reference, so = dHf)";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "Table B1 p. 29 prints 262.953 kJ/mol; the report's own sources: Gurvich,1991 pt1 p284 pt2 p253.";
    }
    s_298
    {
        origin        literature;
        method        "NASA/TP-2002-211556 Table B1, p. 29, entry SiI";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "appendix D's coefficients with b2 integrate to 253.881";
    }
    idealGasHeatCapacity
    {
        origin        literature;
        method        "NASA/TP-2002-211556 appendix D, p. 191, entry SiI, a1..a7 of the 200-1000 K and 1000-6000 K intervals, as printed";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "read by bin/curate/nasa_tp2002_to_choupo.py, which holds H and S at 298.15 K to the printed values";
    }
    source   "McBride, Zehe & Gordon, NASA Glenn Coefficients for Calculating Thermodynamic Properties of Individual Species, NASA/TP-2002-211556 (2002)";
    licence  publicDomain;    // US government work (NASA), 17 U.S.C. 105
}
