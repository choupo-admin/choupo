/*--------------------------------*- Choupo -*-----------------------*\
  Species RbO (NASA/TP-2002-211556 appendix D entry "RbO"):
  ideal-gas formation data and heat capacity transcribed by machine with
  bin/curate/nasa_tp2002_to_choupo.py table, which holds H and S at
  298.15 K recomputed from the printed coefficients to the printed
  values.  Not read back against the page by a curator.
  The report's own description and sources: Gurvich,1982 pt1 p429 pt2 p452.
\*---------------------------------------------------------------------------*/
name           RbO;
formula        RbO;
CAS            n/a;
MW             101.4672;       // kg/kmol, appendix D record line
role           nonvolatile;   // ideal-gas species: no vapour pressure is asked of it
tags           ( gasPhase thermoTable );
nasaEntry      "RbO";
reviewStatus   interim;
reviewReason   "transcribed by machine from NASA/TP-2002-211556 into the thermoTables home and checked against the report itself; not yet read back against the page by a curator";
standardThermochemistry
{
    dHf_298    52489.324;   // J/mol  -- ideal gas; NASA/TP-2002-211556 appendix D, p. 177, entry RbO
    s_298      244.913;     // J/(mol·K) -- third-law absolute; Table B1, p. 27
}

idealGasHeatCapacity
{
    //  NASA/TP-2002-211556 eq. (1), Cp/R = a1/T^2 + a2/T + a3 + a4 T + a5 T^2
    //  + a6 T^3 + a7 T^4; appendix D, p. 177, entry RbO, a1..a7 as printed.
    model    NASA9;
    Tlow     200;
    Tcommon  1000;
    Thigh    6000;
    low      ( 1.900081316e+05 -3.428228990e+03 2.480251273e+01 -5.051654580e-02 6.476338760e-05 -4.198012420e-08 1.093889043e-11 );
    high     ( 6.170756880e+05 -2.175089620e+03 8.290412210e+00 -2.996487663e-03 1.233144275e-06 -2.115810631e-10 1.242607430e-14 );
}

provenance
{
    dHf_298
    {
        origin        literature;
        method        "NASA/TP-2002-211556 appendix D, p. 177, entry RbO, record-line H(298.15) (elements reference, so = dHf)";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "Table B1 p. 27 prints 52.489 kJ/mol; the report's own sources: Gurvich,1982 pt1 p429 pt2 p452.";
    }
    s_298
    {
        origin        literature;
        method        "NASA/TP-2002-211556 Table B1, p. 27, entry RbO";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "appendix D's coefficients with b2 integrate to 244.913";
    }
    idealGasHeatCapacity
    {
        origin        literature;
        method        "NASA/TP-2002-211556 appendix D, p. 177, entry RbO, a1..a7 of the 200-1000 K and 1000-6000 K intervals, as printed";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "read by bin/curate/nasa_tp2002_to_choupo.py, which holds H and S at 298.15 K to the printed values";
    }
    source   "McBride, Zehe & Gordon, NASA Glenn Coefficients for Calculating Thermodynamic Properties of Individual Species, NASA/TP-2002-211556 (2002)";
    licence  publicDomain;    // US government work (NASA), 17 U.S.C. 105
}
