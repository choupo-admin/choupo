/*--------------------------------*- Choupo -*-----------------------*\
  Species Cs2F2 (NASA/TP-2002-211556 appendix D entry "Cs2F2"):
  ideal-gas formation data and heat capacity transcribed by machine with
  bin/curate/nasa_tp2002_to_choupo.py table, which holds H and S at
  298.15 K recomputed from the printed coefficients to the printed
  values.  Not read back against the page by a curator.
  The report's own description and sources: Gurvich,1982 pt1 p484 pt2 p507.
\*---------------------------------------------------------------------------*/
name           Cs2F2;
formula        Cs2F2;
CAS            n/a;
MW             303.8077;       // kg/kmol, appendix D record line
role           radical;       // gas-only (DEV.md 4c C458): stays in the vapour, refused where no vapour holds it
tags           ( gasPhase thermoTable );
nasaEntry      "Cs2F2";
reviewStatus   interim;
reviewReason   "transcribed by machine from NASA/TP-2002-211556 into the thermoTables home and checked against the report itself; not yet read back against the page by a curator";
standardThermochemistry
{
    dHf_298    -891858.506;   // J/mol  -- ideal gas; NASA/TP-2002-211556 appendix D, p. 112, entry Cs2F2
    s_298      358.063;     // J/(mol·K) -- third-law absolute; Table B1, p. 18
}

idealGasHeatCapacity
{
    //  NASA/TP-2002-211556 eq. (1), Cp/R = a1/T^2 + a2/T + a3 + a4 T + a5 T^2
    //  + a6 T^3 + a7 T^4; appendix D, p. 112, entry Cs2F2, a1..a7 as printed.
    model    NASA9;
    Tlow     200;
    Tcommon  1000;
    Thigh    6000;
    low      ( -9.942677480e+03 -2.536723355e+02 1.100684073e+01 -2.185640152e-03 2.664791874e-06 -1.708229209e-09 4.471151980e-13 );
    high     ( -3.677946420e+04 -4.355753480e+00 1.000366687e+01 -1.603814186e-06 3.791469740e-10 -4.578687430e-14 2.209385787e-18 );
}

provenance
{
    dHf_298
    {
        origin        literature;
        method        "NASA/TP-2002-211556 appendix D, p. 112, entry Cs2F2, record-line H(298.15) (elements reference, so = dHf)";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "Table B1 p. 18 prints -891.859 kJ/mol; the report's own sources: Gurvich,1982 pt1 p484 pt2 p507.";
    }
    s_298
    {
        origin        literature;
        method        "NASA/TP-2002-211556 Table B1, p. 18, entry Cs2F2";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "appendix D's coefficients with b2 integrate to 358.063";
    }
    idealGasHeatCapacity
    {
        origin        literature;
        method        "NASA/TP-2002-211556 appendix D, p. 112, entry Cs2F2, a1..a7 of the 200-1000 K and 1000-6000 K intervals, as printed";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "read by bin/curate/nasa_tp2002_to_choupo.py, which holds H and S at 298.15 K to the printed values";
    }
    source   "McBride, Zehe & Gordon, NASA Glenn Coefficients for Calculating Thermodynamic Properties of Individual Species, NASA/TP-2002-211556 (2002)";
    licence  publicDomain;    // US government work (NASA), 17 U.S.C. 105
}
