/*--------------------------------*- Choupo -*-----------------------*\
  Species BH4 (NASA/TP-2002-211556 appendix D entry "BH4"):
  ideal-gas formation data and heat capacity transcribed by machine with
  bin/curate/nasa_tp2002_to_choupo.py table, which holds H and S at
  298.15 K recomputed from the printed coefficients to the printed
  values.  Not read back against the page by a curator.
  The report's own description and sources: Radical. Saxon,1993. Yu,1998.
\*---------------------------------------------------------------------------*/
name           BH4;
formula        BH4;
CAS            n/a;
MW             14.84276;       // kg/kmol, appendix D record line
role           nonvolatile;   // ideal-gas species: no vapour pressure is asked of it
tags           ( gasPhase thermoTable );
nasaEntry      "BH4";
reviewStatus   interim;
reviewReason   "transcribed by machine from NASA/TP-2002-211556 into the thermoTables home and checked against the report itself; not yet read back against the page by a curator";
standardThermochemistry
{
    dHf_298    255210.477;   // J/mol  -- ideal gas; NASA/TP-2002-211556 appendix D, p. 60, entry BH4
    s_298      211.994;     // J/(mol·K) -- third-law absolute; Table B1, p. 11
}

idealGasHeatCapacity
{
    //  NASA/TP-2002-211556 eq. (1), Cp/R = a1/T^2 + a2/T + a3 + a4 T + a5 T^2
    //  + a6 T^3 + a7 T^4; appendix D, p. 60, entry BH4, a1..a7 as printed.
    model    NASA9;
    Tlow     200;
    Tcommon  1000;
    Thigh    6000;
    low      ( 2.734274578e+04 -8.473619380e+01 1.551871695e+00 1.439765491e-02 -6.111152360e-06 -1.324417559e-10 5.133008150e-13 );
    high     ( 1.354714146e+06 -7.870762750e+03 1.826170610e+01 -1.948275329e-03 4.072706890e-07 -4.482710900e-11 2.014115885e-15 );
}

provenance
{
    dHf_298
    {
        origin        literature;
        method        "NASA/TP-2002-211556 appendix D, p. 60, entry BH4, record-line H(298.15) (elements reference, so = dHf)";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "Table B1 p. 11 prints 255.21 kJ/mol; the report's own sources: Radical. Saxon,1993. Yu,1998.";
    }
    s_298
    {
        origin        literature;
        method        "NASA/TP-2002-211556 Table B1, p. 11, entry BH4";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "appendix D's coefficients with b2 integrate to 211.994";
    }
    idealGasHeatCapacity
    {
        origin        literature;
        method        "NASA/TP-2002-211556 appendix D, p. 60, entry BH4, a1..a7 of the 200-1000 K and 1000-6000 K intervals, as printed";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "read by bin/curate/nasa_tp2002_to_choupo.py, which holds H and S at 298.15 K to the printed values";
    }
    source   "McBride, Zehe & Gordon, NASA Glenn Coefficients for Calculating Thermodynamic Properties of Individual Species, NASA/TP-2002-211556 (2002)";
    licence  publicDomain;    // US government work (NASA), 17 U.S.C. 105
}
