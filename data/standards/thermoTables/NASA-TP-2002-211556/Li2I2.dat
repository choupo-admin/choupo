/*--------------------------------*- Choupo -*-----------------------*\
  Species Li2I2 (NASA/TP-2002-211556 appendix D entry "Li2I2"):
  ideal-gas formation data and heat capacity transcribed by machine with
  bin/curate/nasa_tp2002_to_choupo.py table, which holds H and S at
  298.15 K recomputed from the printed coefficients to the printed
  values.  Not read back against the page by a curator.
  The report's own description and sources: Gurvich,1982 pt1 p290 pt2 p323.
\*---------------------------------------------------------------------------*/
name           Li2I2;
formula        Li2I2;
CAS            n/a;
MW             267.6909;       // kg/kmol, appendix D record line
role           gasData;       // closed-shell molecule (or noble gas): ideal-gas data only, no liquid model
tags           ( gasPhase thermoTable );
nasaEntry      "Li2I2";
reviewStatus   interim;
reviewReason   "transcribed by machine from NASA/TP-2002-211556 into the thermoTables home and checked against the report itself; not yet read back against the page by a curator";
standardThermochemistry
{
    dHf_298    -362801.349;   // J/mol  -- ideal gas; NASA/TP-2002-211556 appendix D, p. 146, entry Li2I2
    s_298      334.607;     // J/(mol·K) -- third-law absolute; Table B1, p. 23
}

idealGasHeatCapacity
{
    //  NASA/TP-2002-211556 eq. (1), Cp/R = a1/T^2 + a2/T + a3 + a4 T + a5 T^2
    //  + a6 T^3 + a7 T^4; appendix D, p. 146, entry Li2I2, a1..a7 as printed.
    model    NASA9;
    Tlow     200;
    Tcommon  1000;
    Thigh    6000;
    low      ( 1.014872266e+04 -7.120421010e+02 1.270392960e+01 -5.685536810e-03 6.770340380e-06 -4.263304890e-09 1.100658186e-12 );
    high     ( -6.973587060e+04 -1.316825508e+01 1.001074855e+01 -4.600203780e-06 1.070510527e-09 -1.277717768e-13 6.110612240e-18 );
}

provenance
{
    dHf_298
    {
        origin        literature;
        method        "NASA/TP-2002-211556 appendix D, p. 146, entry Li2I2, record-line H(298.15) (elements reference, so = dHf)";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "Table B1 p. 23 prints -362.801 kJ/mol; the report's own sources: Gurvich,1982 pt1 p290 pt2 p323.";
    }
    s_298
    {
        origin        literature;
        method        "NASA/TP-2002-211556 Table B1, p. 23, entry Li2I2";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "appendix D's coefficients with b2 integrate to 334.607";
    }
    idealGasHeatCapacity
    {
        origin        literature;
        method        "NASA/TP-2002-211556 appendix D, p. 146, entry Li2I2, a1..a7 of the 200-1000 K and 1000-6000 K intervals, as printed";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "read by bin/curate/nasa_tp2002_to_choupo.py, which holds H and S at 298.15 K to the printed values";
    }
    source   "McBride, Zehe & Gordon, NASA Glenn Coefficients for Calculating Thermodynamic Properties of Individual Species, NASA/TP-2002-211556 (2002)";
    licence  publicDomain;    // US government work (NASA), 17 U.S.C. 105
}
