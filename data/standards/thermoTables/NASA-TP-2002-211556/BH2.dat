/*--------------------------------*- Choupo -*-----------------------*\
  Species BH2 (NASA/TP-2002-211556 appendix D entry "BH2"):
  ideal-gas formation data and heat capacity transcribed by machine with
  bin/curate/nasa_tp2002_to_choupo.py table, which holds H and S at
  298.15 K recomputed from the printed coefficients to the printed
  values.  Not read back against the page by a curator.
  The report's own description and sources: Jacox,1994. Kolbuszewski,1996. Gurvich,1996a p32.
\*---------------------------------------------------------------------------*/
name           BH2;
formula        BH2;
CAS            n/a;
MW             12.82688;       // kg/kmol, appendix D record line
role           gasOnly;       // free radical (odd electron count 7)
tags           ( gasPhase thermoTable );
nasaEntry      "BH2";
reviewStatus   interim;
reviewReason   "transcribed by machine from NASA/TP-2002-211556 into the thermoTables home and checked against the report itself; not yet read back against the page by a curator";
standardThermochemistry
{
    dHf_298    328909.059;   // J/mol  -- ideal gas; NASA/TP-2002-211556 appendix D, p. 59, entry BH2
    s_298      193.685;     // J/(mol·K) -- third-law absolute; Table B1, p. 11
}

idealGasHeatCapacity
{
    //  NASA/TP-2002-211556 eq. (1), Cp/R = a1/T^2 + a2/T + a3 + a4 T + a5 T^2
    //  + a6 T^3 + a7 T^4; appendix D, p. 59, entry BH2, a1..a7 as printed.
    model    NASA9;
    Tlow     200;
    Tcommon  1000;
    Thigh    6000;
    low      ( 2.812557296e+04 -3.000083489e+02 4.824221000e+00 -2.186429819e-04 1.485457398e-06 3.893739680e-10 -6.331629390e-13 );
    high     ( 1.360117365e+06 -4.917704490e+03 9.758971030e+00 -7.415870640e-04 1.269760019e-07 -1.187742442e-11 4.682552510e-16 );
}

provenance
{
    dHf_298
    {
        origin        literature;
        method        "NASA/TP-2002-211556 appendix D, p. 59, entry BH2, record-line H(298.15) (elements reference, so = dHf)";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "Table B1 p. 11 prints 328.909 kJ/mol; the report's own sources: Jacox,1994. Kolbuszewski,1996. Gurvich,1996a p32.";
    }
    s_298
    {
        origin        literature;
        method        "NASA/TP-2002-211556 Table B1, p. 11, entry BH2";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "appendix D's coefficients with b2 integrate to 193.685";
    }
    idealGasHeatCapacity
    {
        origin        literature;
        method        "NASA/TP-2002-211556 appendix D, p. 59, entry BH2, a1..a7 of the 200-1000 K and 1000-6000 K intervals, as printed";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "read by bin/curate/nasa_tp2002_to_choupo.py, which holds H and S at 298.15 K to the printed values";
    }
    source   "McBride, Zehe & Gordon, NASA Glenn Coefficients for Calculating Thermodynamic Properties of Individual Species, NASA/TP-2002-211556 (2002)";
    licence  publicDomain;    // US government work (NASA), 17 U.S.C. 105
}
