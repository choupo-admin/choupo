/*--------------------------------*- Choupo -*-----------------------*\
  Species Si2 (NASA/TP-2002-211556 appendix D entry "Si2"):
  ideal-gas formation data and heat capacity transcribed by machine with
  bin/curate/nasa_tp2002_to_choupo.py table, which holds H and S at
  298.15 K recomputed from the printed coefficients to the printed
  values.  Not read back against the page by a curator.
  The report's own description and sources: Gurvich,1991 pt1 p240 pt2 p225.
\*---------------------------------------------------------------------------*/
name           Si2;
formula        Si2;
CAS            n/a;
MW             56.171;       // kg/kmol, appendix D record line
role           nonvolatile;   // ideal-gas species: no vapour pressure is asked of it
tags           ( gasPhase thermoTable );
nasaEntry      "Si2";
reviewStatus   interim;
reviewReason   "transcribed by machine from NASA/TP-2002-211556 into the thermoTables home and checked against the report itself; not yet read back against the page by a curator";
standardThermochemistry
{
    dHf_298    580195.524;   // J/mol  -- ideal gas; NASA/TP-2002-211556 appendix D, p. 192, entry Si2
    s_298      238.007;     // J/(mol·K) -- third-law absolute; Table B1, p. 29
}

idealGasHeatCapacity
{
    //  NASA/TP-2002-211556 eq. (1), Cp/R = a1/T^2 + a2/T + a3 + a4 T + a5 T^2
    //  + a6 T^3 + a7 T^4; appendix D, p. 192, entry Si2, a1..a7 as printed.
    model    NASA9;
    Tlow     200;
    Tcommon  1000;
    Thigh    6000;
    low      ( 1.237596221e+04 -1.024904376e+02 4.354848520e+00 1.281063335e-03 -2.531991623e-06 2.265694244e-09 -7.001290140e-13 );
    high     ( 1.370060657e+06 -4.207060040e+03 9.337432890e+00 -2.749217168e-03 9.586345960e-07 -1.372449748e-10 6.765028100e-15 );
}

provenance
{
    dHf_298
    {
        origin        literature;
        method        "NASA/TP-2002-211556 appendix D, p. 192, entry Si2, record-line H(298.15) (elements reference, so = dHf)";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "Table B1 p. 29 prints 580.196 kJ/mol; the report's own sources: Gurvich,1991 pt1 p240 pt2 p225.";
    }
    s_298
    {
        origin        literature;
        method        "NASA/TP-2002-211556 Table B1, p. 29, entry Si2";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "appendix D's coefficients with b2 integrate to 238.007";
    }
    idealGasHeatCapacity
    {
        origin        literature;
        method        "NASA/TP-2002-211556 appendix D, p. 192, entry Si2, a1..a7 of the 200-1000 K and 1000-6000 K intervals, as printed";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "read by bin/curate/nasa_tp2002_to_choupo.py, which holds H and S at 298.15 K to the printed values";
    }
    source   "McBride, Zehe & Gordon, NASA Glenn Coefficients for Calculating Thermodynamic Properties of Individual Species, NASA/TP-2002-211556 (2002)";
    licence  publicDomain;    // US government work (NASA), 17 U.S.C. 105
}
