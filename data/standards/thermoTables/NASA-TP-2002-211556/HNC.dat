/*--------------------------------*- Choupo -*-----------------------*\
  Species HNC (NASA/TP-2002-211556 appendix D entry "HNC"):
  ideal-gas formation data and heat capacity transcribed by machine with
  bin/curate/nasa_tp2002_to_choupo.py table, which holds H and S at
  298.15 K recomputed from the printed coefficients to the printed
  values.  Not read back against the page by a curator.
  The report's own description and sources: Hf:Gurvich,1991 pt1 p227. Jacox,1998 p145.
\*---------------------------------------------------------------------------*/
name           HNC;
formula        HNC;
CAS            n/a;
MW             27.02534;       // kg/kmol, appendix D record line
role           radical;       // gas-only (DEV.md 4c C458): stays in the vapour, refused where no vapour holds it
tags           ( gasPhase thermoTable );
nasaEntry      "HNC";
reviewStatus   interim;
reviewReason   "transcribed by machine from NASA/TP-2002-211556 into the thermoTables home and checked against the report itself; not yet read back against the page by a curator";
standardThermochemistry
{
    dHf_298    194378.121;   // J/mol  -- ideal gas; NASA/TP-2002-211556 appendix D, p. 129, entry HNC
    s_298      205.511;     // J/(mol·K) -- third-law absolute; Table B1, p. 21
}

idealGasHeatCapacity
{
    //  NASA/TP-2002-211556 eq. (1), Cp/R = a1/T^2 + a2/T + a3 + a4 T + a5 T^2
    //  + a6 T^3 + a7 T^4; appendix D, p. 129, entry HNC, a1..a7 as printed.
    model    NASA9;
    Tlow     200;
    Tcommon  1000;
    Thigh    6000;
    low      ( 4.870620640e+04 -9.891456250e+02 9.722153890e+00 -1.113593916e-02 1.668862707e-05 -1.113940941e-08 2.893600868e-12 );
    high     ( 1.198791660e+06 -3.918941860e+03 9.118020090e+00 -3.417761100e-04 3.314809680e-08 -5.701574740e-13 -7.789455390e-17 );
}

provenance
{
    dHf_298
    {
        origin        literature;
        method        "NASA/TP-2002-211556 appendix D, p. 129, entry HNC, record-line H(298.15) (elements reference, so = dHf)";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "Table B1 p. 21 prints 194.378 kJ/mol; the report's own sources: Hf:Gurvich,1991 pt1 p227. Jacox,1998 p145.";
    }
    s_298
    {
        origin        literature;
        method        "NASA/TP-2002-211556 Table B1, p. 21, entry HNC";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "appendix D's coefficients with b2 integrate to 205.511";
    }
    idealGasHeatCapacity
    {
        origin        literature;
        method        "NASA/TP-2002-211556 appendix D, p. 129, entry HNC, a1..a7 of the 200-1000 K and 1000-6000 K intervals, as printed";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "read by bin/curate/nasa_tp2002_to_choupo.py, which holds H and S at 298.15 K to the printed values";
    }
    source   "McBride, Zehe & Gordon, NASA Glenn Coefficients for Calculating Thermodynamic Properties of Individual Species, NASA/TP-2002-211556 (2002)";
    licence  publicDomain;    // US government work (NASA), 17 U.S.C. 105
}
