/*--------------------------------*- Choupo -*-----------------------*\
  Species CLO2 (NASA/TP-2002-211556 appendix D entry "CLO2"):
  ideal-gas formation data and heat capacity transcribed by machine with
  bin/curate/nasa_tp2002_to_choupo.py table, which holds H and S at
  298.15 K recomputed from the printed coefficients to the printed
  values.  Not read back against the page by a curator.
  The report's own description and sources: Gurvich,1989 pt1 p182 pt2 p91.
\*---------------------------------------------------------------------------*/
name           CLO2;
formula        ClO2;
CAS            n/a;
MW             67.4518;       // kg/kmol, appendix D record line
role           gasData;       // stable odd-electron molecule: chlorine dioxide, a liquid below 284 K
tags           ( gasPhase thermoTable );
nasaEntry      "CLO2";
reviewStatus   interim;
reviewReason   "transcribed by machine from NASA/TP-2002-211556 into the thermoTables home and checked against the report itself; not yet read back against the page by a curator";
standardThermochemistry
{
    dHf_298    105000.000;   // J/mol  -- ideal gas; NASA/TP-2002-211556 appendix D, p. 107, entry CLO2
    s_298      256.885;     // J/(mol·K) -- third-law absolute; Table B1, p. 18
}

idealGasHeatCapacity
{
    //  NASA/TP-2002-211556 eq. (1), Cp/R = a1/T^2 + a2/T + a3 + a4 T + a5 T^2
    //  + a6 T^3 + a7 T^4; appendix D, p. 107, entry CLO2, a1..a7 as printed.
    model    NASA9;
    Tlow     200;
    Tcommon  1000;
    Thigh    6000;
    low      ( -1.127277696e+04 3.903032030e+02 -3.843018530e-01 2.108677947e-02 -2.793137755e-05 1.841289286e-08 -4.839779150e-12 );
    high     ( -1.633793802e+05 -3.161480670e+02 7.009787260e+00 2.837971144e-04 -1.179925338e-07 2.920383252e-11 -2.024030202e-15 );
}

provenance
{
    dHf_298
    {
        origin        literature;
        method        "NASA/TP-2002-211556 appendix D, p. 107, entry CLO2, record-line H(298.15) (elements reference, so = dHf)";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "Table B1 p. 18 prints 105.0 kJ/mol; the report's own sources: Gurvich,1989 pt1 p182 pt2 p91.";
    }
    s_298
    {
        origin        literature;
        method        "NASA/TP-2002-211556 Table B1, p. 18, entry CLO2";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "appendix D's coefficients with b2 integrate to 256.885";
    }
    idealGasHeatCapacity
    {
        origin        literature;
        method        "NASA/TP-2002-211556 appendix D, p. 107, entry CLO2, a1..a7 of the 200-1000 K and 1000-6000 K intervals, as printed";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "read by bin/curate/nasa_tp2002_to_choupo.py, which holds H and S at 298.15 K to the printed values";
    }
    source   "McBride, Zehe & Gordon, NASA Glenn Coefficients for Calculating Thermodynamic Properties of Individual Species, NASA/TP-2002-211556 (2002)";
    licence  publicDomain;    // US government work (NASA), 17 U.S.C. 105
}
