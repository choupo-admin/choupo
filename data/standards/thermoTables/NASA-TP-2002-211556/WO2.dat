/*--------------------------------*- Choupo -*-----------------------*\
  Species WO2 (NASA/TP-2002-211556 appendix D entry "WO2"):
  ideal-gas formation data and heat capacity transcribed by machine with
  bin/curate/nasa_tp2002_to_choupo.py table, which holds H and S at
  298.15 K recomputed from the printed coefficients to the printed
  values.  Not read back against the page by a curator.
  The report's own description and sources: Gurvich,1982 pt1 p47 pt2 p50.
\*---------------------------------------------------------------------------*/
name           WO2;
formula        WO2;
CAS            n/a;
MW             215.8388;       // kg/kmol, appendix D record line
role           nonvolatile;   // ideal-gas species: no vapour pressure is asked of it
tags           ( gasPhase thermoTable );
nasaEntry      "WO2";
reviewStatus   interim;
reviewReason   "transcribed by machine from NASA/TP-2002-211556 into the thermoTables home and checked against the report itself; not yet read back against the page by a curator";
standardThermochemistry
{
    dHf_298    29061.744;   // J/mol  -- ideal gas; NASA/TP-2002-211556 appendix D, p. 207, entry WO2
    s_298      271.487;     // J/(mol·K) -- third-law absolute; Table B1, p. 31
}

idealGasHeatCapacity
{
    //  NASA/TP-2002-211556 eq. (1), Cp/R = a1/T^2 + a2/T + a3 + a4 T + a5 T^2
    //  + a6 T^3 + a7 T^4; appendix D, p. 207, entry WO2, a1..a7 as printed.
    model    NASA9;
    Tlow     200;
    Tcommon  1000;
    Thigh    6000;
    low      ( 3.120918919e+03 2.413883468e+02 -3.024119184e-01 2.324333417e-02 -3.378812680e-05 2.380934019e-08 -6.421592880e-12 );
    high     ( -7.537406680e+05 3.204643050e+03 6.701965600e-01 4.488238870e-03 -8.858328460e-07 6.245171750e-11 -9.046613900e-16 );
}

provenance
{
    dHf_298
    {
        origin        literature;
        method        "NASA/TP-2002-211556 appendix D, p. 207, entry WO2, record-line H(298.15) (elements reference, so = dHf)";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "Table B1 p. 31 prints 29.062 kJ/mol; the report's own sources: Gurvich,1982 pt1 p47 pt2 p50.";
    }
    s_298
    {
        origin        literature;
        method        "NASA/TP-2002-211556 Table B1, p. 31, entry WO2";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "appendix D's coefficients with b2 integrate to 271.487";
    }
    idealGasHeatCapacity
    {
        origin        literature;
        method        "NASA/TP-2002-211556 appendix D, p. 207, entry WO2, a1..a7 of the 200-1000 K and 1000-6000 K intervals, as printed";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "read by bin/curate/nasa_tp2002_to_choupo.py, which holds H and S at 298.15 K to the printed values";
    }
    source   "McBride, Zehe & Gordon, NASA Glenn Coefficients for Calculating Thermodynamic Properties of Individual Species, NASA/TP-2002-211556 (2002)";
    licence  publicDomain;    // US government work (NASA), 17 U.S.C. 105
}
