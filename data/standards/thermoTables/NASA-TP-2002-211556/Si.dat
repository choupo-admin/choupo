/*--------------------------------*- Choupo -*-----------------------*\
  Species Si (NASA/TP-2002-211556 appendix D entry "Si"):
  ideal-gas formation data and heat capacity transcribed by machine with
  bin/curate/nasa_tp2002_to_choupo.py table, which holds H and S at
  298.15 K recomputed from the printed coefficients to the printed
  values.  Not read back against the page by a curator.
  The report's own description and sources: Hf:Cox,1989. NIST data version1.1 [Online]1997. Gordon,1999.
\*---------------------------------------------------------------------------*/
name           Si;
formula        Si;
CAS            n/a;
MW             28.0855;       // kg/kmol, appendix D record line
role           gasOnly;       // free atom
tags           ( gasPhase thermoTable );
nasaEntry      "Si";
reviewStatus   interim;
reviewReason   "transcribed by machine from NASA/TP-2002-211556 into the thermoTables home and checked against the report itself; not yet read back against the page by a curator";
standardThermochemistry
{
    dHf_298    450000.000;   // J/mol  -- ideal gas; NASA/TP-2002-211556 appendix D, p. 186, entry Si
    s_298      167.982;     // J/(mol·K) -- third-law absolute; Table B1, p. 29
}

idealGasHeatCapacity
{
    //  NASA/TP-2002-211556 eq. (1), Cp/R = a1/T^2 + a2/T + a3 + a4 T + a5 T^2
    //  + a6 T^3 + a7 T^4; appendix D, p. 186, entry Si, a1..a7 as printed.
    //  The report's 6000-20000 K interval is not transcribed.
    model    NASA9;
    Tlow     200;
    Tcommon  1000;
    Thigh    6000;
    low      ( 9.836140810e+01 1.546544523e+02 1.876436670e+00 1.320637995e-03 -1.529720059e-06 8.950562770e-10 -1.952873490e-13 );
    high     ( -6.169298850e+05 2.240683927e+03 -4.448619320e-01 1.710056321e-03 -4.107714160e-07 4.558884780e-11 -1.889515353e-15 );
}

provenance
{
    dHf_298
    {
        origin        literature;
        method        "NASA/TP-2002-211556 appendix D, p. 186, entry Si, record-line H(298.15) (elements reference, so = dHf)";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "Table B1 p. 29 prints 450.0 kJ/mol; the report's own sources: Hf:Cox,1989. NIST data version1.1 [Online]1997. Gordon,1999.";
    }
    s_298
    {
        origin        literature;
        method        "NASA/TP-2002-211556 Table B1, p. 29, entry Si";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "appendix D's coefficients with b2 integrate to 167.982";
    }
    idealGasHeatCapacity
    {
        origin        literature;
        method        "NASA/TP-2002-211556 appendix D, p. 186, entry Si, a1..a7 of the 200-1000 K and 1000-6000 K intervals, as printed";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "read by bin/curate/nasa_tp2002_to_choupo.py, which holds H and S at 298.15 K to the printed values";
    }
    source   "McBride, Zehe & Gordon, NASA Glenn Coefficients for Calculating Thermodynamic Properties of Individual Species, NASA/TP-2002-211556 (2002)";
    licence  publicDomain;    // US government work (NASA), 17 U.S.C. 105
}
