/*--------------------------------*- Choupo -*-----------------------*\
  Species SiF3 (NASA/TP-2002-211556 appendix D entry "SiF3"):
  ideal-gas formation data and heat capacity transcribed by machine with
  bin/curate/nasa_tp2002_to_choupo.py table, which holds H and S at
  298.15 K recomputed from the printed coefficients to the printed
  values.  Not read back against the page by a curator.
  The report's own description and sources: Gurvich,1991 pt1 p268 pt2 p240
\*---------------------------------------------------------------------------*/
name           SiF3;
formula        SiF3;
CAS            n/a;
MW             85.08071;       // kg/kmol, appendix D record line
role           gasOnly;       // free radical (odd electron count 41)
tags           ( gasPhase thermoTable );
nasaEntry      "SiF3";
reviewStatus   interim;
reviewReason   "transcribed by machine from NASA/TP-2002-211556 into the thermoTables home and checked against the report itself; not yet read back against the page by a curator";
standardThermochemistry
{
    dHf_298    -996436.577;   // J/mol  -- ideal gas; NASA/TP-2002-211556 appendix D, p. 188, entry SiF3
    s_298      279.708;     // J/(mol·K) -- third-law absolute; Table B1, p. 29
}

idealGasHeatCapacity
{
    //  NASA/TP-2002-211556 eq. (1), Cp/R = a1/T^2 + a2/T + a3 + a4 T + a5 T^2
    //  + a6 T^3 + a7 T^4; appendix D, p. 188, entry SiF3, a1..a7 as printed.
    model    NASA9;
    Tlow     200;
    Tcommon  1000;
    Thigh    6000;
    low      ( 5.755369980e+04 -7.179595770e+02 5.379396940e+00 1.813065142e-02 -2.738373356e-05 1.946519470e-08 -5.390790560e-12 );
    high     ( -2.903283702e+05 -3.427876940e+02 1.025536335e+01 -1.019796690e-04 2.250326132e-08 -2.577117181e-12 1.192923177e-16 );
}

provenance
{
    dHf_298
    {
        origin        literature;
        method        "NASA/TP-2002-211556 appendix D, p. 188, entry SiF3, record-line H(298.15) (elements reference, so = dHf)";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "Table B1 p. 29 prints -996.437 kJ/mol; the report's own sources: Gurvich,1991 pt1 p268 pt2 p240";
    }
    s_298
    {
        origin        literature;
        method        "NASA/TP-2002-211556 Table B1, p. 29, entry SiF3";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "appendix D's coefficients with b2 integrate to 279.708";
    }
    idealGasHeatCapacity
    {
        origin        literature;
        method        "NASA/TP-2002-211556 appendix D, p. 188, entry SiF3, a1..a7 of the 200-1000 K and 1000-6000 K intervals, as printed";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "read by bin/curate/nasa_tp2002_to_choupo.py, which holds H and S at 298.15 K to the printed values";
    }
    source   "McBride, Zehe & Gordon, NASA Glenn Coefficients for Calculating Thermodynamic Properties of Individual Species, NASA/TP-2002-211556 (2002)";
    licence  publicDomain;    // US government work (NASA), 17 U.S.C. 105
}
