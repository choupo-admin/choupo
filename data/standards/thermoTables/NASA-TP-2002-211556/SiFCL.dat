/*--------------------------------*- Choupo -*-----------------------*\
  Species SiFCL (NASA/TP-2002-211556 appendix D entry "SiFCL"):
  ideal-gas formation data and heat capacity transcribed by machine with
  bin/curate/nasa_tp2002_to_choupo.py table, which holds H and S at
  298.15 K recomputed from the printed coefficients to the printed
  values.  Not read back against the page by a curator.
  The report's own description and sources: Gurvich,1991 pt1 p279 pt2 p248.
\*---------------------------------------------------------------------------*/
name           SiFCL;
formula        SiFCl;
CAS            n/a;
MW             82.5369;       // kg/kmol, appendix D record line
role           gasData;       // closed-shell molecule (or noble gas): ideal-gas data only, no liquid model
tags           ( gasPhase thermoTable );
nasaEntry      "SiFCL";
reviewStatus   interim;
reviewReason   "transcribed by machine from NASA/TP-2002-211556 into the thermoTables home and checked against the report itself; not yet read back against the page by a curator";
standardThermochemistry
{
    dHf_298    -377826.516;   // J/mol  -- ideal gas; NASA/TP-2002-211556 appendix D, p. 188, entry SiFCL
    s_298      275.147;     // J/(mol·K) -- third-law absolute; Table B1, p. 29
}

idealGasHeatCapacity
{
    //  NASA/TP-2002-211556 eq. (1), Cp/R = a1/T^2 + a2/T + a3 + a4 T + a5 T^2
    //  + a6 T^3 + a7 T^4; appendix D, p. 188, entry SiFCL, a1..a7 as printed.
    model    NASA9;
    Tlow     200;
    Tcommon  1000;
    Thigh    6000;
    low      ( 4.176954640e+04 -5.926575380e+02 6.409770710e+00 4.641682610e-03 -7.978461910e-06 6.008728370e-09 -1.720953157e-12 );
    high     ( -1.284698945e+05 -1.247550173e+02 7.092893850e+00 -3.707311770e-05 8.175173010e-09 -9.356435210e-13 4.328544340e-17 );
}

provenance
{
    dHf_298
    {
        origin        literature;
        method        "NASA/TP-2002-211556 appendix D, p. 188, entry SiFCL, record-line H(298.15) (elements reference, so = dHf)";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "Table B1 p. 29 prints -377.827 kJ/mol; the report's own sources: Gurvich,1991 pt1 p279 pt2 p248.";
    }
    s_298
    {
        origin        literature;
        method        "NASA/TP-2002-211556 Table B1, p. 29, entry SiFCL";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "appendix D's coefficients with b2 integrate to 275.147";
    }
    idealGasHeatCapacity
    {
        origin        literature;
        method        "NASA/TP-2002-211556 appendix D, p. 188, entry SiFCL, a1..a7 of the 200-1000 K and 1000-6000 K intervals, as printed";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "read by bin/curate/nasa_tp2002_to_choupo.py, which holds H and S at 298.15 K to the printed values";
    }
    source   "McBride, Zehe & Gordon, NASA Glenn Coefficients for Calculating Thermodynamic Properties of Individual Species, NASA/TP-2002-211556 (2002)";
    licence  publicDomain;    // US government work (NASA), 17 U.S.C. 105
}
