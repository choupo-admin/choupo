/*--------------------------------*- Choupo -*-----------------------*\
  Species InBr2 (NASA/TP-2002-211556 appendix D entry "InBr2"):
  ideal-gas formation data and heat capacity transcribed by machine with
  bin/curate/nasa_tp2002_to_choupo.py table, which holds H and S at
  298.15 K recomputed from the printed coefficients to the printed
  values.  Not read back against the page by a curator.
  The report's own description and sources: Gurvich,1996a pt1 p292 pt2 p234.
\*---------------------------------------------------------------------------*/
name           InBr2;
formula        InBr2;
CAS            n/a;
MW             274.626;       // kg/kmol, appendix D record line
role           gasOnly;       // free radical (odd electron count 119)
tags           ( gasPhase thermoTable );
nasaEntry      "InBr2";
reviewStatus   interim;
reviewReason   "transcribed by machine from NASA/TP-2002-211556 into the thermoTables home and checked against the report itself; not yet read back against the page by a curator";
standardThermochemistry
{
    dHf_298    -149729.059;   // J/mol  -- ideal gas; NASA/TP-2002-211556 appendix D, p. 136, entry InBr2
    s_298      333.556;     // J/(mol·K) -- third-law absolute; Table B1, p. 22
}

idealGasHeatCapacity
{
    //  NASA/TP-2002-211556 eq. (1), Cp/R = a1/T^2 + a2/T + a3 + a4 T + a5 T^2
    //  + a6 T^3 + a7 T^4; appendix D, p. 136, entry InBr2, a1..a7 as printed.
    model    NASA9;
    Tlow     200;
    Tcommon  1000;
    Thigh    6000;
    low      ( -6.619878900e+01 -2.365897310e+02 7.926545160e+00 -1.994547959e-03 2.420414153e-06 -1.548924922e-09 4.058148390e-13 );
    high     ( -3.217162030e+05 4.792682100e+02 7.102649480e+00 -5.514019780e-04 3.157862421e-07 -5.511254510e-11 3.172161390e-15 );
}

provenance
{
    dHf_298
    {
        origin        literature;
        method        "NASA/TP-2002-211556 appendix D, p. 136, entry InBr2, record-line H(298.15) (elements reference, so = dHf)";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "Table B1 p. 22 prints -149.729 kJ/mol; the report's own sources: Gurvich,1996a pt1 p292 pt2 p234.";
    }
    s_298
    {
        origin        literature;
        method        "NASA/TP-2002-211556 Table B1, p. 22, entry InBr2";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "appendix D's coefficients with b2 integrate to 333.556";
    }
    idealGasHeatCapacity
    {
        origin        literature;
        method        "NASA/TP-2002-211556 appendix D, p. 136, entry InBr2, a1..a7 of the 200-1000 K and 1000-6000 K intervals, as printed";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "read by bin/curate/nasa_tp2002_to_choupo.py, which holds H and S at 298.15 K to the printed values";
    }
    source   "McBride, Zehe & Gordon, NASA Glenn Coefficients for Calculating Thermodynamic Properties of Individual Species, NASA/TP-2002-211556 (2002)";
    licence  publicDomain;    // US government work (NASA), 17 U.S.C. 105
}
