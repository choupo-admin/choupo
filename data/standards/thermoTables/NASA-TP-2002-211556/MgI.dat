/*--------------------------------*- Choupo -*-----------------------*\
  Species MgI (NASA/TP-2002-211556 appendix D entry "MgI"):
  ideal-gas formation data and heat capacity transcribed by machine with
  bin/curate/nasa_tp2002_to_choupo.py table, which holds H and S at
  298.15 K recomputed from the printed coefficients to the printed
  values.  Not read back against the page by a curator.
  The report's own description and sources: Gurvich,1996a pt1 p420 pt2 p334.
\*---------------------------------------------------------------------------*/
name           MgI;
formula        MgI;
CAS            n/a;
MW             151.2095;       // kg/kmol, appendix D record line
role           gasOnly;       // free radical (odd electron count 65)
tags           ( gasPhase thermoTable );
nasaEntry      "MgI";
reviewStatus   interim;
reviewReason   "transcribed by machine from NASA/TP-2002-211556 into the thermoTables home and checked against the report itself; not yet read back against the page by a curator";
standardThermochemistry
{
    dHf_298    61206.317;   // J/mol  -- ideal gas; NASA/TP-2002-211556 appendix D, p. 149, entry MgI
    s_298      252.815;     // J/(mol·K) -- third-law absolute; Table B1, p. 24
}

idealGasHeatCapacity
{
    //  NASA/TP-2002-211556 eq. (1), Cp/R = a1/T^2 + a2/T + a3 + a4 T + a5 T^2
    //  + a6 T^3 + a7 T^4; appendix D, p. 149, entry MgI, a1..a7 as printed.
    model    NASA9;
    Tlow     200;
    Tcommon  1000;
    Thigh    6000;
    low      ( 2.943889099e+03 -1.690248574e+02 5.147251830e+00 -1.321186997e-03 1.623056505e-06 -1.005114222e-09 2.567337785e-13 );
    high     ( -2.370562811e+06 6.916452480e+03 -3.183894490e+00 4.051551140e-03 -9.774290750e-07 1.023329400e-10 -3.790304870e-15 );
}

provenance
{
    dHf_298
    {
        origin        literature;
        method        "NASA/TP-2002-211556 appendix D, p. 149, entry MgI, record-line H(298.15) (elements reference, so = dHf)";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "Table B1 p. 24 prints 61.206 kJ/mol; the report's own sources: Gurvich,1996a pt1 p420 pt2 p334.";
    }
    s_298
    {
        origin        literature;
        method        "NASA/TP-2002-211556 Table B1, p. 24, entry MgI";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "appendix D's coefficients with b2 integrate to 252.815";
    }
    idealGasHeatCapacity
    {
        origin        literature;
        method        "NASA/TP-2002-211556 appendix D, p. 149, entry MgI, a1..a7 of the 200-1000 K and 1000-6000 K intervals, as printed";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "read by bin/curate/nasa_tp2002_to_choupo.py, which holds H and S at 298.15 K to the printed values";
    }
    source   "McBride, Zehe & Gordon, NASA Glenn Coefficients for Calculating Thermodynamic Properties of Individual Species, NASA/TP-2002-211556 (2002)";
    licence  publicDomain;    // US government work (NASA), 17 U.S.C. 105
}
