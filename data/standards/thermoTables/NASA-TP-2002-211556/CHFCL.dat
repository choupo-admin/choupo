/*--------------------------------*- Choupo -*-----------------------*\
  Species CHFCL (NASA/TP-2002-211556 appendix D entry "CHFCL"):
  ideal-gas formation data and heat capacity transcribed by machine with
  bin/curate/nasa_tp2002_to_choupo.py table, which holds H and S at
  298.15 K recomputed from the printed coefficients to the printed
  values.  Not read back against the page by a curator.
  The report's own description and sources: Gurvich,1991 pt1 p147 pt2 p121.
\*---------------------------------------------------------------------------*/
name           CHFCL;
formula        CHFCl;
CAS            n/a;
MW             67.47004;       // kg/kmol, appendix D record line
role           gasOnly;       // free radical (odd electron count 33)
tags           ( gasPhase thermoTable );
nasaEntry      "CHFCL";
reviewStatus   interim;
reviewReason   "transcribed by machine from NASA/TP-2002-211556 into the thermoTables home and checked against the report itself; not yet read back against the page by a curator";
standardThermochemistry
{
    dHf_298    -83144.704;   // J/mol  -- ideal gas; NASA/TP-2002-211556 appendix D, p. 80, entry CHFCL
    s_298      268.507;     // J/(mol·K) -- third-law absolute; Table B1, p. 14
}

idealGasHeatCapacity
{
    //  NASA/TP-2002-211556 eq. (1), Cp/R = a1/T^2 + a2/T + a3 + a4 T + a5 T^2
    //  + a6 T^3 + a7 T^4; appendix D, p. 80, entry CHFCL, a1..a7 as printed.
    model    NASA9;
    Tlow     200;
    Tcommon  1000;
    Thigh    6000;
    low      ( -7.113008510e+04 1.377872745e+03 -6.484617240e+00 3.890972490e-02 -4.800735220e-05 3.073300019e-08 -7.982853410e-12 );
    high     ( 6.622163580e+05 -3.809007980e+03 1.223880469e+01 -7.467182750e-04 1.434767850e-07 -1.475406631e-11 6.273780680e-16 );
}

provenance
{
    dHf_298
    {
        origin        literature;
        method        "NASA/TP-2002-211556 appendix D, p. 80, entry CHFCL, record-line H(298.15) (elements reference, so = dHf)";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "Table B1 p. 14 prints -83.145 kJ/mol; the report's own sources: Gurvich,1991 pt1 p147 pt2 p121.";
    }
    s_298
    {
        origin        literature;
        method        "NASA/TP-2002-211556 Table B1, p. 14, entry CHFCL";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "appendix D's coefficients with b2 integrate to 268.507";
    }
    idealGasHeatCapacity
    {
        origin        literature;
        method        "NASA/TP-2002-211556 appendix D, p. 80, entry CHFCL, a1..a7 of the 200-1000 K and 1000-6000 K intervals, as printed";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "read by bin/curate/nasa_tp2002_to_choupo.py, which holds H and S at 298.15 K to the printed values";
    }
    source   "McBride, Zehe & Gordon, NASA Glenn Coefficients for Calculating Thermodynamic Properties of Individual Species, NASA/TP-2002-211556 (2002)";
    licence  publicDomain;    // US government work (NASA), 17 U.S.C. 105
}
