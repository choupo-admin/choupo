/*--------------------------------*- Choupo -*-----------------------*\
  Species CCL3 (NASA/TP-2002-211556 appendix D entry "CCL3"):
  ideal-gas formation data and heat capacity transcribed by machine with
  bin/curate/nasa_tp2002_to_choupo.py table, which holds H and S at
  298.15 K recomputed from the printed coefficients to the printed
  values.  Not read back against the page by a curator.
  The report's own description and sources: Hf:Hudgens,1991. TRC(12/93) tuv7270.
\*---------------------------------------------------------------------------*/
name           CCL3;
formula        CCl3;
CAS            n/a;
MW             118.3697;       // kg/kmol, appendix D record line
role           gasOnly;       // free radical (odd electron count 57)
tags           ( gasPhase thermoTable );
nasaEntry      "CCL3";
reviewStatus   interim;
reviewReason   "transcribed by machine from NASA/TP-2002-211556 into the thermoTables home and checked against the report itself; not yet read back against the page by a curator";
standardThermochemistry
{
    dHf_298    71128.000;   // J/mol  -- ideal gas; NASA/TP-2002-211556 appendix D, p. 76, entry CCL3
    s_298      303.100;     // J/(mol·K) -- third-law absolute; Table B1, p. 13
}

idealGasHeatCapacity
{
    //  NASA/TP-2002-211556 eq. (1), Cp/R = a1/T^2 + a2/T + a3 + a4 T + a5 T^2
    //  + a6 T^3 + a7 T^4; appendix D, p. 76, entry CCL3, a1..a7 as printed.
    model    NASA9;
    Tlow     200;
    Tcommon  1000;
    Thigh    6000;
    low      ( 3.414471650e+04 -5.547969730e+02 6.845544390e+00 1.242006495e-02 -2.036896881e-05 1.554979993e-08 -4.568940110e-12 );
    high     ( -5.427572540e+05 6.809020620e+02 9.047723620e+00 1.324277766e-04 6.301263040e-08 -2.656639200e-11 2.105668053e-15 );
}

provenance
{
    dHf_298
    {
        origin        literature;
        method        "NASA/TP-2002-211556 appendix D, p. 76, entry CCL3, record-line H(298.15) (elements reference, so = dHf)";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "Table B1 p. 13 prints 71.128 kJ/mol; the report's own sources: Hf:Hudgens,1991. TRC(12/93) tuv7270.";
    }
    s_298
    {
        origin        literature;
        method        "NASA/TP-2002-211556 Table B1, p. 13, entry CCL3";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "appendix D's coefficients with b2 integrate to 303.100";
    }
    idealGasHeatCapacity
    {
        origin        literature;
        method        "NASA/TP-2002-211556 appendix D, p. 76, entry CCL3, a1..a7 of the 200-1000 K and 1000-6000 K intervals, as printed";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "read by bin/curate/nasa_tp2002_to_choupo.py, which holds H and S at 298.15 K to the printed values";
    }
    source   "McBride, Zehe & Gordon, NASA Glenn Coefficients for Calculating Thermodynamic Properties of Individual Species, NASA/TP-2002-211556 (2002)";
    licence  publicDomain;    // US government work (NASA), 17 U.S.C. 105
}
