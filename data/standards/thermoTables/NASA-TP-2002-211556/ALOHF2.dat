/*--------------------------------*- Choupo -*-----------------------*\
  Species ALOHF2 (NASA/TP-2002-211556 appendix D entry "ALOHF2"):
  ideal-gas formation data and heat capacity transcribed by machine with
  bin/curate/nasa_tp2002_to_choupo.py table, which holds H and S at
  298.15 K recomputed from the printed coefficients to the printed
  values.  Not read back against the page by a curator.
  The report's own description and sources: Gurvich,1996a pt1 p168 pt2 p130.
\*---------------------------------------------------------------------------*/
name           ALOHF2;
formula        AlOHF2;
CAS            n/a;
MW             81.98568;       // kg/kmol, appendix D record line
role           gasData;       // closed-shell molecule (or noble gas): ideal-gas data only, no liquid model
tags           ( gasPhase thermoTable );
nasaEntry      "ALOHF2";
reviewStatus   interim;
reviewReason   "transcribed by machine from NASA/TP-2002-211556 into the thermoTables home and checked against the report itself; not yet read back against the page by a curator";
standardThermochemistry
{
    dHf_298    -1141510.711;   // J/mol  -- ideal gas; NASA/TP-2002-211556 appendix D, p. 52, entry ALOHF2
    s_298      299.541;     // J/(mol·K) -- third-law absolute; Table B1, p. 10
}

idealGasHeatCapacity
{
    //  NASA/TP-2002-211556 eq. (1), Cp/R = a1/T^2 + a2/T + a3 + a4 T + a5 T^2
    //  + a6 T^3 + a7 T^4; appendix D, p. 52, entry ALOHF2, a1..a7 as printed.
    model    NASA9;
    Tlow     200;
    Tcommon  1000;
    Thigh    6000;
    low      ( 1.738263538e+04 -1.307687299e+02 3.312381920e+00 2.784734099e-02 -3.982363210e-05 2.809344456e-08 -7.764574200e-12 );
    high     ( 6.530119920e+05 -3.034017232e+03 1.409719788e+01 -1.663681799e-04 -1.011564183e-09 2.993805003e-12 -2.315956955e-16 );
}

provenance
{
    dHf_298
    {
        origin        literature;
        method        "NASA/TP-2002-211556 appendix D, p. 52, entry ALOHF2, record-line H(298.15) (elements reference, so = dHf)";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "Table B1 p. 10 prints -1141.511 kJ/mol; the report's own sources: Gurvich,1996a pt1 p168 pt2 p130.";
    }
    s_298
    {
        origin        literature;
        method        "NASA/TP-2002-211556 Table B1, p. 10, entry ALOHF2";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "appendix D's coefficients with b2 integrate to 299.541";
    }
    idealGasHeatCapacity
    {
        origin        literature;
        method        "NASA/TP-2002-211556 appendix D, p. 52, entry ALOHF2, a1..a7 of the 200-1000 K and 1000-6000 K intervals, as printed";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "read by bin/curate/nasa_tp2002_to_choupo.py, which holds H and S at 298.15 K to the printed values";
    }
    source   "McBride, Zehe & Gordon, NASA Glenn Coefficients for Calculating Thermodynamic Properties of Individual Species, NASA/TP-2002-211556 (2002)";
    licence  publicDomain;    // US government work (NASA), 17 U.S.C. 105
}
