/*--------------------------------*- Choupo -*-----------------------*\
  Species SO (NASA/TP-2002-211556 appendix D entry "SO"):
  ideal-gas formation data and heat capacity transcribed by machine with
  bin/curate/nasa_tp2002_to_choupo.py table, which holds H and S at
  298.15 K recomputed from the printed coefficients to the printed
  values.  Not read back against the page by a curator.
  The report's own description and sources: Gurvich,1989 pt1 p286 pt2 p173.
\*---------------------------------------------------------------------------*/
name           SO;
formula        SO;
CAS            n/a;
MW             48.059;       // kg/kmol, = sum of the engine's atomic weights (C517; was 48.0644)
role           gasOnly;       // listed (biradical or transient): sulfur monoxide, triplet ground state, a transient that disproportionates when condensed
tags           ( gasPhase thermoTable );
nasaEntry      "SO";
reviewStatus   interim;
reviewReason   "transcribed by machine from NASA/TP-2002-211556 into the thermoTables home and checked against the report itself; not yet read back against the page by a curator";
standardThermochemistry
{
    dHf_298    4760.306;   // J/mol  -- ideal gas; NASA/TP-2002-211556 appendix D, p. 182, entry SO
    s_298      221.941;     // J/(mol·K) -- third-law absolute; Table B1, p. 28
}

idealGasHeatCapacity
{
    //  NASA/TP-2002-211556 eq. (1), Cp/R = a1/T^2 + a2/T + a3 + a4 T + a5 T^2
    //  + a6 T^3 + a7 T^4; appendix D, p. 182, entry SO, a1..a7 as printed.
    model    NASA9;
    Tlow     200;
    Tcommon  1000;
    Thigh    6000;
    low      ( -3.342757000e+04 6.403862500e+02 -1.006641228e+00 1.381512705e-02 -1.704486364e-05 1.061294930e-08 -2.645796205e-12 );
    high     ( -1.443410557e+06 4.113874360e+03 -5.383695780e-01 2.794153269e-03 -6.633352260e-07 7.838221190e-11 -3.560509070e-15 );
}

provenance
{
    dHf_298
    {
        origin        literature;
        method        "NASA/TP-2002-211556 appendix D, p. 182, entry SO, record-line H(298.15) (elements reference, so = dHf)";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "Table B1 p. 28 prints 4.76 kJ/mol; the report's own sources: Gurvich,1989 pt1 p286 pt2 p173.";
    }
    s_298
    {
        origin        literature;
        method        "NASA/TP-2002-211556 Table B1, p. 28, entry SO";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "appendix D's coefficients with b2 integrate to 221.941";
    }
    idealGasHeatCapacity
    {
        origin        literature;
        method        "NASA/TP-2002-211556 appendix D, p. 182, entry SO, a1..a7 of the 200-1000 K and 1000-6000 K intervals, as printed";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "read by bin/curate/nasa_tp2002_to_choupo.py, which holds H and S at 298.15 K to the printed values";
    }
    source   "McBride, Zehe & Gordon, NASA Glenn Coefficients for Calculating Thermodynamic Properties of Individual Species, NASA/TP-2002-211556 (2002)";
    licence  publicDomain;    // US government work (NASA), 17 U.S.C. 105
}
