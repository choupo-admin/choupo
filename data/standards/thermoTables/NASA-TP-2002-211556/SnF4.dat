/*--------------------------------*- Choupo -*-----------------------*\
  Species SnF4 (NASA/TP-2002-211556 appendix D entry "SnF4"):
  ideal-gas formation data and heat capacity transcribed by machine with
  bin/curate/nasa_tp2002_to_choupo.py table, which holds H and S at
  298.15 K recomputed from the printed coefficients to the printed
  values.  Not read back against the page by a curator.
  The report's own description and sources: Gurvich,1991 pt1 p369 pt2 p314.
\*---------------------------------------------------------------------------*/
name           SnF4;
formula        SnF4;
CAS            n/a;
MW             194.7036;       // kg/kmol, appendix D record line
role           nonvolatile;   // ideal-gas species: no vapour pressure is asked of it
tags           ( gasPhase thermoTable );
nasaEntry      "SnF4";
reviewStatus   interim;
reviewReason   "transcribed by machine from NASA/TP-2002-211556 into the thermoTables home and checked against the report itself; not yet read back against the page by a curator";
standardThermochemistry
{
    dHf_298    -1024766.717;   // J/mol  -- ideal gas; NASA/TP-2002-211556 appendix D, p. 194, entry SnF4
    s_298      319.474;     // J/(mol·K) -- third-law absolute; Table B1, p. 30
}

idealGasHeatCapacity
{
    //  NASA/TP-2002-211556 eq. (1), Cp/R = a1/T^2 + a2/T + a3 + a4 T + a5 T^2
    //  + a6 T^3 + a7 T^4; appendix D, p. 194, entry SnF4, a1..a7 as printed.
    model    NASA9;
    Tlow     200;
    Tcommon  1000;
    Thigh    6000;
    low      ( 1.390441119e+05 -2.168784371e+03 1.691802917e+01 -2.318608529e-03 -2.045847976e-06 3.430087900e-09 -1.289228860e-12 );
    high     ( -2.635692764e+05 -1.445469969e+02 1.310690681e+01 -4.237755790e-05 9.286871950e-09 -1.057062694e-12 4.867108680e-17 );
}

provenance
{
    dHf_298
    {
        origin        literature;
        method        "NASA/TP-2002-211556 appendix D, p. 194, entry SnF4, record-line H(298.15) (elements reference, so = dHf)";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "Table B1 p. 30 prints -1024.767 kJ/mol; the report's own sources: Gurvich,1991 pt1 p369 pt2 p314.";
    }
    s_298
    {
        origin        literature;
        method        "NASA/TP-2002-211556 Table B1, p. 30, entry SnF4";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "appendix D's coefficients with b2 integrate to 319.474";
    }
    idealGasHeatCapacity
    {
        origin        literature;
        method        "NASA/TP-2002-211556 appendix D, p. 194, entry SnF4, a1..a7 of the 200-1000 K and 1000-6000 K intervals, as printed";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "read by bin/curate/nasa_tp2002_to_choupo.py, which holds H and S at 298.15 K to the printed values";
    }
    source   "McBride, Zehe & Gordon, NASA Glenn Coefficients for Calculating Thermodynamic Properties of Individual Species, NASA/TP-2002-211556 (2002)";
    licence  publicDomain;    // US government work (NASA), 17 U.S.C. 105
}
