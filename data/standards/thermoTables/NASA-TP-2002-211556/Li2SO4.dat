/*--------------------------------*- Choupo -*-----------------------*\
  Species Li2SO4 (NASA/TP-2002-211556 appendix D entry "Li2SO4"):
  ideal-gas formation data and heat capacity transcribed by machine with
  bin/curate/nasa_tp2002_to_choupo.py table, which holds H and S at
  298.15 K recomputed from the printed coefficients to the printed
  values.  Not read back against the page by a curator.
  The report's own description and sources: Chase,1998 p1522.
\*---------------------------------------------------------------------------*/
name           Li2SO4;
formula        Li2SO4;
CAS            n/a;
MW             109.9446;       // kg/kmol, appendix D record line
role           gasData;       // closed-shell molecule (or noble gas): ideal-gas data only, no liquid model
tags           ( gasPhase thermoTable );
nasaEntry      "Li2SO4";
reviewStatus   interim;
reviewReason   "transcribed by machine from NASA/TP-2002-211556 into the thermoTables home and checked against the report itself; not yet read back against the page by a curator";
standardThermochemistry
{
    dHf_298    -1041816.000;   // J/mol  -- ideal gas; NASA/TP-2002-211556 appendix D, p. 147, entry Li2SO4
    s_298      322.826;     // J/(mol·K) -- third-law absolute; Table B1, p. 23
}

idealGasHeatCapacity
{
    //  NASA/TP-2002-211556 eq. (1), Cp/R = a1/T^2 + a2/T + a3 + a4 T + a5 T^2
    //  + a6 T^3 + a7 T^4; appendix D, p. 147, entry Li2SO4, a1..a7 as printed.
    model    NASA9;
    Tlow     200;
    Tcommon  1000;
    Thigh    6000;
    low      ( 1.006318702e+05 -1.543457217e+03 9.670054910e+00 3.390757380e-02 -4.823483810e-05 3.267368920e-08 -8.702518510e-12 );
    high     ( -6.038750870e+05 -1.064550976e+03 1.979557349e+01 -3.188978250e-04 7.062411120e-08 -8.114439070e-12 3.766830210e-16 );
}

provenance
{
    dHf_298
    {
        origin        literature;
        method        "NASA/TP-2002-211556 appendix D, p. 147, entry Li2SO4, record-line H(298.15) (elements reference, so = dHf)";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "Table B1 p. 23 prints -1041.816 kJ/mol; the report's own sources: Chase,1998 p1522.";
    }
    s_298
    {
        origin        literature;
        method        "NASA/TP-2002-211556 Table B1, p. 23, entry Li2SO4";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "appendix D's coefficients with b2 integrate to 322.826";
    }
    idealGasHeatCapacity
    {
        origin        literature;
        method        "NASA/TP-2002-211556 appendix D, p. 147, entry Li2SO4, a1..a7 of the 200-1000 K and 1000-6000 K intervals, as printed";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "read by bin/curate/nasa_tp2002_to_choupo.py, which holds H and S at 298.15 K to the printed values";
    }
    source   "McBride, Zehe & Gordon, NASA Glenn Coefficients for Calculating Thermodynamic Properties of Individual Species, NASA/TP-2002-211556 (2002)";
    licence  publicDomain;    // US government work (NASA), 17 U.S.C. 105
}
