/*--------------------------------*- Choupo -*-----------------------*\
  Species RbBO2 (NASA/TP-2002-211556 appendix D entry "RbBO2"):
  ideal-gas formation data and heat capacity transcribed by machine with
  bin/curate/nasa_tp2002_to_choupo.py table, which holds H and S at
  298.15 K recomputed from the printed coefficients to the printed
  values.  Not read back against the page by a curator.
  The report's own description and sources: Gurvich,1982 pt1 p459 pt2 p483.
\*---------------------------------------------------------------------------*/
name           RbBO2;
formula        RbBO2;
CAS            n/a;
MW             128.2776;       // kg/kmol, appendix D record line
role           gasData;       // closed-shell molecule (or noble gas): ideal-gas data only, no liquid model
tags           ( gasPhase thermoTable );
nasaEntry      "RbBO2";
reviewStatus   interim;
reviewReason   "transcribed by machine from NASA/TP-2002-211556 into the thermoTables home and checked against the report itself; not yet read back against the page by a curator";
standardThermochemistry
{
    dHf_298    -678977.302;   // J/mol  -- ideal gas; NASA/TP-2002-211556 appendix D, p. 176, entry RbBO2
    s_298      308.301;     // J/(mol·K) -- third-law absolute; Table B1, p. 27
}

idealGasHeatCapacity
{
    //  NASA/TP-2002-211556 eq. (1), Cp/R = a1/T^2 + a2/T + a3 + a4 T + a5 T^2
    //  + a6 T^3 + a7 T^4; appendix D, p. 176, entry RbBO2, a1..a7 as printed.
    model    NASA9;
    Tlow     200;
    Tcommon  1000;
    Thigh    6000;
    low      ( 4.198657750e+04 -6.799448330e+02 8.185151010e+00 2.772536733e-03 -6.175770470e-07 -9.426136250e-10 4.722414240e-13 );
    high     ( 9.154463400e+04 -1.668328341e+03 1.117268757e+01 -4.505533530e-04 9.681330590e-08 -1.088037652e-11 4.967733660e-16 );
}

provenance
{
    dHf_298
    {
        origin        literature;
        method        "NASA/TP-2002-211556 appendix D, p. 176, entry RbBO2, record-line H(298.15) (elements reference, so = dHf)";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "Table B1 p. 27 prints -678.977 kJ/mol; the report's own sources: Gurvich,1982 pt1 p459 pt2 p483.";
    }
    s_298
    {
        origin        literature;
        method        "NASA/TP-2002-211556 Table B1, p. 27, entry RbBO2";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "appendix D's coefficients with b2 integrate to 308.301";
    }
    idealGasHeatCapacity
    {
        origin        literature;
        method        "NASA/TP-2002-211556 appendix D, p. 176, entry RbBO2, a1..a7 of the 200-1000 K and 1000-6000 K intervals, as printed";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "read by bin/curate/nasa_tp2002_to_choupo.py, which holds H and S at 298.15 K to the printed values";
    }
    source   "McBride, Zehe & Gordon, NASA Glenn Coefficients for Calculating Thermodynamic Properties of Individual Species, NASA/TP-2002-211556 (2002)";
    licence  publicDomain;    // US government work (NASA), 17 U.S.C. 105
}
