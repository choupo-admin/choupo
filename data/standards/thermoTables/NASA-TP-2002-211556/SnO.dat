/*--------------------------------*- Choupo -*-----------------------*\
  Species SnO (NASA/TP-2002-211556 appendix D entry "SnO"):
  ideal-gas formation data and heat capacity transcribed by machine with
  bin/curate/nasa_tp2002_to_choupo.py table, which holds H and S at
  298.15 K recomputed from the printed coefficients to the printed
  values.  Not read back against the page by a curator.
  The report's own description and sources: Gurvich,1991 pt1 p359 pt2 p307.
\*---------------------------------------------------------------------------*/
name           SnO;
formula        SnO;
CAS            n/a;
MW             134.7094;       // kg/kmol, appendix D record line
role           radical;       // gas-only (DEV.md 4c C458): stays in the vapour, refused where no vapour holds it
tags           ( gasPhase thermoTable );
nasaEntry      "SnO";
reviewStatus   interim;
reviewReason   "transcribed by machine from NASA/TP-2002-211556 into the thermoTables home and checked against the report itself; not yet read back against the page by a curator";
standardThermochemistry
{
    dHf_298    21911.054;   // J/mol  -- ideal gas; NASA/TP-2002-211556 appendix D, p. 195, entry SnO
    s_298      232.118;     // J/(mol·K) -- third-law absolute; Table B1, p. 30
}

idealGasHeatCapacity
{
    //  NASA/TP-2002-211556 eq. (1), Cp/R = a1/T^2 + a2/T + a3 + a4 T + a5 T^2
    //  + a6 T^3 + a7 T^4; appendix D, p. 195, entry SnO, a1..a7 as printed.
    model    NASA9;
    Tlow     200;
    Tcommon  1000;
    Thigh    6000;
    low      ( 2.547788022e+04 -2.293583066e+02 3.421593530e+00 4.713300040e-03 -7.365971320e-06 5.379738870e-09 -1.519277855e-12 );
    high     ( -2.555955548e+06 7.870053500e+03 -5.439768730e+00 6.307819180e-03 -2.068871370e-06 3.307074880e-10 -1.848169716e-14 );
}

provenance
{
    dHf_298
    {
        origin        literature;
        method        "NASA/TP-2002-211556 appendix D, p. 195, entry SnO, record-line H(298.15) (elements reference, so = dHf)";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "Table B1 p. 30 prints 21.911 kJ/mol; the report's own sources: Gurvich,1991 pt1 p359 pt2 p307.";
    }
    s_298
    {
        origin        literature;
        method        "NASA/TP-2002-211556 Table B1, p. 30, entry SnO";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "appendix D's coefficients with b2 integrate to 232.118";
    }
    idealGasHeatCapacity
    {
        origin        literature;
        method        "NASA/TP-2002-211556 appendix D, p. 195, entry SnO, a1..a7 of the 200-1000 K and 1000-6000 K intervals, as printed";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "read by bin/curate/nasa_tp2002_to_choupo.py, which holds H and S at 298.15 K to the printed values";
    }
    source   "McBride, Zehe & Gordon, NASA Glenn Coefficients for Calculating Thermodynamic Properties of Individual Species, NASA/TP-2002-211556 (2002)";
    licence  publicDomain;    // US government work (NASA), 17 U.S.C. 105
}
