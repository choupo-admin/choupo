/*--------------------------------*- Choupo -*-----------------------*\
  Species NaLi (NASA/TP-2002-211556 appendix D entry "NaLi"):
  ideal-gas formation data and heat capacity transcribed by machine with
  bin/curate/nasa_tp2002_to_choupo.py table, which holds H and S at
  298.15 K recomputed from the printed coefficients to the printed
  values.  Not read back against the page by a curator.
  The report's own description and sources: Gurvich,1982 pt1 p363 pt2 p396.
\*---------------------------------------------------------------------------*/
name           NaLi;
formula        NaLi;
CAS            n/a;
MW             29.93077;       // kg/kmol, appendix D record line
role           radical;       // gas-only (DEV.md 4c C458): stays in the vapour, refused where no vapour holds it
tags           ( gasPhase thermoTable );
nasaEntry      "NaLi";
reviewStatus   interim;
reviewReason   "transcribed by machine from NASA/TP-2002-211556 into the thermoTables home and checked against the report itself; not yet read back against the page by a curator";
standardThermochemistry
{
    dHf_298    178598.320;   // J/mol  -- ideal gas; NASA/TP-2002-211556 appendix D, p. 160, entry NaLi
    s_298      219.434;     // J/(mol·K) -- third-law absolute; Table B1, p. 25
}

idealGasHeatCapacity
{
    //  NASA/TP-2002-211556 eq. (1), Cp/R = a1/T^2 + a2/T + a3 + a4 T + a5 T^2
    //  + a6 T^3 + a7 T^4; appendix D, p. 160, entry NaLi, a1..a7 as printed.
    model    NASA9;
    Tlow     200;
    Tcommon  1000;
    Thigh    6000;
    low      ( -6.569992760e+03 -5.253940430e+00 4.329384260e+00 1.097919189e-03 -1.965726597e-06 2.086472026e-09 -8.195988110e-13 );
    high     ( 1.091664860e+07 -3.480010640e+04 4.614311920e+01 -2.260951051e-02 5.685324370e-06 -6.458143300e-10 2.696508992e-14 );
}

provenance
{
    dHf_298
    {
        origin        literature;
        method        "NASA/TP-2002-211556 appendix D, p. 160, entry NaLi, record-line H(298.15) (elements reference, so = dHf)";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "Table B1 p. 25 prints 178.598 kJ/mol; the report's own sources: Gurvich,1982 pt1 p363 pt2 p396.";
    }
    s_298
    {
        origin        literature;
        method        "NASA/TP-2002-211556 Table B1, p. 25, entry NaLi";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "appendix D's coefficients with b2 integrate to 219.434";
    }
    idealGasHeatCapacity
    {
        origin        literature;
        method        "NASA/TP-2002-211556 appendix D, p. 160, entry NaLi, a1..a7 of the 200-1000 K and 1000-6000 K intervals, as printed";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "read by bin/curate/nasa_tp2002_to_choupo.py, which holds H and S at 298.15 K to the printed values";
    }
    source   "McBride, Zehe & Gordon, NASA Glenn Coefficients for Calculating Thermodynamic Properties of Individual Species, NASA/TP-2002-211556 (2002)";
    licence  publicDomain;    // US government work (NASA), 17 U.S.C. 105
}
