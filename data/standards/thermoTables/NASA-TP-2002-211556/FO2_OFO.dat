/*--------------------------------*- Choupo -*-----------------------*\
  Species FO2_OFO (NASA/TP-2002-211556 appendix D entry "FO2,OFO"):
  ideal-gas formation data and heat capacity transcribed by machine with
  bin/curate/nasa_tp2002_to_choupo.py table, which holds H and S at
  298.15 K recomputed from the printed coefficients to the printed
  values.  Not read back against the page by a curator.
  The report's own description and sources: Chase,1996b p583.
\*---------------------------------------------------------------------------*/
name           FO2_OFO;
formula        FO2;
CAS            n/a;
MW             50.9972;       // kg/kmol, appendix D record line
role           gasOnly;       // free radical (odd electron count 25)
tags           ( gasPhase thermoTable );
nasaEntry      "FO2,OFO";
reviewStatus   interim;
reviewReason   "transcribed by machine from NASA/TP-2002-211556 into the thermoTables home and checked against the report itself; not yet read back against the page by a curator";
standardThermochemistry
{
    dHf_298    378600.000;   // J/mol  -- ideal gas; NASA/TP-2002-211556 appendix D, p. 117, entry FO2,OFO
    s_298      251.289;     // J/(mol·K) -- third-law absolute; Table B1, p. 19
}

idealGasHeatCapacity
{
    //  NASA/TP-2002-211556 eq. (1), Cp/R = a1/T^2 + a2/T + a3 + a4 T + a5 T^2
    //  + a6 T^3 + a7 T^4; appendix D, p. 117, entry FO2,OFO, a1..a7 as printed.
    model    NASA9;
    Tlow     200;
    Tcommon  1000;
    Thigh    6000;
    low      ( -7.734106400e+04 1.663800209e+03 -9.612815160e+00 4.989156870e-02 -6.946217130e-05 4.707787800e-08 -1.258890729e-11 );
    high     ( -6.211867340e+05 9.369474590e+02 6.401558750e+00 2.136110846e-04 -4.337977650e-08 4.667312240e-12 -2.059767432e-16 );
}

provenance
{
    dHf_298
    {
        origin        literature;
        method        "NASA/TP-2002-211556 appendix D, p. 117, entry FO2,OFO, record-line H(298.15) (elements reference, so = dHf)";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "Table B1 p. 19 prints 378.6 kJ/mol; the report's own sources: Chase,1996b p583.";
    }
    s_298
    {
        origin        literature;
        method        "NASA/TP-2002-211556 Table B1, p. 19, entry FO2,OFO";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "appendix D's coefficients with b2 integrate to 251.289";
    }
    idealGasHeatCapacity
    {
        origin        literature;
        method        "NASA/TP-2002-211556 appendix D, p. 117, entry FO2,OFO, a1..a7 of the 200-1000 K and 1000-6000 K intervals, as printed";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "read by bin/curate/nasa_tp2002_to_choupo.py, which holds H and S at 298.15 K to the printed values";
    }
    source   "McBride, Zehe & Gordon, NASA Glenn Coefficients for Calculating Thermodynamic Properties of Individual Species, NASA/TP-2002-211556 (2002)";
    licence  publicDomain;    // US government work (NASA), 17 U.S.C. 105
}
