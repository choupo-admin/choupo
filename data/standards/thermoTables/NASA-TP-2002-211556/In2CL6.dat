/*--------------------------------*- Choupo -*-----------------------*\
  Species In2CL6 (NASA/TP-2002-211556 appendix D entry "In2CL6"):
  ideal-gas formation data and heat capacity transcribed by machine with
  bin/curate/nasa_tp2002_to_choupo.py table, which holds H and S at
  298.15 K recomputed from the printed coefficients to the printed
  values.  Not read back against the page by a curator.
  The report's own description and sources: Gurvich,1996a pt1 p288 pt2 p231.
\*---------------------------------------------------------------------------*/
name           In2CL6;
formula        In2Cl6;
CAS            n/a;
MW             442.354;       // kg/kmol, appendix D record line
role           nonvolatile;   // ideal-gas species: no vapour pressure is asked of it
tags           ( gasPhase thermoTable );
nasaEntry      "In2CL6";
reviewStatus   interim;
reviewReason   "transcribed by machine from NASA/TP-2002-211556 into the thermoTables home and checked against the report itself; not yet read back against the page by a curator";
standardThermochemistry
{
    dHf_298    -882340.029;   // J/mol  -- ideal gas; NASA/TP-2002-211556 appendix D, p. 138, entry In2CL6
    s_298      527.664;     // J/(mol·K) -- third-law absolute; Table B1, p. 22
}

idealGasHeatCapacity
{
    //  NASA/TP-2002-211556 eq. (1), Cp/R = a1/T^2 + a2/T + a3 + a4 T + a5 T^2
    //  + a6 T^3 + a7 T^4; appendix D, p. 138, entry In2CL6, a1..a7 as printed.
    model    NASA9;
    Tlow     200;
    Tcommon  1000;
    Thigh    6000;
    low      ( 3.004663159e+04 -1.585621359e+03 2.796489470e+01 -1.245506052e-02 1.475341213e-05 -9.252689200e-09 2.381233885e-12 );
    high     ( -1.499400484e+05 -2.988680816e+01 2.202425362e+01 -1.033652301e-05 2.397911922e-09 -2.855307516e-13 1.363051661e-17 );
}

provenance
{
    dHf_298
    {
        origin        literature;
        method        "NASA/TP-2002-211556 appendix D, p. 138, entry In2CL6, record-line H(298.15) (elements reference, so = dHf)";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "Table B1 p. 22 prints -882.34 kJ/mol; the report's own sources: Gurvich,1996a pt1 p288 pt2 p231.";
    }
    s_298
    {
        origin        literature;
        method        "NASA/TP-2002-211556 Table B1, p. 22, entry In2CL6";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "appendix D's coefficients with b2 integrate to 527.664";
    }
    idealGasHeatCapacity
    {
        origin        literature;
        method        "NASA/TP-2002-211556 appendix D, p. 138, entry In2CL6, a1..a7 of the 200-1000 K and 1000-6000 K intervals, as printed";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "read by bin/curate/nasa_tp2002_to_choupo.py, which holds H and S at 298.15 K to the printed values";
    }
    source   "McBride, Zehe & Gordon, NASA Glenn Coefficients for Calculating Thermodynamic Properties of Individual Species, NASA/TP-2002-211556 (2002)";
    licence  publicDomain;    // US government work (NASA), 17 U.S.C. 105
}
