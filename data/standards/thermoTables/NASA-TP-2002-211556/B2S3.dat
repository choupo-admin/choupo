/*--------------------------------*- Choupo -*-----------------------*\
  Species B2S3 (NASA/TP-2002-211556 appendix D entry "B2S3"):
  ideal-gas formation data and heat capacity transcribed by machine with
  bin/curate/nasa_tp2002_to_choupo.py table, which holds H and S at
  298.15 K recomputed from the printed coefficients to the printed
  values.  Not read back against the page by a curator.
  The report's own description and sources: Gurvich,1996a pt1 p102 pt2 p81.
\*---------------------------------------------------------------------------*/
name           B2S3;
formula        B2S3;
CAS            n/a;
MW             117.817;       // kg/kmol, appendix D record line
role           gasData;       // closed-shell molecule (or noble gas): ideal-gas data only, no liquid model
tags           ( gasPhase thermoTable );
nasaEntry      "B2S3";
reviewStatus   interim;
reviewReason   "transcribed by machine from NASA/TP-2002-211556 into the thermoTables home and checked against the report itself; not yet read back against the page by a curator";
standardThermochemistry
{
    dHf_298    17754.057;   // J/mol  -- ideal gas; NASA/TP-2002-211556 appendix D, p. 64, entry B2S3
    s_298      351.434;     // J/(mol·K) -- third-law absolute; Table B1, p. 12
}

idealGasHeatCapacity
{
    //  NASA/TP-2002-211556 eq. (1), Cp/R = a1/T^2 + a2/T + a3 + a4 T + a5 T^2
    //  + a6 T^3 + a7 T^4; appendix D, p. 64, entry B2S3, a1..a7 as printed.
    model    NASA9;
    Tlow     200;
    Tcommon  1000;
    Thigh    6000;
    low      ( -3.431268500e+04 5.587615370e+02 3.414077410e+00 2.398333891e-02 -2.841617637e-05 1.690005199e-08 -4.060070710e-12 );
    high     ( -1.905855086e+05 -9.348342480e+02 1.369333613e+01 -2.766647250e-04 6.110155800e-08 -7.008048570e-12 3.249524620e-16 );
}

provenance
{
    dHf_298
    {
        origin        literature;
        method        "NASA/TP-2002-211556 appendix D, p. 64, entry B2S3, record-line H(298.15) (elements reference, so = dHf)";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "Table B1 p. 12 prints 17.754 kJ/mol; the report's own sources: Gurvich,1996a pt1 p102 pt2 p81.";
    }
    s_298
    {
        origin        literature;
        method        "NASA/TP-2002-211556 Table B1, p. 12, entry B2S3";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "appendix D's coefficients with b2 integrate to 351.434";
    }
    idealGasHeatCapacity
    {
        origin        literature;
        method        "NASA/TP-2002-211556 appendix D, p. 64, entry B2S3, a1..a7 of the 200-1000 K and 1000-6000 K intervals, as printed";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "read by bin/curate/nasa_tp2002_to_choupo.py, which holds H and S at 298.15 K to the printed values";
    }
    source   "McBride, Zehe & Gordon, NASA Glenn Coefficients for Calculating Thermodynamic Properties of Individual Species, NASA/TP-2002-211556 (2002)";
    licence  publicDomain;    // US government work (NASA), 17 U.S.C. 105
}
