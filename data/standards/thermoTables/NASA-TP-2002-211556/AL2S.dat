/*--------------------------------*- Choupo -*-----------------------*\
  Species AL2S (NASA/TP-2002-211556 appendix D entry "AL2S"):
  ideal-gas formation data and heat capacity transcribed by machine with
  bin/curate/nasa_tp2002_to_choupo.py table, which holds H and S at
  298.15 K recomputed from the printed coefficients to the printed
  values.  Not read back against the page by a curator.
  The report's own description and sources: Gurvich,1996a pt1 p199 pt2 p160.
\*---------------------------------------------------------------------------*/
name           AL2S;
formula        Al2S;
CAS            n/a;
MW             86.02808;       // kg/kmol, appendix D record line
role           nonvolatile;   // ideal-gas species: no vapour pressure is asked of it
tags           ( gasPhase thermoTable );
nasaEntry      "AL2S";
reviewStatus   interim;
reviewReason   "transcribed by machine from NASA/TP-2002-211556 into the thermoTables home and checked against the report itself; not yet read back against the page by a curator";
standardThermochemistry
{
    dHf_298    220679.131;   // J/mol  -- ideal gas; NASA/TP-2002-211556 appendix D, p. 54, entry AL2S
    s_298      271.338;     // J/(mol·K) -- third-law absolute; Table B1, p. 10
}

idealGasHeatCapacity
{
    //  NASA/TP-2002-211556 eq. (1), Cp/R = a1/T^2 + a2/T + a3 + a4 T + a5 T^2
    //  + a6 T^3 + a7 T^4; appendix D, p. 54, entry AL2S, a1..a7 as printed.
    model    NASA9;
    Tlow     200;
    Tcommon  1000;
    Thigh    6000;
    low      ( 4.094624370e+04 -7.797172470e+02 9.814423100e+00 -3.940339820e-03 3.912465430e-06 -2.105891677e-09 4.746001080e-13 );
    high     ( -7.043437370e+04 -2.676376869e+01 7.520233820e+00 -8.166123060e-06 1.816026040e-09 -2.091989298e-13 9.727537700e-18 );
}

provenance
{
    dHf_298
    {
        origin        literature;
        method        "NASA/TP-2002-211556 appendix D, p. 54, entry AL2S, record-line H(298.15) (elements reference, so = dHf)";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "Table B1 p. 10 prints 220.679 kJ/mol; the report's own sources: Gurvich,1996a pt1 p199 pt2 p160.";
    }
    s_298
    {
        origin        literature;
        method        "NASA/TP-2002-211556 Table B1, p. 10, entry AL2S";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "appendix D's coefficients with b2 integrate to 271.338";
    }
    idealGasHeatCapacity
    {
        origin        literature;
        method        "NASA/TP-2002-211556 appendix D, p. 54, entry AL2S, a1..a7 of the 200-1000 K and 1000-6000 K intervals, as printed";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "read by bin/curate/nasa_tp2002_to_choupo.py, which holds H and S at 298.15 K to the printed values";
    }
    source   "McBride, Zehe & Gordon, NASA Glenn Coefficients for Calculating Thermodynamic Properties of Individual Species, NASA/TP-2002-211556 (2002)";
    licence  publicDomain;    // US government work (NASA), 17 U.S.C. 105
}
