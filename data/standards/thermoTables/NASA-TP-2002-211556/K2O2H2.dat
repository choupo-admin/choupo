/*--------------------------------*- Choupo -*-----------------------*\
  Species K2O2H2 (NASA/TP-2002-211556 appendix D entry "K2O2H2"):
  ideal-gas formation data and heat capacity transcribed by machine with
  bin/curate/nasa_tp2002_to_choupo.py table, which holds H and S at
  298.15 K recomputed from the printed coefficients to the printed
  values.  Not read back against the page by a curator.
  The report's own description and sources: Gurvich,1997.
\*---------------------------------------------------------------------------*/
name           K2O2H2;
formula        K2O2H2;
CAS            n/a;
MW             112.2113;       // kg/kmol, appendix D record line
role           gasData;       // closed-shell molecule (or noble gas): ideal-gas data only, no liquid model
tags           ( gasPhase thermoTable );
nasaEntry      "K2O2H2";
reviewStatus   interim;
reviewReason   "transcribed by machine from NASA/TP-2002-211556 into the thermoTables home and checked against the report itself; not yet read back against the page by a curator";
standardThermochemistry
{
    dHf_298    -641000.000;   // J/mol  -- ideal gas; NASA/TP-2002-211556 appendix D, p. 143, entry K2O2H2
    s_298      342.859;     // J/(mol·K) -- third-law absolute; Table B1, p. 23
}

idealGasHeatCapacity
{
    //  NASA/TP-2002-211556 eq. (1), Cp/R = a1/T^2 + a2/T + a3 + a4 T + a5 T^2
    //  + a6 T^3 + a7 T^4; appendix D, p. 143, entry K2O2H2, a1..a7 as printed.
    model    NASA9;
    Tlow     200;
    Tcommon  1000;
    Thigh    6000;
    low      ( 8.174788370e+03 -1.130630680e+03 1.815303256e+01 -7.737431080e-03 6.837614010e-06 -2.054691111e-09 7.672877510e-14 );
    high     ( 1.773523196e+06 -4.665292470e+03 1.694308128e+01 2.085297143e-04 -1.264714762e-07 2.057506565e-11 -1.148042134e-15 );
}

provenance
{
    dHf_298
    {
        origin        literature;
        method        "NASA/TP-2002-211556 appendix D, p. 143, entry K2O2H2, record-line H(298.15) (elements reference, so = dHf)";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "Table B1 p. 23 prints -641.0 kJ/mol; the report's own sources: Gurvich,1997.";
    }
    s_298
    {
        origin        literature;
        method        "NASA/TP-2002-211556 Table B1, p. 23, entry K2O2H2";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "appendix D's coefficients with b2 integrate to 342.859";
    }
    idealGasHeatCapacity
    {
        origin        literature;
        method        "NASA/TP-2002-211556 appendix D, p. 143, entry K2O2H2, a1..a7 of the 200-1000 K and 1000-6000 K intervals, as printed";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "read by bin/curate/nasa_tp2002_to_choupo.py, which holds H and S at 298.15 K to the printed values";
    }
    source   "McBride, Zehe & Gordon, NASA Glenn Coefficients for Calculating Thermodynamic Properties of Individual Species, NASA/TP-2002-211556 (2002)";
    licence  publicDomain;    // US government work (NASA), 17 U.S.C. 105
}
