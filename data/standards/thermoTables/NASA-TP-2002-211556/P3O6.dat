/*--------------------------------*- Choupo -*-----------------------*\
  Species P3O6 (NASA/TP-2002-211556 appendix D entry "P3O6"):
  ideal-gas formation data and heat capacity transcribed by machine with
  bin/curate/nasa_tp2002_to_choupo.py table, which holds H and S at
  298.15 K recomputed from the printed coefficients to the printed
  values.  Not read back against the page by a curator.
  The report's own description and sources: Gurvich,1989 pt1 p412 pt2 p265.
\*---------------------------------------------------------------------------*/
name           P3O6;
formula        P3O6;
CAS            n/a;
MW             188.9177;       // kg/kmol, appendix D record line
role           gasOnly;       // free radical (odd electron count 93)
tags           ( gasPhase thermoTable );
nasaEntry      "P3O6";
reviewStatus   interim;
reviewReason   "transcribed by machine from NASA/TP-2002-211556 into the thermoTables home and checked against the report itself; not yet read back against the page by a curator";
standardThermochemistry
{
    dHf_298    -1575681.029;   // J/mol  -- ideal gas; NASA/TP-2002-211556 appendix D, p. 171, entry P3O6
    s_298      376.077;     // J/(mol·K) -- third-law absolute; Table B1, p. 27
}

idealGasHeatCapacity
{
    //  NASA/TP-2002-211556 eq. (1), Cp/R = a1/T^2 + a2/T + a3 + a4 T + a5 T^2
    //  + a6 T^3 + a7 T^4; appendix D, p. 171, entry P3O6, a1..a7 as printed.
    model    NASA9;
    Tlow     200;
    Tcommon  1000;
    Thigh    6000;
    low      ( 2.014493813e+05 -3.053488073e+03 1.602114098e+01 4.316889900e-02 -6.376544260e-05 4.422867920e-08 -1.200020334e-11 );
    high     ( -8.787968100e+05 -1.651988071e+03 2.772258397e+01 -4.859326700e-04 1.067867708e-07 -1.218015776e-11 5.614911960e-16 );
}

provenance
{
    dHf_298
    {
        origin        literature;
        method        "NASA/TP-2002-211556 appendix D, p. 171, entry P3O6, record-line H(298.15) (elements reference, so = dHf)";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "Table B1 p. 27 prints -1575.681 kJ/mol; the report's own sources: Gurvich,1989 pt1 p412 pt2 p265.";
    }
    s_298
    {
        origin        literature;
        method        "NASA/TP-2002-211556 Table B1, p. 27, entry P3O6";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "appendix D's coefficients with b2 integrate to 376.077";
    }
    idealGasHeatCapacity
    {
        origin        literature;
        method        "NASA/TP-2002-211556 appendix D, p. 171, entry P3O6, a1..a7 of the 200-1000 K and 1000-6000 K intervals, as printed";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "read by bin/curate/nasa_tp2002_to_choupo.py, which holds H and S at 298.15 K to the printed values";
    }
    source   "McBride, Zehe & Gordon, NASA Glenn Coefficients for Calculating Thermodynamic Properties of Individual Species, NASA/TP-2002-211556 (2002)";
    licence  publicDomain;    // US government work (NASA), 17 U.S.C. 105
}
