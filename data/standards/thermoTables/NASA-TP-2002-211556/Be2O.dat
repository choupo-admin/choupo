/*--------------------------------*- Choupo -*-----------------------*\
  Species Be2O (NASA/TP-2002-211556 appendix D entry "Be2O"):
  ideal-gas formation data and heat capacity transcribed by machine with
  bin/curate/nasa_tp2002_to_choupo.py table, which holds H and S at
  298.15 K recomputed from the printed coefficients to the printed
  values.  Not read back against the page by a curator.
  The report's own description and sources: Gurvich,1996a pt1 p353 pt2 p282.
\*---------------------------------------------------------------------------*/
name           Be2O;
formula        Be2O;
CAS            n/a;
MW             34.02376;       // kg/kmol, appendix D record line
role           radical;       // gas-only (DEV.md 4c C458): stays in the vapour, refused where no vapour holds it
tags           ( gasPhase thermoTable );
nasaEntry      "Be2O";
reviewStatus   interim;
reviewReason   "transcribed by machine from NASA/TP-2002-211556 into the thermoTables home and checked against the report itself; not yet read back against the page by a curator";
standardThermochemistry
{
    dHf_298    -37033.803;   // J/mol  -- ideal gas; NASA/TP-2002-211556 appendix D, p. 72, entry Be2O
    s_298      227.956;     // J/(mol·K) -- third-law absolute; Table B1, p. 13
}

idealGasHeatCapacity
{
    //  NASA/TP-2002-211556 eq. (1), Cp/R = a1/T^2 + a2/T + a3 + a4 T + a5 T^2
    //  + a6 T^3 + a7 T^4; appendix D, p. 72, entry Be2O, a1..a7 as printed.
    model    NASA9;
    Tlow     200;
    Tcommon  1000;
    Thigh    6000;
    low      ( -4.263673570e+02 -1.159556261e+02 4.082677770e+00 1.015885064e-02 -1.326015538e-05 8.488955360e-09 -2.168039077e-12 );
    high     ( -1.412646378e+05 -3.498644590e+02 7.760932680e+00 -1.044953518e-04 2.313342334e-08 -2.657722263e-12 1.233820439e-16 );
}

provenance
{
    dHf_298
    {
        origin        literature;
        method        "NASA/TP-2002-211556 appendix D, p. 72, entry Be2O, record-line H(298.15) (elements reference, so = dHf)";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "Table B1 p. 13 prints -37.034 kJ/mol; the report's own sources: Gurvich,1996a pt1 p353 pt2 p282.";
    }
    s_298
    {
        origin        literature;
        method        "NASA/TP-2002-211556 Table B1, p. 13, entry Be2O";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "appendix D's coefficients with b2 integrate to 227.956";
    }
    idealGasHeatCapacity
    {
        origin        literature;
        method        "NASA/TP-2002-211556 appendix D, p. 72, entry Be2O, a1..a7 of the 200-1000 K and 1000-6000 K intervals, as printed";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "read by bin/curate/nasa_tp2002_to_choupo.py, which holds H and S at 298.15 K to the printed values";
    }
    source   "McBride, Zehe & Gordon, NASA Glenn Coefficients for Calculating Thermodynamic Properties of Individual Species, NASA/TP-2002-211556 (2002)";
    licence  publicDomain;    // US government work (NASA), 17 U.S.C. 105
}
