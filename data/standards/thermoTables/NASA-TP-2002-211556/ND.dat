/*--------------------------------*- Choupo -*-----------------------*\
  Species ND (NASA/TP-2002-211556 appendix D entry "ND"):
  ideal-gas formation data and heat capacity transcribed by machine with
  bin/curate/nasa_tp2002_to_choupo.py table, which holds H and S at
  298.15 K recomputed from the printed coefficients to the printed
  values.  Not read back against the page by a curator.
  The report's own description and sources: Hf:est. from NH,H&D data. Chase,1998 p1037 6/77.
\*---------------------------------------------------------------------------*/
name           ND;
formula        ND;
CAS            n/a;
MW             16.0208;       // kg/kmol, appendix D record line
role           gasOnly;       // listed (biradical or transient): deuterated imidogen, triplet ground state
tags           ( gasPhase thermoTable );
nasaEntry      "ND";
reviewStatus   interim;
reviewReason   "transcribed by machine from NASA/TP-2002-211556 into the thermoTables home and checked against the report itself; not yet read back against the page by a curator";
standardThermochemistry
{
    dHf_298    355738.797;   // J/mol  -- ideal gas; NASA/TP-2002-211556 appendix D, p. 153, entry ND
    s_298      187.234;     // J/(mol·K) -- third-law absolute; Table B1, p. 24
}

idealGasHeatCapacity
{
    //  NASA/TP-2002-211556 eq. (1), Cp/R = a1/T^2 + a2/T + a3 + a4 T + a5 T^2
    //  + a6 T^3 + a7 T^4; appendix D, p. 153, entry ND, a1..a7 as printed.
    model    NASA9;
    Tlow     200;
    Tcommon  1000;
    Thigh    6000;
    low      ( 2.290155757e+04 -3.957388510e+02 6.179010330e+00 -8.847806970e-03 1.441582970e-05 -1.006647227e-08 2.654403586e-12 );
    high     ( 5.439657960e+05 -2.084583507e+03 5.834089720e+00 -4.189393360e-04 9.768929530e-08 -1.056317654e-11 4.683079210e-16 );
}

provenance
{
    dHf_298
    {
        origin        literature;
        method        "NASA/TP-2002-211556 appendix D, p. 153, entry ND, record-line H(298.15) (elements reference, so = dHf)";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "Table B1 p. 24 prints 355.739 kJ/mol; the report's own sources: Hf:est. from NH,H&D data. Chase,1998 p1037 6/77.";
    }
    s_298
    {
        origin        literature;
        method        "NASA/TP-2002-211556 Table B1, p. 24, entry ND";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "appendix D's coefficients with b2 integrate to 187.234";
    }
    idealGasHeatCapacity
    {
        origin        literature;
        method        "NASA/TP-2002-211556 appendix D, p. 153, entry ND, a1..a7 of the 200-1000 K and 1000-6000 K intervals, as printed";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "read by bin/curate/nasa_tp2002_to_choupo.py, which holds H and S at 298.15 K to the printed values";
    }
    source   "McBride, Zehe & Gordon, NASA Glenn Coefficients for Calculating Thermodynamic Properties of Individual Species, NASA/TP-2002-211556 (2002)";
    licence  publicDomain;    // US government work (NASA), 17 U.S.C. 105
}
