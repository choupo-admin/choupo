/*--------------------------------*- Choupo -*-----------------------*\
  Species SiCL3 (NASA/TP-2002-211556 appendix D entry "SiCL3"):
  ideal-gas formation data and heat capacity transcribed by machine with
  bin/curate/nasa_tp2002_to_choupo.py table, which holds H and S at
  298.15 K recomputed from the printed coefficients to the printed
  values.  Not read back against the page by a curator.
  The report's own description and sources: Gurvich,1991 pt1 p275 pt2 p245.
\*---------------------------------------------------------------------------*/
name           SiCL3;
formula        SiCl3;
CAS            n/a;
MW             134.4445;       // kg/kmol, appendix D record line
role           gasOnly;       // free radical (odd electron count 65)
tags           ( gasPhase thermoTable );
nasaEntry      "SiCL3";
reviewStatus   interim;
reviewReason   "transcribed by machine from NASA/TP-2002-211556 into the thermoTables home and checked against the report itself; not yet read back against the page by a curator";
standardThermochemistry
{
    dHf_298    -336271.670;   // J/mol  -- ideal gas; NASA/TP-2002-211556 appendix D, p. 187, entry SiCL3
    s_298      316.646;     // J/(mol·K) -- third-law absolute; Table B1, p. 29
}

idealGasHeatCapacity
{
    //  NASA/TP-2002-211556 eq. (1), Cp/R = a1/T^2 + a2/T + a3 + a4 T + a5 T^2
    //  + a6 T^3 + a7 T^4; appendix D, p. 187, entry SiCL3, a1..a7 as printed.
    model    NASA9;
    Tlow     200;
    Tcommon  1000;
    Thigh    6000;
    low      ( 8.691708460e+04 -1.677556857e+03 1.511519060e+01 -8.937031000e-03 9.097353530e-06 -5.014579960e-09 1.155962016e-12 );
    high     ( -1.477180114e+05 -5.335200980e+01 1.004043521e+01 -1.635121060e-05 3.641940110e-09 -4.200600590e-13 1.955201587e-17 );
}

provenance
{
    dHf_298
    {
        origin        literature;
        method        "NASA/TP-2002-211556 appendix D, p. 187, entry SiCL3, record-line H(298.15) (elements reference, so = dHf)";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "Table B1 p. 29 prints -336.272 kJ/mol; the report's own sources: Gurvich,1991 pt1 p275 pt2 p245.";
    }
    s_298
    {
        origin        literature;
        method        "NASA/TP-2002-211556 Table B1, p. 29, entry SiCL3";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "appendix D's coefficients with b2 integrate to 316.646";
    }
    idealGasHeatCapacity
    {
        origin        literature;
        method        "NASA/TP-2002-211556 appendix D, p. 187, entry SiCL3, a1..a7 of the 200-1000 K and 1000-6000 K intervals, as printed";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "read by bin/curate/nasa_tp2002_to_choupo.py, which holds H and S at 298.15 K to the printed values";
    }
    source   "McBride, Zehe & Gordon, NASA Glenn Coefficients for Calculating Thermodynamic Properties of Individual Species, NASA/TP-2002-211556 (2002)";
    licence  publicDomain;    // US government work (NASA), 17 U.S.C. 105
}
