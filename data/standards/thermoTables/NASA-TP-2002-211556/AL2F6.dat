/*--------------------------------*- Choupo -*-----------------------*\
  Species AL2F6 (NASA/TP-2002-211556 appendix D entry "AL2F6"):
  ideal-gas formation data and heat capacity transcribed by machine with
  bin/curate/nasa_tp2002_to_choupo.py table, which holds H and S at
  298.15 K recomputed from the printed coefficients to the printed
  values.  Not read back against the page by a curator.
  The report's own description and sources: Gurvich,1996a pt1 p160 pt2 p122.
\*---------------------------------------------------------------------------*/
name           AL2F6;
formula        Al2F6;
CAS            n/a;
MW             167.9535;       // kg/kmol, appendix D record line
role           nonvolatile;   // ideal-gas species: no vapour pressure is asked of it
tags           ( gasPhase thermoTable );
nasaEntry      "AL2F6";
reviewStatus   interim;
reviewReason   "transcribed by machine from NASA/TP-2002-211556 into the thermoTables home and checked against the report itself; not yet read back against the page by a curator";
standardThermochemistry
{
    dHf_298    -2632491.231;   // J/mol  -- ideal gas; NASA/TP-2002-211556 appendix D, p. 53, entry AL2F6
    s_298      385.487;     // J/(mol·K) -- third-law absolute; Table B1, p. 10
}

idealGasHeatCapacity
{
    //  NASA/TP-2002-211556 eq. (1), Cp/R = a1/T^2 + a2/T + a3 + a4 T + a5 T^2
    //  + a6 T^3 + a7 T^4; appendix D, p. 53, entry AL2F6, a1..a7 as printed.
    model    NASA9;
    Tlow     200;
    Tcommon  1000;
    Thigh    6000;
    low      ( 1.915061289e+05 -3.168240250e+03 2.245374802e+01 1.271532036e-02 -2.488697302e-05 1.955252096e-08 -5.712084890e-12 );
    high     ( -5.852982610e+05 -5.450571990e+02 2.240686320e+01 -1.627323704e-04 3.595225040e-08 -4.121201440e-12 1.909095384e-16 );
}

provenance
{
    dHf_298
    {
        origin        literature;
        method        "NASA/TP-2002-211556 appendix D, p. 53, entry AL2F6, record-line H(298.15) (elements reference, so = dHf)";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "Table B1 p. 10 prints -2632.491 kJ/mol; the report's own sources: Gurvich,1996a pt1 p160 pt2 p122.";
    }
    s_298
    {
        origin        literature;
        method        "NASA/TP-2002-211556 Table B1, p. 10, entry AL2F6";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "appendix D's coefficients with b2 integrate to 385.487";
    }
    idealGasHeatCapacity
    {
        origin        literature;
        method        "NASA/TP-2002-211556 appendix D, p. 53, entry AL2F6, a1..a7 of the 200-1000 K and 1000-6000 K intervals, as printed";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "read by bin/curate/nasa_tp2002_to_choupo.py, which holds H and S at 298.15 K to the printed values";
    }
    source   "McBride, Zehe & Gordon, NASA Glenn Coefficients for Calculating Thermodynamic Properties of Individual Species, NASA/TP-2002-211556 (2002)";
    licence  publicDomain;    // US government work (NASA), 17 U.S.C. 105
}
