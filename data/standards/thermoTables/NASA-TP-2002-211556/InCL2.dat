/*--------------------------------*- Choupo -*-----------------------*\
  Species InCL2 (NASA/TP-2002-211556 appendix D entry "InCL2"):
  ideal-gas formation data and heat capacity transcribed by machine with
  bin/curate/nasa_tp2002_to_choupo.py table, which holds H and S at
  298.15 K recomputed from the printed coefficients to the printed
  values.  Not read back against the page by a curator.
  The report's own description and sources: Gurvich,1996a pt1 p283 pt2 p226.
\*---------------------------------------------------------------------------*/
name           InCL2;
formula        InCl2;
CAS            n/a;
MW             185.724;       // kg/kmol, appendix D record line
role           gasOnly;       // free radical (odd electron count 83)
tags           ( gasPhase thermoTable );
nasaEntry      "InCL2";
reviewStatus   interim;
reviewReason   "transcribed by machine from NASA/TP-2002-211556 into the thermoTables home and checked against the report itself; not yet read back against the page by a curator";
standardThermochemistry
{
    dHf_298    -201483.416;   // J/mol  -- ideal gas; NASA/TP-2002-211556 appendix D, p. 136, entry InCL2
    s_298      314.208;     // J/(mol·K) -- third-law absolute; Table B1, p. 22
}

idealGasHeatCapacity
{
    //  NASA/TP-2002-211556 eq. (1), Cp/R = a1/T^2 + a2/T + a3 + a4 T + a5 T^2
    //  + a6 T^3 + a7 T^4; appendix D, p. 136, entry InCL2, a1..a7 as printed.
    model    NASA9;
    Tlow     200;
    Tcommon  1000;
    Thigh    6000;
    low      ( 9.935164870e+03 -4.172101860e+02 8.588494910e+00 -3.348385610e-03 3.997866640e-06 -2.525301853e-09 6.544490330e-13 );
    high     ( -3.328719840e+05 4.757691610e+02 7.105443690e+00 -5.525786960e-04 3.160567738e-07 -5.514453680e-11 3.173680380e-15 );
}

provenance
{
    dHf_298
    {
        origin        literature;
        method        "NASA/TP-2002-211556 appendix D, p. 136, entry InCL2, record-line H(298.15) (elements reference, so = dHf)";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "Table B1 p. 22 prints -201.483 kJ/mol; the report's own sources: Gurvich,1996a pt1 p283 pt2 p226.";
    }
    s_298
    {
        origin        literature;
        method        "NASA/TP-2002-211556 Table B1, p. 22, entry InCL2";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "appendix D's coefficients with b2 integrate to 314.208";
    }
    idealGasHeatCapacity
    {
        origin        literature;
        method        "NASA/TP-2002-211556 appendix D, p. 136, entry InCL2, a1..a7 of the 200-1000 K and 1000-6000 K intervals, as printed";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "read by bin/curate/nasa_tp2002_to_choupo.py, which holds H and S at 298.15 K to the printed values";
    }
    source   "McBride, Zehe & Gordon, NASA Glenn Coefficients for Calculating Thermodynamic Properties of Individual Species, NASA/TP-2002-211556 (2002)";
    licence  publicDomain;    // US government work (NASA), 17 U.S.C. 105
}
