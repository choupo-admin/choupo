/*--------------------------------*- Choupo -*-----------------------*\
  Species SnS2 (NASA/TP-2002-211556 appendix D entry "SnS2"):
  ideal-gas formation data and heat capacity transcribed by machine with
  bin/curate/nasa_tp2002_to_choupo.py table, which holds H and S at
  298.15 K recomputed from the printed coefficients to the printed
  values.  Not read back against the page by a curator.
  The report's own description and sources: Gurvich,1991 pt1 p397 pt2 p336.
\*---------------------------------------------------------------------------*/
name           SnS2;
formula        SnS2;
CAS            n/a;
MW             182.84;       // kg/kmol, appendix D record line
role           gasData;       // closed-shell molecule (or noble gas): ideal-gas data only, no liquid model
tags           ( gasPhase thermoTable );
nasaEntry      "SnS2";
reviewStatus   interim;
reviewReason   "transcribed by machine from NASA/TP-2002-211556 into the thermoTables home and checked against the report itself; not yet read back against the page by a curator";
standardThermochemistry
{
    dHf_298    149645.595;   // J/mol  -- ideal gas; NASA/TP-2002-211556 appendix D, p. 195, entry SnS2
    s_298      277.046;     // J/(mol·K) -- third-law absolute; Table B1, p. 30
}

idealGasHeatCapacity
{
    //  NASA/TP-2002-211556 eq. (1), Cp/R = a1/T^2 + a2/T + a3 + a4 T + a5 T^2
    //  + a6 T^3 + a7 T^4; appendix D, p. 195, entry SnS2, a1..a7 as printed.
    model    NASA9;
    Tlow     200;
    Tcommon  1000;
    Thigh    6000;
    low      ( 3.877145410e+04 -8.486953940e+02 1.042083990e+01 -5.686902670e-03 6.373829770e-06 -3.825158100e-09 9.502480960e-13 );
    high     ( -6.764084050e+04 -1.970189679e+01 7.515333870e+00 -6.332559180e-06 1.434207625e-09 -1.676383081e-13 7.886911900e-18 );
}

provenance
{
    dHf_298
    {
        origin        literature;
        method        "NASA/TP-2002-211556 appendix D, p. 195, entry SnS2, record-line H(298.15) (elements reference, so = dHf)";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "Table B1 p. 30 prints 149.646 kJ/mol; the report's own sources: Gurvich,1991 pt1 p397 pt2 p336.";
    }
    s_298
    {
        origin        literature;
        method        "NASA/TP-2002-211556 Table B1, p. 30, entry SnS2";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "appendix D's coefficients with b2 integrate to 277.046";
    }
    idealGasHeatCapacity
    {
        origin        literature;
        method        "NASA/TP-2002-211556 appendix D, p. 195, entry SnS2, a1..a7 of the 200-1000 K and 1000-6000 K intervals, as printed";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "read by bin/curate/nasa_tp2002_to_choupo.py, which holds H and S at 298.15 K to the printed values";
    }
    source   "McBride, Zehe & Gordon, NASA Glenn Coefficients for Calculating Thermodynamic Properties of Individual Species, NASA/TP-2002-211556 (2002)";
    licence  publicDomain;    // US government work (NASA), 17 U.S.C. 105
}
