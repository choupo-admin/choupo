/*--------------------------------*- Choupo -*-----------------------*\
  Species BeH (NASA/TP-2002-211556 appendix D entry "BeH"):
  ideal-gas formation data and heat capacity transcribed by machine with
  bin/curate/nasa_tp2002_to_choupo.py table, which holds H and S at
  298.15 K recomputed from the printed coefficients to the printed
  values.  Not read back against the page by a curator.
  The report's own description and sources: Gurvich,1996a pt1 p356, pt2 p286.
\*---------------------------------------------------------------------------*/
name           BeH;
formula        BeH;
CAS            n/a;
MW             10.02012;       // kg/kmol, appendix D record line
role           gasOnly;       // free radical (odd electron count 5)
tags           ( gasPhase thermoTable );
nasaEntry      "BeH";
reviewStatus   interim;
reviewReason   "transcribed by machine from NASA/TP-2002-211556 into the thermoTables home and checked against the report itself; not yet read back against the page by a curator";
standardThermochemistry
{
    dHf_298    342252.104;   // J/mol  -- ideal gas; NASA/TP-2002-211556 appendix D, p. 70, entry BeH
    s_298      176.823;     // J/(mol·K) -- third-law absolute; Table B1, p. 12
}

idealGasHeatCapacity
{
    //  NASA/TP-2002-211556 eq. (1), Cp/R = a1/T^2 + a2/T + a3 + a4 T + a5 T^2
    //  + a6 T^3 + a7 T^4; appendix D, p. 70, entry BeH, a1..a7 as printed.
    model    NASA9;
    Tlow     200;
    Tcommon  1000;
    Thigh    6000;
    low      ( -1.615149125e+03 -5.935286080e+01 4.507269100e+00 -5.264189610e-03 1.145319967e-05 -9.247883590e-09 2.700364753e-12 );
    high     ( -2.424081636e+06 6.597398460e+03 -3.626316480e+00 4.579634350e-03 -1.163329056e-06 1.297785691e-10 -5.291885810e-15 );
}

provenance
{
    dHf_298
    {
        origin        literature;
        method        "NASA/TP-2002-211556 appendix D, p. 70, entry BeH, record-line H(298.15) (elements reference, so = dHf)";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "Table B1 p. 12 prints 342.252 kJ/mol; the report's own sources: Gurvich,1996a pt1 p356, pt2 p286.";
    }
    s_298
    {
        origin        literature;
        method        "NASA/TP-2002-211556 Table B1, p. 12, entry BeH";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "appendix D's coefficients with b2 integrate to 176.823";
    }
    idealGasHeatCapacity
    {
        origin        literature;
        method        "NASA/TP-2002-211556 appendix D, p. 70, entry BeH, a1..a7 of the 200-1000 K and 1000-6000 K intervals, as printed";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "read by bin/curate/nasa_tp2002_to_choupo.py, which holds H and S at 298.15 K to the printed values";
    }
    source   "McBride, Zehe & Gordon, NASA Glenn Coefficients for Calculating Thermodynamic Properties of Individual Species, NASA/TP-2002-211556 (2002)";
    licence  publicDomain;    // US government work (NASA), 17 U.S.C. 105
}
