/*--------------------------------*- Choupo -*-----------------------*\
  Species BrOO (NASA/TP-2002-211556 appendix D entry "BrOO"):
  ideal-gas formation data and heat capacity transcribed by machine with
  bin/curate/nasa_tp2002_to_choupo.py table, which holds H and S at
  298.15 K recomputed from the printed coefficients to the printed
  values.  Not read back against the page by a curator.
  The report's own description and sources: Chase,1996a.
\*---------------------------------------------------------------------------*/
name           BrOO;
formula        BrO2;
CAS            n/a;
MW             111.9028;       // kg/kmol, appendix D record line
role           gasOnly;       // free radical (odd electron count 51)
tags           ( gasPhase thermoTable );
nasaEntry      "BrOO";
reviewStatus   interim;
reviewReason   "transcribed by machine from NASA/TP-2002-211556 into the thermoTables home and checked against the report itself; not yet read back against the page by a curator";
standardThermochemistry
{
    dHf_298    108000.000;   // J/mol  -- ideal gas; NASA/TP-2002-211556 appendix D, p. 73, entry BrOO
    s_298      288.845;     // J/(mol·K) -- third-law absolute; Table B1, p. 13
}

idealGasHeatCapacity
{
    //  NASA/TP-2002-211556 eq. (1), Cp/R = a1/T^2 + a2/T + a3 + a4 T + a5 T^2
    //  + a6 T^3 + a7 T^4; appendix D, p. 73, entry BrOO, a1..a7 as printed.
    model    NASA9;
    Tlow     200;
    Tcommon  1000;
    Thigh    6000;
    low      ( -4.417619900e+04 4.959637160e+02 3.239884950e+00 5.941502110e-03 -3.402696770e-06 -3.444778160e-11 4.811957950e-13 );
    high     ( 6.172483480e+03 -6.585049660e+02 7.483955330e+00 -1.920530746e-04 4.226946170e-08 -4.837392610e-12 2.239741320e-16 );
}

provenance
{
    dHf_298
    {
        origin        literature;
        method        "NASA/TP-2002-211556 appendix D, p. 73, entry BrOO, record-line H(298.15) (elements reference, so = dHf)";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "Table B1 p. 13 prints 108.0 kJ/mol; the report's own sources: Chase,1996a.";
    }
    s_298
    {
        origin        literature;
        method        "NASA/TP-2002-211556 Table B1, p. 13, entry BrOO";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "appendix D's coefficients with b2 integrate to 288.845";
    }
    idealGasHeatCapacity
    {
        origin        literature;
        method        "NASA/TP-2002-211556 appendix D, p. 73, entry BrOO, a1..a7 of the 200-1000 K and 1000-6000 K intervals, as printed";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "read by bin/curate/nasa_tp2002_to_choupo.py, which holds H and S at 298.15 K to the printed values";
    }
    source   "McBride, Zehe & Gordon, NASA Glenn Coefficients for Calculating Thermodynamic Properties of Individual Species, NASA/TP-2002-211556 (2002)";
    licence  publicDomain;    // US government work (NASA), 17 U.S.C. 105
}
