/*--------------------------------*- Choupo -*-----------------------*\
  Species PH2 (NASA/TP-2002-211556 appendix D entry "PH2"):
  ideal-gas formation data and heat capacity transcribed by machine with
  bin/curate/nasa_tp2002_to_choupo.py table, which holds H and S at
  298.15 K recomputed from the printed coefficients to the printed
  values.  Not read back against the page by a curator.
  The report's own description and sources: Gurvich,1989 pt1 p422 pt2 p273.
\*---------------------------------------------------------------------------*/
name           PH2;
formula        PH2;
CAS            n/a;
MW             32.98964;       // kg/kmol, appendix D record line
role           gasOnly;       // free radical (odd electron count 17)
tags           ( gasPhase thermoTable );
nasaEntry      "PH2";
reviewStatus   interim;
reviewReason   "transcribed by machine from NASA/TP-2002-211556 into the thermoTables home and checked against the report itself; not yet read back against the page by a curator";
standardThermochemistry
{
    dHf_298    119553.470;   // J/mol  -- ideal gas; NASA/TP-2002-211556 appendix D, p. 169, entry PH2
    s_298      212.610;     // J/(mol·K) -- third-law absolute; Table B1, p. 26
}

idealGasHeatCapacity
{
    //  NASA/TP-2002-211556 eq. (1), Cp/R = a1/T^2 + a2/T + a3 + a4 T + a5 T^2
    //  + a6 T^3 + a7 T^4; appendix D, p. 169, entry PH2, a1..a7 as printed.
    model    NASA9;
    Tlow     200;
    Tcommon  1000;
    Thigh    6000;
    low      ( 1.555268372e+04 -1.841602025e+02 4.895896040e+00 -3.495436600e-03 1.053418945e-05 -8.377562920e-09 2.270766150e-12 );
    high     ( 1.127884913e+06 -4.715238250e+03 1.021498300e+01 -1.167573820e-03 2.150542671e-07 -1.624213739e-11 3.766225240e-16 );
}

provenance
{
    dHf_298
    {
        origin        literature;
        method        "NASA/TP-2002-211556 appendix D, p. 169, entry PH2, record-line H(298.15) (elements reference, so = dHf)";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "Table B1 p. 26 prints 119.553 kJ/mol; the report's own sources: Gurvich,1989 pt1 p422 pt2 p273.";
    }
    s_298
    {
        origin        literature;
        method        "NASA/TP-2002-211556 Table B1, p. 26, entry PH2";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "appendix D's coefficients with b2 integrate to 212.610";
    }
    idealGasHeatCapacity
    {
        origin        literature;
        method        "NASA/TP-2002-211556 appendix D, p. 169, entry PH2, a1..a7 of the 200-1000 K and 1000-6000 K intervals, as printed";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "read by bin/curate/nasa_tp2002_to_choupo.py, which holds H and S at 298.15 K to the printed values";
    }
    source   "McBride, Zehe & Gordon, NASA Glenn Coefficients for Calculating Thermodynamic Properties of Individual Species, NASA/TP-2002-211556 (2002)";
    licence  publicDomain;    // US government work (NASA), 17 U.S.C. 105
}
