/*--------------------------------*- Choupo -*-----------------------*\
  Species CsNO3 (NASA/TP-2002-211556 appendix D entry "CsNO3"):
  ideal-gas formation data and heat capacity transcribed by machine with
  bin/curate/nasa_tp2002_to_choupo.py table, which holds H and S at
  298.15 K recomputed from the printed coefficients to the printed
  values.  Not read back against the page by a curator.
  The report's own description and sources: Gurvich,1982 pt1 p501 pt2 p522.
\*---------------------------------------------------------------------------*/
name           CsNO3;
formula        CsNO3;
CAS            n/a;
MW             194.9103;       // kg/kmol, appendix D record line
role           radical;       // gas-only (DEV.md 4c C458): stays in the vapour, refused where no vapour holds it
tags           ( gasPhase thermoTable );
nasaEntry      "CsNO3";
reviewStatus   interim;
reviewReason   "transcribed by machine from NASA/TP-2002-211556 into the thermoTables home and checked against the report itself; not yet read back against the page by a curator";
standardThermochemistry
{
    dHf_298    -318486.390;   // J/mol  -- ideal gas; NASA/TP-2002-211556 appendix D, p. 111, entry CsNO3
    s_298      336.035;     // J/(mol·K) -- third-law absolute; Table B1, p. 18
}

idealGasHeatCapacity
{
    //  NASA/TP-2002-211556 eq. (1), Cp/R = a1/T^2 + a2/T + a3 + a4 T + a5 T^2
    //  + a6 T^3 + a7 T^4; appendix D, p. 111, entry CsNO3, a1..a7 as printed.
    model    NASA9;
    Tlow     200;
    Tcommon  1000;
    Thigh    6000;
    low      ( -2.677219779e+04 9.011692690e+02 -3.265340820e+00 4.298377700e-02 -5.386751380e-05 3.384527520e-08 -8.565223660e-12 );
    high     ( -3.147517676e+05 -1.367011655e+03 1.401012848e+01 -4.018647130e-04 8.853614700e-08 -1.013466457e-11 4.691758730e-16 );
}

provenance
{
    dHf_298
    {
        origin        literature;
        method        "NASA/TP-2002-211556 appendix D, p. 111, entry CsNO3, record-line H(298.15) (elements reference, so = dHf)";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "Table B1 p. 18 prints -318.486 kJ/mol; the report's own sources: Gurvich,1982 pt1 p501 pt2 p522.";
    }
    s_298
    {
        origin        literature;
        method        "NASA/TP-2002-211556 Table B1, p. 18, entry CsNO3";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "appendix D's coefficients with b2 integrate to 336.035";
    }
    idealGasHeatCapacity
    {
        origin        literature;
        method        "NASA/TP-2002-211556 appendix D, p. 111, entry CsNO3, a1..a7 of the 200-1000 K and 1000-6000 K intervals, as printed";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "read by bin/curate/nasa_tp2002_to_choupo.py, which holds H and S at 298.15 K to the printed values";
    }
    source   "McBride, Zehe & Gordon, NASA Glenn Coefficients for Calculating Thermodynamic Properties of Individual Species, NASA/TP-2002-211556 (2002)";
    licence  publicDomain;    // US government work (NASA), 17 U.S.C. 105
}
