/*--------------------------------*- Choupo -*-----------------------*\
  Species C2CL3 (NASA/TP-2002-211556 appendix D entry "C2CL3"):
  ideal-gas formation data and heat capacity transcribed by machine with
  bin/curate/nasa_tp2002_to_choupo.py table, which holds H and S at
  298.15 K recomputed from the printed coefficients to the printed
  values.  Not read back against the page by a curator.
  The report's own description and sources: Gurvich,1991 pt1 p114 pt2 p87.
\*---------------------------------------------------------------------------*/
name           C2CL3;
formula        C2Cl3;
CAS            n/a;
MW             130.3804;       // kg/kmol, appendix D record line
role           gasOnly;       // free radical (odd electron count 63)
tags           ( gasPhase thermoTable );
nasaEntry      "C2CL3";
reviewStatus   interim;
reviewReason   "transcribed by machine from NASA/TP-2002-211556 into the thermoTables home and checked against the report itself; not yet read back against the page by a curator";
standardThermochemistry
{
    dHf_298    190271.592;   // J/mol  -- ideal gas; NASA/TP-2002-211556 appendix D, p. 87, entry C2CL3
    s_298      328.166;     // J/(mol·K) -- third-law absolute; Table B1, p. 15
}

idealGasHeatCapacity
{
    //  NASA/TP-2002-211556 eq. (1), Cp/R = a1/T^2 + a2/T + a3 + a4 T + a5 T^2
    //  + a6 T^3 + a7 T^4; appendix D, p. 87, entry C2CL3, a1..a7 as printed.
    model    NASA9;
    Tlow     200;
    Tcommon  1000;
    Thigh    6000;
    low      ( 4.675016040e+04 -8.851019640e+02 9.032270550e+00 1.242122796e-02 -1.554614347e-05 9.513887120e-09 -2.341473263e-12 );
    high     ( -2.204028219e+05 -1.072926248e+03 1.378367377e+01 -3.093322915e-04 6.777528950e-08 -7.727301820e-12 3.566690220e-16 );
}

provenance
{
    dHf_298
    {
        origin        literature;
        method        "NASA/TP-2002-211556 appendix D, p. 87, entry C2CL3, record-line H(298.15) (elements reference, so = dHf)";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "Table B1 p. 15 prints 190.272 kJ/mol; the report's own sources: Gurvich,1991 pt1 p114 pt2 p87.";
    }
    s_298
    {
        origin        literature;
        method        "NASA/TP-2002-211556 Table B1, p. 15, entry C2CL3";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "appendix D's coefficients with b2 integrate to 328.166";
    }
    idealGasHeatCapacity
    {
        origin        literature;
        method        "NASA/TP-2002-211556 appendix D, p. 87, entry C2CL3, a1..a7 of the 200-1000 K and 1000-6000 K intervals, as printed";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "read by bin/curate/nasa_tp2002_to_choupo.py, which holds H and S at 298.15 K to the printed values";
    }
    source   "McBride, Zehe & Gordon, NASA Glenn Coefficients for Calculating Thermodynamic Properties of Individual Species, NASA/TP-2002-211556 (2002)";
    licence  publicDomain;    // US government work (NASA), 17 U.S.C. 105
}
