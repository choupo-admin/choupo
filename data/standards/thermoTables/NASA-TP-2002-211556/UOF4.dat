/*--------------------------------*- Choupo -*-----------------------*\
  Species UOF4 (NASA/TP-2002-211556 appendix D entry "UOF4"):
  ideal-gas formation data and heat capacity transcribed by machine with
  bin/curate/nasa_tp2002_to_choupo.py table, which holds H and S at
  298.15 K recomputed from the printed coefficients to the printed
  values.  Not read back against the page by a curator.
  The report's own description and sources: Gurvich,1982 pt1 p230 pt2 p265.
\*---------------------------------------------------------------------------*/
name           UOF4;
formula        UOF4;
CAS            n/a;
MW             330.0219;       // kg/kmol, appendix D record line
role           nonvolatile;   // ideal-gas species: no vapour pressure is asked of it
tags           ( gasPhase thermoTable );
nasaEntry      "UOF4";
reviewStatus   interim;
reviewReason   "transcribed by machine from NASA/TP-2002-211556 into the thermoTables home and checked against the report itself; not yet read back against the page by a curator";
standardThermochemistry
{
    dHf_298    -1785611.531;   // J/mol  -- ideal gas; NASA/TP-2002-211556 appendix D, p. 204, entry UOF4
    s_298      363.175;     // J/(mol·K) -- third-law absolute; Table B1, p. 31
}

idealGasHeatCapacity
{
    //  NASA/TP-2002-211556 eq. (1), Cp/R = a1/T^2 + a2/T + a3 + a4 T + a5 T^2
    //  + a6 T^3 + a7 T^4; appendix D, p. 204, entry UOF4, a1..a7 as printed.
    model    NASA9;
    Tlow     200;
    Tcommon  1000;
    Thigh    6000;
    low      ( 1.437164405e+05 -2.496730363e+03 2.104827038e+01 -4.692561330e-03 8.741718650e-07 1.517555623e-09 -7.768799740e-13 );
    high     ( -2.996190288e+05 -1.677276501e+02 1.612494871e+01 -4.984414460e-05 1.098253497e-08 -1.255803231e-12 5.804480980e-17 );
}

provenance
{
    dHf_298
    {
        origin        literature;
        method        "NASA/TP-2002-211556 appendix D, p. 204, entry UOF4, record-line H(298.15) (elements reference, so = dHf)";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "Table B1 p. 31 prints -1785.612 kJ/mol; the report's own sources: Gurvich,1982 pt1 p230 pt2 p265.";
    }
    s_298
    {
        origin        literature;
        method        "NASA/TP-2002-211556 Table B1, p. 31, entry UOF4";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "appendix D's coefficients with b2 integrate to 363.175";
    }
    idealGasHeatCapacity
    {
        origin        literature;
        method        "NASA/TP-2002-211556 appendix D, p. 204, entry UOF4, a1..a7 of the 200-1000 K and 1000-6000 K intervals, as printed";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "read by bin/curate/nasa_tp2002_to_choupo.py, which holds H and S at 298.15 K to the printed values";
    }
    source   "McBride, Zehe & Gordon, NASA Glenn Coefficients for Calculating Thermodynamic Properties of Individual Species, NASA/TP-2002-211556 (2002)";
    licence  publicDomain;    // US government work (NASA), 17 U.S.C. 105
}
