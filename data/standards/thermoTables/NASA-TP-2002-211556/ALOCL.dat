/*--------------------------------*- Choupo -*-----------------------*\
  Species ALOCL (NASA/TP-2002-211556 appendix D entry "ALOCL"):
  ideal-gas formation data and heat capacity transcribed by machine with
  bin/curate/nasa_tp2002_to_choupo.py table, which holds H and S at
  298.15 K recomputed from the printed coefficients to the printed
  values.  Not read back against the page by a curator.
  The report's own description and sources: Gurvich,1996a pt1 p176 pt2 p136.
\*---------------------------------------------------------------------------*/
name           ALOCL;
formula        AlOCl;
CAS            n/a;
MW             78.43394;       // kg/kmol, appendix D record line
role           nonvolatile;   // ideal-gas species: no vapour pressure is asked of it
tags           ( gasPhase thermoTable );
nasaEntry      "ALOCL";
reviewStatus   interim;
reviewReason   "transcribed by machine from NASA/TP-2002-211556 into the thermoTables home and checked against the report itself; not yet read back against the page by a curator";
standardThermochemistry
{
    dHf_298    -301564.570;   // J/mol  -- ideal gas; NASA/TP-2002-211556 appendix D, p. 51, entry ALOCL
    s_298      252.377;     // J/(mol·K) -- third-law absolute; Table B1, p. 10
}

idealGasHeatCapacity
{
    //  NASA/TP-2002-211556 eq. (1), Cp/R = a1/T^2 + a2/T + a3 + a4 T + a5 T^2
    //  + a6 T^3 + a7 T^4; appendix D, p. 51, entry ALOCL, a1..a7 as printed.
    model    NASA9;
    Tlow     200;
    Tcommon  1000;
    Thigh    6000;
    low      ( -5.144627790e+03 -5.886297070e+01 4.452316930e+00 9.288235090e-03 -1.246894823e-05 8.178073540e-09 -2.130739934e-12 );
    high     ( -1.258027706e+05 -2.420565961e+02 7.681130020e+00 -7.268741700e-05 1.611337534e-08 1.852889749e-12 8.607278220e-17 );
}

provenance
{
    dHf_298
    {
        origin        literature;
        method        "NASA/TP-2002-211556 appendix D, p. 51, entry ALOCL, record-line H(298.15) (elements reference, so = dHf)";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "Table B1 p. 10 prints -301.565 kJ/mol; the report's own sources: Gurvich,1996a pt1 p176 pt2 p136.";
    }
    s_298
    {
        origin        literature;
        method        "NASA/TP-2002-211556 Table B1, p. 10, entry ALOCL";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "appendix D's coefficients with b2 integrate to 252.377";
    }
    idealGasHeatCapacity
    {
        origin        literature;
        method        "NASA/TP-2002-211556 appendix D, p. 51, entry ALOCL, a1..a7 of the 200-1000 K and 1000-6000 K intervals, as printed";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "read by bin/curate/nasa_tp2002_to_choupo.py, which holds H and S at 298.15 K to the printed values";
    }
    source   "McBride, Zehe & Gordon, NASA Glenn Coefficients for Calculating Thermodynamic Properties of Individual Species, NASA/TP-2002-211556 (2002)";
    licence  publicDomain;    // US government work (NASA), 17 U.S.C. 105
}
