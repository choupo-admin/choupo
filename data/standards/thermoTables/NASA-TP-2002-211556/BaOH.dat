/*--------------------------------*- Choupo -*-----------------------*\
  Species BaOH (NASA/TP-2002-211556 appendix D entry "BaOH"):
  ideal-gas formation data and heat capacity transcribed by machine with
  bin/curate/nasa_tp2002_to_choupo.py table, which holds H and S at
  298.15 K recomputed from the printed coefficients to the printed
  values.  Not read back against the page by a curator.
  The report's own description and sources: Gurvich,1996a pt1 p557 pt2 p425.
\*---------------------------------------------------------------------------*/
name           BaOH;
formula        BaOH;
CAS            n/a;
MW             154.3343;       // kg/kmol, appendix D record line
role           radical;       // gas-only (DEV.md 4c C458): stays in the vapour, refused where no vapour holds it
tags           ( gasPhase thermoTable );
nasaEntry      "BaOH";
reviewStatus   interim;
reviewReason   "transcribed by machine from NASA/TP-2002-211556 into the thermoTables home and checked against the report itself; not yet read back against the page by a curator";
standardThermochemistry
{
    dHf_298    -224256.513;   // J/mol  -- ideal gas; NASA/TP-2002-211556 appendix D, p. 68, entry BaOH
    s_298      255.755;     // J/(mol·K) -- third-law absolute; Table B1, p. 12
}

idealGasHeatCapacity
{
    //  NASA/TP-2002-211556 eq. (1), Cp/R = a1/T^2 + a2/T + a3 + a4 T + a5 T^2
    //  + a6 T^3 + a7 T^4; appendix D, p. 68, entry BaOH, a1..a7 as printed.
    model    NASA9;
    Tlow     200;
    Tcommon  1000;
    Thigh    6000;
    low      ( 3.776231510e+04 -8.891390220e+02 9.531718000e+00 -5.458825900e-03 4.941783010e-06 -1.809327537e-09 2.050048305e-13 );
    high     ( 2.637336694e+06 -8.365410400e+03 1.599803975e+01 -5.098446050e-03 1.594657431e-06 -2.180478542e-10 1.084610688e-14 );
}

provenance
{
    dHf_298
    {
        origin        literature;
        method        "NASA/TP-2002-211556 appendix D, p. 68, entry BaOH, record-line H(298.15) (elements reference, so = dHf)";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "Table B1 p. 12 prints -224.257 kJ/mol; the report's own sources: Gurvich,1996a pt1 p557 pt2 p425.";
    }
    s_298
    {
        origin        literature;
        method        "NASA/TP-2002-211556 Table B1, p. 12, entry BaOH";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "appendix D's coefficients with b2 integrate to 255.755";
    }
    idealGasHeatCapacity
    {
        origin        literature;
        method        "NASA/TP-2002-211556 appendix D, p. 68, entry BaOH, a1..a7 of the 200-1000 K and 1000-6000 K intervals, as printed";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "read by bin/curate/nasa_tp2002_to_choupo.py, which holds H and S at 298.15 K to the printed values";
    }
    source   "McBride, Zehe & Gordon, NASA Glenn Coefficients for Calculating Thermodynamic Properties of Individual Species, NASA/TP-2002-211556 (2002)";
    licence  publicDomain;    // US government work (NASA), 17 U.S.C. 105
}
