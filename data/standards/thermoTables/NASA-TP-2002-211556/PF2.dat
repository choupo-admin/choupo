/*--------------------------------*- Choupo -*-----------------------*\
  Species PF2 (NASA/TP-2002-211556 appendix D entry "PF2"):
  ideal-gas formation data and heat capacity transcribed by machine with
  bin/curate/nasa_tp2002_to_choupo.py table, which holds H and S at
  298.15 K recomputed from the printed coefficients to the printed
  values.  Not read back against the page by a curator.
  The report's own description and sources: Gurvich,1989 pt1 p426 pt2 p277.
\*---------------------------------------------------------------------------*/
name           PF2;
formula        PF2;
CAS            n/a;
MW             68.97057;       // kg/kmol, appendix D record line
role           gasOnly;       // free radical (odd electron count 33)
tags           ( gasPhase thermoTable );
nasaEntry      "PF2";
reviewStatus   interim;
reviewReason   "transcribed by machine from NASA/TP-2002-211556 into the thermoTables home and checked against the report itself; not yet read back against the page by a curator";
standardThermochemistry
{
    dHf_298    -513103.659;   // J/mol  -- ideal gas; NASA/TP-2002-211556 appendix D, p. 168, entry PF2
    s_298      262.183;     // J/(mol·K) -- third-law absolute; Table B1, p. 26
}

idealGasHeatCapacity
{
    //  NASA/TP-2002-211556 eq. (1), Cp/R = a1/T^2 + a2/T + a3 + a4 T + a5 T^2
    //  + a6 T^3 + a7 T^4; appendix D, p. 168, entry PF2, a1..a7 as printed.
    model    NASA9;
    Tlow     200;
    Tcommon  1000;
    Thigh    6000;
    low      ( 5.524765720e+04 -6.280517800e+02 5.137437920e+00 9.120673350e-03 -1.468773760e-05 1.081268450e-08 -3.064944490e-12 );
    high     ( -1.708467120e+05 -1.692051540e+02 7.125491600e+00 -4.990852850e-05 1.097335230e-08 -1.252870260e-12 5.784791140e-17 );
}

provenance
{
    dHf_298
    {
        origin        literature;
        method        "NASA/TP-2002-211556 appendix D, p. 168, entry PF2, record-line H(298.15) (elements reference, so = dHf)";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "Table B1 p. 26 prints -513.104 kJ/mol; the report's own sources: Gurvich,1989 pt1 p426 pt2 p277.";
    }
    s_298
    {
        origin        literature;
        method        "NASA/TP-2002-211556 Table B1, p. 26, entry PF2";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "appendix D's coefficients with b2 integrate to 262.183";
    }
    idealGasHeatCapacity
    {
        origin        literature;
        method        "NASA/TP-2002-211556 appendix D, p. 168, entry PF2, a1..a7 of the 200-1000 K and 1000-6000 K intervals, as printed";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "read by bin/curate/nasa_tp2002_to_choupo.py, which holds H and S at 298.15 K to the printed values";
    }
    source   "McBride, Zehe & Gordon, NASA Glenn Coefficients for Calculating Thermodynamic Properties of Individual Species, NASA/TP-2002-211556 (2002)";
    licence  publicDomain;    // US government work (NASA), 17 U.S.C. 105
}
