/*--------------------------------*- Choupo -*-----------------------*\
  Species C2H (NASA/TP-2002-211556 appendix D entry "C2H"):
  ideal-gas formation data and heat capacity transcribed by machine with
  bin/curate/nasa_tp2002_to_choupo.py table, which holds H and S at
  298.15 K recomputed from the printed coefficients to the printed
  values.  Not read back against the page by a curator.
  The report's own description and sources: Ervin, 1990. Jacox,1998. Peric,1990. Kanamori,1988.
\*---------------------------------------------------------------------------*/
name           C2H;
formula        C2H;
CAS            n/a;
MW             25.02934;       // kg/kmol, appendix D record line
role           radical;       // gas-only (DEV.md 4c C458): stays in the vapour, refused where no vapour holds it
tags           ( gasPhase thermoTable );
nasaEntry      "C2H";
reviewStatus   interim;
reviewReason   "transcribed by machine from NASA/TP-2002-211556 into the thermoTables home and checked against the report itself; not yet read back against the page by a curator";
standardThermochemistry
{
    dHf_298    566200.482;   // J/mol  -- ideal gas; NASA/TP-2002-211556 appendix D, p. 88, entry C2H
    s_298      213.304;     // J/(mol·K) -- third-law absolute; Table B1, p. 15
}

idealGasHeatCapacity
{
    //  NASA/TP-2002-211556 eq. (1), Cp/R = a1/T^2 + a2/T + a3 + a4 T + a5 T^2
    //  + a6 T^3 + a7 T^4; appendix D, p. 88, entry C2H, a1..a7 as printed.
    model    NASA9;
    Tlow     200;
    Tcommon  1000;
    Thigh    6000;
    low      ( 1.343669487e+04 -5.067970720e+02 7.772107410e+00 -6.512339820e-03 1.030117855e-05 -5.880147670e-09 1.226901861e-12 );
    high     ( 3.922334570e+06 -1.204751703e+04 1.756172920e+01 -3.655442940e-03 6.987685430e-07 -6.825162010e-11 2.719262793e-15 );
}

provenance
{
    dHf_298
    {
        origin        literature;
        method        "NASA/TP-2002-211556 appendix D, p. 88, entry C2H, record-line H(298.15) (elements reference, so = dHf)";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "Table B1 p. 15 prints 566.2 kJ/mol; the report's own sources: Ervin, 1990. Jacox,1998. Peric,1990. Kanamori,1988.";
    }
    s_298
    {
        origin        literature;
        method        "NASA/TP-2002-211556 Table B1, p. 15, entry C2H";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "appendix D's coefficients with b2 integrate to 213.304";
    }
    idealGasHeatCapacity
    {
        origin        literature;
        method        "NASA/TP-2002-211556 appendix D, p. 88, entry C2H, a1..a7 of the 200-1000 K and 1000-6000 K intervals, as printed";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "read by bin/curate/nasa_tp2002_to_choupo.py, which holds H and S at 298.15 K to the printed values";
    }
    source   "McBride, Zehe & Gordon, NASA Glenn Coefficients for Calculating Thermodynamic Properties of Individual Species, NASA/TP-2002-211556 (2002)";
    licence  publicDomain;    // US government work (NASA), 17 U.S.C. 105
}
