/*--------------------------------*- Choupo -*-----------------------*\
  Species BO2 (NASA/TP-2002-211556 appendix D entry "BO2"):
  ideal-gas formation data and heat capacity transcribed by machine with
  bin/curate/nasa_tp2002_to_choupo.py table, which holds H and S at
  298.15 K recomputed from the printed coefficients to the printed
  values.  Not read back against the page by a curator.
  The report's own description and sources: Gurvich,1996a pt1 p14 pt2 p11.
\*---------------------------------------------------------------------------*/
name           BO2;
formula        BO2;
CAS            n/a;
MW             42.8098;       // kg/kmol, appendix D record line
role           gasOnly;       // free radical (odd electron count 21)
tags           ( gasPhase thermoTable );
nasaEntry      "BO2";
reviewStatus   interim;
reviewReason   "transcribed by machine from NASA/TP-2002-211556 into the thermoTables home and checked against the report itself; not yet read back against the page by a curator";
standardThermochemistry
{
    dHf_298    -309121.947;   // J/mol  -- ideal gas; NASA/TP-2002-211556 appendix D, p. 61, entry BO2
    s_298      230.138;     // J/(mol·K) -- third-law absolute; Table B1, p. 11
}

idealGasHeatCapacity
{
    //  NASA/TP-2002-211556 eq. (1), Cp/R = a1/T^2 + a2/T + a3 + a4 T + a5 T^2
    //  + a6 T^3 + a7 T^4; appendix D, p. 61, entry BO2, a1..a7 as printed.
    model    NASA9;
    Tlow     200;
    Tcommon  1000;
    Thigh    6000;
    low      ( -4.141090640e+04 7.198854610e+02 -1.477629435e+00 2.277415194e-02 -2.786326934e-05 1.718462069e-08 -4.278991440e-12 );
    high     ( -3.834452340e+04 -9.563261140e+02 8.200962780e+00 -2.062130802e-04 9.872288990e-09 8.158366760e-12 -7.527519660e-16 );
}

provenance
{
    dHf_298
    {
        origin        literature;
        method        "NASA/TP-2002-211556 appendix D, p. 61, entry BO2, record-line H(298.15) (elements reference, so = dHf)";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "Table B1 p. 11 prints -309.122 kJ/mol; the report's own sources: Gurvich,1996a pt1 p14 pt2 p11.";
    }
    s_298
    {
        origin        literature;
        method        "NASA/TP-2002-211556 Table B1, p. 11, entry BO2";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "appendix D's coefficients with b2 integrate to 230.138";
    }
    idealGasHeatCapacity
    {
        origin        literature;
        method        "NASA/TP-2002-211556 appendix D, p. 61, entry BO2, a1..a7 of the 200-1000 K and 1000-6000 K intervals, as printed";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "read by bin/curate/nasa_tp2002_to_choupo.py, which holds H and S at 298.15 K to the printed values";
    }
    source   "McBride, Zehe & Gordon, NASA Glenn Coefficients for Calculating Thermodynamic Properties of Individual Species, NASA/TP-2002-211556 (2002)";
    licence  publicDomain;    // US government work (NASA), 17 U.S.C. 105
}
