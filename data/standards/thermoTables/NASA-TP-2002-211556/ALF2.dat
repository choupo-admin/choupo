/*--------------------------------*- Choupo -*-----------------------*\
  Species ALF2 (NASA/TP-2002-211556 appendix D entry "ALF2"):
  ideal-gas formation data and heat capacity transcribed by machine with
  bin/curate/nasa_tp2002_to_choupo.py table, which holds H and S at
  298.15 K recomputed from the printed coefficients to the printed
  values.  Not read back against the page by a curator.
  The report's own description and sources: Gurvich,1996a pt1 p153 pt2 p117.
\*---------------------------------------------------------------------------*/
name           ALF2;
formula        AlF2;
CAS            n/a;
MW             64.97834;       // kg/kmol, appendix D record line
role           gasOnly;       // free radical (odd electron count 31)
tags           ( gasPhase thermoTable );
nasaEntry      "ALF2";
reviewStatus   interim;
reviewReason   "transcribed by machine from NASA/TP-2002-211556 into the thermoTables home and checked against the report itself; not yet read back against the page by a curator";
standardThermochemistry
{
    dHf_298    -631764.175;   // J/mol  -- ideal gas; NASA/TP-2002-211556 appendix D, p. 48, entry ALF2
    s_298      264.924;     // J/(mol·K) -- third-law absolute; Table B1, p. 9
}

idealGasHeatCapacity
{
    //  NASA/TP-2002-211556 eq. (1), Cp/R = a1/T^2 + a2/T + a3 + a4 T + a5 T^2
    //  + a6 T^3 + a7 T^4; appendix D, p. 48, entry ALF2, a1..a7 as printed.
    model    NASA9;
    Tlow     200;
    Tcommon  1000;
    Thigh    6000;
    low      ( 2.994951991e+04 -2.194199915e+02 3.416748760e+00 1.272953936e-02 -1.883312206e-05 1.330702256e-08 -3.680118630e-12 );
    high     ( -2.146896245e+05 3.096840150e+01 6.816399620e+00 1.820129379e-04 -7.793677440e-08 1.472534201e-11 -8.803695300e-16 );
}

provenance
{
    dHf_298
    {
        origin        literature;
        method        "NASA/TP-2002-211556 appendix D, p. 48, entry ALF2, record-line H(298.15) (elements reference, so = dHf)";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "Table B1 p. 9 prints -631.764 kJ/mol; the report's own sources: Gurvich,1996a pt1 p153 pt2 p117.";
    }
    s_298
    {
        origin        literature;
        method        "NASA/TP-2002-211556 Table B1, p. 9, entry ALF2";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "appendix D's coefficients with b2 integrate to 264.924";
    }
    idealGasHeatCapacity
    {
        origin        literature;
        method        "NASA/TP-2002-211556 appendix D, p. 48, entry ALF2, a1..a7 of the 200-1000 K and 1000-6000 K intervals, as printed";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "read by bin/curate/nasa_tp2002_to_choupo.py, which holds H and S at 298.15 K to the printed values";
    }
    source   "McBride, Zehe & Gordon, NASA Glenn Coefficients for Calculating Thermodynamic Properties of Individual Species, NASA/TP-2002-211556 (2002)";
    licence  publicDomain;    // US government work (NASA), 17 U.S.C. 105
}
