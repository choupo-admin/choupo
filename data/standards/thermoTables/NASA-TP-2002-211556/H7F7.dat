/*--------------------------------*- Choupo -*-----------------------*\
  Species H7F7 (NASA/TP-2002-211556 appendix D entry "H7F7"):
  ideal-gas formation data and heat capacity transcribed by machine with
  bin/curate/nasa_tp2002_to_choupo.py table, which holds H and S at
  298.15 K recomputed from the printed coefficients to the printed
  values.  Not read back against the page by a curator.
  The report's own description and sources: Gurvich,1989 pt1 p170 pt2 p313.
\*---------------------------------------------------------------------------*/
name           H7F7;
formula        H7F7;
CAS            n/a;
MW             140.0444;       // kg/kmol, appendix D record line
role           gasData;       // closed-shell molecule (or noble gas): ideal-gas data only, no liquid model
tags           ( gasPhase thermoTable );
nasaEntry      "H7F7";
reviewStatus   interim;
reviewReason   "transcribed by machine from NASA/TP-2002-211556 into the thermoTables home and checked against the report itself; not yet read back against the page by a curator";
standardThermochemistry
{
    dHf_298    -2099698.974;   // J/mol  -- ideal gas; NASA/TP-2002-211556 appendix D, p. 133, entry H7F7
    s_298      548.654;     // J/(mol·K) -- third-law absolute; Table B1, p. 21
}

idealGasHeatCapacity
{
    //  NASA/TP-2002-211556 eq. (1), Cp/R = a1/T^2 + a2/T + a3 + a4 T + a5 T^2
    //  + a6 T^3 + a7 T^4; appendix D, p. 133, entry H7F7, a1..a7 as printed.
    model    NASA9;
    Tlow     200;
    Tcommon  1000;
    Thigh    6000;
    low      ( 2.293867477e+05 -3.220807860e+03 2.362235212e+01 4.366801880e-02 -7.297990340e-05 6.041786420e-08 -1.876025627e-11 );
    high     ( 5.868789830e+06 -2.050863473e+04 4.989176110e+01 -2.640634895e-03 3.949796330e-07 -3.053515088e-11 9.282601780e-16 );
}

provenance
{
    dHf_298
    {
        origin        literature;
        method        "NASA/TP-2002-211556 appendix D, p. 133, entry H7F7, record-line H(298.15) (elements reference, so = dHf)";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "Table B1 p. 21 prints -2099.699 kJ/mol; the report's own sources: Gurvich,1989 pt1 p170 pt2 p313.";
    }
    s_298
    {
        origin        literature;
        method        "NASA/TP-2002-211556 Table B1, p. 21, entry H7F7";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "appendix D's coefficients with b2 integrate to 548.654";
    }
    idealGasHeatCapacity
    {
        origin        literature;
        method        "NASA/TP-2002-211556 appendix D, p. 133, entry H7F7, a1..a7 of the 200-1000 K and 1000-6000 K intervals, as printed";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "read by bin/curate/nasa_tp2002_to_choupo.py, which holds H and S at 298.15 K to the printed values";
    }
    source   "McBride, Zehe & Gordon, NASA Glenn Coefficients for Calculating Thermodynamic Properties of Individual Species, NASA/TP-2002-211556 (2002)";
    licence  publicDomain;    // US government work (NASA), 17 U.S.C. 105
}
