/*--------------------------------*- Choupo -*-----------------------*\
  Species ALF2CL (NASA/TP-2002-211556 appendix D entry "ALF2CL"):
  ideal-gas formation data and heat capacity transcribed by machine with
  bin/curate/nasa_tp2002_to_choupo.py table, which holds H and S at
  298.15 K recomputed from the printed coefficients to the printed
  values.  Not read back against the page by a curator.
  The report's own description and sources: Gurvich,1996a pt1 p182 pt2 p145.
\*---------------------------------------------------------------------------*/
name           ALF2CL;
formula        AlF2Cl;
CAS            n/a;
MW             100.4313;       // kg/kmol, appendix D record line
role           nonvolatile;   // ideal-gas species: no vapour pressure is asked of it
tags           ( gasPhase thermoTable );
nasaEntry      "ALF2CL";
reviewStatus   interim;
reviewReason   "transcribed by machine from NASA/TP-2002-211556 into the thermoTables home and checked against the report itself; not yet read back against the page by a curator";
standardThermochemistry
{
    dHf_298    -999128.145;   // J/mol  -- ideal gas; NASA/TP-2002-211556 appendix D, p. 48, entry ALF2CL
    s_298      298.135;     // J/(mol·K) -- third-law absolute; Table B1, p. 9
}

idealGasHeatCapacity
{
    //  NASA/TP-2002-211556 eq. (1), Cp/R = a1/T^2 + a2/T + a3 + a4 T + a5 T^2
    //  + a6 T^3 + a7 T^4; appendix D, p. 48, entry ALF2CL, a1..a7 as printed.
    model    NASA9;
    Tlow     200;
    Tcommon  1000;
    Thigh    6000;
    low      ( 5.677412090e+04 -8.869829470e+02 8.752746550e+00 8.195791200e-03 -1.380480934e-05 1.032703706e-08 -2.948968416e-12 );
    high     ( -2.115422988e+05 -1.959188681e+02 1.014576850e+01 -5.813219350e-05 1.281071982e-08 -1.465366277e-12 6.776002450e-17 );
}

provenance
{
    dHf_298
    {
        origin        literature;
        method        "NASA/TP-2002-211556 appendix D, p. 48, entry ALF2CL, record-line H(298.15) (elements reference, so = dHf)";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "Table B1 p. 9 prints -999.128 kJ/mol; the report's own sources: Gurvich,1996a pt1 p182 pt2 p145.";
    }
    s_298
    {
        origin        literature;
        method        "NASA/TP-2002-211556 Table B1, p. 9, entry ALF2CL";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "appendix D's coefficients with b2 integrate to 298.135";
    }
    idealGasHeatCapacity
    {
        origin        literature;
        method        "NASA/TP-2002-211556 appendix D, p. 48, entry ALF2CL, a1..a7 of the 200-1000 K and 1000-6000 K intervals, as printed";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "read by bin/curate/nasa_tp2002_to_choupo.py, which holds H and S at 298.15 K to the printed values";
    }
    source   "McBride, Zehe & Gordon, NASA Glenn Coefficients for Calculating Thermodynamic Properties of Individual Species, NASA/TP-2002-211556 (2002)";
    licence  publicDomain;    // US government work (NASA), 17 U.S.C. 105
}
