/*--------------------------------*- Choupo -*-----------------------*\
  Species ALH2 (NASA/TP-2002-211556 appendix D entry "ALH2"):
  ideal-gas formation data and heat capacity transcribed by machine with
  bin/curate/nasa_tp2002_to_choupo.py table, which holds H and S at
  298.15 K recomputed from the printed coefficients to the printed
  values.  Not read back against the page by a curator.
  The report's own description and sources: Gurvich,1996a pt1 p142 pt2 p107.
\*---------------------------------------------------------------------------*/
name           ALH2;
formula        AlH2;
CAS            n/a;
MW             28.99742;       // kg/kmol, appendix D record line
role           gasOnly;       // free radical (odd electron count 15)
tags           ( gasPhase thermoTable );
nasaEntry      "ALH2";
reviewStatus   interim;
reviewReason   "transcribed by machine from NASA/TP-2002-211556 into the thermoTables home and checked against the report itself; not yet read back against the page by a curator";
standardThermochemistry
{
    dHf_298    276774.934;   // J/mol  -- ideal gas; NASA/TP-2002-211556 appendix D, p. 49, entry ALH2
    s_298      213.316;     // J/(mol·K) -- third-law absolute; Table B1, p. 9
}

idealGasHeatCapacity
{
    //  NASA/TP-2002-211556 eq. (1), Cp/R = a1/T^2 + a2/T + a3 + a4 T + a5 T^2
    //  + a6 T^3 + a7 T^4; appendix D, p. 49, entry ALH2, a1..a7 as printed.
    model    NASA9;
    Tlow     200;
    Tcommon  1000;
    Thigh    6000;
    low      ( 1.455182996e+04 -2.153768996e+02 5.144370230e+00 -3.965222030e-03 1.340900203e-05 -1.216744854e-08 3.743107130e-12 );
    high     ( 1.432910601e+05 -2.365907684e+03 9.085667190e+00 -1.308536612e-03 4.777191360e-07 -7.324721890e-11 3.997900940e-15 );
}

provenance
{
    dHf_298
    {
        origin        literature;
        method        "NASA/TP-2002-211556 appendix D, p. 49, entry ALH2, record-line H(298.15) (elements reference, so = dHf)";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "Table B1 p. 9 prints 276.775 kJ/mol; the report's own sources: Gurvich,1996a pt1 p142 pt2 p107.";
    }
    s_298
    {
        origin        literature;
        method        "NASA/TP-2002-211556 Table B1, p. 9, entry ALH2";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "appendix D's coefficients with b2 integrate to 213.316";
    }
    idealGasHeatCapacity
    {
        origin        literature;
        method        "NASA/TP-2002-211556 appendix D, p. 49, entry ALH2, a1..a7 of the 200-1000 K and 1000-6000 K intervals, as printed";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "read by bin/curate/nasa_tp2002_to_choupo.py, which holds H and S at 298.15 K to the printed values";
    }
    source   "McBride, Zehe & Gordon, NASA Glenn Coefficients for Calculating Thermodynamic Properties of Individual Species, NASA/TP-2002-211556 (2002)";
    licence  publicDomain;    // US government work (NASA), 17 U.S.C. 105
}
