/*--------------------------------*- Choupo -*-----------------------*\
  Species SiHCL (NASA/TP-2002-211556 appendix D entry "SiHCL"):
  ideal-gas formation data and heat capacity transcribed by machine with
  bin/curate/nasa_tp2002_to_choupo.py table, which holds H and S at
  298.15 K recomputed from the printed coefficients to the printed
  values.  Not read back against the page by a curator.
  The report's own description and sources: Gurvich,1991 pt1 p277 pt2 p247.
\*---------------------------------------------------------------------------*/
name           SiHCL;
formula        SiHCl;
CAS            n/a;
MW             64.54644;       // kg/kmol, appendix D record line
role           nonvolatile;   // ideal-gas species: no vapour pressure is asked of it
tags           ( gasPhase thermoTable );
nasaEntry      "SiHCL";
reviewStatus   interim;
reviewReason   "transcribed by machine from NASA/TP-2002-211556 into the thermoTables home and checked against the report itself; not yet read back against the page by a curator";
standardThermochemistry
{
    dHf_298    54945.913;   // J/mol  -- ideal gas; NASA/TP-2002-211556 appendix D, p. 189, entry SiHCL
    s_298      251.334;     // J/(mol·K) -- third-law absolute; Table B1, p. 29
}

idealGasHeatCapacity
{
    //  NASA/TP-2002-211556 eq. (1), Cp/R = a1/T^2 + a2/T + a3 + a4 T + a5 T^2
    //  + a6 T^3 + a7 T^4; appendix D, p. 189, entry SiHCL, a1..a7 as printed.
    model    NASA9;
    Tlow     200;
    Tcommon  1000;
    Thigh    6000;
    low      ( 5.909673050e+04 -8.780064030e+02 7.999687930e+00 -4.663141270e-03 8.594986000e-06 -6.608073550e-09 1.868076396e-12 );
    high     ( 1.012152890e+05 -1.163239598e+03 7.376366550e+00 1.874151313e-04 -1.661351093e-07 3.964414040e-11 -2.640580080e-15 );
}

provenance
{
    dHf_298
    {
        origin        literature;
        method        "NASA/TP-2002-211556 appendix D, p. 189, entry SiHCL, record-line H(298.15) (elements reference, so = dHf)";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "Table B1 p. 29 prints 54.946 kJ/mol; the report's own sources: Gurvich,1991 pt1 p277 pt2 p247.";
    }
    s_298
    {
        origin        literature;
        method        "NASA/TP-2002-211556 Table B1, p. 29, entry SiHCL";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "appendix D's coefficients with b2 integrate to 251.334";
    }
    idealGasHeatCapacity
    {
        origin        literature;
        method        "NASA/TP-2002-211556 appendix D, p. 189, entry SiHCL, a1..a7 of the 200-1000 K and 1000-6000 K intervals, as printed";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "read by bin/curate/nasa_tp2002_to_choupo.py, which holds H and S at 298.15 K to the printed values";
    }
    source   "McBride, Zehe & Gordon, NASA Glenn Coefficients for Calculating Thermodynamic Properties of Individual Species, NASA/TP-2002-211556 (2002)";
    licence  publicDomain;    // US government work (NASA), 17 U.S.C. 105
}
