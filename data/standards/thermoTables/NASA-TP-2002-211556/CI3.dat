/*--------------------------------*- Choupo -*-----------------------*\
  Species CI3 (NASA/TP-2002-211556 appendix D entry "CI3"):
  ideal-gas formation data and heat capacity transcribed by machine with
  bin/curate/nasa_tp2002_to_choupo.py table, which holds H and S at
  298.15 K recomputed from the printed coefficients to the printed
  values.  Not read back against the page by a curator.
  The report's own description and sources: Gurvich,1991 pt1 p178 pt2 p162.
\*---------------------------------------------------------------------------*/
name           CI3;
formula        CI3;
CAS            n/a;
MW             392.7241;       // kg/kmol, appendix D record line
role           gasOnly;       // free radical (odd electron count 165)
tags           ( gasPhase thermoTable );
nasaEntry      "CI3";
reviewStatus   interim;
reviewReason   "transcribed by machine from NASA/TP-2002-211556 into the thermoTables home and checked against the report itself; not yet read back against the page by a curator";
standardThermochemistry
{
    dHf_298    405983.951;   // J/mol  -- ideal gas; NASA/TP-2002-211556 appendix D, p. 83, entry CI3
    s_298      361.033;     // J/(mol·K) -- third-law absolute; Table B1, p. 14
}

idealGasHeatCapacity
{
    //  NASA/TP-2002-211556 eq. (1), Cp/R = a1/T^2 + a2/T + a3 + a4 T + a5 T^2
    //  + a6 T^3 + a7 T^4; appendix D, p. 83, entry CI3, a1..a7 as printed.
    model    NASA9;
    Tlow     200;
    Tcommon  1000;
    Thigh    6000;
    low      ( 8.596784250e+04 -1.347703793e+03 1.272103659e+01 -2.442876357e-03 2.511609978e-07 1.024658583e-09 -4.872692960e-13 );
    high     ( -1.536511918e+05 -8.357044370e+01 1.006203125e+01 -2.466447336e-05 5.419054750e-09 -6.181417000e-13 2.851262022e-17 );
}

provenance
{
    dHf_298
    {
        origin        literature;
        method        "NASA/TP-2002-211556 appendix D, p. 83, entry CI3, record-line H(298.15) (elements reference, so = dHf)";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "Table B1 p. 14 prints 405.984 kJ/mol; the report's own sources: Gurvich,1991 pt1 p178 pt2 p162.";
    }
    s_298
    {
        origin        literature;
        method        "NASA/TP-2002-211556 Table B1, p. 14, entry CI3";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "appendix D's coefficients with b2 integrate to 361.033";
    }
    idealGasHeatCapacity
    {
        origin        literature;
        method        "NASA/TP-2002-211556 appendix D, p. 83, entry CI3, a1..a7 of the 200-1000 K and 1000-6000 K intervals, as printed";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "read by bin/curate/nasa_tp2002_to_choupo.py, which holds H and S at 298.15 K to the printed values";
    }
    source   "McBride, Zehe & Gordon, NASA Glenn Coefficients for Calculating Thermodynamic Properties of Individual Species, NASA/TP-2002-211556 (2002)";
    licence  publicDomain;    // US government work (NASA), 17 U.S.C. 105
}
