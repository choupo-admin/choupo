/*--------------------------------*- Choupo -*-----------------------*\
  Species VCL4 (NASA/TP-2002-211556 appendix D entry "VCL4"):
  ideal-gas formation data and heat capacity transcribed by machine with
  bin/curate/nasa_tp2002_to_choupo.py table, which holds H and S at
  298.15 K recomputed from the printed coefficients to the printed
  values.  Not read back against the page by a curator.
  The report's own description and sources: Nagarajan,1963. Creighton,1966. Blankenship,1962.
\*---------------------------------------------------------------------------*/
name           VCL4;
formula        VCl4;
CAS            n/a;
MW             192.7535;       // kg/kmol, appendix D record line
role           gasData;       // odd-electron d-block/actinide compound: stable, has condensed phases (not a radical)
tags           ( gasPhase thermoTable );
nasaEntry      "VCL4";
reviewStatus   interim;
reviewReason   "transcribed by machine from NASA/TP-2002-211556 into the thermoTables home and checked against the report itself; not yet read back against the page by a curator";
standardThermochemistry
{
    dHf_298    -527058.480;   // J/mol  -- ideal gas; NASA/TP-2002-211556 appendix D, p. 206, entry VCL4
    s_298      366.518;     // J/(mol·K) -- third-law absolute; Table B1, p. 31
}

idealGasHeatCapacity
{
    //  NASA/TP-2002-211556 eq. (1), Cp/R = a1/T^2 + a2/T + a3 + a4 T + a5 T^2
    //  + a6 T^3 + a7 T^4; appendix D, p. 206, entry VCL4, a1..a7 as printed.
    model    NASA9;
    Tlow     200;
    Tcommon  1000;
    Thigh    6000;
    low      ( 7.719834710e+04 -1.702854040e+03 1.882697965e+01 -1.130896832e-02 1.266950765e-05 -7.625019340e-09 1.907582465e-12 );
    high     ( -1.717776251e+06 4.550441050e+03 8.164464800e+00 2.224875998e-03 -4.094111780e-07 3.271787500e-11 -8.858690800e-16 );
}

provenance
{
    dHf_298
    {
        origin        literature;
        method        "NASA/TP-2002-211556 appendix D, p. 206, entry VCL4, record-line H(298.15) (elements reference, so = dHf)";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "Table B1 p. 31 prints -527.058 kJ/mol; the report's own sources: Nagarajan,1963. Creighton,1966. Blankenship,1962.";
    }
    s_298
    {
        origin        literature;
        method        "NASA/TP-2002-211556 Table B1, p. 31, entry VCL4";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "appendix D's coefficients with b2 integrate to 366.518";
    }
    idealGasHeatCapacity
    {
        origin        literature;
        method        "NASA/TP-2002-211556 appendix D, p. 206, entry VCL4, a1..a7 of the 200-1000 K and 1000-6000 K intervals, as printed";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "read by bin/curate/nasa_tp2002_to_choupo.py, which holds H and S at 298.15 K to the printed values";
    }
    source   "McBride, Zehe & Gordon, NASA Glenn Coefficients for Calculating Thermodynamic Properties of Individual Species, NASA/TP-2002-211556 (2002)";
    licence  publicDomain;    // US government work (NASA), 17 U.S.C. 105
}
