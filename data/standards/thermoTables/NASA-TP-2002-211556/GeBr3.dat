/*--------------------------------*- Choupo -*-----------------------*\
  Species GeBr3 (NASA/TP-2002-211556 appendix D entry "GeBr3"):
  ideal-gas formation data and heat capacity transcribed by machine with
  bin/curate/nasa_tp2002_to_choupo.py table, which holds H and S at
  298.15 K recomputed from the printed coefficients to the printed
  values.  Not read back against the page by a curator.
  The report's own description and sources: Gurvich,1991 pt1 p335 pt2 p289.
\*---------------------------------------------------------------------------*/
name           GeBr3;
formula        GeBr3;
CAS            n/a;
MW             312.352;       // kg/kmol, appendix D record line
role           nonvolatile;   // ideal-gas species: no vapour pressure is asked of it
tags           ( gasPhase thermoTable );
nasaEntry      "GeBr3";
reviewStatus   interim;
reviewReason   "transcribed by machine from NASA/TP-2002-211556 into the thermoTables home and checked against the report itself; not yet read back against the page by a curator";
standardThermochemistry
{
    dHf_298    -119031.308;   // J/mol  -- ideal gas; NASA/TP-2002-211556 appendix D, p. 124, entry GeBr3
    s_298      363.176;     // J/(mol·K) -- third-law absolute; Table B1, p. 20
}

idealGasHeatCapacity
{
    //  NASA/TP-2002-211556 eq. (1), Cp/R = a1/T^2 + a2/T + a3 + a4 T + a5 T^2
    //  + a6 T^3 + a7 T^4; appendix D, p. 124, entry GeBr3, a1..a7 as printed.
    model    NASA9;
    Tlow     200;
    Tcommon  1000;
    Thigh    6000;
    low      ( 2.725568677e+03 -5.186213260e+02 1.199957754e+01 -4.251024530e-03 5.103629720e-06 -3.233706250e-09 8.388358860e-13 );
    high     ( -5.433926700e+04 -9.280327950e+00 1.000765019e+01 -3.297322150e-06 7.712929260e-10 -9.241571850e-14 4.432876230e-18 );
}

provenance
{
    dHf_298
    {
        origin        literature;
        method        "NASA/TP-2002-211556 appendix D, p. 124, entry GeBr3, record-line H(298.15) (elements reference, so = dHf)";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "Table B1 p. 20 prints -119.031 kJ/mol; the report's own sources: Gurvich,1991 pt1 p335 pt2 p289.";
    }
    s_298
    {
        origin        literature;
        method        "NASA/TP-2002-211556 Table B1, p. 20, entry GeBr3";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "appendix D's coefficients with b2 integrate to 363.176";
    }
    idealGasHeatCapacity
    {
        origin        literature;
        method        "NASA/TP-2002-211556 appendix D, p. 124, entry GeBr3, a1..a7 of the 200-1000 K and 1000-6000 K intervals, as printed";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "read by bin/curate/nasa_tp2002_to_choupo.py, which holds H and S at 298.15 K to the printed values";
    }
    source   "McBride, Zehe & Gordon, NASA Glenn Coefficients for Calculating Thermodynamic Properties of Individual Species, NASA/TP-2002-211556 (2002)";
    licence  publicDomain;    // US government work (NASA), 17 U.S.C. 105
}
