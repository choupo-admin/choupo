/*--------------------------------*- Choupo -*-----------------------*\
  Species Cs2SO4 (NASA/TP-2002-211556 appendix D entry "Cs2SO4"):
  ideal-gas formation data and heat capacity transcribed by machine with
  bin/curate/nasa_tp2002_to_choupo.py table, which holds H and S at
  298.15 K recomputed from the printed coefficients to the printed
  values.  Not read back against the page by a curator.
  The report's own description and sources: Gurvich,1982 pt1 p497 pt2 p518.
\*---------------------------------------------------------------------------*/
name           Cs2SO4;
formula        Cs2SO4;
CAS            n/a;
MW             361.8735;       // kg/kmol, appendix D record line
role           gasData;       // closed-shell molecule (or noble gas): ideal-gas data only, no liquid model
tags           ( gasPhase thermoTable );
nasaEntry      "Cs2SO4";
reviewStatus   interim;
reviewReason   "transcribed by machine from NASA/TP-2002-211556 into the thermoTables home and checked against the report itself; not yet read back against the page by a curator";
standardThermochemistry
{
    dHf_298    -1117651.834;   // J/mol  -- ideal gas; NASA/TP-2002-211556 appendix D, p. 113, entry Cs2SO4
    s_298      411.179;     // J/(mol·K) -- third-law absolute; Table B1, p. 18
}

idealGasHeatCapacity
{
    //  NASA/TP-2002-211556 eq. (1), Cp/R = a1/T^2 + a2/T + a3 + a4 T + a5 T^2
    //  + a6 T^3 + a7 T^4; appendix D, p. 113, entry Cs2SO4, a1..a7 as printed.
    model    NASA9;
    Tlow     200;
    Tcommon  1000;
    Thigh    6000;
    low      ( 6.153637870e+04 -6.381374330e+02 6.894772090e+00 3.960182910e-02 -5.529862010e-05 3.736332520e-08 -9.973241830e-12 );
    high     ( -5.223397520e+05 -9.444155250e+02 1.970476453e+01 -2.821225990e-04 6.240792280e-08 -7.163464070e-12 3.322667190e-16 );
}

provenance
{
    dHf_298
    {
        origin        literature;
        method        "NASA/TP-2002-211556 appendix D, p. 113, entry Cs2SO4, record-line H(298.15) (elements reference, so = dHf)";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "Table B1 p. 18 prints -1117.652 kJ/mol; the report's own sources: Gurvich,1982 pt1 p497 pt2 p518.";
    }
    s_298
    {
        origin        literature;
        method        "NASA/TP-2002-211556 Table B1, p. 18, entry Cs2SO4";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "appendix D's coefficients with b2 integrate to 411.179";
    }
    idealGasHeatCapacity
    {
        origin        literature;
        method        "NASA/TP-2002-211556 appendix D, p. 113, entry Cs2SO4, a1..a7 of the 200-1000 K and 1000-6000 K intervals, as printed";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "read by bin/curate/nasa_tp2002_to_choupo.py, which holds H and S at 298.15 K to the printed values";
    }
    source   "McBride, Zehe & Gordon, NASA Glenn Coefficients for Calculating Thermodynamic Properties of Individual Species, NASA/TP-2002-211556 (2002)";
    licence  publicDomain;    // US government work (NASA), 17 U.S.C. 105
}
