/*--------------------------------*- Choupo -*-----------------------*\
  Species Rb2O2 (NASA/TP-2002-211556 appendix D entry "Rb2O2"):
  ideal-gas formation data and heat capacity transcribed by machine with
  bin/curate/nasa_tp2002_to_choupo.py table, which holds H and S at
  298.15 K recomputed from the printed coefficients to the printed
  values.  Not read back against the page by a curator.
  The report's own description and sources: Gurvich,1982 pt1 p434 pt2 p457.
\*---------------------------------------------------------------------------*/
name           Rb2O2;
formula        Rb2O2;
CAS            n/a;
MW             202.9344;       // kg/kmol, appendix D record line
role           nonvolatile;   // ideal-gas species: no vapour pressure is asked of it
tags           ( gasPhase thermoTable );
nasaEntry      "Rb2O2";
reviewStatus   interim;
reviewReason   "transcribed by machine from NASA/TP-2002-211556 into the thermoTables home and checked against the report itself; not yet read back against the page by a curator";
standardThermochemistry
{
    dHf_298    -215848.468;   // J/mol  -- ideal gas; NASA/TP-2002-211556 appendix D, p. 178, entry Rb2O2
    s_298      326.309;     // J/(mol·K) -- third-law absolute; Table B1, p. 28
}

idealGasHeatCapacity
{
    //  NASA/TP-2002-211556 eq. (1), Cp/R = a1/T^2 + a2/T + a3 + a4 T + a5 T^2
    //  + a6 T^3 + a7 T^4; appendix D, p. 178, entry Rb2O2, a1..a7 as printed.
    model    NASA9;
    Tlow     200;
    Tcommon  1000;
    Thigh    6000;
    low      ( 3.260553230e+04 -7.578164720e+02 1.070815124e+01 1.148004329e-03 -3.291243670e-06 2.853106637e-09 -8.721590680e-13 );
    high     ( -1.318567396e+05 -9.647737790e+01 1.007222726e+01 -2.894921706e-05 6.405639100e-09 -7.351419390e-13 3.408561710e-17 );
}

provenance
{
    dHf_298
    {
        origin        literature;
        method        "NASA/TP-2002-211556 appendix D, p. 178, entry Rb2O2, record-line H(298.15) (elements reference, so = dHf)";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "Table B1 p. 28 prints -215.848 kJ/mol; the report's own sources: Gurvich,1982 pt1 p434 pt2 p457.";
    }
    s_298
    {
        origin        literature;
        method        "NASA/TP-2002-211556 Table B1, p. 28, entry Rb2O2";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "appendix D's coefficients with b2 integrate to 326.309";
    }
    idealGasHeatCapacity
    {
        origin        literature;
        method        "NASA/TP-2002-211556 appendix D, p. 178, entry Rb2O2, a1..a7 of the 200-1000 K and 1000-6000 K intervals, as printed";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "read by bin/curate/nasa_tp2002_to_choupo.py, which holds H and S at 298.15 K to the printed values";
    }
    source   "McBride, Zehe & Gordon, NASA Glenn Coefficients for Calculating Thermodynamic Properties of Individual Species, NASA/TP-2002-211556 (2002)";
    licence  publicDomain;    // US government work (NASA), 17 U.S.C. 105
}
