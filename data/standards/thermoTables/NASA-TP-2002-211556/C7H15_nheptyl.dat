/*--------------------------------*- Choupo -*-----------------------*\
  Species C7H15_nheptyl (NASA/TP-2002-211556 appendix D entry "C7H15,n-heptyl"):
  ideal-gas formation data and heat capacity transcribed by machine with
  bin/curate/nasa_tp2002_to_choupo.py table, which holds H and S at
  298.15 K recomputed from the printed coefficients to the printed
  values.  Not read back against the page by a curator.
  The report's own description and sources: TRC(10/83) tuvw1930.
\*---------------------------------------------------------------------------*/
name           C7H15_nheptyl;
formula        C7H15;
CAS            n/a;
MW             99.194;       // kg/kmol, appendix D record line
role           gasOnly;       // free radical (odd electron count 57)
tags           ( gasPhase thermoTable );
nasaEntry      "C7H15,n-heptyl";
reviewStatus   interim;
reviewReason   "transcribed by machine from NASA/TP-2002-211556 into the thermoTables home and checked against the report itself; not yet read back against the page by a curator";
standardThermochemistry
{
    dHf_298    4390.000;   // J/mol  -- ideal gas; NASA/TP-2002-211556 appendix D, p. 102, entry C7H15,n-heptyl
    s_298      448.029;     // J/(mol·K) -- third-law absolute; Table B1, p. 17
}

idealGasHeatCapacity
{
    //  NASA/TP-2002-211556 eq. (1), Cp/R = a1/T^2 + a2/T + a3 + a4 T + a5 T^2
    //  + a6 T^3 + a7 T^4; appendix D, p. 102, entry C7H15,n-heptyl, a1..a7 as printed.
    model    NASA9;
    Tlow     200;
    Tcommon  1000;
    Thigh    6000;
    low      ( -1.671733521e+06 2.640010250e+04 -1.526867707e+02 5.027121410e-01 -6.521014030e-04 4.443488110e-07 -1.227815006e-10 );
    high     ( 5.444527570e+06 -3.456829290e+04 7.638651950e+01 -3.298972000e-03 2.343496957e-07 2.467674021e-11 -3.162012849e-15 );
}

provenance
{
    dHf_298
    {
        origin        literature;
        method        "NASA/TP-2002-211556 appendix D, p. 102, entry C7H15,n-heptyl, record-line H(298.15) (elements reference, so = dHf)";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "Table B1 p. 17 prints 4.39 kJ/mol; the report's own sources: TRC(10/83) tuvw1930.";
    }
    s_298
    {
        origin        literature;
        method        "NASA/TP-2002-211556 Table B1, p. 17, entry C7H15,n-heptyl";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "appendix D's coefficients with b2 integrate to 448.029";
    }
    idealGasHeatCapacity
    {
        origin        literature;
        method        "NASA/TP-2002-211556 appendix D, p. 102, entry C7H15,n-heptyl, a1..a7 of the 200-1000 K and 1000-6000 K intervals, as printed";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "read by bin/curate/nasa_tp2002_to_choupo.py, which holds H and S at 298.15 K to the printed values";
    }
    source   "McBride, Zehe & Gordon, NASA Glenn Coefficients for Calculating Thermodynamic Properties of Individual Species, NASA/TP-2002-211556 (2002)";
    licence  publicDomain;    // US government work (NASA), 17 U.S.C. 105
}
