/*--------------------------------*- Choupo -*-----------------------*\
  Species I (NASA/TP-2002-211556 appendix D entry "I"):
  ideal-gas formation data and heat capacity transcribed by machine with
  bin/curate/nasa_tp2002_to_choupo.py table, which holds H and S at
  298.15 K recomputed from the printed coefficients to the printed
  values.  Not read back against the page by a curator.
  The report's own description and sources: Hf:Cox,1989. Moore,1971. Moore,1970a. Gordon,1999.
\*---------------------------------------------------------------------------*/
name           I;
formula        I;
CAS            n/a;
MW             126.9045;       // kg/kmol, appendix D record line
role           gasOnly;       // free atom
tags           ( gasPhase thermoTable );
nasaEntry      "I";
reviewStatus   interim;
reviewReason   "transcribed by machine from NASA/TP-2002-211556 into the thermoTables home and checked against the report itself; not yet read back against the page by a curator";
standardThermochemistry
{
    dHf_298    106760.000;   // J/mol  -- ideal gas; NASA/TP-2002-211556 appendix D, p. 134, entry I
    s_298      180.789;     // J/(mol·K) -- third-law absolute; Table B1, p. 21
}

idealGasHeatCapacity
{
    //  NASA/TP-2002-211556 eq. (1), Cp/R = a1/T^2 + a2/T + a3 + a4 T + a5 T^2
    //  + a6 T^3 + a7 T^4; appendix D, p. 134, entry I, a1..a7 as printed.
    //  The report's 6000-20000 K interval is not transcribed.
    model    NASA9;
    Tlow     200;
    Tcommon  1000;
    Thigh    6000;
    low      ( 1.698199675e+02 -2.716437233e+00 2.517385557e+00 -5.730692070e-05 1.031716184e-07 -9.670641930e-11 3.706471651e-14 );
    high     ( -7.785860570e+05 2.303279568e+03 2.886686091e-03 1.180878463e-03 -2.264074866e-07 1.963511339e-11 -6.243525941e-16 );
}

provenance
{
    dHf_298
    {
        origin        literature;
        method        "NASA/TP-2002-211556 appendix D, p. 134, entry I, record-line H(298.15) (elements reference, so = dHf)";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "Table B1 p. 21 prints 106.76 kJ/mol; the report's own sources: Hf:Cox,1989. Moore,1971. Moore,1970a. Gordon,1999.";
    }
    s_298
    {
        origin        literature;
        method        "NASA/TP-2002-211556 Table B1, p. 21, entry I";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "appendix D's coefficients with b2 integrate to 180.789";
    }
    idealGasHeatCapacity
    {
        origin        literature;
        method        "NASA/TP-2002-211556 appendix D, p. 134, entry I, a1..a7 of the 200-1000 K and 1000-6000 K intervals, as printed";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "read by bin/curate/nasa_tp2002_to_choupo.py, which holds H and S at 298.15 K to the printed values";
    }
    source   "McBride, Zehe & Gordon, NASA Glenn Coefficients for Calculating Thermodynamic Properties of Individual Species, NASA/TP-2002-211556 (2002)";
    licence  publicDomain;    // US government work (NASA), 17 U.S.C. 105
}
