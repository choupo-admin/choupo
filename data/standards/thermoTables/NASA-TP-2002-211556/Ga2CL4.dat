/*--------------------------------*- Choupo -*-----------------------*\
  Species Ga2CL4 (NASA/TP-2002-211556 appendix D entry "Ga2CL4"):
  ideal-gas formation data and heat capacity transcribed by machine with
  bin/curate/nasa_tp2002_to_choupo.py table, which holds H and S at
  298.15 K recomputed from the printed coefficients to the printed
  values.  Not read back against the page by a curator.
  The report's own description and sources: Gurvich,1996a pt1 p237 pt2 p191.
\*---------------------------------------------------------------------------*/
name           Ga2CL4;
formula        Ga2Cl4;
CAS            n/a;
MW             281.258;       // kg/kmol, appendix D record line
role           nonvolatile;   // ideal-gas species: no vapour pressure is asked of it
tags           ( gasPhase thermoTable );
nasaEntry      "Ga2CL4";
reviewStatus   interim;
reviewReason   "transcribed by machine from NASA/TP-2002-211556 into the thermoTables home and checked against the report itself; not yet read back against the page by a curator";
standardThermochemistry
{
    dHf_298    -602326.828;   // J/mol  -- ideal gas; NASA/TP-2002-211556 appendix D, p. 122, entry Ga2CL4
    s_298      419.676;     // J/(mol·K) -- third-law absolute; Table B1, p. 20
}

idealGasHeatCapacity
{
    //  NASA/TP-2002-211556 eq. (1), Cp/R = a1/T^2 + a2/T + a3 + a4 T + a5 T^2
    //  + a6 T^3 + a7 T^4; appendix D, p. 122, entry Ga2CL4, a1..a7 as printed.
    model    NASA9;
    Tlow     200;
    Tcommon  1000;
    Thigh    6000;
    low      ( 1.637343702e+04 -1.140637354e+03 2.030139827e+01 -8.997746200e-03 1.067254867e-05 -6.700290620e-09 1.725749144e-12 );
    high     ( -1.127110409e+05 -2.138517542e+01 1.601738077e+01 -7.415564640e-06 1.721694751e-09 -2.051361953e-13 9.797311500e-18 );
}

provenance
{
    dHf_298
    {
        origin        literature;
        method        "NASA/TP-2002-211556 appendix D, p. 122, entry Ga2CL4, record-line H(298.15) (elements reference, so = dHf)";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "Table B1 p. 20 prints -602.327 kJ/mol; the report's own sources: Gurvich,1996a pt1 p237 pt2 p191.";
    }
    s_298
    {
        origin        literature;
        method        "NASA/TP-2002-211556 Table B1, p. 20, entry Ga2CL4";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "appendix D's coefficients with b2 integrate to 419.676";
    }
    idealGasHeatCapacity
    {
        origin        literature;
        method        "NASA/TP-2002-211556 appendix D, p. 122, entry Ga2CL4, a1..a7 of the 200-1000 K and 1000-6000 K intervals, as printed";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "read by bin/curate/nasa_tp2002_to_choupo.py, which holds H and S at 298.15 K to the printed values";
    }
    source   "McBride, Zehe & Gordon, NASA Glenn Coefficients for Calculating Thermodynamic Properties of Individual Species, NASA/TP-2002-211556 (2002)";
    licence  publicDomain;    // US government work (NASA), 17 U.S.C. 105
}
