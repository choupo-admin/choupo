/*--------------------------------*- Choupo -*-----------------------*\
  Species ALO (NASA/TP-2002-211556 appendix D entry "ALO"):
  ideal-gas formation data and heat capacity transcribed by machine with
  bin/curate/nasa_tp2002_to_choupo.py table, which holds H and S at
  298.15 K recomputed from the printed coefficients to the printed
  values.  Not read back against the page by a curator.
  The report's own description and sources: Gurvich,1996a pt1 p122 pt2 p96.
\*---------------------------------------------------------------------------*/
name           ALO;
formula        AlO;
CAS            n/a;
MW             42.98094;       // kg/kmol, appendix D record line
role           gasOnly;       // free radical (odd electron count 21)
tags           ( gasPhase thermoTable );
nasaEntry      "ALO";
reviewStatus   interim;
reviewReason   "transcribed by machine from NASA/TP-2002-211556 into the thermoTables home and checked against the report itself; not yet read back against the page by a curator";
standardThermochemistry
{
    dHf_298    67319.006;   // J/mol  -- ideal gas; NASA/TP-2002-211556 appendix D, p. 50, entry ALO
    s_298      218.389;     // J/(mol·K) -- third-law absolute; Table B1, p. 10
}

idealGasHeatCapacity
{
    //  NASA/TP-2002-211556 eq. (1), Cp/R = a1/T^2 + a2/T + a3 + a4 T + a5 T^2
    //  + a6 T^3 + a7 T^4; appendix D, p. 50, entry ALO, a1..a7 as printed.
    //  The report's 6000-20000 K interval is not transcribed.
    model    NASA9;
    Tlow     200;
    Tcommon  1000;
    Thigh    6000;
    low      ( -7.683391100e+03 2.957969549e+02 4.808108440e-01 1.169224855e-02 -1.595428871e-05 1.060766814e-08 -2.647888708e-12 );
    high     ( 1.565721161e+04 3.855741010e+03 -5.926079780e+00 9.050960420e-03 -2.930661549e-06 4.238529070e-10 -2.280655341e-14 );
}

provenance
{
    dHf_298
    {
        origin        literature;
        method        "NASA/TP-2002-211556 appendix D, p. 50, entry ALO, record-line H(298.15) (elements reference, so = dHf)";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "Table B1 p. 10 prints 67.319 kJ/mol; the report's own sources: Gurvich,1996a pt1 p122 pt2 p96.";
    }
    s_298
    {
        origin        literature;
        method        "NASA/TP-2002-211556 Table B1, p. 10, entry ALO";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "appendix D's coefficients with b2 integrate to 218.389";
    }
    idealGasHeatCapacity
    {
        origin        literature;
        method        "NASA/TP-2002-211556 appendix D, p. 50, entry ALO, a1..a7 of the 200-1000 K and 1000-6000 K intervals, as printed";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "read by bin/curate/nasa_tp2002_to_choupo.py, which holds H and S at 298.15 K to the printed values";
    }
    source   "McBride, Zehe & Gordon, NASA Glenn Coefficients for Calculating Thermodynamic Properties of Individual Species, NASA/TP-2002-211556 (2002)";
    licence  publicDomain;    // US government work (NASA), 17 U.S.C. 105
}
