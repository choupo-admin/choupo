/*--------------------------------*- Choupo -*-----------------------*\
  Species ALFCL2 (NASA/TP-2002-211556 appendix D entry "ALFCL2"):
  ideal-gas formation data and heat capacity transcribed by machine with
  bin/curate/nasa_tp2002_to_choupo.py table, which holds H and S at
  298.15 K recomputed from the printed coefficients to the printed
  values.  Not read back against the page by a curator.
  The report's own description and sources: Gurvich,1996a pt1 p183 pt2 p146.
\*---------------------------------------------------------------------------*/
name           ALFCL2;
formula        AlFCl2;
CAS            n/a;
MW             116.8859;       // kg/kmol, appendix D record line
role           nonvolatile;   // ideal-gas species: no vapour pressure is asked of it
tags           ( gasPhase thermoTable );
nasaEntry      "ALFCL2";
reviewStatus   interim;
reviewReason   "transcribed by machine from NASA/TP-2002-211556 into the thermoTables home and checked against the report itself; not yet read back against the page by a curator";
standardThermochemistry
{
    dHf_298    -791395.404;   // J/mol  -- ideal gas; NASA/TP-2002-211556 appendix D, p. 48, entry ALFCL2
    s_298      311.383;     // J/(mol·K) -- third-law absolute; Table B1, p. 9
}

idealGasHeatCapacity
{
    //  NASA/TP-2002-211556 eq. (1), Cp/R = a1/T^2 + a2/T + a3 + a4 T + a5 T^2
    //  + a6 T^3 + a7 T^4; appendix D, p. 48, entry ALFCL2, a1..a7 as printed.
    model    NASA9;
    Tlow     200;
    Tcommon  1000;
    Thigh    6000;
    low      ( 6.955607340e+04 -1.188857902e+03 1.156672590e+01 4.574959490e-04 -3.407372830e-06 3.356822540e-09 -1.085329228e-12 );
    high     ( -1.720360526e+05 -1.193340759e+02 1.008894431e+01 -3.550993810e-05 7.830952610e-09 -8.961734230e-13 4.145330260e-17 );
}

provenance
{
    dHf_298
    {
        origin        literature;
        method        "NASA/TP-2002-211556 appendix D, p. 48, entry ALFCL2, record-line H(298.15) (elements reference, so = dHf)";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "Table B1 p. 9 prints -791.395 kJ/mol; the report's own sources: Gurvich,1996a pt1 p183 pt2 p146.";
    }
    s_298
    {
        origin        literature;
        method        "NASA/TP-2002-211556 Table B1, p. 9, entry ALFCL2";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "appendix D's coefficients with b2 integrate to 311.383";
    }
    idealGasHeatCapacity
    {
        origin        literature;
        method        "NASA/TP-2002-211556 appendix D, p. 48, entry ALFCL2, a1..a7 of the 200-1000 K and 1000-6000 K intervals, as printed";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "read by bin/curate/nasa_tp2002_to_choupo.py, which holds H and S at 298.15 K to the printed values";
    }
    source   "McBride, Zehe & Gordon, NASA Glenn Coefficients for Calculating Thermodynamic Properties of Individual Species, NASA/TP-2002-211556 (2002)";
    licence  publicDomain;    // US government work (NASA), 17 U.S.C. 105
}
