/*--------------------------------*- Choupo -*-----------------------*\
  Species C10H21_ndecyl (NASA/TP-2002-211556 appendix D entry "C10H21,n-decyl"):
  ideal-gas formation data and heat capacity transcribed by machine with
  bin/curate/nasa_tp2002_to_choupo.py table, which holds H and S at
  298.15 K recomputed from the printed coefficients to the printed
  values.  Not read back against the page by a curator.
  The report's own description and sources: TRC(10/83) tuvw1930.
\*---------------------------------------------------------------------------*/
name           C10H21_ndecyl;
formula        C10H21;
CAS            n/a;
MW             141.2737;       // kg/kmol, appendix D record line
role           gasOnly;       // free radical (odd electron count 81)
tags           ( gasPhase thermoTable );
nasaEntry      "C10H21,n-decyl";
reviewStatus   interim;
reviewReason   "transcribed by machine from NASA/TP-2002-211556 into the thermoTables home and checked against the report itself; not yet read back against the page by a curator";
standardThermochemistry
{
    dHf_298    -57740.000;   // J/mol  -- ideal gas; NASA/TP-2002-211556 appendix D, p. 103, entry C10H21,n-decyl
    s_298      567.109;     // J/(mol·K) -- third-law absolute; Table B1, p. 17
}

idealGasHeatCapacity
{
    //  NASA/TP-2002-211556 eq. (1), Cp/R = a1/T^2 + a2/T + a3 + a4 T + a5 T^2
    //  + a6 T^3 + a7 T^4; appendix D, p. 103, entry C10H21,n-decyl, a1..a7 as printed.
    model    NASA9;
    Tlow     200;
    Tcommon  1000;
    Thigh    6000;
    low      ( -2.446511152e+06 3.870081300e+04 -2.244388176e+02 7.343624970e-01 -9.513525600e-04 6.462970330e-07 -1.781502862e-10 );
    high     ( 4.967237760e+06 -4.242468440e+04 1.028853417e+02 -2.324848180e-03 -2.284233900e-07 1.056127364e-10 -8.068065900e-15 );
}

provenance
{
    dHf_298
    {
        origin        literature;
        method        "NASA/TP-2002-211556 appendix D, p. 103, entry C10H21,n-decyl, record-line H(298.15) (elements reference, so = dHf)";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "Table B1 p. 17 prints -57.74 kJ/mol; the report's own sources: TRC(10/83) tuvw1930.";
    }
    s_298
    {
        origin        literature;
        method        "NASA/TP-2002-211556 Table B1, p. 17, entry C10H21,n-decyl";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "appendix D's coefficients with b2 integrate to 567.109";
    }
    idealGasHeatCapacity
    {
        origin        literature;
        method        "NASA/TP-2002-211556 appendix D, p. 103, entry C10H21,n-decyl, a1..a7 of the 200-1000 K and 1000-6000 K intervals, as printed";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "read by bin/curate/nasa_tp2002_to_choupo.py, which holds H and S at 298.15 K to the printed values";
    }
    source   "McBride, Zehe & Gordon, NASA Glenn Coefficients for Calculating Thermodynamic Properties of Individual Species, NASA/TP-2002-211556 (2002)";
    licence  publicDomain;    // US government work (NASA), 17 U.S.C. 105
}
