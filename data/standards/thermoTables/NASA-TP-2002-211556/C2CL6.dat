/*--------------------------------*- Choupo -*-----------------------*\
  Species C2CL6 (NASA/TP-2002-211556 appendix D entry "C2CL6"):
  ideal-gas formation data and heat capacity transcribed by machine with
  bin/curate/nasa_tp2002_to_choupo.py table, which holds H and S at
  298.15 K recomputed from the printed coefficients to the printed
  values.  Not read back against the page by a curator.
  The report's own description and sources: Hf:Manion,2002. Gurvich,1991 pt1 p117 pt2 p90.
\*---------------------------------------------------------------------------*/
name           C2CL6;
formula        C2Cl6;
CAS            n/a;
MW             236.7376;       // kg/kmol, appendix D record line
role           radical;       // gas-only (DEV.md 4c C458): stays in the vapour, refused where no vapour holds it
tags           ( gasPhase thermoTable );
nasaEntry      "C2CL6";
reviewStatus   interim;
reviewReason   "transcribed by machine from NASA/TP-2002-211556 into the thermoTables home and checked against the report itself; not yet read back against the page by a curator";
standardThermochemistry
{
    dHf_298    -148200.000;   // J/mol  -- ideal gas; NASA/TP-2002-211556 appendix D, p. 87, entry C2CL6
    s_298      398.632;     // J/(mol·K) -- third-law absolute; Table B1, p. 15
}

idealGasHeatCapacity
{
    //  NASA/TP-2002-211556 eq. (1), Cp/R = a1/T^2 + a2/T + a3 + a4 T + a5 T^2
    //  + a6 T^3 + a7 T^4; appendix D, p. 87, entry C2CL6, a1..a7 as printed.
    model    NASA9;
    Tlow     200;
    Tcommon  1000;
    Thigh    6000;
    low      ( 1.593451813e+05 -2.606697136e+03 2.028011847e+01 1.769364822e-02 -3.133105185e-05 2.389395238e-08 -6.893038300e-12 );
    high     ( -5.577386320e+05 -4.976491240e+02 2.237041989e+01 -1.477759098e-04 3.257546580e-08 -3.727099210e-12 1.723801704e-16 );
}

provenance
{
    dHf_298
    {
        origin        literature;
        method        "NASA/TP-2002-211556 appendix D, p. 87, entry C2CL6, record-line H(298.15) (elements reference, so = dHf)";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "Table B1 p. 15 prints -148.2 kJ/mol; the report's own sources: Hf:Manion,2002. Gurvich,1991 pt1 p117 pt2 p90.";
    }
    s_298
    {
        origin        literature;
        method        "NASA/TP-2002-211556 Table B1, p. 15, entry C2CL6";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "appendix D's coefficients with b2 integrate to 398.632";
    }
    idealGasHeatCapacity
    {
        origin        literature;
        method        "NASA/TP-2002-211556 appendix D, p. 87, entry C2CL6, a1..a7 of the 200-1000 K and 1000-6000 K intervals, as printed";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "read by bin/curate/nasa_tp2002_to_choupo.py, which holds H and S at 298.15 K to the printed values";
    }
    source   "McBride, Zehe & Gordon, NASA Glenn Coefficients for Calculating Thermodynamic Properties of Individual Species, NASA/TP-2002-211556 (2002)";
    licence  publicDomain;    // US government work (NASA), 17 U.S.C. 105
}
