/*--------------------------------*- Choupo -*-----------------------*\
  Species BHF2 (NASA/TP-2002-211556 appendix D entry "BHF2"):
  ideal-gas formation data and heat capacity transcribed by machine with
  bin/curate/nasa_tp2002_to_choupo.py table, which holds H and S at
  298.15 K recomputed from the printed coefficients to the printed
  values.  Not read back against the page by a curator.
  The report's own description and sources: Gurvich,1996a pt1 p69 pt2 p47.
\*---------------------------------------------------------------------------*/
name           BHF2;
formula        BHF2;
CAS            n/a;
MW             49.81575;       // kg/kmol, appendix D record line
role           nonvolatile;   // ideal-gas species: no vapour pressure is asked of it
tags           ( gasPhase thermoTable );
nasaEntry      "BHF2";
reviewStatus   interim;
reviewReason   "transcribed by machine from NASA/TP-2002-211556 into the thermoTables home and checked against the report itself; not yet read back against the page by a curator";
standardThermochemistry
{
    dHf_298    -739613.811;   // J/mol  -- ideal gas; NASA/TP-2002-211556 appendix D, p. 59, entry BHF2
    s_298      244.323;     // J/(mol·K) -- third-law absolute; Table B1, p. 11
}

idealGasHeatCapacity
{
    //  NASA/TP-2002-211556 eq. (1), Cp/R = a1/T^2 + a2/T + a3 + a4 T + a5 T^2
    //  + a6 T^3 + a7 T^4; appendix D, p. 59, entry BHF2, a1..a7 as printed.
    model    NASA9;
    Tlow     200;
    Tcommon  1000;
    Thigh    6000;
    low      ( -8.353540280e+04 1.616659766e+03 -8.161405670e+00 4.153786790e-02 -4.921063280e-05 3.054165306e-08 -7.786813980e-12 );
    high     ( 4.660876960e+05 -3.728100490e+03 1.244152658e+01 -8.906843190e-04 1.841732568e-07 -2.010774349e-11 8.979196590e-16 );
}

provenance
{
    dHf_298
    {
        origin        literature;
        method        "NASA/TP-2002-211556 appendix D, p. 59, entry BHF2, record-line H(298.15) (elements reference, so = dHf)";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "Table B1 p. 11 prints -739.614 kJ/mol; the report's own sources: Gurvich,1996a pt1 p69 pt2 p47.";
    }
    s_298
    {
        origin        literature;
        method        "NASA/TP-2002-211556 Table B1, p. 11, entry BHF2";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "appendix D's coefficients with b2 integrate to 244.323";
    }
    idealGasHeatCapacity
    {
        origin        literature;
        method        "NASA/TP-2002-211556 appendix D, p. 59, entry BHF2, a1..a7 of the 200-1000 K and 1000-6000 K intervals, as printed";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "read by bin/curate/nasa_tp2002_to_choupo.py, which holds H and S at 298.15 K to the printed values";
    }
    source   "McBride, Zehe & Gordon, NASA Glenn Coefficients for Calculating Thermodynamic Properties of Individual Species, NASA/TP-2002-211556 (2002)";
    licence  publicDomain;    // US government work (NASA), 17 U.S.C. 105
}
