/*--------------------------------*- Choupo -*-----------------------*\
  Species CCL3Br (NASA/TP-2002-211556 appendix D entry "CCL3Br"):
  ideal-gas formation data and heat capacity transcribed by machine with
  bin/curate/nasa_tp2002_to_choupo.py table, which holds H and S at
  298.15 K recomputed from the printed coefficients to the printed
  values.  Not read back against the page by a curator.
  The report's own description and sources: Gurvich,1991 pt1 p169 pt2 p150.
\*---------------------------------------------------------------------------*/
name           CCL3Br;
formula        CCl3Br;
CAS            n/a;
MW             198.2737;       // kg/kmol, appendix D record line
role           nonvolatile;   // ideal-gas species: no vapour pressure is asked of it
tags           ( gasPhase thermoTable );
nasaEntry      "CCL3Br";
reviewStatus   interim;
reviewReason   "transcribed by machine from NASA/TP-2002-211556 into the thermoTables home and checked against the report itself; not yet read back against the page by a curator";
standardThermochemistry
{
    dHf_298    -43000.000;   // J/mol  -- ideal gas; NASA/TP-2002-211556 appendix D, p. 76, entry CCL3Br
    s_298      333.580;     // J/(mol·K) -- third-law absolute; Table B1, p. 13
}

idealGasHeatCapacity
{
    //  NASA/TP-2002-211556 eq. (1), Cp/R = a1/T^2 + a2/T + a3 + a4 T + a5 T^2
    //  + a6 T^3 + a7 T^4; appendix D, p. 76, entry CCL3Br, a1..a7 as printed.
    model    NASA9;
    Tlow     200;
    Tcommon  1000;
    Thigh    6000;
    low      ( 1.049668463e+05 -1.793828482e+03 1.489250892e+01 2.397128310e-03 -7.789615470e-06 7.016617110e-09 -2.196069746e-12 );
    high     ( -2.772324186e+05 -1.840310333e+02 1.313673812e+01 -5.443910010e-05 1.197658923e-08 -1.367818632e-12 6.316164790e-17 );
}

provenance
{
    dHf_298
    {
        origin        literature;
        method        "NASA/TP-2002-211556 appendix D, p. 76, entry CCL3Br, record-line H(298.15) (elements reference, so = dHf)";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "Table B1 p. 13 prints -43.0 kJ/mol; the report's own sources: Gurvich,1991 pt1 p169 pt2 p150.";
    }
    s_298
    {
        origin        literature;
        method        "NASA/TP-2002-211556 Table B1, p. 13, entry CCL3Br";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "appendix D's coefficients with b2 integrate to 333.580";
    }
    idealGasHeatCapacity
    {
        origin        literature;
        method        "NASA/TP-2002-211556 appendix D, p. 76, entry CCL3Br, a1..a7 of the 200-1000 K and 1000-6000 K intervals, as printed";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "read by bin/curate/nasa_tp2002_to_choupo.py, which holds H and S at 298.15 K to the printed values";
    }
    source   "McBride, Zehe & Gordon, NASA Glenn Coefficients for Calculating Thermodynamic Properties of Individual Species, NASA/TP-2002-211556 (2002)";
    licence  publicDomain;    // US government work (NASA), 17 U.S.C. 105
}
