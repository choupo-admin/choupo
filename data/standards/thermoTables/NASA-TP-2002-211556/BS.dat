/*--------------------------------*- Choupo -*-----------------------*\
  Species BS (NASA/TP-2002-211556 appendix D entry "BS"):
  ideal-gas formation data and heat capacity transcribed by machine with
  bin/curate/nasa_tp2002_to_choupo.py table, which holds H and S at
  298.15 K recomputed from the printed coefficients to the printed
  values.  Not read back against the page by a curator.
  The report's own description and sources: Gurvich,1996a pt1 p97 pt2 p76.
\*---------------------------------------------------------------------------*/
name           BS;
formula        BS;
CAS            n/a;
MW             42.87;       // kg/kmol, = sum of the engine's atomic weights (C517; was 42.876)
role           gasOnly;       // free radical (odd electron count 21)
tags           ( gasPhase thermoTable );
nasaEntry      "BS";
reviewStatus   interim;
reviewReason   "transcribed by machine from NASA/TP-2002-211556 into the thermoTables home and checked against the report itself; not yet read back against the page by a curator";
standardThermochemistry
{
    dHf_298    273519.405;   // J/mol  -- ideal gas; NASA/TP-2002-211556 appendix D, p. 62, entry BS
    s_298      216.195;     // J/(mol·K) -- third-law absolute; Table B1, p. 11
}

idealGasHeatCapacity
{
    //  NASA/TP-2002-211556 eq. (1), Cp/R = a1/T^2 + a2/T + a3 + a4 T + a5 T^2
    //  + a6 T^3 + a7 T^4; appendix D, p. 62, entry BS, a1..a7 as printed.
    model    NASA9;
    Tlow     200;
    Tcommon  1000;
    Thigh    6000;
    low      ( -3.839490100e+04 6.989417490e+02 -1.213980460e+00 1.396391264e-02 -1.689881284e-05 1.038889985e-08 -2.582063989e-12 );
    high     ( 1.358760165e+06 -4.364035960e+03 9.034307590e+00 -2.114548699e-03 4.189275310e-07 -1.354787322e-11 -1.360684605e-15 );
}

provenance
{
    dHf_298
    {
        origin        literature;
        method        "NASA/TP-2002-211556 appendix D, p. 62, entry BS, record-line H(298.15) (elements reference, so = dHf)";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "Table B1 p. 11 prints 273.519 kJ/mol; the report's own sources: Gurvich,1996a pt1 p97 pt2 p76.";
    }
    s_298
    {
        origin        literature;
        method        "NASA/TP-2002-211556 Table B1, p. 11, entry BS";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "appendix D's coefficients with b2 integrate to 216.194";
    }
    idealGasHeatCapacity
    {
        origin        literature;
        method        "NASA/TP-2002-211556 appendix D, p. 62, entry BS, a1..a7 of the 200-1000 K and 1000-6000 K intervals, as printed";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "read by bin/curate/nasa_tp2002_to_choupo.py, which holds H and S at 298.15 K to the printed values";
    }
    source   "McBride, Zehe & Gordon, NASA Glenn Coefficients for Calculating Thermodynamic Properties of Individual Species, NASA/TP-2002-211556 (2002)";
    licence  publicDomain;    // US government work (NASA), 17 U.S.C. 105
}
