/*--------------------------------*- Choupo -*-----------------------*\
  Species Cr (NASA/TP-2002-211556 appendix D entry "Cr"):
  ideal-gas formation data and heat capacity transcribed by machine with
  bin/curate/nasa_tp2002_to_choupo.py table, which holds H and S at
  298.15 K recomputed from the printed coefficients to the printed
  values.  Not read back against the page by a curator.
  The report's own description and sources: Hf:Chase,1998 p963 6/79. Sugar,1985. Gordon,1999.
\*---------------------------------------------------------------------------*/
name           Cr;
formula        Cr;
CAS            n/a;
MW             51.9961;       // kg/kmol, appendix D record line
role           radical;       // gas-only (DEV.md 4c C458): stays in the vapour, refused where no vapour holds it
tags           ( gasPhase thermoTable );
nasaEntry      "Cr";
reviewStatus   interim;
reviewReason   "transcribed by machine from NASA/TP-2002-211556 into the thermoTables home and checked against the report itself; not yet read back against the page by a curator";
standardThermochemistry
{
    dHf_298    397480.000;   // J/mol  -- ideal gas; NASA/TP-2002-211556 appendix D, p. 108, entry Cr
    s_298      174.313;     // J/(mol·K) -- third-law absolute; Table B1, p. 18
}

idealGasHeatCapacity
{
    //  NASA/TP-2002-211556 eq. (1), Cp/R = a1/T^2 + a2/T + a3 + a4 T + a5 T^2
    //  + a6 T^3 + a7 T^4; appendix D, p. 108, entry Cr, a1..a7 as printed.
    //  The report's 6000-20000 K interval is not transcribed.
    model    NASA9;
    Tlow     200;
    Tcommon  1000;
    Thigh    6000;
    low      ( 1.335658217e+03 -2.102424026e+01 2.631908173e+00 -4.246263250e-04 7.439194160e-07 -6.763931630e-10 2.507855625e-13 );
    high     ( -1.120220789e+07 3.401163690e+04 -3.657062170e+01 2.110296902e-02 -5.518180140e-06 7.173601710e-10 -3.505127367e-14 );
}

provenance
{
    dHf_298
    {
        origin        literature;
        method        "NASA/TP-2002-211556 appendix D, p. 108, entry Cr, record-line H(298.15) (elements reference, so = dHf)";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "Table B1 p. 18 prints 397.48 kJ/mol; the report's own sources: Hf:Chase,1998 p963 6/79. Sugar,1985. Gordon,1999.";
    }
    s_298
    {
        origin        literature;
        method        "NASA/TP-2002-211556 Table B1, p. 18, entry Cr";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "appendix D's coefficients with b2 integrate to 174.313";
    }
    idealGasHeatCapacity
    {
        origin        literature;
        method        "NASA/TP-2002-211556 appendix D, p. 108, entry Cr, a1..a7 of the 200-1000 K and 1000-6000 K intervals, as printed";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "read by bin/curate/nasa_tp2002_to_choupo.py, which holds H and S at 298.15 K to the printed values";
    }
    source   "McBride, Zehe & Gordon, NASA Glenn Coefficients for Calculating Thermodynamic Properties of Individual Species, NASA/TP-2002-211556 (2002)";
    licence  publicDomain;    // US government work (NASA), 17 U.S.C. 105
}
