/*--------------------------------*- Choupo -*-----------------------*\
  Species Ga2Br2 (NASA/TP-2002-211556 appendix D entry "Ga2Br2"):
  ideal-gas formation data and heat capacity transcribed by machine with
  bin/curate/nasa_tp2002_to_choupo.py table, which holds H and S at
  298.15 K recomputed from the printed coefficients to the printed
  values.  Not read back against the page by a curator.
  The report's own description and sources: Gurvich,1996a pt1 p244 pt2 p197.
\*---------------------------------------------------------------------------*/
name           Ga2Br2;
formula        Ga2Br2;
CAS            n/a;
MW             299.254;       // kg/kmol, appendix D record line
role           gasData;       // closed-shell molecule (or noble gas): ideal-gas data only, no liquid model
tags           ( gasPhase thermoTable );
nasaEntry      "Ga2Br2";
reviewStatus   interim;
reviewReason   "transcribed by machine from NASA/TP-2002-211556 into the thermoTables home and checked against the report itself; not yet read back against the page by a curator";
standardThermochemistry
{
    dHf_298    -136963.692;   // J/mol  -- ideal gas; NASA/TP-2002-211556 appendix D, p. 121, entry Ga2Br2
    s_298      379.766;     // J/(mol·K) -- third-law absolute; Table B1, p. 20
}

idealGasHeatCapacity
{
    //  NASA/TP-2002-211556 eq. (1), Cp/R = a1/T^2 + a2/T + a3 + a4 T + a5 T^2
    //  + a6 T^3 + a7 T^4; appendix D, p. 121, entry Ga2Br2, a1..a7 as printed.
    model    NASA9;
    Tlow     200;
    Tcommon  1000;
    Thigh    6000;
    low      ( -1.117183241e+04 -7.471471620e+01 1.030246084e+01 -6.657929850e-04 8.200515850e-07 -5.297021520e-10 1.394553192e-13 );
    high     ( -1.885373131e+04 -1.263621802e+00 1.000108034e+01 -4.774975660e-07 1.137227648e-10 -1.380820486e-14 6.690242430e-19 );
}

provenance
{
    dHf_298
    {
        origin        literature;
        method        "NASA/TP-2002-211556 appendix D, p. 121, entry Ga2Br2, record-line H(298.15) (elements reference, so = dHf)";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "Table B1 p. 20 prints -136.964 kJ/mol; the report's own sources: Gurvich,1996a pt1 p244 pt2 p197.";
    }
    s_298
    {
        origin        literature;
        method        "NASA/TP-2002-211556 Table B1, p. 20, entry Ga2Br2";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "appendix D's coefficients with b2 integrate to 379.766";
    }
    idealGasHeatCapacity
    {
        origin        literature;
        method        "NASA/TP-2002-211556 appendix D, p. 121, entry Ga2Br2, a1..a7 of the 200-1000 K and 1000-6000 K intervals, as printed";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "read by bin/curate/nasa_tp2002_to_choupo.py, which holds H and S at 298.15 K to the printed values";
    }
    source   "McBride, Zehe & Gordon, NASA Glenn Coefficients for Calculating Thermodynamic Properties of Individual Species, NASA/TP-2002-211556 (2002)";
    licence  publicDomain;    // US government work (NASA), 17 U.S.C. 105
}
