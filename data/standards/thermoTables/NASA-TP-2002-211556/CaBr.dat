/*--------------------------------*- Choupo -*-----------------------*\
  Species CaBr (NASA/TP-2002-211556 appendix D entry "CaBr"):
  ideal-gas formation data and heat capacity transcribed by machine with
  bin/curate/nasa_tp2002_to_choupo.py table, which holds H and S at
  298.15 K recomputed from the printed coefficients to the printed
  values.  Not read back against the page by a curator.
  The report's own description and sources: Gurvich,1996a pt1 p471 pt2 p367.
\*---------------------------------------------------------------------------*/
name           CaBr;
formula        CaBr;
CAS            n/a;
MW             119.982;       // kg/kmol, appendix D record line
role           gasOnly;       // free radical (odd electron count 55)
tags           ( gasPhase thermoTable );
nasaEntry      "CaBr";
reviewStatus   interim;
reviewReason   "transcribed by machine from NASA/TP-2002-211556 into the thermoTables home and checked against the report itself; not yet read back against the page by a curator";
standardThermochemistry
{
    dHf_298    -24868.681;   // J/mol  -- ideal gas; NASA/TP-2002-211556 appendix D, p. 104, entry CaBr
    s_298      253.125;     // J/(mol·K) -- third-law absolute; Table B1, p. 17
}

idealGasHeatCapacity
{
    //  NASA/TP-2002-211556 eq. (1), Cp/R = a1/T^2 + a2/T + a3 + a4 T + a5 T^2
    //  + a6 T^3 + a7 T^4; appendix D, p. 104, entry CaBr, a1..a7 as printed.
    model    NASA9;
    Tlow     200;
    Tcommon  1000;
    Thigh    6000;
    low      ( 5.693832620e+02 -1.257513537e+02 5.001508330e+00 -1.039868753e-03 1.377594927e-06 -8.949013960e-10 2.395658928e-13 );
    high     ( 2.783236402e+06 -8.458203730e+03 1.431756560e+01 -5.430781680e-03 1.522218659e-06 -1.831824807e-10 7.864288660e-15 );
}

provenance
{
    dHf_298
    {
        origin        literature;
        method        "NASA/TP-2002-211556 appendix D, p. 104, entry CaBr, record-line H(298.15) (elements reference, so = dHf)";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "Table B1 p. 17 prints -24.869 kJ/mol; the report's own sources: Gurvich,1996a pt1 p471 pt2 p367.";
    }
    s_298
    {
        origin        literature;
        method        "NASA/TP-2002-211556 Table B1, p. 17, entry CaBr";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "appendix D's coefficients with b2 integrate to 253.125";
    }
    idealGasHeatCapacity
    {
        origin        literature;
        method        "NASA/TP-2002-211556 appendix D, p. 104, entry CaBr, a1..a7 of the 200-1000 K and 1000-6000 K intervals, as printed";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "read by bin/curate/nasa_tp2002_to_choupo.py, which holds H and S at 298.15 K to the printed values";
    }
    source   "McBride, Zehe & Gordon, NASA Glenn Coefficients for Calculating Thermodynamic Properties of Individual Species, NASA/TP-2002-211556 (2002)";
    licence  publicDomain;    // US government work (NASA), 17 U.S.C. 105
}
