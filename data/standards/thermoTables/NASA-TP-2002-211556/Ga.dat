/*--------------------------------*- Choupo -*-----------------------*\
  Species Ga (NASA/TP-2002-211556 appendix D entry "Ga"):
  ideal-gas formation data and heat capacity transcribed by machine with
  bin/curate/nasa_tp2002_to_choupo.py table, which holds H and S at
  298.15 K recomputed from the printed coefficients to the printed
  values.  Not read back against the page by a curator.
  The report's own description and sources: Hf:Gurvich,1996a. Moore,1971. Johansson,1966. Gordon,1999.
\*---------------------------------------------------------------------------*/
name           Ga;
formula        Ga;
CAS            n/a;
MW             69.723;       // kg/kmol, appendix D record line
role           radical;       // gas-only (DEV.md 4c C458): stays in the vapour, refused where no vapour holds it
tags           ( gasPhase thermoTable );
nasaEntry      "Ga";
reviewStatus   interim;
reviewReason   "transcribed by machine from NASA/TP-2002-211556 into the thermoTables home and checked against the report itself; not yet read back against the page by a curator";
standardThermochemistry
{
    dHf_298    272000.000;   // J/mol  -- ideal gas; NASA/TP-2002-211556 appendix D, p. 119, entry Ga
    s_298      169.045;     // J/(mol·K) -- third-law absolute; Table B1, p. 19
}

idealGasHeatCapacity
{
    //  NASA/TP-2002-211556 eq. (1), Cp/R = a1/T^2 + a2/T + a3 + a4 T + a5 T^2
    //  + a6 T^3 + a7 T^4; appendix D, p. 119, entry Ga, a1..a7 as printed.
    //  The report's 6000-20000 K interval is not transcribed.
    model    NASA9;
    Tlow     200;
    Tcommon  1000;
    Thigh    6000;
    low      ( 2.387947890e+05 -3.121634631e+03 1.630171272e+01 -2.347922342e-02 1.932327565e-05 -7.316311870e-09 8.857387735e-13 );
    high     ( -5.544186520e+04 8.808624420e+02 1.760717716e+00 2.993259460e-04 -5.610827310e-08 2.682832239e-12 3.132134914e-16 );
}

provenance
{
    dHf_298
    {
        origin        literature;
        method        "NASA/TP-2002-211556 appendix D, p. 119, entry Ga, record-line H(298.15) (elements reference, so = dHf)";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "Table B1 p. 19 prints 272.0 kJ/mol; the report's own sources: Hf:Gurvich,1996a. Moore,1971. Johansson,1966. Gordon,1999.";
    }
    s_298
    {
        origin        literature;
        method        "NASA/TP-2002-211556 Table B1, p. 19, entry Ga";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "appendix D's coefficients with b2 integrate to 169.045";
    }
    idealGasHeatCapacity
    {
        origin        literature;
        method        "NASA/TP-2002-211556 appendix D, p. 119, entry Ga, a1..a7 of the 200-1000 K and 1000-6000 K intervals, as printed";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "read by bin/curate/nasa_tp2002_to_choupo.py, which holds H and S at 298.15 K to the printed values";
    }
    source   "McBride, Zehe & Gordon, NASA Glenn Coefficients for Calculating Thermodynamic Properties of Individual Species, NASA/TP-2002-211556 (2002)";
    licence  publicDomain;    // US government work (NASA), 17 U.S.C. 105
}
