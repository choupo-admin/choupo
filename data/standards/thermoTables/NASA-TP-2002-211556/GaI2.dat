/*--------------------------------*- Choupo -*-----------------------*\
  Species GaI2 (NASA/TP-2002-211556 appendix D entry "GaI2"):
  ideal-gas formation data and heat capacity transcribed by machine with
  bin/curate/nasa_tp2002_to_choupo.py table, which holds H and S at
  298.15 K recomputed from the printed coefficients to the printed
  values.  Not read back against the page by a curator.
  The report's own description and sources: Gurvich,1996a pt1 p249 pt2 p201.
\*---------------------------------------------------------------------------*/
name           GaI2;
formula        GaI2;
CAS            n/a;
MW             323.5319;       // kg/kmol, appendix D record line
role           gasOnly;       // free radical (odd electron count 137)
tags           ( gasPhase thermoTable );
nasaEntry      "GaI2";
reviewStatus   interim;
reviewReason   "transcribed by machine from NASA/TP-2002-211556 into the thermoTables home and checked against the report itself; not yet read back against the page by a curator";
standardThermochemistry
{
    dHf_298    -28954.965;   // J/mol  -- ideal gas; NASA/TP-2002-211556 appendix D, p. 121, entry GaI2
    s_298      338.523;     // J/(mol·K) -- third-law absolute; Table B1, p. 20
}

idealGasHeatCapacity
{
    //  NASA/TP-2002-211556 eq. (1), Cp/R = a1/T^2 + a2/T + a3 + a4 T + a5 T^2
    //  + a6 T^3 + a7 T^4; appendix D, p. 121, entry GaI2, a1..a7 as printed.
    model    NASA9;
    Tlow     200;
    Tcommon  1000;
    Thigh    6000;
    low      ( -9.831395900e+02 -2.152621259e+02 7.844318760e+00 -1.819797849e-03 2.210706958e-06 -1.416110855e-09 3.713762930e-13 );
    high     ( -3.202879750e+05 4.796502330e+02 7.102333960e+00 -5.512657830e-04 3.157543452e-07 -5.510871940e-11 3.171977730e-15 );
}

provenance
{
    dHf_298
    {
        origin        literature;
        method        "NASA/TP-2002-211556 appendix D, p. 121, entry GaI2, record-line H(298.15) (elements reference, so = dHf)";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "Table B1 p. 20 prints -28.955 kJ/mol; the report's own sources: Gurvich,1996a pt1 p249 pt2 p201.";
    }
    s_298
    {
        origin        literature;
        method        "NASA/TP-2002-211556 Table B1, p. 20, entry GaI2";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "appendix D's coefficients with b2 integrate to 338.523";
    }
    idealGasHeatCapacity
    {
        origin        literature;
        method        "NASA/TP-2002-211556 appendix D, p. 121, entry GaI2, a1..a7 of the 200-1000 K and 1000-6000 K intervals, as printed";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "read by bin/curate/nasa_tp2002_to_choupo.py, which holds H and S at 298.15 K to the printed values";
    }
    source   "McBride, Zehe & Gordon, NASA Glenn Coefficients for Calculating Thermodynamic Properties of Individual Species, NASA/TP-2002-211556 (2002)";
    licence  publicDomain;    // US government work (NASA), 17 U.S.C. 105
}
