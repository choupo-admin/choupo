/*--------------------------------*- Choupo -*-----------------------*\
  Species CuF2 (NASA/TP-2002-211556 appendix D entry "CuF2"):
  ideal-gas formation data and heat capacity transcribed by machine with
  bin/curate/nasa_tp2002_to_choupo.py table, which holds H and S at
  298.15 K recomputed from the printed coefficients to the printed
  values.  Not read back against the page by a curator.
  The report's own description and sources: Chase,1998 p1017.
\*---------------------------------------------------------------------------*/
name           CuF2;
formula        CuF2;
CAS            n/a;
MW             101.5428;       // kg/kmol, appendix D record line
role           gasData;       // odd-electron d-block/actinide compound: stable, has condensed phases (not a radical)
tags           ( gasPhase thermoTable );
nasaEntry      "CuF2";
reviewStatus   interim;
reviewReason   "transcribed by machine from NASA/TP-2002-211556 into the thermoTables home and checked against the report itself; not yet read back against the page by a curator";
standardThermochemistry
{
    dHf_298    -266940.000;   // J/mol  -- ideal gas; NASA/TP-2002-211556 appendix D, p. 114, entry CuF2
    s_298      267.090;     // J/(mol·K) -- third-law absolute; Table B1, p. 19
}

idealGasHeatCapacity
{
    //  NASA/TP-2002-211556 eq. (1), Cp/R = a1/T^2 + a2/T + a3 + a4 T + a5 T^2
    //  + a6 T^3 + a7 T^4; appendix D, p. 114, entry CuF2, a1..a7 as printed.
    model    NASA9;
    Tlow     200;
    Tcommon  1000;
    Thigh    6000;
    low      ( 6.573311280e+04 -8.962430840e+02 7.917560940e+00 1.345667904e-03 -4.162400010e-06 3.716181090e-09 -1.155537597e-12 );
    high     ( -1.650355082e+06 3.775362120e+03 3.889116550e+00 6.821912640e-04 1.875979026e-07 -5.677368110e-11 3.823248730e-15 );
}

provenance
{
    dHf_298
    {
        origin        literature;
        method        "NASA/TP-2002-211556 appendix D, p. 114, entry CuF2, record-line H(298.15) (elements reference, so = dHf)";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "Table B1 p. 19 prints -266.94 kJ/mol; the report's own sources: Chase,1998 p1017.";
    }
    s_298
    {
        origin        literature;
        method        "NASA/TP-2002-211556 Table B1, p. 19, entry CuF2";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "appendix D's coefficients with b2 integrate to 267.090";
    }
    idealGasHeatCapacity
    {
        origin        literature;
        method        "NASA/TP-2002-211556 appendix D, p. 114, entry CuF2, a1..a7 of the 200-1000 K and 1000-6000 K intervals, as printed";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "read by bin/curate/nasa_tp2002_to_choupo.py, which holds H and S at 298.15 K to the printed values";
    }
    source   "McBride, Zehe & Gordon, NASA Glenn Coefficients for Calculating Thermodynamic Properties of Individual Species, NASA/TP-2002-211556 (2002)";
    licence  publicDomain;    // US government work (NASA), 17 U.S.C. 105
}
