/*--------------------------------*- Choupo -*-----------------------*\
  Species ALFCL (NASA/TP-2002-211556 appendix D entry "ALFCL"):
  ideal-gas formation data and heat capacity transcribed by machine with
  bin/curate/nasa_tp2002_to_choupo.py table, which holds H and S at
  298.15 K recomputed from the printed coefficients to the printed
  values.  Not read back against the page by a curator.
  The report's own description and sources: Gurvich,1996a pt1 p182 pt2 p144.
\*---------------------------------------------------------------------------*/
name           ALFCL;
formula        AlFCl;
CAS            n/a;
MW             81.43294;       // kg/kmol, appendix D record line
role           gasOnly;       // free radical (odd electron count 39)
tags           ( gasPhase thermoTable );
nasaEntry      "ALFCL";
reviewStatus   interim;
reviewReason   "transcribed by machine from NASA/TP-2002-211556 into the thermoTables home and checked against the report itself; not yet read back against the page by a curator";
standardThermochemistry
{
    dHf_298    -436409.913;   // J/mol  -- ideal gas; NASA/TP-2002-211556 appendix D, p. 48, entry ALFCL
    s_298      282.721;     // J/(mol·K) -- third-law absolute; Table B1, p. 9
}

idealGasHeatCapacity
{
    //  NASA/TP-2002-211556 eq. (1), Cp/R = a1/T^2 + a2/T + a3 + a4 T + a5 T^2
    //  + a6 T^3 + a7 T^4; appendix D, p. 48, entry ALFCL, a1..a7 as printed.
    model    NASA9;
    Tlow     200;
    Tcommon  1000;
    Thigh    6000;
    low      ( 4.104779480e+04 -5.769646420e+02 6.562642700e+00 4.106285840e-03 -7.213921120e-06 5.486401450e-09 -1.580656193e-12 );
    high     ( 6.970636350e+04 -6.224485910e+02 7.573475410e+00 -2.236155999e-04 2.382317949e-08 4.443785760e-12 -5.486977850e-16 );
}

provenance
{
    dHf_298
    {
        origin        literature;
        method        "NASA/TP-2002-211556 appendix D, p. 48, entry ALFCL, record-line H(298.15) (elements reference, so = dHf)";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "Table B1 p. 9 prints -436.41 kJ/mol; the report's own sources: Gurvich,1996a pt1 p182 pt2 p144.";
    }
    s_298
    {
        origin        literature;
        method        "NASA/TP-2002-211556 Table B1, p. 9, entry ALFCL";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "appendix D's coefficients with b2 integrate to 282.721";
    }
    idealGasHeatCapacity
    {
        origin        literature;
        method        "NASA/TP-2002-211556 appendix D, p. 48, entry ALFCL, a1..a7 of the 200-1000 K and 1000-6000 K intervals, as printed";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "read by bin/curate/nasa_tp2002_to_choupo.py, which holds H and S at 298.15 K to the printed values";
    }
    source   "McBride, Zehe & Gordon, NASA Glenn Coefficients for Calculating Thermodynamic Properties of Individual Species, NASA/TP-2002-211556 (2002)";
    licence  publicDomain;    // US government work (NASA), 17 U.S.C. 105
}
