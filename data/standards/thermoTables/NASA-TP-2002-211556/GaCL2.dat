/*--------------------------------*- Choupo -*-----------------------*\
  Species GaCL2 (NASA/TP-2002-211556 appendix D entry "GaCL2"):
  ideal-gas formation data and heat capacity transcribed by machine with
  bin/curate/nasa_tp2002_to_choupo.py table, which holds H and S at
  298.15 K recomputed from the printed coefficients to the printed
  values.  Not read back against the page by a curator.
  The report's own description and sources: Gurvich,1996a pt1 p232 pt2 p187.
\*---------------------------------------------------------------------------*/
name           GaCL2;
formula        GaCl2;
CAS            n/a;
MW             140.629;       // kg/kmol, appendix D record line
role           gasOnly;       // free radical (odd electron count 65)
tags           ( gasPhase thermoTable );
nasaEntry      "GaCL2";
reviewStatus   interim;
reviewReason   "transcribed by machine from NASA/TP-2002-211556 into the thermoTables home and checked against the report itself; not yet read back against the page by a curator";
standardThermochemistry
{
    dHf_298    -220978.909;   // J/mol  -- ideal gas; NASA/TP-2002-211556 appendix D, p. 120, entry GaCL2
    s_298      302.930;     // J/(mol·K) -- third-law absolute; Table B1, p. 19
}

idealGasHeatCapacity
{
    //  NASA/TP-2002-211556 eq. (1), Cp/R = a1/T^2 + a2/T + a3 + a4 T + a5 T^2
    //  + a6 T^3 + a7 T^4; appendix D, p. 120, entry GaCL2, a1..a7 as printed.
    model    NASA9;
    Tlow     200;
    Tcommon  1000;
    Thigh    6000;
    low      ( 2.225481851e+04 -6.046218440e+02 9.220388910e+00 -4.554400790e-03 5.324855180e-06 -3.308605570e-09 8.462235560e-13 );
    high     ( -3.445405300e+05 4.714437160e+02 7.108775480e+00 -5.539433560e-04 3.163638240e-07 -5.518023930e-11 3.175353030e-15 );
}

provenance
{
    dHf_298
    {
        origin        literature;
        method        "NASA/TP-2002-211556 appendix D, p. 120, entry GaCL2, record-line H(298.15) (elements reference, so = dHf)";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "Table B1 p. 19 prints -220.979 kJ/mol; the report's own sources: Gurvich,1996a pt1 p232 pt2 p187.";
    }
    s_298
    {
        origin        literature;
        method        "NASA/TP-2002-211556 Table B1, p. 19, entry GaCL2";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "appendix D's coefficients with b2 integrate to 302.930";
    }
    idealGasHeatCapacity
    {
        origin        literature;
        method        "NASA/TP-2002-211556 appendix D, p. 120, entry GaCL2, a1..a7 of the 200-1000 K and 1000-6000 K intervals, as printed";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "read by bin/curate/nasa_tp2002_to_choupo.py, which holds H and S at 298.15 K to the printed values";
    }
    source   "McBride, Zehe & Gordon, NASA Glenn Coefficients for Calculating Thermodynamic Properties of Individual Species, NASA/TP-2002-211556 (2002)";
    licence  publicDomain;    // US government work (NASA), 17 U.S.C. 105
}
