/*--------------------------------*- Choupo -*-----------------------*\
  Species C2H4O_ethyleno (NASA/TP-2002-211556 appendix D entry "C2H4O,ethylen-o"):
  ideal-gas formation data and heat capacity transcribed by machine with
  bin/curate/nasa_tp2002_to_choupo.py table, which holds H and S at
  298.15 K recomputed from the printed coefficients to the printed
  values.  Not read back against the page by a curator.
  The report's own description and sources: Ethylene Oxide. Shimanouchi,1972. Chase,1998 9/65.
\*---------------------------------------------------------------------------*/
name           C2H4O_ethyleno;
formula        C2H4O;
CAS            n/a;
MW             44.05256;       // kg/kmol, appendix D record line
role           nonvolatile;   // ideal-gas species: no vapour pressure is asked of it
tags           ( gasPhase thermoTable );
nasaEntry      "C2H4O,ethylen-o";
reviewStatus   interim;
reviewReason   "transcribed by machine from NASA/TP-2002-211556 into the thermoTables home and checked against the report itself; not yet read back against the page by a curator";
standardThermochemistry
{
    dHf_298    -52634.720;   // J/mol  -- ideal gas; NASA/TP-2002-211556 appendix D, p. 91, entry C2H4O,ethylen-o
    s_298      242.870;     // J/(mol·K) -- third-law absolute; Table B1, p. 15
}

idealGasHeatCapacity
{
    //  NASA/TP-2002-211556 eq. (1), Cp/R = a1/T^2 + a2/T + a3 + a4 T + a5 T^2
    //  + a6 T^3 + a7 T^4; appendix D, p. 91, entry C2H4O,ethylen-o, a1..a7 as printed.
    model    NASA9;
    Tlow     200;
    Tcommon  1000;
    Thigh    6000;
    low      ( -1.728233345e+05 3.816678800e+03 -2.629851977e+01 1.014103162e-01 -1.240578373e-04 8.034040350e-08 -2.120942544e-11 );
    high     ( 3.151809957e+06 -1.423646316e+04 2.708080476e+01 -2.606238456e-03 4.853891930e-07 -4.852144760e-11 2.011778721e-15 );
}

provenance
{
    dHf_298
    {
        origin        literature;
        method        "NASA/TP-2002-211556 appendix D, p. 91, entry C2H4O,ethylen-o, record-line H(298.15) (elements reference, so = dHf)";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "Table B1 p. 15 prints -52.635 kJ/mol; the report's own sources: Ethylene Oxide. Shimanouchi,1972. Chase,1998 9/65.";
    }
    s_298
    {
        origin        literature;
        method        "NASA/TP-2002-211556 Table B1, p. 15, entry C2H4O,ethylen-o";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "appendix D's coefficients with b2 integrate to 242.870";
    }
    idealGasHeatCapacity
    {
        origin        literature;
        method        "NASA/TP-2002-211556 appendix D, p. 91, entry C2H4O,ethylen-o, a1..a7 of the 200-1000 K and 1000-6000 K intervals, as printed";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "read by bin/curate/nasa_tp2002_to_choupo.py, which holds H and S at 298.15 K to the printed values";
    }
    source   "McBride, Zehe & Gordon, NASA Glenn Coefficients for Calculating Thermodynamic Properties of Individual Species, NASA/TP-2002-211556 (2002)";
    licence  publicDomain;    // US government work (NASA), 17 U.S.C. 105
}
