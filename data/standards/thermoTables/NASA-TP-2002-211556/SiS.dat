/*--------------------------------*- Choupo -*-----------------------*\
  Species SiS (NASA/TP-2002-211556 appendix D entry "SiS"):
  ideal-gas formation data and heat capacity transcribed by machine with
  bin/curate/nasa_tp2002_to_choupo.py table, which holds H and S at
  298.15 K recomputed from the printed coefficients to the printed
  values.  Not read back against the page by a curator.
  The report's own description and sources: Gurvich,1991 pt1 p290 pt2 p258.
\*---------------------------------------------------------------------------*/
name           SiS;
formula        SiS;
CAS            n/a;
MW             60.1505;       // kg/kmol, appendix D record line
role           radical;       // gas-only (DEV.md 4c C458): stays in the vapour, refused where no vapour holds it
tags           ( gasPhase thermoTable );
nasaEntry      "SiS";
reviewStatus   interim;
reviewReason   "transcribed by machine from NASA/TP-2002-211556 into the thermoTables home and checked against the report itself; not yet read back against the page by a curator";
standardThermochemistry
{
    dHf_298    108194.407;   // J/mol  -- ideal gas; NASA/TP-2002-211556 appendix D, p. 191, entry SiS
    s_298      223.675;     // J/(mol·K) -- third-law absolute; Table B1, p. 29
}

idealGasHeatCapacity
{
    //  NASA/TP-2002-211556 eq. (1), Cp/R = a1/T^2 + a2/T + a3 + a4 T + a5 T^2
    //  + a6 T^3 + a7 T^4; appendix D, p. 191, entry SiS, a1..a7 as printed.
    model    NASA9;
    Tlow     200;
    Tcommon  1000;
    Thigh    6000;
    low      ( 3.599449290e+04 -4.239723300e+02 4.654014420e+00 1.588470782e-03 -3.310254360e-06 2.706096479e-09 -8.113517820e-13 );
    high     ( -2.102323897e+06 6.228836180e+03 -3.004120882e+00 4.495499930e-03 -1.368821364e-06 1.998097253e-10 -9.882035800e-15 );
}

provenance
{
    dHf_298
    {
        origin        literature;
        method        "NASA/TP-2002-211556 appendix D, p. 191, entry SiS, record-line H(298.15) (elements reference, so = dHf)";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "Table B1 p. 29 prints 108.194 kJ/mol; the report's own sources: Gurvich,1991 pt1 p290 pt2 p258.";
    }
    s_298
    {
        origin        literature;
        method        "NASA/TP-2002-211556 Table B1, p. 29, entry SiS";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "appendix D's coefficients with b2 integrate to 223.675";
    }
    idealGasHeatCapacity
    {
        origin        literature;
        method        "NASA/TP-2002-211556 appendix D, p. 191, entry SiS, a1..a7 of the 200-1000 K and 1000-6000 K intervals, as printed";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "read by bin/curate/nasa_tp2002_to_choupo.py, which holds H and S at 298.15 K to the printed values";
    }
    source   "McBride, Zehe & Gordon, NASA Glenn Coefficients for Calculating Thermodynamic Properties of Individual Species, NASA/TP-2002-211556 (2002)";
    licence  publicDomain;    // US government work (NASA), 17 U.S.C. 105
}
