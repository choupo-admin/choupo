/*--------------------------------*- Choupo -*-----------------------*\
  Species LiBO2 (NASA/TP-2002-211556 appendix D entry "LiBO2"):
  ideal-gas formation data and heat capacity transcribed by machine with
  bin/curate/nasa_tp2002_to_choupo.py table, which holds H and S at
  298.15 K recomputed from the printed coefficients to the printed
  values.  Not read back against the page by a curator.
  The report's own description and sources: Gurvich,1982 pt1 p299 pt2 p332.
\*---------------------------------------------------------------------------*/
name           LiBO2;
formula        LiBO2;
CAS            n/a;
MW             49.7508;       // kg/kmol, appendix D record line
role           gasData;       // closed-shell molecule (or noble gas): ideal-gas data only, no liquid model
tags           ( gasPhase thermoTable );
nasaEntry      "LiBO2";
reviewStatus   interim;
reviewReason   "transcribed by machine from NASA/TP-2002-211556 into the thermoTables home and checked against the report itself; not yet read back against the page by a curator";
standardThermochemistry
{
    dHf_298    -652352.276;   // J/mol  -- ideal gas; NASA/TP-2002-211556 appendix D, p. 144, entry LiBO2
    s_298      272.380;     // J/(mol·K) -- third-law absolute; Table B1, p. 23
}

idealGasHeatCapacity
{
    //  NASA/TP-2002-211556 eq. (1), Cp/R = a1/T^2 + a2/T + a3 + a4 T + a5 T^2
    //  + a6 T^3 + a7 T^4; appendix D, p. 144, entry LiBO2, a1..a7 as printed.
    model    NASA9;
    Tlow     200;
    Tcommon  1000;
    Thigh    6000;
    low      ( 6.518987570e+04 -1.060320845e+03 9.548049960e+00 -5.469576070e-05 2.658687599e-06 -2.931603694e-09 9.663029730e-13 );
    high     ( 8.554404520e+04 -1.731920898e+03 1.121462090e+01 -4.659162170e-04 9.999875690e-08 -1.122880592e-11 5.123529460e-16 );
}

provenance
{
    dHf_298
    {
        origin        literature;
        method        "NASA/TP-2002-211556 appendix D, p. 144, entry LiBO2, record-line H(298.15) (elements reference, so = dHf)";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "Table B1 p. 23 prints -652.352 kJ/mol; the report's own sources: Gurvich,1982 pt1 p299 pt2 p332.";
    }
    s_298
    {
        origin        literature;
        method        "NASA/TP-2002-211556 Table B1, p. 23, entry LiBO2";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "appendix D's coefficients with b2 integrate to 272.380";
    }
    idealGasHeatCapacity
    {
        origin        literature;
        method        "NASA/TP-2002-211556 appendix D, p. 144, entry LiBO2, a1..a7 of the 200-1000 K and 1000-6000 K intervals, as printed";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "read by bin/curate/nasa_tp2002_to_choupo.py, which holds H and S at 298.15 K to the printed values";
    }
    source   "McBride, Zehe & Gordon, NASA Glenn Coefficients for Calculating Thermodynamic Properties of Individual Species, NASA/TP-2002-211556 (2002)";
    licence  publicDomain;    // US government work (NASA), 17 U.S.C. 105
}
