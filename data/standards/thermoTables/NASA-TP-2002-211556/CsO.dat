/*--------------------------------*- Choupo -*-----------------------*\
  Species CsO (NASA/TP-2002-211556 appendix D entry "CsO"):
  ideal-gas formation data and heat capacity transcribed by machine with
  bin/curate/nasa_tp2002_to_choupo.py table, which holds H and S at
  298.15 K recomputed from the printed coefficients to the printed
  values.  Not read back against the page by a curator.
  The report's own description and sources: Gurvich,1982 pt1 p471 pt2 p493.
\*---------------------------------------------------------------------------*/
name           CsO;
formula        CsO;
CAS            n/a;
MW             148.9049;       // kg/kmol, appendix D record line
role           gasOnly;       // free radical (odd electron count 63)
tags           ( gasPhase thermoTable );
nasaEntry      "CsO";
reviewStatus   interim;
reviewReason   "transcribed by machine from NASA/TP-2002-211556 into the thermoTables home and checked against the report itself; not yet read back against the page by a curator";
standardThermochemistry
{
    dHf_298    37587.318;   // J/mol  -- ideal gas; NASA/TP-2002-211556 appendix D, p. 111, entry CsO
    s_298      248.512;     // J/(mol·K) -- third-law absolute; Table B1, p. 18
}

idealGasHeatCapacity
{
    //  NASA/TP-2002-211556 eq. (1), Cp/R = a1/T^2 + a2/T + a3 + a4 T + a5 T^2
    //  + a6 T^3 + a7 T^4; appendix D, p. 111, entry CsO, a1..a7 as printed.
    model    NASA9;
    Tlow     200;
    Tcommon  1000;
    Thigh    6000;
    low      ( 8.683958810e+03 4.250278170e+02 -3.484055300e+00 3.801969830e-02 -6.651927560e-05 5.173472190e-08 -1.512567066e-11 );
    high     ( 8.375544350e+05 -2.418205772e+03 8.908065350e+00 -3.378180040e-03 1.312755917e-06 -2.150508925e-10 1.219138980e-14 );
}

provenance
{
    dHf_298
    {
        origin        literature;
        method        "NASA/TP-2002-211556 appendix D, p. 111, entry CsO, record-line H(298.15) (elements reference, so = dHf)";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "Table B1 p. 18 prints 37.587 kJ/mol; the report's own sources: Gurvich,1982 pt1 p471 pt2 p493.";
    }
    s_298
    {
        origin        literature;
        method        "NASA/TP-2002-211556 Table B1, p. 18, entry CsO";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "appendix D's coefficients with b2 integrate to 248.512";
    }
    idealGasHeatCapacity
    {
        origin        literature;
        method        "NASA/TP-2002-211556 appendix D, p. 111, entry CsO, a1..a7 of the 200-1000 K and 1000-6000 K intervals, as printed";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "read by bin/curate/nasa_tp2002_to_choupo.py, which holds H and S at 298.15 K to the printed values";
    }
    source   "McBride, Zehe & Gordon, NASA Glenn Coefficients for Calculating Thermodynamic Properties of Individual Species, NASA/TP-2002-211556 (2002)";
    licence  publicDomain;    // US government work (NASA), 17 U.S.C. 105
}
