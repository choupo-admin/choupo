/*--------------------------------*- Choupo -*-----------------------*\
  Species RbNO2 (NASA/TP-2002-211556 appendix D entry "RbNO2"):
  ideal-gas formation data and heat capacity transcribed by machine with
  bin/curate/nasa_tp2002_to_choupo.py table, which holds H and S at
  298.15 K recomputed from the printed coefficients to the printed
  values.  Not read back against the page by a curator.
  The report's own description and sources: Gurvich,1982 pt1 p454 pt2 p478.
\*---------------------------------------------------------------------------*/
name           RbNO2;
formula        RbNO2;
CAS            n/a;
MW             131.4733;       // kg/kmol, appendix D record line
role           nonvolatile;   // ideal-gas species: no vapour pressure is asked of it
tags           ( gasPhase thermoTable );
nasaEntry      "RbNO2";
reviewStatus   interim;
reviewReason   "transcribed by machine from NASA/TP-2002-211556 into the thermoTables home and checked against the report itself; not yet read back against the page by a curator";
standardThermochemistry
{
    dHf_298    -187629.777;   // J/mol  -- ideal gas; NASA/TP-2002-211556 appendix D, p. 177, entry RbNO2
    s_298      317.580;     // J/(mol·K) -- third-law absolute; Table B1, p. 27
}

idealGasHeatCapacity
{
    //  NASA/TP-2002-211556 eq. (1), Cp/R = a1/T^2 + a2/T + a3 + a4 T + a5 T^2
    //  + a6 T^3 + a7 T^4; appendix D, p. 177, entry RbNO2, a1..a7 as printed.
    model    NASA9;
    Tlow     200;
    Tcommon  1000;
    Thigh    6000;
    low      ( -7.199420030e+04 1.265802595e+03 -2.415715742e+00 3.054641420e-02 -3.684004050e-05 2.247716481e-08 -5.547527430e-12 );
    high     ( -1.644994453e+05 -8.499443440e+02 1.063080575e+01 -2.517893988e-04 5.561420120e-08 -6.378805600e-12 2.957679896e-16 );
}

provenance
{
    dHf_298
    {
        origin        literature;
        method        "NASA/TP-2002-211556 appendix D, p. 177, entry RbNO2, record-line H(298.15) (elements reference, so = dHf)";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "Table B1 p. 27 prints -187.63 kJ/mol; the report's own sources: Gurvich,1982 pt1 p454 pt2 p478.";
    }
    s_298
    {
        origin        literature;
        method        "NASA/TP-2002-211556 Table B1, p. 27, entry RbNO2";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "appendix D's coefficients with b2 integrate to 317.580";
    }
    idealGasHeatCapacity
    {
        origin        literature;
        method        "NASA/TP-2002-211556 appendix D, p. 177, entry RbNO2, a1..a7 of the 200-1000 K and 1000-6000 K intervals, as printed";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "read by bin/curate/nasa_tp2002_to_choupo.py, which holds H and S at 298.15 K to the printed values";
    }
    source   "McBride, Zehe & Gordon, NASA Glenn Coefficients for Calculating Thermodynamic Properties of Individual Species, NASA/TP-2002-211556 (2002)";
    licence  publicDomain;    // US government work (NASA), 17 U.S.C. 105
}
