/*--------------------------------*- Choupo -*-----------------------*\
  Species CCN (NASA/TP-2002-211556 appendix D entry "CCN"):
  ideal-gas formation data and heat capacity transcribed by machine with
  bin/curate/nasa_tp2002_to_choupo.py table, which holds H and S at
  298.15 K recomputed from the printed coefficients to the printed
  values.  Not read back against the page by a curator.
  The report's own description and sources: Hf:Gurvich,1991 pt1 p222. Jacox,1998 p173.
\*---------------------------------------------------------------------------*/
name           CCN;
formula        C2N;
CAS            n/a;
MW             38.0281;       // kg/kmol, appendix D record line
role           gasOnly;       // free radical (odd electron count 19)
tags           ( gasPhase thermoTable );
nasaEntry      "CCN";
reviewStatus   interim;
reviewReason   "transcribed by machine from NASA/TP-2002-211556 into the thermoTables home and checked against the report itself; not yet read back against the page by a curator";
standardThermochemistry
{
    dHf_298    804596.472;   // J/mol  -- ideal gas; NASA/TP-2002-211556 appendix D, p. 93, entry CCN
    s_298      237.159;     // J/(mol·K) -- third-law absolute; Table B1, p. 16
}

idealGasHeatCapacity
{
    //  NASA/TP-2002-211556 eq. (1), Cp/R = a1/T^2 + a2/T + a3 + a4 T + a5 T^2
    //  + a6 T^3 + a7 T^4; appendix D, p. 93, entry CCN, a1..a7 as printed.
    model    NASA9;
    Tlow     200;
    Tcommon  1000;
    Thigh    6000;
    low      ( -1.696281385e+04 9.837891630e+01 3.812662940e+00 5.346894230e-03 -2.473598508e-06 -3.730564220e-10 4.481756860e-13 );
    high     ( 7.948674890e+04 -1.344786906e+03 8.309986460e+00 -2.220105361e-04 1.753683113e-08 2.545998719e-12 -2.645649117e-16 );
}

provenance
{
    dHf_298
    {
        origin        literature;
        method        "NASA/TP-2002-211556 appendix D, p. 93, entry CCN, record-line H(298.15) (elements reference, so = dHf)";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "Table B1 p. 16 prints 804.596 kJ/mol; the report's own sources: Hf:Gurvich,1991 pt1 p222. Jacox,1998 p173.";
    }
    s_298
    {
        origin        literature;
        method        "NASA/TP-2002-211556 Table B1, p. 16, entry CCN";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "appendix D's coefficients with b2 integrate to 237.159";
    }
    idealGasHeatCapacity
    {
        origin        literature;
        method        "NASA/TP-2002-211556 appendix D, p. 93, entry CCN, a1..a7 of the 200-1000 K and 1000-6000 K intervals, as printed";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "read by bin/curate/nasa_tp2002_to_choupo.py, which holds H and S at 298.15 K to the printed values";
    }
    source   "McBride, Zehe & Gordon, NASA Glenn Coefficients for Calculating Thermodynamic Properties of Individual Species, NASA/TP-2002-211556 (2002)";
    licence  publicDomain;    // US government work (NASA), 17 U.S.C. 105
}
