/*--------------------------------*- Choupo -*-----------------------*\
  Species B2H5_db (NASA/TP-2002-211556 appendix D entry "B2H5,db"):
  ideal-gas formation data and heat capacity transcribed by machine with
  bin/curate/nasa_tp2002_to_choupo.py table, which holds H and S at
  298.15 K recomputed from the printed coefficients to the printed
  values.  Not read back against the page by a curator.
  The report's own description and sources: 2-Bridges. Ruscic,1989a. Trachtman,1989.
\*---------------------------------------------------------------------------*/
name           B2H5_db;
formula        B2H5;
CAS            n/a;
MW             26.6617;       // kg/kmol, appendix D record line
role           gasOnly;       // free radical (odd electron count 15)
tags           ( gasPhase thermoTable );
nasaEntry      "B2H5,db";
reviewStatus   interim;
reviewReason   "transcribed by machine from NASA/TP-2002-211556 into the thermoTables home and checked against the report itself; not yet read back against the page by a curator";
standardThermochemistry
{
    dHf_298    275150.616;   // J/mol  -- ideal gas; NASA/TP-2002-211556 appendix D, p. 63, entry B2H5,db
    s_298      245.703;     // J/(mol·K) -- third-law absolute; Table B1, p. 11
}

idealGasHeatCapacity
{
    //  NASA/TP-2002-211556 eq. (1), Cp/R = a1/T^2 + a2/T + a3 + a4 T + a5 T^2
    //  + a6 T^3 + a7 T^4; appendix D, p. 63, entry B2H5,db, a1..a7 as printed.
    model    NASA9;
    Tlow     200;
    Tcommon  1000;
    Thigh    6000;
    low      ( 1.424446027e+04 4.204558200e+02 -3.700451250e+00 3.672053100e-02 -3.193503730e-05 1.695013434e-08 -4.257038140e-12 );
    high     ( 2.571729448e+06 -1.356829858e+04 2.781376038e+01 -3.192365030e-03 6.561165260e-07 -7.127333940e-11 3.169492650e-15 );
}

provenance
{
    dHf_298
    {
        origin        literature;
        method        "NASA/TP-2002-211556 appendix D, p. 63, entry B2H5,db, record-line H(298.15) (elements reference, so = dHf)";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "Table B1 p. 11 prints 275.151 kJ/mol; the report's own sources: 2-Bridges. Ruscic,1989a. Trachtman,1989.";
    }
    s_298
    {
        origin        literature;
        method        "NASA/TP-2002-211556 Table B1, p. 11, entry B2H5,db";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "appendix D's coefficients with b2 integrate to 245.703";
    }
    idealGasHeatCapacity
    {
        origin        literature;
        method        "NASA/TP-2002-211556 appendix D, p. 63, entry B2H5,db, a1..a7 of the 200-1000 K and 1000-6000 K intervals, as printed";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "read by bin/curate/nasa_tp2002_to_choupo.py, which holds H and S at 298.15 K to the printed values";
    }
    source   "McBride, Zehe & Gordon, NASA Glenn Coefficients for Calculating Thermodynamic Properties of Individual Species, NASA/TP-2002-211556 (2002)";
    licence  publicDomain;    // US government work (NASA), 17 U.S.C. 105
}
