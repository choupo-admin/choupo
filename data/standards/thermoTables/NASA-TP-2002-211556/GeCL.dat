/*--------------------------------*- Choupo -*-----------------------*\
  Species GeCL (NASA/TP-2002-211556 appendix D entry "GeCL"):
  ideal-gas formation data and heat capacity transcribed by machine with
  bin/curate/nasa_tp2002_to_choupo.py table, which holds H and S at
  298.15 K recomputed from the printed coefficients to the printed
  values.  Not read back against the page by a curator.
  The report's own description and sources: Gurvich,1991 pt1 p328 pt2 p283.
\*---------------------------------------------------------------------------*/
name           GeCL;
formula        GeCl;
CAS            n/a;
MW             108.08;       // kg/kmol, = sum of the engine's atomic weights (C517; was 108.093)
role           gasOnly;       // free radical (odd electron count 49)
tags           ( gasPhase thermoTable );
nasaEntry      "GeCL";
reviewStatus   interim;
reviewReason   "transcribed by machine from NASA/TP-2002-211556 into the thermoTables home and checked against the report itself; not yet read back against the page by a curator";
standardThermochemistry
{
    dHf_298    69029.915;   // J/mol  -- ideal gas; NASA/TP-2002-211556 appendix D, p. 124, entry GeCL
    s_298      245.907;     // J/(mol·K) -- third-law absolute; Table B1, p. 20
}

idealGasHeatCapacity
{
    //  NASA/TP-2002-211556 eq. (1), Cp/R = a1/T^2 + a2/T + a3 + a4 T + a5 T^2
    //  + a6 T^3 + a7 T^4; appendix D, p. 124, entry GeCL, a1..a7 as printed.
    model    NASA9;
    Tlow     200;
    Tcommon  1000;
    Thigh    6000;
    low      ( 1.069724739e+04 -2.241238266e+01 1.987371070e+00 1.368270905e-02 -2.358294414e-05 1.786756020e-08 -5.102503250e-12 );
    high     ( -3.784193250e+05 1.429309204e+03 3.194854640e+00 8.119939120e-04 -2.652459954e-07 5.151957880e-11 -3.534214570e-15 );
}

provenance
{
    dHf_298
    {
        origin        literature;
        method        "NASA/TP-2002-211556 appendix D, p. 124, entry GeCL, record-line H(298.15) (elements reference, so = dHf)";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "Table B1 p. 20 prints 69.03 kJ/mol; the report's own sources: Gurvich,1991 pt1 p328 pt2 p283.";
    }
    s_298
    {
        origin        literature;
        method        "NASA/TP-2002-211556 Table B1, p. 20, entry GeCL";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "appendix D's coefficients with b2 integrate to 245.907";
    }
    idealGasHeatCapacity
    {
        origin        literature;
        method        "NASA/TP-2002-211556 appendix D, p. 124, entry GeCL, a1..a7 of the 200-1000 K and 1000-6000 K intervals, as printed";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "read by bin/curate/nasa_tp2002_to_choupo.py, which holds H and S at 298.15 K to the printed values";
    }
    source   "McBride, Zehe & Gordon, NASA Glenn Coefficients for Calculating Thermodynamic Properties of Individual Species, NASA/TP-2002-211556 (2002)";
    licence  publicDomain;    // US government work (NASA), 17 U.S.C. 105
}
