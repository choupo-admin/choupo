/*--------------------------------*- Choupo -*-----------------------*\
  Species CHFCLBr (NASA/TP-2002-211556 appendix D entry "CHFCLBr"):
  ideal-gas formation data and heat capacity transcribed by machine with
  bin/curate/nasa_tp2002_to_choupo.py table, which holds H and S at
  298.15 K recomputed from the printed coefficients to the printed
  values.  Not read back against the page by a curator.
  The report's own description and sources: Gurvich,1991 pt1 p176 pt2 p159.
\*---------------------------------------------------------------------------*/
name           CHFCLBr;
formula        CHFClBr;
CAS            n/a;
MW             147.374;       // kg/kmol, appendix D record line
role           radical;       // gas-only (DEV.md 4c C458): stays in the vapour, refused where no vapour holds it
tags           ( gasPhase thermoTable );
nasaEntry      "CHFCLBr";
reviewStatus   interim;
reviewReason   "transcribed by machine from NASA/TP-2002-211556 into the thermoTables home and checked against the report itself; not yet read back against the page by a curator";
standardThermochemistry
{
    dHf_298    -230000.000;   // J/mol  -- ideal gas; NASA/TP-2002-211556 appendix D, p. 80, entry CHFCLBr
    s_298      310.691;     // J/(mol·K) -- third-law absolute; Table B1, p. 14
}

idealGasHeatCapacity
{
    //  NASA/TP-2002-211556 eq. (1), Cp/R = a1/T^2 + a2/T + a3 + a4 T + a5 T^2
    //  + a6 T^3 + a7 T^4; appendix D, p. 80, entry CHFCLBr, a1..a7 as printed.
    model    NASA9;
    Tlow     200;
    Tcommon  1000;
    Thigh    6000;
    low      ( -1.959240614e+04 4.901723270e+02 -1.259408503e+00 3.617708470e-02 -4.654244960e-05 3.065240659e-08 -8.123903600e-12 );
    high     ( 5.800117510e+05 -3.823337850e+03 1.522809062e+01 -7.373906310e-04 1.407097155e-07 -1.438245319e-11 6.083867150e-16 );
}

provenance
{
    dHf_298
    {
        origin        literature;
        method        "NASA/TP-2002-211556 appendix D, p. 80, entry CHFCLBr, record-line H(298.15) (elements reference, so = dHf)";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "Table B1 p. 14 prints -230.0 kJ/mol; the report's own sources: Gurvich,1991 pt1 p176 pt2 p159.";
    }
    s_298
    {
        origin        literature;
        method        "NASA/TP-2002-211556 Table B1, p. 14, entry CHFCLBr";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "appendix D's coefficients with b2 integrate to 310.691";
    }
    idealGasHeatCapacity
    {
        origin        literature;
        method        "NASA/TP-2002-211556 appendix D, p. 80, entry CHFCLBr, a1..a7 of the 200-1000 K and 1000-6000 K intervals, as printed";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "read by bin/curate/nasa_tp2002_to_choupo.py, which holds H and S at 298.15 K to the printed values";
    }
    source   "McBride, Zehe & Gordon, NASA Glenn Coefficients for Calculating Thermodynamic Properties of Individual Species, NASA/TP-2002-211556 (2002)";
    licence  publicDomain;    // US government work (NASA), 17 U.S.C. 105
}
