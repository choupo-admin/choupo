/*--------------------------------*- Choupo -*-----------------------*\
  Species CHF2 (NASA/TP-2002-211556 appendix D entry "CHF2"):
  ideal-gas formation data and heat capacity transcribed by machine with
  bin/curate/nasa_tp2002_to_choupo.py table, which holds H and S at
  298.15 K recomputed from the printed coefficients to the printed
  values.  Not read back against the page by a curator.
  The report's own description and sources: TRC(6/88) tuvw6950.
\*---------------------------------------------------------------------------*/
name           CHF2;
formula        CHF2;
CAS            n/a;
MW             51.01545;       // kg/kmol, appendix D record line
role           gasOnly;       // free radical (odd electron count 25)
tags           ( gasPhase thermoTable );
nasaEntry      "CHF2";
reviewStatus   interim;
reviewReason   "transcribed by machine from NASA/TP-2002-211556 into the thermoTables home and checked against the report itself; not yet read back against the page by a curator";
standardThermochemistry
{
    dHf_298    -238900.000;   // J/mol  -- ideal gas; NASA/TP-2002-211556 appendix D, p. 80, entry CHF2
    s_298      258.000;     // J/(mol·K) -- third-law absolute; Table B1, p. 14
}

idealGasHeatCapacity
{
    //  NASA/TP-2002-211556 eq. (1), Cp/R = a1/T^2 + a2/T + a3 + a4 T + a5 T^2
    //  + a6 T^3 + a7 T^4; appendix D, p. 80, entry CHF2, a1..a7 as printed.
    model    NASA9;
    Tlow     200;
    Tcommon  1000;
    Thigh    6000;
    low      ( -1.469690117e+05 2.553397313e+03 -1.302627630e+01 5.438128460e-02 -6.713418790e-05 4.287651730e-08 -1.110824216e-11 );
    high     ( 5.526806550e+05 -3.696009170e+03 1.208610573e+01 -6.498588100e-04 1.120846220e-07 -9.814147010e-12 3.349192390e-16 );
}

provenance
{
    dHf_298
    {
        origin        literature;
        method        "NASA/TP-2002-211556 appendix D, p. 80, entry CHF2, record-line H(298.15) (elements reference, so = dHf)";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "Table B1 p. 14 prints -238.9 kJ/mol; the report's own sources: TRC(6/88) tuvw6950.";
    }
    s_298
    {
        origin        literature;
        method        "NASA/TP-2002-211556 Table B1, p. 14, entry CHF2";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "appendix D's coefficients with b2 integrate to 258.000";
    }
    idealGasHeatCapacity
    {
        origin        literature;
        method        "NASA/TP-2002-211556 appendix D, p. 80, entry CHF2, a1..a7 of the 200-1000 K and 1000-6000 K intervals, as printed";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "read by bin/curate/nasa_tp2002_to_choupo.py, which holds H and S at 298.15 K to the printed values";
    }
    source   "McBride, Zehe & Gordon, NASA Glenn Coefficients for Calculating Thermodynamic Properties of Individual Species, NASA/TP-2002-211556 (2002)";
    licence  publicDomain;    // US government work (NASA), 17 U.S.C. 105
}
