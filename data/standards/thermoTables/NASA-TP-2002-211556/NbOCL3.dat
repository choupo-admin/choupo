/*--------------------------------*- Choupo -*-----------------------*\
  Species NbOCL3 (NASA/TP-2002-211556 appendix D entry "NbOCL3"):
  ideal-gas formation data and heat capacity transcribed by machine with
  bin/curate/nasa_tp2002_to_choupo.py table, which holds H and S at
  298.15 K recomputed from the printed coefficients to the printed
  values.  Not read back against the page by a curator.
  The report's own description and sources: Barin,1989. Wagman,1982.
\*---------------------------------------------------------------------------*/
name           NbOCL3;
formula        NbOCl3;
CAS            n/a;
MW             215.2648;       // kg/kmol, appendix D record line
role           nonvolatile;   // ideal-gas species: no vapour pressure is asked of it
tags           ( gasPhase thermoTable );
nasaEntry      "NbOCL3";
reviewStatus   interim;
reviewReason   "transcribed by machine from NASA/TP-2002-211556 into the thermoTables home and checked against the report itself; not yet read back against the page by a curator";
standardThermochemistry
{
    dHf_298    -752300.000;   // J/mol  -- ideal gas; NASA/TP-2002-211556 appendix D, p. 163, entry NbOCL3
    s_298      358.302;     // J/(mol·K) -- third-law absolute; Table B1, p. 25
}

idealGasHeatCapacity
{
    //  NASA/TP-2002-211556 eq. (1), Cp/R = a1/T^2 + a2/T + a3 + a4 T + a5 T^2
    //  + a6 T^3 + a7 T^4; appendix D, p. 163, entry NbOCL3, a1..a7 as printed.
    model    NASA9;
    Tlow     298.15;
    Tcommon  1000;
    Thigh    6000;
    low      ( -1.108482359e+05 1.173066983e+02 1.165558433e+01 1.287422064e-03 -1.659778281e-06 1.102107826e-09 -2.949903264e-13 );
    high     ( -1.515551427e+05 5.305545230e+01 1.228915282e+01 -1.527366571e-04 6.778576440e-08 -9.365170650e-12 4.670036930e-16 );
}

provenance
{
    dHf_298
    {
        origin        literature;
        method        "NASA/TP-2002-211556 appendix D, p. 163, entry NbOCL3, record-line H(298.15) (elements reference, so = dHf)";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "Table B1 p. 25 prints -752.3 kJ/mol; the report's own sources: Barin,1989. Wagman,1982.";
    }
    s_298
    {
        origin        literature;
        method        "NASA/TP-2002-211556 Table B1, p. 25, entry NbOCL3";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "appendix D's coefficients with b2 integrate to 358.302";
    }
    idealGasHeatCapacity
    {
        origin        literature;
        method        "NASA/TP-2002-211556 appendix D, p. 163, entry NbOCL3, a1..a7 of the 298.15-1000 K and 1000-6000 K intervals, as printed";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "read by bin/curate/nasa_tp2002_to_choupo.py, which holds H and S at 298.15 K to the printed values";
    }
    source   "McBride, Zehe & Gordon, NASA Glenn Coefficients for Calculating Thermodynamic Properties of Individual Species, NASA/TP-2002-211556 (2002)";
    licence  publicDomain;    // US government work (NASA), 17 U.S.C. 105
}
