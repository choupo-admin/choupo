/*--------------------------------*- Choupo -*-----------------------*\
  Species SrF (NASA/TP-2002-211556 appendix D entry "SrF"):
  ideal-gas formation data and heat capacity transcribed by machine with
  bin/curate/nasa_tp2002_to_choupo.py table, which holds H and S at
  298.15 K recomputed from the printed coefficients to the printed
  values.  Not read back against the page by a curator.
  The report's own description and sources: Gurvich,1996a pt1 p507 pt2 p394.
\*---------------------------------------------------------------------------*/
name           SrF;
formula        SrF;
CAS            n/a;
MW             106.6184;       // kg/kmol, appendix D record line
role           radical;       // gas-only (DEV.md 4c C458): stays in the vapour, refused where no vapour holds it
tags           ( gasPhase thermoTable );
nasaEntry      "SrF";
reviewStatus   interim;
reviewReason   "transcribed by machine from NASA/TP-2002-211556 into the thermoTables home and checked against the report itself; not yet read back against the page by a curator";
standardThermochemistry
{
    dHf_298    -303552.788;   // J/mol  -- ideal gas; NASA/TP-2002-211556 appendix D, p. 196, entry SrF
    s_298      239.903;     // J/(mol·K) -- third-law absolute; Table B1, p. 30
}

idealGasHeatCapacity
{
    //  NASA/TP-2002-211556 eq. (1), Cp/R = a1/T^2 + a2/T + a3 + a4 T + a5 T^2
    //  + a6 T^3 + a7 T^4; appendix D, p. 196, entry SrF, a1..a7 as printed.
    //  The report's 6000-20000 K interval is not transcribed.
    model    NASA9;
    Tlow     200;
    Tcommon  1000;
    Thigh    6000;
    low      ( 2.725008615e+04 -4.850019720e+02 6.112697200e+00 -3.008469209e-03 3.368465800e-06 -1.987813072e-09 4.884161090e-13 );
    high     ( 8.702340490e+05 -2.589818770e+03 7.200264220e+00 -1.173446296e-03 1.996165066e-07 1.103842667e-11 -2.343183859e-15 );
}

provenance
{
    dHf_298
    {
        origin        literature;
        method        "NASA/TP-2002-211556 appendix D, p. 196, entry SrF, record-line H(298.15) (elements reference, so = dHf)";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "Table B1 p. 30 prints -303.553 kJ/mol; the report's own sources: Gurvich,1996a pt1 p507 pt2 p394.";
    }
    s_298
    {
        origin        literature;
        method        "NASA/TP-2002-211556 Table B1, p. 30, entry SrF";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "appendix D's coefficients with b2 integrate to 239.903";
    }
    idealGasHeatCapacity
    {
        origin        literature;
        method        "NASA/TP-2002-211556 appendix D, p. 196, entry SrF, a1..a7 of the 200-1000 K and 1000-6000 K intervals, as printed";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "read by bin/curate/nasa_tp2002_to_choupo.py, which holds H and S at 298.15 K to the printed values";
    }
    source   "McBride, Zehe & Gordon, NASA Glenn Coefficients for Calculating Thermodynamic Properties of Individual Species, NASA/TP-2002-211556 (2002)";
    licence  publicDomain;    // US government work (NASA), 17 U.S.C. 105
}
