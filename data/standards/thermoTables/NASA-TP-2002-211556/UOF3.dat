/*--------------------------------*- Choupo -*-----------------------*\
  Species UOF3 (NASA/TP-2002-211556 appendix D entry "UOF3"):
  ideal-gas formation data and heat capacity transcribed by machine with
  bin/curate/nasa_tp2002_to_choupo.py table, which holds H and S at
  298.15 K recomputed from the printed coefficients to the printed
  values.  Not read back against the page by a curator.
  The report's own description and sources: Gurvich,1982 pt1 p229 pt2 p264.
\*---------------------------------------------------------------------------*/
name           UOF3;
formula        UOF3;
CAS            n/a;
MW             311.0235;       // kg/kmol, appendix D record line
role           gasData;       // odd-electron d-block/actinide compound: stable, has condensed phases (not a radical)
tags           ( gasPhase thermoTable );
nasaEntry      "UOF3";
reviewStatus   interim;
reviewReason   "transcribed by machine from NASA/TP-2002-211556 into the thermoTables home and checked against the report itself; not yet read back against the page by a curator";
standardThermochemistry
{
    dHf_298    -1510638.039;   // J/mol  -- ideal gas; NASA/TP-2002-211556 appendix D, p. 204, entry UOF3
    s_298      353.073;     // J/(mol·K) -- third-law absolute; Table B1, p. 31
}

idealGasHeatCapacity
{
    //  NASA/TP-2002-211556 eq. (1), Cp/R = a1/T^2 + a2/T + a3 + a4 T + a5 T^2
    //  + a6 T^3 + a7 T^4; appendix D, p. 204, entry UOF3, a1..a7 as printed.
    model    NASA9;
    Tlow     200;
    Tcommon  1000;
    Thigh    6000;
    low      ( 1.249256374e+05 -2.111719498e+03 1.844931536e+01 -1.041493583e-02 1.469002962e-05 -1.049770051e-08 2.922353602e-12 );
    high     ( -1.658296049e+06 3.714434680e+03 9.202425540e+00 2.412862293e-03 -5.666241720e-07 5.989062110e-11 -2.424534810e-15 );
}

provenance
{
    dHf_298
    {
        origin        literature;
        method        "NASA/TP-2002-211556 appendix D, p. 204, entry UOF3, record-line H(298.15) (elements reference, so = dHf)";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "Table B1 p. 31 prints -1510.638 kJ/mol; the report's own sources: Gurvich,1982 pt1 p229 pt2 p264.";
    }
    s_298
    {
        origin        literature;
        method        "NASA/TP-2002-211556 Table B1, p. 31, entry UOF3";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "appendix D's coefficients with b2 integrate to 353.073";
    }
    idealGasHeatCapacity
    {
        origin        literature;
        method        "NASA/TP-2002-211556 appendix D, p. 204, entry UOF3, a1..a7 of the 200-1000 K and 1000-6000 K intervals, as printed";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "read by bin/curate/nasa_tp2002_to_choupo.py, which holds H and S at 298.15 K to the printed values";
    }
    source   "McBride, Zehe & Gordon, NASA Glenn Coefficients for Calculating Thermodynamic Properties of Individual Species, NASA/TP-2002-211556 (2002)";
    licence  publicDomain;    // US government work (NASA), 17 U.S.C. 105
}
