/*--------------------------------*- Choupo -*-----------------------*\
  Species BHFCL (NASA/TP-2002-211556 appendix D entry "BHFCL"):
  ideal-gas formation data and heat capacity transcribed by machine with
  bin/curate/nasa_tp2002_to_choupo.py table, which holds H and S at
  298.15 K recomputed from the printed coefficients to the printed
  values.  Not read back against the page by a curator.
  The report's own description and sources: Gurvich,1996a pt1 p90 pt2 p69.
\*---------------------------------------------------------------------------*/
name           BHFCL;
formula        BHFCl;
CAS            n/a;
MW             66.27034;       // kg/kmol, appendix D record line
role           gasData;       // closed-shell molecule (or noble gas): ideal-gas data only, no liquid model
tags           ( gasPhase thermoTable );
nasaEntry      "BHFCL";
reviewStatus   interim;
reviewReason   "transcribed by machine from NASA/TP-2002-211556 into the thermoTables home and checked against the report itself; not yet read back against the page by a curator";
standardThermochemistry
{
    dHf_298    -483036.620;   // J/mol  -- ideal gas; NASA/TP-2002-211556 appendix D, p. 59, entry BHFCL
    s_298      263.145;     // J/(mol·K) -- third-law absolute; Table B1, p. 11
}

idealGasHeatCapacity
{
    //  NASA/TP-2002-211556 eq. (1), Cp/R = a1/T^2 + a2/T + a3 + a4 T + a5 T^2
    //  + a6 T^3 + a7 T^4; appendix D, p. 59, entry BHFCL, a1..a7 as printed.
    model    NASA9;
    Tlow     200;
    Tcommon  1000;
    Thigh    6000;
    low      ( 5.761169720e+02 3.042156250e+02 -9.808900360e-01 2.803843648e-02 -3.676734020e-05 2.499824138e-08 -6.873421640e-12 );
    high     ( 4.390778920e+05 -3.137181709e+03 1.200286161e+01 -7.153669340e-04 1.453878608e-07 -1.565197070e-11 6.910075060e-16 );
}

provenance
{
    dHf_298
    {
        origin        literature;
        method        "NASA/TP-2002-211556 appendix D, p. 59, entry BHFCL, record-line H(298.15) (elements reference, so = dHf)";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "Table B1 p. 11 prints -483.037 kJ/mol; the report's own sources: Gurvich,1996a pt1 p90 pt2 p69.";
    }
    s_298
    {
        origin        literature;
        method        "NASA/TP-2002-211556 Table B1, p. 11, entry BHFCL";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "appendix D's coefficients with b2 integrate to 263.145";
    }
    idealGasHeatCapacity
    {
        origin        literature;
        method        "NASA/TP-2002-211556 appendix D, p. 59, entry BHFCL, a1..a7 of the 200-1000 K and 1000-6000 K intervals, as printed";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "read by bin/curate/nasa_tp2002_to_choupo.py, which holds H and S at 298.15 K to the printed values";
    }
    source   "McBride, Zehe & Gordon, NASA Glenn Coefficients for Calculating Thermodynamic Properties of Individual Species, NASA/TP-2002-211556 (2002)";
    licence  publicDomain;    // US government work (NASA), 17 U.S.C. 105
}
