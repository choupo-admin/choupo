/*--------------------------------*- Choupo -*-----------------------*\
  Species SN (NASA/TP-2002-211556 appendix D entry "SN"):
  ideal-gas formation data and heat capacity transcribed by machine with
  bin/curate/nasa_tp2002_to_choupo.py table, which holds H and S at
  298.15 K recomputed from the printed coefficients to the printed
  values.  Not read back against the page by a curator.
  The report's own description and sources: Gurvich,1989 pt1 p392 pt2 p252.
\*---------------------------------------------------------------------------*/
name           SN;
formula        SN;
CAS            n/a;
MW             46.0717;       // kg/kmol, appendix D record line
role           gasOnly;       // free radical (odd electron count 23)
tags           ( gasPhase thermoTable );
nasaEntry      "SN";
reviewStatus   interim;
reviewReason   "transcribed by machine from NASA/TP-2002-211556 into the thermoTables home and checked against the report itself; not yet read back against the page by a curator";
standardThermochemistry
{
    dHf_298    267388.313;   // J/mol  -- ideal gas; NASA/TP-2002-211556 appendix D, p. 182, entry SN
    s_298      222.095;     // J/(mol·K) -- third-law absolute; Table B1, p. 28
}

idealGasHeatCapacity
{
    //  NASA/TP-2002-211556 eq. (1), Cp/R = a1/T^2 + a2/T + a3 + a4 T + a5 T^2
    //  + a6 T^3 + a7 T^4; appendix D, p. 182, entry SN, a1..a7 as printed.
    model    NASA9;
    Tlow     200;
    Tcommon  1000;
    Thigh    6000;
    low      ( -6.835412350e+04 1.147567483e+03 -2.877802574e+00 1.724864320e-02 -2.058999904e-05 1.261369640e-08 -3.139030141e-12 );
    high     ( -4.837284460e+05 1.058075590e+03 3.086198804e+00 9.111360780e-04 -2.764061722e-07 4.157370110e-11 -2.128351755e-15 );
}

provenance
{
    dHf_298
    {
        origin        literature;
        method        "NASA/TP-2002-211556 appendix D, p. 182, entry SN, record-line H(298.15) (elements reference, so = dHf)";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "Table B1 p. 28 prints 267.388 kJ/mol; the report's own sources: Gurvich,1989 pt1 p392 pt2 p252.";
    }
    s_298
    {
        origin        literature;
        method        "NASA/TP-2002-211556 Table B1, p. 28, entry SN";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "appendix D's coefficients with b2 integrate to 222.095";
    }
    idealGasHeatCapacity
    {
        origin        literature;
        method        "NASA/TP-2002-211556 appendix D, p. 182, entry SN, a1..a7 of the 200-1000 K and 1000-6000 K intervals, as printed";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "read by bin/curate/nasa_tp2002_to_choupo.py, which holds H and S at 298.15 K to the printed values";
    }
    source   "McBride, Zehe & Gordon, NASA Glenn Coefficients for Calculating Thermodynamic Properties of Individual Species, NASA/TP-2002-211556 (2002)";
    licence  publicDomain;    // US government work (NASA), 17 U.S.C. 105
}
