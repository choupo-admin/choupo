/*--------------------------------*- Choupo -*-----------------------*\
  Species C4H9_ibutyl (NASA/TP-2002-211556 appendix D entry "C4H9,i-butyl"):
  ideal-gas formation data and heat capacity transcribed by machine with
  bin/curate/nasa_tp2002_to_choupo.py table, which holds H and S at
  298.15 K recomputed from the printed coefficients to the printed
  values.  Not read back against the page by a curator.
  The report's own description and sources: 2-methylpropyl. TRC(10/84) tuvw1940.
\*---------------------------------------------------------------------------*/
name           C4H9_ibutyl;
formula        C4H9;
CAS            n/a;
MW             57.11426;       // kg/kmol, appendix D record line
role           nonvolatile;   // ideal-gas species: no vapour pressure is asked of it
tags           ( gasPhase thermoTable );
nasaEntry      "C4H9,i-butyl";
reviewStatus   interim;
reviewReason   "transcribed by machine from NASA/TP-2002-211556 into the thermoTables home and checked against the report itself; not yet read back against the page by a curator";
standardThermochemistry
{
    dHf_298    57320.000;   // J/mol  -- ideal gas; NASA/TP-2002-211556 appendix D, p. 98, entry C4H9,i-butyl
    s_298      318.649;     // J/(mol·K) -- third-law absolute; Table B1, p. 16
}

idealGasHeatCapacity
{
    //  NASA/TP-2002-211556 eq. (1), Cp/R = a1/T^2 + a2/T + a3 + a4 T + a5 T^2
    //  + a6 T^3 + a7 T^4; appendix D, p. 98, entry C4H9,i-butyl, a1..a7 as printed.
    model    NASA9;
    Tlow     200;
    Tcommon  1000;
    Thigh    6000;
    low      ( -2.399461281e+05 4.697444540e+03 -3.087472560e+01 1.391655831e-01 -1.670233968e-04 1.092423088e-07 -2.936209962e-11 );
    high     ( 6.752936060e+06 -2.837423721e+04 5.140687610e+01 -4.982399010e-03 8.801506630e-07 -8.125738690e-11 3.099140009e-15 );
}

provenance
{
    dHf_298
    {
        origin        literature;
        method        "NASA/TP-2002-211556 appendix D, p. 98, entry C4H9,i-butyl, record-line H(298.15) (elements reference, so = dHf)";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "Table B1 p. 16 prints 57.32 kJ/mol; the report's own sources: 2-methylpropyl. TRC(10/84) tuvw1940.";
    }
    s_298
    {
        origin        literature;
        method        "NASA/TP-2002-211556 Table B1, p. 16, entry C4H9,i-butyl";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "appendix D's coefficients with b2 integrate to 318.649";
    }
    idealGasHeatCapacity
    {
        origin        literature;
        method        "NASA/TP-2002-211556 appendix D, p. 98, entry C4H9,i-butyl, a1..a7 of the 200-1000 K and 1000-6000 K intervals, as printed";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "read by bin/curate/nasa_tp2002_to_choupo.py, which holds H and S at 298.15 K to the printed values";
    }
    source   "McBride, Zehe & Gordon, NASA Glenn Coefficients for Calculating Thermodynamic Properties of Individual Species, NASA/TP-2002-211556 (2002)";
    licence  publicDomain;    // US government work (NASA), 17 U.S.C. 105
}
