/*--------------------------------*- Choupo -*-----------------------*\
  Species ALCL3 (NASA/TP-2002-211556 appendix D entry "ALCL3"):
  ideal-gas formation data and heat capacity transcribed by machine with
  bin/curate/nasa_tp2002_to_choupo.py table, which holds H and S at
  298.15 K recomputed from the printed coefficients to the printed
  values.  Not read back against the page by a curator.
  The report's own description and sources: Gurvich,1996a pt1 p173 pt2 p134.
\*---------------------------------------------------------------------------*/
name           ALCL3;
formula        AlCl3;
CAS            n/a;
MW             133.3405;       // kg/kmol, appendix D record line
role           nonvolatile;   // ideal-gas species: no vapour pressure is asked of it
tags           ( gasPhase thermoTable );
nasaEntry      "ALCL3";
reviewStatus   interim;
reviewReason   "transcribed by machine from NASA/TP-2002-211556 into the thermoTables home and checked against the report itself; not yet read back against the page by a curator";
standardThermochemistry
{
    dHf_298    -584678.863;   // J/mol  -- ideal gas; NASA/TP-2002-211556 appendix D, p. 47, entry ALCL3
    s_298      313.089;     // J/(mol·K) -- third-law absolute; Table B1, p. 9
}

idealGasHeatCapacity
{
    //  NASA/TP-2002-211556 eq. (1), Cp/R = a1/T^2 + a2/T + a3 + a4 T + a5 T^2
    //  + a6 T^3 + a7 T^4; appendix D, p. 47, entry ALCL3, a1..a7 as printed.
    model    NASA9;
    Tlow     200;
    Tcommon  1000;
    Thigh    6000;
    low      ( 7.750600970e+04 -1.440779717e+03 1.401744141e+01 -6.381631240e-03 5.871674720e-06 -2.908872278e-09 5.994050890e-13 );
    high     ( -1.378630916e+05 -5.579207290e+01 1.004190387e+01 -1.682165339e-05 3.724664660e-09 -4.275526780e-13 1.982341329e-17 );
}

provenance
{
    dHf_298
    {
        origin        literature;
        method        "NASA/TP-2002-211556 appendix D, p. 47, entry ALCL3, record-line H(298.15) (elements reference, so = dHf)";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "Table B1 p. 9 prints -584.679 kJ/mol; the report's own sources: Gurvich,1996a pt1 p173 pt2 p134.";
    }
    s_298
    {
        origin        literature;
        method        "NASA/TP-2002-211556 Table B1, p. 9, entry ALCL3";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "appendix D's coefficients with b2 integrate to 313.089";
    }
    idealGasHeatCapacity
    {
        origin        literature;
        method        "NASA/TP-2002-211556 appendix D, p. 47, entry ALCL3, a1..a7 of the 200-1000 K and 1000-6000 K intervals, as printed";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "read by bin/curate/nasa_tp2002_to_choupo.py, which holds H and S at 298.15 K to the printed values";
    }
    source   "McBride, Zehe & Gordon, NASA Glenn Coefficients for Calculating Thermodynamic Properties of Individual Species, NASA/TP-2002-211556 (2002)";
    licence  publicDomain;    // US government work (NASA), 17 U.S.C. 105
}
