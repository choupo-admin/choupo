/*--------------------------------*- Choupo -*-----------------------*\
  Species Ni (NASA/TP-2002-211556 appendix D entry "Ni"):
  ideal-gas formation data and heat capacity transcribed by machine with
  bin/curate/nasa_tp2002_to_choupo.py table, which holds H and S at
  298.15 K recomputed from the printed coefficients to the printed
  values.  Not read back against the page by a curator.
  The report's own description and sources: Hf:Hultgren,1973. Litzen,1993. Gordon,1999.
\*---------------------------------------------------------------------------*/
name           Ni;
formula        Ni;
CAS            n/a;
MW             58.6934;       // kg/kmol, appendix D record line
role           gasData;       // free metal atom: a liquid or solid metal exists, no liquid model here
tags           ( gasPhase thermoTable );
nasaEntry      "Ni";
reviewStatus   interim;
reviewReason   "transcribed by machine from NASA/TP-2002-211556 into the thermoTables home and checked against the report itself; not yet read back against the page by a curator";
standardThermochemistry
{
    dHf_298    430116.605;   // J/mol  -- ideal gas; NASA/TP-2002-211556 appendix D, p. 163, entry Ni
    s_298      182.193;     // J/(mol·K) -- third-law absolute; Table B1, p. 25
}

idealGasHeatCapacity
{
    //  NASA/TP-2002-211556 eq. (1), Cp/R = a1/T^2 + a2/T + a3 + a4 T + a5 T^2
    //  + a6 T^3 + a7 T^4; appendix D, p. 163, entry Ni, a1..a7 as printed.
    //  The report's 6000-20000 K interval is not transcribed.
    model    NASA9;
    Tlow     200;
    Tcommon  1000;
    Thigh    6000;
    low      ( -3.235810550e+04 6.015264620e+02 -1.079270657e+00 1.089505519e-02 -1.369578748e-05 8.317725790e-09 -2.019206968e-12 );
    high     ( -4.938262210e+05 1.092909991e+03 2.410485014e+00 -1.599071827e-05 -1.047414069e-08 4.624795210e-12 -4.448865218e-17 );
}

provenance
{
    dHf_298
    {
        origin        literature;
        method        "NASA/TP-2002-211556 appendix D, p. 163, entry Ni, record-line H(298.15) (elements reference, so = dHf)";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "Table B1 p. 25 prints 430.117 kJ/mol; the report's own sources: Hf:Hultgren,1973. Litzen,1993. Gordon,1999.";
    }
    s_298
    {
        origin        literature;
        method        "NASA/TP-2002-211556 Table B1, p. 25, entry Ni";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "appendix D's coefficients with b2 integrate to 182.193";
    }
    idealGasHeatCapacity
    {
        origin        literature;
        method        "NASA/TP-2002-211556 appendix D, p. 163, entry Ni, a1..a7 of the 200-1000 K and 1000-6000 K intervals, as printed";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "read by bin/curate/nasa_tp2002_to_choupo.py, which holds H and S at 298.15 K to the printed values";
    }
    source   "McBride, Zehe & Gordon, NASA Glenn Coefficients for Calculating Thermodynamic Properties of Individual Species, NASA/TP-2002-211556 (2002)";
    licence  publicDomain;    // US government work (NASA), 17 U.S.C. 105
}
