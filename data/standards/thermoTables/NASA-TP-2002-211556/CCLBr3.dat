/*--------------------------------*- Choupo -*-----------------------*\
  Species CCLBr3 (NASA/TP-2002-211556 appendix D entry "CCLBr3"):
  ideal-gas formation data and heat capacity transcribed by machine with
  bin/curate/nasa_tp2002_to_choupo.py table, which holds H and S at
  298.15 K recomputed from the printed coefficients to the printed
  values.  Not read back against the page by a curator.
  The report's own description and sources: Gurvich,1991 pt1 p171 pt2 p152.
\*---------------------------------------------------------------------------*/
name           CCLBr3;
formula        CClBr3;
CAS            n/a;
MW             287.1757;       // kg/kmol, appendix D record line
role           nonvolatile;   // ideal-gas species: no vapour pressure is asked of it
tags           ( gasPhase thermoTable );
nasaEntry      "CCLBr3";
reviewStatus   interim;
reviewReason   "transcribed by machine from NASA/TP-2002-211556 into the thermoTables home and checked against the report itself; not yet read back against the page by a curator";
standardThermochemistry
{
    dHf_298    65000.000;   // J/mol  -- ideal gas; NASA/TP-2002-211556 appendix D, p. 75, entry CCLBr3
    s_298      357.617;     // J/(mol·K) -- third-law absolute; Table B1, p. 13
}

idealGasHeatCapacity
{
    //  NASA/TP-2002-211556 eq. (1), Cp/R = a1/T^2 + a2/T + a3 + a4 T + a5 T^2
    //  + a6 T^3 + a7 T^4; appendix D, p. 75, entry CCLBr3, a1..a7 as printed.
    model    NASA9;
    Tlow     200;
    Tcommon  1000;
    Thigh    6000;
    low      ( 1.021596752e+05 -1.746281176e+03 1.598215634e+01 -1.350975234e-03 -2.330039129e-06 3.201856270e-09 -1.150412393e-12 );
    high     ( -2.282709343e+05 -1.277037936e+02 1.309470658e+01 -3.763326710e-05 8.264715600e-09 -9.424237560e-13 4.345940760e-17 );
}

provenance
{
    dHf_298
    {
        origin        literature;
        method        "NASA/TP-2002-211556 appendix D, p. 75, entry CCLBr3, record-line H(298.15) (elements reference, so = dHf)";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "Table B1 p. 13 prints 65.0 kJ/mol; the report's own sources: Gurvich,1991 pt1 p171 pt2 p152.";
    }
    s_298
    {
        origin        literature;
        method        "NASA/TP-2002-211556 Table B1, p. 13, entry CCLBr3";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "appendix D's coefficients with b2 integrate to 357.617";
    }
    idealGasHeatCapacity
    {
        origin        literature;
        method        "NASA/TP-2002-211556 appendix D, p. 75, entry CCLBr3, a1..a7 of the 200-1000 K and 1000-6000 K intervals, as printed";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "read by bin/curate/nasa_tp2002_to_choupo.py, which holds H and S at 298.15 K to the printed values";
    }
    source   "McBride, Zehe & Gordon, NASA Glenn Coefficients for Calculating Thermodynamic Properties of Individual Species, NASA/TP-2002-211556 (2002)";
    licence  publicDomain;    // US government work (NASA), 17 U.S.C. 105
}
