/*--------------------------------*- Choupo -*-----------------------*\
  Species PF3CL2 (NASA/TP-2002-211556 appendix D entry "PF3CL2"):
  ideal-gas formation data and heat capacity transcribed by machine with
  bin/curate/nasa_tp2002_to_choupo.py table, which holds H and S at
  298.15 K recomputed from the printed coefficients to the printed
  values.  Not read back against the page by a curator.
  The report's own description and sources: Gurvich,1989 pt1 p441 pt2 p293.
\*---------------------------------------------------------------------------*/
name           PF3CL2;
formula        PF3Cl2;
CAS            n/a;
MW             158.875;       // kg/kmol, appendix D record line
role           gasData;       // closed-shell molecule (or noble gas): ideal-gas data only, no liquid model
tags           ( gasPhase thermoTable );
nasaEntry      "PF3CL2";
reviewStatus   interim;
reviewReason   "transcribed by machine from NASA/TP-2002-211556 into the thermoTables home and checked against the report itself; not yet read back against the page by a curator";
standardThermochemistry
{
    dHf_298    -1122022.916;   // J/mol  -- ideal gas; NASA/TP-2002-211556 appendix D, p. 169, entry PF3CL2
    s_298      335.435;     // J/(mol·K) -- third-law absolute; Table B1, p. 26
}

idealGasHeatCapacity
{
    //  NASA/TP-2002-211556 eq. (1), Cp/R = a1/T^2 + a2/T + a3 + a4 T + a5 T^2
    //  + a6 T^3 + a7 T^4; appendix D, p. 169, entry PF3CL2, a1..a7 as printed.
    model    NASA9;
    Tlow     200;
    Tcommon  1000;
    Thigh    6000;
    low      ( 1.822497206e+05 -3.089610245e+03 2.067710388e+01 -1.168732391e-03 -5.020540740e-06 5.804573350e-09 -1.965367906e-12 );
    high     ( -4.223838050e+05 -3.207965220e+02 1.624013000e+01 -9.623655310e-05 2.129279712e-08 -2.443515401e-12 1.132904350e-16 );
}

provenance
{
    dHf_298
    {
        origin        literature;
        method        "NASA/TP-2002-211556 appendix D, p. 169, entry PF3CL2, record-line H(298.15) (elements reference, so = dHf)";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "Table B1 p. 26 prints -1122.023 kJ/mol; the report's own sources: Gurvich,1989 pt1 p441 pt2 p293.";
    }
    s_298
    {
        origin        literature;
        method        "NASA/TP-2002-211556 Table B1, p. 26, entry PF3CL2";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "appendix D's coefficients with b2 integrate to 335.435";
    }
    idealGasHeatCapacity
    {
        origin        literature;
        method        "NASA/TP-2002-211556 appendix D, p. 169, entry PF3CL2, a1..a7 of the 200-1000 K and 1000-6000 K intervals, as printed";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "read by bin/curate/nasa_tp2002_to_choupo.py, which holds H and S at 298.15 K to the printed values";
    }
    source   "McBride, Zehe & Gordon, NASA Glenn Coefficients for Calculating Thermodynamic Properties of Individual Species, NASA/TP-2002-211556 (2002)";
    licence  publicDomain;    // US government work (NASA), 17 U.S.C. 105
}
