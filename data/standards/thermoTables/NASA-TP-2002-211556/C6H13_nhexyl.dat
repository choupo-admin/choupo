/*--------------------------------*- Choupo -*-----------------------*\
  Species C6H13_nhexyl (NASA/TP-2002-211556 appendix D entry "C6H13,n-hexyl"):
  ideal-gas formation data and heat capacity transcribed by machine with
  bin/curate/nasa_tp2002_to_choupo.py table, which holds H and S at
  298.15 K recomputed from the printed coefficients to the printed
  values.  Not read back against the page by a curator.
  The report's own description and sources: TRC(10/83) tuvw1930.
\*---------------------------------------------------------------------------*/
name           C6H13_nhexyl;
formula        C6H13;
CAS            n/a;
MW             85.16742;       // kg/kmol, appendix D record line
role           nonvolatile;   // ideal-gas species: no vapour pressure is asked of it
tags           ( gasPhase thermoTable );
nasaEntry      "C6H13,n-hexyl";
reviewStatus   interim;
reviewReason   "transcribed by machine from NASA/TP-2002-211556 into the thermoTables home and checked against the report itself; not yet read back against the page by a curator";
standardThermochemistry
{
    dHf_298    25100.000;   // J/mol  -- ideal gas; NASA/TP-2002-211556 appendix D, p. 101, entry C6H13,n-hexyl
    s_298      408.339;     // J/(mol·K) -- third-law absolute; Table B1, p. 17
}

idealGasHeatCapacity
{
    //  NASA/TP-2002-211556 eq. (1), Cp/R = a1/T^2 + a2/T + a3 + a4 T + a5 T^2
    //  + a6 T^3 + a7 T^4; appendix D, p. 101, entry C6H13,n-hexyl, a1..a7 as printed.
    model    NASA9;
    Tlow     200;
    Tcommon  1000;
    Thigh    6000;
    low      ( -1.427278220e+06 2.248828093e+04 -1.297492240e+02 4.279797330e-01 -5.556013180e-04 3.791256940e-07 -1.048462404e-10 );
    high     ( 5.967938620e+06 -3.299023160e+04 6.869073440e+01 -4.225009060e-03 5.496523820e-07 -2.292851471e-11 -5.086341890e-16 );
}

provenance
{
    dHf_298
    {
        origin        literature;
        method        "NASA/TP-2002-211556 appendix D, p. 101, entry C6H13,n-hexyl, record-line H(298.15) (elements reference, so = dHf)";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "Table B1 p. 17 prints 25.1 kJ/mol; the report's own sources: TRC(10/83) tuvw1930.";
    }
    s_298
    {
        origin        literature;
        method        "NASA/TP-2002-211556 Table B1, p. 17, entry C6H13,n-hexyl";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "appendix D's coefficients with b2 integrate to 408.339";
    }
    idealGasHeatCapacity
    {
        origin        literature;
        method        "NASA/TP-2002-211556 appendix D, p. 101, entry C6H13,n-hexyl, a1..a7 of the 200-1000 K and 1000-6000 K intervals, as printed";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "read by bin/curate/nasa_tp2002_to_choupo.py, which holds H and S at 298.15 K to the printed values";
    }
    source   "McBride, Zehe & Gordon, NASA Glenn Coefficients for Calculating Thermodynamic Properties of Individual Species, NASA/TP-2002-211556 (2002)";
    licence  publicDomain;    // US government work (NASA), 17 U.S.C. 105
}
