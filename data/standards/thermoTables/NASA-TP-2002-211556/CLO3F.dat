/*--------------------------------*- Choupo -*-----------------------*\
  Species CLO3F (NASA/TP-2002-211556 appendix D entry "CLO3F"):
  ideal-gas formation data and heat capacity transcribed by machine with
  bin/curate/nasa_tp2002_to_choupo.py table, which holds H and S at
  298.15 K recomputed from the printed coefficients to the printed
  values.  Not read back against the page by a curator.
  The report's own description and sources: Hf:Wagman,1982 p49. Chase,1998 p755. React.
\*---------------------------------------------------------------------------*/
name           CLO3F;
formula        ClO3F;
CAS            n/a;
MW             102.4496;       // kg/kmol, appendix D record line
role           radical;       // gas-only (DEV.md 4c C458): stays in the vapour, refused where no vapour holds it
tags           ( gasPhase thermoTable );
nasaEntry      "CLO3F";
reviewStatus   interim;
reviewReason   "transcribed by machine from NASA/TP-2002-211556 into the thermoTables home and checked against the report itself; not yet read back against the page by a curator";
standardThermochemistry
{
    dHf_298    -23800.000;   // J/mol  -- ideal gas; NASA/TP-2002-211556 appendix D, p. 278, entry CLO3F
    s_298      278.989;     // J/(mol·K) -- third-law absolute; Table B1, p. 32
}

idealGasHeatCapacity
{
    //  NASA/TP-2002-211556 eq. (1), Cp/R = a1/T^2 + a2/T + a3 + a4 T + a5 T^2
    //  + a6 T^3 + a7 T^4; appendix D, p. 278, entry CLO3F, a1..a7 as printed.
    model    NASA9;
    Tlow     200;
    Tcommon  1000;
    Thigh    6000;
    low      ( 4.461077310e+04 -5.892352210e+02 3.558850810e+00 2.809585831e-02 -3.610880350e-05 2.273331859e-08 -5.716733040e-12 );
    high     ( -3.910495440e+05 -1.193220687e+03 1.388657545e+01 -3.541312060e-04 7.825464770e-08 -8.978325430e-12 4.163869660e-16 );
}

provenance
{
    dHf_298
    {
        origin        literature;
        method        "NASA/TP-2002-211556 appendix D, p. 278, entry CLO3F, record-line H(298.15) (elements reference, so = dHf)";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "Table B1 p. 32 prints -23.8 kJ/mol; the report's own sources: Hf:Wagman,1982 p49. Chase,1998 p755. React.";
    }
    s_298
    {
        origin        literature;
        method        "NASA/TP-2002-211556 Table B1, p. 32, entry CLO3F";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "appendix D's coefficients with b2 integrate to 278.989";
    }
    idealGasHeatCapacity
    {
        origin        literature;
        method        "NASA/TP-2002-211556 appendix D, p. 278, entry CLO3F, a1..a7 of the 200-1000 K and 1000-6000 K intervals, as printed";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "read by bin/curate/nasa_tp2002_to_choupo.py, which holds H and S at 298.15 K to the printed values";
    }
    source   "McBride, Zehe & Gordon, NASA Glenn Coefficients for Calculating Thermodynamic Properties of Individual Species, NASA/TP-2002-211556 (2002)";
    licence  publicDomain;    // US government work (NASA), 17 U.S.C. 105
}
