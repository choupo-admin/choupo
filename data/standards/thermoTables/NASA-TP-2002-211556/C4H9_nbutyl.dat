/*--------------------------------*- Choupo -*-----------------------*\
  Species C4H9_nbutyl (NASA/TP-2002-211556 appendix D entry "C4H9,n-butyl"):
  ideal-gas formation data and heat capacity transcribed by machine with
  bin/curate/nasa_tp2002_to_choupo.py table, which holds H and S at
  298.15 K recomputed from the printed coefficients to the printed
  values.  Not read back against the page by a curator.
  The report's own description and sources: TRC(10/84) tuvw1940.
\*---------------------------------------------------------------------------*/
name           C4H9_nbutyl;
formula        C4H9;
CAS            n/a;
MW             57.11426;       // kg/kmol, appendix D record line
role           gasOnly;       // free radical (odd electron count 33)
tags           ( gasPhase thermoTable );
nasaEntry      "C4H9,n-butyl";
reviewStatus   interim;
reviewReason   "transcribed by machine from NASA/TP-2002-211556 into the thermoTables home and checked against the report itself; not yet read back against the page by a curator";
standardThermochemistry
{
    dHf_298    66530.000;   // J/mol  -- ideal gas; NASA/TP-2002-211556 appendix D, p. 98, entry C4H9,n-butyl
    s_298      328.519;     // J/(mol·K) -- third-law absolute; Table B1, p. 16
}

idealGasHeatCapacity
{
    //  NASA/TP-2002-211556 eq. (1), Cp/R = a1/T^2 + a2/T + a3 + a4 T + a5 T^2
    //  + a6 T^3 + a7 T^4; appendix D, p. 98, entry C4H9,n-butyl, a1..a7 as printed.
    model    NASA9;
    Tlow     200;
    Tcommon  1000;
    Thigh    6000;
    low      ( -2.239560407e+05 4.676554100e+03 -2.985424449e+01 1.345493704e-01 -1.600660350e-04 1.045338096e-07 -2.812951048e-11 );
    high     ( 7.198686940e+06 -2.959241524e+04 5.242042810e+01 -5.441572440e-03 9.917758370e-07 -9.464455870e-11 3.729487040e-15 );
}

provenance
{
    dHf_298
    {
        origin        literature;
        method        "NASA/TP-2002-211556 appendix D, p. 98, entry C4H9,n-butyl, record-line H(298.15) (elements reference, so = dHf)";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "Table B1 p. 16 prints 66.53 kJ/mol; the report's own sources: TRC(10/84) tuvw1940.";
    }
    s_298
    {
        origin        literature;
        method        "NASA/TP-2002-211556 Table B1, p. 16, entry C4H9,n-butyl";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "appendix D's coefficients with b2 integrate to 328.519";
    }
    idealGasHeatCapacity
    {
        origin        literature;
        method        "NASA/TP-2002-211556 appendix D, p. 98, entry C4H9,n-butyl, a1..a7 of the 200-1000 K and 1000-6000 K intervals, as printed";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "read by bin/curate/nasa_tp2002_to_choupo.py, which holds H and S at 298.15 K to the printed values";
    }
    source   "McBride, Zehe & Gordon, NASA Glenn Coefficients for Calculating Thermodynamic Properties of Individual Species, NASA/TP-2002-211556 (2002)";
    licence  publicDomain;    // US government work (NASA), 17 U.S.C. 105
}
