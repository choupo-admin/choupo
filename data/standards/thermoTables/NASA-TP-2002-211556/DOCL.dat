/*--------------------------------*- Choupo -*-----------------------*\
  Species DOCL (NASA/TP-2002-211556 appendix D entry "DOCL"):
  ideal-gas formation data and heat capacity transcribed by machine with
  bin/curate/nasa_tp2002_to_choupo.py table, which holds H and S at
  298.15 K recomputed from the printed coefficients to the printed
  values.  Not read back against the page by a curator.
  The report's own description and sources: D0 estimated from HOCL. Jacox,1998 p155.
\*---------------------------------------------------------------------------*/
name           DOCL;
formula        DOCl;
CAS            n/a;
MW             53.4665;       // kg/kmol, appendix D record line
role           nonvolatile;   // ideal-gas species: no vapour pressure is asked of it
tags           ( gasPhase thermoTable );
nasaEntry      "DOCL";
reviewStatus   interim;
reviewReason   "transcribed by machine from NASA/TP-2002-211556 into the thermoTables home and checked against the report itself; not yet read back against the page by a curator";
standardThermochemistry
{
    dHf_298    -79538.686;   // J/mol  -- ideal gas; NASA/TP-2002-211556 appendix D, p. 115, entry DOCL
    s_298      240.321;     // J/(mol·K) -- third-law absolute; Table B1, p. 19
}

idealGasHeatCapacity
{
    //  NASA/TP-2002-211556 eq. (1), Cp/R = a1/T^2 + a2/T + a3 + a4 T + a5 T^2
    //  + a6 T^3 + a7 T^4; appendix D, p. 115, entry DOCL, a1..a7 as printed.
    model    NASA9;
    Tlow     200;
    Tcommon  1000;
    Thigh    6000;
    low      ( 6.852834290e+04 -7.673444550e+02 5.933970140e+00 2.868820667e-03 -5.207166370e-06 4.927572740e-09 -1.709526276e-12 );
    high     ( 6.043066330e+05 -2.646500381e+03 8.612474210e+00 -5.532268240e-04 1.086845232e-07 -1.137381290e-11 4.904295520e-16 );
}

provenance
{
    dHf_298
    {
        origin        literature;
        method        "NASA/TP-2002-211556 appendix D, p. 115, entry DOCL, record-line H(298.15) (elements reference, so = dHf)";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "Table B1 p. 19 prints -79.539 kJ/mol; the report's own sources: D0 estimated from HOCL. Jacox,1998 p155.";
    }
    s_298
    {
        origin        literature;
        method        "NASA/TP-2002-211556 Table B1, p. 19, entry DOCL";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "appendix D's coefficients with b2 integrate to 240.321";
    }
    idealGasHeatCapacity
    {
        origin        literature;
        method        "NASA/TP-2002-211556 appendix D, p. 115, entry DOCL, a1..a7 of the 200-1000 K and 1000-6000 K intervals, as printed";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "read by bin/curate/nasa_tp2002_to_choupo.py, which holds H and S at 298.15 K to the printed values";
    }
    source   "McBride, Zehe & Gordon, NASA Glenn Coefficients for Calculating Thermodynamic Properties of Individual Species, NASA/TP-2002-211556 (2002)";
    licence  publicDomain;    // US government work (NASA), 17 U.S.C. 105
}
