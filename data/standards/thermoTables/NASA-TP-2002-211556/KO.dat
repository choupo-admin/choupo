/*--------------------------------*- Choupo -*-----------------------*\
  Species KO (NASA/TP-2002-211556 appendix D entry "KO"):
  ideal-gas formation data and heat capacity transcribed by machine with
  bin/curate/nasa_tp2002_to_choupo.py table, which holds H and S at
  298.15 K recomputed from the printed coefficients to the printed
  values.  Not read back against the page by a curator.
  The report's own description and sources: Gurvich,1982 pt1 p375 pt2 p404.
\*---------------------------------------------------------------------------*/
name           KO;
formula        KO;
CAS            n/a;
MW             55.0977;       // kg/kmol, appendix D record line
role           gasOnly;       // free radical (odd electron count 27)
tags           ( gasPhase thermoTable );
nasaEntry      "KO";
reviewStatus   interim;
reviewReason   "transcribed by machine from NASA/TP-2002-211556 into the thermoTables home and checked against the report itself; not yet read back against the page by a curator";
standardThermochemistry
{
    dHf_298    64733.314;   // J/mol  -- ideal gas; NASA/TP-2002-211556 appendix D, p. 141, entry KO
    s_298      241.198;     // J/(mol·K) -- third-law absolute; Table B1, p. 22
}

idealGasHeatCapacity
{
    //  NASA/TP-2002-211556 eq. (1), Cp/R = a1/T^2 + a2/T + a3 + a4 T + a5 T^2
    //  + a6 T^3 + a7 T^4; appendix D, p. 141, entry KO, a1..a7 as printed.
    model    NASA9;
    Tlow     200;
    Tcommon  1000;
    Thigh    6000;
    low      ( 1.462562908e+04 -3.384765650e+02 5.716607640e+00 -2.363265083e-03 2.848716276e-06 -1.739858233e-09 4.431006520e-13 );
    high     ( 6.960103380e+05 -3.304835290e+03 1.005743444e+01 -4.331112000e-03 1.747281632e-06 -3.012370548e-10 1.790827870e-14 );
}

provenance
{
    dHf_298
    {
        origin        literature;
        method        "NASA/TP-2002-211556 appendix D, p. 141, entry KO, record-line H(298.15) (elements reference, so = dHf)";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "Table B1 p. 22 prints 64.733 kJ/mol; the report's own sources: Gurvich,1982 pt1 p375 pt2 p404.";
    }
    s_298
    {
        origin        literature;
        method        "NASA/TP-2002-211556 Table B1, p. 22, entry KO";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "appendix D's coefficients with b2 integrate to 241.198";
    }
    idealGasHeatCapacity
    {
        origin        literature;
        method        "NASA/TP-2002-211556 appendix D, p. 141, entry KO, a1..a7 of the 200-1000 K and 1000-6000 K intervals, as printed";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "read by bin/curate/nasa_tp2002_to_choupo.py, which holds H and S at 298.15 K to the printed values";
    }
    source   "McBride, Zehe & Gordon, NASA Glenn Coefficients for Calculating Thermodynamic Properties of Individual Species, NASA/TP-2002-211556 (2002)";
    licence  publicDomain;    // US government work (NASA), 17 U.S.C. 105
}
