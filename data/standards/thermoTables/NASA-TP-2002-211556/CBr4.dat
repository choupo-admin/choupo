/*--------------------------------*- Choupo -*-----------------------*\
  Species CBr4 (NASA/TP-2002-211556 appendix D entry "CBr4"):
  ideal-gas formation data and heat capacity transcribed by machine with
  bin/curate/nasa_tp2002_to_choupo.py table, which holds H and S at
  298.15 K recomputed from the printed coefficients to the printed
  values.  Not read back against the page by a curator.
  The report's own description and sources: Kudchadker,1975.
\*---------------------------------------------------------------------------*/
name           CBr4;
formula        CBr4;
CAS            n/a;
MW             331.6267;       // kg/kmol, appendix D record line
role           nonvolatile;   // ideal-gas species: no vapour pressure is asked of it
tags           ( gasPhase thermoTable );
nasaEntry      "CBr4";
reviewStatus   interim;
reviewReason   "transcribed by machine from NASA/TP-2002-211556 into the thermoTables home and checked against the report itself; not yet read back against the page by a curator";
standardThermochemistry
{
    dHf_298    79500.000;   // J/mol  -- ideal gas; NASA/TP-2002-211556 appendix D, p. 75, entry CBr4
    s_298      357.954;     // J/(mol·K) -- third-law absolute; Table B1, p. 13
}

idealGasHeatCapacity
{
    //  NASA/TP-2002-211556 eq. (1), Cp/R = a1/T^2 + a2/T + a3 + a4 T + a5 T^2
    //  + a6 T^3 + a7 T^4; appendix D, p. 75, entry CBr4, a1..a7 as printed.
    model    NASA9;
    Tlow     200;
    Tcommon  1000;
    Thigh    6000;
    low      ( 1.023083739e+05 -1.735600709e+03 1.651317914e+01 -3.147664747e-03 2.924135486e-07 1.360605681e-09 -6.431758650e-13 );
    high     ( -2.059785072e+05 -1.048517002e+02 1.307772550e+01 -3.086857556e-05 6.775309810e-09 -7.721837540e-13 3.559218240e-17 );
}

provenance
{
    dHf_298
    {
        origin        literature;
        method        "NASA/TP-2002-211556 appendix D, p. 75, entry CBr4, record-line H(298.15) (elements reference, so = dHf)";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "Table B1 p. 13 prints 79.5 kJ/mol; the report's own sources: Kudchadker,1975.";
    }
    s_298
    {
        origin        literature;
        method        "NASA/TP-2002-211556 Table B1, p. 13, entry CBr4";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "appendix D's coefficients with b2 integrate to 357.954";
    }
    idealGasHeatCapacity
    {
        origin        literature;
        method        "NASA/TP-2002-211556 appendix D, p. 75, entry CBr4, a1..a7 of the 200-1000 K and 1000-6000 K intervals, as printed";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "read by bin/curate/nasa_tp2002_to_choupo.py, which holds H and S at 298.15 K to the printed values";
    }
    source   "McBride, Zehe & Gordon, NASA Glenn Coefficients for Calculating Thermodynamic Properties of Individual Species, NASA/TP-2002-211556 (2002)";
    licence  publicDomain;    // US government work (NASA), 17 U.S.C. 105
}
