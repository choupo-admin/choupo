/*--------------------------------*- Choupo -*-----------------------*\
  Species CaOH (NASA/TP-2002-211556 appendix D entry "CaOH"):
  ideal-gas formation data and heat capacity transcribed by machine with
  bin/curate/nasa_tp2002_to_choupo.py table, which holds H and S at
  298.15 K recomputed from the printed coefficients to the printed
  values.  Not read back against the page by a curator.
  The report's own description and sources: Gurvich,1996a pt1 p451 pt2 p355.
\*---------------------------------------------------------------------------*/
name           CaOH;
formula        CaOH;
CAS            n/a;
MW             57.08534;       // kg/kmol, appendix D record line
role           gasOnly;       // free radical (odd electron count 29)
tags           ( gasPhase thermoTable );
nasaEntry      "CaOH";
reviewStatus   interim;
reviewReason   "transcribed by machine from NASA/TP-2002-211556 into the thermoTables home and checked against the report itself; not yet read back against the page by a curator";
standardThermochemistry
{
    dHf_298    -173307.350;   // J/mol  -- ideal gas; NASA/TP-2002-211556 appendix D, p. 105, entry CaOH
    s_298      238.853;     // J/(mol·K) -- third-law absolute; Table B1, p. 17
}

idealGasHeatCapacity
{
    //  NASA/TP-2002-211556 eq. (1), Cp/R = a1/T^2 + a2/T + a3 + a4 T + a5 T^2
    //  + a6 T^3 + a7 T^4; appendix D, p. 105, entry CaOH, a1..a7 as printed.
    model    NASA9;
    Tlow     200;
    Tcommon  1000;
    Thigh    6000;
    low      ( 4.620028900e+04 -9.285672820e+02 9.175828770e+00 -3.962828800e-03 2.505447308e-06 3.852068210e-11 -3.352778470e-13 );
    high     ( 1.979972994e+06 -5.598880990e+03 1.151348706e+01 -1.668264707e-03 3.312573910e-07 -1.789056647e-11 -3.580716410e-16 );
}

provenance
{
    dHf_298
    {
        origin        literature;
        method        "NASA/TP-2002-211556 appendix D, p. 105, entry CaOH, record-line H(298.15) (elements reference, so = dHf)";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "Table B1 p. 17 prints -173.307 kJ/mol; the report's own sources: Gurvich,1996a pt1 p451 pt2 p355.";
    }
    s_298
    {
        origin        literature;
        method        "NASA/TP-2002-211556 Table B1, p. 17, entry CaOH";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "appendix D's coefficients with b2 integrate to 238.853";
    }
    idealGasHeatCapacity
    {
        origin        literature;
        method        "NASA/TP-2002-211556 appendix D, p. 105, entry CaOH, a1..a7 of the 200-1000 K and 1000-6000 K intervals, as printed";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "read by bin/curate/nasa_tp2002_to_choupo.py, which holds H and S at 298.15 K to the printed values";
    }
    source   "McBride, Zehe & Gordon, NASA Glenn Coefficients for Calculating Thermodynamic Properties of Individual Species, NASA/TP-2002-211556 (2002)";
    licence  publicDomain;    // US government work (NASA), 17 U.S.C. 105
}
