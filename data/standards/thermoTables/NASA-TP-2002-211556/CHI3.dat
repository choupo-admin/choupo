/*--------------------------------*- Choupo -*-----------------------*\
  Species CHI3 (NASA/TP-2002-211556 appendix D entry "CHI3"):
  ideal-gas formation data and heat capacity transcribed by machine with
  bin/curate/nasa_tp2002_to_choupo.py table, which holds H and S at
  298.15 K recomputed from the printed coefficients to the printed
  values.  Not read back against the page by a curator.
  The report's own description and sources: Kudchadker,1975.
\*---------------------------------------------------------------------------*/
name           CHI3;
formula        CHI3;
CAS            n/a;
MW             393.7321;       // kg/kmol, appendix D record line
role           radical;       // gas-only (DEV.md 4c C458): stays in the vapour, refused where no vapour holds it
tags           ( gasPhase thermoTable );
nasaEntry      "CHI3";
reviewStatus   interim;
reviewReason   "transcribed by machine from NASA/TP-2002-211556 into the thermoTables home and checked against the report itself; not yet read back against the page by a curator";
standardThermochemistry
{
    dHf_298    210873.600;   // J/mol  -- ideal gas; NASA/TP-2002-211556 appendix D, p. 80, entry CHI3
    s_298      355.622;     // J/(mol·K) -- third-law absolute; Table B1, p. 14
}

idealGasHeatCapacity
{
    //  NASA/TP-2002-211556 eq. (1), Cp/R = a1/T^2 + a2/T + a3 + a4 T + a5 T^2
    //  + a6 T^3 + a7 T^4; appendix D, p. 80, entry CHI3, a1..a7 as printed.
    model    NASA9;
    Tlow     200;
    Tcommon  1000;
    Thigh    6000;
    low      ( 5.252923590e+04 -7.242166470e+02 8.018623340e+00 1.470995487e-02 -2.163843469e-05 1.594571452e-08 -4.601437960e-12 );
    high     ( 6.294205430e+05 -3.184061570e+03 1.479622178e+01 -5.749555500e-04 1.062025541e-07 -1.052804696e-11 4.329720020e-16 );
}

provenance
{
    dHf_298
    {
        origin        literature;
        method        "NASA/TP-2002-211556 appendix D, p. 80, entry CHI3, record-line H(298.15) (elements reference, so = dHf)";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "Table B1 p. 14 prints 210.874 kJ/mol; the report's own sources: Kudchadker,1975.";
    }
    s_298
    {
        origin        literature;
        method        "NASA/TP-2002-211556 Table B1, p. 14, entry CHI3";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "appendix D's coefficients with b2 integrate to 355.622";
    }
    idealGasHeatCapacity
    {
        origin        literature;
        method        "NASA/TP-2002-211556 appendix D, p. 80, entry CHI3, a1..a7 of the 200-1000 K and 1000-6000 K intervals, as printed";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "read by bin/curate/nasa_tp2002_to_choupo.py, which holds H and S at 298.15 K to the printed values";
    }
    source   "McBride, Zehe & Gordon, NASA Glenn Coefficients for Calculating Thermodynamic Properties of Individual Species, NASA/TP-2002-211556 (2002)";
    licence  publicDomain;    // US government work (NASA), 17 U.S.C. 105
}
