/*--------------------------------*- Choupo -*-----------------------*\
  Species C5H11_tpentyl (NASA/TP-2002-211556 appendix D entry "C5H11,t-pentyl"):
  ideal-gas formation data and heat capacity transcribed by machine with
  bin/curate/nasa_tp2002_to_choupo.py table, which holds H and S at
  298.15 K recomputed from the printed coefficients to the printed
  values.  Not read back against the page by a curator.
  The report's own description and sources: 1,1-dimethylpropyl radical. Tsang,1985.
\*---------------------------------------------------------------------------*/
name           C5H11_tpentyl;
formula        C5H11;
CAS            n/a;
MW             71.14084;       // kg/kmol, appendix D record line
role           radical;       // gas-only (DEV.md 4c C458): stays in the vapour, refused where no vapour holds it
tags           ( gasPhase thermoTable );
nasaEntry      "C5H11,t-pentyl";
reviewStatus   interim;
reviewReason   "transcribed by machine from NASA/TP-2002-211556 into the thermoTables home and checked against the report itself; not yet read back against the page by a curator";
standardThermochemistry
{
    dHf_298    32600.000;   // J/mol  -- ideal gas; NASA/TP-2002-211556 appendix D, p. 99, entry C5H11,t-pentyl
    s_298      366.476;     // J/(mol·K) -- third-law absolute; Table B1, p. 17
}

idealGasHeatCapacity
{
    //  NASA/TP-2002-211556 eq. (1), Cp/R = a1/T^2 + a2/T + a3 + a4 T + a5 T^2
    //  + a6 T^3 + a7 T^4; appendix D, p. 99, entry C5H11,t-pentyl, a1..a7 as printed.
    model    NASA9;
    Tlow     200;
    Tcommon  1000;
    Thigh    6000;
    low      ( -5.152181980e+05 9.144327830e+03 -5.602397890e+01 1.998204194e-01 -2.239112591e-04 1.375455547e-07 -3.523833050e-11 );
    high     ( 8.602108260e+06 -3.805205770e+04 6.649690370e+01 -7.533860630e-03 1.451612787e-06 -1.495593207e-10 6.368022330e-15 );
}

provenance
{
    dHf_298
    {
        origin        literature;
        method        "NASA/TP-2002-211556 appendix D, p. 99, entry C5H11,t-pentyl, record-line H(298.15) (elements reference, so = dHf)";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "Table B1 p. 17 prints 32.6 kJ/mol; the report's own sources: 1,1-dimethylpropyl radical. Tsang,1985.";
    }
    s_298
    {
        origin        literature;
        method        "NASA/TP-2002-211556 Table B1, p. 17, entry C5H11,t-pentyl";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "appendix D's coefficients with b2 integrate to 366.476";
    }
    idealGasHeatCapacity
    {
        origin        literature;
        method        "NASA/TP-2002-211556 appendix D, p. 99, entry C5H11,t-pentyl, a1..a7 of the 200-1000 K and 1000-6000 K intervals, as printed";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "read by bin/curate/nasa_tp2002_to_choupo.py, which holds H and S at 298.15 K to the printed values";
    }
    source   "McBride, Zehe & Gordon, NASA Glenn Coefficients for Calculating Thermodynamic Properties of Individual Species, NASA/TP-2002-211556 (2002)";
    licence  publicDomain;    // US government work (NASA), 17 U.S.C. 105
}
