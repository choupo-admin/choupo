/*--------------------------------*- Choupo -*-----------------------*\
  Species SnBr (NASA/TP-2002-211556 appendix D entry "SnBr"):
  ideal-gas formation data and heat capacity transcribed by machine with
  bin/curate/nasa_tp2002_to_choupo.py table, which holds H and S at
  298.15 K recomputed from the printed coefficients to the printed
  values.  Not read back against the page by a curator.
  The report's own description and sources: Gurvich,1991 pt1 p378 pt2 p321.
\*---------------------------------------------------------------------------*/
name           SnBr;
formula        SnBr;
CAS            n/a;
MW             198.614;       // kg/kmol, appendix D record line
role           gasOnly;       // free radical (odd electron count 85)
tags           ( gasPhase thermoTable );
nasaEntry      "SnBr";
reviewStatus   interim;
reviewReason   "transcribed by machine from NASA/TP-2002-211556 into the thermoTables home and checked against the report itself; not yet read back against the page by a curator";
standardThermochemistry
{
    dHf_298    75644.020;   // J/mol  -- ideal gas; NASA/TP-2002-211556 appendix D, p. 193, entry SnBr
    s_298      264.831;     // J/(mol·K) -- third-law absolute; Table B1, p. 30
}

idealGasHeatCapacity
{
    //  NASA/TP-2002-211556 eq. (1), Cp/R = a1/T^2 + a2/T + a3 + a4 T + a5 T^2
    //  + a6 T^3 + a7 T^4; appendix D, p. 193, entry SnBr, a1..a7 as printed.
    model    NASA9;
    Tlow     200;
    Tcommon  1000;
    Thigh    6000;
    low      ( 2.564193542e+04 -5.259122330e+02 7.687410690e+00 -9.654205420e-03 1.482863248e-05 -9.942236980e-09 2.475051091e-12 );
    high     ( 1.815578541e+06 -6.728264580e+03 1.332464516e+01 -4.608102300e-03 1.236439537e-06 -1.528863587e-10 6.971513500e-15 );
}

provenance
{
    dHf_298
    {
        origin        literature;
        method        "NASA/TP-2002-211556 appendix D, p. 193, entry SnBr, record-line H(298.15) (elements reference, so = dHf)";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "Table B1 p. 30 prints 75.644 kJ/mol; the report's own sources: Gurvich,1991 pt1 p378 pt2 p321.";
    }
    s_298
    {
        origin        literature;
        method        "NASA/TP-2002-211556 Table B1, p. 30, entry SnBr";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "appendix D's coefficients with b2 integrate to 264.831";
    }
    idealGasHeatCapacity
    {
        origin        literature;
        method        "NASA/TP-2002-211556 appendix D, p. 193, entry SnBr, a1..a7 of the 200-1000 K and 1000-6000 K intervals, as printed";
        methodVersion "NASA/TP-2002-211556";
        uncertainty   "not quantified by source";
        notes         "read by bin/curate/nasa_tp2002_to_choupo.py, which holds H and S at 298.15 K to the printed values";
    }
    source   "McBride, Zehe & Gordon, NASA Glenn Coefficients for Calculating Thermodynamic Properties of Individual Species, NASA/TP-2002-211556 (2002)";
    licence  publicDomain;    // US government work (NASA), 17 U.S.C. 105
}
