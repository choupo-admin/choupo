            { quantity "vibrational wavenumber 8 (exp gas)"; value 977; unit cm-1; doi "10.18434/T47C7Z"; }
            { quantity "vibrational wavenumber 9 (exp gas)"; value 433; unit cm-1; doi "10.18434/T47C7Z"; }
