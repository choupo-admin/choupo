            { quantity "vibrational wavenumber 8 (exp gas)"; value 977; unit cm-1; doi "10.18434/T47C7Z"; }
            { quantity "vibrational wavenumber 9 (exp gas)"; value 433; unit cm-1; doi "10.18434/T47C7Z"; }
            { quantity "rotational constant A (exp)"; value 9.37; unit cm-1; doi "10.18434/T47C7Z"; }
            { quantity "rotational constant B (exp)"; value 0.34335; unit cm-1; doi "10.18434/T47C7Z"; }
            { quantity "rotational constant C (exp)"; value 0.33076; unit cm-1; doi "10.18434/T47C7Z"; }
            { quantity "rotational symmetry number (point group of the cited structure)"; value 2; unit 1; doi "10.18434/T47C7Z"; }
            { quantity "electronic level 1 energy (cited state table)"; value 0; unit cm-1; doi "10.18434/T47C7Z"; }
            { quantity "electronic level 1 degeneracy (cited state table)"; value 1; unit 1; doi "10.18434/T47C7Z"; }
        );
        uncertainty   "+-0.3 J/(mol K) (propagated from the stated uncertainty of each frequency, 1.5 % on the rotational constants)";
        notes         "constants: NIST CCCBDB release 22 (cccbdb.nist.gov, SRD 101), fetched 2026-11-22 experimental page: rotational constants A,B,C and the nine fundamentals from Herzberg, Electronic Spectra and Electronic Structure of Polyatomic Molecules (1966) as listed there; ground state 1A1 (first excited level 25975 cm-1 neglected)";
    }
    idealGasHeatCapacity
    {
