/*--------------------------------*- Choupo -*-----------------------*\
  Species CH2CO (ketene H2C=C=O, X 1A1): ideal-gas thermochemistry COMPUTED from molecular
  constants by bin/curate/rrho_thermo.py (rigid rotor, harmonic
  oscillator, electronic levels) from the inputs of bin/curate/rrho_species.json,
  anchored to a cited enthalpy of formation.  NOT a transcription of a
  published table: the NASA/TP-2002-211556 report holds no entry for it.
  Re-run `bin/curate/rrho_thermo.py write`; the gate check_rrho_thermo holds this
  file equal to the tool's output.
\*---------------------------------------------------------------------------*/
name           CH2CO;
formula        CH2CO;
CAS            463-51-4;
MW             42.03668;       // kg/kmol, standard atomic weights
role           gasData;       // closed-shell molecule: ideal-gas data only, no liquid model
tags           ( gasPhase thermoTable rrhoComputed );
reviewStatus   interim;
reviewReason   "computed by bin/curate/rrho_thermo.py from molecular constants (inputs and sources in bin/curate/rrho_species.json); not read back against the cited papers by a curator"; 
standardThermochemistry
{
    dHf_298    -48600.000;   // J/mol  -- ideal gas; ATcT, Klippenstein, Harding & Ruscic, J. Phys. Chem. A 121 (2017) 6580, Table 1 (0 K), derived to 298.15 K, +-0.22 kJ/mol
    s_298      241.963;     // J/(mol K) -- RRHO at 298.15 K, P0 = 1 bar (rrho_thermo.py)
}

idealGasHeatCapacity
{
    //  Cp/R = a1/T^2 + a2/T + a3 + a4 T + a5 T^2 + a6 T^3 + a7 T^4 (NASA9 form, as the
    //  NASA/TP-2002-211556 records), LEAST-SQUARES FIT to the RRHO Cp(T) curve of
    //  rrho_thermo.py on 200-1000 K (10 K) and 1000-6000 K (50 K).
    //  Worst relative Cp error of the fit: 1.51e-04 at 1000 K (low), 2.91e-05 at 1000 K (high).
    model    NASA9;
    Tlow     200;
    Tcommon  1000;
    Thigh    6000;
    low      ( 2.193921785e+04 -2.147319023e+02 2.686341088e+00 1.866509275e-02 -2.142531698e-05 1.469256332e-08 -4.239057288e-12 );
    high     ( 2.035496550e+06 -8.248592083e+03 1.763605422e+01 -1.482132892e-03 2.739271518e-07 -2.720476123e-11 1.121834553e-15 );
}

provenance
{
    dHf_298
    {
        origin        derived;
        method        "Active Thermochemical Tables enthalpy of formation at 0 K as printed in the cited journal paper, converted to 298.15 K, ideal gas";
        methodVersion "Klippenstein, Harding & Ruscic, J. Phys. Chem. A 121 (2017) 6580-6602, doi:10.1021/acs.jpca.7b05945, Table 1 (ATcT TN ver. 1.122b)";
        inputs
        (
            { quantity "Delta_f H at 0 K (ATcT, paper label CH2CO, Table 1; +-0.1 kJ/mol)"; value -45.5; unit kJ/mol; doi "10.1021/acs.jpca.7b05945"; }
        );
        uncertainty   "+-0.22 kJ/mol (paper's 95% confidence at 0 K, 0.1, with 0.2 for the 0 K to 298.15 K conversion, in quadrature)";
        notes         "Value read in Table 1 of Klippenstein, Harding & Ruscic, J. Phys. Chem. A 121 (2017) 6580-6602, doi:10.1021/acs.jpca.7b05945, Table 1 (ATcT thermochemical network ver. 1.122b, Delta_f H at 0 K, 95 percent uncertainty, one decimal), manuscript PDF page 32 of the accepted manuscript at OSTI 1389058 (the journal's table number is the citation; the manuscript's pagination is not the journal's): Delta_f H(0 K) = -45.5 +-0.1 kJ/mol (paper label CH2CO); the 298.15 K value is DERIVED from that 0 K value as Delta_f H(298.15) = Delta_f H(0) + [H(298.15)-H(0)] of the species (rrho_thermo.py, the same constants as this record's S and Cp) - sum of [H(298.15)-H(0)] of the elements in their standard states (CODATA Key Values for Thermodynamics: C graphite 1.050, H2 8.468, N2 8.670, O2 8.680 kJ/mol), net increment -3.099 kJ/mol; the same conversion reproduces the paper's own pair for singlet CH2 (+0.422 against the printed +0.412 kJ/mol). The value held before 2026-11-23 was -48.42 (website version, withdrawn as a source); the difference is 0.18 kJ/mol.";
    }
    s_298
    {
        origin        derived;
        method        "RRHO from molecular constants via bin/curate/rrho_thermo.py with the inputs of bin/curate/rrho_species.json (Sackur-Tetrode translation, rigid rotor, harmonic oscillator, electronic levels), 1 bar";
        methodVersion "rrho_thermo.py rrho_species.json";
        inputs
