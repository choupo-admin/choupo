/*--------------------------------*- Choupo -*-----------------------*\
  Species CH2CO (ketene H2C=C=O, X 1A1): ideal-gas thermochemistry COMPUTED from molecular
  constants by bin/curate/rrho_thermo.py (rigid rotor, harmonic
  oscillator, electronic levels) from the inputs of bin/curate/rrho_species.json,
  anchored to a cited enthalpy of formation.  NOT a transcription of a
  published table: the NASA/TP-2002-211556 report holds no entry for it.
  Re-run `bin/curate/rrho_thermo.py write`; the gate check_rrho_thermo holds this
  file equal to the tool's output.
\*---------------------------------------------------------------------------*/
name           CH2CO;
formula        CH2CO;
CAS            463-51-4;
MW             42.03668;       // kg/kmol, standard atomic weights
role           gasData;       // closed-shell molecule: ideal-gas data only, no liquid model
tags           ( gasPhase thermoTable rrhoComputed );
reviewStatus   interim;
reviewReason   "computed by bin/curate/rrho_thermo.py from molecular constants (inputs and sources in bin/curate/rrho_species.json); not read back against the cited papers by a curator"; 
standardThermochemistry
{
    dHf_298    -48420.000;   // J/mol  -- ideal gas; ATcT 1.124 (Ruscic et al.), 298.15 K, ideal gas, +-0.11 kJ/mol
    s_298      241.963;     // J/(mol K) -- RRHO at 298.15 K, P0 = 1 bar (rrho_thermo.py)
}

idealGasHeatCapacity
{
    //  Cp/R = a1/T^2 + a2/T + a3 + a4 T + a5 T^2 + a6 T^3 + a7 T^4 (NASA9 form, as the
    //  NASA/TP-2002-211556 records), LEAST-SQUARES FIT to the RRHO Cp(T) curve of
    //  rrho_thermo.py on 200-1000 K (10 K) and 1000-6000 K (50 K).
    //  Worst relative Cp error of the fit: 1.51e-04 at 1000 K (low), 2.91e-05 at 1000 K (high).
    model    NASA9;
    Tlow     200;
    Tcommon  1000;
    Thigh    6000;
    low      ( 2.193921785e+04 -2.147319023e+02 2.686341088e+00 1.866509275e-02 -2.142531698e-05 1.469256332e-08 -4.239057288e-12 );
    high     ( 2.035496550e+06 -8.248592083e+03 1.763605422e+01 -1.482132892e-03 2.739271518e-07 -2.720476123e-11 1.121834553e-15 );
}

