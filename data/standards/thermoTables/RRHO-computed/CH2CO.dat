            { quantity "vibrational wavenumber 2 (exp gas)"; value 2152; unit cm-1; doi "10.18434/T47C7Z"; }
            { quantity "vibrational wavenumber 3 (exp gas)"; value 1388; unit cm-1; doi "10.18434/T47C7Z"; }
            { quantity "vibrational wavenumber 4 (exp gas)"; value 1118; unit cm-1; doi "10.18434/T47C7Z"; }
            { quantity "vibrational wavenumber 5 (exp gas)"; value 588; unit cm-1; doi "10.18434/T47C7Z"; }
            { quantity "vibrational wavenumber 6 (exp gas)"; value 528; unit cm-1; doi "10.18434/T47C7Z"; }
