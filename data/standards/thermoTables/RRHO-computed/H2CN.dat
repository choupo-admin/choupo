/*--------------------------------*- Choupo -*-----------------------*\
  Species H2CN (methyleneamidogen radical H2CN, X 2B2 (planar C2v)): ideal-gas thermochemistry COMPUTED from molecular
  constants by bin/curate/rrho_thermo.py (rigid rotor, harmonic
  oscillator, electronic levels) from the inputs of bin/curate/rrho_species.json,
  anchored to a cited enthalpy of formation.  NOT a transcription of a
  published table: the NASA/TP-2002-211556 report holds no entry for it.
  Re-run `bin/curate/rrho_thermo.py write`; the gate check_rrho_thermo holds this
  file equal to the tool's output.
\*---------------------------------------------------------------------------*/
name           H2CN;
formula        H2CN;
CAS            15845-29-1;
MW             28.03328;       // kg/kmol, standard atomic weights
role           gasOnly;       // free radical (odd electron count)
tags           ( gasPhase thermoTable rrhoComputed );
reviewStatus   interim;
reviewReason   "computed by bin/curate/rrho_thermo.py from molecular constants (inputs and sources in bin/curate/rrho_species.json); not read back against the cited papers by a curator"; 
standardThermochemistry
{
    dHf_298    238540.000;   // J/mol  -- ideal gas; ATcT, Klippenstein, Harding & Ruscic, J. Phys. Chem. A 121 (2017) 6580, Table 1 (0 K), derived to 298.15 K, +-0.82 kJ/mol
    s_298      224.130;     // J/(mol K) -- RRHO at 298.15 K, P0 = 1 bar (rrho_thermo.py)
}

idealGasHeatCapacity
{
    //  Cp/R = a1/T^2 + a2/T + a3 + a4 T + a5 T^2 + a6 T^3 + a7 T^4 (NASA9 form, as the
    //  NASA/TP-2002-211556 records), LEAST-SQUARES FIT to the RRHO Cp(T) curve of
    //  rrho_thermo.py on 200-1000 K (10 K) and 1000-6000 K (50 K).
    //  Worst relative Cp error of the fit: 1.98e-04 at 1000 K (low), 2.97e-05 at 6000 K (high).
    model    NASA9;
    Tlow     200;
    Tcommon  1000;
    Thigh    6000;
    low      ( -4.902152378e+04 1.066100470e+03 -4.350009577e+00 2.715202688e-02 -3.036036772e-05 1.937199133e-08 -5.223854942e-12 );
    high     ( 1.729908342e+06 -7.133276887e+03 1.414413445e+01 -1.366988991e-03 2.600608378e-07 -2.651512132e-11 1.119483380e-15 );
}

provenance
{
    dHf_298
    {
        origin        derived;
        method        "Active Thermochemical Tables enthalpy of formation at 0 K as printed in the cited journal paper, converted to 298.15 K, ideal gas";
        methodVersion "Klippenstein, Harding & Ruscic, J. Phys. Chem. A 121 (2017) 6580-6602, doi:10.1021/acs.jpca.7b05945, Table 1 (ATcT TN ver. 1.122b)";
        inputs
        (
            { quantity "Delta_f H at 0 K (ATcT, paper label CH2N, Table 1; +-0.8 kJ/mol)"; value 242.2; unit kJ/mol; doi "10.1021/acs.jpca.7b05945"; }
        );
        uncertainty   "+-0.82 kJ/mol (paper's 95% confidence at 0 K, 0.8, with 0.2 for the 0 K to 298.15 K conversion, in quadrature)";
        notes         "Value read in Table 1 of Klippenstein, Harding & Ruscic, J. Phys. Chem. A 121 (2017) 6580-6602, doi:10.1021/acs.jpca.7b05945, Table 1 (ATcT thermochemical network ver. 1.122b, Delta_f H at 0 K, 95 percent uncertainty, one decimal), manuscript PDF page 33 of the accepted manuscript at OSTI 1389058 (the journal's table number is the citation; the manuscript's pagination is not the journal's): Delta_f H(0 K) = 242.2 +-0.8 kJ/mol (paper label CH2N); the 298.15 K value is DERIVED from that 0 K value as Delta_f H(298.15) = Delta_f H(0) + [H(298.15)-H(0)] of the species (rrho_thermo.py, the same constants as this record's S and Cp) - sum of [H(298.15)-H(0)] of the elements in their standard states (CODATA Key Values for Thermodynamics: C graphite 1.050, H2 8.468, N2 8.670, O2 8.680 kJ/mol), net increment -3.656 kJ/mol; the same conversion reproduces the paper's own pair for singlet CH2 (+0.422 against the printed +0.412 kJ/mol). The value held before 2026-11-23 was 238.44 (website version, withdrawn as a source); the difference is 0.10 kJ/mol. Miller & Bowman 1989, Table 1 (p. 289) lists 59.08 kcal/mol = 247.19 kJ/mol (+8.65 kJ/mol from the paper's value); the ATcT value of the paper is used because the other table species (HNCO, NCO, NH2, ...) are on the same modern base and the isomer energetics (HOCN/HNCO, HCNO) stay consistent; the paper's value is kept here so Phase B can choose.";
    }
    s_298
    {
        origin        derived;
        method        "RRHO from molecular constants via bin/curate/rrho_thermo.py with the inputs of bin/curate/rrho_species.json (Sackur-Tetrode translation, rigid rotor, harmonic oscillator, electronic levels), 1 bar";
        methodVersion "rrho_thermo.py rrho_species.json";
        inputs
        (
            { quantity "vibrational wavenumber 1 (exp gas (T, photoelectron))"; value 2820; unit cm-1; doi "10.18434/T4D303"; }
            { quantity "vibrational wavenumber 2 (exp matrix (Ar))"; value 1725.4; unit cm-1; doi "10.18434/T4D303"; }
            { quantity "vibrational wavenumber 3 (exp gas (T, photoelectron))"; value 1337; unit cm-1; doi "10.18434/T4D303"; }
            { quantity "vibrational wavenumber 4 (exp matrix (Ar))"; value 954.1; unit cm-1; doi "10.18434/T4D303"; }
            { quantity "vibrational wavenumber 5 (exp matrix (Ar))"; value 3103.2; unit cm-1; doi "10.18434/T4D303"; }
            { quantity "vibrational wavenumber 6 (exp matrix (Ar))"; value 912.8; unit cm-1; doi "10.18434/T4D303"; }
            { quantity "rotational constant A (calc)"; value 9.6219; unit cm-1; doi "10.1063/5.0006074"; }
            { quantity "rotational constant B (calc)"; value 1.3212; unit cm-1; doi "10.1063/5.0006074"; }
            { quantity "rotational constant C (calc)"; value 1.1617; unit cm-1; doi "10.1063/5.0006074"; }
            { quantity "rotational symmetry number (point group of the cited structure)"; value 2; unit 1; doi "10.18434/T4D303"; }
            { quantity "electronic level 1 energy (cited state table)"; value 0; unit cm-1; doi "10.18434/T4D303"; }
            { quantity "electronic level 1 degeneracy (cited state table)"; value 2; unit 1; doi "10.18434/T4D303"; }
        );
        uncertainty   "+-0.2 J/(mol K) (propagated from the stated uncertainty of each frequency, 1.5 % on the rotational constants)";
        notes         "constants: NIST Chemistry WebBook (webbook.nist.gov, SRD 69; vibrational/electronic energy levels compiled by M. E. Jacox), fetched 2026-11-22: X state fundamentals nu1 2820 (T, gas photoelectron, Cowles et al. 1991), nu2 1725.4 and nu4 954.1, nu5 3103.2, nu6 912.8 (Ar matrix IR, Jacox 1987), nu3 1337 (T, gas PE); rotational constants CALCULATED (B3LYP/def2-TZVP (density fitted, DFT grid level 3) equilibrium geometry and harmonic frequencies (PySCF 2.15, bin/curate/rrho_abinitio_constants.py, UKS for open shells), frequencies x 0.964 (single factor fitted on 23 measured fundamentals of six molecules (the scale_calibration block of rrho_species.json), rms 21 cm-1 / 1.7 %), rotational constants as computed (equilibrium, not B0; ~1-2 % effect)). The two CH stretches (2820, 3103) differ more than the B3LYP harmonic pair (2963, 3016); the effect on Cp(1500 K) is below 0.5 %";
    }
    idealGasHeatCapacity
    {
        origin        derived;
        method        "RRHO from molecular constants via bin/curate/rrho_thermo.py with the inputs of bin/curate/rrho_species.json, then a 7-term NASA9 least-squares fit (200-1000 K and 1000-6000 K)";
        methodVersion "rrho_thermo.py rrho_species.json";
        inputs
        (
            { quantity "vibrational wavenumber 1 (exp gas (T, photoelectron))"; value 2820; unit cm-1; doi "10.18434/T4D303"; }
            { quantity "vibrational wavenumber 2 (exp matrix (Ar))"; value 1725.4; unit cm-1; doi "10.18434/T4D303"; }
            { quantity "vibrational wavenumber 3 (exp gas (T, photoelectron))"; value 1337; unit cm-1; doi "10.18434/T4D303"; }
            { quantity "vibrational wavenumber 4 (exp matrix (Ar))"; value 954.1; unit cm-1; doi "10.18434/T4D303"; }
            { quantity "vibrational wavenumber 5 (exp matrix (Ar))"; value 3103.2; unit cm-1; doi "10.18434/T4D303"; }
            { quantity "vibrational wavenumber 6 (exp matrix (Ar))"; value 912.8; unit cm-1; doi "10.18434/T4D303"; }
            { quantity "rotational constant A (calc)"; value 9.6219; unit cm-1; doi "10.1063/5.0006074"; }
            { quantity "rotational constant B (calc)"; value 1.3212; unit cm-1; doi "10.1063/5.0006074"; }
            { quantity "rotational constant C (calc)"; value 1.1617; unit cm-1; doi "10.1063/5.0006074"; }
            { quantity "rotational symmetry number (point group of the cited structure)"; value 2; unit 1; doi "10.18434/T4D303"; }
            { quantity "electronic level 1 energy (cited state table)"; value 0; unit cm-1; doi "10.18434/T4D303"; }
            { quantity "electronic level 1 degeneracy (cited state table)"; value 2; unit 1; doi "10.18434/T4D303"; }
        );
        uncertainty   "+-0.20 J/(mol K) at 298 K, +-0.21 at 1000 K from the same propagation; above ~1500 K the harmonic model under-counts (anharmonicity, validated deficit up to -3 % at 1500 K and -7 % at 3000 K)";
        notes         "Cp(298.15) = 37.768, Cp(1500) = 71.573 J/(mol K) from the RRHO curve; fit error 2.0e-04 (<1000 K) and 3.0e-05 (>=1000 K), relative. Approximations: rigid rotor, harmonic oscillator; two measured stretches are tentative; X 2B2 only";
    }
    source   "Choupo RRHO computation (bin/curate/rrho_thermo.py) from the molecular constants and enthalpy of formation cited in the record's provenance";
    licence  publicDomain;    // inputs: NIST (US government) data and published spectroscopy; the computation is Choupo's own
}
