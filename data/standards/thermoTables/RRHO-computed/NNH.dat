/*--------------------------------*- Choupo -*-----------------------*\
  Species NNH (diazenyl radical N2H (HNN), X 2A'): ideal-gas thermochemistry COMPUTED from molecular
  constants by bin/curate/rrho_thermo.py (rigid rotor, harmonic
  oscillator, electronic levels) from the inputs of bin/curate/rrho_species.json,
  anchored to a cited enthalpy of formation.  NOT a transcription of a
  published table: the NASA/TP-2002-211556 report holds no entry for it.
  Re-run `bin/curate/rrho_thermo.py write`; the gate check_rrho_thermo holds this
  file equal to the tool's output.
\*---------------------------------------------------------------------------*/
name           NNH;
formula        NNH;
CAS            36882-13-0;
MW             29.02134;       // kg/kmol, standard atomic weights
role           gasOnly;       // free radical (odd electron count)
tags           ( gasPhase thermoTable rrhoComputed );
reviewStatus   interim;
reviewReason   "computed by bin/curate/rrho_thermo.py from molecular constants (inputs and sources in bin/curate/rrho_species.json); not read back against the cited papers by a curator"; 
standardThermochemistry
{
    dHf_298    249230.000;   // J/mol  -- ideal gas; ATcT 1.124 (Ruscic et al.), 298.15 K, ideal gas, +-0.45 kJ/mol
    s_298      224.276;     // J/(mol K) -- RRHO at 298.15 K, P0 = 1 bar (rrho_thermo.py)
}

idealGasHeatCapacity
{
    //  Cp/R = a1/T^2 + a2/T + a3 + a4 T + a5 T^2 + a6 T^3 + a7 T^4 (NASA9 form, as the
    //  NASA/TP-2002-211556 records), LEAST-SQUARES FIT to the RRHO Cp(T) curve of
    //  rrho_thermo.py on 200-1000 K (10 K) and 1000-6000 K (50 K).
    //  Worst relative Cp error of the fit: 1.01e-05 at 1000 K (low), 5.91e-05 at 1000 K (high).
    model    NASA9;
    Tlow     200;
    Tcommon  1000;
    Thigh    6000;
    low      ( -1.858492235e+04 3.393339386e+02 1.842470226e+00 4.856001862e-03 -1.558291168e-07 -1.837134622e-09 7.136144589e-13 );
    high     ( 8.261356947e+05 -3.817406962e+03 9.448303668e+00 -8.783017337e-04 1.792654374e-07 -1.938022298e-11 8.591452303e-16 );
}

provenance
{
    dHf_298
    {
        origin        literature;
        method        "Active Thermochemical Tables, selected enthalpy of formation, 298.15 K, ideal gas";
        methodVersion "ATcT 1.124 (atct.anl.gov, fetched 2026-11-22)";
        uncertainty   "+-0.45 kJ/mol (ATcT, 95% confidence)";
        notes         "ATcT 1.124 standard enthalpy of formation at 298.15 K, ideal gas, 1 bar. Miller & Bowman 1989, Table 1 (p. 289) lists 58.5 kcal/mol = 244.76 kJ/mol (-4.47 kJ/mol from ATcT); the ATcT value is used because the other table species (HNCO, NCO, NH2, ...) are on the same modern base and the isomer energetics (HOCN/HNCO, HCNO) stay consistent; the paper's value is kept here so Phase B can choose.";
    }
    s_298
    {
        origin        derived;
        method        "RRHO from molecular constants via bin/curate/rrho_thermo.py with the inputs of bin/curate/rrho_species.json (Sackur-Tetrode translation, rigid rotor, harmonic oscillator, electronic levels), 1 bar";
        methodVersion "rrho_thermo.py rrho_species.json";
        inputs
        (
            { quantity "vibrational wavenumber 1 (calc)"; value 1079.9; unit cm-1; doi "10.1063/5.0006074"; }
            { quantity "vibrational wavenumber 2 (calc)"; value 1811.9; unit cm-1; doi "10.1063/5.0006074"; }
            { quantity "vibrational wavenumber 3 (calc)"; value 2654.8; unit cm-1; doi "10.1063/5.0006074"; }
            { quantity "rotational constant A (calc)"; value 22.4649; unit cm-1; doi "10.1063/5.0006074"; }
            { quantity "rotational constant B (calc)"; value 1.568; unit cm-1; doi "10.1063/5.0006074"; }
            { quantity "rotational constant C (calc)"; value 1.4657; unit cm-1; doi "10.1063/5.0006074"; }
            { quantity "rotational symmetry number (point group of the cited structure)"; value 1; unit 1; doi "10.18434/T4D303"; }
            { quantity "electronic level 1 energy (cited state table)"; value 0; unit cm-1; doi "10.18434/T4D303"; }
            { quantity "electronic level 1 degeneracy (cited state table)"; value 2; unit 1; doi "10.18434/T4D303"; }
        );
        uncertainty   "+-0.2 J/(mol K) (propagated from the stated uncertainty of each frequency, 1.5 % on the rotational constants)";
        notes         "constants: no measured gas-phase fundamental or rotational constant is tabulated by CCCBDB or the WebBook for NNH; all constants CALCULATED: B3LYP/def2-TZVP (density fitted, DFT grid level 3) equilibrium geometry and harmonic frequencies (PySCF 2.15, bin/curate/rrho_abinitio_constants.py, UKS for open shells), frequencies x 0.964 (single factor fitted on 23 measured fundamentals of six molecules (the scale_calibration block of rrho_species.json), rms 21 cm-1 / 1.7 %), rotational constants as computed (equilibrium, not B0; ~1-2 % effect); raw harmonic frequencies [1120.0, 1879.2, 2753.4] cm-1";
    }
    idealGasHeatCapacity
    {
        origin        derived;
        method        "RRHO from molecular constants via bin/curate/rrho_thermo.py with the inputs of bin/curate/rrho_species.json, then a 7-term NASA9 least-squares fit (200-1000 K and 1000-6000 K)";
        methodVersion "rrho_thermo.py rrho_species.json";
        inputs
        (
            { quantity "vibrational wavenumber 1 (calc)"; value 1079.9; unit cm-1; doi "10.1063/5.0006074"; }
            { quantity "vibrational wavenumber 2 (calc)"; value 1811.9; unit cm-1; doi "10.1063/5.0006074"; }
            { quantity "vibrational wavenumber 3 (calc)"; value 2654.8; unit cm-1; doi "10.1063/5.0006074"; }
            { quantity "rotational constant A (calc)"; value 22.4649; unit cm-1; doi "10.1063/5.0006074"; }
            { quantity "rotational constant B (calc)"; value 1.568; unit cm-1; doi "10.1063/5.0006074"; }
            { quantity "rotational constant C (calc)"; value 1.4657; unit cm-1; doi "10.1063/5.0006074"; }
            { quantity "rotational symmetry number (point group of the cited structure)"; value 1; unit 1; doi "10.18434/T4D303"; }
            { quantity "electronic level 1 energy (cited state table)"; value 0; unit cm-1; doi "10.18434/T4D303"; }
            { quantity "electronic level 1 degeneracy (cited state table)"; value 2; unit 1; doi "10.18434/T4D303"; }
        );
        uncertainty   "+-0.07 J/(mol K) at 298 K, +-0.13 at 1000 K from the same propagation; above ~1500 K the harmonic model under-counts (anharmonicity, validated deficit up to -3 % at 1500 K and -7 % at 3000 K)";
        notes         "Cp(298.15) = 34.608, Cp(1500) = 52.344 J/(mol K) from the RRHO curve; fit error 1.0e-05 (<1000 K) and 5.9e-05 (>=1000 K), relative. Approximations: rigid rotor, harmonic oscillator; ground state X 2A' only (the first excited state lies far above 6000 cm-1); all vibrations calculated";
    }
    source   "Choupo RRHO computation (bin/curate/rrho_thermo.py) from the molecular constants and enthalpy of formation cited in the record's provenance";
    licence  publicDomain;    // inputs: NIST (US government) data and published spectroscopy; the computation is Choupo's own
}
