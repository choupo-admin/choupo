            { quantity "vibrational wavenumber 5 (exp matrix (Ar))"; value 1072.1; unit cm-1; doi "10.18434/T4D303"; }
            { quantity "vibrational wavenumber 6 (exp matrix (Ar, T low))"; value 599; unit cm-1; doi "10.18434/T4D303"; }
            { quantity "vibrational wavenumber 7 (exp matrix (Ar, T low))"; value 523; unit cm-1; doi "10.18434/T4D303"; }
            { quantity "vibrational wavenumber 8 (exp matrix (Ar, T low))"; value 383; unit cm-1; doi "10.18434/T4D303"; }
            { quantity "vibrational wavenumber 9 (exp matrix (Ar, T low))"; value 346; unit cm-1; doi "10.18434/T4D303"; }
            { quantity "rotational constant A (calc)"; value 22.7969; unit cm-1; doi "10.1063/5.0006074"; }
            { quantity "rotational constant B (calc)"; value 0.3266; unit cm-1; doi "10.1063/5.0006074"; }
            { quantity "rotational constant C (calc)"; value 0.322; unit cm-1; doi "10.1063/5.0006074"; }
            { quantity "rotational symmetry number (point group of the cited structure)"; value 1; unit 1; doi "10.18434/T4D303"; }
            { quantity "electronic level 1 energy (cited state table)"; value 0; unit cm-1; doi "10.18434/T4D303"; }
            { quantity "electronic level 1 degeneracy (cited state table)"; value 1; unit 1; doi "10.18434/T4D303"; }
        );
        uncertainty   "+-0.88 J/(mol K) at 298 K, +-0.53 at 1000 K from the same propagation; plus 0.5 for large-amplitude motion; above ~1500 K the harmonic model under-counts (anharmonicity, validated deficit up to -3 % at 1500 K and -7 % at 3000 K)";
        notes         "Cp(298.15) = 57.600, Cp(1500) = 94.062 J/(mol K) from the RRHO curve; fit error 1.1e-04 (<1000 K) and 1.1e-04 (>=1000 K), relative. Approximations: rigid rotor, harmonic oscillator; the OH torsion (one of the four tentative low modes) is hindered internal rotation treated as a harmonic mode; matrix shifts of the OH stretch (calc. harmonic 3761 vs matrix 3501) not removed";
    }
    source   "Choupo RRHO computation (bin/curate/rrho_thermo.py) from the molecular constants and enthalpy of formation cited in the record's provenance";
