recordType        elementaryReaction;
reversible        true;
printedEquation  "OH + H2 = H + H2O";
limitingReactant  OH;
stoichiometry
(
        { component H;       nu  1; }
        { component H2;      nu -1; }
        { component OH;      nu -1; }
        { component water;   nu  1; }
);
kinetics
{
    type modifiedArrhenius;
    A 2.1600e+08;  b 1.51;  Ea 3.43;
    units { A "cm3/mol/s"; Ea "kcal/mol"; }
}
sets { OConaire2004 R3_OH_H2_H_H2O; }
source
{
    citation "O Conaire, Curran, Simmie, Pitz and Westbrook, Int. J. Chem. Kinet. 36 (2004) 603-622";
    doi "10.1002/kin.20036";
    table "Table I (Revised H2/O2 Reaction Mechanism)";
