recordType        elementaryReaction;
reversible        true;
printedEquation  "H + C2H4 (+M) = C2H5 (+M)";
limitingReactant  H;
stoichiometry
(
        { component C2H5;    nu  1; }
        { component H;       nu -1; }
        { component ethylene; nu -1; }
);
kinetics
{
    type falloff;
    A 2.21e+13;  b 0;  Ea 2066;
    low  { A 6.37e+27;  b -2.8;  Ea -54;  units { A "cm3/mol/s"; Ea "cal/mol"; } }
    thirdBody { H2 2.0; CO 2.0; CO2 3.0; water 5.0; }
    units { A "cm3/mol/s"; Ea "cal/mol"; }
}
sets { MillerBowman1989_AppA A73; }
source
{
    citation "Miller and Bowman, Prog. Energy Combust. Sci. 15 (1989) 287-338";
    doi "10.1016/0360-1285(89)90017-8";
    table "Appendix A (C/H/O/N mechanism)";
    page 332;
    reaction 73;
    note "one mechanism's value, as printed (cm3, mol, s, cal/mol); not an evaluated constant; the review's note: Lindemann footnote 3";
}
reviewStatus      interim;
reviewReason      "read from the page images of Appendix A in two passes (docs/reviews/2026-11-22-miller-bowman/); not yet read back by the curator";
