  Elementary reaction N2+O+M=N2O+M
  Miller and Bowman, Prog. Energy Combust. Sci. 15 (1989) 287-338, Appendix B reaction 25 (p. 337)
  Written by bin/curate/make_kinetics_mb1989.py; the FOLDER name is the
  canonical equation, the file its source (src/thermo/reaction/KineticsLibrary.H).
\*---------------------------------------------------------------------------*/
recordType        elementaryReaction;
reversible        true;
printedEquation  "N2O + M = N2 + O + M";
limitingReactant  N2O;
stoichiometry
(
        { component N2;      nu  1; }
        { component N2O;     nu -1; }
        { component O;       nu  1; }
);
kinetics
{
    type thirdBody;
    A 1.62e+14;  b 0;  Ea 51600;
    thirdBody {  }
    units { A "cm3/mol/s"; Ea "cal/mol"; }
}
sets { MillerBowman1989_AppB B25; }
source
{
    citation "Miller and Bowman, Prog. Energy Combust. Sci. 15 (1989) 287-338";
    doi "10.1016/0360-1285(89)90017-8";
    table "Appendix B (ammonia mechanism)";
    page 337;
    reaction 25;
    note "one mechanism's value, as printed (cm3, mol, s, cal/mol); not an evaluated constant; the review's note: A=1.62e+14 here vs 1.60e+14 in Appendix A reaction 205 (both read twice); Appendix B prints other numbers than Appendix A for this equation, this is B's";
}
reviewStatus      interim;
reviewReason      "read from the page images of Appendix B in two passes (docs/reviews/2026-11-22-miller-bowman/); not yet read back by the curator";
provenance
{
    kinetics
    {
        origin        literature;
        method        "Miller and Bowman, Prog. Energy Combust. Sci. 15 (1989) 287-338, Appendix B, reaction 25 (journal p. 337), A in cm3 mol-1 s-1, Ea in cal/mol, as printed";
        methodVersion "Prog. Energy Combust. Sci. 15 (1989) 287";
        uncertainty   "not given by the source";
    }
}
