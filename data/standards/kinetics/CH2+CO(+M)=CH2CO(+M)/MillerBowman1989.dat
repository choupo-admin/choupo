    type falloff;
    A 3e+14;  b 0;  Ea 70980;
    low  { A 3.6e+15;  b 0;  Ea 59270;  units { A "cm3/mol/s"; Ea "cal/mol"; } }
    thirdBody {  }
    units { A "cm3/mol/s"; Ea "cal/mol"; }
}
sets { MillerBowman1989_AppA A98; }
source
{
