    table "Appendix A (C/H/O/N mechanism)";
    page 333;
    reaction 98;
    note "one mechanism's value, as printed (cm3, mol, s, cal/mol); not an evaluated constant; the review's note: Lindemann footnote 3";
}
reviewStatus      interim;
