/*--------------------------------*- Choupo -*-----------------------*\
  Elementary reaction C3H2+H=CH+acetylene
  Miller and Bowman, Prog. Energy Combust. Sci. 15 (1989) 287-338, Appendix A reaction 34 (p. 331)
  Written by bin/curate/make_kinetics_mb1989.py; the FOLDER name is the
  canonical equation, the file its source (src/thermo/reaction/KineticsLibrary.H).
\*---------------------------------------------------------------------------*/
recordType        elementaryReaction;
reversible        true;
printedEquation  "CH + C2H2 = C3H2 + H";
limitingReactant  CH;
stoichiometry
(
        { component C3H2;    nu  1; }
        { component CH;      nu -1; }
        { component H;       nu  1; }
        { component acetylene; nu -1; }
);
kinetics
{
    type modifiedArrhenius;
    A 1e+14;  b 0;  Ea 0;
    units { A "cm3/mol/s"; Ea "cal/mol"; }
}
sets { MillerBowman1989_AppA A34; }
source
{
    citation "Miller and Bowman, Prog. Energy Combust. Sci. 15 (1989) 287-338";
    doi "10.1016/0360-1285(89)90017-8";
    table "Appendix A (C/H/O/N mechanism)";
    page 331;
    reaction 34;
    note "one mechanism's value, as printed (cm3, mol, s, cal/mol); not an evaluated constant";
}
reviewStatus      interim;
reviewReason      "read from the page images of Appendix A in two passes (docs/reviews/2026-11-22-miller-bowman/); not yet read back by the curator";
provenance
{
    kinetics
    {
        origin        literature;
        method        "Miller and Bowman, Prog. Energy Combust. Sci. 15 (1989) 287-338, Appendix A, reaction 34 (journal p. 331), A in cm3 mol-1 s-1, Ea in cal/mol, as printed";
        methodVersion "Prog. Energy Combust. Sci. 15 (1989) 287";
        uncertainty   "not given by the source";
    }
}
