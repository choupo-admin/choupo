/*--------------------------------*- Choupo -*-----------------------*\
  Elementary reaction H+H+water=H2+water
  Miller and Bowman, Prog. Energy Combust. Sci. 15 (1989) 287-338, Appendix A reaction 141 (p. 334)
  Written by bin/curate/make_kinetics_mb1989.py; the FOLDER name is the
  canonical equation, the file its source (src/thermo/reaction/KineticsLibrary.H).
\*---------------------------------------------------------------------------*/
recordType        elementaryReaction;
reversible        true;
spectators       true;
printedEquation  "2H + H2O = H2 + H2O";
limitingReactant  H;
stoichiometry
(
        { component H;       nu -2;  order 2;  orderRev 0; }
        { component H2;      nu  1;  order 0;  orderRev 1; }
        { component water;   nu  0;  order 1;  orderRev 1; }
);
kinetics
{
    type modifiedArrhenius;
    A 6e+19;  b -1.25;  Ea 0;
    units { A "cm3/mol/s"; Ea "cal/mol"; }
}
sets { MillerBowman1989_AppA A141; MillerBowman1989_AppB B12; }
source
{
    citation "Miller and Bowman, Prog. Energy Combust. Sci. 15 (1989) 287-338";
    doi "10.1016/0360-1285(89)90017-8";
    table "Appendix A (C/H/O/N mechanism)";
    page 334;
    reaction 141;
    alsoPrinted "Appendix B reaction 12, p. 337: the same numbers";
    note "one mechanism's value, as printed (cm3, mol, s, cal/mol); not an evaluated constant";
}
reviewStatus      interim;
reviewReason      "read from the page images of Appendix A in two passes (docs/reviews/2026-11-22-miller-bowman/); not yet read back by the curator";
provenance
{
    kinetics
    {
        origin        literature;
        method        "Miller and Bowman, Prog. Energy Combust. Sci. 15 (1989) 287-338, Appendix A, reaction 141 (journal p. 334), A in cm3 mol-1 s-1, Ea in cal/mol, as printed";
        methodVersion "Prog. Energy Combust. Sci. 15 (1989) 287";
        uncertainty   "not given by the source";
    }
}
