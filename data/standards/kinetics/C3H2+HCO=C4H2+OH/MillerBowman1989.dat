/*--------------------------------*- Choupo -*-----------------------*\
  Elementary reaction C3H2+HCO=C4H2+OH
  Miller and Bowman, Prog. Energy Combust. Sci. 15 (1989) 287-338, Appendix A reaction 117 (p. 333)
  Written by bin/curate/make_kinetics_mb1989.py; the FOLDER name is the
  canonical equation, the file its source (src/thermo/reaction/KineticsLibrary.H).
\*---------------------------------------------------------------------------*/
recordType        elementaryReaction;
reversible        true;
printedEquation  "C4H2 + OH = C3H2 + HCO";
limitingReactant  C4H2;
stoichiometry
(
        { component C3H2;    nu  1; }
        { component C4H2;    nu -1; }
        { component HCO;     nu  1; }
        { component OH;      nu -1; }
);
kinetics
{
    type modifiedArrhenius;
    A 6.66e+12;  b 0;  Ea -410;
    units { A "cm3/mol/s"; Ea "cal/mol"; }
}
sets { MillerBowman1989_AppA A117; }
source
{
    citation "Miller and Bowman, Prog. Energy Combust. Sci. 15 (1989) 287-338";
    doi "10.1016/0360-1285(89)90017-8";
    table "Appendix A (C/H/O/N mechanism)";
    page 333;
    reaction 117;
    note "one mechanism's value, as printed (cm3, mol, s, cal/mol); not an evaluated constant; the review's note: E: last digit region speckled in the scan; read -410 (two passes, 4x zoom)";
}
reviewStatus      interim;
reviewReason      "read from the page images of Appendix A in two passes (docs/reviews/2026-11-22-miller-bowman/); not yet read back by the curator";
provenance
{
    kinetics
    {
        origin        literature;
        method        "Miller and Bowman, Prog. Energy Combust. Sci. 15 (1989) 287-338, Appendix A, reaction 117 (journal p. 333), A in cm3 mol-1 s-1, Ea in cal/mol, as printed";
        methodVersion "Prog. Energy Combust. Sci. 15 (1989) 287";
        uncertainty   "not given by the source";
    }
}
