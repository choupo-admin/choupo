recordType        elementaryReaction;
reversible        true;
printedEquation  "NH + NO = N2O + H";
limitingReactant  NH;
stoichiometry
(
        { component H;       nu  1; }
        { component N2O;     nu  1; }
        { component NH;      nu -1; }
        { component NO;      nu -1; }
);
kinetics
{
    type modifiedArrhenius;
    A 2.7000e+15;  b -0.78;  Ea 20.0;
    units { A "cm3/mol/s"; Ea "cal/mol"; }
}
sets { Glarborg2018 N2O17_NH_NO_N2O_H; }
source
{
    citation "Glarborg, Miller, Ruscic and Klippenstein, Prog. Energy Combust. Sci. 67 (2018) 31-68";
