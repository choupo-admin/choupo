/*--------------------------------*- Choupo -*-----------------------*\
  Elementary reaction HNO+HNO=N2O+water
  Miller and Bowman, Prog. Energy Combust. Sci. 15 (1989) 287-338, Appendix B reaction 54 (p. 338)
  Written by bin/curate/make_kinetics_mb1989.py; the FOLDER name is the
  canonical equation, the file its source (src/thermo/reaction/KineticsLibrary.H).
\*---------------------------------------------------------------------------*/
recordType        elementaryReaction;
reversible        true;
printedEquation  "2HNO = N2O + H2O";
limitingReactant  HNO;
stoichiometry
(
        { component HNO;     nu -2; }
        { component N2O;     nu  1; }
        { component water;   nu  1; }
);
kinetics
{
    type modifiedArrhenius;
    A 3.95e+12;  b 0;  Ea 5000;
    units { A "cm3/mol/s"; Ea "cal/mol"; }
}
sets { MillerBowman1989_AppB B54; }
source
{
    citation "Miller and Bowman, Prog. Energy Combust. Sci. 15 (1989) 287-338";
    doi "10.1016/0360-1285(89)90017-8";
    table "Appendix B (ammonia mechanism)";
    page 338;
    reaction 54;
    note "one mechanism's value, as printed (cm3, mol, s, cal/mol); not an evaluated constant";
}
reviewStatus      interim;
reviewReason      "read from the page images of Appendix B in two passes (docs/reviews/2026-11-22-miller-bowman/); not yet read back by the curator";
provenance
{
    kinetics
    {
        origin        literature;
        method        "Miller and Bowman, Prog. Energy Combust. Sci. 15 (1989) 287-338, Appendix B, reaction 54 (journal p. 338), A in cm3 mol-1 s-1, Ea in cal/mol, as printed";
        methodVersion "Prog. Energy Combust. Sci. 15 (1989) 287";
        uncertainty   "not given by the source";
    }
}
