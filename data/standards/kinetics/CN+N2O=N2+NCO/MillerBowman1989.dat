/*--------------------------------*- Choupo -*-----------------------*\
  Elementary reaction CN+N2O=N2+NCO
  Miller and Bowman, Prog. Energy Combust. Sci. 15 (1989) 287-338, Appendix A reaction 185 (p. 335)
  Written by bin/curate/make_kinetics_mb1989.py; the FOLDER name is the
  canonical equation, the file its source (src/thermo/reaction/KineticsLibrary.H).
\*---------------------------------------------------------------------------*/
recordType        elementaryReaction;
reversible        true;
printedEquation  "CN + N2O = NCO + N2";
limitingReactant  CN;
stoichiometry
(
        { component CN;      nu -1; }
        { component N2;      nu  1; }
        { component N2O;     nu -1; }
        { component NCO;     nu  1; }
);
kinetics
{
    type modifiedArrhenius;
    A 1e+13;  b 0;  Ea 0;
    units { A "cm3/mol/s"; Ea "cal/mol"; }
}
sets { MillerBowman1989_AppA A185; }
source
{
    citation "Miller and Bowman, Prog. Energy Combust. Sci. 15 (1989) 287-338";
    doi "10.1016/0360-1285(89)90017-8";
    table "Appendix A (C/H/O/N mechanism)";
    page 335;
    reaction 185;
    note "one mechanism's value, as printed (cm3, mol, s, cal/mol); not an evaluated constant; the review's note: A: leading digit partly lost in the scan; read 1.00e+13 (consistent with every other row of this A-value)";
}
reviewStatus      interim;
reviewReason      "read from the page images of Appendix A in two passes (docs/reviews/2026-11-22-miller-bowman/); not yet read back by the curator";
provenance
{
    kinetics
    {
        origin        literature;
        method        "Miller and Bowman, Prog. Energy Combust. Sci. 15 (1989) 287-338, Appendix A, reaction 185 (journal p. 335), A in cm3 mol-1 s-1, Ea in cal/mol, as printed";
        methodVersion "Prog. Energy Combust. Sci. 15 (1989) 287";
        uncertainty   "not given by the source";
    }
}
