#---------------------------------------------------------------------------#
#  runGui  --  one-shot launcher: start the Choupo Vite dev server and
#              open it in a fresh Firefox window.
#
#  Sibling of runCase / runApplication / listCases / cleanCase.
#
#  Usage:
#      bin/runGui                # default: 1400x900 windowed
#      bin/runGui --fullscreen   # open in fullscreen (F11-style; Esc
#                                # reverts to a normal window)
#      bin/runGui --no-browser   # only start the dev server
#      bin/runGui --kill         # stop the dev server (and any orphans)
#
#  Cleanup contract:
#      * Re-running `bin/runGui` is idempotent: any previous dev server
#        is killed before a new one starts (delegated to `bin/devGui`).
#      * Firefox is launched with `--no-remote` against a dedicated
#        Choupo profile (~/.cache/choupo-firefox/), so it opens as a
#        genuinely separate Firefox window/process -- independent of
#        the user's daily-browsing Firefox session.  Closing the
#        window does NOT stop the dev server (it is meant to survive
#        across edit/reload cycles).  Use `bin/runGui --kill` to stop
#        the server.
#---------------------------------------------------------------------------#

set -e

script_dir=$(dirname "$(readlink -f "$0")")
URL="http://127.0.0.1:5173/"

#  A STALE WASM IS OLD PHYSICS IN THE BROWSER, and it fails silently: the
#  GUI faithfully draws whatever the .wasm computes, so an engine fix that
#  never reached `make wasm-gui` simply... is not there.  Found the hard
#  way (2026-08-10): gui/public/wasm sat twelve days behind src/, and
#  flash21's mass balance "did not close and finished without any warning"
#  in the browser while the native binary and the whole suite had both
#  right.  gui/public/wasm is gitignored -- a LOCAL build product -- so
#  every machine must build its own, and this launcher is the one seam
#  every GUI session passes through.  REFUSE to serve a solver older than
#  the sources; a missing wasm gets the same message.
root_dir=$(dirname "$script_dir")
wasm="$root_dir/gui/public/wasm/choupoSolve.wasm"
newest_src=$(find "$root_dir/src" "$root_dir/make" -type f \
                 \( -name '*.cpp' -o -name '*.H' -o -name '*.mk' \) \
                 -newer "$wasm" 2>/dev/null | head -1 || true)
if [ ! -f "$wasm" ] || [ -n "$newest_src" ]; then
    echo "[runGui] REFUSED: gui/public/wasm is $( [ -f "$wasm" ] \
         && echo 'OLDER than the C++ sources' || echo 'MISSING' ) --"
    echo "         the browser would run old physics while the native"
    echo "         binary runs the current tree (the two CAN disagree on"
    echo "         answers, balances and refusals)."
    echo "         Build it:   make wasm-gui      (then re-run bin/runGui)"
    exit 1
fi

#  AND THE STAMP MUST NOT BE OLDER THAN THE ENGINE IT NAMES (2026-08-26).
#  TopBar.tsx reads gui/public/wasm/version.json for the badge and its
#  comment claims the announced version and the running engine "can never
#  disagree".  They can, and Vitor hit it: `wasm-version` is a RECURSIVE
#  step that runs AFTER the binaries, so a build that dies part-way leaves
#  fresh .wasm files beside a stamp from the last build that COMPLETED.
#  His browser announced Choupo-2607 -- the last successful build, months
#  old -- over binaries compiled minutes earlier.
#
#  A version badge that lies is worse than no badge: it is the ONE thing a
#  reader consults to find out what they are running, and CLAUDE.md points
#  at it as the staleness check.  So this refuses too, separately, because
#  the remedy is the same command but the fault is a different one.
stamp="$root_dir/gui/public/wasm/version.json"
if [ -f "$wasm" ] && { [ ! -f "$stamp" ] || [ "$wasm" -nt "$stamp" ]; }; then
    echo "[runGui] REFUSED: gui/public/wasm/version.json is $( [ -f "$stamp" ] \
         && echo 'OLDER than the .wasm beside it' || echo 'MISSING' ) --"
    echo "         the version badge would announce the last build that"
    echo "         COMPLETED while the browser runs binaries from a later"
    echo "         one that did not (the stamp is written after them)."
    echo "         Build it:   make wasm-gui      (then re-run bin/runGui)"
    exit 1
fi

#  NODE, AND THE INTERFACE'S LIBRARIES (2026-09-30).  Whoever runs this may
#  know nothing about Node or npm (Vitor: "os meus alunos nao percebem nada
#  de computadores"), so the launcher does the plumbing itself and speaks
#  only when a person has to act.
#
#  Node: Vite needs 18; pdfjs-dist and postcss-mixins (via Mantine) DECLARE
#  20.  Below 18 nothing runs, so it stops; at 18-19 it runs today, so it
#  says once what to update and carries on.
if ! command -v node > /dev/null 2>&1 || ! command -v npm > /dev/null 2>&1; then
    echo "[runGui] Choupo's interface needs Node.js, and this computer does"
    echo "         not have it.  Install the LTS version from https://nodejs.org,"
    echo "         then run bin/runGui again."
    exit 1
fi
node_major=$(node -p 'process.versions.node.split(".")[0]' 2>/dev/null || echo 0)
if [ "$node_major" -lt 18 ]; then
    echo "[runGui] Choupo's interface needs Node.js 20 or newer; this computer"
    echo "         has $(node -v).  Install the LTS version from https://nodejs.org,"
    echo "         then run bin/runGui again."
    exit 1
elif [ "$node_major" -lt 20 ]; then
    echo "[runGui] note: Node.js $(node -v) is older than the 20 some of the"
    echo "         interface's libraries ask for.  It runs today; update from"
    echo "         https://nodejs.org (LTS) when convenient."
fi

#  The libraries: gui/node_modules is a LOCAL install, gitignored like the
#  wasm, and a pull that adds one does not install it -- Vitor pulled the
#  KaTeX lessons and Vite died with "Failed to resolve import
#  katex/dist/...", the consequence rather than the cause.  npm writes
#  node_modules/.package-lock.json on every install, so a lockfile NEWER
#  than it is a set this machine has not installed: install it, quietly
#  (a student has nothing to do with npm's warnings), and stop only if the
#  install itself fails.
lock="$root_dir/gui/package-lock.json"
installed="$root_dir/gui/node_modules/.package-lock.json"
if [ ! -f "$installed" ] || [ "$lock" -nt "$installed" ]; then
    echo "[runGui] installing the interface's libraries (first run, or after"
    echo "         an update) -- this can take a minute ..."
    if ! (cd "$root_dir/gui" && npm install --no-audit --no-fund \
              --loglevel=error > /tmp/choupo-npm-install.log 2>&1); then
        echo "[runGui] the installation failed; the details are in"
        echo "         /tmp/choupo-npm-install.log.  Check the internet"
        echo "         connection and run bin/runGui again."
        exit 1
    fi
    echo "[runGui] libraries installed"
fi

kill_prior() {
    local prior
    prior=$(pgrep -f 'node .*\.bin/vite' 2>/dev/null || true)
    if [ -n "$prior" ]; then
        echo "[runGui] stopping prior vite processes: $prior"
        kill $prior 2>/dev/null || true
        sleep 0.5
        # Anyone stubborn after SIGTERM -- be emphatic, then wait again
        # so the listening sockets are fully released before we restart.
        local still
        still=$(pgrep -f 'node .*\.bin/vite' 2>/dev/null || true)
        if [ -n "$still" ]; then
            kill -KILL $still 2>/dev/null || true
            sleep 0.5
        fi
    fi
}

case "${1:-}" in
    --kill|--stop)
        pkill -f 'claudeBridge.mjs' 2>/dev/null && echo "[runGui] stopped agent bridge" || true
        if pgrep -f 'node .*\.bin/vite' > /dev/null 2>&1; then
            kill_prior
            echo "[runGui] stopped"
        else
            echo "[runGui] nothing running"
        fi
        exit 0
        ;;
esac

# 1. Kill any prior Vite synchronously BEFORE waiting on the new one.
#    Doing this here (rather than letting devGui do it from inside its own
#    background process) avoids a race where the readiness probe sees the
#    OLD vite responding just before devGui kills it -- making the script
#    falsely report "ready" then "ERROR" half a second apart.
kill_prior

# 2. Start fresh vite in the background.  devGui still does its own
#    safety-net cleanup, but at this point there is nothing to clean up.
LOG=/tmp/choupo-dev.log
echo "[runGui] starting Vite dev server -> log $LOG"
nohup "$script_dir/devGui" > "$LOG" 2>&1 &
disown

# 3. Wait up to 30 seconds for the server to come up.
echo -n "[runGui] waiting for $URL "
ready=0
for i in $(seq 1 60); do
    if curl -fs "$URL" -o /dev/null 2>&1; then
        ready=1
        echo ""
        echo "[runGui] dev server ready"
        break
    fi
    echo -n "."
    sleep 0.5
done

if [ "$ready" = "0" ]; then
    echo ""
    echo "[runGui] ERROR: dev server failed to start; check $LOG"
    tail -n 20 "$LOG" 2>/dev/null || true
    exit 1
fi

# 2b. Start the Assistant bridge (the GUI's console runs `claude -c` through it).
#     Best-effort: if `claude` is missing the console just shows how to start it.
pkill -f 'claudeBridge.mjs' 2>/dev/null || true
if command -v claude > /dev/null; then
    BLOG=/tmp/choupo-agent-bridge.log
    echo "[runGui] starting Assistant bridge -> log $BLOG"
    nohup "$script_dir/agentBridge" > "$BLOG" 2>&1 &
    disown
fi

# 3. Open the GUI in Firefox unless the user asked us not to.
if [ "${1:-}" = "--no-browser" ]; then
    echo "[runGui] dev server is at $URL  (Firefox not launched)"
    exit 0
fi

# Dedicated Firefox profile under ~/.cache/choupo-firefox/ -- isolated
# from the user's daily Firefox: own session, own cache, own (lack of)
# bookmarks.  Combined with `--no-remote` this guarantees a genuinely
# separate Firefox window/process, not a new tab in the running browser.
# The guides the GUI serves (F1 / the Theory links) live at gui/public/docs/,
# a GITIGNORED copy of docs/*.pdf -- and an unsynced copy silently serves a
# STALE guide: a nameddest added since the last copy is absent from the old
# PDF, so the viewer opens on page 1 instead of the section (found 2026-08-15,
# a 17-day-old theoryGuide.pdf behind a fresh ch:coolingTower link).  Sync on
# every launch; -u makes it a no-op when nothing changed.
mkdir -p "$root_dir/gui/public/docs"
for _g in theoryGuide userGuide propsGuide developerGuide; do
    [ -f "$root_dir/docs/$_g.pdf" ] && cp -u "$root_dir/docs/$_g.pdf" "$root_dir/gui/public/docs/"
done

PROFILE_DIR="${HOME}/.cache/choupo-firefox"
#  Ubuntu ships Firefox as a SNAP, and a snap may not read hidden
#  directories in $HOME -- so a profile under ~/.cache is one the browser
#  cannot open, and with its output sent to /dev/null the student sees
#  "opening Firefox" and then nothing.  A snap's own writable area is
#  ~/snap/firefox/common, so the profile goes there.
#  (On Ubuntu /usr/bin/firefox is often a small script that runs the snap,
#  so the script's own text is checked too.)
_ff=$(command -v firefox 2>/dev/null || true)
if [ "${_ff#/snap/}" != "$_ff" ] \
   || { [ -n "$_ff" ] && grep -qs '/snap/bin/firefox' "$_ff"; }; then
    PROFILE_DIR="${HOME}/snap/firefox/common/choupo-profile"
fi
FIRST_RUN=0
if [ ! -d "$PROFILE_DIR" ]; then
    mkdir -p "$PROFILE_DIR"
    FIRST_RUN=1
fi

# First-run profile setup: skip welcome/onboarding noise and ensure
# Esc exits fullscreen.
if [ "$FIRST_RUN" = "1" ]; then
    cat > "$PROFILE_DIR/user.js" <<'EOF'
user_pref("browser.aboutwelcome.enabled", false);
user_pref("browser.shell.checkDefaultBrowser", false);
user_pref("browser.sessionstore.resume_from_crash", false);
user_pref("browser.fullscreen.exit_on_esc", true);
user_pref("datareporting.policy.firstRunURL", "");
user_pref("browser.startup.homepage_override.mstone", "ignore");
EOF
fi

# Window sizemode persistence lives in xulstore.json.
#   default       -> "normal"     1400 x 900 windowed (only set on
#                                  first run, so the user's later
#                                  resize sticks)
#   --fullscreen  -> "fullscreen" F11-style: chrome hidden but Esc
#                                  reverts to a normal window
#                                  (NOT --kiosk, which traps input)
WANT_SIZEMODE='"normal"'
if [ "${1:-}" = "--fullscreen" ]; then
    WANT_SIZEMODE='"fullscreen"'
fi

if [ "$FIRST_RUN" = "1" ] || [ "${1:-}" = "--fullscreen" ]; then
    cat > "$PROFILE_DIR/xulstore.json" <<EOF
{
  "chrome://browser/content/browser.xhtml": {
    "main-window": {
      "screenX": "100",
      "screenY": "100",
      "width": "1400",
      "height": "900",
      "sizemode": $WANT_SIZEMODE
    }
  }
}
EOF
fi

if command -v firefox > /dev/null; then
    echo "[runGui] opening Firefox at $URL (profile $PROFILE_DIR)"
    firefox --no-remote --profile "$PROFILE_DIR" --new-window "$URL" \
        > /dev/null 2>&1 &
    disown
elif command -v xdg-open > /dev/null; then
    echo "[runGui] Firefox not found -- opening $URL in your default browser"
    xdg-open "$URL" > /dev/null 2>&1 &
    disown
else
    echo "[runGui] Firefox not found -- open $URL in your browser"
fi
echo "[runGui] if no window appears, open $URL in any browser yourself"

echo "[runGui] dev server running in background; run \`bin/runGui --kill\` to stop"
