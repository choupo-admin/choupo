#---------------------------------------------------------------------------#
#  checkGui  --  run the GUI visual-defect harness (phase 1).
#
#  The GUI's node/jsdom tests cannot see layout: there every box is 0x0 and
#  nothing is ever on top of anything.  This harness opens the real app in a
#  real Chromium at a real viewport and asks the one question those tests
#  cannot: for every visible interactive control, would a click at its centre
#  actually reach it?
#
#  Usage:
#      bin/checkGui                 # walk the EduTools workspace at 1400x900
#      bin/checkGui --screenshots   # also save a PNG per page (gitignored)
#      bin/checkGui --keep-server   # leave a dev server this run started up
#
#  Exit codes:
#      0   no covered control found
#      1   at least one control is covered  (a real, clickable-surface defect)
#      2   REFUSED -- it could not honestly run (no Chromium, no node_modules,
#          no dev server, empty registry).  Never a silent skip: this project
#          retired a gate that reported PASS while its inputs were gone.
#
#  Implementation: gui/tools/checkGui/ (checkGui.mjs, cdp.mjs, occlusion.mjs).
#  NO new dependency -- it drives Chromium over the DevTools protocol using
#  `ws`, already a devDependency of gui/.  The browser is the pre-installed one
#  under PLAYWRIGHT_BROWSERS_PATH; never run `playwright install`.
#---------------------------------------------------------------------------#

set -u

script_dir=$(dirname "$(readlink -f "$0")")
root=$(dirname "$script_dir")

if ! command -v node >/dev/null 2>&1; then
    echo "checkGui REFUSES TO RUN: node is not on PATH." >&2
    echo "Remedy: install Node (the GUI toolchain needs it anyway)." >&2
    exit 2
fi

exec node "$root/gui/tools/checkGui/checkGui.mjs" "$@"
