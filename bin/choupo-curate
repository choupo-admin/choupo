#!/usr/bin/env python3
"""choupo-curate -- the C16 chain for one binary pair, as ONE command.

    bin/choupo-curate pair A B [--pmax 110] [--plan] [--no-commit]
    bin/choupo-curate pair A B --promote
    bin/choupo-curate fetch <case>
    bin/choupo-curate revert <pair-file-stem>
    bin/choupo-curate <compound> [--case DIR] [--rule byDoiOrder] [--nFit N]
                                 (the pure-compound mode, unchanged; see below)

WHY (DEV.md 4c C282, after C16/C225/C226/C280).  The chain that regressed the
catalogue's first NRTL pairs (docs/design/binary-pairs-from-open-measurements.md)
was a sequence of manual steps: join the two compounds to the archive, list
the studies, choose a fit set and a held-out set, compute the band, write a
case, fit, read the verdict, check the phase stability, promote.  Every rule
in it was already DECIDED; only the hands were missing.  This tool applies
the decided rules and decides nothing new:

  1. IDENTITY.  Both components are joined to the archive by InChIKey
     (thirdParty/thermoml/identity.json, two resolvers that agree) -- never
     by name.  A pair that already has a record in ANY model directory of
     data/standards/parameters/ is REFUSED: this tool never overwrites.
  2. STUDIES.  Every isobaric (or multi-isobar) bubble-temperature block at
     or below --pmax kPa whose uncertainty is declared, extracted with
     `choupo-thermoml extract-vle --interior-only` into a scratch directory.
     A block whose uncertainty is partial or absent, whose x is reported for
     the OTHER component (extract-vle has no reorientation, C16 6.1), or with
     fewer than 5 interior points is SET ASIDE BY NAME.
  3. TRIAGE (C226 item 3).  Leave-one-study-out: the pair is fitted by the
     ENGINE (fitParameters, the same model and weighting) on every study but
     one and scored on that one.  A study whose held-out AAD exceeds its own
     largest stated U plus the largest stated U of the others disagrees with
     them beyond their stated uncertainties and is SET ASIDE BY NAME in the
     declaration.  With two usable studies the triage cannot say which of two
     disagreeing studies is wrong; it says so, and the held-out verdict is
     then the test.
  4. PARTITION (C16 slice 2, declared rule).  FIT = the study with the most
     interior points; HELD OUT = the next largest sharing NO author with it
     and measured at ONE pressure.  None -> REFUSED by name.
  5. BAND (C16 rule).  The held-out set's largest stated expanded U plus the
     catalogue vapour-pressure model's own error at that set's pure endpoints
     (the larger of the two, measured with no pair, by the engine), as a % of
     the held-out mean T, rounded UP to two significant figures; the Antoine
     term is ZERO when the study reports no pure endpoint.
  6. CASE.  data/curation/pairs/<a>-<b> (the record's own stem) on the shape of
     curate06/curate09: two fits from two starts, ideal/UNIFAC/NRTL overlays.
     The declaration (partition, triage, band and its origin sentence) is
     WRITTEN and COMMITTED before any fit runs, so it can be read against the
     result.
  7. NO MEASURED SERIES IN THE TREE (Vitor, 2026-11-10: "nao vamos copiar as
     series medidas! Vamos so guardar os parametros de ajuste").  The case
     declares each dataset in `constant/archiveDatasets`: DOI, the NIST
     per-article URL, the sha256 of the article file, the extraction selector
     and the sha256 of the extracted file.  `fetch` regenerates the extracts
     into constant/archiveExtracts/ (gitignored): from the local cache when it
     holds the article, else from the NIST URL; a sha256 mismatch REFUSES; an
     unreachable NIST is reported NOT RUN (exit 2), never a pass.
  8. RUN, VERDICT, PHASE STABILITY.  The fit is run, the case-local record is
     written from the proposal (reviewStatus interim), the case is sealed
     (bin/choupo-import), and arm (f) of check_regressed_pairs is applied to
     the fitted parameters: a pair that splits ONE liquid inside its own
     validity span is never proposed for promotion.
  9. PROMOTION (C225/C226, the architect's decision).  `--promote` copies the
     record into data/standards/parameters/NRTL/ as `reviewStatus
     autoPromoted;` with `review { by none; }` (DEV.md 4c C300 rule 4; a
     record no longer gets `humanReviewed`) ONLY when the verdict is
     `validated`, arm (f) is clean and the triage ran; it never overwrites a
     record; `revert` removes a record this tool promoted, and only such a
     record.

WHAT IT DOES NOT DO.  Read the articles back (every dataset stays
`transcribedNotCheckedAgainstArticle`; the CHECKLIST it writes beside the
extracts is the aid for that human act); fit any model but two-parameter NRTL
(a = 0, alpha 0.30, the C16 frame); decide a band; choose a partition by
looking at a residual.
"""
import argparse
import hashlib
import json
import math
import os
import re
import shutil
import subprocess
import sys
import tempfile
import unicodedata
import urllib.request
from datetime import date
from pathlib import Path

ROOT = Path(__file__).resolve().parents[1]
sys.path.insert(0, str(ROOT / "bin" / "curate"))
import check_regressed_pairs as crp  # noqa: E402  (arm f and the record reader: ONE home)
import curation_roots  # noqa: E402  (where a curation case lives: ONE home, DEV.md 4c C295)

PROPS = ROOT / "choupoProps"
THERMOML = ROOT / "bin" / "choupo-thermoml"
IMPORT = ROOT / "bin" / "choupo-import"
CURATION = curation_roots.PAIRS        # a pair case is born under here (C295, C296)
VP_CURATION = curation_roots.COMPONENTS   # a vapour-pressure case is born here
STD_PARAMS = ROOT / "data" / "standards" / "parameters"
STD_NRTL = STD_PARAMS / "NRTL"
DECL = "constant/archiveDatasets"
EXTRACTS = "constant/archiveExtracts"
NIST = "https://trc.nist.gov/ThermoML/{doi}.{ext}"
ARCHIVE = "ThermoML.v2020-09-30.tgz"
ARCHIVE_DOI = "10.18434/mds2-2422"
MIN_INTERIOR = 5
PROMOTED_BY = "bin/choupo-curate pair --promote"
#  DEV.md 4c C300 rule 4: a tool writes who reviewed the record -- today nobody.
REVIEW_NONE = "    review        { by none; }   // DEV.md 4c C300 rule 4 (C297): nobody has reviewed it\n"


def cache_root():
    env = os.environ.get("CHOUPO_THERMOML_HOME")
    return Path(env) if env else ROOT / "thirdParty" / "thermoml"


def say(*a):
    print(*a, flush=True)


def refuse(msg, code=1):
    say("choupo-curate: REFUSED\n  " + msg)
    sys.exit(code)


def sha_file(p):
    return hashlib.sha256(Path(p).read_bytes()).hexdigest()


def env():
    return dict(os.environ, CHOUPO_HOME=str(ROOT))


# --------------------------------------------------------------------------
#  1. identity
# --------------------------------------------------------------------------
def identity(name):
    f = cache_root() / "identity.json"
    if not f.exists():
        refuse(f"no {f} -- run `bin/choupo-thermoml identity` first: a pair is "
               "joined to the archive by InChIKey, never by name")
    doc = json.loads(f.read_text())
    hits = [r for r in doc["records"]
            if name in (r.get("component"), r.get("cas"), r.get("inchiKey"))]
    if not hits:
        refuse(f"'{name}' names no catalogue component in identity.json")
    r = hits[0]
    if r.get("status") != "resolved":
        refuse(f"'{r['component']}' has identity status '{r.get('status')}' -- the "
               "two resolvers did not agree on its InChIKey, so no archive block "
               "can be joined to it")
    if len(doc["byInchiKey"].get(r["inchiKey"], [])) != 1:
        refuse(f"the InChIKey of '{r['component']}' is claimed by "
               f"{doc['byInchiKey'][r['inchiKey']]} -- an ambiguous join joins nothing")
    return r["component"], r["cas"], r["inchiKey"]


def existing_records(a, b, model=None):
    """Every record in ANY model directory of data/standards/parameters/ for
    the pair -- by file name (either order, any prefix) and by `pair {}`.
    With `model`, that model's directory only (DEV.md 4c C294: one pair now
    carries NRTL, UNIQUAC and Wilson records, and each model's promotion asks
    about its own)."""
    out = []
    pat = re.compile(r"pair\s*\{\s*i\s+(\S+?)\s*;\s*j\s+(\S+?)\s*;")
    for p in sorted((STD_PARAMS / model if model else STD_PARAMS).rglob("*.dat")):
        parts = p.stem.split("-")
        hit = len(parts) >= 2 and {parts[-2], parts[-1]} == {a, b}
        m = pat.search(p.read_text(errors="replace"))
        if m and {m.group(1), m.group(2)} == {a, b}:
            hit = True
        if hit:
            out.append(p.relative_to(ROOT).as_posix())
    return out


# --------------------------------------------------------------------------
#  2. studies
# --------------------------------------------------------------------------
def surnames(authors):
    out = set()
    for a in authors:
        s = a.split(",")[0].strip()
        s = unicodedata.normalize("NFKD", s).encode("ascii", "ignore").decode().lower()
        if s:
            out.add(s)
    return out


def blocks_for(keys, pmax):
    vi = cache_root() / "vleIndex.json"
    ix = cache_root() / "index.json"
    for f in (vi, ix):
        if not f.exists():
            refuse(f"no {f} -- run `bin/choupo-thermoml index` and `vle-index` first")
    rows = json.loads(vi.read_text())["blocks"]
    authors = {e["doi"]: e.get("authors", []) for e in json.loads(ix.read_text())["entries"]}
    out = []
    for r in rows:
        ks = {c.get("inchiKey") for c in r["compounds"]}
        if ks != set(keys) or r["geometry"] != "bubbleT":
            continue
        if not r["P_kPa"] or r["P_kPa"][1] > pmax:
            continue
        r = dict(r, authors=authors.get(r["doi"], []))
        out.append(r)
    out.sort(key=lambda r: (r["doi"], r["block"]))
    return out


def read_dataset(path):
    """The facts this tool needs from an extract-vle dataset file."""
    t = path.read_text()
    cols = re.findall(r"\{\s*name\s+(\S+?);", t[t.index("\ncolumns"):t.index("\ndata")])
    xcomp = re.match(r"x\[(.+)\]", cols[0]).group(1)
    d = t[t.index("\ndata"):]
    rows = [l.split() for l in d.splitlines() if l.strip() and l.strip()[0].isdigit()]
    iT = cols.index("T_bubble")
    iP = cols.index("Pressure") if "Pressure" in cols else None
    m = re.search(r"^pressure\s+([0-9.eE+-]+)\s+kPa;", t, re.M)
    u = re.search(r"T_bubble\s*\{[^}]*values\s*\(([^)]*)\)", t, re.S)
    U = [float(v) for v in u.group(1).split()] if u else None
    if U is not None and len(U) != len(rows):
        U = None
    pe = re.findall(r"\{\s*x\s+([0-9.]+);\s*T_bubble\s+([0-9.eE+-]+)\s*K;\s*\}", t)
    return {
        "x": xcomp, "n": len(rows),
        "T": [float(r[iT]) for r in rows],
        "P_kPa": float(m.group(1)) if m else None,
        "isobars": sorted({float(r[iP]) for r in rows}) if iP is not None else None,
        "U": U, "pure": [(float(x), float(T)) for x, T in pe],
    }


def extract(xml, block, into, fake_cache=None, x_of=None):
    """Run extract-vle on ONE block; return (path, stdout) or (None, why).
    `x_of` (C284): write the series in that member's mole fraction."""
    cmd = [sys.executable, "-I", str(THERMOML), "extract-vle", str(xml),
           "--block", str(block), "--interior-only", "--into", str(into)]
    if x_of:
        cmd += ["--x-of", x_of]
    e = env()
    if fake_cache:
        e["CHOUPO_THERMOML_HOME"] = str(fake_cache)
    p = subprocess.run(cmd, capture_output=True, text=True, env=e)
    m = re.search(r"extract-vle: (\S+\.dat)\s+\(", p.stdout)
    if p.returncode != 0 or not m:
        why = " ".join(l.strip() for l in p.stdout.splitlines()[1:3]) or p.stderr[-300:]
        return None, why
    return Path(m.group(1)), p.stdout


def extract_px(xml, block, into, fake_cache=None, x_of=None):
    """Run extract-px (C291, a bubble-PRESSURE block) on ONE block; return
    (path, stdout) or (None, why).  The same contract as `extract`."""
    cmd = [sys.executable, "-I", str(THERMOML), "extract-px", str(xml),
           "--block", str(block), "--into", str(into)]
    if x_of:
        cmd += ["--x-of", x_of]
    e = env()
    if fake_cache:
        e["CHOUPO_THERMOML_HOME"] = str(fake_cache)
    p = subprocess.run(cmd, capture_output=True, text=True, env=e)
    m = re.search(r"extract-px: (\S+\.dat)\s+\(", p.stdout)
    if p.returncode != 0 or not m:
        why = " ".join(l.strip() for l in p.stdout.splitlines()[1:3]) or p.stderr[-300:]
        return None, why
    return Path(m.group(1)), p.stdout


# --------------------------------------------------------------------------
#  engine runs (scratch cases)
# --------------------------------------------------------------------------
def thermo_dict(c1, c2, header=""):
    return f"""{header}recordType    thermophysicalPropertySystem;
schemaVersion 2;

components       ( {c1}  {c2} );

equilibrium
{{
    formulation gammaPhi;

    liquid
    {{
        activityModel
        {{
            model NRTL;
            binaryParameters   // the FIT'S starting point -- see the header
            {{
                {c1}-{c2}
                {{
                    i {c1};
                    j {c2};
                    a_ij 0;
                    b_ij 0;
                    a_ji 0;
                    b_ji 0;
                    alpha 0.30;
                }}
            }}
        }}
        standardState pureLiquid;
    }}

    vapour
    {{
        fugacityModel idealGas;
    }}
}}
"""


def fit_op(name, c1, c2, fits, held, band_pct, origin, start, proposal=None,
           parity="parity.csv", log=None):
    ev = "".join(f"""            {{
                dataset  "{d}";
                role     fit;
            }}
""" for d in fits)
    ev += f"""            {{
                dataset  "{held}";
                role     validation;
            }}
"""
    out = f"            parity     {parity};\n"
    if log:
        out = f"            fit_log    {log};\n" + out
    if proposal:
        out += f"            proposal   {proposal};\n"
    path = f"equilibrium.liquid.activityModel.binaryParameters.{c1}-{c2}"
    return f"""    {{
        name        {name};
        type        fitParameters;

        parameters
        (
            {{ path  {path}.b_ij;  initial {start[0]};  min -3000;  max 3000; }}
            {{ path  {path}.b_ji;  initial {start[1]};  min -3000;  max 3000; }}
        );

        evidence
        (
{ev}        );

        acceptance
        {{
            maxAAD  {band_pct} percent;
            origin  "{origin}";
        }}

        objective {{ method leastSquares; }}
        residual
        {{
            kind        T_bubble;
            components  ( {c1} {c2} );
            weighting   uncertainty;
        }}

        options
        {{
            maxIter      80;
            tolerance    1.0e-6;
            fdStep       1.0e-4;
            lambda0      1.0e-3;
        }}

        output
        {{
{out}        }}
    }}
"""


def run_props(case):
    p = subprocess.run([str(PROPS), "."], cwd=str(case), env=env(),
                       capture_output=True, text=True, timeout=1800)
    out = p.stdout + p.stderr
    m = re.search(r"<<<Choupo:result-begin>>>(.*?)<<<Choupo:result-end>>>", out, re.S)
    js = json.loads(m.group(1)) if m else None
    return p.returncode, out, js


def op_result(js, name):
    for op in (js or {}).get("operationResults", []):
        if op.get("name") == name:
            return op
    return None


def scratch_case(base, c1, c2, ops, files):
    if base.exists():
        shutil.rmtree(base)
    (base / "system").mkdir(parents=True)
    (base / "constant").mkdir()
    (base / "system" / "controlDict").write_text(
        'application choupoProps;\ndescription "choupo-curate scratch";\nverbosity 2;\n')
    (base / "system" / "propsDict").write_text("operations\n(\n" + "".join(ops) + ");\n")
    (base / "constant" / "thermoPhysPropDict").write_text(thermo_dict(c1, c2))
    for rel, src in files.items():
        (base / rel).parent.mkdir(parents=True, exist_ok=True)
        shutil.copy(src, base / rel)
    return base


def pure_bubble_T(work, c1, c2, P_kPa):
    """The ENGINE's bubble T of each pure component at P (the catalogue
    vapour-pressure record, no pair): (T at x1 = 0, T at x1 = 1)."""
    op = f"""    {{
        name        pureEnds;
        type        propertyScan1D;
        vary        {{ variable x[{c1}];  from 0.0;  to 1.0;  n 2; }}
        state       {{ P {P_kPa} kPa;  composition {{ {c1} 0.5;  {c2} 0.5; }} }}
        thermo      {{ equilibrium {{ liquid {{ activityModel {{ model ideal; }} }} }} }}
        properties  ( T_bubble );
        output      {{ file ends.csv; }}
    }}
"""
    case = scratch_case(work / "ends", c1, c2, [op], {})
    rc, out, _ = run_props(case)
    rows = [l.split(",") for l in (case / "ends.csv").read_text().splitlines()
            if l and l[0].isdigit()] if (case / "ends.csv").exists() else []
    if rc != 0 or len(rows) != 2:
        refuse(f"the engine could not compute the pure-component bubble points at "
               f"{P_kPa} kPa (exit {rc}) -- the band cannot be computed: {out[-300:]}")
    hdr = (case / "ends.csv").read_text().splitlines()[0].split(",")
    k = [i for i, h in enumerate(hdr) if h.startswith("T_bubble")][0]
    return float(rows[0][k]), float(rows[1][k])


def round_up_2sf(v):
    e = math.floor(math.log10(v)) - 1
    return math.ceil(round(v / 10 ** e, 9)) * 10 ** e


def fmt_band(v):
    e = math.floor(math.log10(v)) - 1
    return f"{v:.{max(0, -e)}f}"


# --------------------------------------------------------------------------
#  the plan: studies -> triage -> partition -> band
# --------------------------------------------------------------------------
def plan(a, b, pmax, work):
    ca, cb = identity(a), identity(b)
    a, b = ca[0], cb[0]
    if a == b:
        refuse("a pair needs two different components")
    have = existing_records(a, b)
    if have:
        refuse(f"the pair {a} + {b} already has a catalogue record: {', '.join(have)} "
               "-- this tool never overwrites a literature, reviewed or regressed "
               "record; a new regression of it is a curator's decision")
    blocks = blocks_for((ca[2], cb[2]), pmax)
    if not blocks:
        refuse(f"no isobaric bubble-temperature block for {a} + {b} at or below "
               f"{pmax} kPa in the archive index")
    ext = work / "extracts"
    ext.mkdir(parents=True, exist_ok=True)
    studies, aside = [], []
    for r in blocks:
        xml = cache_root() / r["file"]
        tag = f"doi {r['doi']} block {r['block']}"
        if not r["uncertaintyDeclared"]:
            aside.append((tag, "declares no uncertainty"))
            continue
        d = work / f"b{len(studies) + len(aside)}"
        path, why = extract(xml, r["block"], d)
        if path is None:
            aside.append((tag, "extract-vle refused it: " + why))
            continue
        ds = read_dataset(path)
        if ds["U"] is None:
            aside.append((tag, "its uncertainty is partial or not one per point"))
            continue
        if ds["n"] < MIN_INTERIOR:
            aside.append((tag, f"only {ds['n']} interior point(s) (< {MIN_INTERIOR})"))
            continue
        final = ext / path.name
        if final.exists():
            aside.append((tag, f"a second block of the same article ({final.name} "
                          "already taken from it) -- one block per study"))
            continue
        shutil.move(str(path), final)
        studies.append({"doi": r["doi"], "block": r["block"], "file": r["file"],
                        "xml": xml, "path": final, "authors": r["authors"],
                        "sur": surnames(r["authors"]), "year": r.get("year"), **ds})
    if not studies:
        refuse(f"no usable study for {a} + {b}: " +
               "; ".join(f"{t}: {w}" for t, w in aside))
    #  Orientation: the one of the largest usable study.  A study reporting x
    #  of the other component is set aside BY NAME (no reorientation exists).
    studies.sort(key=lambda s: (-s["n"], s["doi"]))
    c1 = studies[0]["x"]
    c2 = b if c1 == a else a
    keep = []
    for s in studies:
        if s["x"] != c1:
            aside.append((f"doi {s['doi']} block {s['block']}",
                          f"reports x of {s['x']}, the others of {c1}; extract-vle has "
                          "no reorientation (C16 section 6.1) and a hand edit of a "
                          "measured file is what the chain exists to prevent"))
        else:
            keep.append(s)
    studies = keep

    #  3. triage, leave one study out, by the engine
    triage = []
    if len(studies) >= 3:
        for k, s in enumerate(studies):
            others = [o for o in studies if o is not s]
            files = {f"data/s{n}.dat": o["path"] for n, o in enumerate(others)}
            files["data/held.dat"] = s["path"]
            op = fit_op("loso", c1, c2, [f"data/s{n}.dat" for n in range(len(others))],
                        "data/held.dat", "100",
                        "triage scratch run -- the band is not used", (0, 0))
            case = scratch_case(work / f"loso{k}", c1, c2, [op], files)
            rc, out, js = run_props(case)
            r = op_result(js, "loso")
            aad = (r or {}).get("diagnostics", {}).get("aad_heldout_K")
            lim = max(s["U"]) + max(max(o["U"]) for o in others)
            if rc != 0 or aad is None:
                triage.append((s, None, lim, "the leave-one-out fit did not run "
                               f"(exit {rc}); the study is KEPT, unjudged"))
                continue
            out_ = aad > lim
            triage.append((s, aad, lim, "DISAGREES -- set aside" if out_ else "agrees"))
        flagged = [t[0] for t in triage if t[3].startswith("DISAGREES")]
        if len(flagged) * 2 > len(studies):
            refuse(f"{len(flagged)} of {len(studies)} studies disagree with the others "
                   "beyond their stated uncertainties -- there is no majority to "
                   "triage against; choosing which laboratory is right is a "
                   "curator's act.  " + triage_text(triage))
        for s in flagged:
            aside.append((f"doi {s['doi']} block {s['block']}",
                          "TRIAGE: disagrees with the other studies beyond their "
                          "stated uncertainties (leave-one-study-out, below)"))
        studies = [s for s in studies if s not in flagged]
    triage_note = (triage_text(triage) if triage else
                   f"NOT RUN: {len(studies)} usable stud{'y' if len(studies) == 1 else 'ies'}; "
                   "with fewer than three the triage cannot say which of two "
                   "disagreeing studies is wrong -- the held-out verdict is then the test")

    #  4. partition
    fit = studies[0]
    held = None
    for s in studies[1:]:
        if s["sur"] & fit["sur"]:
            continue
        if s["isobars"] is not None:
            continue
        held = s
        break
    if held is None:
        refuse(f"no independent held-out study for {c1} + {c2}: the fit set is doi "
               f"{fit['doi']} ({fit['n']} interior points) and no other usable "
               "single-pressure study shares no author with it.  Studies: " +
               "; ".join(f"{s['doi']} ({s['n']} pts, authors {sorted(s['sur'])})"
                         for s in studies[1:]) +
               (". Set aside: " + "; ".join(f"{t}: {w}" for t, w in aside) if aside else ""))

    #  5. band
    Umax = max(held["U"])
    meanT = sum(held["T"]) / len(held["T"])
    errs = []
    if held["pure"]:
        T0, T1 = pure_bubble_T(work, c1, c2, held["P_kPa"])
        for x, Tm in held["pure"]:
            comp, Tmod = (c2, T0) if x == 0 else (c1, T1)
            errs.append((comp, Tmod - Tm))
    eps = max((abs(e) for _, e in errs), default=0.0)
    raw = (Umax + eps) / meanT * 100.0
    band = round_up_2sf(raw)
    if errs:
        ends = ", ".join(f"{c} {e:+.3f} K" for c, e in errs)
    else:
        ends = ("NONE: the held-out study reports no pure-component bubble point, so "
                "the term is ZERO, the strictest reading of the rule -- the band is "
                "the measurement's own uncertainty alone")
    origin = (f"declared before the fit by bin/choupo-curate, the ONE rule of C16: the "
              f"held-out set's largest stated expanded uncertainty (U95 = {Umax:g} K) "
              f"plus the catalogue vapour-pressure model's own error at that set's "
              f"pure endpoints ({ends}; measured with no pair involved), as a "
              f"percentage of the held-out mean T ({meanT:.2f} K) = {raw:.4f} %, "
              f"rounded UP to two significant figures")
    return {"c1": c1, "c2": c2, "ident": {ca[0]: ca, cb[0]: cb},
            "fit": fit, "held": held, "studies": studies, "aside": aside,
            "triage": triage, "triage_note": triage_note, "band": band,
            "band_txt": fmt_band(band), "origin": origin, "ends": errs,
            "Umax": Umax, "meanT": meanT}


def triage_text(triage):
    return "; ".join(
        f"{s['doi']}: AAD {('%.3f K' % aad) if aad is not None else 'n/a'} against "
        f"the limit {lim:.3f} K -> {v}" for s, aad, lim, v in triage)


# --------------------------------------------------------------------------
#  6. the case
# --------------------------------------------------------------------------
def curation_case_dirs():
    """Every curation case in every curation root (C295: the roots are
    curation_roots' to name; a case is found by walking, never by a number)."""
    return curation_roots.all_case_dirs()


def label(case):
    """A case's name in prose: its path under data/curation, origin dropped."""
    return curation_roots.label(case)


def has_unifac(comp):
    p = ROOT / "data" / "standards" / "components" / f"{comp}.dat"
    return p.exists() and re.search(r"^\s*unifac\b", p.read_text(), re.M | re.I) is not None


def wrap(text, width=74, indent="  "):
    out, line = [], indent
    for w in text.split():
        if len(line) + len(w) + 1 > width and line.strip():
            out.append(line.rstrip())
            line = indent
        line += w + " "
    if line.strip():
        out.append(line.rstrip())
    return "\n".join(out)


def decl_text(pl, case_rel):
    fit, held = pl["fit"], pl["held"]
    lines = [
        "/*--------------------------------*- Choupo -*--------------------------------*\\",
        f"  constant/archiveDatasets -- WHERE the measurements of {case_rel.split('/')[-1]}",
        "  come from, and how to regenerate them.  NO MEASURED POINT IS IN THIS TREE",
        "  (Vitor, 2026-11-10: the measured series are not copied; only the fitted",
        "  parameters are kept).  `bin/choupo-curate fetch <case>` writes each",
        f"  dataset into {EXTRACTS}/ (gitignored): the article file is taken from",
        "  the local ThermoML cache when it holds it, else from the NIST URL below,",
        "  and BOTH sha256 sums are checked -- a mismatch refuses, an unreachable",
        "  NIST is reported NOT RUN, never a pass.",
        "\\*-----------------------------------------------------------------------------*/",
        "",
        "recordType    archiveDatasets;",
        "",
        "archive",
        "{",
        f'    tarball   "{ARCHIVE}";',
        f'    doi       "{ARCHIVE_DOI}";',
        '    note      "the finding aid; each article file is also served one by one at the NIST URL";',
        "}",
        "",
        "datasets",
        "(",
    ]
    for role, s in (("fit", fit), ("validation", held)):
        lines += [
            "    {",
            f'        file          "{EXTRACTS}/{s["path"].name}";',
            f"        role          {role};   // informational: the operation declares it",
            f'        doi           "{s["doi"]}";',
            f'        url           "{NIST.format(doi=s["doi"], ext="xml")}";',
            f'        page          "{NIST.format(doi=s["doi"], ext="json")}";',
            f'        articleFile   "{Path(s["file"]).name}";',
            f'        articleSha256 "{sha_file(s["xml"])}";',
            f"        block         {s['block']};",
            "        filter        ( --interior-only );",
            f'        extract       "bin/choupo-thermoml extract-vle <article file> --block {s["block"]} --interior-only --into <dir>";',
            f'        sha256        "{sha_file(s["path"])}";',
            "        identity",
            "        {",
        ]
        for comp in (pl["c1"], pl["c2"]):
            _, cas, key = pl["ident"][comp]
            lines.append(f'            {comp:<14} {{ cas "{cas}"; inchiKey "{key}"; }}')
        lines += ["        }", "    }"]
    lines += [");", ""]
    return "\n".join(lines)


def props_text(pl, case_name, stem, unifac):
    c1, c2 = pl["c1"], pl["c2"]
    fit, held = pl["fit"], pl["held"]
    fpath = f"{EXTRACTS}/{fit['path'].name}"
    hpath = f"{EXTRACTS}/{held['path'].name}"
    Ph = held["P_kPa"]
    Pf = fit["P_kPa"] if fit["isobars"] is None else max(fit["isobars"])
    aside = "\n".join(wrap(f"- {t}: {w}", indent="      ") for t, w in pl["aside"]) \
        or "      (none)"
    fitP = (f"{fit['P_kPa']:g} kPa" if fit["isobars"] is None else
            f"{len(fit['isobars'])} isobars {min(fit['isobars']):g}-{max(fit['isobars']):g} kPa")
    hdr = f"""/*--------------------------------*- Choupo -*--------------------------------*\\
|       \\|/    C hemicals     |  Choupo: open-source, glass-box simulation    |
|      \\\\|//   H eat-transfer |  Version:  Choupo-dev                         |
|     \\\\\\|///  O perations    |  Website:  https://choupo.org                 |
|      \\\\|//   U nits         |  Licence:  GPL-3.0-or-later                   |
|       \\|/    P roperties    |  Tutorial case file -- part of Choupo         |
|        |     O ptimization  |                                               |
\\*-----------------------------------------------------------------------------*/
/*---------------------------------------------------------------------------*\\
  {case_name} -- AN NRTL PAIR FROM PUBLISHED MEASUREMENTS, BY THE PIPELINE.

  WRITTEN BY bin/choupo-curate pair {c1} {c2} (DEV.md 4c C282; record
  docs/design/binary-pairs-from-open-measurements.md section 8).  Every rule
  below was decided before this tool existed (C16, C225, C226); the tool
  applies them and decides nothing.

  THE DECLARATION -- WRITTEN AND COMMITTED BEFORE ANY FIT RAN.
  (C16 slice 2: so the declaration can be read against the result.)

  IDENTITY.  {c1} (CAS {pl['ident'][c1][1]}, InChIKey {pl['ident'][c1][2]})
  + {c2} (CAS {pl['ident'][c2][1]}, InChIKey {pl['ident'][c2][2]}), joined
  to the archive through identity.json -- never by name.

  NO MEASURED SERIES IN THIS TREE.  constant/archiveDatasets names each
  dataset (DOI, NIST URL, article sha256, extraction selector, extract
  sha256); `bin/choupo-curate fetch` writes the points into
  {EXTRACTS}/, which is gitignored.

  STUDIES CONSIDERED: every bubble-temperature block of the pair at or below
  110 kPa with a declared uncertainty ({len(pl['studies']) + len(pl['aside'])} block(s)).
  USABLE after the screens: {len(pl['studies'])}.  SET ASIDE, BY NAME:
{aside}

  TRIAGE (C226 item 3, leave one study out, fitted by the engine; a study
  whose held-out AAD exceeds its own largest stated U plus the others'
  largest stated U disagrees with them beyond their stated uncertainties):
{wrap(pl['triage_note'], indent="      ")}

  PARTITION (the declared rule of C16 slice 2): the FIT set is the usable
  study with the most interior points; the HELD-OUT set is the next largest
  that shares NO author with it and was measured at one pressure.
    FIT       doi {fit['doi']} ({fit['n']} interior points, {fitP})
              authors: {'; '.join(fit['authors'][:6])}
    HELD OUT  doi {held['doi']} ({held['n']} interior points, {Ph:g} kPa)
              authors: {'; '.join(held['authors'][:6])}

  BAND: maxAAD {pl['band_txt']} % of the held-out mean T.
{wrap(pl['origin'], indent="      ")}

  THE FIT.  NRTL with a_ij = a_ji = 0 and alpha = 0.30 fixed: TWO parameters
  (b_ij, b_ji), the C16 frame (bubble temperatures over these ranges do not
  identify more).  Each point weighted by 1/U, U its own stated expanded
  uncertainty.  Two starts: (0, 0) and (800, -400).

  @@RESULT-BEGIN@@
  WHAT THE RUN FOUND: not yet run.
  @@RESULT-END@@

  WHAT IS NOT CLAIMED.  The pair is correct at these pressures and in this
  frame (ideal-gas vapour, the catalogue's own vapour-pressure records); the
  measurements were transcribed by the archive and have NOT been read back
  against the articles (the CHECKLIST that `fetch` writes beside the extracts
  is the aid for that reading).
\\*---------------------------------------------------------------------------*/

operations
(
"""
    body = fit_op("fit_nrtl", c1, c2, [fpath], hpath, pl["band_txt"], pl["origin"],
                  (0, 0), proposal=f"{stem}.proposal.dat", parity="parity.csv",
                  log="fit_history.csv")
    body += fit_op("fit_nrtl_start2", c1, c2, [fpath], hpath, pl["band_txt"],
                   pl["origin"], (800, -400), parity="parity_start2.csv")
    models = ["ideal"] + (["UNIFAC"] if unifac else []) + ["NRTL"]

    def scans(P, sfx):
        s = ""
        for m in models:
            th = ("model NRTL; /* no inline pair: the case's own record */"
                  if m == "NRTL" else f"model {m};")
            s += f"""    {{
        name        txy_{m.lower()}{sfx};
        type        propertyScan1D;
        vary        {{ variable x[{c1}];  from 0.0;  to 1.0;  n 101; }}
        state       {{ P {P:g} kPa;  composition {{ {c1} 0.5;  {c2} 0.5; }} }}
        thermo
        {{
            equilibrium {{ liquid {{ activityModel {{ {th} }} }} }}
        }}
        properties  ( T_bubble  y_eq_{c1} );
        output      {{ file txy_{m.lower()}{sfx}.csv; }}
    }}
"""
        return s
    body += scans(Ph, "")
    if fit["isobars"] is None:
        body += scans(Pf, "_fitP")
    body += ");\n\nexperimental\n(\n"
    body += f"""    {{
        name      heldout;
        component {c1};
        kind      txy;
        models    ( {'  '.join('txy_' + m.lower() for m in models)} );
        dataset   "{hpath}";
        source    "held out: doi {held['doi']}";
    }}
"""
    if fit["isobars"] is None:
        body += f"""    {{
        name      fitset;
        component {c1};
        kind      txy;
        models    ( {'  '.join('txy_' + m.lower() + '_fitP' for m in models)} );
        dataset   "{fpath}";
        source    "IN-SAMPLE (the fit set): doi {fit['doi']}";
    }}
"""
    body += ");\n"
    return hdr + body


def write_case(pl, kind="Tx"):
    c1, c2 = pl["c1"], pl["c2"]
    try:
        case = curation_roots.new_pair_case_dir(c1, c2, kind)
    except FileExistsError as ex:
        refuse(str(ex))
    name = label(case)
    stem = "-".join(sorted((c1, c2)))   # the loader opens the ALPHABETICAL name (NRTL.cpp alphaPairFilename)
    (case / "system").mkdir(parents=True)
    (case / "constant").mkdir()
    (case / f"{case.name}.cho").write_text("")
    (case / "system" / "controlDict").write_text(f"""/*  {name}: an NRTL pair for {c1} + {c2} regressed by bin/choupo-curate to
    MEASURED bubble temperatures from one article and scored on another it
    never saw.  See system/propsDict for the declaration and the result.  */

application   choupoProps;
description   "NRTL {c1}-{c2} regressed by the curation pipeline to measured bubble temperatures (ThermoML locates, the article sources), held out against an independent study";
verbosity     2;
""")
    hdr = f"""/*---------------------------------------------------------------------------*\\
  {name} -- the thermophysical system: gamma-phi at LOW PRESSURE.
    * vapour: IDEAL GAS (fugacity coefficient 1, no Poynting term);
    * pure components: the catalogue's own vapour-pressure records, UNCHANGED
      (their error at the held-out endpoints is in the band's origin);
    * liquid: NRTL, tau_ij = a_ij + b_ij/T, alpha 0.30 FIXED.
  The inline pair is the FIT'S STARTING POINT (zero = ideal mixing); the
  regressed pair is the record under constant/parameters/NRTL/ (or, once
  promoted, the catalogue's, sealed into this case), read by the scans.
\\*---------------------------------------------------------------------------*/

"""
    (case / "constant" / "thermoPhysPropDict").write_text(thermo_dict(c1, c2, hdr))
    (case / "constant" / "archiveDatasets").write_text(
        decl_text(pl, case.relative_to(ROOT).as_posix()))
    unifac = has_unifac(c1) and has_unifac(c2)
    (case / "system" / "propsDict").write_text(props_text(pl, name, stem, unifac))
    ex = case / EXTRACTS
    ex.mkdir(parents=True)
    for s in (pl["fit"], pl["held"]):
        shutil.copy(s["path"], ex / s["path"].name)
    return case, stem


# --------------------------------------------------------------------------
#  7. fetch
# --------------------------------------------------------------------------
def parse_decl(case):
    f = case / DECL
    if not f.exists():
        return None
    t = crp.strip_comments(f.read_text())
    m = re.search(r"datasets\s*\((.*)\)\s*;", t, re.S)
    out = []
    depth, start = 0, None
    body = m.group(1) if m else ""
    for k, ch in enumerate(body):
        if ch == "{":
            if depth == 0:
                start = k
            depth += 1
        elif ch == "}":
            depth -= 1
            if depth == 0:
                d = body[start + 1:k]
                ident = {}
                for im in re.finditer(r"(\S+)\s*\{\s*cas\s+\"([^\"]+)\";\s*inchiKey\s+\"([^\"]+)\";\s*\}", d):
                    ident[im.group(1)] = (im.group(2), im.group(3))
                out.append({k2: crp.word(d, k2) for k2 in
                            ("file", "doi", "url", "articleFile", "articleSha256",
                             "block", "sha256", "role", "extractor", "inchiKey", "xOf")} | {"identity": ident})
    return out


def fetch(case, quiet=False):
    """0 = every extract present and verified; 1 = refused (a mismatch);
    2 = NOT RUN (the article is neither cached nor reachable)."""
    decl = parse_decl(case)
    if decl is None:
        say(f"choupo-curate fetch: {case} declares no {DECL}")
        return 1
    tmp = Path(tempfile.mkdtemp(prefix="choupo-curate-fetch-"))
    try:
        for d in decl:
            dest = case / d["file"]
            if dest.exists() and sha_file(dest) == d["sha256"]:
                continue
            src = cache_root() / (d["doi"] + ".xml")
            if src.exists():
                how = "local cache"
            else:
                src = tmp / "article" / d["doi"] / d["articleFile"]
                src = src.parent / d["articleFile"]
                src.parent.mkdir(parents=True, exist_ok=True)
                try:
                    #  A generic client name: NIST refuses the library's
                    #  default agent (measured, HTTP 403), and no personal
                    #  detail goes to an outside service.
                    req = urllib.request.Request(
                        d["url"], headers={"User-Agent": "choupo-curate"})
                    with urllib.request.urlopen(req, timeout=60) as r:
                        src.write_bytes(r.read())
                except Exception as ex:   # noqa: BLE001 -- any network failure
                    say(f"choupo-curate fetch: NOT RUN -- NIST ThermoML unreachable "
                        f"for doi {d['doi']} ({d['url']}: {ex}); regenerate with "
                        f"`bin/choupo-curate fetch {case}` where the network or "
                        "the archive cache (bin/choupo-thermoml sync) is present")
                    return 2
                how = "NIST URL"
            got = sha_file(src)
            if got != d["articleSha256"]:
                say(f"choupo-curate fetch: REFUSED -- the article file of doi {d['doi']} "
                    f"({how}) has sha256 {got}, the case declares {d['articleSha256']}: "
                    "it is not the file the fit was declared on")
                return 1
            #  A private cache holding ONLY the two identities this case
            #  declares: the join is the declaration's, never a name.
            fake = tmp / "cache"
            fake.mkdir(exist_ok=True)
            recs = [{"component": c, "cas": cas, "inchiKey": key, "status": "resolved"}
                    for c, (cas, key) in d["identity"].items()]
            (fake / "identity.json").write_text(json.dumps(
                {"records": recs,
                 "byInchiKey": {r["inchiKey"]: [r["component"]] for r in recs}}))
            if src.name != d["articleFile"]:
                refuse(f"article file name {src.name} != {d['articleFile']}")
            #  WHICH EXTRACTOR is declared, never guessed: a pure-component
            #  vapour-pressure dataset (C281) names `extractor vapourPressure`
            #  and the InChIKey it is joined on; a binary bubble-point dataset
            #  (C282) declares none and its block.
            if d.get("extractor") == "vapourPressure":
                out, why = extract_vp(src, d["inchiKey"], tmp / "x", fake_cache=fake)
                what = f"extract-vp refused doi {d['doi']} ({d['inchiKey']})"
            elif d.get("extractor") == "bubblePressure":
                out, why = extract_px(src, d["block"], tmp / "x", fake_cache=fake,
                                      x_of=d.get("xOf"))
                what = f"extract-px refused doi {d['doi']} block {d['block']}"
            elif d.get("extractor"):
                refuse(f"{label(case)}: dataset of doi {d['doi']} declares extractor "
                       f"`{d['extractor']}`, which this tool does not know")
            else:
                out, why = extract(src, d["block"], tmp / "x", fake_cache=fake,
                                   x_of=d.get("xOf"))
                what = f"extract-vle refused doi {d['doi']} block {d['block']}"
            if out is None:
                say(f"choupo-curate fetch: REFUSED -- {what}: {why}")
                return 1
            got = sha_file(out)
            if got != d["sha256"]:
                say(f"choupo-curate fetch: REFUSED -- the extract of doi {d['doi']} has "
                    f"sha256 {got}, the case declares {d['sha256']}: the extractor or "
                    "the article changed since the declaration")
                return 1
            dest.parent.mkdir(parents=True, exist_ok=True)
            shutil.move(str(out), dest)
            if not quiet:
                say(f"choupo-curate fetch: {dest.relative_to(case)}  ({how}, both "
                    "sha256 verified)")
        write_checklist(case, decl)
        return 0
    finally:
        shutil.rmtree(tmp, ignore_errors=True)


def write_checklist(case, decl):
    """C226: the extracted table beside each DOI, so a reviewer can confirm
    it against the article in minutes.  Beside the extracts, gitignored."""
    lines = ["CHECKLIST -- read each table against its article, then mark the",
             "dataset `reviewStatus checked` in a curator's act.  Generated by",
             "bin/choupo-curate fetch; NOT tracked (it carries measured points).", ""]
    for d in decl:
        p = case / d["file"]
        t = p.read_text()
        cit = crp.word(crp.block(t, "provenance") or "", "citation") or ""
        lines += ["=" * 74, f"doi {d['doi']}" + (f"   block {d['block']}" if d.get('block') else ""),
                  f"article  https://doi.org/{d['doi']}", f"citation {cit}",
                  f"NIST     {d['url']}", "-" * 74]
        dd = t[t.index("\ncolumns"):]
        lines += [l for l in dd.splitlines() if l.strip()]
        lines.append("")
    (case / EXTRACTS / "CHECKLIST.txt").write_text("\n".join(lines))


# --------------------------------------------------------------------------
#  8. run, record, seal
# --------------------------------------------------------------------------
def record_header(stem, c1, c2, case_rel, reason_line, extra=""):
    return f"""/*---------------------------------------------------------------------------*\\
  NRTL binary interaction parameters --- {c1}(i) + {c2}(j)

  REGRESSED BY CHOUPO'S CURATION PIPELINE (bin/choupo-curate, DEV.md 4c C282;
  record docs/design/binary-pairs-from-open-measurements.md) to measured
  bubble temperatures.  The two articles named under `evidence` are the
  SOURCE of the measurements; the NIST/TRC ThermoML Archive located them.
  NO MEASURED POINT IS IN THIS RECORD OR THIS TREE: the case regenerates
  them from the DOIs and sha256 sums it declares (constant/archiveDatasets).
  The PARAMETERS are Choupo's own work.

  EQUATION: tau_ij = a_ij + b_ij / T [b in K], G_ij = exp(-alpha tau_ij),
  Renon & Prausnitz direction (src/thermo/activityCoefficient/NRTL.cpp).
  a_ij = a_ji = 0 and alpha = 0.30 FIXED, not fitted.
  FRAME: ideal-gas vapour, no Poynting term, the catalogue's own
  vapour-pressure records for both pure components.

  {reason_line}
{extra}
  REPRODUCE: run {case_rel} (after `bin/choupo-curate fetch` on it); its fit
  writes {stem}.proposal.dat, which bin/curate/check_regressed_pairs.py holds
  equal to this record.
\\*---------------------------------------------------------------------------*/

recordType binaryInteractionParameters;
schemaVersion 1;

pair {{ i {c1}; j {c2}; }}

"""


def body_of(text):
    """The record from its `components ( ... );` line on -- the first line of
    DATA, never the word in a header's prose."""
    return text[re.search(r"^components\s*\(", text, re.M).start():]


def record_from_proposal(prop_text, header, fields):
    body = body_of(prop_text)
    ins = "".join(f"    {k:<13} {v};\n" for k, v in fields)
    body = re.sub(r"(\n    fitDate )", "\n" + ins.rstrip("\n") + r"\1", body, count=1)
    return header + body


def case_record_fields(case_rel):
    return [("fittedInCase", f'"{case_rel}"'),
            ("reviewStatus", "interim"),
            ("reviewReason", '"regressed by bin/choupo-curate from archive-transcribed '
                             'measurements; not yet read back against the articles"'),
            ("reuse", '"Choupo\'s own regression; the measured points belong to the '
                      'cited articles and are not reproduced in this record or this tree"')]


def stability(rec_text, tag):
    rf = crp.facts(rec_text)
    return rf, crp.one_liquid_failures(rf, tag)


def run_pipeline(case, stem, pl, commit):
    case_rel = case.relative_to(ROOT).as_posix()
    c1, c2 = pl["c1"], pl["c2"]
    if commit:
        files = [p for p in case.rglob("*") if p.is_file()
                 and EXTRACTS not in p.relative_to(case).as_posix()]
        git(["add", "--"] + [str(p) for p in files])
        git(["commit", "-q", "-m",
             f"C282: {label(case)} -- the declaration, before any fit\n\n"
             f"bin/choupo-curate pair {c1} {c2}: partition (fit doi {pl['fit']['doi']}, "
             f"held out doi {pl['held']['doi']}), triage and band maxAAD "
             f"{pl['band_txt']} % written before the fit runs, so it can be read "
             "against the result (C16 slice 2)."])
        say(f"  committed the declaration: {git(['rev-parse', '--short', 'HEAD']).strip()}")
    rc = fetch(case, quiet=True)
    if rc:
        refuse(f"fetch of {case_rel} returned {rc}")
    #  The fit alone first: the NRTL scans read the record the fit produces.
    work = Path(tempfile.mkdtemp(prefix="choupo-curate-fit-"))
    try:
        sc = work / case.name
        shutil.copytree(case, sc)
        t = (sc / "system" / "propsDict").read_text()
        t = t[:t.index("    {\n        name        txy_")] + ");\n"
        (sc / "system" / "propsDict").write_text(t)
        rc, out, js = run_props(sc)
        prop = sc / f"{stem}.proposal.dat"
        if rc != 0 or not prop.exists():
            refuse(f"the fit of {case_rel} exited {rc} / wrote no proposal: {out[-600:]}")
        ptext = prop.read_text()
    finally:
        shutil.rmtree(work, ignore_errors=True)
    rf, split = stability(ptext, stem)
    verdict = rf["verdict"]
    if split:
        reason = ("NOT PROMOTABLE: the pair splits ONE liquid inside its own validity "
                  "span (check_regressed_pairs arm f) -- " + split[0].split(": ", 1)[1])
    elif verdict != "validated":
        reason = (f"NOT PROMOTABLE: held-out verdict {verdict} (AAD {rf['aad_pct']} % "
                  f"against the band {rf['maxAAD']} % declared before the fit)")
    else:
        reason = ("PROMOTABLE by `bin/choupo-curate pair ... --promote`: verdict "
                  "validated, one liquid across the validity span, triage "
                  + ("run" if pl.get("triage") else "not run (fewer than three studies)"))
    hdr = record_header(stem, c1, c2, case_rel,
                        "reviewStatus interim: a case-local record, regressed and "
                        "not read back.",
                        wrap(reason, indent="  ") + "\n")
    rec = record_from_proposal(ptext, hdr, case_record_fields(case_rel))
    rp = case / "constant" / "parameters" / "NRTL" / f"{stem}.dat"
    rp.parent.mkdir(parents=True, exist_ok=True)
    rp.write_text(rec)
    seal(case)
    rc, out, js = run_props(case)
    if rc != 0:
        refuse(f"the sealed case {case_rel} exited {rc}: {out[-600:]}")
    fill_result(case, js, rf, reason, pl)
    return rf, split, reason


def seal(case):
    p = subprocess.run([sys.executable, "-I", str(IMPORT), str(case)],
                       capture_output=True, text=True, env=env(), timeout=1800)
    if p.returncode != 0:
        refuse(f"bin/choupo-import {label(case)} exited {p.returncode}: "
               f"{(lambda o: o if len(o) <= 1600 else o[:800] + ' [...] ' + o[-800:])(p.stdout + p.stderr)}")


def fill_result(case, js, rf, reason, pl):
    f1 = op_result(js, "fit_nrtl") or {}
    f2 = op_result(js, "fit_nrtl_start2") or {}
    d1, d2 = f1.get("diagnostics", {}), f2.get("diagnostics", {})
    keys = [k for k in d1 if k.endswith(".b_ij") or k.endswith(".b_ji")]
    b1 = [d1[k] for k in sorted(keys)]
    b2 = [d2.get(k) for k in sorted(keys)]
    same = all(x is not None and abs(x - y) <= 1e-3 * max(1, abs(y))
               for x, y in zip(b2, b1))
    aad = rf["aad_pct"]
    txt = (f"WHAT THE RUN FOUND (pinned in `expected`; measured, not argued).  "
           f"fit_nrtl: b_ij = {b1[0]:.1f} K, b_ji = {b1[1]:.1f} K, in-sample rms "
           f"{d1.get('rms', float('nan')):.3f} K over {int(d1.get('n_data', 0))} points; "
           f"fit_nrtl_start2 lands on {'the same pair' if same else 'A DIFFERENT pair'} "
           f"({b2[0]:.1f}, {b2[1]:.1f}).  HELD OUT: AAD "
           f"{d1.get('aad_heldout_K', float('nan')):.3f} K ({aad:.4f} %) against the "
           f"band {rf['maxAAD']:g} % -> {rf['verdict']}.  {reason}")
    p = case / "system" / "propsDict"
    t = p.read_text()
    t = re.sub(r"@@RESULT-BEGIN@@.*?@@RESULT-END@@",
               "@@RESULT-BEGIN@@\n" + wrap(txt) + "\n  @@RESULT-END@@", t, flags=re.S)
    p.write_text(t)


def mark_result(case, old, new):
    """Rewrite one phrase of the RESULT paragraph of the case header, and
    re-wrap it (the paragraph is prose; whitespace carries nothing)."""
    pd = case / "system" / "propsDict"
    x = pd.read_text()
    m = re.search(r"@@RESULT-BEGIN@@(.*?)@@RESULT-END@@", x, re.S)
    para = " ".join(m.group(1).split())
    if old not in para:
        return
    para = para.replace(old, new, 1)
    pd.write_text(x[:m.start()] + "@@RESULT-BEGIN@@\n" + wrap(para) + "\n  @@RESULT-END@@"
                  + x[m.end():])


def git(args):
    p = subprocess.run(["git"] + args, cwd=str(ROOT), capture_output=True, text=True)
    if p.returncode != 0:
        refuse(f"git {' '.join(args[:2])} failed: {p.stderr[-400:]}")
    return p.stdout


# --------------------------------------------------------------------------
#  9. promotion and its revert
# --------------------------------------------------------------------------
def find_case(c1, c2):
    """The pair's case written by this tool (a pair with two cases: the one
    the record names, `Tx`, is preferred)."""
    stem = curation_roots.pair_stem(c1, c2)
    found = [p for p, a, b in curation_roots.pair_cases()
             if curation_roots.pair_stem(a, b) == stem and (p / DECL).exists()]
    found.sort(key=lambda p: (p.name != "Tx", p.name))
    return found[0] if found else None


def promote(a, b):
    a, b = identity(a)[0], identity(b)[0]
    case = find_case(a, b)
    if case is None:
        refuse(f"no case written by this tool for {a} + {b} -- run "
               f"`bin/choupo-curate pair {a} {b}` first")
    recs = list((case / "constant" / "parameters" / "NRTL").glob("*.dat"))
    if len(recs) != 1:
        refuse(f"{label(case)} carries {len(recs)} NRTL records; expected its one")
    rp = recs[0]
    text = rp.read_text()
    have = existing_records(a, b, model="NRTL")
    if have:
        refuse(f"a catalogue record for {a} + {b} already exists ({', '.join(have)}) "
               "-- never overwritten")
    rf, split = stability(text, rp.stem)
    if rf["verdict"] != "validated":
        refuse(f"{rp.stem}: verdict `{rf['verdict']}` -- only a `validated` fit is "
               "promoted (C225)")
    if split:
        refuse(f"{rp.stem}: " + split[0])
    decl = (case / "system" / "propsDict").read_text()
    tri = re.search(r"TRIAGE \(C226.*?\n\n", decl, re.S)
    if tri is None or "NOT RUN" in tri.group(0):
        refuse(f"{label(case)}: the study triage of C226 item 3 did not run (fewer than "
               "three usable studies, or no triage declared) -- it is a condition of "
               "AUTOMATIC promotion; a human may still promote by the C16 route")
    case_rel = case.relative_to(ROOT).as_posix()
    hdr = record_header(
        rp.stem, rf["i"], rf["j"], case_rel,
        "reviewStatus autoPromoted; review { by none; }: PROMOTED AUTOMATICALLY by\n"
        "  its fitting pipeline (verdict validated against a band declared before the\n"
        "  fit, one liquid across its validity span, study triage run), and NO HUMAN\n"
        "  HAS REVIEWED IT.  The engine says so on every run that reads it.  A\n"
        "  curator who reads the series back against the articles records it in\n"
        "  the `review {}` block (DEV.md 4c C297).  Revert with\n"
        f"  `bin/choupo-curate revert {rp.stem}`.")
    body = body_of(text)
    body = re.sub(r"(\n    reviewStatus\s+)interim;",
                  r"\1autoPromoted;\n" + REVIEW_NONE +
                  f'    promotedBy    "{PROMOTED_BY}";\n'
                  f'    promotedDate  "{date.today().isoformat()}";', body, count=1)
    dest = STD_NRTL / f"{rp.stem}.dat"
    if dest.exists():
        refuse(f"{dest.relative_to(ROOT)} exists -- never overwritten")
    #  Transactional: the catalogue record and the case's re-seal land
    #  together, or neither does.
    dest.write_text(hdr + body)
    rp.unlink()
    try:
        seal(case)
    except SystemExit:
        dest.unlink()
        rp.write_text(text)
        seal(case)
        raise
    mark_result(case, "PROMOTABLE by `bin/choupo-curate pair ... --promote`:",
                f"PROMOTED on {date.today().isoformat()} into "
                f"{dest.relative_to(ROOT).as_posix()} as reviewStatus autoPromoted, "
                "review by none, because:")
    mark_result(case, "(and since REVERTED by `choupo-curate revert`)",
                "(REVERTED by `choupo-curate revert`, then promoted again on "
                f"{date.today().isoformat()})")
    say(f"choupo-curate: PROMOTED {dest.relative_to(ROOT)} (autoPromoted, "
        f"review by none); {label(case)} re-sealed on it")
    return 0


def revert(stem):
    dest = STD_NRTL / f"{stem}.dat"
    if not dest.exists():
        refuse(f"no catalogue record {dest.relative_to(ROOT)}")
    t = crp.strip_comments(dest.read_text())
    if crp.word(t, "reviewStatus") != "autoPromoted" or \
            crp.word(t, "promotedBy") != PROMOTED_BY:
        refuse(f"{dest.relative_to(ROOT)} was not promoted by this tool (reviewStatus "
               f"{crp.word(t, 'reviewStatus')}, promotedBy {crp.word(t, 'promotedBy')}) "
               "-- revert removes ONLY a record this tool promoted")
    case = ROOT / crp.word(t, "fittedInCase")
    text = dest.read_text()
    rp = case / "constant" / "parameters" / "NRTL" / f"{stem}.dat"
    rf = crp.facts(text)
    hdr = record_header(stem, rf["i"], rf["j"], case.relative_to(ROOT).as_posix(),
                        "reviewStatus interim: a case-local record (its automatic "
                        "promotion was REVERTED).")
    body = body_of(text)
    body = re.sub(r"\n    humanReviewed[^\n]*|\n    review +\{[^\n]*|\n    promotedBy[^\n]*"
                  r"|\n    promotedDate[^\n]*",
                  "", body)
    body = re.sub(r"(\n    reviewStatus\s+)autoPromoted;", r"\1interim;", body, count=1)
    old_case = rp.read_text() if rp.exists() else None
    #  The case's sealed copy is REPLACED by the case-local record and taken
    #  out of the importer's ownership (`--adopt-local`), then the catalogue
    #  record goes; on any failure both are put back.
    dest.unlink()
    rp.parent.mkdir(parents=True, exist_ok=True)
    rp.write_text(hdr + body)
    man = case / "constant" / "propertyManifest"
    old_man = man.read_text() if man.exists() else None
    if old_man is not None:
        #  The importer's rule 4 asks for exactly this by hand: the claim on
        #  the sealed copy is removed, so the file becomes an AUTHORED record
        #  (curate12's shape) rather than an edited import.
        key = f'"parameters/NRTL/{stem}.dat"'
        k = old_man.find(key)
        if k >= 0:
            b = old_man.index("{", k)
            depth, n = 0, b
            for n in range(b, len(old_man)):
                depth += {"{": 1, "}": -1}.get(old_man[n], 0)
                if depth == 0:
                    break
            ls = old_man.rfind("\n", 0, k)
            man.write_text(old_man[:ls] + old_man[n + 1:])
    p = subprocess.run([sys.executable, "-I", str(IMPORT), str(case)],
                       capture_output=True, text=True, env=env(), timeout=1800)
    if p.returncode != 0:
        dest.write_text(text)
        if old_case is not None:
            rp.write_text(old_case)
        if old_man is not None:
            man.write_text(old_man)
        refuse(f"bin/choupo-import on {label(case)} exited "
               f"{p.returncode}; nothing reverted: {(p.stdout + p.stderr)[-600:]}")
    mark_result(case, "PROMOTED on", "PROMOTED (and since REVERTED by `choupo-curate "
                "revert`) on")
    say(f"choupo-curate: REVERTED {dest.relative_to(ROOT)}; the record is case-local "
        f"again in {label(case)}")
    return 0


# --------------------------------------------------------------------------

# ==========================================================================
#  THE PURE-COMPONENT VAPOUR-PRESSURE MODE (DEV.md 4c C281 step 2)
#
#      choupo-curate vp <component> [--plan] [--no-commit] [--resume]
#      choupo-curate vp <component> --promote
#      choupo-curate revert <component>     (a vapour pressure this mode promoted)
#
#  The same decided rules as `pair`, applied to ONE compound's vapour
#  pressure, and nothing new decided:
#
#    1. IDENTITY by InChIKey (identity.json), never by name.  Only a record
#       whose vaporPressure is `model AmbroseWalton` is a candidate: this
#       mode replaces a corresponding-states ESTIMATE and never overwrites a
#       curve somebody fitted or read.
#    2. STUDIES: one per ARTICLE (the archive's file), each extracted by
#       `choupo-thermoml extract-vp` (the C279 audit's reading of a pure
#       liquid-gas vapour-pressure point).  SET ASIDE BY NAME: an article with
#       no pressure row, one whose pressure rows do not ALL state an
#       uncertainty, one with fewer than MIN_INTERIOR points.
#    3. PARTITION (C16 slice 2, declared rule): FIT = the study with the most
#       points (ties by DOI); HELD OUT = the next largest sharing NO author
#       with it.  None -> no fit, and the record keeps AmbroseWalton.
#    4. BAND: the held-out study's own stated relative expanded uncertainty
#       U95(P)/P AVERAGED over its points, in per cent, rounded UP to two
#       significant figures.  NOT the largest (C16's rule for a pair): a
#       pair's U is in kelvin and nearly uniform along a series, a vapour
#       pressure's RELATIVE U spans orders of magnitude along one (the
#       lowest-pressure point sets the maximum and says nothing about the
#       rest), and the statistic it is held to -- the held-out AAD -- is a
#       mean.  Nothing else enters it: there is no pair and no endpoint.
#    5. THE NORMAL BOILING POINT (rule 4 of the commission): where the
#       record's Tb lies OUTSIDE every measured temperature (fit and held
#       out), the fitted Antoine is an extrapolation there, and it is
#       promoted only if its own normal boiling point (P = 101.325 kPa) lies
#       within TB_TOL_K of the record's Tb.  Inside the measured span the
#       held-out verdict is the test.  Declared in the case before the fit.
#    6. CASE data/curation/components/<component>, the declaration COMMITTED before any
#       fit; no measured series in the tree (constant/archiveDatasets, as
#       `pair`).  Not sealed: the fit reads no catalogue record, and the
#       run must read the CATALOGUE record so it can voice its status.
#    7. PROMOTION (`--promote`) -- THE DEFAULT ACCEPTANCE OF DEV.md 4c C283
#       (Vitor, 2026-11-10: "isto nao e ciencia exata ... Por default um erro
#       relativo de 5% chega e sobra! E um erro inferior a 1 grau K
#       tambem!"; it REPLACES the band rule of items 4-5 as the test).  A fit
#       is ACCEPTED when its MAXIMUM relative error in P on the held-out
#       measurements is <= 5 %, and -- where the record's Tb lies OUTSIDE the
#       FIT study's range -- its normal boiling point is within 1 K of Tb
#       (absolute); outside either the gap is announced and the fit is not
#       promoted.  GRADED SINCE DEV.md 4c C285 (Vitor, 2026-11-10: "mete
#       mesmo as que estao acima de 5%"): the max relative P error over the
#       kept points is clean <= 5 %, warning <= 10 %, severe <= 20 %, refused
#       above; where Tb lies outside the kept range, |Tnb - Tb| is clean
#       <= 1 K, warning <= 2 K, severe <= 4 K, refused above; the grade is
#       the WORSE of the two, every grade but refused is promoted, and the
#       record carries `fitGrade <grade>;` with the deciding numbers
#       (`fitGradeMaxRelativeError_pct`, `fitGradeBoilingPointGap_K`), which
#       the component loader voices.  A case may declare another acceptance
#       in `system/curationDict` (`acceptance { maxRelativeError (<clean>
#       <warning> <severe>) percent; maxTemperatureError (<c> <w> <s>) K;
#       reason "..."; }`, a reason REQUIRED); with none the default is used
#       and SAID so in the run and the result.  The
#       band of item 4 is kept as INFORMATION (`bandVerdict`); both errors
#       (the fit and the AmbroseWalton curve it replaces, mean and max, on the
#       held-out points) are written in the record's provenance.  When it holds: the AmbroseWalton block is REPLACED by the fitted
#       Antoine (Trange = the fit's own span; outside it the engine announces
#       the extrapolation, as for every Antoine), the per-value provenance
#       entry names the DOIs, the case and the verdict, and is marked
#       `reviewStatus autoPromoted;` with `review { by none; }` (C300) -- voiced on every
#       run by the component loader (src/thermo/Database.cpp).  `revert
#       <component>` puts the AmbroseWalton block back, and only on a record
#       this mode promoted.
#
#    8. THE FIT WINDOW (DEV.md 4c C367): `system/curationDict` may declare
#       `fitWindow { pressureMax <x> <unit>; pressureMin <x> <unit>; reason
#       "..."; }` (a reason REQUIRED, at least one limit).  Only the points
#       whose pressure lies inside are FITTED (the engine's `window` block of
#       vaporPressureFit, written into the case's propsDict by `--redeclare`,
#       committed before the fit); the others are LEFT OUT BY NAME and their
#       error against the fitted curve is REPORTED beside the fit's.  The
#       grade is computed on the fitted points; the record's Trange is the
#       window actually fitted, so the engine's out-of-range announcement
#       speaks beyond it; the record's provenance states the window, its
#       reason, and the left-out points and their error.  Without the block
#       every output is byte-identical to what it was before C367.
#
#  WHAT IT DOES NOT DO: a study triage (C226 item 3 is the PAIR pipeline's;
#  here a disagreeing held-out study simply fails the verdict and nothing is
#  promoted); fit any form but the three-parameter Antoine of
#  src/propertyOps/VaporPressureFit.cpp; read the articles back.
# ==========================================================================
VP_PROMOTED_BY = "bin/choupo-curate vp --promote"
TB_TOL_K = 2.0      # step 2's normal-boiling-point tolerance (superseded)
#  THE GRADED ACCEPTANCE (DEV.md 4c C285, Vitor 2026-11-10: "mete mesmo as que
#  estao acima de 5%. Mas acima de 5% - 10% mete um warning, e entre 10 a 20%
#  poe um warning mais severo. Acima de 20% descarta").  Each list is the
#  upper limit of clean, warning and severe; above the last, refused.  The
#  temperature limits are the stated default "same factors" of the ruling.
VP_ACCEPT_DEFAULT = {"maxRel": (5.0, 10.0, 20.0), "maxT": (1.0, 2.0, 4.0), "reason": None}
VP_GRADES = ("clean", "warning", "severe", "refused")
VP_CURATION_DICT = "system/curationDict"
VP_RULE_MARK = "FIT AND GRADED ACCEPTANCE (DEV.md 4c C285"
VP_RULE_MARK_C283 = "FIT AND ACCEPTANCE (DEV.md 4c C283"   # the superseded declaration
VP_OUTLIER_PCT = 15.0   # C283 amended: three times the 5 % acceptance
STD_COMP = ROOT / "data" / "standards" / "components"
AW_BLOCK = ("vaporPressure\n{\n    model AmbroseWalton;  "
            "// [origin=estimated method=Ambrose-Walton]\n}\n")
AW_BANNER = ("  Critical constants are source data; Psat is an explicitly\n"
             "  estimated Ambrose-Walton corresponding-states closure.\n")
AW_PROV = ("    vaporPressure\n    {\n        origin        predictive;\n"
           '        method        "Ambrose-Walton corresponding states";\n'
           '        methodVersion "choupo-aw-1989";\n'
           '        uncertainty   "not quantified; validate against saturation data";\n'
           '        notes         "computed from ChemSep Tc/Pc/omega";\n    }\n')


def aw_psat_kPa(T, rec_text):
    """The AmbroseWalton curve the record declares, from its own Tc, Pc and
    omega, through check_ambrose_walton_announced's independent Python
    (which that gate holds to the engine's own Psat to 1e-11)."""
    import importlib.machinery
    import importlib.util
    global _AW
    if "_AW" not in globals():
        path = ROOT / "bin" / "curate" / "check_ambrose_walton_announced.py"
        ld = importlib.machinery.SourceFileLoader("check_aw", str(path))
        sp_ = importlib.util.spec_from_loader("check_aw", ld)
        _AW = importlib.util.module_from_spec(sp_)
        ld.exec_module(_AW)
    t = crp.strip_comments(rec_text)
    g = lambda k: float(re.search(r"^%s\s+([-+0-9.eE]+)" % k, t, re.M).group(1))
    return _AW.psat(T, g("Tc"), g("Pc") * 1e5, g("omega")) / 1e3


def vp_record(comp):
    p = STD_COMP / f"{comp}.dat"
    if not p.exists():
        refuse(f"no catalogue record {p.relative_to(ROOT)}")
    return p


def vp_is_aw(text):
    return re.search(r"^vaporPressure\s*\{[^}]*\bmodel\s+AmbroseWalton\s*;",
                     crp.strip_comments(text), re.M) is not None


def vp_promoted_here(text):
    """A vaporPressure this mode promoted: it may be refitted (redeclared) and
    re-promoted, never a curve somebody else fitted or read."""
    m = re.search(r"\n    vaporPressure\n    \{\n.*?\n    \}\n", text, re.S)
    return bool(m) and crp.word(crp.strip_comments(m.group(0)), "promotedBy") == VP_PROMOTED_BY


def record_Tb(text):
    m = re.search(r"^Tb\s+([0-9.eE+-]+)\s*;", crp.strip_comments(text), re.M)
    return float(m.group(1)) if m else None


def read_vp_dataset(path):
    t = path.read_text()
    d = t[t.index("\ndata"):]
    rows = [l.split() for l in d.splitlines() if l.strip() and l.strip()[0].isdigit()]
    u = re.search(r"Psat\s*\{[^}]*values\s*\(([^)]*)\)", t, re.S)
    U = [float(v) for v in u.group(1).split()] if u else []
    T = [float(r[0]) for r in rows]
    P = [float(r[1]) for r in rows]
    return {"n": len(rows), "T": T, "P": P, "U": U}


def extract_vp(xml, key, into, fake_cache=None):
    cmd = [sys.executable, "-I", str(THERMOML), "extract-vp", str(xml),
           "--inchikey", key, "--into", str(into)]
    e = env()
    if fake_cache:
        e["CHOUPO_THERMOML_HOME"] = str(fake_cache)
    p = subprocess.run(cmd, capture_output=True, text=True, env=e)
    m = re.search(r"extract-vp: (\S+\.dat)\s+\(", p.stdout)
    if p.returncode != 0 or not m:
        return None, " ".join(l.strip() for l in p.stdout.splitlines()[1:3]) or p.stderr[-300:]
    return Path(m.group(1)), p.stdout


def antoine_P_kPa(A, B, C, T):
    return 100.0 * 10.0 ** (A - B / (T + C))


def antoine_Tnb(A, B, C, P_kPa=101.325):
    return B / (A - math.log10(P_kPa / 100.0)) - C


def vp_plan(name, work):
    comp, cas, key = identity(name)
    rp = vp_record(comp)
    text = rp.read_text()
    if not vp_is_aw(text) and not vp_promoted_here(text):
        refuse(f"{comp}: its vaporPressure is not `model AmbroseWalton` (nor a curve "
               "this mode promoted) -- this mode "
               "replaces a corresponding-states estimate and never overwrites a curve "
               "somebody fitted or read")
    ix = json.loads((cache_root() / "index.json").read_text())
    arts = sorted({e["doi"]: e for e in ix["entries"]
                   if any(c.get("inchikey") == key for c in e.get("compounds", []))}.values(),
                  key=lambda e: e["doi"])
    studies, aside = [], []
    for e in arts:
        xml = cache_root() / (e["doi"] + ".xml")
        if not xml.exists():
            aside.append((e["doi"], "the article file is not in the local cache"))
            continue
        out, why = extract_vp(xml, key, work / "ex")
        if out is None:
            if "carries no pure" not in why:
                aside.append((e["doi"], why))
            continue
        ds = read_vp_dataset(out)
        if ds["n"] < MIN_INTERIOR:
            aside.append((e["doi"], f"{ds['n']} pressure point(s), fewer than {MIN_INTERIOR}"))
            continue
        studies.append(dict(ds, doi=e["doi"], path=out, xml=xml,
                            authors=e.get("authors", []),
                            Tmin=min(ds["T"]), Tmax=max(ds["T"])))
    studies.sort(key=lambda s: (-s["n"], s["doi"]))
    pl = {"comp": comp, "cas": cas, "key": key, "studies": studies, "aside": aside,
          "Tb": record_Tb(text)}
    if not studies:
        pl["why"] = "no usable study"
        return pl
    #  THE EVIDENCE (DEV.md 4c C283, amended): EVERY usable study is fitted;
    #  none is held out.  Independence is no longer the test -- agreement
    #  across laboratories is, through the outlier rule and the acceptance.
    lo = min(s["Tmin"] for s in studies)
    hi = max(s["Tmax"] for s in studies)
    pl["span"] = (lo, hi)
    Tb = pl["Tb"]
    pl["tb_rule"] = (
        "no Tb declared in the record: no normal-boiling-point condition" if Tb is None else
        f"the record's Tb {Tb:g} K is judged against the range of the KEPT points "
        f"(all studies span {lo:g}-{hi:g} K before any outlier is discarded): if Tb lies "
        "OUTSIDE that range, the fitted Antoine's own normal boiling point (P = 101.325 "
        "kPa) is GRADED by its absolute gap to it (the temperature limits of the "
        "acceptance below); inside it, the gap is reported and is not a condition")
    return pl


def vp_decl_text(pl, case_rel):
    lines = [
        "/*--------------------------------*- Choupo -*--------------------------------*\\",
        f"  constant/archiveDatasets -- WHERE the measurements of {case_rel.split('/')[-1]}",
        "  come from, and how to regenerate them.  NO MEASURED POINT IS IN THIS TREE",
        "  (Vitor, 2026-11-10: the measured series are not copied; only the fitted",
        "  parameters are kept).  `bin/choupo-curate fetch <case>` writes each",
        f"  dataset into {EXTRACTS}/ (gitignored): the article file is taken from",
        "  the local ThermoML cache when it holds it, else from the NIST URL below,",
        "  and BOTH sha256 sums are checked -- a mismatch refuses, an unreachable",
        "  NIST is reported NOT RUN, never a pass.",
        "\\*-----------------------------------------------------------------------------*/",
        "",
        "recordType    archiveDatasets;",
        "",
        "archive",
        "{",
        f'    tarball   "{ARCHIVE}";',
        f'    doi       "{ARCHIVE_DOI}";',
        '    note      "the finding aid; each article file is also served one by one at the NIST URL";',
        "}",
        "",
        "datasets",
        "(",
    ]
    for role, s in [("fit", st) for st in pl["studies"]]:
        lines += [
            "    {",
            f'        file          "{EXTRACTS}/{s["path"].name}";',
            f"        role          {role};   // informational: the operation declares it",
            f'        doi           "{s["doi"]}";',
            f'        url           "{NIST.format(doi=s["doi"], ext="xml")}";',
            f'        page          "{NIST.format(doi=s["doi"], ext="json")}";',
            f'        articleFile   "{Path(s["xml"]).name}";',
            f'        articleSha256 "{sha_file(s["xml"])}";',
            "        extractor     vapourPressure;",
            f'        inchiKey      "{pl["key"]}";',
            f'        extract       "bin/choupo-thermoml extract-vp <article file> --inchikey {pl["key"]} --into <dir>";',
            f'        sha256        "{sha_file(s["path"])}";',
            "        identity",
            "        {",
            f'            {pl["comp"]:<14} {{ cas "{pl["cas"]}"; inchiKey "{pl["key"]}"; }}',
            "        }",
            "    }",
        ]
    lines += [");", ""]
    return "\n".join(lines)


VP_OBJECTIVE = "twoStage"   # C281 step 3: Vitor's fitting practice (C280), declared
VP_OBJ_WORDS = {"twoStage": "least squares in log10 P, then the largest relative error "
                            "in P minimised from it",
                "leastSquares": "least squares in log10 P",
                "minimax": "the largest relative error in P minimised"}


def vp_props_text(pl, case_name, earlier=None, window=None):
    comp = pl["comp"]
    window_par, window_op = "", ""
    accept_sent = f"case declares no `{VP_CURATION_DICT}`, so the default applies"
    if window:
        window_op = window["op"]
        accept_sent = (f"case's `{VP_CURATION_DICT}` declares only the fit window below, so "
                       "the default applies")
        window_par = (
            "\n" + wrap("FIT WINDOW (DEV.md 4c C367, declared in " + VP_CURATION_DICT
                        + " with its reason before the window fit): only the points whose "
                        f"pressure lies inside the window ({window['text']}) are FITTED; the "
                        "others are LEFT OUT BY NAME and their relative error in P against "
                        "the fitted curve is REPORTED beside the fit's own (never hidden). "
                        "The grade is computed on the fitted points; the record's Trange is "
                        "the window actually fitted, so the engine announces an extrapolation "
                        "beyond it.  Reason: " + window["reason"]) + "\n")
    earlier_par = ("" if not earlier else
                   "\n  EARLIER FITS, SUPERSEDED BY THIS DECLARATION\n  @@EARLIER-BEGIN@@\n"
                   + wrap(earlier) + "\n  @@EARLIER-END@@\n")
    ranked = "\n".join(
        f"      {s['doi']:<30} {s['n']:>4} pts  {s['Tmin']:g}-{s['Tmax']:g} K  "
        + "; ".join(a.split(",")[0] for a in s["authors"][:4])
        + (" et al." if len(s["authors"]) > 4 else "")
        for s in pl["studies"])
    aside = "\n".join(f"      {d}: {w}" for d, w in pl["aside"]) or "      (none)"
    ev = "".join(f"""            {{
                dataset   "{EXTRACTS}/{st['path'].name}";
                identity  {{ doi "{st['doi']}"; }}
                role      fit;
            }}
""" for st in pl["studies"])
    return f"""/*--------------------------------*- Choupo -*--------------------------------*\\
|       \\|/    C hemicals     |  Choupo: open-source, glass-box simulation    |
|      \\\\|//   H eat-transfer |  Version:  Choupo-dev                         |
|     \\\\\\|///  O perations    |  Website:  https://choupo.org                 |
|      \\\\|//   U nits         |  Licence:  GPL-3.0-or-later                   |
|       \\|/    P roperties    |  Tutorial case file -- part of Choupo         |
|        |     O ptimization  |                                               |
\\*-----------------------------------------------------------------------------*/
/*---------------------------------------------------------------------------*\\
  {case_name} -- the vapour pressure of {comp}, REFITTED to
  measurements (DEV.md 4c C281 and C283).  Written by `bin/choupo-curate vp
  {comp}`; everything above the RESULT paragraph is the DECLARATION,
  committed before any fit ran, so it can be read against the result.

  WHY.  The catalogue record carried `vaporPressure {{ model AmbroseWalton; }}`,
  a corresponding-states ESTIMATE from Tc, Pc and omega that never reads the
  record's own Tb (C279 measured a median 19.6 % AAD over the 25 such records
  with archive data).  Here a three-parameter Antoine is fitted to EVERY
  usable laboratory's measurements of it.

  STUDIES (one per article, extracted by `choupo-thermoml extract-vp`; ranked
  by points, ties by DOI):
{ranked}
  SET ASIDE BY NAME:
{aside}

  {VP_RULE_MARK}, Vitor 2026-11-10; the evidence,
  objective and outliers of C283; declared before the fit).
  EVIDENCE: every study above is fitted; none is held out (C283 amended:
  laboratories disagree with each other by more than they claim, so the
  test is agreement across all of them, not one laboratory's claimed
  precision).  OBJECTIVE: `objective {{ method {VP_OBJECTIVE}; }}` -- least
  squares in log10 P for a first estimate, then the LARGEST relative error in
  P, (P_model - P)/P, over the kept points minimised from it (Vitor's
  practice, C280); both answers kept.  OUTLIERS: after the least-squares
  stage a point with a relative P error above {VP_OUTLIER_PCT:g} % (three times
  the acceptance) is DISCARDED BY NAME (its study DOI, T and P), listed in
  the result and the record, and the fit repeated without it, once
  (`outliers {{ maxRelativeError {VP_OUTLIER_PCT:g} percent; }}`).  ACCEPTANCE,
  GRADED, the DEFAULT of C285: the maximum relative P error over all kept
  points is graded clean up to {VP_ACCEPT_DEFAULT['maxRel'][0]:g} %, warning up to
  {VP_ACCEPT_DEFAULT['maxRel'][1]:g} %, severe up to {VP_ACCEPT_DEFAULT['maxRel'][2]:g} % and refused above; where the
  normal-boiling-point condition below applies, the absolute gap is graded
  clean up to {VP_ACCEPT_DEFAULT['maxT'][0]:g} K, warning up to {VP_ACCEPT_DEFAULT['maxT'][1]:g} K, severe up to
  {VP_ACCEPT_DEFAULT['maxT'][2]:g} K and refused above.  The fit's grade is the WORSE of the
  two.  A clean, warning or severe fit is ACCEPTED and promoted (autoPromoted,
  humanReviewed false) with `fitGrade <grade>;` and the deciding numbers in
  its provenance entry, which the component loader voices on every run that
  uses it (a warning or a severe grade); a refused one is not promoted.  This
  {accept_sent}; a case
  that needs another acceptance declares it there, with its reason.  The
  AmbroseWalton curve's errors on the same points are reported beside the
  fit's, as information.
{window_par}
  NORMAL BOILING POINT: {pl['tb_rule']}.
{earlier_par}
  NO MEASURED POINT IS IN THIS TREE: constant/archiveDatasets declares every
  series by DOI, NIST URL and sha256; `bin/choupo-curate fetch` regenerates
  them into constant/archiveExtracts/ (gitignored).

  RESULT
  @@RESULT-BEGIN@@
  (filled in by bin/choupo-curate after the run)
  @@RESULT-END@@
\\*---------------------------------------------------------------------------*/

operations
(
    {{
        name       fit_antoine;
        type       vaporPressureFit;
        component  {comp};

        evidence
        (
{ev}        );

        objective  {{ method {VP_OBJECTIVE}; }}
        outliers   {{ maxRelativeError {VP_OUTLIER_PCT:g} percent; }}
{window_op}
        output     {{ file fit_antoine.csv; }}
    }}
);
"""


def vp_case_dir(comp):
    p = VP_CURATION / comp
    return p if (p / DECL).exists() else None


def vp_write_case(pl):
    comp = pl["comp"]
    case = VP_CURATION / comp
    name = label(case)
    if case.exists():
        refuse(f"{case.relative_to(ROOT)} exists -- a declaration is never rewritten")
    case_rel = case.relative_to(ROOT).as_posix()
    (case / "system").mkdir(parents=True)
    (case / "constant").mkdir()
    (case / f"{case.name}.cho").write_text("")
    (case / "system" / "controlDict").write_text(
        f"""/*  {name}: the vapour pressure of {comp} refitted as an Antoine to MEASURED
    vapour pressures from every usable laboratory (DEV.md 4c C281, C283).
    See system/propsDict for the declaration and the result.  */

application   choupoProps;
description   "Antoine vapour pressure of {comp} fitted by the curation pipeline to the measured vapour pressures of every usable laboratory (ThermoML locates, the articles source), outliers discarded by name";
verbosity     2;
""")
    (case / "constant" / "thermoPhysPropDict").write_text(
        f"""/*  {name}: the component whose vapour pressure is fitted.  The fit reads
    only its evidence; the catalogue record is loaded so the run voices what
    it is (the AmbroseWalton estimate before promotion, the autoPromoted
    Antoine after).  NOT sealed, for that reason.  */

recordType    thermophysicalPropertySystem;
schemaVersion 2;

components       ( {comp} );

equilibrium
{{
    formulation gammaPhi;
    liquid {{ activityModel {{ model ideal; }} }}
    vapour {{ fugacityModel idealGas; }}
}}
""")
    (case / DECL).write_text(vp_decl_text(pl, case_rel))
    (case / "system" / "propsDict").write_text(vp_props_text(pl, name))
    for s in pl["studies"]:
        (case / EXTRACTS).mkdir(parents=True, exist_ok=True)
        shutil.copy(s["path"], case / EXTRACTS / s["path"].name)
    return case


def vp_run(case):
    """Run the case on a scratch copy; (result facts, console)."""
    rc = fetch(case, quiet=True)
    if rc:
        return None, f"fetch of {case.relative_to(ROOT)} returned {rc}"
    work = Path(tempfile.mkdtemp(prefix="choupo-curate-vp-"))
    try:
        sc = work / case.name
        shutil.copytree(case, sc)
        rc, out, js = run_props(sc)
        if rc != 0 or js is None:
            return None, f"{label(case)} exited {rc}: {out[-600:]}"
    finally:
        shutil.rmtree(work, ignore_errors=True)
    op = op_result(js, "fit_antoine") or {}
    d, cu = op.get("diagnostics", {}), op.get("curation", {})
    decl = parse_decl(case)
    comp = case.name
    rec = vp_record(comp).read_text()
    dropped = vp_dropped(cu.get("outliersDropped", ""))
    studies = []
    kept_T, kept_P = [], []
    win = vp_window(case)
    n_left = 0
    for x in decl:
        ds = read_vp_dataset(case / x["file"])
        kT, kP, nd, nl = [], [], 0, 0
        for t, pk in zip(ds["T"], ds["P"]):
            if not vp_in_window(win, pk):
                nl += 1
                continue
            if (x["doi"], round(t, 3), round(math.log10(pk * 1e3), 5)) in dropped:
                nd += 1
                continue
            kT.append(t); kP.append(pk)
        studies.append({"doi": x["doi"], "n": ds["n"], "kept": len(kT), "dropped": nd,
                        "left": nl, "T": kT, "P": kP})
        kept_T += kT; kept_P += kP
        n_left += nl
    if win and n_left != int(d.get("n_window_left_out", -1)):
        return None, (f"{label(case)}: the tool counts {n_left} points left out of the "
                      f"window, the engine {d.get('n_window_left_out')} -- the window "
                      "is not read the same way in both")
    if len(kept_T) != int(d.get("n_points", -1)):
        return None, (f"{label(case)}: the tool reconstructs {len(kept_T)} kept points, the "
                      f"engine fitted {d.get('n_points')} -- the outlier list does not "
                      "name what the engine discarded")
    awr = [abs(aw_psat_kPa(t, rec) / pk - 1.0) for t, pk in zip(kept_T, kept_P)]
    return {"aw_aad": 100.0 * sum(awr) / len(awr), "aw_max": 100.0 * max(awr),
            "Tb": record_Tb(rec), "A": d.get("A"), "B": d.get("B"), "C": d.get("C"),
            "R2": d.get("R2"), "n": d.get("n_points"),
            "n_dropped": int(d.get("n_outliers_dropped", 0)),
            "dropped_txt": cu.get("outliersDropped", "none"),
            "aad_pct": d.get("relErr_mean_fit_pct"), "max_pct": d.get("relErr_max_fit_pct"),
            "aad_ls": d.get("relErr_mean_fit_pct_leastSquares"),
            "max_ls": d.get("relErr_max_fit_pct_leastSquares"),
            "objective": {0: "leastSquares", 1: "minimax", 2: "twoStage"}.get(
                int(d.get("objective_method", -1)), "unstated"),
            "studies": studies,
            "window": win, "n_left": n_left,
            "left_mean": d.get("relErr_mean_leftOut_pct"),
            "left_max": d.get("relErr_max_leftOut_pct"),
            "left_txt": cu.get("windowLeftOut"),
            "left_pts": cu.get("windowLeftOutPoints"),
            "Tmin": min(kept_T), "Tmax": max(kept_T)}, out


def vp_dropped(txt):
    """The engine's curation.outliersDropped list -> {(doi, T, P_Pa)}."""
    out = set()
    for item in (txt or "").split(";"):
        m = re.match(r"\s*(\S+) T=([0-9.eE+-]+) K P=([0-9.eE+-]+) Pa", item)
        if m:
            out.add((m.group(1), round(float(m.group(2)), 3),
                     round(math.log10(float(m.group(3))), 5)))
    return out


VP_P_UNITS_kPa = {"Pa": 1e-3, "kPa": 1.0, "MPa": 1e3, "bar": 100.0, "mbar": 0.1, "atm": 101.325}


def vp_window(case):
    """The fit window the case DECLARES (system/curationDict `fitWindow {}`, DEV.md
    4c C367), else None: {"max_kPa", "min_kPa", "reason", "op"}, `op` being the
    engine's `window {}` block as it is written into the propsDict.  A reason is
    REQUIRED and the units are the engine's pressure words."""
    p = case / VP_CURATION_DICT
    if not p.exists():
        return None
    t = crp.strip_comments(p.read_text())
    b = crp.block(t, "fitWindow")
    if b is None:
        return None
    rs = re.search(r'reason\s+"([^"]+)"\s*;', b)
    if not rs:
        refuse(f"{p.relative_to(ROOT)}: a `fitWindow` carries its `reason \"...\";` -- the "
               "physical reason the fit is restricted; none is declared")
    lim, ops = {}, []
    for key in ("pressureMax", "pressureMin"):
        m = re.search(r"\b%s\s+([0-9.eE+-]+)\s+(\w+)\s*;" % key, b)
        if m:
            if m.group(2) not in VP_P_UNITS_kPa:
                refuse(f"{p.relative_to(ROOT)}: fitWindow.{key} needs a pressure unit "
                       f"({', '.join(VP_P_UNITS_kPa)}); got `{m.group(2)}`")
            lim[key] = float(m.group(1)) * VP_P_UNITS_kPa[m.group(2)]
            ops.append(f"            {key:<12} {m.group(1)} {m.group(2)};\n")
    if not lim:
        refuse(f"{p.relative_to(ROOT)}: a `fitWindow` declares `pressureMax` and/or "
               "`pressureMin` (a number and a pressure unit)")
    op = ("        window\n        {\n" + "".join(ops)
          + f'            reason       "{rs.group(1)}";\n        }}\n')
    return {"max_kPa": lim.get("pressureMax"), "min_kPa": lim.get("pressureMin"),
            "reason": rs.group(1), "op": op,
            "text": ", ".join(f"{k} {v:g} kPa" for k, v in lim.items())}


def vp_in_window(w, p_kPa):
    return (w is None
            or ((w["max_kPa"] is None or p_kPa <= w["max_kPa"] * (1 + 1e-9))
                and (w["min_kPa"] is None or p_kPa >= w["min_kPa"] * (1 - 1e-9))))


def vp_acceptance(case):
    """The graded acceptance the case DECLARES (system/curationDict), else the
    C285 default -- (dict, declared?).  A declared acceptance gives the three
    upper limits of each grade (clean, warning, severe), with its reason."""
    p = case / VP_CURATION_DICT
    if not p.exists():
        return dict(VP_ACCEPT_DEFAULT), False
    t = crp.strip_comments(p.read_text())
    b = crp.block(t, "acceptance")
    if b is None and crp.block(t, "fitWindow") is not None:
        return dict(VP_ACCEPT_DEFAULT), False      # C367: the dict declares only the window
    if b is None:
        refuse(f"{p.relative_to(ROOT)}: no `acceptance {{}}` block")
    lim = lambda unit, key: re.search(
        r"%s\s*\(\s*([0-9.eE+-]+)\s+([0-9.eE+-]+)\s+([0-9.eE+-]+)\s*\)\s+%s\s*;"
        % (key, unit), b)
    mr = lim("percent", "maxRelativeError")
    mt = lim("K", "maxTemperatureError")
    rs = re.search(r'reason\s+"([^"]+)"\s*;', b)
    if not (mr and mt):
        refuse(f"{p.relative_to(ROOT)}: a graded acceptance (DEV.md 4c C285) declares "
               "`maxRelativeError (<clean> <warning> <severe>) percent;` and "
               "`maxTemperatureError (<clean> <warning> <severe>) K;` -- the upper "
               "limit of each grade, with their units")
    r_ = tuple(float(x) for x in mr.groups())
    t_ = tuple(float(x) for x in mt.groups())
    if list(r_) != sorted(r_) or list(t_) != sorted(t_):
        refuse(f"{p.relative_to(ROOT)}: the grade limits must not decrease")
    if not rs:
        refuse(f"{p.relative_to(ROOT)}: an acceptance other than the C285 default "
               "carries its `reason \"...\";` -- none is declared")
    return {"maxRel": r_, "maxT": t_, "reason": rs.group(1)}, True


def vp_grade(x, limits):
    """clean / warning / severe / refused: the first upper limit x stays within."""
    for g, lim in zip(VP_GRADES, limits):
        if x <= lim:
            return g
    return VP_GRADES[-1]


def vp_worse(a, b):
    return a if VP_GRADES.index(a) >= VP_GRADES.index(b) else b


def vp_judge(case, rf):
    """(promotable, reason) by the graded acceptance the case declares (C285's
    default unless system/curationDict says otherwise); a declaration that
    predates the rule is not judged by it.  Sets rf['grade'] and the numbers
    that decided it."""
    decl = (case / "system" / "propsDict").read_text()
    if VP_RULE_MARK not in decl:
        refuse(f"{label(case)} does not declare the C285 graded acceptance -- "
               f"`bin/choupo-curate vp <c> --redeclare` first")
    acc, declared = vp_acceptance(case)
    rf["acceptance"] = acc
    rf["acceptance_declared"] = declared
    who = (f"the graded acceptance declared in {VP_CURATION_DICT} ({acc['reason']})"
           if declared else
           "the DEFAULT graded acceptance of DEV.md 4c C285 (no system/curationDict)"
           if not rf.get("window") else
           "the DEFAULT graded acceptance of DEV.md 4c C285 (the system/curationDict "
           "declares only the fit window)")
    Tnb = antoine_Tnb(rf["A"], rf["B"], rf["C"])
    rf["Tnb"] = Tnb
    Tb = rf.get("Tb")
    info = (f"AmbroseWalton on the same points mean {rf['aw_aad']:.4g} % / max "
            f"{rf['aw_max']:.4g} %")
    if rf.get("window"):
        info += (f"; FIT WINDOW ({rf['window']['text']}): {rf['n_left']} measured point(s) "
                 f"LEFT OUT ({rf['left_txt']}), error against the fitted curve mean "
                 f"{rf['left_mean']:.4g} % / max {rf['left_max']:.4g} % (reported, not graded)")
    gP = vp_grade(rf["max_pct"], acc["maxRel"])
    errs = (f"{len(rf['studies'])} studies, {int(rf['n'])} points kept, "
            f"{rf['n_dropped']} discarded as outliers; max relative error "
            f"{rf['max_pct']:.4g} % (mean {rf['aad_pct']:.4g} %), grade {gP} (limits "
            + " / ".join(f"{x:g}" for x in acc["maxRel"]) + " %)")
    comp = case.name
    gap = None if Tb is None else Tnb - Tb
    gtxt = "" if Tb is None else (f"normal boiling point {Tnb:.2f} K, {gap:+.2f} K from "
                                  f"the record's Tb {Tb:g} K")
    if Tb is not None and not (rf["Tmin"] <= Tb <= rf["Tmax"]):
        gT = vp_grade(abs(gap), acc["maxT"])
        rf["tb_gap"] = gap
        tb = (f"Tb outside the kept points' range, {gtxt}, grade {gT} (limits "
              + " / ".join(f"{x:g}" for x in acc["maxT"]) + " K)")
    else:
        gT = "clean"
        rf["tb_gap"] = None
        tb = (f"Tb inside the kept points' range, {gtxt} (reported, not a condition)"
              if Tb is not None else "no Tb declared")
    grade = vp_worse(gP, gT)
    rf["grade"], rf["grade_P"], rf["grade_T"] = grade, gP, gT
    if grade == "refused":
        return False, (f"NOT PROMOTED by {who}: fit grade refused -- {errs}; {tb}; "
                       f"{info}; the record keeps AmbroseWalton")
    return True, (f"PROMOTABLE by `bin/choupo-curate vp {comp} --promote`: fit grade "
                  f"{grade} under {who}, "
                  f"{errs}; {tb}; {info}")


def vp_fill_result(case, rf, reason):
    per = "; ".join(f"{st['doi']} {st['kept']}/{st['n']} kept" for st in rf["studies"])
    txt = (f"WHAT THE RUN FOUND (pinned in `expected`; measured, not argued).  "
           f"Objective {rf['objective']}.  "
           f"Antoine log10(Psat/bar) = {rf['A']:.6f} - {rf['B']:.4f}/(T + "
           f"{rf['C']:.4f}), in-sample R2 {rf['R2']:.6f} over {int(rf['n'])} kept points, "
           f"{rf['Tmin']:g}-{rf['Tmax']:g} K ({per}).  Relative error in P over the kept "
           f"points: mean {rf['aad_pct']:.4f} %, max {rf['max_pct']:.4f} %; AmbroseWalton on "
           f"the same points: mean {rf['aw_aad']:.4f} %, max {rf['aw_max']:.4f} %.  "
           f"Outliers discarded: {rf['dropped_txt']}.  "
           + (f"Fit window ({rf['window']['text']}; reason: {rf['window']['reason']}): "
              f"{rf['n_left']} point(s) left out ({rf['left_txt']}); their relative error "
              f"in P against the fitted curve: mean {rf['left_mean']:.4f} %, max "
              f"{rf['left_max']:.4f} %.  Left out, point by point: {rf['left_pts']}.  "
              if rf.get("window") else "")
           + f"Its own normal boiling point "
           f"(101.325 kPa): {rf['Tnb']:.2f} K.  {reason}")
    p = case / "system" / "propsDict"
    t = p.read_text()
    t = re.sub(r"@@RESULT-BEGIN@@.*?@@RESULT-END@@",
               "@@RESULT-BEGIN@@\n" + wrap(txt) + "\n  @@RESULT-END@@", t, flags=re.S)
    p.write_text(t)


def earlier_of(case):
    m = re.search(r"@@EARLIER-BEGIN@@(.*?)@@EARLIER-END@@",
                  (case / "system" / "propsDict").read_text(), re.S)
    return " ".join(m.group(1).split()) if m else None


def vp_redeclare_window(pl, case, win, old, no_commit):
    """C367: the case's curationDict declares a fit window the propsDict does not
    yet carry.  Only the window is added: the evidence is never re-partitioned
    (the studies the extraction rules give now must be the case's own), the
    result so far is kept in the header, and the new declaration is committed
    BEFORE the fit runs."""
    have = {(d["doi"], d["sha256"]) for d in (parse_decl(case) or [])}
    now = {(s["doi"], sha_file(s["path"])) for s in pl["studies"]}
    if have != now:
        refuse(f"--redeclare: {label(case)} declares the studies {sorted(have)} and the "
               f"extraction rules give {sorted(now)} now -- C367 adds a window only; "
               "the evidence is never re-partitioned")
    m = re.search(r"@@RESULT-BEGIN@@(.*?)@@RESULT-END@@", old, re.S)
    prev = " ".join(m.group(1).split()) if m else "(no result recorded)"
    before = earlier_of(case)
    earlier = ((before.rstrip(". ") + ".  THEN " if before else "")
               + "C285, every usable study fitted over its WHOLE measured range "
               "(superseded by the fit window of C367): " + prev)
    pd = case / "system" / "propsDict"
    pd.write_text(vp_props_text(pl, label(case), earlier, win))
    if not no_commit:
        git(["add", "--", str(pd)])
        git(["commit", "-q", "-m",
             f"C367: {label(case)} -- the fit window, declared before the fit\n\n"
             f"bin/choupo-curate vp {pl['comp']} --redeclare: system/curationDict declares "
             f"a fit window ({win['text']}; reason: {win['reason']}); only the points "
             "inside it are fitted, the others are left out by name and their error "
             "reported.  The same studies, not re-partitioned; the earlier result kept "
             "in the header."])
        say(f"  committed the window declaration: {git(['rev-parse', '--short', 'HEAD']).strip()}")
    return case


def vp_redeclare(pl, no_commit):
    """C281 step 3: a NEW declaration for a case the tool already wrote --
    the SAME partition and band (re-derived by the same rules and refused if
    they differ: never a re-partition after seeing a result), the declared
    objective added, the earlier result kept in the header, committed before
    the fit runs."""
    case = vp_case_dir(pl["comp"])
    if case is None:
        refuse("--redeclare: no case for this component -- run `vp` first")
    pd = case / "system" / "propsDict"
    old = pd.read_text()
    win = vp_window(case)
    if VP_RULE_MARK in old:
        if win is None or win["op"] in old:
            refuse(f"--redeclare: {label(case)} already declares the C285 graded acceptance"
                   + ("" if win is None else " and this fit window"))
        return vp_redeclare_window(pl, case, win, old, no_commit)
    c283 = VP_RULE_MARK_C283 in old
    if c283:
        #  C285 changes the ACCEPTANCE only: the evidence is never re-partitioned
        #  after a result was seen.  The studies the same extraction rules give
        #  now must be exactly the ones the case already declares.
        have = {(d["doi"], d["sha256"]) for d in (parse_decl(case) or [])}
        now = {(s["doi"], sha_file(s["path"])) for s in pl["studies"]}
        if have != now:
            refuse(f"--redeclare: {label(case)} declares the studies {sorted(have)} and the "
                   f"extraction rules give {sorted(now)} now -- C285 changes the "
                   "acceptance only; the evidence is never re-partitioned")
    #  C283 (amended) changes the EVIDENCE by ruling: every usable study is
    #  fitted, none held out.  The studies are re-derived by the same
    #  extraction rules; the archiveDatasets are rewritten with them.
    m = re.search(r"@@RESULT-BEGIN@@(.*?)@@RESULT-END@@", old, re.S)
    prev = " ".join(m.group(1).split()) if m else "(no result recorded)"
    before = earlier_of(case)
    if c283:
        earlier = ((before.rstrip(". ") + ".  THEN " if before else "")
                   + "C283, every usable study fitted and none held out, accepted only "
                   "at max relative error <= 5 % and Tnb within 1 K (superseded by the "
                   "graded acceptance of C285): " + prev)
    elif before:
        earlier = (before + "  THEN C281 step 3, objective twoStage, one study fitted "
                   "and one held out, judged by the band (superseded by C283): " + prev)
    else:
        earlier = ("C281 step 2, objective leastSquares (log10 P), the same partition "
                   "and band: " + prev)
    pd.write_text(vp_props_text(pl, label(case), earlier))
    (case / DECL).write_text(vp_decl_text(pl, case.relative_to(ROOT).as_posix()))
    for st in pl["studies"]:
        (case / EXTRACTS).mkdir(parents=True, exist_ok=True)
        shutil.copy(st["path"], case / EXTRACTS / st["path"].name)
    for old_x in (case / EXTRACTS).glob("*.dat"):
        if old_x.name not in {st["path"].name for st in pl["studies"]}:
            old_x.unlink()
    if not no_commit:
        git(["add", "--", str(pd), str(case / DECL)])
        git(["commit", "-q", "-m",
             f"C285: {label(case)} -- the new declaration, before the fit\n\n"
             f"bin/choupo-curate vp {pl['comp']} --redeclare (DEV.md 4c C285): the "
             f"same {len(pl['studies'])} studies (every usable one, none held out, "
             f"not re-partitioned); objective {VP_OBJECTIVE}; outliers above "
             f"{VP_OUTLIER_PCT:g} % discarded by name and the fit repeated; the "
             "GRADED acceptance declared (max relative error over the kept points "
             "5 / 10 / 20 % for clean / warning / severe, |Tnb - Tb| 1 / 2 / 4 K where "
             "Tb lies outside their range, the worse of the two; refused above); the "
             "earlier results kept in the header."])
        say(f"  committed the new declaration: {git(['rev-parse', '--short', 'HEAD']).strip()}")
    return case


def vp_main(a):
    if a.promote:
        return vp_promote(a.component)
    work = Path(tempfile.mkdtemp(prefix="choupo-curate-vp-"))
    try:
        pl = vp_plan(a.component, work)
        say(f"choupo-curate vp {pl['comp']}  (InChIKey {pl['key']})")
        say(f"  usable studies {len(pl['studies'])}; set aside {len(pl['aside'])}")
        for d, w in pl["aside"]:
            say(f"    aside  {d}: {w}")
        for s in pl["studies"]:
            say(f"    study  {s['doi']} ({s['n']} pts, {s['Tmin']:g}-{s['Tmax']:g} K)")
        if not pl["studies"]:
            say(f"  NO FIT: {pl['why']} -- the record keeps AmbroseWalton")
            return 3
        say(f"  FIT      every usable study ({len(pl['studies'])}); none held out (C283)")
        say(f"  Tb       {pl['tb_rule']}")
        if a.plan:
            return 0
        if a.redeclare:
            case = vp_redeclare(pl, a.no_commit)
        elif a.resume:
            case = vp_case_dir(pl["comp"])
            if case is None:
                refuse("--resume: no case for this component")
            norm = lambda s: re.sub(r"@@(RESULT|EARLIER)-BEGIN@@.*?@@(RESULT|EARLIER)-END@@",
                                    "", s, flags=re.S)
            if (case / DECL).read_text() != vp_decl_text(pl, case.relative_to(ROOT).as_posix()) \
                    or norm((case / "system" / "propsDict").read_text()) != \
                    norm(vp_props_text(pl, label(case), earlier_of(case), vp_window(case))):
                refuse(f"--resume: {label(case)}'s declaration differs from the one the "
                       "rules give now -- a declaration is never rewritten after it "
                       "was committed")
        else:
            case = vp_write_case(pl)
            if not a.no_commit:
                files = [p for p in case.rglob("*") if p.is_file()
                         and EXTRACTS not in p.relative_to(case).as_posix()]
                git(["add", "--"] + [str(p) for p in files])
                git(["commit", "-q", "-m",
                     f"C285: {label(case)} -- the declaration, before any fit\n\n"
                     f"bin/choupo-curate vp {pl['comp']}: every usable study "
                     f"({len(pl['studies'])}) fitted, objective {VP_OBJECTIVE}, "
                     f"outliers above {VP_OUTLIER_PCT:g} % discarded by name, the "
                     "default GRADED acceptance of C285 (max relative error 5 / 10 / 20 "
                     "%, |Tnb - Tb| 1 / 2 / 4 K) written before the fit runs, so they "
                     "can be read against the result."])
                say(f"  committed the declaration: "
                    f"{git(['rev-parse', '--short', 'HEAD']).strip()}")
        say(f"  case     {case.relative_to(ROOT)}")
        rf, out = vp_run(case)
        if rf is None:
            refuse(out)
        ok, reason = vp_judge(case, rf)
        vp_fill_result(case, rf, reason)
        say(f"  fit      max {rf['max_pct']:.4g} % / mean {rf['aad_pct']:.4g} % over "
            f"{int(rf['n'])} kept points ({rf['n_dropped']} discarded); AmbroseWalton "
            f"{rf['aw_max']:.4g} % / {rf['aw_aad']:.4g} %; Tnb {rf['Tnb']:.2f} K, record "
            f"Tb {pl['Tb']}")
        say(f"  {reason}")
        return 0
    finally:
        shutil.rmtree(work, ignore_errors=True)


def vp_block(rf):
    return ("vaporPressure\n{\n    model         Antoine;\n"
            "    // log10(Psat [bar]) = A - B / (T[K] + C), FITTED by bin/choupo-curate vp to\n"
            "    // measured vapour pressures -- see provenance.vaporPressure\n"
            f"    coefficients  ({rf['A']:.10g}  {rf['B']:.10g}  {rf['C']:.10g});\n"
            f"    Trange        ({rf['Tmin']:g}  {rf['Tmax']:g});   // the fit's own span; "
            "outside it the engine announces the extrapolation\n}\n")


def vp_prov(rf, case, decl):
    case_rel = case.relative_to(ROOT).as_posix()
    ev = ""
    for d in decl:
        st = next(x for x in rf["studies"] if x["doi"] == d["doi"])
        ev += ("            {\n"
               f"                role      {d['role']};\n"
               f'                dataset   "{d["file"]}";\n'
               f'                doi       "{d["doi"]}";\n'
               f'                sha256    "{d["sha256"]}";\n'
               f'                articleSha256 "{d["articleSha256"]}";\n'
               f"                pointsKept    {st['kept']};\n"
               f"                pointsDropped {st['dropped']};\n"
               + (f"                pointsLeftOut {st['left']};\n" if rf.get("window") else "")
               + "                provenance measured;\n"
               "            }\n")
    acc = rf["acceptance"]
    lims = lambda v, u: " / ".join(f"{x:g}" for x in v) + f" {u}"
    acc_txt = ((f"the default of DEV.md 4c C285 (graded): " if not rf.get("acceptance_declared")
                else f"declared in {VP_CURATION_DICT} (reason: {acc['reason']}): ")
               + f"max relative error in P over the kept points {lims(acc['maxRel'], '%')}, "
               f"and |Tnb - Tb| {lims(acc['maxT'], 'K')} where Tb lies outside their range, "
               "are the upper limits of clean / warning / severe; above, refused; the "
               "grade is the worse of the two")
    gap = rf.get("tb_gap")
    grade_lines = (
        f"        fitGrade      {rf['grade']};   // DEV.md 4c C285: the worse of the grades below\n"
        "        fitGradeBasis inSample;   // DEV.md 4c C300 rule 1: the residual of the points it was fitted to\n"
        f"        fitGradeMaxRelativeError_pct {rf['max_pct']:.6f};   // grade {rf['grade_P']}\n"
        + ("" if gap is None else
           f"        fitGradeBoilingPointGap_K    {gap:.4f};   // grade {rf['grade_T']} "
           "(Tb outside the kept points' range)\n"))
    w = rf.get("window")
    win_blk = ""
    if w:
        win_blk = (
            "        window\n        {\n"
            f'            limits        "{w["text"]}";\n'
            f'            reason        "{w["reason"]}";\n'
            f"            pointsFitted  {int(rf['n'])};\n"
            f"            pointsLeftOut {rf['n_left']};\n"
            f'            leftOut       "{rf["left_txt"]}";\n'
            f"            leftOutMeanError_pct {rf['left_mean']:.6f};   // the fitted Antoine on the points the window left out: REPORTED, not fitted, not graded\n"
            f"            leftOutMaxError_pct  {rf['left_max']:.6f};\n"
            "        }\n")
    scope_txt = ("every usable study fitted inside the declared window (DEV.md 4c C367: "
                 "provenance window), the points outside it left out and reported"
                 if w else "every usable study fitted")
    return ("    vaporPressure\n    {\n"
            "        origin        fitted;\n"
            f'        method        "vaporPressureFit (three-parameter Antoine; objective {rf["objective"]}: {VP_OBJ_WORDS.get(rf["objective"], "unstated")}; {scope_txt}, outliers above {VP_OUTLIER_PCT:g} % discarded by name)";\n'
            '        methodVersion "choupoProps Choupo-dev";\n'
            f'        fittedInCase  "{case_rel}";\n'
            "        reviewStatus  autoPromoted;\n"
            "        review        { by none; }   // DEV.md 4c C300 rule 4 (C297): nobody has reviewed it\n"
            + grade_lines +
            f'        promotedBy    "{VP_PROMOTED_BY}";\n'
            f'        promotedDate  "{date.today().isoformat()}";\n'
            '        reviewReason  "regressed by bin/choupo-curate from archive-transcribed measurements; not yet read back against the articles";\n'
            '        reuse         "Choupo\'s own regression; the measured points belong to the cited articles and are not reproduced in this record or this tree";\n'
            '        uncertainty   "the fit\'s maximum relative error over every kept measurement, below";\n'
            '        replaces      "model AmbroseWalton (a corresponding-states estimate from Tc, Pc, omega); `bin/choupo-curate revert <component>` restores it";\n'
            "        evidence\n        (\n" + ev + "        );\n"
            + win_blk +
            "        acceptance\n        {\n"
            f'            rule        "{acc_txt}";\n'
            "            verdict     accepted;\n"
            f"            studies     {len(rf['studies'])};\n"
            f"            pointsKept  {int(rf['n'])};\n"
            f"            pointsDropped {rf['n_dropped']};\n"
            f'            dropped     "{rf["dropped_txt"]}";\n'
            f"            aad_pct     {rf['aad_pct']:.6f};   // the fitted Antoine, every kept point\n"
            f"            max_pct     {rf['max_pct']:.6f};\n"
            f"            awAad_pct   {rf['aw_aad']:.6f};   // the AmbroseWalton curve it replaces, the same points\n"
            f"            awMax_pct   {rf['aw_max']:.6f};\n"
            f"            Tnb_fit     {rf['Tnb']:.4f};   // K, the fitted curve at 101.325 kPa\n"
            "        }\n    }\n")


def vp_promote(name):
    comp = identity(name)[0]
    case = vp_case_dir(comp)
    if case is None:
        refuse(f"no case written by this tool for {comp} -- run "
               f"`bin/choupo-curate vp {comp}` first")
    rp = vp_record(comp)
    text = rp.read_text()
    if not vp_is_aw(text) or AW_BLOCK not in text or AW_PROV not in text:
        refuse(f"{rp.relative_to(ROOT)}: its vaporPressure is not the AmbroseWalton "
               "block this mode replaces (or its provenance entry is not the one it "
               "expects) -- never overwritten")
    rf, out = vp_run(case)
    if rf is None:
        refuse(out)
    ok, reason = vp_judge(case, rf)
    if not ok:
        refuse(f"{comp}: {reason}")
    decl = parse_decl(case)
    new = text.replace(AW_BLOCK, vp_block(rf), 1)
    new = new.replace(AW_PROV, vp_prov(rf, case, decl), 1)
    new = new.replace(AW_BANNER,
                      "  Critical constants are source data.  Psat is an Antoine FITTED by\n"
                      "  bin/choupo-curate vp to measured vapour pressures (DEV.md 4c C281;\n"
                      "  provenance.vaporPressure): reviewStatus autoPromoted, NOT human-reviewed.\n",
                      1)
    rp.write_text(new)
    mark_result(case, f"PROMOTABLE by `bin/choupo-curate vp {comp} --promote`:",
                f"PROMOTED on {date.today().isoformat()} into "
                f"{rp.relative_to(ROOT).as_posix()} as reviewStatus autoPromoted, "
                "review by none, because:")
    say(f"choupo-curate: PROMOTED the vapour pressure of {comp} into "
        f"{rp.relative_to(ROOT)} (autoPromoted, review by none, fitGrade "
        f"{rf['grade']})")
    return 0


def vp_revert(comp):
    rp = vp_record(comp)
    text = rp.read_text()
    m = re.search(r"\n    vaporPressure\n    \{\n.*?\n    \}\n", text, re.S)
    ent = m.group(0)[1:] if m else ""
    if crp.word(crp.strip_comments(ent), "promotedBy") != VP_PROMOTED_BY:
        refuse(f"{rp.relative_to(ROOT)}: its vapour pressure was not promoted by this "
               "mode -- revert restores ONLY what `vp --promote` replaced")
    case = ROOT / crp.word(crp.strip_comments(ent), "fittedInCase")
    new = re.sub(r"^vaporPressure\n\{\n.*?\n\}\n", lambda _: AW_BLOCK, text,
                 count=1, flags=re.S | re.M)
    new = new.replace(ent, AW_PROV, 1)
    new = re.sub(r"  Critical constants are source data\.  Psat is an Antoine FITTED by\n.*?"
                 r"NOT human-reviewed\.\n", lambda _: AW_BANNER, new, count=1, flags=re.S)
    rp.write_text(new)
    if case.exists():
        mark_result(case, "PROMOTED on", "PROMOTED (and since REVERTED by `choupo-curate "
                    "revert`) on")
    say(f"choupo-curate: REVERTED the vapour pressure of {comp} to AmbroseWalton")
    return 0


def main():
    ap = argparse.ArgumentParser(prog="choupo-curate", description=__doc__.split("\n")[0])
    sp = ap.add_subparsers(dest="cmd", required=True)
    p = sp.add_parser("pair", help="the C16 chain for one binary pair")
    p.add_argument("a")
    p.add_argument("b")
    p.add_argument("--pmax", type=float, default=110.0)
    p.add_argument("--plan", action="store_true", help="print the declaration, write nothing")
    p.add_argument("--no-commit", action="store_true")
    p.add_argument("--promote", action="store_true")
    p.add_argument("--resume", action="store_true",
                   help="the case exists (its declaration committed): verify the "
                        "declaration is unchanged and run it")
    v = sp.add_parser("vp", help="refit ONE compound's estimated vapour pressure (C281)")
    v.add_argument("component")
    v.add_argument("--plan", action="store_true", help="print the declaration, write nothing")
    v.add_argument("--no-commit", action="store_true")
    v.add_argument("--promote", action="store_true")
    v.add_argument("--resume", action="store_true")
    v.add_argument("--redeclare", action="store_true",
                   help="C281 step 3: rewrite an existing case's declaration with the "
                        "declared objective (same partition and band, refused "
                        "otherwise), commit it, then fit")
    f = sp.add_parser("fetch", help="regenerate a case's extracts")
    f.add_argument("case")
    r = sp.add_parser("revert", help="remove a record this tool promoted")
    r.add_argument("stem")
    a = ap.parse_args()
    if a.cmd == "vp":
        return vp_main(a)
    if a.cmd == "revert" and (STD_COMP / f"{a.stem}.dat").exists():
        return vp_revert(a.stem)
    if a.cmd == "fetch":
        return fetch(Path(a.case).resolve())
    if a.cmd == "revert":
        return revert(a.stem)
    if a.promote:
        return promote(a.a, a.b)
    work = Path(tempfile.mkdtemp(prefix="choupo-curate-"))
    try:
        pl = plan(a.a, a.b, a.pmax, work)
        say(f"choupo-curate pair {pl['c1']} {pl['c2']}")
        say(f"  usable studies {len(pl['studies'])}; set aside {len(pl['aside'])}")
        for t, w in pl["aside"]:
            say(f"    aside  {t}: {w}")
        say("  triage  " + pl["triage_note"])
        say(f"  FIT      doi {pl['fit']['doi']} ({pl['fit']['n']} pts)")
        say(f"  HELD OUT doi {pl['held']['doi']} ({pl['held']['n']} pts, "
            f"{pl['held']['P_kPa']:g} kPa)")
        say(f"  band     {pl['band_txt']} %  ({pl['origin']})")
        if a.plan:
            return 0
        if a.resume:
            case = find_case(pl["c1"], pl["c2"])
            if case is None:
                refuse("--resume: no case for this pair")
            stem = "-".join(sorted((pl["c1"], pl["c2"])))
            want = decl_text(pl, case.relative_to(ROOT).as_posix())
            unifac = has_unifac(pl["c1"]) and has_unifac(pl["c2"])
            wantp = props_text(pl, label(case), stem, unifac)
            norm = lambda s: re.sub(r"  @@PILOT-BEGIN@@.*?@@PILOT-END@@\n\n", "", re.sub(
                r"@@RESULT-BEGIN@@.*?@@RESULT-END@@", "", s, flags=re.S), flags=re.S)
            if (case / DECL).read_text() != want or \
                    norm((case / "system" / "propsDict").read_text()) != norm(wantp):
                refuse(f"--resume: {label(case)}'s declaration differs from the one the "
                       "rules give now -- a declaration is never rewritten after it "
                       "was committed")
            for s in (pl["fit"], pl["held"]):
                (case / EXTRACTS).mkdir(parents=True, exist_ok=True)
                shutil.copy(s["path"], case / EXTRACTS / s["path"].name)
            commit = False
        else:
            case, stem = write_case(pl)
            commit = not a.no_commit
        say(f"  case     {case.relative_to(ROOT)}")
        rf, split, reason = run_pipeline(case, stem, pl, commit)
        say(f"  verdict  {rf['verdict']}  (held-out AAD {rf['aad_pct']} %, band "
            f"{rf['maxAAD']} %)")
        say(f"  arm (f)  {'SPLITS: ' + split[0] if split else 'one liquid across the span'}")
        say(f"  {reason}")
        return 0
    finally:
        shutil.rmtree(work, ignore_errors=True)


# ==========================================================================
#  THE PURE-COMPOUND MODE, unchanged (it predates `pair`; usage
#  `choupo-curate <compound> [--case DIR] [--rule byDoiOrder] [--nFit N]`).
#  Its own description, as it was written:
#
#  choupo-curate -- one command: evidence -> partition -> fit -> held-out -> dossier.
#
#      choupo-curate <compound> [--case DIR] [--rule byDoiOrder] [--nFit N]
#
#  What it does, in the order a curator would:
#
#      identity      resolve the compound in the local ThermoML index
#      evidence      extract every dataset Choupo can read into the case
#      partition     DECLARE which datasets fit and which are held out
#      fit           run choupoProps
#      validate      report held-out residuals, or refuse
#      dossier       write the evidence record; promote nothing
#
#  THE PARTITION RULE IS DECLARED AND DETERMINISTIC, AND THAT IS THE WHOLE POINT.
#  A class cannot hand-pick DOIs for thirty components, so an automatic rule is
#  allowed -- but only one that is stated in advance, reproducible from the
#  declaration alone, and RECORDED in the dossier.  `byDoiOrder` sorts the
#  datasets by DOI and gives the first `nFit` to the fit; the rest are held out.
#  It does not look at a single residual, and this tool will not re-run it after
#  seeing one.  Automatic-and-declared is not tuning; re-partitioning after a bad
#  result is, and that is what the whole contract exists to prevent.
#
#  WITH ONLY ONE DATASET the honest outcome is a refusal, not a smaller split.
#  The tool says so before running, and choupoProps then prints
#
#      VALIDATION REFUSED:
#      No independent experimental evidence remains after fitting.
#
#  which is the correct answer to "I have one measurement and want to know if my
#  model generalises".
#
#  NOTHING IS PROMOTED.  The dossier has evidence semantics and sits in
#  <case>/curation/, outside every resolver root.  Admitting a property to
#  data/standards/ is a separate, explicit human act:
#  bin/curate/promote-from-dossier.
# ==========================================================================
def sh(args, cwd=None):
    p = subprocess.run(args, cwd=cwd, capture_output=True, text=True)
    return p.returncode, p.stdout + p.stderr


PROP_OP = {
    "vapourPressure":  ("vaporPressureFit", "vapourPressure"),
    "heatCapacity":    ("heatCapacityFit",  "liquidHeatCapacity"),
}


def sh(args, cwd=None):
    p = subprocess.run(args, cwd=cwd, capture_output=True, text=True)
    return p.returncode, p.stdout + p.stderr


def compound_main(argv):
    ap = argparse.ArgumentParser(prog="choupo-curate <compound>")
    ap.add_argument("compound")
    ap.add_argument("--case", default=None,
                    help="case directory to build (default: ./curate-<compound>)")
    ap.add_argument("--rule", default="byDoiOrder", choices=["byDoiOrder"])
    ap.add_argument("--nFit", type=int, default=1)
    ap.add_argument("--maxAAD", type=float, default=None,
                    help="acceptance band in percent; without one no verdict "
                         "is claimed on the held-out residuals")
    a = ap.parse_args(argv)

    case = Path(a.case or f"curate-{a.compound}")

    # -- identity ---------------------------------------------------------
    print(f"IDENTITY")
    rc, out = sh([str(THERMOML), "search", a.compound])
    if rc != 0:
        print(out.rstrip())
        return 1
    print("  " + out.strip().splitlines()[0])

    # -- evidence ---------------------------------------------------------
    print(f"\nTHERMOML EVIDENCE")
    exp = case / "constant" / "experiments"
    rc, out = sh([str(THERMOML), "extract", a.compound, "--into", str(exp)])
    print("  " + "\n  ".join(l for l in out.strip().splitlines() if l))
    if rc != 0:
        return 1

    # -- partition --------------------------------------------------------
    #  Group the extracted datasets by property, then split each group by the
    #  DECLARED rule.  The rule runs ONCE, before anything is fitted.
    import re as _re
    by_prop = {}
    for f in sorted(exp.glob("*.dat")):
        m = _re.search(r"^property\s+(\S+);", f.read_text(), _re.M)
        if not m:
            print(f"  SKIPPED {f.name}: declares no `property` field.  The "
                  f"property is read from the file, never split out of its "
                  f"name -- a name is not an identity.")
            continue
        by_prop.setdefault(m.group(1), []).append(f)

    print(f"\nPARTITION   rule {a.rule}, nFit {a.nFit}"
          f"   (declared before the fit; recorded in the dossier)")
    ops = []
    for prop, files in sorted(by_prop.items()):
        if prop not in PROP_OP:
            print(f"  {prop:<20} SKIPPED -- Choupo has no fit operation for it")
            continue
        files = sorted(files, key=lambda p: p.name)          # byDoiOrder proxy
        fit, held = files[:a.nFit], files[a.nFit:]
        if not fit:
            print(f"  {prop:<20} SKIPPED -- nFit {a.nFit} leaves nothing to fit")
            continue
        print(f"  {prop}")
        for f in fit:
            print(f"      FIT        {f.name}")
        for f in held:
            print(f"      HELD-OUT   {f.name}")
        if not held:
            print(f"      -> only one dataset: the validation will be REFUSED, "
                  f"which is the honest answer, not a smaller split.")
        ops.append((prop, fit, held))

    if not ops:
        print("\nNothing to curate: no extracted property has a fit operation.")
        return 1

    # -- write the case ---------------------------------------------------
    (case / "system").mkdir(parents=True, exist_ok=True)
    blocks = []
    for prop, fit, held in ops:
        optype, _ = PROP_OP[prop]
        ev = "\n".join(
            f'            {{ dataset "constant/experiments/{f.name}"; '
            f'role {role}; }}'
            for role, group in (("fit", fit), ("validation", held))
            for f in group)
        #  `--maxAAD 0.01` means 0.01 PERCENT, and the `percent` unit already
        #  carries the /100 -- dividing again here made a 0.01 % band arrive at
        #  the engine as 0.0001 %, and the run reported NOT VALIDATED for a
        #  reason that was the tool's arithmetic rather than the model's.
        acc = (f"\n        acceptance {{ maxAAD {a.maxAAD:g} percent; }}"
               if a.maxAAD is not None else "")
        blocks.append(f'''    {{
        name       curate_{prop};
        type       {optype};
        component  {a.compound};
        evidence
        (
{ev}
        );{acc}
        output     {{ file curate_{prop}.csv; }}
    }}''')

    (case / "system" / "propsDict").write_text(
        "//  GENERATED by bin/choupo-curate.  The partition below was declared\n"
        f"//  by rule `{a.rule}` (nFit {a.nFit}) BEFORE anything was fitted, and\n"
        "//  re-running this tool after seeing residuals would re-declare it --\n"
        "//  which is why the dossier records the rule beside the answer.\n\n"
        "operations\n(\n" + "\n\n".join(blocks) + "\n);\n")

    for f in ("controlDict",):
        srcs = list(ROOT.glob(f"tutorials/props/**/system/{f}"))
        if srcs:
            (case / "system" / f).write_text(srcs[0].read_text())

    if not (case / "constant" / "thermoPhysPropDict").exists():
        tp = next(ROOT.glob("tutorials/props/fit/*/constant/thermoPhysPropDict"))
        (case / "constant" / "thermoPhysPropDict").write_text(tp.read_text())

    # -- run --------------------------------------------------------------
    print(f"\nRUN   {case}")
    rc, out = sh([str(PROPS), "."], cwd=case)
    for line in out.splitlines():
        if any(k in line for k in ("HELD-OUT", "VALIDAT", "[evidence]",
                                   "[curation]", "REFUSED", "Antoine",
                                   "[estimate]", "[unreviewed]")):
            print("  " + line.strip())
    if rc != 0:
        print(f"\n  choupoProps exited {rc}")
        return rc

    print(f"\nNOTHING PROMOTED.  Review {case}/curation/, then\n"
          f"  bin/curate/promote-from-dossier {case}/curation/<component>.dossier \\\n"
          f"      --property <name> --by <who> --grounds \"<why>\"")
    return 0




if __name__ == "__main__":
    #  `pair` and `pairs` run under DEV.md 4c C283 (amended) and C284
    #  (bin/curate/pairs_c283.py); `pair ... --rule c282` keeps the pilot chain.
    if len(sys.argv) > 1 and sys.argv[1] in ("pair", "pairs"):
        if "--rule" in sys.argv:
            k = sys.argv.index("--rule")
            rule = sys.argv[k + 1] if k + 1 < len(sys.argv) else ""
            del sys.argv[k:k + 2]
            if rule != "c282":
                refuse(f"--rule {rule}: the rules are c283 (the default) and c282")
        else:
            import pairs_c283
            sys.exit(pairs_c283.main(sys.argv[1:]))
    if len(sys.argv) > 1 and sys.argv[1] not in ("pair", "vp", "fetch", "revert", "-h", "--help"):
        sys.exit(compound_main(sys.argv[1:]))
    sys.exit(main())
