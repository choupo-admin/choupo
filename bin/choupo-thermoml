#!/usr/bin/env python3
"""choupo-thermoml -- the local ThermoML archive: sync, index, search.

WHY THIS IS A CURATION TOOL AND NOT PART OF choupoProps.  `choupoProps`
compiles to WebAssembly and runs in the browser, where opening an HTTPS
connection is impossible; and the engine carries no external dependencies by
policy.  So the network lives here, in Python, beside every other importer,
and the engine only ever READS the cache this tool builds.  The solver never
touches the network.

WHAT IS AND IS NOT REDISTRIBUTED.  Choupo ships no ThermoML content.  This
tool downloads the official NIST archive into a gitignored cache on the user's
own machine, from the source NIST publishes for exactly that purpose
(doi:10.18434/mds2-2422).  Nothing from the archive enters the repository or a
release tarball, so the unresolved question of downstream redistribution stays
off the critical path.  Keep it that way.

    thirdParty/thermoml/          the cache (already gitignored by thirdParty/*)
    $CHOUPO_THERMOML_HOME         overrides it -- a class of thirty students
                                  shares one copy rather than fetching it thirty
                                  times

TWO DIALECTS, AND THE REASON THIS TOOL DETECTS RATHER THAN ASSUMES.  ThermoML
exists in two incompatible forms, and a reader written for one fails on every
file of the other:

    published   <DataReport>   <Compound> <PureOrMixtureData> <Property>
                               -- the dialect the ARCHIVE ships
    v5 (2017)   <dataReport>   <chemical> <prop> <var> <phase>
                               -- the proposal in usnistgov/thermoML

Verified element by element against NIST's own ThermoML5.xsd, which defines
`chemical` and `property` and contains no `Compound` or `PureOrMixtureData` at
all.  So the dialect is READ off the root element and an unrecognised one is
REFUSED BY NAME.  If NIST ever migrates the archive to v5 -- and publishing a
v5 schema suggests they intend to -- Choupo refuses instead of silently
misreading, which is the whole point of detecting rather than assuming.

MATCHING IS BY LOCAL ELEMENT NAME, NOT BY PATH.  The extractor searches for
elements by name anywhere beneath their parent and REFUSES when a required
name is absent.  A nesting difference then costs an adjustment; it does not
produce plausible wrong numbers.  That choice was made when the real archive
could not be reached, and it is the reason nothing had to be rewritten when it
finally was.

STATUS -- and this paragraph used to say the opposite, correctly, until
2026-08-25.  It read: "the published path is exercised against a FIXTURE
written from the documented element names and is marked unverified until a
real archive file has passed through it."  Real archive files have now passed
through it: **11 921 of the archive's 11 923 files parse**, every one of them
the published dialect, yielding 25 546 searchable identifiers.  The two
refusals are malformed XML IN THE ARCHIVE (`j.fluid.2018.07.020.xml` and
`.021`, both an invalid token mid-file) and are LISTED with the parse error
rather than dropped -- which is the behaviour the reader was written for.

So the by-name matching held against the real thing at scale.  What is STILL
unexercised is the v5 dialect at scale (one file), and every property this
tool does not read: `index` lists 92 declared property types Choupo cannot
consume yet, and listing them is the whole point -- a reader that quietly
ignored them would be indistinguishable from one that found nothing.
"""

import argparse
import hashlib
import json
import os
import re
import ssl
import tarfile
import time
import urllib.error
import urllib.parse
import urllib.request
import pathlib
import sys
import xml.etree.ElementTree as ET

ROOT = pathlib.Path(__file__).resolve().parents[1]

ARCHIVE_DOI = "10.18434/mds2-2422"
ARCHIVE_LANDING = "https://data.nist.gov/od/id/mds2-2422"
SCHEMA_URL = "https://trc.nist.gov/ThermoML.xsd"

#  The distribution facts, READ FROM THE RECORD on 2026-08-25, not guessed.
SYNC_BASE = "https://data.nist.gov/od/ds/mds2-2422"
SYNC_TARBALL = "ThermoML.v2020-09-30.tgz"
#  The proxy's CA is not in the system store, and this host rejects urllib's
#  default User-Agent with a 403 that curl does not receive.  Both are
#  environment facts, discovered by hitting them.
CA_BUNDLE = os.environ.get("SSL_CERT_FILE") or "/root/.ccr/ca-bundle.crt"
SYNC_UA = "choupo-thermoml/1.0 (private mirror; doi:10.18434/mds2-2422)"

#  The property names Choupo can consume today.  Anything else is LISTED and
#  skipped, never silently dropped: a reader that quietly ignores two thirds of
#  a file is indistinguishable from one that found nothing.
WANTED = {
    "vapourPressure": ("vapor", "sublimation pressure", "vapour"),
    "liquidDensity":  ("density", "mass density", "specific volume"),
    "heatCapacity":   ("heat capacity",),
}


def cache_root() -> pathlib.Path:
    env = os.environ.get("CHOUPO_THERMOML_HOME")
    return pathlib.Path(env) if env else ROOT / "thirdParty" / "thermoml"


def local(tag: str) -> str:
    """Element tag without its namespace."""
    return tag.rsplit("}", 1)[-1]


def find_all(elem, name):
    return [e for e in elem.iter() if local(e.tag) == name]


def find_text(elem, name, default=""):
    for e in elem.iter():
        if local(e.tag) == name and e.text:
            return e.text.strip()
    return default


def detect_dialect(root) -> str:
    r = local(root.tag)
    if r == "DataReport":
        return "published"
    if r == "dataReport":
        return "v5"
    raise ValueError(
        f"unrecognised ThermoML root element <{r}>.  Choupo reads two "
        f"dialects: the PUBLISHED one (<DataReport>, <Compound>, "
        f"<PureOrMixtureData>) that the NIST archive ships, and the 2017 v5 "
        f"proposal (<dataReport>, <chemical>, <prop>).  This file is neither, "
        f"and guessing which reader to point at it would produce plausible "
        f"wrong numbers rather than an error.")


def compounds_published(root):
    out = []
    for c in find_all(root, "Compound"):
        cas = ""
        for rn in find_all(c, "RegNum"):
            v = find_text(rn, "nCASRegNum")
            if v:
                cas = v
        out.append({
            "name":     find_text(c, "sCommonName"),
            "formula":  find_text(c, "sFormulaMolec"),
            "inchi":    find_text(c, "sStandardInChI"),
            "inchikey": find_text(c, "sStandardInChIKey"),
            "cas":      cas,
        })
    return out


def compounds_v5(root):
    out = []
    for c in find_all(root, "chemical"):
        out.append({
            "name":     find_text(c, "commonName"),
            "formula":  find_text(c, "molecularFormula"),
            "inchi":    find_text(c, "standardInChI"),
            "inchikey": find_text(c, "standardInChIKey"),
            "cas":      find_text(c, "casrn"),
        })
    return out


def properties_published(root):
    """Property names declared in the file, with how many points carry them."""
    names = []
    for p in find_all(root, "Property"):
        n = find_text(p, "ePropName")
        if n:
            names.append(n)
    return names


def properties_v5(root):
    names = []
    for p in find_all(root, "prop"):
        n = find_text(p, "name") or find_text(p, "label")
        if n:
            names.append(n)
    return names


def classify(prop_name: str):
    low = prop_name.lower()
    for key, needles in WANTED.items():
        if any(nd in low for nd in needles):
            return key
    return None


def read_file(path: pathlib.Path):
    root = ET.parse(path).getroot()
    dialect = detect_dialect(root)
    #  THE CITATION FIELDS ARE PART OF THE INDEX (2026-08-25).  They were not,
    #  and their absence is why a SECOND index (a parallel citations.jsonl) got
    #  built beside this one: the Literature workspace needs authors, journal
    #  and year to show a reader WHICH PAPER to go and read, and this index
    #  carried only doi + title.  Two indexes over one cache is the arity sin;
    #  the fix is for the one index to answer the question.
    if dialect == "published":
        comps, props = compounds_published(root), properties_published(root)
        doi = find_text(root, "sDOI")
        title = find_text(root, "sTitle")
        authors = [e.text.strip() for e in find_all(root, "sAuthor")
                   if e.text and e.text.strip()]
        journal = find_text(root, "sPubName")
        year = find_text(root, "yrPubYr")
    else:
        comps, props = compounds_v5(root), properties_v5(root)
        doi = find_text(root, "DOI")
        title = find_text(root, "title")
        authors = [e.text.strip() for e in find_all(root, "author")
                   if e.text and e.text.strip()]
        journal = find_text(root, "publicationName")
        year = find_text(root, "publicationYear")

    supported, unsupported = [], []
    for p in props:
        (supported if classify(p) else unsupported).append(p)

    return {
        "file": str(path),
        "dialect": dialect,
        "doi": doi,
        "title": title,
        "authors": authors,
        "journal": journal,
        "year": year,
        "compounds": comps,
        "propertiesSupported": sorted({classify(p) for p in supported}),
        "propertiesDeclared": sorted(set(props)),
        "propertiesUnsupported": sorted(set(unsupported)),
        "sha256": hashlib.sha256(path.read_bytes()).hexdigest(),
    }


#  ThermoML states a property's unit inside its name, after the comma:
#  "Vapor or sublimation pressure, kPa".  Choupo's dataset grammar wants the
#  unit in its own field, so it is SPLIT OUT here and REFUSED when absent --
#  a value whose unit had to be guessed is worse than no value.
def split_unit(prop_name: str):
    if "," not in prop_name:
        raise ValueError(
            f"property '{prop_name}' states no unit.  ThermoML carries the "
            f"unit inside the property name after a comma; without one the "
            f"numbers cannot be placed on any scale, and guessing kPa versus "
            f"Pa is the difference between a boiling point and a vacuum.")
    head, unit = prop_name.rsplit(",", 1)
    return head.strip(), unit.strip()


#  Spellings ThermoML uses that Choupo's tokenizer would not accept verbatim.
UNIT_MAP = {"kg/m3": "kg/m3", "K": "K", "kPa": "kPa", "MPa": "MPa",
            "Pa": "Pa", "J/K/mol": "J/mol/K", "J/mol/K": "J/mol/K"}


def extract_published(root, path, compounds=None):
    """(property -> {unit, vars[], points[]}) from one archive file.

    EVERY DECLARED VARIABLE IS A COLUMN (2026-09-09).  This function used to
    end with

        xnum, xval = next(iter(xs.items()))

    -- ONE variable per point, whichever the dict happened to yield first --
    and the block comment under `extract_binary_bubble` had NAMED that as the
    reason a second reader exists: "a binary bubble point has TWO variables,
    so reusing that path would silently keep whichever came first and emit
    plausible-looking garbage.  A parser that guesses is worse than no
    parser."  The rule was written down and then applied to exactly one
    dataset shape.

    WHAT IT COST, found by Vitor asking for better data for the green-ammonia
    loop.  `10.1021/acs.jced.7b00694` is 399 accurate (p, rho, T, x) points on
    the NITROGEN + HYDROGEN binary from 240 to 350 K and up to 20 MPa -- the
    synthesis loop's separator conditions exactly, and the only measured test
    of SRK with kij = 0 at those conditions that exists in the archive.  Its
    XML declares THREE variables: Temperature, Pressure, Mole fraction.  This
    reader wrote (T, rho) and threw the other two away, so the file carried
    five different densities at 240.046 K with nothing to tell them apart.
    Evidence that cannot be told apart is not evidence.

    The project had already ruled the principle on 2026-08-25 for the fitting
    side -- "A BUBBLE POINT IS (x, P, T), AND THE FIT NOW READS ALL THREE",
    `EvidencePoint` gaining a per-point pressure.  The CONSUMER learned it;
    the WRITER never did.

    Points are now dicts keyed by column name, and `vars` carries the ordered
    (name, unit) of every declared variable.  A composition variable is named
    by the COMPONENT it belongs to (`nOrgNum` into the file's own compound
    list), never by position.
    """
    out = {}
    comp_names = [c.get("name") or f"component{i+1}"
                  for i, c in enumerate(compounds or [])]
    for pom in find_all(root, "PureOrMixtureData"):
        props = {}
        for p in find_all(pom, "Property"):
            num = find_text(p, "nPropNumber")
            name = find_text(p, "ePropName")
            if num and name:
                props[num] = name
        #  ORDERED, and named from the DECLARED type -- never from position
        #  in the file and never from the order a dict happens to iterate.
        varinfo = {}
        for v in find_all(pom, "Variable"):
            num = find_text(v, "nVarNumber")
            kind, unit, org = _var_kind(v)
            if kind == "temperature":
                cname = "T"
            elif kind == "pressure":
                cname = "P"
            elif kind == "composition":
                who = ""
                try:
                    who = comp_names[int(org) - 1] if org else ""
                except (ValueError, IndexError):
                    who = ""
                cname = ("x_" + who.replace(" ", "_")) if who else f"x{num}"
            else:
                cname = f"var{num}"
            #  A DIMENSIONLESS variable declares no unit, because ThermoML
            #  carries the unit after a comma and a mole fraction has none.
            #  `split_unit` REFUSES an empty string -- rightly, for a
            #  PROPERTY, where guessing kPa versus Pa is the difference
            #  between a boiling point and a vacuum -- so the dimensionless
            #  case is named here rather than pushed through a guard whose
            #  subject is a different question.
            u = split_unit(unit)[1] if (unit and "," in unit) else "-"
            varinfo[num] = (cname, u or "-")
        order = sorted(varinfo)
        for nv in find_all(pom, "NumValues"):
            xs = {find_text(x, "nVarNumber"): find_text(x, "nVarValue")
                  for x in find_all(nv, "VariableValue")}
            for pv in find_all(nv, "PropertyValue"):
                pn = find_text(pv, "nPropNumber")
                val = find_text(pv, "nPropValue")
                if pn not in props or not val or not xs:
                    continue
                key = classify(props[pn])
                if key is None:
                    continue
                _, punit = split_unit(props[pn])
                cols = [varinfo[n] for n in order if n in varinfo]
                #  THE SHAPE IS PART OF THE KEY.  One archive file may carry
                #  SEVERAL `PureOrMixtureData` blocks, and they need not
                #  declare the same variables -- `10.1007/s10765-011-1120-x`
                #  reports the two PURE fluids (T, P) beside nothing else,
                #  where the binary study declares (T, P, x).  Keyed on the
                #  property alone, the first block would fix the column list
                #  and every later row would be appended under headings that
                #  do not describe it: a table whose columns are a claim about
                #  the numbers under them, made false by a block the reader
                #  never saw.  Distinct shapes become distinct records, and
                #  the writer names them apart.
                rec = out.setdefault((key, tuple(c[0] for c in cols)),
                                     {"unit": punit,
                                      "property": key,
                                      "vars": cols,
                                      "declaredAs": props[pn],
                                      "points": []})
                row = []
                ok = True
                for n in order:
                    if n not in xs or xs[n] is None:
                        ok = False
                        break
                    try:
                        row.append(float(xs[n]))
                    except (TypeError, ValueError):
                        ok = False
                        break
                if not ok:
                    continue
                rec["points"].append(tuple(row) + (float(val),))
    return out



# ===========================================================================
#  THE FIXED-PRESSURE BINARY BUBBLE-POINT READER
# ===========================================================================
#
#  ITS OWN READER, DELIBERATELY.  `extract_published` above takes
#  `next(iter(xs.items()))` -- ONE variable per point, whichever the dict
#  happens to yield first.  That is correct for a pure-component property
#  measured against temperature, and it is exactly the wrong shape here: a
#  binary bubble point has TWO variables (pressure and a composition), so
#  reusing that path would silently keep whichever came first and emit
#  plausible-looking garbage.  A parser that guesses is worse than no parser.
#
#  SO THIS ONE REQUIRES what it understands and REFUSES everything else BY
#  NAME.  It supports exactly:
#
#      fixed-pressure binary bubble-point evidence   (P, x1, T)
#
#  and refuses variable pressure, vapour compositions, more than two
#  components, and any other geometry -- stating what it DOES understand, so
#  the refusal carries its own remedy.

BUBBLE_SUPPORTED = ("fixed-pressure binary bubble-point evidence "
                    "(constant P, liquid mole fraction x1, bubble temperature T)")


class BubbleRefusal(Exception):
    """A dataset shape this extractor does not interpret.  Never a fallback."""


def _var_kind(v):
    """(kind, unit, orgNum) for one <Variable>: kind in {pressure, composition,
    temperature, other}.  Read from the DECLARED type element, never guessed
    from position."""
    unit, kind = "", "other"
    for e in v.iter():
        t, txt = local(e.tag), (e.text or "").strip()
        if not txt:
            continue
        if t.startswith("e") and "," in txt:
            unit = txt
        low = txt.lower()
        if "pressure" in low:
            kind = "pressure"
        elif "mole fraction" in low or "composition" in low:
            kind = "composition"
        elif "temperature" in low:
            kind = "temperature"
    org = find_text(v, "nOrgNum")
    return kind, unit, org


def extract_binary_bubble(root, path, block=None):
    """One binary bubble series, or a BubbleRefusal naming the shape.

    ONE ARTICLE, SEVERAL DATASETS (2026-08-25).  This used to loop over the
    file's <PureOrMixtureData> blocks and raise on the FIRST one that was not a
    binary bubble curve -- so a paper that reports a ternary before its two
    binaries was refused for the ternary, and the binaries were unreachable.
    Its own "no interpretable dataset found" line was dead code, because the
    loop could never reach it.

    Every block is examined now, and the refusals are COLLECTED rather than
    thrown at the first one.  Then:

      exactly one interpretable  -> use it; there is nothing to choose
      several                    -> REFUSE, listing them by index, and require
                                    `--block N`.  Picking one would be guessing
                                    which experiment the curator meant
      none                       -> REFUSE, naming each block's own reason

    `block` names an index into the file's blocks (not into the interpretable
    subset, which would shift as the reader improves).

    Returns {system, doi, points[(x1, T)], and either P_kPa or
    P_kPa_perPoint + isobars}."""
    comps = compounds_published(root)
    doi = find_text(root, "sDOI")

    poms = find_all(root, "PureOrMixtureData")
    if not poms:
        raise BubbleRefusal("the file declares no <PureOrMixtureData> block")

    if block is not None:
        if not 0 <= block < len(poms):
            raise BubbleRefusal(
                f"--block {block} is out of range: this file has "
                f"{len(poms)} dataset block(s), numbered 0..{len(poms)-1}")
        poms = [poms[block]]

    ok, refusals = [], []
    for idx, pom in enumerate(poms):
        try:
            ok.append((block if block is not None else idx,
                       _one_bubble_block(root, pom, comps, doi)))
        except BubbleRefusal as ex:
            refusals.append((block if block is not None else idx, str(ex)))

    if len(ok) == 1:
        ok[0][1]["block"] = ok[0][0]
        return ok[0][1]
    if len(ok) > 1:
        listing = "\n".join(
            f"      --block {i}   {r['system'][0]} + {r['system'][1]}, "
            f"{len(r['points'])} points, "
            + (f"{len(r['isobars'])} isobars {min(r['isobars'])}"
               f"..{max(r['isobars'])} kPa" if "isobars" in r
               else f"{r['P_kPa']} kPa")
            for i, r in ok)
        raise BubbleRefusal(
            f"this file carries {len(ok)} interpretable bubble-point"
            f" dataset(s), and choosing among them is the CURATOR's act, not"
            f" this tool's:\n" + listing +
            "\n    Name one with `--block N`.")
    detail = "\n".join(f"      block {i}: {why}" for i, why in refusals)
    raise BubbleRefusal(
        f"none of this file's {len(refusals)} dataset block(s) is a binary"
        f" bubble-point series:\n" + detail)


def _one_bubble_block(root, pom, comps, doi):
    """Interpret ONE <PureOrMixtureData> block, or raise BubbleRefusal."""
    members = [find_text(c, "nOrgNum") for c in find_all(pom, "Component")]
    if len(members) != 2:
        raise BubbleRefusal(
            f"this dataset declares {len(members)} component(s).  "
            f"Only BINARY systems are interpreted.")

    #  The property must be temperature, and there must be exactly one.
    props = {}
    for pr in find_all(pom, "Property"):
        num, name = find_text(pr, "nPropNumber"), find_text(pr, "ePropName")
        if num and name:
            props[num] = name
    if len(props) != 1:
        raise BubbleRefusal(
            f"this dataset declares {len(props)} properties "
            f"({', '.join(sorted(props.values())) or 'none'}).  A bubble "
            f"series carries exactly one: the temperature.")
    pnum, pname = next(iter(props.items()))
    if "temperature" not in pname.lower():
        raise BubbleRefusal(
            f"the measured property is '{pname}'.  This extractor reads "
            f"the BUBBLE TEMPERATURE; a dataset whose property is a "
            f"pressure or a composition is a different geometry.")

    #  The variables must be exactly {pressure, composition}.
    kinds = {}
    for v in find_all(pom, "Variable"):
        num = find_text(v, "nVarNumber")
        if num:
            kinds[num] = _var_kind(v)
    kindset = sorted(k for k, _, _ in kinds.values())

    #  A HELD-CONSTANT PRESSURE IS STILL A PRESSURE (2026-08-25).  ThermoML
    #  draws a first-class distinction between a Variable (measured per point)
    #  and a Constraint (fixed for the series), and an ISOBARIC study -- the
    #  commonest form of VLE there is -- declares its pressure as a
    #  CONSTRAINT.  This reader looked only at Variables, so it refused every
    #  such file with "the declared variables are ['composition']", which is
    #  true and unhelpful: the pressure was three lines away.
    #
    #  It is the same distinction EvidencePartition::loadColumns makes on the
    #  reading side, and the two halves have to agree or a faithful
    #  transcription of an isobar could be written and not read.
    pconst_kPa = None
    if "pressure" not in kindset:
        for c in find_all(pom, "Constraint"):
            unit = ""
            for e in c.iter():
                t = local(e.tag)
                if t == "ePressure" and e.text:
                    unit = e.text.strip()
            if not unit:
                continue
            if "kpa" not in unit.lower():
                raise BubbleRefusal(
                    f"the held-constant pressure is declared in '{unit}'.  "
                    f"Only kPa is read today; a unit conversion here would be "
                    f"a silent one.")
            val = find_text(c, "nConstraintValue")
            if val:
                pconst_kPa = float(val)
                kindset = sorted(kindset + ["pressure"])
                break

    if kindset != ["composition", "pressure"]:
        raise BubbleRefusal(
            f"the declared variables are {sorted(k for k, _, _ in kinds.values()) or ['none']}"
            f" and no held-constant pressure was found among the Constraints."
            f"  This extractor requires a liquid composition and a pressure "
            f"(either form) -- it does not choose among the variables "
            f"present, because choosing is guessing.")

    pvar = next((n for n, (k, _, _) in kinds.items() if k == "pressure"), None)
    xvar = next(n for n, (k, _, _) in kinds.items() if k == "composition")
    xorg = kinds[xvar][2]
    if xorg and xorg != members[0]:
        #  The composition names a component; x1 must be the FIRST, or the
        #  series would be reported against the wrong axis.
        members = [members[1], members[0]]

    if pvar is not None:
        punit = kinds[pvar][1]
        if "kpa" not in punit.lower():
            raise BubbleRefusal(
                f"the pressure is declared in '{punit}'.  Only kPa is read "
                f"today; a unit conversion here would be a silent one.")

    pressures, points, pressures_per_point = set(), [], []
    uncert_per_point = []
    for nv in find_all(pom, "NumValues"):
        xs = {find_text(x, "nVarNumber"): find_text(x, "nVarValue")
              for x in find_all(nv, "VariableValue")}
        if xvar not in xs or (pvar is not None and pvar not in xs):
            raise BubbleRefusal(
                "a data point declares only one of the two required "
                "variables -- the series is not a bubble curve.")
        if pvar is None:
            xs = dict(xs, **{"__const_P__": str(pconst_kPa)})
        tval, uval = "", ""
        for pv in find_all(nv, "PropertyValue"):
            if find_text(pv, "nPropNumber") == pnum:
                tval = find_text(pv, "nPropValue")
                #  THE DECLARED UNCERTAINTY TRAVELS WITH THE POINT (2026-09-28).
                #  ThermoML carries a per-point expanded uncertainty beside the
                #  value; it used to be read by nobody.  An absent one stays
                #  ABSENT (None), never zero: zero is a claim of perfection.
                uval = find_text(pv, "nCombExpandUncertValue")
        if not tval:
            continue
        pk = float(xs[pvar] if pvar is not None else xs["__const_P__"])
        pressures.add(round(pk, 6))
        points.append((float(xs[xvar]), float(tval)))
        pressures_per_point.append(pk)
        uncert_per_point.append(float(uval) if uval else None)

    #  VARIABLE PRESSURE IS NOW READ (2026-08-25), and the refusal that
    #  stood here was right on the day it was written.  It said: "the
    #  series spans N distinct pressures.  VARIABLE PRESSURE is a
    #  different geometry; this extractor reads a curve at ONE pressure."
    #  The reason was not the file -- it was the CONSUMER: `fitParameters
    #  (kind T_bubble)` read one scalar `residual.P` and priced every point
    #  at it, so a multi-isobar series could only have been fitted by
    #  discarding all but one pressure.  Writing it out would have handed
    #  the fit points it could not price.
    #
    #  The fit now takes a pressure PER POINT (docs/design/held-out-
    #  pressure.md), so the geometry is representable and the refusal has
    #  lost its reason.  Removing a guard because its cause is gone is a
    #  different act from weakening one, and this comment is here so the
    #  next reader can tell which happened.
    if len(points) < 2:
        raise BubbleRefusal("fewer than two usable points")

    #  A REPEATED OBSERVATION IS REFUSED, NOT DEDUPLICATED (2026-09-28).
    #  Found on the first multi-isobar file chosen for a fit
    #  (j.fluid.2015.12.029, block 9): every (x, P, T) row appears TWICE, so a
    #  regression would weight each measurement double and report twice the
    #  degrees of freedom it has.  Whether the article printed two identical
    #  tables or the transcription doubled one is a question for the article;
    #  silently keeping one copy would answer it without reading it.
    seen, dup = set(), []
    for (x, t), pk in zip(points, pressures_per_point):
        key = (x, t, round(pk, 6))
        if key in seen:
            dup.append(key)
        seen.add(key)
    if dup:
        raise BubbleRefusal(
            f"{len(dup)} of {len(points)} (x, P, T) rows repeat an earlier "
            f"row exactly (first: x = {dup[0][0]}, P = {dup[0][2]} kPa, "
            f"T = {dup[0][1]} K).  A duplicated observation would count twice "
            f"in a fit; read the article before choosing one copy.")

    #  THE NAMES MUST FOLLOW `members`, NOT THE DOCUMENT ORDER.  Found
    #  2026-08-25 on the first real multi-isobar file, and it is a
    #  pre-existing defect of exactly the class this project polices: a
    #  plausible number on the wrong axis.
    #
    #  `members` is the BLOCK's <Component> order, already swapped above so
    #  that members[0] is the compound the composition variable names.
    #  `comps` is the FILE's <Compound> order.  They coincide in most
    #  files -- which is why the fixture never caught this -- and in
    #  j.fluid.2011.06.009 they do not: the file declares water(1) then
    #  ethanol(2), the block declares Components (2, 1), and the mole
    #  fraction is ethanol's.  Taking `comps[:2]` therefore labelled an
    #  x_ethanol column `x1 is water`, with the data untouched and correct
    #  underneath it.  A wrong axis label on right numbers is worse than
    #  wrong numbers, because nothing downstream can detect it.
    by_org = {}
    for c, org in zip(comps, [find_text(x, "nOrgNum")
                              for x in find_all(root, "Compound")]):
        if org:
            by_org[org] = c["name"]
    names = [by_org.get(m, "") for m in members]
    if not all(names):
        raise BubbleRefusal(
            "a component of this dataset could not be resolved to a "
            "compound name by its RegNum.  The axis of x1 would be a "
            "guess, and a mislabelled axis is a wrong answer that nothing "
            "downstream can detect.")
    #  The confidence level the uncertainties are stated at, read off the
    #  PROPERTY's own CombinedUncertainty (per series, not per point).
    level = ""
    for pr in find_all(pom, "Property"):
        if find_text(pr, "nPropNumber") == pnum:
            level = find_text(pr, "nCombUncertLevOfConfid")
    order = sorted(range(len(points)), key=lambda k: points[k])
    rec = {
        "system": names[:2],
        #  The block's own member org numbers, in `system` order -- so a
        #  caller can reach each member's InChI/InChIKey without matching
        #  anything by name.
        "members": members[:2],
        "doi": doi,
        "points": sorted(points),
        "uT": [uncert_per_point[k] for k in order],
        "uT_level": level,
    }
    if len(pressures) == 1:
        #  Held CONSTANT: keep it a scalar, which is what ThermoML's own
        #  Constraint means and what a faithful transcription writes.
        rec["P_kPa"] = next(iter(pressures))
    else:
        #  VARIED: it becomes a column, one value per point, in the same
        #  order as `points`.  A study that measured three isobars has
        #  said something a single-isobar study cannot, and flattening it
        #  to a mean would destroy exactly that.
        rec["P_kPa_perPoint"] = [p for _, p in sorted(
            zip(points, pressures_per_point), key=lambda z: z[0])]
        rec["isobars"] = sorted(pressures)
    return rec


def cmd_extract(a):
    cache = cache_root()
    idx = cache / "index.json"
    if not idx.exists():
        print(f"choupo-thermoml extract: no index at {idx}.  Run `index` first.")
        return 1
    index = json.loads(idx.read_text())
    hits = index["byKey"].get(a.query.strip().lower(), [])
    if not hits:
        print(f"choupo-thermoml extract: nothing matches '{a.query}'.")
        return 1

    dest = pathlib.Path(a.into)
    dest.mkdir(parents=True, exist_ok=True)
    written, skipped = [], []

    for h in hits:
        src = pathlib.Path(h["file"])
        root = ET.parse(src).getroot()
        dialect = detect_dialect(root)
        if dialect != "published":
            #  Honest scope: the archive is the published dialect, and value
            #  extraction was built and tested against it.  A v5 file is
            #  NAMED and skipped rather than run through a reader that was
            #  never meant for it.
            skipped.append((src.name, f"dialect '{dialect}' -- value "
                            f"extraction is implemented for the published "
                            f"dialect (the archive's) only"))
            continue
        #  WHAT SYSTEM IS THIS FILE ABOUT?  The index hit carries the compound
        #  the CALLER asked for; the file carries the compounds it MEASURED,
        #  and until 2026-09-09 only the first reached the written header.
        #
        #  FOUND BY VITOR asking for better ammonia data.  `extract ammonia`
        #  wrote TWELVE files each headed `compound ammonia / property
        #  vapourPressure`, with a DOI and a sha256 -- and every one was a
        #  MIXTURE study: ammonia + HFO-1234yf, ammonia + LiNO3 + water, and
        #  "Experimental Investigation of the Solubility of Ammonia in
        #  Methanol".  The total pressure over a mixture is not the pure
        #  compound's saturation pressure.  Fit an Antoine to one and you get a
        #  WRONG RECORD CARRYING A TRUE PRIMARY CITATION -- unsourced turned
        #  into falsely sourced, which philosophy section 4 names as the one
        #  thing worse than a visible gap, and which no gate downstream can
        #  detect.  Measured: the shipped ammonia Antoine reads AAD 32 % and
        #  1762 % against two of them, both meaningless numbers a student
        #  would act on.
        #
        #  Every property this tool reads (vapourPressure, liquidDensity,
        #  heatCapacity) is a PURE-COMPONENT property as it writes them, so
        #  the rule is one line: more than one compound, and it refuses by
        #  name.  `--allow-mixture` is the curator's deliberate act, and the
        #  header then says what the file really is.
        comps = [c.get("name") or "(unnamed)" for c in compounds_published(root)]
        system = " + ".join(comps) if comps else "(no compound declared)"
        if len(comps) > 1 and not a.allow_mixture:
            skipped.append((src.name, f"MULTI-COMPONENT file ({system}) -- its "
                            f"'{h['compound']}' rows are a property of that "
                            f"MIXTURE, not of pure {h['compound']}; writing "
                            "them under a pure-component header would attach a "
                            "true DOI to a false claim.  Pass --allow-mixture "
                            "if you want the mixture data (for a Henry or VLE "
                            "fit); the header will name the system"))
            continue
        try:
            found = extract_published(root, src, compounds_published(root))
        except ValueError as exc:
            skipped.append((src.name, str(exc)))
            continue
        shapes = {}
        for (prop, _sig) in found:
            shapes[prop] = shapes.get(prop, 0) + 1
        nth = {}
        for (prop, _sig), rec in found.items():
            if not rec["points"]:
                continue
            #  A SUFFIX ONLY WHERE ONE IS EARNED: a property that yielded a
            #  single shape keeps the name every earlier extraction wrote.
            nth[prop] = nth.get(prop, 0) + 1
            shape_tag = f"-{nth[prop]}" if shapes[prop] > 1 else ""
            #  THE SOURCE STEM IS PART OF THE NAME, and it is not cosmetic.
            #  Naming by <compound>-<property>alone made two INDEPENDENT
            #  datasets for the same property collide, and the second silently
            #  overwrote the first -- so a partition that believed it had
            #  held-out evidence would have had one file twice.  A collision
            #  that destroys the very independence the contract rests on must
            #  not be possible by construction.
            name = (f"{h['compound']}-{prop}-{src.stem}{shape_tag}"
                    .replace(" ", "_"))
            out = dest / f"{name}.dat"
            sha = hashlib.sha256(src.read_bytes()).hexdigest()
            lines = [
                "/*--------------------------------------------------------------------------*\\",
                f"  EXPERIMENTAL EVIDENCE extracted from a local ThermoML archive file.",
                "",
                f"  compound     {h['compound']}",
                f"  system       {system}"
                + ("   <-- MIXTURE: the values below are a property of THIS "
                   "SYSTEM,\n               not of the compound alone"
                   if len(comps) > 1 else "   (single-component study)"),
                f"  property     {prop}   (declared as '{rec['declaredAs']}')",
                f"  points       {len(rec['points'])}",
                f"  DOI          {h['doi'] or '(none declared in the file)'}",
                f"  source       {src.name}",
                f"  sha256       {sha}",
                "",
                "  NOT REDISTRIBUTED BY CHOUPO.  This file was generated on this machine",
                "  from an archive copy the user obtained themselves; the archive is not",
                "  part of Choupo and no part of it enters the repository.  Cite the DOI",
                "  above -- the PRIMARY publication -- never the archive's arrangement.",
                "",
                "  The role this evidence plays (fit or held-out validation) is NOT set",
                "  here: it is declared in the operation that consumes it, before any",
                "  fitting runs.  See src/propertyOps/EvidencePartition.H.",
                "\\*--------------------------------------------------------------------------*/",
                "",
                #  A DECLARED FIELD, not a filename convention.  A consumer
                #  that recovered the property by splitting the filename would
                #  be doing identity-by-name, which this project bans for
                #  exactly the reason it bit here: the name also carries the
                #  source stem, and parsing it gave `vapourPressure-published-
                #  water` as a property.
                f"property     {prop};",
                f"compound     {h['compound']};",
                #  DECLARED, so a consumer never has to trust the header prose
                #  or the filename for the one fact that decides whether these
                #  numbers are a pure-component property at all.
                "system       ( " + " ".join(c.replace(" ", "_") for c in comps)
                + " );",
                "", "columns", "(",
            ]
            #  ONE COLUMN PER DECLARED VARIABLE, then the property.  Not a
            #  fixed (T, y) pair: see extract_published's docstring for the
            #  399-point dataset that pair silently destroyed.
            for cname, cunit in rec["vars"]:
                lines.append(f"    {{ name {cname};  "
                             f"unit {UNIT_MAP.get(cunit, cunit)}; }}")
            yname = ("Psat" if prop == "vapourPressure"
                     else "rho" if prop == "liquidDensity" else "Cp")
            lines.append(f"    {{ name {yname};  "
                         f"unit {UNIT_MAP.get(rec['unit'], rec['unit'])}; }}")
            lines += [");", "", "data", "("]
            for row in sorted(rec["points"]):
                lines.append("    " + "  ".join(f"{v:.10g}" for v in row))
            lines += [");", ""]
            out.write_text("\n".join(lines))
            written.append((str(out), len(rec["points"])))

    for w, n in written:
        print(f"choupo-thermoml extract: {w}  ({n} points)")
    for name, why in skipped:
        print(f"  SKIPPED {name}: {why}")
    if not written:
        print("choupo-thermoml extract: nothing extracted -- every candidate "
              "was skipped for the reason named above.")
        return 1
    return 0



#  ---------------------------------------------------------------------------
#  IDENTITY: ARCHIVE COMPOUND -> CHOUPO COMPONENT, BY IDENTIFIER (2026-09-28).
#
#  The archive identifies a compound by its standard InChI and InChIKey and,
#  in the files NIST actually ships, by NO CAS number at all (measured: 0 of
#  58 276 binary blocks carry one).  The catalogue identifies a component by
#  its CAS number and carries no InChIKey.  So the two cannot be joined
#  directly, and the tool used to join them by the only thing they share --
#  the NAME ("ethanol" in both) -- which is right for ethanol and wrong for
#  "propan-2-ol" against `isopropanol`, and is the name identity this project
#  bans.
#
#  The bridge is built ONCE, at curation time, from the catalogue's own CAS:
#  two independent resolvers (PubChem PUG REST and NCI CACTUS) are asked for
#  the standard InChIKey of each CAS, and the answer is accepted only when
#  they AGREE and the molecular formula PubChem returns matches the record's
#  own `formula` (when it declares one).  Anything else is listed, never
#  guessed.  The bridge is a cache on the curator's machine
#  (identity.json, gitignored with the archive); the extracted dataset
#  records the CAS and the InChIKey it was joined on, so a reader can check
#  the join without re-running it.
#  ---------------------------------------------------------------------------
PUBCHEM = ("https://pubchem.ncbi.nlm.nih.gov/rest/pug/compound/name/{}/"
           "property/InChIKey,MolecularFormula/JSON")
CACTUS = "https://cactus.nci.nih.gov/chemical/structure/{}/stdinchikey"
IDENTITY_RULE = ("the archive's standard InChIKey matched to the catalogue "
                 "record's CAS through two resolvers that agree (PubChem PUG "
                 "REST and NCI CACTUS), molecular formula checked -- never "
                 "by name")


def _formula_counts(f: str):
    """Element counts of a molecular formula ('C2H6O' -> {C:2, H:6, O:1})."""
    out = {}
    for el, n in re.findall(r"([A-Z][a-z]?)(\d*)", f or ""):
        out[el] = out.get(el, 0) + (int(n) if n else 1)
    return out


def _catalogue_identities():
    """(component, CAS, formula) for every catalogue record declaring a CAS."""
    rows = []
    for f in sorted((ROOT / "data" / "standards" / "components").glob("*.dat")):
        t = f.read_text(errors="ignore")
        m = re.search(r"^\s*CAS\s+([0-9]+-[0-9]+-[0-9])\s*;", t, re.M)
        if not m:
            continue
        fm = re.search(r"^\s*formula\s+([A-Za-z0-9]+)\s*;", t, re.M)
        rows.append((f.stem, m.group(1), fm.group(1) if fm else ""))
    return rows


def _ask_pubchem(cas):
    txt = _fetch(PUBCHEM.format(urllib.parse.quote(cas)), text=True)
    props = json.loads(txt)["PropertyTable"]["Properties"]
    return sorted({(p["InChIKey"], p.get("MolecularFormula", "")) for p in props})


def _ask_cactus(cas):
    txt = _fetch(CACTUS.format(urllib.parse.quote(cas)), text=True).strip()
    return sorted({ln.split("=", 1)[-1].strip() for ln in txt.splitlines()
                   if ln.strip()})


def cmd_identity(a):
    """Build the CAS -> InChIKey bridge for the catalogue."""
    cache = cache_root()
    cache.mkdir(parents=True, exist_ok=True)
    out = cache / "identity.json"
    old = json.loads(out.read_text()) if out.exists() and not a.refresh else {}
    prev = {r["component"]: r for r in old.get("records", [])}
    records = []
    rows = _catalogue_identities()
    for i, (comp, cas, formula) in enumerate(rows):
        #  A settled answer is reused; an INCOMPLETE one (a resolver could
        #  not be reached) is asked again -- a network error is not a finding
        #  about the compound.
        if comp in prev and prev[comp].get("cas") == cas and not a.refresh \
                and prev[comp].get("status") != "incomplete":
            records.append(prev[comp])
            continue
        rec = {"component": comp, "cas": cas, "formula": formula}
        def _ask(fn, tries=3):
            last = None
            for k in range(tries):
                try:
                    return fn(cas), None
                except urllib.error.HTTPError as ex:
                    if ex.code == 404:          # the resolver ANSWERED: unknown
                        return [], None
                    last = ex
                except Exception as ex:         # transport: worth a retry
                    last = ex
                time.sleep(1.0 + k)
            return [], f"{type(last).__name__}: {last}"[:120]
        pc, err = _ask(_ask_pubchem)
        if err:
            rec["pubchemError"] = err
        ca, err = _ask(_ask_cactus)
        if err:
            rec["cactusError"] = err
        rec["pubchem"] = [k for k, _ in pc]
        rec["cactus"] = ca
        keys_pc, keys_ca = {k for k, _ in pc}, set(ca)
        if len(keys_pc) == 1 and keys_pc == keys_ca:
            key = next(iter(keys_pc))
            pf = pc[0][1]
            if formula and _formula_counts(formula) != _formula_counts(pf):
                rec["status"] = "formulaMismatch"
                rec["note"] = f"record formula {formula} vs PubChem {pf}"
            else:
                rec["status"] = "resolved"
                rec["inchiKey"] = key
                rec["formulaChecked"] = bool(formula)
        elif rec.get("pubchemError") or rec.get("cactusError"):
            #  One resolver could not be REACHED.  That is not a disagreement
            #  and not an absence; it is an unanswered question.
            rec["status"] = "incomplete"
        elif not keys_pc and not keys_ca:
            rec["status"] = "unresolved"
        else:
            rec["status"] = "disagree"
        records.append(rec)
        if (i + 1) % 25 == 0:
            sys.stderr.write(f"\r  {i + 1} / {len(rows)}")
        time.sleep(0.2)          # PubChem asks for at most 5 requests per second
    sys.stderr.write("\n")
    by_key = {}
    for r in records:
        if r.get("status") == "resolved":
            by_key.setdefault(r["inchiKey"], []).append(r["component"])
    doc = {"rule": IDENTITY_RULE, "resolvedOn": time.strftime("%Y-%m-%d"),
           "resolvers": ["PubChem PUG REST", "NCI CACTUS"],
           "records": records, "byInchiKey": by_key}
    out.write_text(json.dumps(doc, indent=1, sort_keys=True))
    counts = {}
    for r in records:
        counts[r["status"]] = counts.get(r["status"], 0) + 1
    print(f"choupo-thermoml identity: {len(records)} catalogue record(s) with a CAS")
    for k in sorted(counts):
        print(f"  {k:<16} {counts[k]}")
    for r in records:
        if r["status"] != "resolved":
            print(f"  {r['status']:<16} {r['component']} (CAS {r['cas']})"
                  + (f" -- {r['note']}" if r.get("note") else ""))
    amb = {k: v for k, v in by_key.items() if len(v) > 1}
    for k, v in sorted(amb.items()):
        print(f"  AMBIGUOUS        {k} is claimed by {', '.join(v)} -- no "
              f"dataset naming it will be joined")
    print(f"  wrote {out}")
    return 0


def _identity_map():
    """InChIKey -> (component, CAS) for resolved, unambiguous records."""
    f = cache_root() / "identity.json"
    if not f.exists():
        return None
    doc = json.loads(f.read_text())
    out = {}
    for r in doc["records"]:
        if r.get("status") != "resolved":
            continue
        if len(doc["byInchiKey"].get(r["inchiKey"], [])) != 1:
            continue
        out[r["inchiKey"]] = (r["component"], r["cas"])
    return out


#  ---------------------------------------------------------------------------
#  THE VLE INDEX: one row per BINARY vapour-liquid block, searchable by
#  component, CAS, InChIKey, geometry, pressure and temperature.
#
#  `index` answers "which ARTICLES mention this compound?".  Fitting a pair
#  needs a sharper question -- "which binary DATASETS measured this pair, in
#  what geometry, at what pressure, over what temperatures, with or without a
#  stated uncertainty?" -- and answering it by opening XML files one by one is
#  how a curator ends up fitting to whatever they found first.  This index is
#  the finding aid for that choice; it copies NO data point.
#  ---------------------------------------------------------------------------
def _block_geometry(props, variables):
    """Name the geometry from DECLARED property/variable types and phases."""
    pn = [(n.split(",")[0].lower(), ph) for n, ph, _ in props]
    vn = [(n.split(",")[0].lower(), ph) for n, ph, _ in variables]
    xL = ("mole fraction", "Liquid") in vn
    if pn == [("boiling temperature at pressure p", "Liquid")] and xL:
        return "bubbleT"
    if len(pn) == 1 and pn[0][0] == "mole fraction" and pn[0][1] == "Gas" and xL:
        return "vapourComposition"
    if len(pn) == 1 and pn[0][0] == "vapor or sublimation pressure" and xL:
        return "bubbleP"
    if len(pn) == 1 and pn[0][0] == "activity coefficient":
        return "activityCoefficient"
    return "other"


def _read_vle_blocks(path):
    root = ET.parse(path).getroot()
    if detect_dialect(root) != "published":
        return []
    comps = {}
    for c in find_all(root, "Compound"):
        comps[find_text(c, "nOrgNum")] = {
            "name": find_text(c, "sCommonName"),
            "inchi": find_text(c, "sStandardInChI"),
            "inchiKey": find_text(c, "sStandardInChIKey")}
    cite = {"doi": find_text(root, "sDOI"), "year": find_text(root, "yrPubYr"),
            "journal": find_text(root, "sPubName"),
            "title": find_text(root, "sTitle")}
    rows = []
    for bi, pom in enumerate(find_all(root, "PureOrMixtureData")):
        members = [find_text(c, "nOrgNum") for c in find_all(pom, "Component")]
        if len(members) != 2:
            continue
        phases = sorted({(e.text or "").strip() for e in find_all(pom, "ePhase")})
        if phases != ["Gas", "Liquid"]:
            continue
        props = []
        for p in find_all(pom, "Property"):
            props.append((find_text(p, "ePropName"), find_text(p, "ePropPhase"),
                          find_text(p, "nPropNumber")))
        variables = []
        for v in find_all(pom, "Variable"):
            kind, unit, org = _var_kind(v)
            name = ""
            for e in v.iter():
                if local(e.tag).startswith("e") and local(e.tag) != "eVarPhase" \
                        and e.text and e.text.strip():
                    name = e.text.strip()
            variables.append((name, find_text(v, "eVarPhase"),
                              find_text(v, "nVarNumber")))
        geom = _block_geometry(props, variables)
        #  Temperature and pressure spans, from the DECLARED types only:
        #  "Boiling temperature at pressure P" is a temperature, whatever the
        #  word "pressure" inside its name suggests.
        tnum = {n for nm, _, n in variables if nm.lower().startswith("temperature")}
        pnum = {n for nm, _, n in variables if nm.lower().startswith("pressure")}
        tprop = {n for nm, _, n in props if "temperature" in nm.lower().split(",")[0]}
        pprop = {n for nm, _, n in props
                 if nm.lower().startswith(("vapor or sublimation pressure", "pressure"))}
        T, P, hasU = [], [], False
        for nv in find_all(pom, "NumValues"):
            for vv in find_all(nv, "VariableValue"):
                k, val = find_text(vv, "nVarNumber"), find_text(vv, "nVarValue")
                try:
                    f = float(val)
                except ValueError:
                    continue
                if k in tnum:
                    T.append(f)
                if k in pnum:
                    P.append(f)
            for pv in find_all(nv, "PropertyValue"):
                k, val = find_text(pv, "nPropNumber"), find_text(pv, "nPropValue")
                if find_text(pv, "nCombExpandUncertValue") or \
                        find_text(pv, "nStdUncertValue"):
                    hasU = True
                try:
                    f = float(val)
                except ValueError:
                    continue
                if k in tprop:
                    T.append(f)
                if k in pprop:
                    P.append(f)
        for c in find_all(pom, "Constraint"):
            unit = ""
            for e in c.iter():
                if local(e.tag) in ("eTemperature", "ePressure") and e.text:
                    unit = e.text.strip()
            try:
                f = float(find_text(c, "nConstraintValue"))
            except ValueError:
                continue
            if unit.lower().startswith("temperature"):
                T.append(f)
            elif unit.lower().startswith("pressure"):
                P.append(f)
        rows.append({
            "file": str(path.relative_to(cache_root())),
            "block": bi, **cite,
            "compounds": [comps.get(m, {}) for m in members],
            "geometry": geom,
            "properties": [(n, ph) for n, ph, _ in props],
            "variables": [(n, ph) for n, ph, _ in variables],
            "points": len(find_all(pom, "NumValues")),
            "T_K": [min(T), max(T)] if T else None,
            #  The archive's pressure unit is kPa throughout the blocks this
            #  index classifies; a block declaring another is not summarised.
            "P_kPa": [min(P), max(P)] if P else None,
            "uncertaintyDeclared": hasU,
        })
    return rows


def cmd_vle_index(a):
    cache = cache_root()
    files = sorted(cache.rglob("*.xml"))
    if not files:
        print(f"choupo-thermoml vle-index: {cache} holds no .xml files.  Run "
              f"`sync` first; an index over nothing is not a clean archive.")
        return 1
    ident = _identity_map()
    if ident is None:
        print("choupo-thermoml vle-index: no identity.json -- run "
              "`choupo-thermoml identity` first.  Without it no archive "
              "compound can be joined to a catalogue component, and the index "
              "would say every pair is unknown to Choupo.")
        return 1
    rows, refused = [], []
    for f in files:
        try:
            rows.extend(_read_vle_blocks(f))
        except ET.ParseError as ex:
            refused.append((f.name, str(ex)))
    for r in rows:
        for c in r["compounds"]:
            hit = ident.get(c.get("inchiKey", ""))
            if hit:
                c["component"], c["cas"] = hit
    out = cache / "vleIndex.json"
    doc = {"archive": SYNC_TARBALL, "archiveDoi": ARCHIVE_DOI,
           "identity": IDENTITY_RULE, "blocks": rows}
    out.write_text(json.dumps(doc, indent=0, sort_keys=True))
    geo = {}
    joined = 0
    for r in rows:
        geo[r["geometry"]] = geo.get(r["geometry"], 0) + 1
        if all(c.get("component") for c in r["compounds"]):
            joined += 1
    print(f"choupo-thermoml vle-index: {len(rows)} binary vapour-liquid "
          f"block(s) from {len(files)} file(s)")
    for g in sorted(geo):
        print(f"  {g:<22} {geo[g]}")
    print(f"  {joined} block(s) join BOTH compounds to a catalogue component "
          f"by InChIKey")
    for n, why in refused:
        print(f"  REFUSED {n}: {why}")
    print(f"  wrote {out}")
    return 0


def cmd_vle_search(a):
    f = cache_root() / "vleIndex.json"
    if not f.exists():
        print("choupo-thermoml vle-search: no vleIndex.json -- run "
              "`choupo-thermoml vle-index` first.")
        return 1
    rows = json.loads(f.read_text())["blocks"]

    def matches(c, q):
        q = q.lower()
        return q in {(c.get(k) or "").lower()
                     for k in ("component", "cas", "inchiKey", "name")}
    hits = []
    for r in rows:
        c1, c2 = r["compounds"]
        if a.geometry and r["geometry"] != a.geometry:
            continue
        ok = any(matches(c, a.a) for c in (c1, c2))
        if a.b:
            ok = (matches(c1, a.a) and matches(c2, a.b)) or \
                 (matches(c1, a.b) and matches(c2, a.a))
        if not ok:
            continue
        if a.pmax is not None and (not r["P_kPa"] or r["P_kPa"][1] > a.pmax):
            continue
        hits.append(r)
    hits.sort(key=lambda r: (r["geometry"], r["doi"], r["block"]))
    print(f"choupo-thermoml vle-search: {len(hits)} block(s)")
    for r in hits:
        c1, c2 = r["compounds"]
        nm = lambda c: c.get("component") or f"({c.get('name')}, not in catalogue)"
        P = r["P_kPa"]
        T = r["T_K"]
        print(f"  {r['geometry']:<18} {nm(c1)} + {nm(c2)}   {r['points']:>3} pts"
              f"   P {P[0]:g}-{P[1]:g} kPa" if P else "   P ?", end="")
        print(f"   T {T[0]:g}-{T[1]:g} K" if T else "   T ?", end="")
        print("   U declared" if r["uncertaintyDeclared"] else "   U none")
        print(f"      doi {r['doi']}  ({r['year']})  {r['file']}  --block {r['block']}")
    return 0


def _vapour_series(root, pom_t, rec):
    """y of the SAME component at the SAME liquid compositions, from a
    companion block of the same file -- or None, with the reason.

    ThermoML stores a T-x-y measurement as TWO blocks: the bubble
    temperature against x, and the vapour mole fraction against x, each under
    the same held pressure.  They are joined here only when the companion is
    unambiguous: same members, the vapour fraction OF THE SAME component the
    liquid fraction names, the same held pressure, and an identical set of x
    values.  Anything else is reported and left out; a y paired with the
    wrong x would be a plausible number on the wrong point."""
    if "P_kPa" not in rec:
        return None, "the series varies its pressure; no vapour column is joined"
    want = set(rec["members"])
    comp_org = rec["members"][0]
    xs = [x for x, _ in rec["points"]]
    cands = []
    for pom in find_all(root, "PureOrMixtureData"):
        if pom is pom_t:
            continue
        mem = [find_text(c, "nOrgNum") for c in find_all(pom, "Component")]
        if set(mem) != want:
            continue
        props = [(find_text(p, "ePropName"), find_text(p, "ePropPhase"),
                  find_text(p, "nOrgNum"), find_text(p, "nPropNumber"))
                 for p in find_all(pom, "Property")]
        if len(props) != 1 or not props[0][0].lower().startswith("mole fraction") \
                or props[0][1] != "Gas":
            continue
        if props[0][2] and props[0][2] != comp_org:
            continue
        pc = None
        for c in find_all(pom, "Constraint"):
            try:
                pc = float(find_text(c, "nConstraintValue"))
            except ValueError:
                pass
        if pc is None or abs(pc - rec["P_kPa"]) > 1e-9:
            continue
        xvar = None
        for v in find_all(pom, "Variable"):
            kind, _, org = _var_kind(v)
            if kind == "composition" and (not org or org == comp_org):
                xvar = find_text(v, "nVarNumber")
        if xvar is None:
            continue
        pairs = {}
        for nv in find_all(pom, "NumValues"):
            xv = [find_text(x, "nVarValue") for x in find_all(nv, "VariableValue")
                  if find_text(x, "nVarNumber") == xvar]
            yv = [find_text(p, "nPropValue") for p in find_all(nv, "PropertyValue")
                  if find_text(p, "nPropNumber") == props[0][3]]
            if xv and yv:
                pairs.setdefault(float(xv[0]), []).append(float(yv[0]))
        cands.append(pairs)
    if not cands:
        return None, "no companion vapour-composition block in this file"
    if len(cands) > 1:
        return None, (f"{len(cands)} companion vapour-composition blocks match; "
                      "choosing among them would be a guess")
    pairs = cands[0]
    if sorted(pairs) != sorted(xs) or any(len(v) != 1 for v in pairs.values()):
        return None, ("the companion vapour block's liquid compositions do not "
                      "coincide one-for-one with this series")
    return [pairs[x][0] for x in xs], "joined"


def cmd_extract_vle(a):
    """Write ONE Choupo dataset from a binary bubble-point block."""
    src = pathlib.Path(a.file)
    if not src.is_file():
        print(f"choupo-thermoml extract-vle: no such file: {src}")
        return 1
    try:
        root = ET.parse(src).getroot()
    except ET.ParseError as ex:
        print(f"choupo-thermoml extract-vle: {src.name} is not parseable XML: {ex}")
        return 1

    dialect = detect_dialect(root)
    if dialect != "published":
        print(f"choupo-thermoml extract-vle: REFUSED\n"
              f"  {src.name} is the '{dialect}' dialect.  The bubble-point "
              f"reader is written against the published archive dialect only.")
        return 1

    try:
        rec = extract_binary_bubble(root, src, block=a.block)
    except BubbleRefusal as ex:
        #  THE REFUSAL NAMES WHAT IS SUPPORTED, so it carries its own remedy.
        print(f"choupo-thermoml extract-vle: REFUSED\n"
              f"  This extractor supports {BUBBLE_SUPPORTED}.\n"
              f"  {src.name}: {ex}\n"
              f"  Nothing was written.  A dataset of another geometry -- "
              f"more than two components, VLLE, a pressure or a composition "
              f"as the measured property -- is NOT reduced to a shape it does "
              f"not have; reducing it would produce plausible numbers from a "
              f"misreading.")
        return 1

    syn = a.provenance == "synthetic"
    #  THE COMPONENTS ARE NAMED BY IDENTIFIER, NOT BY THE ARCHIVE'S NAME.
    #  A measured dataset is joined to the catalogue through the InChIKey
    #  bridge, and REFUSES when a member cannot be joined.  A synthetic
    #  fixture carries no identifier by construction, keeps the name it was
    #  written with, and says so in the file.
    orgs = {find_text(c, "nOrgNum"): c for c in find_all(root, "Compound")}
    identity = []
    if not syn:
        ident = _identity_map()
        if ident is None:
            print("choupo-thermoml extract-vle: REFUSED\n"
                  "  no identity.json in the cache.  Run `choupo-thermoml "
                  "identity` first: a measured dataset is joined to a "
                  "catalogue component by InChIKey, never by the archive's "
                  "compound name.")
            return 1
        names = []
        for org, arch_name in zip(rec["members"], rec["system"]):
            key = find_text(orgs.get(org, root), "sStandardInChIKey") \
                if org in orgs else ""
            hit = ident.get(key)
            if not hit:
                print("choupo-thermoml extract-vle: REFUSED\n"
                      f"  the archive compound '{arch_name}' (InChIKey "
                      f"{key or 'none declared'}) resolves to NO catalogue "
                      "component through the identity bridge.  Either the "
                      "catalogue does not describe it, or `identity` could not "
                      "resolve its CAS -- run `identity` and read its list.  "
                      "Guessing from the name is the join this tool refuses.")
                return 1
            names.append(hit[0])
            identity.append((hit[0], hit[1], key))
        rec["system"] = names
    c1, c2 = rec["system"]

    pts, uT = rec["points"], rec["uT"]
    ypts, yreason = (None, "not requested")
    if not a.no_vapour:
        ypts, yreason = _vapour_series(root, _find_block(root, rec, a.block), rec)
    keep = list(range(len(pts)))
    dropped = []
    if a.interior_only:
        keep = [k for k in keep if 0.0 < pts[k][0] < 1.0]
        dropped = [k for k in range(len(pts)) if k not in keep]
        if len(keep) < 2:
            print("choupo-thermoml extract-vle: REFUSED\n"
                  "  fewer than two interior points remain after setting the "
                  "pure-component endpoints aside.")
            return 1

    dest = pathlib.Path(a.into)
    dest.mkdir(parents=True, exist_ok=True)
    sha = hashlib.sha256(src.read_bytes()).hexdigest()
    sysname = f"{c1}-{c2}".replace(" ", "_")
    out = dest / f"{sysname}-bubble-{src.stem}.dat"

    varying = "P_kPa_perPoint" in rec
    doi = rec["doi"] or "none-declared"
    authors = [e.text.strip() for e in find_all(root, "sAuthor")
               if e.text and e.text.strip()]
    journal, year = find_text(root, "sPubName"), find_text(root, "yrPubYr")
    title = find_text(root, "sTitle")
    au = "; ".join(x.split("[")[0].strip() for x in authors[:6])
    if len(authors) > 6:
        au += " et al."
    citation = f"{au} ({year}). {title}. {journal}. doi:{doi}".replace('"', "'")

    if varying:
        lo, hi = min(rec["isobars"]), max(rec["isobars"])
        pline = (f"  pressure     {len(rec['isobars'])} isobars, {lo} .. {hi} kPa"
                 f"   (a COLUMN: each point at its own)")
    else:
        pline = f"  pressure     {rec['P_kPa']} kPa   (CONSTANT across the series)"
    lines = [
        "/*--------------------------------------------------------------------------*\\",
        "  BINARY BUBBLE-POINT EVIDENCE, extracted from a ThermoML file by",
        "  bin/choupo-thermoml extract-vle.",
        "",
        f"  system       {c1} + {c2}   (x is {c1}'s liquid mole fraction)",
        pline,
        f"  points       {len(keep)}"
        + (f"   ({len(dropped)} pure-component endpoint(s) set aside -- see"
           f" `selection`)" if dropped else ""),
        f"  vapour       {'y joined from the companion block' if ypts else 'none -- ' + yreason}",
        "",
        "  ONE FILE, TWO READERS.  The column names are the ones the props",
        "  bench's `experimental {}` overlay draws against a propertyScan1D",
        "  (x[<component>], T_bubble, y_eq_<component>) AND the ones",
        "  fitParameters(T_bubble) reads -- so the points a pair is fitted to",
        "  and the points it is drawn against cannot be two transcriptions.",
        "",
        "  The role this evidence plays -- fit or held-out validation -- is NOT",
        "  set here.  It is declared in the operation that consumes it, before",
        "  any fitting runs (src/propertyOps/EvidencePartition.H).",
        "",
        "  REDISTRIBUTION.  These are measured values reported in the article",
        "  cited below, located through the NIST/TRC ThermoML Archive (a finding",
        "  aid; thirdParty/thermoml/README.md).  The article is the source; the",
        "  archive's arrangement is not reproduced.",
        "\\*--------------------------------------------------------------------------*/",
        "",
        "property     binaryVLE.T_bubble;",
        f"system       ( {c1} {c2} );",
    ]
    if not varying:
        #  The held-constant form.  THE UNIT IS NEVER OMITTED: an unqualified
        #  number is read as canonical SI (EvidencePartition refuses it, and
        #  this is the writer's half of that contract).
        lines.append(f"pressure     {rec['P_kPa']} kPa;")
    lines += ["", "provenance", "{", f"    source       {a.provenance};"]
    if not syn:
        #  THE CONDITION THE TIER RULING ATTACHES: values "cited to the
        #  ORIGINAL article, CHECKED AGAINST IT when the paper is in hand".
        #  This tool has never seen the article; a curator who reads it and
        #  confirms the numbers edits this to `checked`, nothing automatic may.
        lines.append("    reviewStatus transcribedNotCheckedAgainstArticle;")
        lines.append(f'    citation     "{citation}";')
    if syn:
        lines.append('    note         "STRUCTURAL FIXTURE -- generated, never measured.  '
                     'Any verdict computed from it is about the machinery, not physics";')
    lines += [
        f'    archiveFile  "{src.name}";',
        f'    archive      "{SYNC_TARBALL} (NIST/TRC ThermoML Archive, doi:{ARCHIVE_DOI})";',
        f"    block        {a.block if a.block is not None else rec.get('block', 0)};",
        f'    doi          "{doi}";',
        f'    sha256       "{sha}";',
    ]
    if identity:
        lines += ["    identity", "    {"]
        for comp, cas, key in identity:
            lines.append(f'        {comp:<14} {{ cas "{cas}"; inchiKey "{key}"; }}')
        lines += [f'        rule           "{IDENTITY_RULE}";', "    }"]
    lines += ["}", ""]

    #  THE UNCERTAINTY, AS DECLARED, PER POINT.  Kept even though
    #  fitParameters(T_bubble) weights every point equally today: a stated
    #  uncertainty that was dropped at extraction can never be used again.
    u = [uT[k] for k in keep]
    if all(v is not None for v in u):
        lines += ["uncertainty", "{", "    T_bubble", "    {",
                  "        kind    expandedCombined;   // ThermoML nCombExpandUncertValue",
                  f"        level   {rec['uT_level'] or 'undeclared'};"
                  + ("            // per cent confidence" if rec["uT_level"] else ""),
                  "        unit    K;",
                  "        values  ( " + " ".join(f"{v:g}" for v in u) + " );"
                  "   // per point, in `data` order",
                  "    }", "}", ""]
    elif any(v is not None for v in u):
        lines += ["uncertainty", "{", "    T_bubble  partial;   // declared for "
                  f"{sum(v is not None for v in u)} of {len(u)} points; the per-point"
                  " values are in the archive file", "}", ""]
    else:
        lines += ["uncertainty", "{", "    T_bubble  none;   // the archive declares no "
                  "uncertainty for this series", "}", ""]

    if dropped:
        lines += ["selection", "{",
                  "    //  A bubble point on a PURE component measures the vapour-pressure",
                  "    //  correlation, not the pair: the pair parameters have no effect",
                  "    //  there.  Set aside, not deleted -- the values stay here.",
                  "    pureEndpoints",
                  "    (",
                  ]
        for k in dropped:
            lines.append(f"        {{ x {pts[k][0]:g}; T_bubble {pts[k][1]:g} K; }}")
        lines += ["    );", "}", ""]

    lines += ["columns", "(", f"    {{ name x[{c1}];  unit -;  }}"]
    if varying:
        lines.append("    { name Pressure;  unit kPa; }")
    lines.append("    { name T_bubble;  unit K;  }")
    if ypts:
        lines.append(f"    {{ name y_eq_{c1};  unit -;  }}")
    lines += [");", "", "data", "("]
    for k in keep:
        x, t = pts[k]
        row = f"    {x:8.4f}"
        if varying:
            row += f"  {rec['P_kPa_perPoint'][k]:10.4f}"
        row += f"  {t:.6g}"
        if ypts:
            row += f"  {ypts[k]:.4f}"
        lines.append(row)
    lines += [");", ""]
    out.write_text("\n".join(lines))

    print(f"choupo-thermoml extract-vle: {out}  ({len(keep)} points)")
    print(f"  system    {c1} + {c2}")
    for comp, cas, key in identity:
        print(f"  identity  {comp:<14} CAS {cas}  InChIKey {key}")
    if varying:
        print(f"  pressure  {len(rec['isobars'])} isobars, "
              f"{min(rec['isobars'])} .. {max(rec['isobars'])} kPa (a column)")
    else:
        print(f"  pressure  {rec['P_kPa']} kPa (constant)")
    print(f"  vapour    {'joined' if ypts else yreason}")
    for k in dropped:
        print(f"  set aside x = {pts[k][0]:g}, T = {pts[k][1]:g} K (pure endpoint)")
    print(f"  doi       {rec['doi'] or '(none declared)'}")
    if syn:
        print("  provenance synthetic -- GENERATED.  Any verdict from this "
              "evidence is about the plumbing, never about physics.")
    print("  role      NOT set here: the consuming operation declares it "
          "before fitting.")
    return 0


def _find_block(root, rec, block):
    """The <PureOrMixtureData> element `rec` was read from."""
    poms = find_all(root, "PureOrMixtureData")
    if block is not None:
        return poms[block]
    return poms[rec.get("block", 0)]


def _fetch(url, dest=None, text=False):
    """One HTTP GET.  An explicit User-Agent and an explicit CA bundle,
    because the defaults fail here in two different ways: urllib's default
    agent is rejected by the host with a 403 that curl does not get, and the
    proxy's CA is not in the system store."""
    req = urllib.request.Request(url, headers={"User-Agent": SYNC_UA})
    ctx = ssl.create_default_context(cafile=CA_BUNDLE
                                     if os.path.exists(CA_BUNDLE) else None)
    with urllib.request.urlopen(req, timeout=120, context=ctx) as r:
        if text:
            return r.read().decode("utf-8", "replace")
        total = int(r.headers.get("Content-Length") or 0)
        done = 0
        with open(dest, "wb") as f:
            while True:
                chunk = r.read(1 << 20)
                if not chunk:
                    break
                f.write(chunk)
                done += len(chunk)
                if total:
                    sys.stderr.write(f"\r  {done/1e6:8.1f} / {total/1e6:.1f} MB")
        sys.stderr.write("\n")


def _sha256_of(path):
    h = hashlib.sha256()
    with open(path, "rb") as f:
        for chunk in iter(lambda: f.read(1 << 20), b""):
            h.update(chunk)
    return h.hexdigest()


def cmd_sync(a):
    """Download the archive FROM NIST and unpack it into the cache.

    IMPLEMENTED 2026-08-25, and this is the half the original slice
    deliberately left undone.  It used to print a refusal and exit 2, because
    the distribution URL and its checksum could not be read from the
    environment it was written in and *inventing them would have shipped a
    sync that fails at the only moment it matters*.  That was the right call.
    The network became reachable, the two facts were read from the record, and
    the refusal became a gap to close rather than a position to hold.

    INTEGRITY, exactly as that refusal promised: the tarball is verified
    against the sha256 NIST publishes IN THE SAME RECORD, before it is
    unpacked.  A mismatch DELETES the download -- a mirror that fails its own
    integrity check must not exist half-installed, because every citation
    drawn from it afterwards would inherit the doubt silently.
    """
    cache = cache_root()
    cache.mkdir(parents=True, exist_ok=True)
    print("choupo-thermoml sync")
    print(f"  cache      {cache}")
    print(f"  archive    doi:{ARCHIVE_DOI}")
    print(f"  landing    {ARCHIVE_LANDING}")
    print()

    tgz = cache / SYNC_TARBALL
    if a.index_only:
        print("  --index-only: skipping the download entirely")
    else:
        want = _fetch(f"{SYNC_BASE}/{SYNC_TARBALL}.sha256", text=True).split()[0].lower()
        if not re.fullmatch(r"[0-9a-f]{64}", want):
            print(f"  REFUSED: the published checksum does not look like a"
                  f" sha256: {want!r}")
            return 1
        if tgz.exists() and _sha256_of(tgz) == want:
            print(f"  {SYNC_TARBALL} already present and verified -- not re-downloaded")
        else:
            print(f"  downloading {SYNC_TARBALL} (~190 MB) from data.nist.gov ...")
            _fetch(f"{SYNC_BASE}/{SYNC_TARBALL}", dest=tgz)
            got = _sha256_of(tgz)
            if got != want:
                tgz.unlink()
                print("  REFUSED: sha256 MISMATCH against the checksum published"
                      f" in the same NIST record:\n    expected {want}\n"
                      f"    got      {got}\n"
                      "  The download was DELETED.  A mirror that fails its own"
                      " integrity check must not exist half-installed.")
                return 1
            print(f"  sha256 verified against the record's own {SYNC_TARBALL}.sha256")

        print("  unpacking (this is the slow part) ...")
        with tarfile.open(tgz) as t:
            #  A hostile tarball must not write outside the cache.  Checked for
            #  EVERY member before a single one is extracted, so a refusal
            #  leaves nothing behind.
            for m in t.getmembers():
                p = (cache / m.name).resolve()
                if not str(p).startswith(str(cache.resolve())):
                    print(f"  REFUSED: tarball member escapes the cache: {m.name}")
                    return 1
            t.extractall(cache)
        print("  unpacked")

    #  THE STAMP THE INDEX ALREADY LOOKS FOR.  `cmd_index` reports a cache
    #  with no SYNC.json as `[unverified] ... placed by hand`, which was the
    #  honest state while this command refused.  Writing it is what turns that
    #  line off, and it must therefore record what was actually verified --
    #  never merely that the command ran.
    #  `--index-only` must not silently UPGRADE a hand-placed cache to
    #  "synced".  If the tarball is here it is verified against the published
    #  checksum anyway (one small GET); if that cannot be fetched, or there is
    #  no tarball, the stamp records what was obtained and says plainly that
    #  no verification was performed.  The original refusal's own wording:
    #  a record of what was obtained is never a verification that was not.
    local_sha = _sha256_of(tgz) if tgz.exists() else None
    if not a.index_only:
        integrity = "verified against the checksum published in the same NIST record"
    elif local_sha is None:
        integrity = ("NOT VERIFIED -- no tarball in the cache; these files were"
                     " placed by hand and nothing establishes where they came"
                     " from")
    else:
        try:
            pub = _fetch(f"{SYNC_BASE}/{SYNC_TARBALL}.sha256", text=True).split()[0].lower()
            integrity = ("verified against the checksum published in the same"
                         " NIST record" if pub == local_sha else
                         f"MISMATCH -- the cached tarball hashes {local_sha},"
                         f" the record publishes {pub}")
        except Exception as exc:
            integrity = ("NOT VERIFIED -- the published checksum could not be"
                         f" fetched ({type(exc).__name__}); the sha256 below is"
                         " what is on disk, not a verification")
    stamp = {
        "archiveDoi": ARCHIVE_DOI,
        "landing": ARCHIVE_LANDING,
        "tarball": SYNC_TARBALL,
        "integrity": integrity,
        "sha256": local_sha,
    }
    (cache / "SYNC.json").write_text(json.dumps(stamp, indent=2, sort_keys=True))
    print(f"  wrote {cache / 'SYNC.json'}")
    print()
    print("  The cache is PRIVATE (thirdParty/ is gitignored) and the RUNTIME")
    print("  NEVER READS IT.  Next: `choupo-thermoml index`, then `search`.")
    print("  A value moves into a Choupo record only by reading and citing the")
    print("  ORIGINAL ARTICLE the cache names beside it.")
    return 0


def _sync_provenance(cache) -> str:
    """What the cache's own stamp claims about where it came from."""
    stamp = cache / "SYNC.json"
    if not stamp.exists():
        return "hand-placed"
    try:
        integrity = json.loads(stamp.read_text()).get("integrity", "")
    except (ValueError, OSError):
        return "stamp-unreadable"
    if integrity.startswith("verified"):
        return "synced"
    return "stamped-but-unverified"


def cmd_index(a):
    cache = cache_root()
    if not cache.is_dir():
        print(f"choupo-thermoml index: no cache at {cache}.  Run `sync`, or "
              f"set CHOUPO_THERMOML_HOME to a shared copy.")
        return 1

    files = sorted(cache.rglob("*.xml"))
    if not files:
        print(f"choupo-thermoml index: {cache} holds no .xml files.  An index "
              f"built over nothing would report a clean empty archive, which "
              f"is not the same as a working one.")
        return 1

    entries, refused, dialects = [], [], {}
    for f in files:
        try:
            e = read_file(f)
        except ValueError as exc:
            refused.append((f.name, str(exc)))
            continue
        except ET.ParseError as exc:
            refused.append((f.name, f"not well-formed XML: {exc}"))
            continue
        dialects[e["dialect"]] = dialects.get(e["dialect"], 0) + 1
        entries.append(e)

    #  The index is keyed by every identifier a student might type.
    by_key = {}
    for e in entries:
        for c in e["compounds"]:
            for field in ("name", "cas", "inchi", "inchikey"):
                v = (c.get(field) or "").strip()
                if v:
                    by_key.setdefault(v.lower(), []).append(
                        {"file": e["file"], "doi": e["doi"],
                         "compound": c["name"],
                         "properties": e["propertiesSupported"]})

    index = {
        "cache": str(cache),
        "archiveDoi": ARCHIVE_DOI,
        "files": len(files),
        "indexed": len(entries),
        "refused": [{"file": n, "reason": r} for n, r in refused],
        "dialects": dialects,
        "entries": entries,
        "byKey": by_key,
        #  READ THE STAMP, do not merely notice it.  `sync --index-only` can
        #  write a SYNC.json over a cache nobody downloaded, so the existence
        #  of the file says only that somebody ran the command; what it SAYS
        #  is the fact.
        "provenance": _sync_provenance(cache),
    }
    out = cache / "index.json"
    out.write_text(json.dumps(index, indent=2, sort_keys=True))

    print(f"choupo-thermoml index: {len(entries)} file(s) indexed from {cache}")
    for d, n in sorted(dialects.items()):
        print(f"  dialect {d:<10} {n} file(s)")
    print(f"  {len(by_key)} searchable identifier(s) "
          f"(name / CAS / InChI / InChIKey)")
    for name, reason in refused:
        print(f"  REFUSED {name}: {reason.splitlines()[0]}")
    unsup = sorted({p for e in entries for p in e["propertiesUnsupported"]})
    if unsup:
        print(f"  {len(unsup)} declared property type(s) Choupo does not read "
              f"yet, LISTED rather than dropped:")
        for u in unsup[:8]:
            print(f"      {u}")
    if index["provenance"] == "hand-placed":
        print("  [unverified] this cache carries no sync stamp -- its files "
              "were placed by hand,\n"
              "              so the published-dialect reader has not yet been "
              "exercised against\n"
              "              a file NIST actually served.")
    print(f"  wrote {out}")
    return 0


#  ---------------------------------------------------------------------------
#  THE ONLINE BIBLIOGRAPHIC QUERY (folded in 2026-08-25).
#
#  `search` reads the local index and needs a 4 GB cache to answer anything.
#  The archive ALSO publishes a metadata search API, and querying it needs no
#  cache at all -- which is the difference between "what does my mirror hold?"
#  and "what has anybody measured?".  Those are two questions, so they are two
#  flags on one command rather than two commands.
#
#  THE API IS METADATA-ONLY BY THE ARCHIVE'S OWN DESIGN.  NIST documents that
#  the JSON served here has its data points REPLACED BY COUNTS before posting,
#  so this path cannot import a value even by accident.  That is why it needs
#  no licence reasoning that `sync` does: crossing to the bulk files is a
#  deliberate, separate act.
#  ---------------------------------------------------------------------------
ONLINE_API = "https://trc.nist.gov/ThermoML-API/objects"


def _online_query(compounds, raw):
    if raw:
        return raw
    terms = " AND ".join(r"/Compound/\_/sCommonName/\_:" + c.lower()
                         for c in compounds)
    return f"type:TRCTml4 AND ({terms})"


def _online_fetch(query, page_size):
    url = (ONLINE_API + "?" + urllib.parse.urlencode(
        {"query": query, "pageNum": 0, "pageSize": page_size}))
    req = urllib.request.Request(
        url, headers={"Accept": "application/json", "User-Agent": SYNC_UA})
    ctx = ssl.create_default_context(
        cafile=CA_BUNDLE if os.path.exists(CA_BUNDLE) else None)
    try:
        with urllib.request.urlopen(req, timeout=45, context=ctx) as r:
            return json.load(r)
    except Exception as e:
        #  AN OFFLINE SESSION MUST SAY SO.  An empty list here would read as
        #  "nobody measured this", which is a different claim entirely.
        raise SystemExit(
            f"choupo-thermoml search --online: the archive is unreachable"
            f" ({e}).\n  This needs network egress to trc.nist.gov.  Use"
            f" `search` without --online to query the local cache.")


def _online_points(content):
    """The archive's own data-point counts, per property name."""
    out = {}

    def walk(node):
        if isinstance(node, dict):
            for k, v in node.items():
                if isinstance(v, dict) and "data_points" in v:
                    out[k] = out.get(k, 0) + v.get("data_points", 0)
                else:
                    walk(v)
        elif isinstance(node, list):
            for v in node:
                walk(v)

    walk(content.get("summary") or content.get("Summary") or {})
    return out


def cmd_search_online(a):
    q = _online_query([a.query] if a.query else [], a.raw_query)
    d = _online_fetch(q, a.max_n)
    total = d.get("size", 0)
    print(f"ThermoML API: {total} entr{'y' if total == 1 else 'ies'} for"
          f" {a.query or a.raw_query}  (showing at most {a.max_n}; five"
          f" journals, ~2003-2019 -- absence here is not absence of"
          f" literature)")
    for r in d.get("results", []):
        c = r.get("content", {})
        cit = c.get("Citation", {})
        au = cit.get("sAuthor") or []
        if isinstance(au, str):
            au = [au]
        names = "; ".join(x.split("[")[0].strip() for x in au[:4])
        if len(au) > 4:
            names += " et al."
        print(f"\n  {names} ({cit.get('yrPubYr', '?')})")
        print(f"    {str(cit.get('sTitle', '?'))[:96]}")
        print(f"    {cit.get('sPubName', '?')}"
              + (f"  doi:{cit['sDOI']}" if cit.get("sDOI") else ""))
        pts = _online_points(c)
        if pts:
            top = sorted(pts.items(), key=lambda kv: -kv[1])[:3]
            print("    measured: " + "; ".join(f"{k} ({v} pts)" for k, v in top))
    print("\n  The ARTICLE is the source.  Read it, cite IT -- never this"
          " index -- and\n  record the value with the paper's own units and"
          " uncertainty.")
    return 0


def cmd_search(a):
    cache = cache_root()
    idx = cache / "index.json"
    if not idx.exists():
        print(f"choupo-thermoml search: no index at {idx}.  Run "
              f"`choupo-thermoml index` first.")
        return 1
    index = json.loads(idx.read_text())
    q = a.query.strip().lower()
    hits = index["byKey"].get(q, [])
    if not hits:
        near = [k for k in index["byKey"] if q in k][:8]
        print(f"choupo-thermoml search: nothing matches '{a.query}'.")
        print("  Searchable keys are the compound NAME, CAS number, InChI and "
              "InChIKey.")
        if near:
            print("  Did you mean: " + ", ".join(near))
        return 1
    print(f"choupo-thermoml search: '{a.query}' -> {len(hits)} dataset(s)")
    for h in hits:
        props = ", ".join(h["properties"]) or "(none Choupo reads)"
        print(f"  {h['compound']:<24} {props}")
        print(f"      doi {h['doi'] or '(none declared)'}")
        print(f"      {h['file']}")
    return 0


def main():
    ap = argparse.ArgumentParser(description=__doc__.splitlines()[0])
    sub = ap.add_subparsers(dest="cmd", required=True)
    sy = sub.add_parser("sync", help="download the official NIST archive")
    sy.add_argument("--index-only", action="store_true",
                    help="skip the download; stamp a cache already unpacked "
                         "by hand or by an earlier sync")
    sub.add_parser("index", help="build the local index over the cache")
    s = sub.add_parser("search", help="search by name / CAS / InChI / InChIKey")
    s.add_argument("query")
    s.add_argument("--online", action="store_true",
                   help="query the NIST metadata API instead of the local "
                        "cache -- answers 'what has anybody measured?' rather "
                        "than 'what does my cache hold?', and needs no cache "
                        "(the API serves citations with the data points "
                        "stripped, by the archive's own design)")
    s.add_argument("--raw-query", default="",
                   help="a Lucene query passed to the API verbatim "
                        "(implies --online)")
    s.add_argument("--max-n", type=int, default=10,
                   help="how many results to show (--online only)")
    ev = sub.add_parser("extract-vle",
                        help="write ONE dataset from a binary bubble-point file")
    ev.add_argument("file", help="the ThermoML .xml to read")
    ev.add_argument("--block", type=int, default=None,
                    help="which <PureOrMixtureData> block to read, when the "
                         "file carries more than one interpretable dataset.  "
                         "Omit it and the tool uses the only one there is, or "
                         "REFUSES with the list -- choosing among several is "
                         "the curator's act, not the tool's")
    ev.add_argument("--into", required=True, help="destination directory")
    ev.add_argument("--provenance", default="measured",
                    choices=["measured", "synthetic"],
                    help="what the numbers ARE -- `synthetic` marks a structural "
                         "fixture, and the mark travels with the dataset")
    ev.add_argument("--interior-only", action="store_true",
                    help="set the pure-component endpoints (x = 0 and x = 1) "
                         "aside: they measure the vapour-pressure correlation, "
                         "not the pair.  They are KEPT in the file under "
                         "`selection`, never deleted")
    ev.add_argument("--no-vapour", action="store_true",
                    help="do not join the companion vapour-composition block")
    idn = sub.add_parser("identity",
                         help="build the CAS -> InChIKey bridge for the catalogue "
                              "(network; PubChem + NCI CACTUS must agree)")
    idn.add_argument("--refresh", action="store_true",
                     help="ask the resolvers again for every record")
    sub.add_parser("vle-index",
                   help="index every binary vapour-liquid block in the cache "
                        "(geometry, T and P spans, uncertainty, DOI, identity)")
    vs = sub.add_parser("vle-search",
                        help="search the VLE index by component / CAS / InChIKey")
    vs.add_argument("a")
    vs.add_argument("b", nargs="?", default="")
    vs.add_argument("--geometry", default="",
                    choices=["", "bubbleT", "vapourComposition", "bubbleP",
                             "activityCoefficient", "other"])
    vs.add_argument("--pmax", type=float, default=None,
                    help="only blocks whose highest pressure is at most this (kPa)")
    e = sub.add_parser("extract", help="write Choupo datasets for a compound")
    e.add_argument("query")
    e.add_argument("--into", default="constant/experiments")
    e.add_argument("--allow-mixture", action="store_true",
                   help="write datasets from MULTI-COMPONENT files too.  Off by "
                        "default: a pure-component property read off a mixture "
                        "study is a different physical quantity, and the file "
                        "would carry a real DOI for it (see cmd_extract)")
    a = ap.parse_args()
    if a.cmd == "search" and (getattr(a, "online", False)
                              or getattr(a, "raw_query", "")):
        return cmd_search_online(a)
    return {"sync": cmd_sync, "index": cmd_index, "search": cmd_search,
            "extract": cmd_extract, "extract-vle": cmd_extract_vle,
            "identity": cmd_identity, "vle-index": cmd_vle_index,
            "vle-search": cmd_vle_search}[a.cmd](a)


if __name__ == "__main__":
    sys.exit(main())
