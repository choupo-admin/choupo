"""choupo-import-thermoml -- mirror the NIST/TRC ThermoML Archive into data/local.

WHAT THIS INSTALLS, AND WHERE.  The complete ThermoML Archive -- experimental
thermophysical and thermochemical property data extracted by NIST/TRC from
five journals (~2003-2019), each dataset carrying the citation of the article
it came from -- into the PRIVATE, gitignored tier:

    data/local/thermoml/xml/<journal-doi-path>.xml     the archive, verbatim
    data/local/thermoml/citations.jsonl                a local citation index

Nothing this tool writes is ever committed; data/local is yours.  The Choupo
runtime NEVER reads it -- the loader resolves records by exact name under
data/local/{components,parameters,...}/, and nothing walks directories -- so
installing the mirror cannot change any simulation result by even one bit.

WHAT THIS DELIBERATELY DOES NOT DO: convert anything into a Choupo record.
An outside format is never the base of a record (the 2026-07-27 lesson); a
value moves from this mirror into data/standards/ or data/local/ records only
by a HUMAN act of curation, one value at a time, citing the ORIGINAL ARTICLE
-- whose full reference the mirror hands you next to every number.  The
licence assessment behind this boundary, with verbatim quotes:
docs/design/thermoml-archive-assessment.md (tiers 1-2 in, tier 3 reserved).

PROVENANCE OF THE DOWNLOAD ITSELF.  The tarball comes from NIST's data
repository (record mds2-2422) over TLS, and its sha256 is fetched from the
SAME record and checked before anything is unpacked -- a mirror whose
integrity was assumed would poison every citation drawn from it.  If you use
this resource in published work, NIST asks that you cite doi:10.18434/mds2-2422
and the software note doi:10.1002/jcc.26842.

Usage:
    bin/choupo-import-thermoml              # download, verify, unpack, index
    bin/choupo-import-thermoml --index-only # rebuild citations.jsonl from an
                                            # existing mirror (no network)

Disk: the download is ~190 MB; unpacked, plan for a few GB.
"""
import hashlib
import json
import os
import re
import ssl
import sys
import tarfile
import urllib.request
import xml.etree.ElementTree as ET
from pathlib import Path

BASE = "https://data.nist.gov/od/ds/mds2-2422"
TARBALL = "ThermoML.v2020-09-30.tgz"
ROOT = Path(__file__).resolve().parent.parent
DEST = ROOT / "data" / "local" / "thermoml"
CA = os.environ.get("SSL_CERT_FILE") or "/root/.ccr/ca-bundle.crt"
UA = "choupo-import-thermoml/1.0 (private mirror; doi:10.18434/mds2-2422)"


def die(msg):
    sys.stderr.write("choupo-import-thermoml: " + msg + "\n")
    sys.exit(1)


def fetch(url, dest=None, text=False):
    req = urllib.request.Request(url, headers={"User-Agent": UA})
    ctx = ssl.create_default_context(
        cafile=CA if os.path.exists(CA) else None)
    with urllib.request.urlopen(req, timeout=120, context=ctx) as r:
        if text:
            return r.read().decode("utf-8", "replace")
        total = int(r.headers.get("Content-Length") or 0)
        done = 0
        with open(dest, "wb") as f:
            while True:
                chunk = r.read(1 << 20)
                if not chunk:
                    break
                f.write(chunk)
                done += len(chunk)
                if total:
                    sys.stderr.write(f"\r  {done/1e6:8.1f} / {total/1e6:.1f} MB")
        sys.stderr.write("\n")


def sha256_of(path):
    h = hashlib.sha256()
    with open(path, "rb") as f:
        for chunk in iter(lambda: f.read(1 << 20), b""):
            h.update(chunk)
    return h.hexdigest()


#  ThermoML citation fields (namespace-agnostic: the schema moved between
#  versions and a tag's local name is stable where its namespace is not).
def local(tag):
    return tag.rsplit("}", 1)[-1]


def cite_of(xml_path):
    """One citation dict from a ThermoML file's <Citation> block."""
    out = {"file": None, "title": "", "authors": [], "journal": "",
           "year": "", "doi": "", "compounds": [], "properties": []}
    try:
        for _, el in ET.iterparse(xml_path, events=("end",)):
            t = local(el.tag)
            if t == "sTitle" and el.text:
                out["title"] = el.text.strip()
            elif t == "sAuthor" and el.text:
                out["authors"].append(el.text.strip())
            elif t == "sPubName" and el.text:
                out["journal"] = el.text.strip()
            elif t == "yrPubYr" and el.text:
                out["year"] = el.text.strip()
            elif t == "sDOI" and el.text:
                out["doi"] = el.text.strip()
            elif t == "sCommonName" and el.text:
                nm = el.text.strip()
                if nm not in out["compounds"]:
                    out["compounds"].append(nm)
            elif t == "ePropName" and el.text:
                p = el.text.strip()
                if p not in out["properties"]:
                    out["properties"].append(p)
            #  free memory as we go -- the archive holds tens of thousands
            el.clear()
    except ET.ParseError as e:
        out["parseError"] = str(e)
    return out


def build_index(xml_root):
    files = sorted(xml_root.rglob("*.xml"))
    if not files:
        die(f"no .xml files under {xml_root} -- unpack first (run without"
            " --index-only)")
    idx = DEST / "citations.jsonl"
    n_bad = 0
    with open(idx, "w", encoding="utf-8") as f:
        for i, p in enumerate(files):
            c = cite_of(p)
            c["file"] = str(p.relative_to(DEST))
            if "parseError" in c:
                n_bad += 1
            f.write(json.dumps(c, ensure_ascii=False) + "\n")
            if (i + 1) % 2000 == 0:
                sys.stderr.write(f"\r  indexed {i+1}/{len(files)}")
    sys.stderr.write(f"\r  indexed {len(files)}/{len(files)}\n")
    print(f"choupo-import-thermoml: {idx}")
    print(f"  {len(files)} article file(s) indexed"
          + (f"; {n_bad} carried XML parse errors and are listed with the"
             " error rather than dropped" if n_bad else ""))


def main():
    index_only = "--index-only" in sys.argv
    DEST.mkdir(parents=True, exist_ok=True)
    xml_root = DEST / "xml"

    if not index_only:
        tgz = DEST / TARBALL
        want = fetch(f"{BASE}/{TARBALL}.sha256", text=True).split()[0].lower()
        if not re.fullmatch(r"[0-9a-f]{64}", want):
            die(f"the published checksum does not look like sha256: {want!r}")
        if tgz.exists() and sha256_of(tgz) == want:
            print(f"  {TARBALL} already present and verified -- not re-downloaded")
        else:
            print(f"  downloading {TARBALL} (~190 MB) from data.nist.gov ...")
            fetch(f"{BASE}/{TARBALL}", dest=tgz)
            got = sha256_of(tgz)
            if got != want:
                tgz.unlink()
                die("sha256 MISMATCH against the checksum published in the"
                    f" same NIST record:\n  expected {want}\n  got      {got}\n"
                    "  The download was deleted.  A mirror that fails its own"
                    " integrity check must not exist half-installed.")
            print(f"  sha256 verified against the record's own {TARBALL}.sha256")
        xml_root.mkdir(exist_ok=True)
        print("  unpacking (this is the slow part) ...")
        with tarfile.open(tgz) as t:
            #  refuse path traversal -- a hostile tarball must not write
            #  outside the mirror
            for m in t.getmembers():
                p = (xml_root / m.name).resolve()
                if not str(p).startswith(str(xml_root.resolve())):
                    die(f"tarball member escapes the mirror: {m.name}")
            t.extractall(xml_root)
        print("  unpacked")

    build_index(xml_root)
    print("\n  The mirror is PRIVATE (data/local is gitignored) and the"
          "\n  runtime never reads it.  Query it with:"
          "\n      bin/curate/thermoml_locate.py --local <compound> ..."
          "\n  A value moves into a Choupo record only by reading and citing"
          "\n  the ORIGINAL ARTICLE the mirror names beside it.")


if __name__ == "__main__":
    main()
