#---------------------------------------------------------------------------#
#  buildSite  --  ASSEMBLE the Choupo site into site/_dist.  ONE assembler,
#                 two consumers: `bin/runSite` serves what this produces, and
#                 the publish workflow uploads what this produces.
#
#  That is the whole point of the file existing.  The assembly used to live
#  inside runSite, which meant a published site could only be built by a
#  SECOND copy of the same twenty lines -- and the day those two copies
#  disagree is the day "it worked locally" stops being evidence about the
#  thing visitors see.  One quantity, one home; a build recipe is a quantity.
#
#  THE SINGLE-ORIGIN LAYOUT (no asset rebasing anywhere):
#      site/_dist/index.html        the LANDING, at /
#      site/_dist/app/index.html    the APP entry, at /app
#      site/_dist/{assets,wasm,workers,docs}/   served at ROOT, so the app's
#                                   absolute /assets, /wasm, /workers refs
#                                   resolve and /app/index.html runs unchanged.
#
#  The simulator (choupoSolve.wasm and friends) is DELIVERED by whatever
#  serves this directory and EXECUTES in the visitor's browser tab.  No server
#  ever computes a flash.  That is not an implementation detail: it is why a
#  static host is enough, why there is no per-user state, and why a visitor's
#  case never leaves their machine.
#
#  Usage:
#      bin/buildSite            build the app, then assemble
#      bin/buildSite --no-build reuse gui/dist, just assemble
#
#  Requires (for a full build): npm, and gui/node_modules installed.  The
#  WASM must already be built (`make wasm-gui`) -- this script does NOT build
#  it, because a 7-minute Emscripten link has no business hiding inside an
#  assembly step that otherwise takes a second.
#---------------------------------------------------------------------------#

set -e

script_dir=$(dirname "$(readlink -f "$0")")
root=$(readlink -f "$script_dir/..")
gui="$root/gui"
src="$root/site"
dist="$src/_dist"

if [ "${1:-}" != "--no-build" ]; then
    #  The guide PDFs FIRST (incremental), so the served Help links never 404.
    if command -v pdflatex >/dev/null 2>&1; then
        echo "[buildSite] compiling guide PDFs (make -C docs) ..."
        #  A failed compile means the PDFs about to be published are stale
        #  behind their own sources.  This branch used to WARN and continue,
        #  and from 2026-08-27 to 2026-08-30 that is exactly what happened:
        #  theoryGuide.tex had become uncompilable (an \SI with no siunitx
        #  anywhere in the tree) and every publish served the 08-19 PDF --
        #  missing the Hansen chapter -- with the suite green.  The
        #  title-page version gate below cannot catch it: same version,
        #  stale content.  Refuse, naming the log.
        ( cd "$root/docs" && make all >/dev/null 2>&1 ) || {
            echo "[buildSite] ERROR: docs build FAILED -- the committed PDFs are stale" >&2
            echo "[buildSite]        behind their own .tex sources.  Publishing them would" >&2
            echo "[buildSite]        serve a guide missing what the source already says." >&2
            echo "[buildSite]        See docs/*.build.log; fix the .tex, then re-run." >&2
            exit 1
        }
    else
        echo "[buildSite] WARN: no pdflatex -- using existing docs/*.pdf"
    fi
    echo "[buildSite] building the app (npm run build) ..."
    ( cd "$gui" && npm run build )
fi

if [ ! -d "$gui/dist" ]; then
    echo "[buildSite] ERROR: no app build at $gui/dist (run without --no-build first)" >&2
    exit 1
fi
if [ ! -f "$gui/public/wasm/choupoSolve.wasm" ]; then
    echo "[buildSite] ERROR: no WASM at gui/public/wasm -- run \`make wasm-gui\` first." >&2
    echo "[buildSite]        A site assembled without it serves an app that cannot solve." >&2
    exit 1
fi

#  PRESENT IS NOT FRESH, and this is the one artefact where nothing else says so.
#
#  gui/public/wasm/ is GITIGNORED and this script does NOT build it -- it copies
#  whatever happens to be on the publishing machine.  So the engine the site
#  serves is whatever someone last remembered to build, with no check anywhere:
#  `check_build_fresh` covers the NATIVE build and states, in its own words,
#  that "the WASM build is separate and not covered".
#
#  Found 2026-08-14 with the WASM sixteen days and ~250 commits behind the
#  engine -- old enough to predate a corrected reactor duty, a corrected
#  enthalpy leg and a whole new distillate specification.  A site published
#  from that tree would have served an app that silently disagrees with the
#  repository it was built from, and the symptom is the confusing
#  `unknown type '<yourType>'` that CLAUDE.md 13 already documents.
#
#  This REFUSES rather than warns, for the reason this same script was already
#  corrected once: a check that cannot run must not pass, and a warning at
#  publish time is a check nobody reads.  `--stale-wasm-ok` exists for the
#  deliberate case (publishing a doc-only change from a tree you have not
#  rebuilt) and it has to be typed, which is the point.
newest_src=$(find "$root/src" "$root/make" -type f \( -name '*.cpp' -o -name '*.H' -o -name '*.mk' \) \
             -newer "$gui/public/wasm/choupoSolve.wasm" -print -quit 2>/dev/null)
if [ -n "$newest_src" ] && [ "${STALE_WASM_OK:-0}" != 1 ]; then
    echo "[buildSite] ERROR: the WASM is OLDER than the engine sources." >&2
    echo "[buildSite]        e.g. $newest_src is newer than gui/public/wasm/choupoSolve.wasm" >&2
    echo "[buildSite]        The site would serve an engine that disagrees with this tree;" >&2
    echo "[buildSite]        the symptom in the browser is an unknown unit type or a" >&2
    echo "[buildSite]        silently different answer.  Run \`make wasm-gui\`." >&2
    echo "[buildSite]        Deliberate (doc-only publish)?  STALE_WASM_OK=1 bin/buildSite ..." >&2
    exit 1
fi

echo "[buildSite] assembling combined site -> $dist"
rm -rf "$dist"
mkdir -p "$dist/app"
cp -r "$gui/dist/." "$dist/"          # app assets + the app index.html at root
mv "$dist/index.html" "$dist/app/index.html"   # the APP lives at /app
cp "$src/index.html" "$dist/index.html"         # the LANDING lives at /
# The model catalogue page at /models/ (clean route via a directory index).
mkdir -p "$dist/models"
cp "$src/models.html" "$dist/models/index.html" 2>/dev/null || true
# The releases page at /releases/ (same clean-route pattern).
mkdir -p "$dist/releases"
cp "$src/releases.html" "$dist/releases/index.html" 2>/dev/null || true
# The generated single-source-of-truth JSONs the landing + /models consume.
python3 "$root/bin/curate/release_inventory.py" >/dev/null 2>&1 || true
cp "$root/generated/releaseInventory.json" "$dist/" 2>/dev/null || true
mkdir -p "$dist/releases"
cp "$root/generated/releases/"*.json "$dist/releases/" 2>/dev/null || true
cp "$root/generated/modelsCatalogue.json"  "$dist/" 2>/dev/null || true
#  The EduTools list the landing renders -- derived from the app's own registry
#  (gui/src/ui/methods/registry.ts), never hand-written.  Regenerated here for
#  the same reason releaseInventory is: what gets published should be counted
#  from the tree being published.  A regeneration failure (no gui/node_modules
#  on the publishing machine) leaves the COMMITTED artefact in place, which
#  check_method_tools.py independently keeps equal to the registry.
node "$root/bin/curate/method_tools.mjs" >/dev/null 2>&1 || true
cp "$root/generated/methodTools.json" "$dist/" 2>/dev/null || true
cp "$src"/*.svg "$dist/" 2>/dev/null || true
cp "$src"/*.png "$dist/" 2>/dev/null || true    # landing logo (logo2.png) + any raster art
cp "$src"/*.webp "$dist/" 2>/dev/null || true   # compressed landing product imagery
cp "$src/sw.js" "$dist/" 2>/dev/null || true    # offline service worker (scope /)
#  The custom domain, when one is declared.  GitHub Pages reads CNAME from the
#  root of what is published; keeping it in site/ means the domain is a fact of
#  the SITE, versioned beside the pages it names, not a setting in a web UI
#  that no clone can see.
cp "$src/CNAME" "$dist/" 2>/dev/null || true

#  ANALYTICS — configuration, never code.  A GoatCounter site code in
#  $CHOUPO_GOATCOUNTER_SITE (or, second, the single non-comment line of
#  site/analytics.conf) injects the cookieless counter script before </head>
#  on the landing and the app.  Absent, NOTHING is injected and the log says
#  so: the site keeps its promise (no per-user state, no cookies, a case never
#  leaves the machine); the counter, when present, sees page loads and
#  content-free events only.
gc_site="${CHOUPO_GOATCOUNTER_SITE:-}"
if [ -z "$gc_site" ] && [ -s "$src/analytics.conf" ]; then
    gc_site="$(grep -v '^[[:space:]]*#' "$src/analytics.conf" | grep -v '^[[:space:]]*$' | head -1 | tr -d '[:space:]')"
fi
if [ -n "$gc_site" ]; then
    case "$gc_site" in
        *[!A-Za-z0-9_-]*) echo "buildSite: refusing analytics site code '$gc_site' (letters, digits, - and _ only)" >&2; exit 1 ;;
    esac
    gc_tag="<script data-goatcounter=\"https://${gc_site}.goatcounter.com/count\" async src=\"//gc.zgo.at/count.js\"></script>"
    for page in "$dist/index.html" "$dist/app/index.html"; do
        sed -i "s#</head>#  ${gc_tag}\n</head>#" "$page"
        grep -q 'data-goatcounter=' "$page" || { echo "buildSite: analytics injection failed on $page" >&2; exit 1; }
    done
    echo "analytics: GoatCounter site '$gc_site' injected into index.html and app/index.html"
else
    echo "analytics: not configured (CHOUPO_GOATCOUNTER_SITE unset, site/analytics.conf empty) -- nothing injected"
fi

#  SITEMAP + ROBOTS — generated beside the pages they list, so the list
#  cannot drift from what the build ships; a page that does not exist in
#  _dist is not listed.
site_url="https://www.choupo.org"
{
    echo '<?xml version="1.0" encoding="UTF-8"?>'
    echo '<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">'
    for p in "/" "/app/" "/models/" "/releases/" "/releases.html" "/guide.html"; do
        [ -e "$dist${p%/}/index.html" ] || [ -e "$dist$p" ] || continue
        echo "  <url><loc>${site_url}${p}</loc></url>"
    done
    echo '</urlset>'
} > "$dist/sitemap.xml"
printf 'User-agent: *\nAllow: /\nSitemap: %s/sitemap.xml\n' "$site_url" > "$dist/robots.txt"
echo "sitemap: $(grep -c '<loc>' "$dist/sitemap.xml") URLs in sitemap.xml; robots.txt written"
#  Jekyll is not involved and must not be: a directory or file beginning with
#  an underscore (the app's chunks can) would be silently dropped otherwise.
touch "$dist/.nojekyll"

#  THE PUBLISHED ARTEFACT IS THE ONE A READER OPENS.  On 2026-08-05
#  choupo.org served a Theory Guide title page reading "Version 2607 / 30 June
#  2026" while the repository's own PDF said Choupo-dev -- the deployed build
#  was six days old, and nothing anywhere compared the two.  The in-repo half
#  is now gated (bin/curate/check_guide_pdf_version.py); this is the other
#  half, and it runs where the staleness actually appears: after assembly,
#  against what is about to be published.
if command -v pdftotext >/dev/null 2>&1; then
    _want=$(sed -n 's/.*CHOUPO_VERSION[[:space:]]*=[[:space:]]*"\([^"]*\)".*/\1/p' \
            "$root/src/core/Banner.H" | head -1)
    _bad=0
    #  THE GUIDE LIST HAS ONE HOME -- `DOCS` in docs/Makefile -- and this was
    #  the fourth hand-written copy of it (after the Makefile, copyDocs.mjs and
    #  guide.html's allowlist).  A verification loop that names its own subset
    #  checks the guides someone remembered, which is exactly the guide a new
    #  one is not.  Refuse rather than fall back: a silent default here would
    #  publish an unverified manual.
    _docs=$(sed -n 's/^DOCS[[:space:]]*:=[[:space:]]*//p' "$root/docs/Makefile")
    if [ -z "$_docs" ]; then
        echo "[buildSite] ERROR: cannot read \`DOCS :=\` from docs/Makefile -- that line" >&2
        echo "[buildSite]        decides which guides are public, and this check will not" >&2
        echo "[buildSite]        invent a list of its own." >&2
        exit 1
    fi
    for _g in $_docs; do
        #  A guide in DOCS that did not reach the dist is NOT a skip: it is a
        #  manual the app will list and fail to open.
        if [ ! -f "$dist/docs/$_g.pdf" ]; then
            echo "[buildSite] ERROR: $_g is public per docs/Makefile but no PDF reached the site" >&2
            _bad=1
            continue
        fi
        if ! pdftotext -f 1 -l 1 "$dist/docs/$_g.pdf" - 2>/dev/null | grep -qF "$_want"; then
            echo "[buildSite] ERROR: $_g.pdf about to be PUBLISHED does not carry '$_want' on its title page" >&2
            _bad=1
        fi
    done
    if [ "$_bad" = 1 ]; then
        echo "[buildSite]        A guide naming a version it does not describe is worse than an undated one:" >&2
        echo "[buildSite]        the wrong label is believed.  Run: bin/curate/guide_version.py && make -C docs all" >&2
        exit 1
    fi
    echo "[buildSite] guide PDFs verified: all four title pages read $_want"
else
    #  A CHECK THAT CANNOT RUN MUST NOT PASS.  This branch used to WARN and
    #  continue, and on 2026-08-05 that is exactly what happened in CI: the
    #  GitHub runner has no `pdftotext`, so the very gate written to stop a
    #  mislabelled guide reaching choupo.org printed one line into a
    #  900-line log and published anyway.  The guide happened to be correct;
    #  nothing here established that.
    #
    #  A missing tool is not evidence of a good artefact -- it is the absence
    #  of evidence, and reporting the absence as a pass is the silent
    #  fallback the project forbids everywhere else (invariant I5).  So the
    #  publishing path REFUSES.
    #
    #  CHOUPO_SKIP_PDF_VERIFY exists for a developer assembling the site
    #  locally without poppler, and it is deliberately an ACT: you have to
    #  type it, and it says out loud what it bought.  CI never sets it -- the
    #  workflow installs poppler-utils instead.
    if [ -n "${CHOUPO_SKIP_PDF_VERIFY:-}" ]; then
        echo "[buildSite] WARN: pdftotext absent and CHOUPO_SKIP_PDF_VERIFY set --" >&2
        echo "[buildSite]       the guide versions in this build are UNVERIFIED." >&2
        echo "[buildSite]       Do not publish this assembly." >&2
    else
        echo "[buildSite] ERROR: pdftotext is not installed, so the guide title pages" >&2
        echo "[buildSite]        about to be published CANNOT be verified." >&2
        echo "[buildSite]        Refusing: an unverifiable claim is not a verified one." >&2
        echo "[buildSite]        REMEDY: install poppler-utils (apt-get install -y poppler-utils)," >&2
        echo "[buildSite]        or set CHOUPO_SKIP_PDF_VERIFY=1 for a local build you will NOT publish." >&2
        exit 1
    fi
fi

echo "[buildSite] done:  $(du -sh "$dist" | cut -f1)  in  $dist"
