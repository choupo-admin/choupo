#---------------------------------------------------------------------------#
#  buildSite  --  ASSEMBLE the Choupo site into site/_dist.  ONE assembler,
#                 two consumers: `bin/runSite` serves what this produces, and
#                 the publish workflow uploads what this produces.
#
#  That is the whole point of the file existing.  The assembly used to live
#  inside runSite, which meant a published site could only be built by a
#  SECOND copy of the same twenty lines -- and the day those two copies
#  disagree is the day "it worked locally" stops being evidence about the
#  thing visitors see.  One quantity, one home; a build recipe is a quantity.
#
#  THE SINGLE-ORIGIN LAYOUT (no asset rebasing anywhere):
#      site/_dist/index.html        the LANDING, at /
#      site/_dist/app/index.html    the APP entry, at /app
#      site/_dist/{assets,wasm,workers,docs}/   served at ROOT, so the app's
#                                   absolute /assets, /wasm, /workers refs
#                                   resolve and /app/index.html runs unchanged.
#
#  The simulator (choupoSolve.wasm and friends) is DELIVERED by whatever
#  serves this directory and EXECUTES in the visitor's browser tab.  No server
#  ever computes a flash.  That is not an implementation detail: it is why a
#  static host is enough, why there is no per-user state, and why a visitor's
#  case never leaves their machine.
#
#  Usage:
#      bin/buildSite            build the app, then assemble
#      bin/buildSite --no-build reuse gui/dist, just assemble
#
#  Requires (for a full build): npm, and gui/node_modules installed.  The
#  WASM must already be built (`make wasm-gui`) -- this script does NOT build
#  it, because a 7-minute Emscripten link has no business hiding inside an
#  assembly step that otherwise takes a second.
#---------------------------------------------------------------------------#

set -e

script_dir=$(dirname "$(readlink -f "$0")")
root=$(readlink -f "$script_dir/..")
gui="$root/gui"
src="$root/site"
dist="$src/_dist"

if [ "${1:-}" != "--no-build" ]; then
    #  The guide PDFs FIRST (incremental), so the served Help links never 404.
    if command -v pdflatex >/dev/null 2>&1; then
        echo "[buildSite] compiling guide PDFs (make -C docs) ..."
        ( cd "$root/docs" && make all >/dev/null 2>&1 ) \
            || echo "[buildSite] WARN: docs build had errors; using existing PDFs"
    else
        echo "[buildSite] WARN: no pdflatex -- using existing docs/*.pdf"
    fi
    echo "[buildSite] building the app (npm run build) ..."
    ( cd "$gui" && npm run build )
fi

if [ ! -d "$gui/dist" ]; then
    echo "[buildSite] ERROR: no app build at $gui/dist (run without --no-build first)" >&2
    exit 1
fi
if [ ! -f "$gui/public/wasm/choupoSolve.wasm" ]; then
    echo "[buildSite] ERROR: no WASM at gui/public/wasm -- run \`make wasm-gui\` first." >&2
    echo "[buildSite]        A site assembled without it serves an app that cannot solve." >&2
    exit 1
fi

echo "[buildSite] assembling combined site -> $dist"
rm -rf "$dist"
mkdir -p "$dist/app"
cp -r "$gui/dist/." "$dist/"          # app assets + the app index.html at root
mv "$dist/index.html" "$dist/app/index.html"   # the APP lives at /app
cp "$src/index.html" "$dist/index.html"         # the LANDING lives at /
# The model catalogue page at /models/ (clean route via a directory index).
mkdir -p "$dist/models"
cp "$src/models.html" "$dist/models/index.html" 2>/dev/null || true
# The releases page at /releases/ (same clean-route pattern).
mkdir -p "$dist/releases"
cp "$src/releases.html" "$dist/releases/index.html" 2>/dev/null || true
# The generated single-source-of-truth JSONs the landing + /models consume.
python3 "$root/bin/curate/release_inventory.py" >/dev/null 2>&1 || true
cp "$root/generated/releaseInventory.json" "$dist/" 2>/dev/null || true
cp "$root/generated/modelsCatalogue.json"  "$dist/" 2>/dev/null || true
cp "$src"/*.svg "$dist/" 2>/dev/null || true
cp "$src"/*.png "$dist/" 2>/dev/null || true    # landing logo (logo2.png) + any raster art
cp "$src"/*.webp "$dist/" 2>/dev/null || true   # compressed landing product imagery
cp "$src/sw.js" "$dist/" 2>/dev/null || true    # offline service worker (scope /)
#  The custom domain, when one is declared.  GitHub Pages reads CNAME from the
#  root of what is published; keeping it in site/ means the domain is a fact of
#  the SITE, versioned beside the pages it names, not a setting in a web UI
#  that no clone can see.
cp "$src/CNAME" "$dist/" 2>/dev/null || true
#  Jekyll is not involved and must not be: a directory or file beginning with
#  an underscore (the app's chunks can) would be silently dropped otherwise.
touch "$dist/.nojekyll"

#  THE PUBLISHED ARTEFACT IS THE ONE A READER OPENS.  On 2026-08-05
#  choupo.org served a Theory Guide title page reading "Version 2607 / 30 June
#  2026" while the repository's own PDF said Choupo-dev -- the deployed build
#  was six days old, and nothing anywhere compared the two.  The in-repo half
#  is now gated (bin/curate/check_guide_pdf_version.py); this is the other
#  half, and it runs where the staleness actually appears: after assembly,
#  against what is about to be published.
if command -v pdftotext >/dev/null 2>&1; then
    _want=$(sed -n 's/.*CHOUPO_VERSION[[:space:]]*=[[:space:]]*"\([^"]*\)".*/\1/p' \
            "$root/src/core/Banner.H" | head -1)
    _bad=0
    for _g in theoryGuide userGuide propsGuide developerGuide; do
        [ -f "$dist/docs/$_g.pdf" ] || continue
        if ! pdftotext -f 1 -l 1 "$dist/docs/$_g.pdf" - 2>/dev/null | grep -qF "$_want"; then
            echo "[buildSite] ERROR: $_g.pdf about to be PUBLISHED does not carry '$_want' on its title page" >&2
            _bad=1
        fi
    done
    if [ "$_bad" = 1 ]; then
        echo "[buildSite]        A guide naming a version it does not describe is worse than an undated one:" >&2
        echo "[buildSite]        the wrong label is believed.  Run: bin/curate/guide_version.py && make -C docs all" >&2
        exit 1
    fi
    echo "[buildSite] guide PDFs verified: all four title pages read $_want"
else
    #  A CHECK THAT CANNOT RUN MUST NOT PASS.  This branch used to WARN and
    #  continue, and on 2026-08-05 that is exactly what happened in CI: the
    #  GitHub runner has no `pdftotext`, so the very gate written to stop a
    #  mislabelled guide reaching choupo.org printed one line into a
    #  900-line log and published anyway.  The guide happened to be correct;
    #  nothing here established that.
    #
    #  A missing tool is not evidence of a good artefact -- it is the absence
    #  of evidence, and reporting the absence as a pass is the silent
    #  fallback the project forbids everywhere else (invariant I5).  So the
    #  publishing path REFUSES.
    #
    #  CHOUPO_SKIP_PDF_VERIFY exists for a developer assembling the site
    #  locally without poppler, and it is deliberately an ACT: you have to
    #  type it, and it says out loud what it bought.  CI never sets it -- the
    #  workflow installs poppler-utils instead.
    if [ -n "${CHOUPO_SKIP_PDF_VERIFY:-}" ]; then
        echo "[buildSite] WARN: pdftotext absent and CHOUPO_SKIP_PDF_VERIFY set --" >&2
        echo "[buildSite]       the guide versions in this build are UNVERIFIED." >&2
        echo "[buildSite]       Do not publish this assembly." >&2
    else
        echo "[buildSite] ERROR: pdftotext is not installed, so the guide title pages" >&2
        echo "[buildSite]        about to be published CANNOT be verified." >&2
        echo "[buildSite]        Refusing: an unverifiable claim is not a verified one." >&2
        echo "[buildSite]        REMEDY: install poppler-utils (apt-get install -y poppler-utils)," >&2
        echo "[buildSite]        or set CHOUPO_SKIP_PDF_VERIFY=1 for a local build you will NOT publish." >&2
        exit 1
    fi
fi

echo "[buildSite] done:  $(du -sh "$dist" | cut -f1)  in  $dist"
