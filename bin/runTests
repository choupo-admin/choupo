    # mineral records and their dissolution reactions
    if "$ROOT/bin/curate/check_minerals.py" > /tmp/check_minerals.$$ 2>&1; then
        printf "PASS  %-40s  (%s)\n" "minerals-gate" "$(tail -1 /tmp/check_minerals.$$)"
        pass=$((pass+1))
    else
        printf "FAIL  %-40s  (run bin/curate/check_minerals.py)\n" "minerals-gate"
        cat /tmp/check_minerals.$$
        fail=$((fail+1))
    fi
    rm -f /tmp/check_minerals.$$

    # the Pitzer pair catalogue
    if "$ROOT/bin/curate/check_pitzer_pairs.py" > /tmp/check_pitzer_pairs.$$ 2>&1; then
        printf "PASS  %-40s  (%s)\n" "pitzer-pairs-gate" "$(tail -1 /tmp/check_pitzer_pairs.$$)"
        pass=$((pass+1))
    else
        printf "FAIL  %-40s  (run bin/curate/check_pitzer_pairs.py)\n" "pitzer-pairs-gate"
        cat /tmp/check_pitzer_pairs.$$
        fail=$((fail+1))
    fi
    rm -f /tmp/check_pitzer_pairs.$$

    # the eNRTL pair catalogue
    if "$ROOT/bin/curate/check_enrtl.py" > /tmp/check_enrtl.$$ 2>&1; then
        printf "PASS  %-40s  (%s)\n" "enrtl-gate" "$(tail -1 /tmp/check_enrtl.$$)"
        pass=$((pass+1))
    else
        printf "FAIL  %-40s  (run bin/curate/check_enrtl.py)\n" "enrtl-gate"
        cat /tmp/check_enrtl.$$
        fail=$((fail+1))
    fi
    rm -f /tmp/check_enrtl.$$

    # the gas-liquid (Henry) records
    if "$ROOT/bin/curate/check_gases.py" > /tmp/check_gases.$$ 2>&1; then
        printf "PASS  %-40s  (%s)\n" "gases-gate" "$(tail -1 /tmp/check_gases.$$)"
        pass=$((pass+1))
    else
        printf "FAIL  %-40s  (run bin/curate/check_gases.py)\n" "gases-gate"
        cat /tmp/check_gases.$$
        fail=$((fail+1))
    fi
    rm -f /tmp/check_gases.$$

    # the mixing-rule records
    if "$ROOT/bin/curate/check_mixing.py" > /tmp/check_mixing.$$ 2>&1; then
        printf "PASS  %-40s  (%s)\n" "mixing-gate" "$(tail -1 /tmp/check_mixing.$$)"
        pass=$((pass+1))
    else
        printf "FAIL  %-40s  (run bin/curate/check_mixing.py)\n" "mixing-gate"
        cat /tmp/check_mixing.$$
        fail=$((fail+1))
    fi
    rm -f /tmp/check_mixing.$$

    # the group-contribution group table
    if "$ROOT/bin/curate/check_groups.py" > /tmp/check_groups.$$ 2>&1; then
        printf "PASS  %-40s  (%s)\n" "groups-gate" "$(tail -1 /tmp/check_groups.$$)"
        pass=$((pass+1))
    else
        printf "FAIL  %-40s  (run bin/curate/check_groups.py)\n" "groups-gate"
        cat /tmp/check_groups.$$
        fail=$((fail+1))
    fi
    rm -f /tmp/check_groups.$$

    # the ion-exchange resin records
    if "$ROOT/bin/curate/check_ionexchange.py" > /tmp/check_ionexchange.$$ 2>&1; then
        printf "PASS  %-40s  (%s)\n" "ionexchange-gate" "$(tail -1 /tmp/check_ionexchange.$$)"
        pass=$((pass+1))
    else
        printf "FAIL  %-40s  (run bin/curate/check_ionexchange.py)\n" "ionexchange-gate"
        cat /tmp/check_ionexchange.$$
        fail=$((fail+1))
    fi
    rm -f /tmp/check_ionexchange.$$

    # flashComplex gate: the DESIGN-DRIVER case must keep closing.  It lives
    # in docs/design/, not tutorials/, because sealing it is an unresolved
    # CURATION question (ten component records differ from the catalogue in
    # real data -- its README carries the numbers).  So the case loop never
    # runs it, and the hardest thing the solver does had no regression signal
    # at all: every slice of the phase work could break it with the whole
    # suite staying green.  Verified by sabotage -- deleting the organic
    # declaration leaves it converging, exit 0, answering a different problem.
    if "$ROOT/bin/curate/check_flash_complex.py" > /tmp/fcgate.$$ 2>&1; then
        printf "PASS  %-40s  (%s)\n" "flashComplex-gate" "$(tail -1 /tmp/fcgate.$$)"
        pass=$((pass+1))
    else
        printf "FAIL  %-40s  (run bin/curate/check_flash_complex.py)\n" "flashComplex-gate"
        cat /tmp/fcgate.$$
        fail=$((fail+1))
    fi
    rm -f /tmp/fcgate.$$

    # Duplicate-key gate: the parser refuses a key declared twice, but only
    # for a file some case LOADS.  A record nobody opens carries the defect
    # silently until the day it is used -- which is exactly how twelve
    # standard components sat there discarding their Joback groups.  This
    # sweeps every dict on disk, loaded or not, and it exists because the
    # corpus was SAMPLED once (sixty cases, declared clean) and the full
    # suite then found four more.
    if "$ROOT/bin/curate/check_duplicate_keys.py" > /tmp/dupkey.$$ 2>&1; then
        printf "PASS  %-40s  (%s)\n" "duplicate-key-gate" "$(tail -1 /tmp/dupkey.$$)"
        pass=$((pass+1))
    else
        printf "FAIL  %-40s  (run bin/curate/check_duplicate_keys.py)\n" "duplicate-key-gate"
        cat /tmp/dupkey.$$
        fail=$((fail+1))
    fi
    rm -f /tmp/dupkey.$$

    # Registry-scan gate: the duplicate-key sweep above covers ONE key twice
    # inside ONE file.  The same failure lives one level up -- two FILES both
    # claiming one record's identity, where the registry is keyed by a name
    # read from inside the file and `registry()[key] = rec` kept whichever the
    # directory listing reached last.  It is not hypothetical: flash16 with
    # its CO3 formation record duplicated ran to exit 0 and moved the pH.
    if "$ROOT/bin/curate/check_registry_scan.py" > /tmp/regscan.$$ 2>&1; then
        printf "PASS  %-40s  (%s)\n" "registry-scan-gate" "$(tail -1 /tmp/regscan.$$)"
        pass=$((pass+1))
    else
        printf "FAIL  %-40s  (run bin/curate/check_registry_scan.py)\n" "registry-scan-gate"
        cat /tmp/regscan.$$
        fail=$((fail+1))
    fi
    rm -f /tmp/regscan.$$

    # Standard-include gate: g++ hands a file <sstream> through <iostream>;
    # emscripten's libc++ does not.  So the WASM build -- which is what
    # www.choupo.org is MADE of -- can fail on a file that compiles perfectly
    # here, and it did: the psychrometric chart's label lambda used a
    # stringstream without the header, `make all` was clean, this suite was
    # 333 PASS, and every publish-site run failed at the build step until the
    # failure arrived by EMAIL.  Building both compilers on every slice costs
    # ~8 min of emscripten; this costs a second and catches that shape.
    if "$ROOT/bin/curate/check_std_includes.py" > /tmp/stdinc.$$ 2>&1; then
        printf "PASS  %-40s  (%s)\n" "std-include-gate" "$(tail -1 /tmp/stdinc.$$)"
        pass=$((pass+1))
    else
        printf "FAIL  %-40s  (run bin/curate/check_std_includes.py)\n" "std-include-gate"
        cat /tmp/stdinc.$$
        fail=$((fail+1))
    fi
    rm -f /tmp/stdinc.$$

    # Git-visibility gate: .gitignore's broad case-output rules (`**/postProcessing/`,
    # `**/solution/`) match a directory ANYWHERE, and two of them were sitting
    # on src/ directories.  The files already there are tracked so nothing
    # looked wrong -- but a NEW file added there is invisible to `git status`,
    # and this project stages explicitly (never `git add -A`), so it would
    # simply never be committed.  Both were found by accident; this finds them
    # on purpose.
    if "$ROOT/bin/curate/check_git_visibility.py" > /tmp/gitvis.$$ 2>&1; then
        printf "PASS  %-40s  (%s)\n" "git-visibility-gate" "$(tail -1 /tmp/gitvis.$$)"
        pass=$((pass+1))
    else
        printf "FAIL  %-40s  (run bin/curate/check_git_visibility.py)\n" "git-visibility-gate"
        cat /tmp/gitvis.$$
        fail=$((fail+1))
    fi
    rm -f /tmp/gitvis.$$

    # Type-coverage gate: a registered type is a PROMISE -- it shows in the
    # GUI's palette and a student may write it in a dict.  Four property ops
    # had no case; the first one written for `vaporPressureFit` segfaulted
    # choupoProps twice and then ran with a silently empty package, and
    # `evaporativeDryer` was the last unit-op class nobody built.  Aliases
    # need no case of their own (`flash` and `isothermalFlash` are one
    # class); a CLASS with no case at all is the failure.
    if "$ROOT/bin/curate/check_type_coverage.py" > /tmp/typecov.$$ 2>&1; then
        printf "PASS  %-40s  (%s)\n" "type-coverage-gate" "$(tail -1 /tmp/typecov.$$)"
        pass=$((pass+1))
    else
        printf "FAIL  %-40s  (run bin/curate/check_type_coverage.py)\n" "type-coverage-gate"
        cat /tmp/typecov.$$
        fail=$((fail+1))
    fi
    rm -f /tmp/typecov.$$

    # Cosmo-scrub gate: the public tree ships NO externally-restricted values.
    # A COSMO set is an external REFERENCE (licence externalRestricted;
    # installed false) or carries an open-licence profile (the synthetic
    # teaching surrogates); a VT-2005 profile anywhere in data/ or tutorials/
    # is redistribution and fails here.
    if "$ROOT/bin/curate/check_cosmo_scrub.py" > /tmp/csgate.$$ 2>&1; then
        printf "PASS  %-40s  (%s)\n" "cosmo-scrub-gate" "$(head -1 /tmp/csgate.$$)"
        pass=$((pass+1))
    else
        printf "FAIL  %-40s  (run bin/curate/check_cosmo_scrub.py)\n" "cosmo-scrub-gate"
        cat /tmp/csgate.$$
        fail=$((fail+1))
    fi
    rm -f /tmp/csgate.$$

    # Header self-containment gate: every src/**/*.H compiles ALONE with the
    # project flags (g++ -fsyntax-only) -- a header that only works through
    # an accidental transitive include couples the build graph invisibly.
    if "$ROOT/bin/checkHeaderSelfContained" > /tmp/hscgate.$$ 2>&1; then
        printf "PASS  %-40s  (%s)\n" "header-selfcontained-gate" "$(tail -1 /tmp/hscgate.$$)"
        pass=$((pass+1))
    else
        printf "FAIL  %-40s  (run bin/checkHeaderSelfContained)\n" "header-selfcontained-gate"
        cat /tmp/hscgate.$$
        fail=$((fail+1))
    fi
    rm -f /tmp/hscgate.$$

    # Equilibrium-family gate: identity per curated parameterisation
    # (typed family refs + versioned convention profiles); cross-convention
    # comparisons are curation DIAGNOSTICS, duplicates/contradicted
    # identity are the errors (ADR 2026-07-26).
    if "$ROOT/bin/curate/check_equilibrium_families.py" > /tmp/efgate.$$ 2>&1; then
        printf "PASS  %-40s  (%s)\n" "equilibrium-family-gate" "$(head -1 /tmp/efgate.$$)"
        grep "\[diagnostic\]" /tmp/efgate.$$ || true
        pass=$((pass+1))
    else
        printf "FAIL  %-40s  (run bin/curate/check_equilibrium_families.py)\n" "equilibrium-family-gate"
        cat /tmp/efgate.$$
        fail=$((fail+1))
    fi
    rm -f /tmp/efgate.$$

    # Legacy-schema gate (D2 closed migration): no pre-identity gas-liquid
    # schema in the dev corpus -- standards chemistry records canonical
    # (schemaVersion 2 + typed identity), Henry pairs identity-complete,
    # sealed tutorial mirrors re-imported.  The loader's legacy adapter is
    # for OLD EXTERNAL cases only (announced, converted in memory).
    if "$ROOT/bin/curate/check_legacy_schema.py" > /tmp/lsgate.$$ 2>&1; then
        printf "PASS  %-40s  (%s)\n" "legacy-schema-gate" "$(head -1 /tmp/lsgate.$$)"
        pass=$((pass+1))
    else
        printf "FAIL  %-40s  (run bin/curate/check_legacy_schema.py)\n" "legacy-schema-gate"
        cat /tmp/lsgate.$$
        fail=$((fail+1))
    fi
    rm -f /tmp/lsgate.$$

    # Record-form gate: the settled shape of a data record, enforced in
    # docs/design/ too -- the one place the 25 other gates never looked, and
    # therefore the place where `role`, a second standard state and six
    # single-valued ceremony fields silently came back on 2026-07-27.
    if "$ROOT/bin/curate/check_record_form.py" > /tmp/rfgate.$$ 2>&1; then
        printf "PASS  %-40s  (%s)\n" "record-form-gate" "$(tail -1 /tmp/rfgate.$$)"
        grep "still carry" /tmp/rfgate.$$ || true
        pass=$((pass+1))
    else
        printf "FAIL  %-40s  (run bin/curate/check_record_form.py)\n" "record-form-gate"
        cat /tmp/rfgate.$$
        fail=$((fail+1))
    fi
    rm -f /tmp/rfgate.$$

    # Family-outlier gate (born 2026-07-27 from a real defect: CaHCO3+ held
    # logK -4.059 / dH 158 kJ/mol against siblings at +1.0 / 3-25 kJ/mol,
    # while citing a source that holds +1.106).  INFORMATIONAL: chemistry has
    # real outliers, so this reports for a human eye and never fails.
    if "$ROOT/bin/curate/check_family_outliers.py" > /tmp/fogate.$$ 2>&1; then
        printf "PASS  %-40s  (%s)\n" "family-outlier-gate" "$(head -1 /tmp/fogate.$$)"
        grep -E "deserve a human eye|MAD from" /tmp/fogate.$$ || true
        pass=$((pass+1))
    else
        printf "FAIL  %-40s  (run bin/curate/check_family_outliers.py)\n" "family-outlier-gate"
        cat /tmp/fogate.$$
        fail=$((fail+1))
    fi
    rm -f /tmp/fogate.$$

    # Composite-limits gate: the composite mixed-solvent electrolyte v1
    # surface must RECOVER its pure constituents at the limits (x_co -> 0,
    # I -> 0, NRTL -> ideal) -- proven on live solver probes, never assumed.
    if "$ROOT/bin/curate/check_composite_limits.py" > /tmp/clgate.$$ 2>&1; then
        printf "PASS  %-40s  (%s)\n" "composite-limits-gate" "$(tail -1 /tmp/clgate.$$)"
        pass=$((pass+1))
    else
        printf "FAIL  %-40s  (run bin/curate/check_composite_limits.py)\n" "composite-limits-gate"
        cat /tmp/clgate.$$
        fail=$((fail+1))
    fi
    rm -f /tmp/clgate.$$

    # Resolver-coherence gate: the aqueousSpeciation facts on standards
    # components must agree with the bridges and the chemistry catalogue
    # (a lying fact misclassifies a system silently), and vapour reactions
    # stay off the aqueous records (phase purity, ratified 2026-07-26).
    if "$ROOT/bin/curate/check_resolver_coherence.py" > /tmp/rcgate.$$ 2>&1; then
        printf "PASS  %-40s  (%s)\n" "resolver-coherence-gate" "$(head -1 /tmp/rcgate.$$)"
        pass=$((pass+1))
    else
        printf "FAIL  %-40s  (run bin/curate/check_resolver_coherence.py)\n" "resolver-coherence-gate"
        cat /tmp/rcgate.$$
        fail=$((fail+1))
    fi
    rm -f /tmp/rcgate.$$

    # Sealed-corpus gate: every top-level case carries constant/propertyManifest
    # -- the student finds a hashed copy of every record the case uses INSIDE
    # the case.  The two live-overlay demos are exempt by design (their lesson
    # IS the un-sealed overlay against the evolving catalogue).
    if "$ROOT/bin/curate/check_sealed_corpus.py" > /tmp/scgate.$$ 2>&1; then
        printf "PASS  %-40s  (%s)\n" "sealed-corpus-gate" "$(head -1 /tmp/scgate.$$)"
        pass=$((pass+1))
    else
        printf "FAIL  %-40s  (run bin/curate/check_sealed_corpus.py)\n" "sealed-corpus-gate"
        cat /tmp/scgate.$$
        fail=$((fail+1))
    fi
    rm -f /tmp/scgate.$$

    # Element-balance gate (steady): a reacting boundary changes species but
    # closes per atom; an impossible formula refuses ONLY the elemental claim.
    # Basis-rank gate: the component->species map's rank refusal actually
    # fires and names the theorem's numbers -- AND a full-rank multi-master
    # basis still runs.  flash15 is `.expect-nonconvergence`, which makes the
    # tutorial sweep SKIP it; without this gate nothing would ever check that
    # the refusal still happens.  A refusal with no test rots.
    if "$ROOT/bin/curate/check_basis_rank.py" > /tmp/brgate.$$ 2>&1; then
        printf "PASS  %-40s  (%s)\n" "basis-rank-gate" "$(head -1 /tmp/brgate.$$)"
        pass=$((pass+1))
    else
        printf "FAIL  %-40s  (run bin/curate/check_basis_rank.py)\n" "basis-rank-gate"
        cat /tmp/brgate.$$
        fail=$((fail+1))
    fi
    rm -f /tmp/brgate.$$

    # Second-liquid gate: the reactive three-phase answer really carries two
    # liquids, and the activity equality that ties them holds at the answer.
    # No golden-master KPI can see this -- the two liquids leave as ONE
    # apparent stream, so a case that silently reverted to one liquid would
    # produce byte-identical stream numbers.
    if "$ROOT/bin/curate/check_two_liquids.py" > /tmp/tlgate.$$ 2>&1; then
        printf "PASS  %-40s  (%s)\n" "second-liquid-gate" "$(head -1 /tmp/tlgate.$$)"
        pass=$((pass+1))
    else
        printf "FAIL  %-40s  (run bin/curate/check_two_liquids.py)\n" "second-liquid-gate"
        cat /tmp/tlgate.$$
        fail=$((fail+1))
    fi
    rm -f /tmp/tlgate.$$

    # Stream-basis gate: a feed written in the aqueous-SPECIES basis gives the
    # SAME answer as the components it inverts to, and its three refusals
    # (charge, network, basis) still fire.  Invisible to a golden master: the
    # projection happens on read, so by the time a KPI sees the case it is an
    # ordinary component-basis stream.
    if "$ROOT/bin/curate/check_stream_basis.py" > /tmp/sbgate.$$ 2>&1; then
        printf "PASS  %-40s  (%s)\n" "stream-basis-gate" "$(head -1 /tmp/sbgate.$$)"
        pass=$((pass+1))
    else
        printf "FAIL  %-40s  (run bin/curate/check_stream_basis.py)\n" "stream-basis-gate"
        cat /tmp/sbgate.$$
        fail=$((fail+1))
    fi
    rm -f /tmp/sbgate.$$

    if "$ROOT/bin/curate/check_element_balance.py" > /tmp/ebgate.$$ 2>&1; then
        printf "PASS  %-40s  (%s)\n" "element-balance-gate" "$(head -1 /tmp/ebgate.$$)"
        pass=$((pass+1))
    else
        printf "FAIL  %-40s  (run bin/curate/check_element_balance.py)\n" "element-balance-gate"
        cat /tmp/ebgate.$$
        fail=$((fail+1))
    fi
    rm -f /tmp/ebgate.$$

    # Ctrl balance-ledger gate: accepted-state integration closes mass+atoms;
    # the elemental and energy claims are honest (withheld/refused with named
    # reasons, never fabricated).
    if "$ROOT/bin/curate/check_ctrl_balance.py" > /tmp/cbgate.$$ 2>&1; then
        printf "PASS  %-40s  (%s)\n" "ctrl-balance-gate" "$(head -1 /tmp/cbgate.$$)"
        pass=$((pass+1))
    else
        printf "FAIL  %-40s  (run bin/curate/check_ctrl_balance.py)\n" "ctrl-balance-gate"
        cat /tmp/cbgate.$$
        fail=$((fail+1))
    fi
    rm -f /tmp/cbgate.$$

    # Flash-model gate: the machine that solves a flash has a NAME (`model`,
    # the distillation convention) -- and a name that cannot lie.  Four
    # refusals, including the one that matters: a REACTIVE package's machine
    # belongs to the declared formulation, never to the unit.
    if "$ROOT/bin/curate/check_flash_model.py" > /tmp/fmgate.$$ 2>&1; then
        printf "PASS  %-40s  (%s)\n" "flash-model-gate" "$(head -1 /tmp/fmgate.$$)"
        pass=$((pass+1))
    else
        printf "FAIL  %-40s  (run bin/curate/check_flash_model.py)\n" "flash-model-gate"
        cat /tmp/fmgate.$$
        fail=$((fail+1))
    fi
    rm -f /tmp/fmgate.$$

    # Charge-balance gate: when a case SOLVES its pH, electroneutrality is an
    # equation the solver imposes, so its residual on the ANSWER belongs at
    # round-off -- and a precipitating crystal, being neutral, may not move it.
    # (The double-counted carbonate proton this catches was invisible to every
    # other check: converged, exit 0, goldens green, scale under-read by 37%.)
    if "$ROOT/bin/curate/check_charge_balance.py" > /tmp/qgate.$$ 2>&1; then
        printf "PASS  %-40s  (%s)\n" "charge-balance-gate" "$(head -1 /tmp/qgate.$$)"
        pass=$((pass+1))
    else
        printf "FAIL  %-40s  (run bin/curate/check_charge_balance.py)\n" "charge-balance-gate"
        cat /tmp/qgate.$$
        fail=$((fail+1))
    fi
    rm -f /tmp/qgate.$$

    # Asset-home gate (Codex assets-audit, 2026-07-18): a physical asset lives
    # in ONE home (constant/assets/) -- the legacy membranes/ overlay let a
    # sealed case open input its manifest never claimed.
    if "$ROOT/bin/curate/check_asset_homes.py" > /tmp/assetgate.$$ 2>&1; then
        printf "PASS  %-40s  (%s)\n" "asset-home-gate" "$(head -1 /tmp/assetgate.$$)"
        pass=$((pass+1))
    else
        printf "FAIL  %-40s  (run bin/curate/check_asset_homes.py)\n" "asset-home-gate"
        cat /tmp/assetgate.$$
        fail=$((fail+1))
    fi
    rm -f /tmp/assetgate.$$

    # Empty-dir gate (2026-07-18): reachable-closure / methods removals must
    # leave no hollow species/ or parameters/ shells (the importer prunes).
    if "$ROOT/bin/curate/check_empty_dirs.py" > /tmp/emptygate.$$ 2>&1; then
        printf "PASS  %-40s  (%s)\n" "empty-dir-gate" "$(head -1 /tmp/emptygate.$$)"
        pass=$((pass+1))
    else
        printf "FAIL  %-40s  (run bin/curate/check_empty_dirs.py)\n" "empty-dir-gate"
        cat /tmp/emptygate.$$
        fail=$((fail+1))
    fi
    rm -f /tmp/emptygate.$$

    # Seal-drift gate (sealing wave, 2026-07-17): every sealed record's origin
    # sha256 vs the LIVE catalogue.  Drift (catalogue evolved under a frozen
    # copy) is REPORTED but passes -- refreshing is a per-case curation act;
    # DAMAGE (a claimed file missing / failing its own manifest hash) FAILS.
    if "$ROOT/bin/curate/check_seal_drift.py" > /tmp/sealgate.$$ 2>&1; then
        printf "PASS  %-40s  (%s)\n" "seal-drift-gate" "$(head -1 /tmp/sealgate.$$)"
        pass=$((pass+1))
        if grep -q 'SEAL DRIFT' /tmp/sealgate.$$; then cat /tmp/sealgate.$$; fi
    else
        printf "FAIL  %-40s  (broken seal manifest -- run bin/curate/check_seal_drift.py)\n" "seal-drift-gate"
        cat /tmp/sealgate.$$
        fail=$((fail+1))
    fi
    rm -f /tmp/sealgate.$$

    # Release-inventory gate (ChatGPT landing-plan §5): the generated single-
    # source-of-truth counts (generated/releaseInventory.json, consumed by the
    # homepage hero + "What is inside" + /models) must match the current tree --
    # a published release metric may not silently drift.  Regenerate to fix.
    if "$ROOT/bin/curate/release_inventory.py" --check > /tmp/inventory.$$ 2>&1; then
        printf "PASS  %-40s  (%s)\n" "release-inventory-gate" "$(head -1 /tmp/inventory.$$)"
        pass=$((pass+1))
    else
        printf "FAIL  %-40s  (stale -- run bin/curate/release_inventory.py)\n" "release-inventory-gate"
        cat /tmp/inventory.$$
        fail=$((fail+1))
    fi
    rm -f /tmp/inventory.$$

    # Adsorption catalogue gate: pair records have one home, declared bases,
    # provenance and an honest quality class.  In particular a historical
    # teaching fit may not masquerade as directly measured literature data.
    if "$ROOT/bin/curate/check_adsorption_tree.py" > /tmp/adsorption.$$ 2>&1; then
        printf "PASS  %-40s  (%s)\n" "adsorption-tree-gate" "$(head -1 /tmp/adsorption.$$)"
        pass=$((pass+1))
    else
        printf "FAIL  %-40s  (adsorption catalogue contract -- run bin/curate/check_adsorption_tree.py)\n" "adsorption-tree-gate"
        cat /tmp/adsorption.$$
        fail=$((fail+1))
    fi
    rm -f /tmp/adsorption.$$

    # One-enthalpy-surface gate (forum #103/#105): the retired H_stream
    # blend must never re-enter a balance/duty/published .H; the surviving
    # blend is legal only at AUTHORIZED-BLEND loci, LISTED by the gate.
    if "$ROOT/bin/curate/check_h_surface.py" > /tmp/hsurface.$$ 2>&1; then
        printf "PASS  %-40s  (%s)\n" "h-surface-gate" "$(head -1 /tmp/hsurface.$$)"
        pass=$((pass+1))
    else
        printf "FAIL  %-40s  (legacy enthalpy surface -- run bin/curate/check_h_surface.py)\n" "h-surface-gate"
        cat /tmp/hsurface.$$
        fail=$((fail+1))
    fi
    rm -f /tmp/hsurface.$$
fi

for case_dir in "${CASES[@]}"; do
    name_short=$(basename "$case_dir")

    # --- honest opt-outs, classified BEFORE gating ------------------------
    #  Neither is ever reported PASS.  The case is still RUN (so its state is
    #  observable in -v output) but its result does not gate the suite.
    if [ -f "$case_dir/.known-broken" ]; then
        reason=$(grep -vE '^[[:space:]]*#' "$case_dir/.known-broken" 2>/dev/null \
                 | grep -m1 -vE '^[[:space:]]*$')
        printf "KNOWN-BROKEN  %-32s  (%s)\n" "$name_short" "${reason:-see .known-broken}"
        known_broken=$((known_broken+1)); KB_NAMES+=("$name_short"); continue
    fi
    if [ -f "$case_dir/.expect-nonconvergence" ]; then
        reason=$(grep -vE '^[[:space:]]*#' "$case_dir/.expect-nonconvergence" 2>/dev/null \
                 | grep -m1 -vE '^[[:space:]]*$')
        printf "EXPECTED-FAIL %-32s  (%s)\n" "$name_short" "${reason:-deliberate teaching non-convergence}"
        expected_fail=$((expected_fail+1)); EF_NAMES+=("$name_short"); continue
    fi

    app=$(binary_for "$case_dir")
    out=$(run_case_raw "$case_dir" "$app"); rc=$?

    if [ "$out" = "__BUILDFAIL__" ]; then
        printf "FAIL  %-40s  (compile failed)\n" "$name_short"; fail=$((fail+1)); continue
    fi

    # (0) exit-code guard -- a non-zero exit (a crashed / aborted run) is a FAIL.
    #     This is the §10 fix: a crash that emits no result block used to fall
    #     through to a vacuous "smoke pass"; it no longer can.
    if [ "$rc" -ne 0 ]; then
        printf "FAIL  %-40s  (non-zero exit code %s -- crashed/aborted)\n" "$name_short" "$rc"
        fail=$((fail+1)); continue
    fi

    # result block only (avoid false hits in the iteration log)
    block=$(printf '%s\n' "$out" | sed -n '/result-begin/,/result-end/p')
    have_block=1; [ -z "$block" ] && { have_block=0; block="$out"; }

    # (1) NaN / inf guard
    if printf '%s\n' "$block" | grep -qiE ':[[:space:]]*-?(nan|inf)\b'; then
        printf "FAIL  %-40s  (NaN/inf in result)\n" "$name_short"; fail=$((fail+1)); continue
    fi

    # (2) result-block guard -- a case that PROMISES a golden but emits NO
    #     comparable result block FAILS (the golden cannot be checked
    #     vacuously).  Without this, an errored-but-exit-0 run, or one whose
    #     result-begin/result-end markers never appeared, would slip through.
    if [ -f "$case_dir/expected" ] && [ "$have_block" -eq 0 ]; then
        printf "FAIL  %-40s  (no result block, but ships a golden 'expected')\n" "$name_short"
        fail=$((fail+1)); continue
    fi

    # (3) reference KPIs
    if [ -f "$case_dir/expected" ]; then
        bad=""
        while read -r line; do
            case "$line" in ''|\#*) continue;; esac
            read -r kind name key exp_v tol _ <<< "$line"
            [ -z "${tol:-}" ] && continue
            act=$(get_any "$out" "$kind" "$name" "$key")
            within_tol "$act" "$exp_v" "$tol"
            case $? in
              0) ;;
              2) bad="$bad\n    $kind.$name.$key: MISSING (expected $exp_v)";;
              *) bad="$bad\n    $kind.$name.$key: got ${act:-?} expected $exp_v (reltol $tol)";;
            esac
        done < "$case_dir/expected"
        if [ -n "$bad" ]; then
            printf "FAIL  %-40s  (KPI mismatch)" "$name_short"; printf "$bad\n"; fail=$((fail+1)); continue
        fi
        printf "PASS  %-40s  (checked vs reference)\n" "$name_short"; pass=$((pass+1))
    else
        printf "pass  %-40s  (smoke + NaN guard)\n" "$name_short"; pass=$((pass+1))
    fi
done

# --- standalone-branch regression (lean-fractal promise) ------------------
#  The lean fractal layout PROMISES that any branch of a composite plant can be
#  run on its OWN (./choupoSolve <plant>/<BRANCH>) with its inlets frozen.  The
#  thermoPackage + component overlays already cascaded UP for a standalone
#  branch, but the REACTIONS library did NOT -- so FERMENTATION run alone threw
#  "reaction 'sucroseToEthanol' not in constant/reactions" (forum Finding D).
#  This guard pins the fix: the pilot branch must run alone, EXIT 0, AND
#  ANNOUNCE where its reactions came from (the loud, non-silent cascade).  It is
#  pilot-scoped (only on the full sweep) -- a general standalone-branch sweep
#  would be too broad while the fractal layout is still a pilot.
if [ "$#" -eq 0 ]; then
    branch="tutorials/plant/ChemicalPlantTutorial/FERMENTATION"
    if [ -f "$branch/flowsheetDict" ]; then
        sb_out=$("$ROOT/choupoSolve" "$branch" 2>&1); sb_rc=$?
        sb_announced=0
        printf '%s\n' "$sb_out" | grep -qE 'reactions library: loaded — (inherited from|LOCAL)' \
            && sb_announced=1
        if [ "$sb_rc" -eq 0 ] && [ "$sb_announced" -eq 1 ]; then
            printf "PASS  %-40s  (runs alone; reactions cascade announced)\n" \
                "standalone-branch:FERMENTATION"
            pass=$((pass+1))
        else
            printf "FAIL  %-40s  (exit %s; announced=%s)\n" \
                "standalone-branch:FERMENTATION" "$sb_rc" "$sb_announced"
            fail=$((fail+1))
        fi
    fi

    # --- energy-closure regression (T1 + T2) on the flagship plant ----------
    #  The ChemicalPlantTutorial is the flagship for the ONE-datum energy
    #  balance.  Two assertions pin it so the "2131 % double-count" and the
    #  "silent sensible fallback" can NEVER come back:
    #
    #   T1  per-unit datum + no gross non-closure.  Every unit MUST report
    #       reference = `elements` (NO `sensible` and NO `gap` rows -- the
    #       sensible fallback was deleted; a curation gap would print `gap`).
    #       AND no unit's |closure - 100| may exceed 50 % -- that band catches
    #       the old double-counts (Evap1 2131 %, Evap2 -35028 %) while honestly
    #       tolerating the small residual water-curve inconsistency that remains
    #       on the Q-determined evaporator (~5 %, documented).
    #
    #   T2  GLOBAL plant boundary first law.  |inputs - outputs| / |inputs|
    #       from globalEnergyBoundary.csv MUST be < 1 %.  With one datum every
    #       internal stream cancels, so this is the rigorous whole-plant check.
    plant="tutorials/plant/ChemicalPlantTutorial"
    # Clear ALL prior balance output so a pre-fix `sensible` leftover (the old
    # reports/ format, or a sub-branch isolated run) cannot be picked up below.
    rm -rf "$plant"/reports "$plant"/postProcessing \
           "$plant"/*/reports "$plant"/*/postProcessing \
           "$plant"/*/*/reports "$plant"/*/*/postProcessing 2>/dev/null
    "$ROOT/choupoSolve" "$plant" >/dev/null 2>&1
    # Read ONLY the plant-ROOT postProcessing, latest instant (sort -V = numeric)
    # -- never a sub-branch's postProcessing or a stale reports/ csv.
    eb=$(find "$plant/postProcessing" -name energyBalance_byUnit.csv 2>/dev/null | sort -V | tail -1)
    gb=$(find "$plant/postProcessing" -name globalEnergyBoundary.csv 2>/dev/null | sort -V | tail -1)

    # T1
    t1_bad=""
    if [ -f "$eb" ]; then
        while IFS=, read -r unit hin hout dH items closure ref; do
            case "$unit" in unit|''|\#*) continue;; esac
            [ -z "$ref" ] && continue
            if [ "$ref" != "elements" ]; then
                t1_bad="$t1_bad\n    $unit: reference='$ref' (must be elements -- no sensible/gap)"
                continue
            fi
            # |closure - 100| <= 50  (numeric; closure may be n/a for pure nodes)
            case "$closure" in n/a|'') continue;; esac
            off=$(awk -v c="$closure" 'BEGIN{d=c-100; if(d<0)d=-d; print (d>50)?1:0}')
            [ "$off" = "1" ] && t1_bad="$t1_bad\n    $unit: closure $closure % (>50 % off -- a double-count?)"
        done < "$eb"
    else
        t1_bad="\n    energyBalance_byUnit.csv not produced"
    fi
    if [ -z "$t1_bad" ]; then
        printf "PASS  %-40s  (per-unit elements datum, no double-count)\n" "energy-T1:plant"
        pass=$((pass+1))
    else
        printf "FAIL  %-40s  (T1 per-unit closure)" "energy-T1:plant"; printf "$t1_bad\n"
        fail=$((fail+1))
    fi

    # T2
    if [ -f "$gb" ]; then
        rp=$(awk -F, '/^residual_pct,/{v=$2; if(v<0)v=-v; print v}' "$gb")
        ok=$(awk -v v="${rp:-999}" 'BEGIN{print (v<1.0)?1:0}')
        if [ "$ok" = "1" ]; then
            printf "PASS  %-40s  (global boundary |in-out|/in = %s %% < 1 %%)\n" "energy-T2:plant" "$rp"
            pass=$((pass+1))
        else
            printf "FAIL  %-40s  (global boundary |in-out|/in = %s %% >= 1 %%)\n" "energy-T2:plant" "${rp:-?}"
            fail=$((fail+1))
        fi
    else
        printf "FAIL  %-40s  (globalEnergyBoundary.csv not produced)\n" "energy-T2:plant"
        fail=$((fail+1))
    fi
fi

echo "--------------------------------------------------------------------"
# The known-broken and expected-fail cases are NAMED, not just counted -- the
# breakage stays visible in the summary, never masked as green.
if [ "$known_broken" -gt 0 ]; then
    echo "KNOWN-BROKEN (bugs to fix -- see TUTORIAL-QA-2026-06-22.md):"
    for n in "${KB_NAMES[@]}"; do echo "    - $n"; done
fi
if [ "$expected_fail" -gt 0 ]; then
    echo "EXPECTED-FAIL (deliberate teaching non-convergence):"
    for n in "${EF_NAMES[@]}"; do echo "    - $n"; done
fi
echo "PASS $pass / FAIL $fail / KNOWN-BROKEN $known_broken / EXPECTED-FAIL $expected_fail"
# The suite is GREEN iff nothing FAILS.  Known-broken + expected-fail are
# tracked, visible, and non-gating -- the honest middle ground.
[ "$fail" -eq 0 ]
