    # Gibbs-Duhem gate (2026-08-07).  The first check in the tree that asks
    # whether a thermodynamic model is RIGHT rather than UNCHANGED.  A golden
    # preserves whatever error it was recorded with; Gibbs-Duhem is a
    # constraint on any model derived from an excess Gibbs energy and needs no
    # data at all.  Carries its own synthetic negative (gamma_2 := gamma_1 ->
    # R = 1.0) and REFUSES a vacuous run, because gammas that do not vary with
    # composition pass 0/0 -- which is how two probe bugs each produced a
    # clean sheet of zeros during development.
    if "$ROOT/bin/curate/check_gibbs_duhem.py" > /tmp/gibbsduhem.$$ 2>&1; then
        printf "PASS  %-40s  (%s)\n" "gibbs-duhem-gate" "$(head -1 /tmp/gibbsduhem.$$)"
        pass=$((pass+1))
    else
        printf "FAIL  %-40s  (run bin/curate/check_gibbs_duhem.py)\n" "gibbs-duhem-gate"
        cat /tmp/gibbsduhem.$$
        fail=$((fail+1))
    fi
    rm -f /tmp/gibbsduhem.$$

    # multi-ion Gibbs-Duhem (2026-08-08).  Ties the SOLVENT activity to the ION
    # activities: (1000/Mw)dln(a_w) + SUM m_i dln(g_i) + SUM dm_i = 0.  Two
    # kinds of model and two questions -- PitzerHMW and EdwardsPitzer supply an
    # osmotic coefficient on the same parameters as their gammas and are held
    # to the finite-difference floor; Davies supplies none (the solver holds
    # phi = 1), so its solvent side is fixed at ideal and it CANNOT satisfy the
    # constraint.  The gate MEASURES that departure rather than failing it, and
    # requires it to grow with ionic strength: a Davies that came back
    # consistent would have silently stopped being Davies.
    if "$ROOT/bin/curate/check_ion_gibbs_duhem.py" > /tmp/iongd.$$ 2>&1; then
        printf "PASS  %-40s  (%s)\n" "ion-gibbs-duhem-gate" "$(head -1 /tmp/iongd.$$)"
        pass=$((pass+1))
    else
        printf "FAIL  %-40s  (run bin/curate/check_ion_gibbs_duhem.py)\n" "ion-gibbs-duhem-gate"
        cat /tmp/iongd.$$
        fail=$((fail+1))
    fi
    rm -f /tmp/iongd.$$

    # psat-range gate (2026-08-06).  All 108 vaporPressure blocks declare a
