    # directory layout cannot -- if that count ever drops to zero, the bipartite
    # argument behind this design has silently been lost.
    if "$ROOT/choupoProps" --aqueous-graph /tmp/aqg.$$.json > /tmp/aqg.$$ 2>&1 \
       && python3 - /tmp/aqg.$$.json <<'PYEOF' >> /tmp/aqg.$$ 2>&1
import json, sys
d = json.load(open(sys.argv[1]))
multi = [r for r in d["reactions"] if len(r["families"]) > 1]
assert d["species"],   "no species in the graph"
assert d["reactions"], "no reactions in the graph"
assert not d["findings"], "graph findings: %s" % d["findings"]
assert multi, "no reaction belongs to two families -- the view has collapsed"
print("aqueous graph: %d species, %d equilibria, %d parameters, "
      "%d reactions in 2+ families" % (len(d["species"]), len(d["reactions"]),
                                       len(d["parameters"]), len(multi)))
PYEOF
