    else
        printf "FAIL  %-40s  (run bin/curate/check_electrolyte_sidecars.py)\n" "electrolyte-sidecar-gate"
        cat /tmp/elsc.$$
        fail=$((fail+1))
    fi
    rm -f /tmp/elsc.$$

    # D-R1 restricted-network gate (approved 2026-08-02): the declared
    # `networkScope restricted` announces + labels + refuses its five
    # dishonest shapes; sabotage-verified (no-op parser -> 7 probes fail).
    if "$ROOT/bin/curate/check_restricted_network.py" > /tmp/rnet.$$ 2>&1; then
        printf "PASS  %-40s  (%s)\n" "restricted-network-gate" "$(tail -1 /tmp/rnet.$$)"
        pass=$((pass+1))
    else
