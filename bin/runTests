    if "$ROOT/bin/curate/check_empty_dirs.py" > /tmp/emptygate.$$ 2>&1; then
        printf "PASS  %-40s  (%s)\n" "empty-dir-gate" "$(head -1 /tmp/emptygate.$$)"
        pass=$((pass+1))
    else
        printf "FAIL  %-40s  (run bin/curate/check_empty_dirs.py)\n" "empty-dir-gate"
        cat /tmp/emptygate.$$
        fail=$((fail+1))
    fi
    rm -f /tmp/emptygate.$$

    # Seal-drift gate (sealing wave, 2026-07-17): every sealed record's origin
    # sha256 vs the LIVE catalogue.  Drift (catalogue evolved under a frozen
    # copy) is REPORTED but passes -- refreshing is a per-case curation act;
    # DAMAGE (a claimed file missing / failing its own manifest hash) FAILS.
    if "$ROOT/bin/curate/check_seal_drift.py" > /tmp/sealgate.$$ 2>&1; then
        printf "PASS  %-40s  (%s)\n" "seal-drift-gate" "$(head -1 /tmp/sealgate.$$)"
        pass=$((pass+1))
        if grep -q 'SEAL DRIFT' /tmp/sealgate.$$; then cat /tmp/sealgate.$$; fi
    else
        printf "FAIL  %-40s  (broken seal manifest -- run bin/curate/check_seal_drift.py)\n" "seal-drift-gate"
        cat /tmp/sealgate.$$
        fail=$((fail+1))
    fi
    rm -f /tmp/sealgate.$$

    # Release-inventory gate (ChatGPT landing-plan §5): the generated single-
    # source-of-truth counts (generated/releaseInventory.json, consumed by the
    # homepage hero + "What is inside" + /models) must match the current tree --
    # a published release metric may not silently drift.  Regenerate to fix.
    if "$ROOT/bin/curate/release_inventory.py" --check > /tmp/inventory.$$ 2>&1; then
        printf "PASS  %-40s  (%s)\n" "release-inventory-gate" "$(head -1 /tmp/inventory.$$)"
        pass=$((pass+1))
    else
        printf "FAIL  %-40s  (stale, or a tally is hand-carried in prose -- see below)\n" "release-inventory-gate"
        cat /tmp/inventory.$$
        fail=$((fail+1))
    fi
    rm -f /tmp/inventory.$$

    # Release-identity gate (2026-08-08, website audit).  The dev inventory
    # above answers for the CURRENT tree; this one answers for the IMMUTABLE
    # releases: each generated/releases/<tag>.json must record the commit its
    # tag resolves to, survive a fresh recount from a worktree of that tag,
    # carry a citation equal to a render of the tag's own CITATION.cff, and
    # every data-inv fallback literal in the site sources must equal its
    # artefact value -- the homepage said 284, the releases page said 331,
    # and the tag says 288; neither public number was ever right.
    if "$ROOT/bin/curate/check_release_identity.py" > /tmp/relid.$$ 2>&1; then
        printf "PASS  %-40s  (%s)\n" "release-identity-gate" "$(head -1 /tmp/relid.$$)"
        pass=$((pass+1))
    else
        printf "FAIL  %-40s  (run bin/curate/check_release_identity.py)\n" "release-identity-gate"
        cat /tmp/relid.$$
        fail=$((fail+1))
    fi
    rm -f /tmp/relid.$$

    # Validation-subset gate (2026-08-08, the validation loop's first find).
    # The V&V doc's "named subset" had seven rows while the props corpus held
    # a battery of eight more -- the governing list undercounted, and every
    # project-level "validation deficit" number inherited it.  Recounts the
    # validation-op cases, refuses synthetic anchors, and refuses independence
    # claimed where a case's own header says fit-consistency.
    if "$ROOT/bin/curate/check_validation_subset.py" > /tmp/valsub.$$ 2>&1; then
        printf "PASS  %-40s  (%s)\n" "validation-subset-gate" "$(head -1 /tmp/valsub.$$)"
        pass=$((pass+1))
    else
        printf "FAIL  %-40s  (run bin/curate/check_validation_subset.py)\n" "validation-subset-gate"
        cat /tmp/valsub.$$
        fail=$((fail+1))
    fi
    rm -f /tmp/valsub.$$

    # Overlay-AAD gate (2026-08-12).  An `experimental {}` overlay publishes
    # how far each model sits from a MEASURED dataset -- the headline result
    # of every compare_* case -- into a top-level `validation` block that no
    # golden row could read until the `aad` kind was added.  So those numbers
    # lived only in prose, and prose about a number goes stale: this case's
    # own header claimed UNIFAC "T_bubble AAD ~2.6 K" against its output's
    # 0.407 K.  Requires published-implies-pinned and pinned-implies-published.
    if "$ROOT/bin/curate/check_overlay_aad_pinned.py" > /tmp/aadpin.$$ 2>&1; then
        printf "PASS  %-40s  (%s)\n" "overlay-aad-gate" "$(grep -m1 ': OK' /tmp/aadpin.$$)"
        pass=$((pass+1))
    else
        printf "FAIL  %-40s  (run bin/curate/check_overlay_aad_pinned.py)\n" "overlay-aad-gate"
        cat /tmp/aadpin.$$
        fail=$((fail+1))
    fi
    rm -f /tmp/aadpin.$$

    # Model-boundary ledger gate (2026-08-12), the same defect as the overlay
    # AADs one field over: the ledger's three quantities (raw imbalance /
    # declared step / what remains) live in a top-level `energyClosures` array
    # no golden row could read, so not one number of it was checked.  The step
    # is credited only when an INDEPENDENTLY assembled package reproduces the
    # imbalance; if that path drifted, remaining_kW would climb from 9e-9 to
    # the full 2.99 kW with the suite green.
    if "$ROOT/bin/curate/check_closure_ledger_pinned.py" > /tmp/clopin.$$ 2>&1; then
        printf "PASS  %-40s  (%s)\n" "closure-ledger-gate" "$(grep -m1 ': OK' /tmp/clopin.$$)"
        pass=$((pass+1))
    else
        printf "FAIL  %-40s  (run bin/curate/check_closure_ledger_pinned.py)\n" "closure-ledger-gate"
        cat /tmp/clopin.$$
        fail=$((fail+1))
    fi
    rm -f /tmp/clopin.$$

    # Utility-allocation gate (2026-08-12), the third instance of the same
    # question in one session: which blocks of the result JSON can a golden
    # row read?  `pickForDuty`'s choice of catalogue utility -- and its mass
    # flow and cost -- went into a top-level `utilityAllocation` array that
    # nothing could reach, on 77 cases.  The unit's own Q_kW does not move
    # when the picker does: the duty is the same, the service is not.
    if "$ROOT/bin/curate/check_utility_allocation_pinned.py" > /tmp/utilpin.$$ 2>&1; then
        printf "PASS  %-40s  (%s)\n" "utility-allocation-gate" "$(grep -m1 ': OK' /tmp/utilpin.$$)"
        pass=$((pass+1))
    else
        printf "FAIL  %-40s  (run bin/curate/check_utility_allocation_pinned.py)\n" "utility-allocation-gate"
        cat /tmp/utilpin.$$
        fail=$((fail+1))
    fi
    rm -f /tmp/utilpin.$$

    # Props operations-reference gate: the propsGuide's operations chapter is
    # RENDERED from gui/schemas/operations/, so adding or changing an op
    # schema must not leave the manual describing the previous one.  The
    # props-op partition is derived from the C++ unit-op registries, not
    # listed anywhere, so a new operation appears in the guide the day its
    # schema does.  Regenerate with bin/curate/props_ops_reference.py.
    if "$ROOT/bin/curate/props_ops_reference.py" --check > /tmp/propsops.$$ 2>&1; then
        printf "PASS  %-40s  (%s)\n" "props-ops-reference-gate" "$(head -1 /tmp/propsops.$$)"
        pass=$((pass+1))
    else
        printf "FAIL  %-40s  (stale -- run bin/curate/props_ops_reference.py)\n" "props-ops-reference-gate"
        cat /tmp/propsops.$$
        fail=$((fail+1))
    fi
    rm -f /tmp/propsops.$$

    # Guide version-stamp gate: the manuals' footer and title page are
    # RENDERED from CHOUPO_VERSION (src/core/Banner.H), because they used to
    # hardcode it -- every guide built from main was stamped Choupo-2607
    # while documenting the development line, which is a manual naming a
    # release it does not describe.  Regenerate with
    # bin/curate/guide_version.py (and rebuild the PDFs).
    # Sabotage-verified: bumping CHOUPO_VERSION makes it fail by name.
    if "$ROOT/bin/curate/guide_version.py" --check > /tmp/gver.$$ 2>&1; then
        printf "PASS  %-40s  (%s)\n" "guide-version-gate" "$(head -1 /tmp/gver.$$)"
        pass=$((pass+1))
    else
        printf "FAIL  %-40s  (run bin/curate/guide_version.py)\n" "guide-version-gate"
        cat /tmp/gver.$$
        fail=$((fail+1))
    fi
    rm -f /tmp/gver.$$

    # Guide PDF version gate (2026-08-05).  guide_version.py proves the SOURCE
    # the guides compile from is current; it cannot prove anybody recompiled
    # them.  A .tex reading Choupo-dev beside a .pdf built last month passes
    # that gate cleanly -- and the PDF is the artefact a reader opens, so the
    # only gated link was the one nobody reads.  Found when choupo.org served
    # a Theory Guide title page reading "Version 2607 / 30 June 2026" while
    # the repository's own PDF was correct.
    # Sabotage-verified with the real stale artefact: dropping the deployed
    # 2607 PDF into docs/ fails by name and reports the version it found.
    if "$ROOT/bin/curate/check_guide_pdf_version.py" > /tmp/gpdf.$$ 2>&1; then
        printf "PASS  %-40s  (%s)\n" "guide-pdf-version-gate" "$(tail -1 /tmp/gpdf.$$)"
        pass=$((pass+1))
    else
        printf "FAIL  %-40s  (rebuild: make -C docs all)\n" "guide-pdf-version-gate"
        cat /tmp/gpdf.$$
        fail=$((fail+1))
    fi
    rm -f /tmp/gpdf.$$

    # Banner version-stamp gate (Vitor, 2026-08-04 -- the OpenFOAM.org
    # arrangement).  Every file in the tree carries the version of the LINE
    # it belongs to: `Choupo-dev` on main, rewritten to `Choupo-YYMM` when a
    # release is frozen and back again afterwards.  Before this, 2053 case
    # files said `Choupo-2607` on the development line -- the same defect the
    # guides had, in its largest form.
    #
    # What the gate does NOT touch: `catalogueRelease Choupo-2607` in a
    # sealed case's propertyManifest.  That is a HISTORICAL FACT (this case
    # was sealed against the 2607 catalogue), not a label, and rewriting it
    # would falsify provenance.  Same string, opposite meaning.
    # Sabotage-verified: restoring one banner to Choupo-2607 fails by name.
    if "$ROOT/bin/curate/banner_version.py" --check > /tmp/bver.$$ 2>&1; then
        printf "PASS  %-40s  (%s)\n" "banner-version-gate" "$(head -1 /tmp/bver.$$)"
        pass=$((pass+1))
    else
        printf "FAIL  %-40s  (run bin/curate/banner_version.py)\n" "banner-version-gate"
        cat /tmp/bver.$$
        fail=$((fail+1))
    fi
    rm -f /tmp/bver.$$

    # Adsorption catalogue gate: pair records have one home, declared bases,
    # provenance and an honest quality class.  In particular a historical
    # teaching fit may not masquerade as directly measured literature data.
    if "$ROOT/bin/curate/check_adsorption_tree.py" > /tmp/adsorption.$$ 2>&1; then
        printf "PASS  %-40s  (%s)\n" "adsorption-tree-gate" "$(head -1 /tmp/adsorption.$$)"
        pass=$((pass+1))
    else
        printf "FAIL  %-40s  (adsorption catalogue contract -- run bin/curate/check_adsorption_tree.py)\n" "adsorption-tree-gate"
        cat /tmp/adsorption.$$
        fail=$((fail+1))
    fi
    rm -f /tmp/adsorption.$$

    # One-enthalpy-surface gate (forum #103/#105): the retired H_stream
    # blend must never re-enter a balance/duty/published .H; the surviving
    # blend is legal only at AUTHORIZED-BLEND loci, LISTED by the gate.
    if "$ROOT/bin/curate/check_h_surface.py" > /tmp/hsurface.$$ 2>&1; then
        printf "PASS  %-40s  (%s)\n" "h-surface-gate" "$(head -1 /tmp/hsurface.$$)"
        pass=$((pass+1))
    else
        printf "FAIL  %-40s  (legacy enthalpy surface -- run bin/curate/check_h_surface.py)\n" "h-surface-gate"
        cat /tmp/hsurface.$$
        fail=$((fail+1))
    fi
    rm -f /tmp/hsurface.$$
fi

for case_dir in "${CASES[@]}"; do
    name_short=$(basename "$case_dir")

    # --- honest opt-outs, classified BEFORE gating ------------------------
    #  Neither is ever reported PASS.  The case is still RUN (so its state is
    #  observable in -v output) but its result does not gate the suite.
    if [ -f "$case_dir/.known-broken" ]; then
        reason=$(grep -vE '^[[:space:]]*#' "$case_dir/.known-broken" 2>/dev/null \
                 | grep -m1 -vE '^[[:space:]]*$')
        printf "KNOWN-BROKEN  %-32s  (%s)\n" "$name_short" "${reason:-see .known-broken}"
        known_broken=$((known_broken+1)); KB_NAMES+=("$name_short"); continue
    fi
    if [ -f "$case_dir/.expect-nonconvergence" ]; then
        reason=$(grep -vE '^[[:space:]]*#' "$case_dir/.expect-nonconvergence" 2>/dev/null \
                 | grep -m1 -vE '^[[:space:]]*$')
        printf "EXPECTED-FAIL %-32s  (%s)\n" "$name_short" "${reason:-deliberate teaching non-convergence}"
        expected_fail=$((expected_fail+1)); EF_NAMES+=("$name_short"); continue
    fi

    app=$(binary_for "$case_dir")
    out=$(run_case_raw "$case_dir" "$app"); rc=$?

    if [ "$out" = "__BUILDFAIL__" ]; then
        printf "FAIL  %-40s  (compile failed)\n" "$name_short"; fail=$((fail+1)); continue
    fi

    # (0) exit-code guard -- a non-zero exit (a crashed / aborted run) is a FAIL.
    #     This is the §10 fix: a crash that emits no result block used to fall
    #     through to a vacuous "smoke pass"; it no longer can.
    if [ "$rc" -ne 0 ]; then
        printf "FAIL  %-40s  (non-zero exit code %s -- crashed/aborted)\n" "$name_short" "$rc"
        fail=$((fail+1)); continue
    fi

    # result block only (avoid false hits in the iteration log)
    block=$(printf '%s\n' "$out" | sed -n '/result-begin/,/result-end/p')
    have_block=1; [ -z "$block" ] && { have_block=0; block="$out"; }

    # (1) NaN / inf guard
    if printf '%s\n' "$block" | grep -qiE ':[[:space:]]*-?(nan|inf)\b'; then
        printf "FAIL  %-40s  (NaN/inf in result)\n" "$name_short"; fail=$((fail+1)); continue
    fi

    # (2) result-block guard -- a case that PROMISES a golden but emits NO
    #     comparable result block FAILS (the golden cannot be checked
    #     vacuously).  Without this, an errored-but-exit-0 run, or one whose
    #     result-begin/result-end markers never appeared, would slip through.
    if [ -f "$case_dir/expected" ] && [ "$have_block" -eq 0 ]; then
        #  A golden of ONLY `csv` rows needs no result block: the sweep
        #  drivers publish their whole answer as a CSV and emit none, which
        #  is why the kind exists (2026-08-22).  Any other kind present
        #  keeps the refusal -- those rows read the block that never came.
        if awk '$1!~/^#/ && NF>=5 && $1!="csv" {exit 1}' "$case_dir/expected"; then
            :
        else
            printf "FAIL  %-40s  (no result block, but ships a golden 'expected')\n" "$name_short"
            fail=$((fail+1)); continue
        fi
    fi

    # (3) reference KPIs
    if [ -f "$case_dir/expected" ]; then
        bad=""; anchors_ok=0; golden_rows=0
        while read -r line; do
            case "$line" in ''|\#*) continue;; esac
            read -r kind name key exp_v tol claim _ <<< "$line"
            [ -z "${tol:-}" ] && continue
            golden_rows=$((golden_rows+1))
            act=$(get_any "$out" "$kind" "$name" "$key" "$case_dir")
            within_tol "$act" "$exp_v" "$tol"
            case $? in
              0) [ "${claim:-}" = anchor ] && anchors_ok=$((anchors_ok+1)); ;;
              #  An anchor states a DISAGREEMENT WITH THE CITED VALUE, which
              #  is a finding about the model or the datum -- never "the
              #  golden moved".  It is reported in those words so a reader
              #  cannot mistake the two, and the remedy is never to loosen
              #  the band: report, or fix the physics.
              2) if [ "${claim:-}" = anchor ]; then
                     bad="$bad\n    ANCHOR $name.$key: NOT PUBLISHED by this case (cited value $exp_v) -- the quantity an anchor names must be emitted where its kind '$kind' reads"
                 else bad="$bad\n    $kind.$name.$key: MISSING (expected $exp_v)"; fi;;
              *) if [ "${claim:-}" = anchor ]; then
                     bad="$bad\n    ANCHOR $name.$key: model gives ${act:-?} against the CITED $exp_v (band $tol) -- a disagreement with the primary, not a moved golden"
                 else bad="$bad\n    $kind.$name.$key: got ${act:-?} expected $exp_v (reltol $tol)"; fi;;
            esac
        done < "$case_dir/expected"
        #  A golden with ZERO data rows pinned nothing and still printed the
        #  suite's STRONGEST verdict ("checked vs reference") -- observed on
        #  farelo_licl_range, 2026-08-22.  Checked-vacuously is not checked.
        if [ "$golden_rows" -eq 0 ]; then
            printf "FAIL  %-40s  (golden 'expected' has 0 rows -- pins nothing; record rows or remove the file)\n" "$name_short"
            fail=$((fail+1)); continue
        fi
        if [ -n "$bad" ]; then
            printf "FAIL  %-40s  (KPI mismatch)" "$name_short"; printf "$bad\n"; fail=$((fail+1)); continue
        fi
        #  Say WHICH claim passed.  "checked vs reference" is true of a
        #  self-recorded golden and would be a false advertisement for an
        #  anchor row, whose PASS means the answer agrees with a published
        #  measurement.  A case carrying both says both.
        if [ "$anchors_ok" -gt 0 ]; then
            printf "PASS  %-40s  (checked vs reference; %d anchor(s) agree with the cited primary)\n" "$name_short" "$anchors_ok"
        else
            printf "PASS  %-40s  (checked vs reference)\n" "$name_short"
        fi
        pass=$((pass+1))
    else
        printf "pass  %-40s  (smoke + NaN guard)\n" "$name_short"; pass=$((pass+1))
    fi
done

# --- standalone-branch regression (lean-fractal promise) ------------------
#  The lean fractal layout PROMISES that any branch of a composite plant can be
#  run on its OWN (./choupoSolve <plant>/<BRANCH>) with its inlets frozen.  The
#  thermoPackage + component overlays already cascaded UP for a standalone
#  branch, but the REACTIONS library did NOT -- so FERMENTATION run alone threw
#  "reaction 'sucroseToEthanol' not in constant/reactions" (forum Finding D).
#  This guard pins the fix: the pilot branch must run alone, EXIT 0, AND
#  ANNOUNCE where its reactions came from (the loud, non-silent cascade).  It is
#  pilot-scoped (only on the full sweep) -- a general standalone-branch sweep
#  would be too broad while the fractal layout is still a pilot.
if [ "$#" -eq 0 ]; then
    branch="tutorials/plant/ChemicalPlantTutorial/FERMENTATION"
    if [ -f "$branch/flowsheetDict" ]; then
        sb_out=$("$ROOT/choupoSolve" "$branch" 2>&1); sb_rc=$?
        sb_announced=0
        printf '%s\n' "$sb_out" | grep -qE 'reactions library: loaded — (inherited from|LOCAL)' \
            && sb_announced=1
        if [ "$sb_rc" -eq 0 ] && [ "$sb_announced" -eq 1 ]; then
            printf "PASS  %-40s  (runs alone; reactions cascade announced)\n" \
                "standalone-branch:FERMENTATION"
            pass=$((pass+1))
        else
            printf "FAIL  %-40s  (exit %s; announced=%s)\n" \
                "standalone-branch:FERMENTATION" "$sb_rc" "$sb_announced"
            fail=$((fail+1))
        fi
    fi

    # --- energy-closure regression (T1 + T2) on the flagship plant ----------
    #  The ChemicalPlantTutorial is the flagship for the ONE-datum energy
    #  balance.  Two assertions pin it so the "2131 % double-count" and the
    #  "silent sensible fallback" can NEVER come back:
    #
    #   T1  per-unit datum + no gross non-closure.  Every unit MUST report
    #       reference = `elements` (NO `sensible` and NO `gap` rows -- the
    #       sensible fallback was deleted; a curation gap would print `gap`).
    #       AND no unit's |closure - 100| may exceed 50 % -- that band catches
    #       the old double-counts (Evap1 2131 %, Evap2 -35028 %) while honestly
    #       tolerating the small residual water-curve inconsistency that remains
    #       on the Q-determined evaporator (~5 %, documented).
    #
    #   T2  GLOBAL plant boundary first law.  |inputs - outputs| / |inputs|
    #       from globalEnergyBoundary.csv MUST be < 1 %.  With one datum every
    #       internal stream cancels, so this is the rigorous whole-plant check.
    plant="tutorials/plant/ChemicalPlantTutorial"
    # Clear ALL prior balance output so a pre-fix `sensible` leftover (the old
    # reports/ format, or a sub-branch isolated run) cannot be picked up below.
    rm -rf "$plant"/reports "$plant"/postProcessing \
           "$plant"/*/reports "$plant"/*/postProcessing \
           "$plant"/*/*/reports "$plant"/*/*/postProcessing 2>/dev/null
    "$ROOT/choupoSolve" "$plant" >/dev/null 2>&1
    # Read ONLY the plant-ROOT postProcessing, latest instant (sort -V = numeric)
    # -- never a sub-branch's postProcessing or a stale reports/ csv.
    eb=$(find "$plant/postProcessing" -name energyBalance_byUnit.csv 2>/dev/null | sort -V | tail -1)
    gb=$(find "$plant/postProcessing" -name globalEnergyBoundary.csv 2>/dev/null | sort -V | tail -1)

    # T1
    t1_bad=""
    if [ -f "$eb" ]; then
        # `rest` swallows the model-boundary accounting columns added
        # 2026-08-09 (raw / step / remaining / adjusted / boundary).  Without
        # it `ref` would absorb the whole tail and the `!= elements` arm below
        # would fail on EVERY row -- a reader that must be told when its file
        # grows, told here.
        # THE PER-UNIT TABLE IS THE LEADING SECTION, and this reader must stop
        # at the end of it.  It used to run to end-of-file, which was harmless
        # only while every later section had FEWER fields than `ref` (the
        # 3-column `# declared energy items` table left it empty).  The
        # model-boundary ledger added 2026-08-09 has FIFTEEN, so its rows
        # arrived here with `ref` = "kW" and T1 failed on four units of the
        # plant -- a reader that walked past its own table's end.
        while IFS=, read -r unit hin hout dH items closure ref rest; do
            [ -z "$unit" ] && break          # blank line: the table has ended
            case "$unit" in unit|\#*) continue;; esac
            [ -z "$ref" ] && continue
            if [ "$ref" != "elements" ]; then
                t1_bad="$t1_bad\n    $unit: reference='$ref' (must be elements -- no sensible/gap)"
                continue
            fi
            # |closure - 100| <= 50  (numeric; closure may be n/a for pure nodes)
            case "$closure" in n/a|'') continue;; esac
            off=$(awk -v c="$closure" 'BEGIN{d=c-100; if(d<0)d=-d; print (d>50)?1:0}')
            [ "$off" = "1" ] && t1_bad="$t1_bad\n    $unit: closure $closure % (>50 % off -- a double-count?)"
        done < "$eb"
    else
        t1_bad="\n    energyBalance_byUnit.csv not produced"
    fi
    if [ -z "$t1_bad" ]; then
        printf "PASS  %-40s  (per-unit elements datum, no double-count)\n" "energy-T1:plant"
        pass=$((pass+1))
    else
        printf "FAIL  %-40s  (T1 per-unit closure)" "energy-T1:plant"; printf "$t1_bad\n"
        fail=$((fail+1))
    fi

    # T2
    if [ -f "$gb" ]; then
        rp=$(awk -F, '/^residual_pct,/{v=$2; if(v<0)v=-v; print v}' "$gb")
        ok=$(awk -v v="${rp:-999}" 'BEGIN{print (v<1.0)?1:0}')
        if [ "$ok" = "1" ]; then
            printf "PASS  %-40s  (global boundary |in-out|/in = %s %% < 1 %%)\n" "energy-T2:plant" "$rp"
            pass=$((pass+1))
        else
            printf "FAIL  %-40s  (global boundary |in-out|/in = %s %% >= 1 %%)\n" "energy-T2:plant" "${rp:-?}"
            fail=$((fail+1))
        fi
    else
        printf "FAIL  %-40s  (globalEnergyBoundary.csv not produced)\n" "energy-T2:plant"
        fail=$((fail+1))
    fi
fi

echo "--------------------------------------------------------------------"
# The known-broken and expected-fail cases are NAMED, not just counted -- the
# breakage stays visible in the summary, never masked as green.
if [ "$known_broken" -gt 0 ]; then
    echo "KNOWN-BROKEN (bugs to fix -- see TUTORIAL-QA-2026-06-22.md):"
    for n in "${KB_NAMES[@]}"; do echo "    - $n"; done
fi
if [ "$expected_fail" -gt 0 ]; then
    echo "EXPECTED-FAIL (deliberate teaching non-convergence):"
    for n in "${EF_NAMES[@]}"; do echo "    - $n"; done
fi
echo "PASS $pass / FAIL $fail / KNOWN-BROKEN $known_broken / EXPECTED-FAIL $expected_fail"
#  WHAT THAT NUMBER MEANS (G2, 2026-08-05).  Almost every case above compares
#  against a golden Choupo recorded itself, so a PASS proves the answer has NOT
#  MOVED -- not that it was ever right.  This corpus used to be called "the
#  validation corpus", which claimed the second thing while doing the first.
#  Printing the distinction beside the tally is the point: the number is read
#  far more often than any document about it.
echo "  ^ verification + regression.  A PASS means the answer has not moved from"
echo "    a self-recorded golden -- NOT that it is right.  The validation subset"
echo "    (agreement with independent published results) is small and named in"
echo "    docs/architecture/verification-and-validation.md"
# The suite is GREEN iff nothing FAILS.  Known-broken + expected-fail are
# tracked, visible, and non-gating -- the honest middle ground.
[ "$fail" -eq 0 ]
