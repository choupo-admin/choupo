#!/usr/bin/env bash
# Copyright (C) 2026 Vítor Geraldes
# SPDX-License-Identifier: GPL-3.0-or-later
# =============================================================================
#  header  --  stamp the Choupo source-file header onto a file, or --check it.
#
#  A THIN WRAPPER (DEV.md 4c C393).  The table of code kinds, the holder line
#  and the banner live in ONE place, bin/curate/source_headers_kinds.py, and
#  the work is done by bin/curate/add_source_headers.py; this script only keeps
#  the command line it always had.  The holder is NEVER read from git
#  configuration (in a managed container user.name is a tool's identity): it is
#  the one holder line of the table, accent included.  The old template etc/header.txt was
#  retired with it: it was a second home for the banner and not the banner the
#  files carry; the banner is now copied from the engine's own files.
#
#      C / C++ / TypeScript / CSS (engine, web app)  ->  the full banner
#      every other code file  ->  two lines: the copyright line and the
#                                 SPDX-License-Identifier, in its own syntax
#
#  Usage:
#      bin/header <file> ["description"]   # stamp (skips if present); the
#                                          # description is no longer written
#      bin/header --check <file...>        # verify the two lines
# =============================================================================

set -euo pipefail

ROOT="$(cd "$(dirname "$0")/.." && pwd)"
TOOL="$ROOT/bin/curate/add_source_headers.py"

if [ "${1:-}" = "-h" ] || [ "${1:-}" = "--help" ] || [ "$#" -eq 0 ]; then
    sed -n '5,24p' "$0" | sed 's/^# \{0,1\}//'
    exit 0
fi

if [ "${1:-}" = "--check" ]; then
    shift
    [ "$#" -gt 0 ] || { echo "header: --check needs files" >&2; exit 2; }
    python3 "$TOOL" --check "$@"
    exit $?
fi

[ -f "$1" ] || { echo "header: no such file '$1'" >&2; exit 1; }
python3 "$TOOL" "$1"
