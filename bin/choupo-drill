#!/usr/bin/env python3
"""choupo-drill -- materialise a standalone sub-case from ONE sector of a plant.

The stream-state architecture (docs/architecture/stream-state-architecture.md
2.6): drilling in changes the DOMAIN, not the stream.  A sector's producer that
LEAVES the domain flips the stream's role internal -> INLET automatically.  We
build a ONE-SECTOR plant so the sector keeps the GLOBAL component set (spectator
species like a NaCl background still load) and its own thermo override:

  * system/flowsheetDict   children ( SECTOR ); the parent's inter-sector edges
                           RESTRICTED to the sector -- an endpoint outside the
                           domain is TRUNCATED, so `liquor { from BRINE/liquor;
                           to SECTOR/liquor }` (internal in the plant) becomes
                           `liquor { to SECTOR/liquor }` (an INLET here).  The
                           edge is not edited -- its role follows the domain.
  * constant/              the parent's data closure (global package) + the
                           sector's own overlay -- SELF-CONTAINED.
  * SECTOR/                the sector, untouched (its edges already correct).
  * 0/                     materialised from the parent's persisted state
                           (converged/ by default), at the address the ENGINE
                           gives for each stream in the CHILD domain.

WHERE EACH STATE FILE GOES IS NOT THIS TOOL'S DECISION (2026-09-07).  It asks
`choupoSolve --manifest` -- the ONE home of the ownership rule
(src/streams/StreamOwnership.H) -- for the parent's manifest and the child's,
and copies streamId by streamId.  A stream keeps its IDENTITY across the
drill (the sector's own edges keep their `SECTOR.name`, a plant-level edge
keeps its bare name), so the two manifests are joined on the id and no name
is ever taken apart.  This tool used to look the parent's state up by the
CONSUMING PORT'S basename, which is a second derivation of the rule and a
wrong one: `PlantSteam { to CONCENTRATION/Steam; }` sent it looking for a file
called `Steam`, so drilling CONCENTRATION and FERMENTATION failed on the
flagship while DRYING worked by a coincidence of naming.

Usage:  choupo-drill <plant-case> <SECTOR> <out-dir> [--from converged|<statedir>]
"""
import os, re, shutil, subprocess, sys

ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))

def parse_named_edges(fs_text):
    m = re.search(r'\bconnections\s*\{', fs_text)
    if not m: return []
    i = m.end() - 1; depth = 0; j = i
    while j < len(fs_text):
        if fs_text[j] == '{': depth += 1
        elif fs_text[j] == '}':
            depth -= 1
            if depth == 0: break
        j += 1
    body = fs_text[i+1:j]
    edges = []
    for em in re.finditer(r'(\w+)\s*\{([^}]*)\}', body):
        inner = em.group(2)
        fr = re.search(r'\bfrom\s+([^\s;]+)', inner)
        to = re.search(r'\bto\s+([^\s;]+)', inner)
        edges.append([em.group(1), fr.group(1) if fr else "", to.group(1) if to else ""])
    return edges

def child_of(port):
    return port.split('/', 1)[0] if '/' in port else ""

def main():
    if len(sys.argv) < 4:
        sys.exit(__doc__)
    plant, sector, out = sys.argv[1], sys.argv[2], sys.argv[3]
    src = sys.argv[sys.argv.index("--from") + 1] if "--from" in sys.argv else "converged"

    #  TWO LAYOUTS EXIST IN THE CORPUS and both are legal: a sector may sit
    #  directly under the plant (ChemicalPlantTutorial/DRYING) or under a
    #  sectors/ folder (lithiumBrinePlant/sectors/BRINE).  This knew only the
    #  first, so the one plant that carries electrolyte worlds -- the reason to
    #  drill in the first place -- could not be drilled at all.
    sdir = os.path.join(plant, sector)
    if not os.path.isdir(sdir):
        sdir = os.path.join(plant, "sectors", sector)
    if not os.path.isdir(sdir):
        sys.exit(f"choupo-drill: no sector '{sector}' in {plant} "
                 f"(looked in {plant}/{sector} and {plant}/sectors/{sector})")
    statedir = os.path.join(plant, src)
    if not os.path.isdir(statedir):
        sys.exit(f"choupo-drill: parent has no '{src}/' -- run the plant first "
                 f"(no silent 'latest'; pass --from <statedir> explicitly)")

    # RESTRICT the parent's root edges to this sector; truncate the endpoints
    # that leave the domain (that is the role flip).
    root_edges = parse_named_edges(open(os.path.join(plant, "system", "flowsheetDict")).read())
    kept = []
    for name, fr, to in root_edges:
        touches = child_of(fr) == sector or child_of(to) == sector
        if not touches: continue
        nf = fr if child_of(fr) == sector else ""     # producer left the domain -> feed
        nt = to if child_of(to) == sector else ""     # consumer left the domain -> outlet
        #  The ORIGINAL endpoints ride along: the identity join below needs
        #  the PARENT's `from` beside the CHILD's, and re-selecting the same
        #  edges downstream would be the same filter written twice.
        kept.append([name, nf, nt, fr, to])
    if not kept:
        sys.exit(f"choupo-drill: no root edge touches sector '{sector}'")

    # --- assemble the self-contained one-sector sub-case -------------------
    if os.path.exists(out): shutil.rmtree(out)
    os.makedirs(os.path.join(out, "system"))
    shutil.copytree(os.path.join(plant, "constant"), os.path.join(out, "constant"))
    #  MIRROR THE PARENT'S LAYOUT, do not flatten it.  A plant that keeps its
    #  sectors under sectors/ puts them one level deeper, and the engine walks
    #  a fixed number of levels up from a sector to find the case root -- so a
    #  flattened copy sent it looking for constant/ ABOVE the drilled case and
    #  it refused to open a dict that was sitting right there.
    sect_rel = os.path.relpath(sdir, plant)          # "BRINE" or "sectors/BRINE"
    shutil.copytree(sdir, os.path.join(out, sect_rel))

    with open(os.path.join(out, "system", "flowsheetDict"), "w") as f:
        f.write(f"/*--- Drilled domain: sector {sector} of {os.path.basename(plant)}. "
                f"Every stream keeps its identity; its ROLE is inferred in THIS "
                f"domain (a producer that left -> the stream is now an inlet). ---*/\n\n")
        #  `sectors ( ... )`, not the retired `children ( ... )`: the composite
        #  keyword was renamed and this tool kept emitting the old one, so every
        #  drilled sub-case was refused by the engine with "node has neither a
        #  `units (...)` list, a `members (...)` list, nor a `type`".  The tool
        #  produced output its own solver would not read.
        f.write(f"sectors\n(\n    {sector}\n);\n\nconnections\n{{\n")
        for name, fr, to, _pf, _pt in kept:
            parts = (f"from {fr}; " if fr else "") + (f"to {to};" if to else "")
            f.write(f"    {name:14s} {{ {parts} }}\n")
        f.write("}\n")
    # copy the parent's controlDict metadata but keep it a solve
    with open(os.path.join(out, "system", "controlDict"), "w") as f:
        f.write(f'application   choupoSolve;\n'
                f'description   "Drilled sector {sector} -- role of each boundary '
                f'stream inferred in this domain (drill-in test).";\n'
                f'verbosity     3;\n')
    for opt in ("solverDict",):
        s = os.path.join(plant, "system", opt)
        if os.path.exists(s): shutil.copy2(s, os.path.join(out, "system", opt))

    # --- materialise 0/ from the parent's persisted state ------------------
    #  ASK THE ENGINE, both sides.  `--manifest` prints `streamId TAB relative
    #  state path` and stops BEFORE the 0/ completeness check, which is exactly
    #  the state the child is in at this moment (its 0/ does not exist yet).
    def manifest_of(case):
        r = subprocess.run([os.path.join(ROOT, "choupoSolve"), "--manifest", case],
                           capture_output=True, text=True)
        if r.returncode != 0:
            sys.exit("choupo-drill: could not read the stream manifest of "
                     f"{case} -- choupoSolve --manifest exited {r.returncode}.\n"
                     + (r.stdout + r.stderr).strip()[-1200:])
        out, keep = {}, False
        for line in r.stdout.splitlines():
            if line.strip() == "[manifest] begin": keep = True;  continue
            if line.strip() == "[manifest] end":   keep = False; continue
            if keep and "\t" in line:
                sid, path = line.split("\t", 1)
                out[sid] = path
        if not out:
            sys.exit(f"choupo-drill: {case} published an EMPTY stream manifest "
                     "-- there is nothing to materialise, which is never right "
                     "for a domain with units.")
        return out

    parent_manifest = manifest_of(plant)
    child_manifest  = manifest_of(out)

    #  A STREAM KEEPS ITS IDENTITY ACROSS THE DRILL -- EXCEPT WHERE ITS
    #  PRODUCER LEFT.  A sector's own edge is `SECTOR.name` in both domains and
    #  a plant inlet is a bare plant-level name in both, so the manifests join
    #  on the id directly.  The one exception is a CROSSING edge: in the plant
    #  its identity comes from the producing port (`MAIN/ToConcentration` ->
    #  `MAIN.ToConcentration`), and in the child the producer is outside the
    #  domain, so the identity is the edge's own name.  That correspondence is
    #  in the tool's own kept-edge list; what the tool does NOT do is decide
    #  how a `<member>/<port>` reference is spelled as an identity -- the
    #  flatten seam spells it `<member>.<port>` for a COMPOSITE member and
    #  `<port>` for a LEAF one -- so it proposes both spellings and requires
    #  the published manifest to confirm exactly ONE.  Two confirmations is a
    #  real ambiguity (a case may legitimately carry both `A.feed` and `feed`)
    #  and is refused by name rather than picked.
    def identity_of(port, manifest, whose):
        dotted = port.replace("/", ".")
        bare   = port.rsplit("/", 1)[-1]
        hits   = [x for x in dict.fromkeys((dotted, bare)) if x in manifest]
        if len(hits) > 1:
            sys.exit(f"choupo-drill: the port '{port}' matches TWO streams in "
                     f"the {whose} manifest ({', '.join(hits)}) -- this tool "
                     "cannot tell which one the edge means, and will not guess.")
        return hits[0] if hits else None

    parent_of_child = {}
    for name, cf, _ct, pf, _pt in kept:
        cid = identity_of(cf, child_manifest,  "child")  if cf else name
        pid = identity_of(pf, parent_manifest, "parent") if pf else name
        if cid and pid and cid != pid:
            parent_of_child[cid] = pid

    missing, n = [], 0
    for sid in sorted(child_manifest):
        psid = parent_of_child.get(sid, sid)
        if psid not in parent_manifest:
            missing.append(sid if psid == sid else f"{sid} (as {psid})")
            continue
        srcf = os.path.join(statedir, parent_manifest[psid])
        if not os.path.isfile(srcf):
            missing.append(f"{sid} (expected {src}/{parent_manifest[psid]})")
            continue
        dest = os.path.join(out, "0", child_manifest[sid])
        os.makedirs(os.path.dirname(dest), exist_ok=True)
        shutil.copy2(srcf, dest)
        n += 1
    if missing:
        sys.exit(f"choupo-drill: parent {src}/ missing state for: {', '.join(missing)}")

    inlets = [nm for nm, fr, to, _pf, _pt in kept if not fr and to]
    print(f"choupo-drill: {sector} -> {out}")
    print(f"  {n} stream(s) materialised into 0/ from {os.path.basename(plant)}/{src}/")
    print(f"  role flipped to INLET in this domain (internal in the plant): {', '.join(inlets)}")

if __name__ == "__main__":
    main()
