#---------------------------------------------------------------------------#
#  drive-app  --  open the DELIVERED app in a real browser, run a case, read
#  every view as a student reads it, and report what it actually fetched.
#  Implementation and the full usage: gui/tools/driveApp/driveApp.mjs.
#
#  Exit codes:  0 no finding · 1 findings · 2 REFUSED (could not honestly run)
#---------------------------------------------------------------------------#
set -u
script_dir=$(dirname "$(readlink -f "$0")")
root=$(dirname "$script_dir")
if ! command -v node >/dev/null 2>&1; then
    echo "drive-app REFUSES TO RUN: node is not on PATH." >&2; exit 2
fi
exec node "$root/gui/tools/driveApp/driveApp.mjs" "$@"
