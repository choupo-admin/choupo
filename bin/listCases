# =============================================================================
#  listCases  --  list available tutorial cases
#
#  Tutorials live under tutorials/<discipline>/<name>/.  A top-level folder
#  is a DISCIPLINE a student studies, NOT a binary (ruled 2026-09-20, Vitor):
#  steady/ unsteady/ ctrl/ batch/ props/ plant/.  The binary a case runs on
#  is the case's own `controlDict.application`, which `runCase` reads and
#  dispatches on -- so this script keeps NO folder->binary table and NO
#  hand-kept folder list: it enumerates the top-level folders of tutorials/
#  and prints each case's declared application beside it.  (The table this
#  used to carry named three folders and had been wrong since props/, plant/
#  and electrochem/ existed.)
#
#  Each entry shows the first comment line from system/flowsheetDict
#  as a short description.
# =============================================================================

set -euo pipefail

ROOT=${CHOUPO_HOME:-}
if [ -z "$ROOT" ]; then
    echo "listCases: CHOUPO_HOME is not set." >&2
    echo "           source <projectRoot>/etc/bashrc to set it." >&2
    exit 1
fi

if [ ! -d "$ROOT/tutorials" ]; then
    echo "listCases: '$ROOT/tutorials' not found" >&2
    exit 1
fi

cd "$ROOT/tutorials"

echo "Tutorial cases in $ROOT/tutorials:"
echo

for catdir in */; do
    cat="${catdir%/}"
    [ -d "$cat" ] || continue
    # A folder holding no case (no system/controlDict anywhere below) is not
    # a discipline; skip it silently rather than print an empty table.
    [ -n "$(find "$cat" -path '*/system/controlDict' -print -quit 2>/dev/null)" ] || continue
    echo "  ── $cat/ ──────────────────────────────────────────────────────────"
    printf "    %-50s %-12s %s\n" "CASE" "APPLICATION" "DESCRIPTION"
    # A case is any directory holding system/controlDict, at ANY depth, so the
    # <discipline>/<subclass>/<case> layout shows the sub-class as a path
    # prefix (e.g. membranes/membrane01_...) and a flat folder lists plainly.
    while IFS= read -r cd; do
        d="$(dirname "$(dirname "$cd")")"
        name="${d#"$cat"/}"
        # The binary column is READ from the case, never inferred from the
        # folder: `application <word>;` in system/controlDict.
        app=$(awk '/^[ \t]*application[ \t]/ { sub(/;.*$/, "", $2); print $2; exit }' "$cd")
        desc=""
        fd="$d/system/flowsheetDict"
        if [ -f "$fd" ]; then
            desc=$(awk '
                /^\/\*/   {inblk=1; next}
                inblk && /^\*\\/  {inblk=0; next}
                inblk && /^\*\// {inblk=0; next}
                inblk && /^[ \t]*[A-Za-z]/ {
                    gsub(/^[ \t]+|[ \t]+$/,"")
                    sub(/[ \t]+\\\\.*$/,"")
                    print
                    exit
                }
            ' "$fd")
        fi
        printf "    %-50s %-12s %s\n" "$name" "${app:-?}" "${desc:--}"
    done < <(find "$cat" -path '*/system/controlDict' 2>/dev/null | sort)
    echo
done

#  A LIST IS NOT A WAY IN.  354 entries organised by what each case IS answers
#  "which case does X"; someone arriving needs "which case FIRST".  The
#  ordered path is a separate document and this is where a reader of the list
#  is standing when they need it.
printf 'New here?  %s reads nine of these in order,\n' "docs/start-here.md"
printf '           each introducing one idea and resting on the one before.\n\n'
