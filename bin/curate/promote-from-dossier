#!/usr/bin/env python3
"""promote-from-dossier -- the EXPLICIT HUMAN ACT between evidence and trust.

    curation dossier  ->  human review / promotion  ->  data/standards/

Nothing in a curation dossier is visible to the solver, and nothing in it is
promoted by any automated step.  This tool is the only door, and it is a
CURATION tool, not part of the engine: the runtime never calls it.

    Curation state belongs to the evidence process; runtime trust belongs to
    the numerical record actually admitted to standards.

WHAT IT REFUSES, and why each refusal is the point rather than an obstacle:

  * a property whose verdict is `validationRefused` -- its only residual is
    in-sample, and promoting that would admit a number whose agreement with
    anything was never tested;
  * a property whose verdict is `notValidated` -- the held-out residuals
    exceeded the band the case itself declared beforehand;
  * a property whose verdict is `heldOutPerformed` -- the validation ran and
    nobody said what would count as passing, so there is no verdict to
    promote on.  Declare `acceptance { maxAAD ...; }` and re-run, or promote
    with --despite and say why;
  * a promotion with no promoter, date and grounds -- the record of WHO
    admitted a number and on what basis is the auditable half of the act, and
    is required in the same shape `promotedDespite` already uses.

`--despite` exists because a curator may legitimately promote past a
diagnostic; it does not silence anything, it RECORDS the override into the
promoted file so every later reader meets it.

USAGE
    promote-from-dossier <dossier> --property <name> --by <who> \\
        --grounds "<why>" [--date YYYY-MM-DD] [--despite] [--dry-run]

This first version PRINTS the record it would admit and refuses to write into
data/standards/ without --i-am-sure, because the standards tree is a curation
act and the engine itself refuses to write there.
"""

import argparse
import datetime
import pathlib
import re
import sys

ROOT = pathlib.Path(__file__).resolve().parents[2]

PROMOTABLE = {"validated"}
REFUSALS = {
    "validationRefused":
        "its only residual is IN-SAMPLE -- the model was never tested against "
        "evidence it had not seen, so there is nothing to promote on",
    "notValidated":
        "the held-out residuals EXCEEDED the acceptance band this case "
        "declared before the fit",
    "heldOutPerformed":
        "a held-out validation ran but NO acceptance band was declared, so "
        "nothing states what would have counted as passing.  Declare "
        "`acceptance { maxAAD <x> percent; }` and re-run",
    "notClaimed":
        "this property used the legacy single-dataset form: every point was "
        "fitted and no validation was ever claimed",
}


def parse_dossier(path: pathlib.Path):
    """Pull the per-property blocks out of a dossier.  Deliberately simple:
    the dossier is generated by one writer in a fixed shape, and a full dict
    parser here would be a second implementation of one Choupo already has."""
    text = path.read_text()
    comp = re.search(r"^component\s+(\S+);", text, re.M)
    props = {}
    for m in re.finditer(r"^property\s+(\S+)\s*\n\{(.*?)^\}", text, re.M | re.S):
        name, body = m.group(1), m.group(2)
        v = re.search(r"^\s*verdict\s+(\S+);", body, re.M)
        op = re.search(r"^\s*operation\s+(\S+);", body, re.M)
        model = re.search(r'^\s*model\s+"([^"]*)";', body, re.M)
        fp = re.search(r'partitionFingerprint\s+"([0-9a-f]+)"', body)
        #  SCOPED TO `fittedParameters` ON PURPOSE.  An indentation-only
        #  match also swallows the `metrics` block, merging r2InSample and the
        #  held-out statistics into "parameters" -- which is exactly the
        #  merging this whole design exists to prevent, committed by the tool
        #  that reads it.  Caught on the first run; scoped rather than tidied.
        fp_blk = re.search(r"fittedParameters\s*\n\s*\{(.*?)\n\s*\}",
                           body, re.S)
        params = dict(re.findall(r"(\w+)\s+(-?[\d.eE+-]+);",
                                 fp_blk.group(1) if fp_blk else ""))
        dois = re.findall(r'^\s*doi\s+"([^"]*)";', body, re.M)
        aad = re.search(r"^\s*aadHeldOutPct\s+(\S+);", body, re.M)
        # a property name may appear more than once (two ops, one property)
        props.setdefault(name, []).append({
            "verdict": v.group(1) if v else "?",
            "operation": op.group(1) if op else "?",
            "model": model.group(1) if model else "?",
            "fingerprint": fp.group(1) if fp else "",
            "parameters": params,
            "dois": dois,
            "aadHeldOutPct": aad.group(1) if aad else "",
        })
    return (comp.group(1) if comp else "?"), props


def main():
    ap = argparse.ArgumentParser(add_help=True)
    ap.add_argument("dossier")
    ap.add_argument("--property", required=True)
    ap.add_argument("--by")
    ap.add_argument("--grounds")
    ap.add_argument("--date", default=str(datetime.date.today()))
    ap.add_argument("--despite", action="store_true")
    ap.add_argument("--i-am-sure", action="store_true")
    a = ap.parse_args()

    path = pathlib.Path(a.dossier)
    if not path.exists():
        print(f"promote-from-dossier: no such dossier: {path}")
        return 1

    component, props = parse_dossier(path)
    if a.property not in props:
        print(f"promote-from-dossier: '{a.property}' is not in {path}.  "
              f"It carries: {', '.join(sorted(props)) or '(nothing)'}")
        return 1

    entries = props[a.property]
    #  Several operations may have resolved the same property.  Promote the
    #  one that is promotable; if none is, name every verdict rather than the
    #  first, so the reader sees the whole picture.
    ok = [e for e in entries if e["verdict"] in PROMOTABLE]
    if not ok:
        print(f"promote-from-dossier: REFUSED -- '{a.property}' of "
              f"{component} carries no promotable verdict.")
        for e in entries:
            why = REFUSALS.get(e["verdict"], "unrecognised verdict")
            print(f"  - {e['operation']}: verdict `{e['verdict']}` -- {why}.")
        if not a.despite:
            print("  Promote past this only with --despite, which RECORDS the "
                  "override into the promoted file rather than hiding it.")
            return 1
        ok = entries[:1]

    #  The auditable half of the act.
    missing = [f for f, v in (("--by", a.by), ("--grounds", a.grounds)) if not v]
    if missing:
        print("promote-from-dossier: REFUSED -- a promotion is an act with an "
              f"author.  Missing {', '.join(missing)}.  Who admitted this "
              "number, and on what grounds, is the auditable half of the "
              "promotion and is not optional.")
        return 1

    e = ok[0]
    print(f"promote-from-dossier: would admit to data/standards/\n")
    print(f"  component        {component}")
    print(f"  property         {a.property}")
    print(f"  model            {e['model']}")
    print(f"  parameters       " + ", ".join(f"{k}={v}" for k, v in e["parameters"].items()))
    print(f"  verdict          {e['verdict']}"
          + ("   [PROMOTED DESPITE]" if e["verdict"] not in PROMOTABLE else ""))
    if e["aadHeldOutPct"]:
        print(f"  aadHeldOutPct    {e['aadHeldOutPct']}")
    print(f"  partition        {e['fingerprint'] or '(legacy form -- none)'}")
    print(f"  evidence DOIs    " + (", ".join(e["dois"]) or "(none declared)"))
    print(f"  promotedBy       {a.by}")
    print(f"  promotedOn       {a.date}")
    print(f"  grounds          {a.grounds}")
    print()
    print("  The promoted record would claim `validated against dataset X`, "
          "and NOT that it\n  contains what is needed to repeat that "
          "validation -- the evidence may live\n  outside this repository.")

    if not a.i_am_sure:
        print("\npromote-from-dossier: nothing written.  data/standards/ is a "
              "curation act;\n  re-run with --i-am-sure once the record above "
              "is what you mean to admit.")
        return 0

    print("\npromote-from-dossier: writing into data/standards/ is not "
          "implemented in this\n  slice -- the shape of the admitted record is "
          "settled with the curation\n  protocol, not here.  The review half "
          "above is what this slice delivers.")
    return 0


if __name__ == "__main__":
    sys.exit(main())
