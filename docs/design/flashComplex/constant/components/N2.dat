/*--------------------------------*- Choupo -*--------------------------------*\
|  N2 -- the INERT.  Its job in this case is to guarantee a vapour phase       |
|  exists at every condition, so "no vapour formed" can never be confused      |
|  with "the run failed".  DESIGN DRAFT.                                       |
\*-----------------------------------------------------------------------------*/
recordType    component;
schemaVersion 3;

name        N2;
formula     "N2";
CAS         7727-37-9;
MW          28.0134 g/mol;
standardStates
{
    vapour  { dHf_298 0 J/mol; s_298 191.61 J/mol/K; }
}

//  INERT does NOT mean insoluble: the dissolution is priced like any other.
aqueousChemistry
{
    speciation none;

    reactions
    (
        {
            name      nitrogenDissolution;
            equation "N2(g) = N2(aq)";
            stoichiometry
            (
                { species N2;    phase vapour;   nu -1; }
                { species N2aq;  phase aqueous;  nu  1; }
            );
                            authority  measuredK;
                measuredK
                {
                    logK25   -3.1864;
                    analytic ( -58.453 0.001818 3199 17.909 -27460 );
                    convention PHREEQC-gasMolal-v1;
                    source   "USGS PHREEQC phreeqc.dat (public domain)";
                }
            }
        }
    );
}
