/*--------------------------------*- Choupo -*--------------------------------*\
|  NH4HCO3 -- ammonium bicarbonate.  NEVER FED: this solid APPEARS if the      |
|  NH3 + CO2 loading crosses saturation.  DESIGN DRAFT -- every value below    |
|  is INTERIM, pending primary curation.  The case cannot run until it is.     |
\*-----------------------------------------------------------------------------*/
recordType    component;
schemaVersion 3;

name        NH4HCO3;
formula     "NH4HCO3";
MW          79.056 g/mol;
role        nonvolatile;

defaultPhase ammoniumBicarbonate;

standardStates
{
    ammoniumBicarbonate
    {
        reference pureSolid;
        physical  { rho_p 1580 kg/m^3; }     // CRC, INTERIM
        source    "INTERIM -- formation datum not curated";
    }
}

aqueousChemistry
{
    introduces ( );          // brings no NEW species: NH4+ and HCO3- are
                             // already introduced by NH3 and CO2

    reactions
    (
        {
            name      ammoniumBicarbonateDissolution;
            equation "NH4HCO3(s) = NH4+ + HCO3-";
            stoichiometry
            (
                { species NH4HCO3; phase ammoniumBicarbonate; nu -1; }
                { species NH4;     phase aqueous;             nu  1; }
                { species HCO3;    phase aqueous;             nu  1; }
            );
            equilibriumCondition zeroAffinity;
            standardGibbs
            {
                authority  measuredK;
                measuredK
                {
                    logK25    0.25;      // ORDER OF MAGNITUDE ONLY, from the
                                         // ~220 g/L (25 C) solubility
                    source   "INTERIM: primary pending (Trypuc & Kielkowska,
                              J. Chem. Eng. Data)";
                }
                crossCheck none;         // no species datum to compare against
            }
        }
    );
}

reviewStatus interim;
reviewReason ( primarySourceMissing );
reviewOwner  IST;
