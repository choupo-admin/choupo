/*--------------------------------*- Choupo -*-----------------------*\
  NH4HCO3 (ammonium bicarbonate) -- DRAFT record, design driver ONLY.
  NOT in data/standards: every value below is INTERIM order-of-magnitude
  pending primary curation (Trypuc & Kielkowska, J. Chem. Eng. Data,
  solubility; CRC density) BEFORE this case can ever run.
\*---------------------------------------------------------------------------*/
name        NH4HCO3;
formula     NH4HCO3;
MW          79.056;             // kg/kmol
role        solute;
dissociatesTo ( { species NH4; nu 1; } { species HCO3; nu 1; } );

solidPhases
{
    ammoniumBicarbonate
    {
        physical { rho_p 1580.0; }   // g/cm^3 1.58 -- CRC, INTERIM
        dissolutionReaction { masters ( { ion NH4; nu 1; } { ion HCO3; nu 1; } ); }
        equilibrium { logK25 0.25; source "INTERIM: order of magnitude from ~220 g/L (25 C) solubility; primary pending (Trypuc & Kielkowska)"; }
    }
}

reviewStatus interim;
reviewReason ( primarySourceMissing );
reviewOwner  IST;
