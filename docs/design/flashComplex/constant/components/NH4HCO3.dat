/*--------------------------------*- Choupo -*--------------------------------*\
|  NH4HCO3 -- ammonium bicarbonate.  NEVER FED: this solid APPEARS if the      |
|  NH3 + CO2 loading crosses saturation.  DESIGN DRAFT -- every value below    |
|  is INTERIM, pending primary curation.  The case cannot run until it is.     |
\*-----------------------------------------------------------------------------*/
recordType    component;
schemaVersion 3;

name        NH4HCO3;
formula     "NH4HCO3";
MW          79.056 g/mol;
role        nonvolatile;

defaultPhase ammoniumBicarbonate;

standardStates
{
    ammoniumBicarbonate
    {
        reference pureSolid;
        physical  { rho_p 1580 kg/m^3; }     // CRC, INTERIM
        source    "INTERIM -- formation datum not curated";
    }
}

aqueousChemistry
{
    introduces ( );          // brings no NEW species: NH4+ and HCO3- are
                             // already introduced by NH3 and CO2

    reactions
    (
        {
            name      ammoniumBicarbonateDissolution;
            equation "NH4HCO3(s) = NH4+ + HCO3-";
            stoichiometry
            (
                { species NH4HCO3; phase ammoniumBicarbonate; nu -1; }
                { species NH4;     phase aqueous;             nu  1; }
                { species HCO3;    phase aqueous;             nu  1; }
            );
            equilibriumCondition zeroAffinity;

            //  THE speciesData EXEMPLAR.  Here the measured constant is the
            //  WEAK one: 0.25 is an order of magnitude read off a solubility,
            //  while the solid's formation datum -- once curated -- gives the
            //  equilibrium to the precision of the calorimetry.  So the
            //  authority is the SPECIES route, and because that datum does
            //  not exist yet the engine REFUSES rather than quietly running
            //  on the order-of-magnitude number.  (Compare CO2.dat, where
            //  every constant is measured to 0.01 log units and the
            //  authority is measuredK.  Authority is a property of the DATA
            //  for THIS reaction -- never of the reaction's category.)
            standardGibbs
            {
                authority  speciesData;

                //  refusal expected today:
                //    NH4HCO3(ammoniumBicarbonate) carries no formation datum
                //    -> curate it, or declare `authority measuredK` and
                //       accept the order-of-magnitude constant explicitly.

                measuredK
                {
                    logK25    0.25;      // ORDER OF MAGNITUDE ONLY, from the
                                         // ~220 g/L (25 C) solubility
                    source   "INTERIM: primary pending (Trypuc & Kielkowska,
                              J. Chem. Eng. Data)";
                    reviewStatus interim;
                }
            }
        }
    );
}

reviewStatus interim;
reviewReason ( primarySourceMissing );
reviewOwner  IST;
