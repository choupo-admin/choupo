/*--------------------------------*- Choupo -*--------------------------------*\
|  CO2 -- the student feeds carbon dioxide; this file carries its water        |
|  chemistry.  DESIGN DRAFT (flashComplex), not a standards record.            |
\*-----------------------------------------------------------------------------*/
/*---------------------------------------------------------------------------*\
  WHY THE DISSOLVED SPECIES IS CALLED CO2aq AND NOT H2CO3
  -------------------------------------------------------
  The textbook writes  CO2 + H2O -> H2CO3 -> H+ + HCO3-.  True (molecular)
  carbonic acid EXISTS, but it is a tiny minority of the dissolved carbon:

      K_hyd = [H2CO3]/[CO2(aq)]  ~ 1.3e-3     (0.13 % of dissolved CO2)
      pKa(true H2CO3)            ~ 3.45       (a MODERATELY strong acid)

  and the two pictures reconcile exactly:

      pK1(aggregate) = pKa(H2CO3) + log(1/K_hyd) = 3.45 + 2.89 = 6.34
                                                        measured: 6.352  OK

  EVERY tabulated pK1 = 6.35 -- including this record's -- belongs to the
  AGGREGATE  CO2* = CO2(aq) + H2CO3, because no analytical method separates
  them.  Splitting the species while keeping 6.35 would be WRONG physics.
  Choupo therefore carries the aggregate, NAMES it honestly (CO2aq is CO2*)
  and prints this box: the student gets the textbook picture AND the
  convention that the numbers actually obey.

  An explicit-H2CO3 variant is legitimate but needs BOTH K_hyd and
  pKa(H2CO3) curated from primaries, and a re-curation of the whole
  carbonate ladder.  Named, not drafted.
\*---------------------------------------------------------------------------*/
recordType    component;
schemaVersion 3;

name        CO2;
formula     "CO2";
CAS         124-38-9;
MW          44.010 g/mol;
role        solute;

standardStates
{
    vapour  { reference idealGas1bar;  dHf_298 -393510 J/mol;  s_298 213.79 J/mol/K; }
}

aqueousChemistry
{
    //  Species this component BRINGS to the system.  Their identity and
    //  standard-state data live in species/ (one home); this is the link,
    //  never a copy of the values.
    introduces ( CO2aq  HCO3  CO3 );

    reactions
    (
        {
            name      carbonDioxideDissolution;
            equation "CO2(g) = CO2(aq)";              // rendered from the
                                                      // stoichiometry below
                                                      // and VERIFIED against
                                                      // it; never a 2nd source
            stoichiometry
            (
                { species CO2;    phase vapour;   nu -1; }
                { species CO2aq;  phase aqueous;  nu  1; }
            );

            //  The equilibrium CONDITION is always the same physics:
            //      sum(nu_i * mu_i) = 0        (zero affinity)
            //  What differs between records is only HOW the standard part
            //  sum(nu_i * mu_i^0) is obtained -- see standardGibbs.
            equilibriumCondition zeroAffinity;

            standardGibbs
            {
                authority  measuredK;      // this reaction's TRUTH
                measuredK
                {
                    logK25    -1.468;
                    dH        -19982.8 J/mol;
                    analytic  ( 10.5624 -0.023547 -3972.8 0 587460 1.9194e-05 );
                    convention PHREEQC-gasMolal-v1;
                    source    "USGS PHREEQC phreeqc.dat (public domain)";
                }
                crossCheck speciesData;    // announced comparison against
                                           // sum(nu*mu0) from species/
            }
        }

        {
            name      carbonicFirstDissociation;
            equation "CO2(aq) + H2O = H+ + HCO3-";
            //  Written in the TEXTBOOK direction; log K applies to THIS
            //  direction.  The catalogue stores the reverse (formation of
            //  CO2aq from its masters) -- the loader converts and announces.
            stoichiometry
            (
                { species CO2aq;  phase aqueous;  nu -1; }
                { species water;  phase aqueous;  nu -1; }
                { species H;      phase aqueous;  nu  1; }
                { species HCO3;   phase aqueous;  nu  1; }
            );
            equilibriumCondition zeroAffinity;
            standardGibbs
            {
                authority  measuredK;
                measuredK
                {
                    logK25    -6.352;          // pK1 of the AGGREGATE CO2*
                    dH         9108.6 J/mol;
                    analytic  ( -356.3094 -0.06091964 21834.37 126.8339 -1684915 );
                    source    "USGS PHREEQC phreeqc.dat (public domain)";
                }
                crossCheck speciesData;
            }
        }

        {
            name      bicarbonateDissociation;
            equation "HCO3- = H+ + CO3-2";
            stoichiometry
            (
                { species HCO3;   phase aqueous;  nu -1; }
                { species H;      phase aqueous;  nu  1; }
                { species CO3;    phase aqueous;  nu  1; }
            );
            equilibriumCondition zeroAffinity;
            standardGibbs
            {
                authority  measuredK;
                measuredK
                {
                    logK25   -10.329;          // pK2
                    dH        14899.2 J/mol;
                    analytic ( -107.8871 -0.03252849 5151.79 38.92561 -563713.9 );
                    source   "USGS PHREEQC phreeqc.dat (public domain)";
                }
                crossCheck speciesData;        // PASSES today: 14899 stored
                                               // vs 14850 from species (49 J)
            }
        }
    );
}
