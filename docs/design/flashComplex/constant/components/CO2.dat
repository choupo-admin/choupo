/*--------------------------------*- Choupo -*-----------------------*\
  Component: Carbon dioxide  (CO2, CAS 124-38-9)  --  DESIGN DRAFT.

  THE CARBONATE LADDER lives in chemistry/, one record per rung:

      CO2(g)        = CO2(aq)          CO2-dissolution.dat     (Henry)
      CO2(aq) + H2O = H+ + HCO3-       CO2aq-formation.dat     (aggregate)
      H+ + HCO3-    = H2CO3            H2CO3-formation.dat     (derived)
      HCO3-         = H+ + CO3-2       CO3-formation.dat       (pK2)

  This file declares only WHICH network CO2 joins and HOW it maps onto that
  network's master species.  The two lines at the bottom are the whole of
  it -- everything else here is pure-component thermophysics.

  The mapping is the DECLARED STOICHIOMETRIC BRIDGE from the component basis
  to the species basis: CO2 accounts as HCO3- + H+.  It is never inferred
  from the name, and it is the only legal crossing between the two bases.

  Values mirrored from data/standards/components/CO2.dat.  Above its triple
  point (216.55 K, 5.18 bar) CO2 has a normal liquid range only up to
  Tc = 304.13 K; in process work above ambient T it is permanently gaseous.
\*---------------------------------------------------------------------------*/

name        CO2;
formula     CO2;
CAS         124-38-9;
noncondensable true;

MW          44.010;
Tc          304.13;
Pc          73.83;
omega       0.225;
Tb          194.65;             // sublimation point at 1 atm
HvapTb      25230;
Vliq        4.70e-5;

standardThermochemistry
{
    dHf_298   -393520.0;        // J/mol  -- ideal-gas reference
    s_298     213.790;          // J/(mol*K)  -- third-law absolute
}

vaporPressure
{
    model         Antoine;
    coefficients  (6.81228   1301.679   -3.494);
    Trange        (154  204);
}

idealGasHeatCapacity
{
    model         polynomial;
    coefficients  (19.80   7.344e-2   -5.602e-5   1.715e-8);
    Trange        (250  1500);
}

// Physically extrapolated stub: CO2 is gas or solid at normal P.
liquidHeatCapacity
{
    model         polynomial;
    coefficients  (90.0);
}

aqueousSpeciation  carbonate;
aqueousMapping ( { species HCO3; nu 1; } { species H; nu 1; } );
