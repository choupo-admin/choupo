/*--------------------------------*- Choupo -*--------------------------------*\
|  water -- the aqueous solvent.  DESIGN DRAFT (flashComplex).                 |
\*-----------------------------------------------------------------------------*/
recordType    component;
schemaVersion 3;

name        water;
formula     "H2O";
CAS         7732-18-5;
MW          18.0153 g/mol;
role        solvent;

standardStates
{
    liquid  { reference pureLiquid;   dHf_298 -285830 J/mol;  s_298  69.95 J/mol/K; }
    vapour  { reference idealGas1bar; dHf_298 -241830 J/mol;  s_298 188.84 J/mol/K; }
}

aqueousChemistry
{
    introduces ( H  OH );

    reactions
    (
        {
            name      waterAutoprotolysis;
            equation "H2O = H+ + OH-";
            stoichiometry
            (
                { species water;  phase aqueous;  nu -1; }
                { species H;      phase aqueous;  nu  1; }
                { species OH;     phase aqueous;  nu  1; }
            );
            equilibriumCondition zeroAffinity;
            standardGibbs
            {
                authority  measuredK;
                measuredK
                {
                    logK25   -14.0;
                    dH        56400 J/mol;
                    analytic ( 293.29227 0.1360833 -10576.913 -123.73158 0 -6.996455e-05 );
                    source   "USGS PHREEQC phreeqc.dat (public domain)";
                }
                crossCheck speciesData;   // PASSES: 56400 stored vs 55840
                                          // from species (560 J = 0.016 in
                                          // log K at 358 K)
            }
        }
    );
}

//  The solvent's own VLE is the Raoult leg (a_w * psat), NOT a K-bearing
//  equilibrium: it lives with the phase MODEL in thermoPhysPropDict.  Stated
//  here so the student is not left wondering where the water vapour went.
vapourLiquidEquilibrium
{
    route      raoultSolvent;         // p_w = a_w * psat_w(T)
    note       "activity of the solvent from the declared aqueous activity
                model; no equilibrium constant is involved";
}
