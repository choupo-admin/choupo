/*--------------------------------*- Choupo -*--------------------------------*\
|  NH3 -- volatile weak base.  DESIGN DRAFT (flashComplex).                    |
\*-----------------------------------------------------------------------------*/
recordType    component;
schemaVersion 3;

name        NH3;
formula     "NH3";
CAS         7664-41-7;
MW          17.0305 g/mol;
role        solute;

standardStates
{
    vapour  { reference idealGas1bar; dHf_298 -45940 J/mol;  s_298 192.77 J/mol/K; }
}

aqueousChemistry
{
    introduces ( NH3aq  NH4 );

    reactions
    (
        {
            name      ammoniaDissolution;
            equation "NH3(g) = NH3(aq)";
            stoichiometry
            (
                { species NH3;    phase vapour;   nu -1; }
                { species NH3aq;  phase aqueous;  nu  1; }
            );
            equilibriumCondition zeroAffinity;
            standardGibbs
            {
                authority  measuredK;
                measuredK
                {
                    logK25    1.7966;
                    analytic ( -18.758 0.0003367 2511.3 4.8619 39.192 );
                    convention PHREEQC-gasMolal-v1;
                    source   "USGS PHREEQC phreeqc.dat (public domain)";
                }
                crossCheck speciesData;
            }
        }

        {
            name      ammoniumDissociation;
            equation "NH4+ = NH3(aq) + H+";
            stoichiometry
            (
                { species NH4;    phase aqueous;  nu -1; }
                { species NH3aq;  phase aqueous;  nu  1; }
                { species H;      phase aqueous;  nu  1; }
            );
            equilibriumCondition zeroAffinity;
            standardGibbs
            {
                authority  measuredK;
                measuredK
                {
                    logK25   -9.252;          // pKa of the ammonium ion
                    dH        52090 J/mol;
                    source   "USGS PHREEQC phreeqc.dat (public domain)";
                }
                crossCheck speciesData;       // NOT AVAILABLE today: NH3aq
                                              // carries no formation datum
                                              // (curation debt, announced)
            }
        }
    );
}
