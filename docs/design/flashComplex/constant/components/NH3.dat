/*--------------------------------*- Choupo -*-----------------------*\
  Component: Ammonia  (NH3, CAS 7664-41-7)  --  DESIGN DRAFT.

  Volatile weak base.  Its two equilibria live in chemistry/:
      NH3(g) = NH3(aq)         NH3-dissolution.dat
      NH4+   = NH3(aq) + H+    NH3aq-formation.dat   (written as the
                                                      formation of the
                                                      neutral from NH4+)
  The MASTER of this network is NH4+, not NH3(aq): at circumneutral pH
  almost all the ammonia is protonated, and a master that is a minority
  species conditions the solve badly.  Hence the mapping below carries
  nu(H) = -1 -- feeding NH3 CONSUMES a proton.  That sign is what makes an
  ammonia feed raise the pH, and it is why the mapping must be declared
  rather than guessed from the formula.

  Values mirrored from data/standards/components/NH3.dat.
\*---------------------------------------------------------------------------*/

name        NH3;
formula     NH3;
CAS         7664-41-7;

MW          17.030;
Tc          405.40;
Pc          113.59;
omega       0.252;
Tb          239.82;
HvapTb      23330;
Vliq        2.50e-5;

standardThermochemistry
{
    dHf_298    -45940.0;        // J/mol  -- ideal-gas reference
    s_298      192.77;          // J/(mol*K)
}

vaporPressure
{
    model         Antoine;
    coefficients  (4.86886   1113.928   -10.409);
    Trange        (195  371);
}

idealGasHeatCapacity
{
    model         polynomial;
    coefficients  (27.31   0.02383   1.707e-5   -1.185e-8);
    Trange        (250  1500);
}

liquidHeatCapacity
{
    model         polynomial;
    coefficients  (80.0);
    Trange        (200  350);
}

aqueousSpeciation  ammonia;
aqueousMapping ( { species NH4; nu 1; } { species H; nu -1; } );
