/*--------------------------------*- Choupo -*-----------------------*\
  Component: Hydrogen sulfide  (H2S, CAS 7783-06-4)  --  DESIGN DRAFT.
  Added mid-flight in this case, together with acetic acid.

  Volatile weak acid.  Its rungs live in chemistry/:
      H2S(g)   = H2S(aq)       H2S-dissolution.dat  (CASE-LOCAL: the
                               catalogue record is FUSED with the first
                               dissociation; see that file's header)
      HS- + H+ = H2S(aq)       H2Saq-formation.dat  (pKa1 6.994)

  Master: HS-.  Feeding H2S RELEASES a proton, hence nu(H) = +1 -- the
  opposite sign to ammonia, and the reason the two together buffer this case.

  Values mirrored from data/standards/components/H2S.dat.
\*---------------------------------------------------------------------------*/

name        H2S;
formula     H2S;
CAS         7783-06-4;

MW 34.082;
Tc          373.40;
Pc          89.63;
omega       0.090;
Tb          213.60;
HvapTb      18670;
Vliq        3.49e-5;

standardThermochemistry
{
    dHf_298    -20630.0;        // J/mol  -- ideal-gas reference
    s_298      205.79;          // J/(mol*K)
}

vaporPressure
{
    model         Antoine;
    coefficients  (4.22883   806.62   -25.770);
    Trange        (188  340);
}

idealGasHeatCapacity
{
    model         polynomial;
    coefficients  (31.94   1.436e-3   2.432e-5   -1.176e-8);
    Trange        (250  1500);
}


aqueousSpeciation  sulfide;
aqueousMapping ( { species HS; nu 1; } { species H; nu 1; } );
