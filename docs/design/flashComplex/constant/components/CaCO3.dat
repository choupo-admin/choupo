/*--------------------------------*- Choupo -*--------------------------------*\
|  CaCO3 -- fed as a suspended solid; may dissolve or grow.                    |
|  DESIGN DRAFT (flashComplex).                                                |
\*-----------------------------------------------------------------------------*/
/*---------------------------------------------------------------------------*\
  TWO WAYS TO WRITE THE SAME EQUILIBRIUM (and why they agree)
  -----------------------------------------------------------
  The solubility product the student learns:

      CaCO3(s) = Ca+2 + CO3-2        pKsp = 8.450

  The form the geochemical catalogues store (acid form, because CO3-2 is a
  poor master at circumneutral pH):

      CaCO3(s) + H+ = Ca+2 + HCO3-   log K = +1.879

  They are the SAME equilibrium, related through the bicarbonate step:

      -8.450 + 10.329 = 1.879    exactly

  Choupo declares the Ksp form (what the course teaches) and VERIFIES it
  against the catalogue's acid form through the ladder -- a numerical
  conversion, never a string match.
\*---------------------------------------------------------------------------*/
recordType    component;
schemaVersion 3;

name        CaCO3;
formula     "CaCO3";
CAS         471-34-1;
MW          100.0869 g/mol;
defaultPhase calcite;

standardStates
{
    calcite { dHf_298 -1207600 J/mol; s_298 91.7 J/mol/K;
              physical { rho_p 2710 kg/m^3; }
              source "CODATA Key Values 1989; xcheck Robie-Hemingway 1995"; }
}

aqueousChemistry
{

    reactions
    (
        {
            name      calciteDissolution;
            equation "CaCO3(calcite) = Ca+2 + CO3-2";
            stoichiometry
            (
                { species CaCO3;  phase calcite;  nu -1; }
                { species Ca;     phase aqueous;  nu  1; }
                { species CO3;    phase aqueous;  nu  1; }
            );
                            authority  measuredK;
                measuredK
                {
                    logK25   -8.450;          // pKsp 8.450
                    dH       -13179.6 J/mol;  // = -28078.8 + 14899.2 (acid
                                              //   form + bicarbonate step)
                    validC   ( 0 300 );
                    source   "USGS PHREEQC phreeqc.dat (public domain), acid
                              form log K 1.879 converted through the
                              bicarbonate step; lit: Plummer & Busenberg 1982";
                }
            }
        }
    );
}
