/*--------------------------------*- Choupo -*-----------------------*\
  Component: Calcium carbonate (CaCO3), CALCITE polymorph.  CAS 471-34-1.
  DESIGN DRAFT.  Fed as a suspended solid; may dissolve or grow.

  TWO WAYS TO WRITE THE SAME EQUILIBRIUM -- and why only ONE is stored.
  ------------------------------------------------------------------
  The solubility product the course teaches:

      CaCO3(s) = Ca+2 + CO3-2          pKsp = 8.450

  The form the geochemical catalogues store, because CO3-2 is a poor master
  at circumneutral pH (it is a vanishing minority there):

      CaCO3(s) + H+ = Ca+2 + HCO3-     log K = +1.879

  They are the SAME equilibrium, related exactly through the bicarbonate rung
  (chemistry/CO3-formation.dat, pK2 = 10.329):

      -8.450 + 10.329 = +1.879

  Choupo stores the ACID form only -- the one written on the masters the
  solver actually uses.  Storing the Ksp form as well would give one
  equilibrium two homes, and the day pK2 were revised the two would disagree
  with nothing to say which wins.  The conversion belongs here, in the
  header, where the student reads it; not in a second field.

  Values mirrored from data/standards/components/CaCO3.dat.
\*---------------------------------------------------------------------------*/

name        CaCO3;
formula     CaCO3;
CAS         471-34-1;

MW          100.0869;          // kg/kmol  (calcite)

solid
{
    rho_p   2710.0;            // calcite particle density [kg/m^3]
}

// The ONE formation datum, in this component's natural phase (solid).
// PRIMARY: CODATA Key Values for Thermodynamics (Cox, Wagman & Medvedev
// 1989); cross-checked vs Robie & Hemingway, USGS Bull. 2131 (1995).
standardThermochemistry
{
    dHf_298   -1207600;        // J/mol  calcite
    s_298     91.7;            // J/(mol*K)  third-law absolute
    referenceState     pureSolid;
}

// Real solid Cp of calcite: 83.5 J/(mol*K) at 298.15 K rising to ~110.9 at
// 600 K.  Quadratic least-squares fit to Robie & Hemingway 1995 (a U.S.
// Government work, public domain), AAD < 0.3 %.
solidHeatCapacity
{
    model         polynomial;
    coefficients  ( 29.8993   0.224617   -1.49637e-04 );
    Trange        ( 298  600 );
}

// The mineral's dissolution: a property of THIS component's solid phase, so
// it lives here and not in chemistry/ (see chemistry/README.md).  Both
// polymorphs are declared; which one the case allows is the phase's business,
// declared in constant/thermoPhysPropDict.
solidPhases
{
    calcite
    {
        dissolutionReaction { masters ( { ion Ca; nu 1; } { ion HCO3; nu 1; } { ion H; nu -1; } ); }
        equilibrium { logK25 1.879; dH -28078.8; analytic ( 40.0171 -0.01928451 -5151.79 -8.66815 563713.9 ); validC ( 0 300 ); source "USGS PHREEQC phreeqc.dat (public domain); lit: 0 - 300 C, Ellis, 1959, Plummer and Busenberg, 1982"; }
    }
    aragonite
    {
        dissolutionReaction { masters ( { ion Ca; nu 1; } { ion HCO3; nu 1; } { ion H; nu -1; } ); }
        equilibrium { logK25 1.993; dH -25731.6; analytic ( -64.0902 -0.04546451 -2248.497 32.66939 563713.9 ); source "USGS PHREEQC phreeqc.dat (public domain)"; }
    }
}
