/*--------------------------------*- Choupo -*--------------------------------*\
|  benzene -- the ORGANIC solvent.  DESIGN DRAFT.                              |
\*-----------------------------------------------------------------------------*/
recordType    component;
schemaVersion 3;

name        benzene;
formula     "C6H6";
CAS         71-43-2;
MW          78.114 g/mol;
role        solvent;

standardStates
{
    liquid  { reference pureLiquid;   dHf_298  49080 J/mol; s_298 173.3 J/mol/K; }
    vapour  { reference idealGas1bar; dHf_298  82930 J/mol; s_298 269.3 J/mol/K; }
}

aqueousChemistry
{
    speciation none;
    note "nonionising; its real (small) water solubility is EXCLUDED by the
          declared organic-phase approximation -- see thermoPhysPropDict";
}

vapourLiquidEquilibrium { route raoultBackbone; }
