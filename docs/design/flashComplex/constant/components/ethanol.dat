/*--------------------------------*- Choupo -*--------------------------------*\
|  ethanol -- molecular condensable; joins BOTH liquids.  DESIGN DRAFT.        |
\*-----------------------------------------------------------------------------*/
recordType    component;
schemaVersion 3;

name        ethanol;
formula     "C2H6O";
CAS         64-17-5;
MW          46.068 g/mol;
role        solute;

standardStates
{
    liquid  { reference pureLiquid;   dHf_298 -277690 J/mol; s_298 160.7 J/mol/K; }
    vapour  { reference idealGas1bar; dHf_298 -234800 J/mol; s_298 281.6 J/mol/K; }
}

//  The curated FACT the classifier reads: ethanol takes part in NO aqueous
//  speciation equilibrium.  It is a molecular condensable on the Raoult
//  backbone of every liquid phase that admits it -- never a Henry solute,
//  never an ion.
aqueousChemistry
{
    speciation none;
    note "nonionising: no acid-base, complexation or precipitation
          equilibrium in water at any pH this case reaches";
}

vapourLiquidEquilibrium
{
    route  raoultBackbone;        // p = gamma * x * psat(T)
    note   "gamma from the declared molecular activity model of whichever
            liquid phase it sits in (NRTL in both here)";
}
