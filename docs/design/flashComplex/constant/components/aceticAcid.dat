/*--------------------------------*- Choupo -*--------------------------------*\
|  aceticAcid -- volatile weak acid that ALSO associates in the vapour.        |
|  DESIGN DRAFT (flashComplex).                                                |
\*-----------------------------------------------------------------------------*/
recordType    component;
schemaVersion 3;

name        aceticAcid;
formula     "C2H4O2";
CAS         64-19-7;
MW          60.052 g/mol;
role        solute;

standardStates
{
    liquid  { reference pureLiquid;   dHf_298 -484500 J/mol; s_298 159.8 J/mol/K; }
    vapour  { reference idealGas1bar; dHf_298 -432800 J/mol; s_298 283.5 J/mol/K; }
}

aqueousChemistry
{
    introduces ( HAc  Acetate );

    reactions
    (
        {
            name      aceticAcidDissolution;
            equation "HAc(g) = HAc(aq)";
            stoichiometry
            (
                { species aceticAcid; phase vapour;   nu -1; }
                { species HAc;        phase aqueous;  nu  1; }
            );
            equilibriumCondition zeroAffinity;
            standardGibbs
            {
                authority  measuredK;
                measuredK
                {
                    logK25    3.61;
                    dH       -51500 J/mol;
                    convention PHREEQC-gasMolal-v1;
                    source   "Sander, R. (2015) Atmos. Chem. Phys. 15, 4399
                              (CC-BY 3.0): H_cp ~ 4.1e3 M/atm at 298 K";
                }
                crossCheck speciesData;
            }
        }

        {
            name      aceticDissociation;
            equation "HAc(aq) = H+ + Acetate-";
            stoichiometry
            (
                { species HAc;      phase aqueous;  nu -1; }
                { species H;        phase aqueous;  nu  1; }
                { species Acetate;  phase aqueous;  nu  1; }
            );
            equilibriumCondition zeroAffinity;
            standardGibbs
            {
                authority  measuredK;
                measuredK
                {
                    logK25   -4.756;         // pKa
                    dH       -410 J/mol;
                    source   "Goldberg, Kishore & Lennen, J. Phys. Chem. Ref.
                              Data 31 (2002) 231";
                }
                crossCheck speciesData;
            }
        }
    );
}

//  A reaction in the VAPOUR phase -- the carboxylic-acid signature.  It is
//  NOT aqueous chemistry, so it lives in its own block: the dimer re-weights
//  the vapour mole balance (v_HAc = t_mono + 2*t_dim) and its association
//  heat is priced into the duty.
vapourChemistry
{
    introduces ( HAc2 );

    reactions
    (
        {
            name      aceticDimerisation;
            equation "2 HAc(g) = (HAc)2(g)";
            stoichiometry
            (
                { species aceticAcid; phase vapour;  nu -2; }
                { species HAc2;       phase vapour;  nu  1; }
            );
            equilibriumCondition zeroAffinity;
            standardGibbs
            {
                authority  measuredK;
                measuredK
                {
                    logK25    3.146;          // K_dim [atm^-1]
                    dH       -58500 J/mol;
                    source   "Chao & Zwolinski, J. Phys. Chem. Ref. Data 7
                              (1978) 363";
                    reviewStatus interim;
                    reviewReason ( primarySourceRecheck );
                    reviewOwner  IST;
                }
                crossCheck speciesData;
            }
        }
    );
}
