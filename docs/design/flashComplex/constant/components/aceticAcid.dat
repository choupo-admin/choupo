/*--------------------------------*- Choupo -*-----------------------*\
  Component: Acetic acid  (C2H4O2, CAS 64-19-7)  --  DESIGN DRAFT.
  Added mid-flight in this case, together with H2S.

  Weak acid in the water AND an associating vapour -- the carboxylic-acid
  signature.  Both facts live in chemistry/aceticAcid-dissolution.dat: the
  Henry rung and, in the same record, the VAPOUR dimerisation
  2 CH3COOH(g) = (CH3COOH)2(g).  The dimer re-weights the vapour mole balance
  (v_HAc = t_mono + 2*t_dim) and its association heat is priced into the duty.
  It sits with the gas-liquid record because it is the same substance's
  gas-phase behaviour, not because it is aqueous chemistry.

  The dissociation HAc(aq) = H+ + Acetate- is chemistry/HAc-formation.dat
  (written, per the catalogue convention, as the formation of the neutral
  from its masters).

  Values mirrored from data/standards/components/aceticAcid.dat.
\*---------------------------------------------------------------------------*/

name        aceticAcid;
formula     C2H4O2;
CAS         64-19-7;

MW          60.052;
Tc          591.95;
Pc          57.86;
omega       0.4665;
Tb          391.05;
HvapTb      24390;
Vliq        5.752e-5;

standardThermochemistry
{
    dHf_298   -432250.0;        // J/mol  -- ideal-gas reference
    s_298      282.500;           // J/(mol*K)
}

vaporPressure
{
    model         Antoine;
    coefficients  (4.68206   1642.540   -39.764);
    Trange        (290  392);
}

idealGasHeatCapacity
{
    model         polynomial;
    coefficients  (4.840   0.2549   -1.753e-4   4.949e-8);
    Trange        (200  1500);
}

liquidHeatCapacity
{
    model         polynomial;
    coefficients  (123.1);
    Trange        (290  390);
}

aqueousSpeciation  aceticAcid;
aqueousMapping ( { species Acetate; nu 1; } { species H; nu 1; } );
