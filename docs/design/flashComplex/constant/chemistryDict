/*---------------------------------------------------------------------------*\
  The rules this declaration lives by (the ratified form):

    * the STOICHIOMETRY BLOCK is the primary truth -- typed species, signed
      nu, phase tag per term.  The DIRECTION is what the student wrote:
      every K below applies to the reaction AS WRITTEN HERE.
    * the rendered equation next to each entry is a COMMENT (derived,
      re-printed by the engine); the engine refuses if they ever disagree.
    * the pK / logK / pKsp values are DECLARED-AND-VERIFIED: the catalogue
      is the single home of the numbers; a declared value disagreeing with
      the curated record is a loud error; a reaction with no curated
      record is a refusal with the curation remedy.
    * before solving anything the engine CHECKS the student's chemistry:
      charge balance (sum nu*z = 0) and element balance per reaction --
      a mistyped reaction is refused by the physics, element by element.

  FOUR acid-base families share one H+ (carbonate, ammonia, sulfide,
  acetate); one pH couples every equilibrium below, both precipitates,
  and the volatility of every weak electrolyte.
\*---------------------------------------------------------------------------*/

recordType    chemistrySystem;
schemaVersion 2;                    // v1 = solids-list only; v2 = the full
                                    // declared system (subsumes v1)

// ======================  AQUEOUS (homogeneous)  ======================
reactions
(
    {
        name           waterAutoprotolysis;
        //  H2O = H+ + OH-
        stoichiometry
        (
            { species H2O;    phase aqueous;  nu -1; }
            { species H;      phase aqueous;  nu  1; }
            { species OH;     phase aqueous;  nu  1; }
        );
        pK             14.00;
    }
    {
        name           ammoniumDissociation;
        //  NH4+ = NH3(aq) + H+
        stoichiometry
        (
            { species NH4;    phase aqueous;  nu -1; }
            { species NH3aq;  phase aqueous;  nu  1; }
            { species H;      phase aqueous;  nu  1; }
        );
        pK             9.25;
    }
    {
        name           carbonicFirstDissociation;
        //  CO2(aq) + H2O = HCO3- + H+
        stoichiometry
        (
            { species CO2aq;  phase aqueous;  nu -1; }
            { species H2O;    phase aqueous;  nu -1; }
            { species HCO3;   phase aqueous;  nu  1; }
            { species H;      phase aqueous;  nu  1; }
        );
        pK             6.35;
    }
    {
        name           bicarbonateDissociation;
        //  HCO3- = CO3-2 + H+
        stoichiometry
        (
            { species HCO3;   phase aqueous;  nu -1; }
            { species CO3;    phase aqueous;  nu  1; }
            { species H;      phase aqueous;  nu  1; }
        );
        pK             10.33;
    }
    {
        name           sulfideFirstDissociation;
        //  H2S(aq) = HS- + H+
        //  (the second step HS- = S-2 + H+ is DELIBERATELY absent: its pK
        //   is contested across the literature by ~7 units, 12..19 --
        //   modern PHREEQC dropped S-2; leaving it out is a curation
        //   decision, stated here, not an oversight)
        stoichiometry
        (
            { species H2Saq;  phase aqueous;  nu -1; }
            { species HS;     phase aqueous;  nu  1; }
            { species H;      phase aqueous;  nu  1; }
        );
        pK             6.99;
    }
    {
        name           aceticDissociation;
        //  HAc(aq) = Ac- + H+
        stoichiometry
        (
            { species HAc;    phase aqueous;  nu -1; }
            { species Acetate; phase aqueous; nu  1; }
            { species H;      phase aqueous;  nu  1; }
        );
        pK             4.756;
    }
);

// ==================  GAS-LIQUID (Henry, K-bearing)  ==================
//  The Raoult-convention legs (water, ethanol, benzene: f_V = f_L via
//  gamma * x * psat) carry NO equilibrium constant -- they live with the
//  phase MODELS in thermoPhysPropDict.  Open design question Q4.
gasLiquid
(
    {
        name           CO2dissolution;
        //  CO2(g) = CO2(aq)
        stoichiometry
        (
            { species CO2;    phase gas;      nu -1; }
            { species CO2aq;  phase aqueous;  nu  1; }
        );
        logK           -1.468;
    }
    {
        name           NH3dissolution;
        //  NH3(g) = NH3(aq)
        stoichiometry
        (
            { species NH3;    phase gas;      nu -1; }
            { species NH3aq;  phase aqueous;  nu  1; }
        );
        logK           1.7966;
    }
    {
        name           H2Sdissolution;
        //  H2S(g) = H2S(aq)     -- the PHYSICAL (molecular) dissolution.
        //  DECOMPOSED from the catalogue's fused record (H2S(g) = H+ + HS-,
        //  logK -7.93) minus the first dissociation (Ka1, logK -6.994):
        //      logK_phys = -7.93 - (-6.994) = -0.94
        //  This is the D6 dossier finding EXECUTED: the fused constant and
        //  the molecular Henry become comparable only through this explicit
        //  thermodynamic decomposition -- never by label.
        stoichiometry
        (
            { species H2S;    phase gas;      nu -1; }
            { species H2Saq;  phase aqueous;  nu  1; }
        );
        logK           -0.94;   // INTERIM: derived, pending curation as its
                                // own record with both parents cited
    }
    {
        name           HAcDissolution;
        //  HAc(g) = HAc(aq)
        stoichiometry
        (
            { species HAc;    phase gas;      nu -1; }
            { species HAc;    phase aqueous;  nu  1; }
        );
        logK           3.61;
    }
    {
        name           N2dissolution;
        //  N2(g) = N2(aq)   (the inert is NOT insoluble -- it is priced)
        //  NOTE the same token on both sides: in this grammar identity is
        //  the TYPED PAIR (species, phase) -- the catalogue's dissolved-N2
        //  label is plain "N2", and the phase tag does the disambiguation
        //  the aq-suffix does for bare-string record references.
        stoichiometry
        (
            { species N2;     phase gas;      nu -1; }
            { species N2;     phase aqueous;  nu  1; }
        );
        logK           -3.1864;
    }
);

// ================  VAPOUR-PHASE (homogeneous, gas)  ================
//  The fourth arena: a reaction INSIDE the vapour.  The carboxylic-acid
//  signature re-weights the vapour balance (v_HAc = t_mono + 2 t_dim)
//  and its association heat is priced into the duty.
vapourReactions
(
    {
        name           aceticDimerisation;
        //  2 HAc(g) = (HAc)2(g)
        stoichiometry
        (
            { species HAc;    phase gas;      nu -2; }
            { species HAc2;   phase gas;      nu  1; }
        );
        logK           3.146;   // K_dim [atm^-1]; INTERIM (Chao & Zwolinski
                                // 1978) -- primary re-check pending
    }
);

// ====================  SOLID-LIQUID (saturation)  ====================
solids
(
    {
        name           calcite;
        component      CaCO3;               // the flowsheet-basis identity
        //  CaCO3(s) = Ca+2 + CO3-2
        stoichiometry
        (
            { species CaCO3;  phase solid;    nu -1; }
            { species Ca;     phase aqueous;  nu  1; }
            { species CO3;    phase aqueous;  nu  1; }
        );
        pKsp           8.48;
    }
    {
        name           ammoniumBicarbonate;
        component      NH4HCO3;
        //  NH4HCO3(s) = NH4+ + HCO3-
        stoichiometry
        (
            { species NH4HCO3; phase solid;   nu -1; }
            { species NH4;     phase aqueous; nu  1; }
            { species HCO3;    phase aqueous; nu  1; }
        );
        pKsp           -0.25;   // INTERIM: order of magnitude from the
                                // ~220 g/L (25 C) solubility; primary
                                // curation pending (Trypuc & Kielkowska,
                                // J. Chem. Eng. Data) -- NOT promotable
    }
);
