/*--------------------------------*- Choupo -*--------------------------------*\
|  Ca2+ + HCO3- = CaHCO3+   -- a CROSS-FAMILY ion pair (calcium x carbonate)   |
\*-----------------------------------------------------------------------------*/
/*---------------------------------------------------------------------------*\
  !! CATALOGUE DEFECT FOUND WHILE DRAFTING THIS CASE (2026-07-27) !!

  data/standards/chemistry/CaHCO3-formation.dat currently holds

      logK25 -4.059 ;  dH 158117.5 J/mol

  Both are wrong.  Evidence:

    * the SIBLING pairs in the same catalogue are internally consistent and
      this one is five orders of magnitude away from the family:

          MgHCO3+   logK +1.07   dH   3305 J/mol
          SrHCO3+   logK +1.18   dH  25313 J/mol
          BaHCO3+   logK +0.98   dH  23263 J/mol
          CaHCO3+   logK -4.06   dH 158118 J/mol   <-- out of family

    * the record CITES phreeqc.dat as its source, and phreeqc.dat holds
      log_k 1.106, delta_h 2.69 kcal (= 11255 J/mol) for this reaction --
      so the record is unfaithful to its own declared source;

    * a dH of 158 kJ/mol for an ion-pair association is physically absurd
      (six times the highest sibling); it would swing log K by +4.6 units
      between 298 and 358 K, inverting the hot-carbonate chemistry.

  CONSEQUENCE of the stored value: the pair effectively never forms, free
  Ca2+ is overestimated, and calcite saturation is overestimated.

  The corrected values are used BELOW for this design draft.  The standards
  record is NOT edited here -- correcting it is a curation act (it re-seals
  ~34 cases) and belongs to its own reviewed wave.
\*---------------------------------------------------------------------------*/
recordType    complexFormation;
schemaVersion 3;

//  The STANDARDS record this one supersedes carries a suspect value.  Marked
//  machine-readably so no case can consume it as if validated, and so the
//  curation report picks it up without a human remembering:
supersedes
{
    record  "data/standards/chemistry/CaHCO3-formation.dat";
    status  suspectedBadData;
    reason  "logK25 -4.059 / dH 158117.5 contradict the record's own cited
             source (phreeqc.dat: log_k 1.106, delta_h 2.69 kcal) and sit 51
             and 12 median-absolute-deviations from the Mg/Sr/Ba siblings";
    fix     "own reviewed wave: verify source, units, reaction direction and
             sign, correct, re-seal the ~34 affected cases, run the suite";
}

name        CaHCO3;
equation   "Ca+2 + HCO3- = CaHCO3+";
stoichiometry
(
    { species Ca;      phase aqueous;  nu -1; }
    { species HCO3;    phase aqueous;  nu -1; }
    { species CaHCO3;  phase aqueous;  nu  1; }
);
standardGibbs
{
    authority  measuredK;
    measuredK
    {
        logK25    1.106;
        dH        11255 J/mol;
        source   "USGS PHREEQC phreeqc.dat (public domain), log_k 1.106,
                  delta_h 2.69 kcal -- restores the value the standards
                  record claims but does not carry (see header)";
    }
}
