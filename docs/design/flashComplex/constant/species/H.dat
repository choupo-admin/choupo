recordType    modelSpecies;
schemaVersion 3;

name        H;
formula     "H+";
charge      +1;
MW          1.008 g/mol;
phase       aqueous;
standardState infiniteDilutionMolality;

//  The proton is the CONVENTION anchor: every single-ion standard property
//  in this databank is referenced to it.  Declared, never implied.
ionicConvention protonZero;
aqueousThermo { hfAq { value 0; unit J/mol; }  sAq { value 0; unit J/mol/K; } }
