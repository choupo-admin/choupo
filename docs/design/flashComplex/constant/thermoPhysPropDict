/*--------------------------------*- Choupo -*--------------------------------*\
|  flashComplex/constant/thermoPhysPropDict                                    |
|  The PHASES and the MODELS.  The CHEMISTRY is not here: it comes with the    |
|  components (see constant/components/*.dat and constant/complexes/).         |
\*-----------------------------------------------------------------------------*/
/*---------------------------------------------------------------------------*\
  ONE equilibrium condition, everywhere:      sum(nu_i * mu_i) = 0

  Homogeneous reactions, phase transfer and precipitation are the SAME
  condition applied to different stoichiometries.  What varies is only how
  each mu_i is built:

      mu_i = mu_i^0(T,P, standard state)  +  R T ln a_i

  and how the standard part is obtained -- from a MEASURED equilibrium
  constant or from SPECIES standard-state data.  Every reaction declares
  which, and the engine cross-checks whenever both exist.
\*---------------------------------------------------------------------------*/

recordType    thermophysicalPropertySystem;
schemaVersion 3;

//  No `components ( ... )` list: the components come from the feed and from
//  the solids the phases declare.  A component that is never fed and never
//  named by a phase cannot appear -- there is nothing to forget.

equilibrium
{


    phases
    {
        vapour
        {
            type          gas;
            fugacityModel idealGas;
            //  members: every component with a vapour standard state, plus
            //  the vapour species its chemistry introduces (the acetic dimer)
        }

        aqueous
        {
            type          liquid;
            solvent       water;

            activityModel
            {
                ions      Davies;      // water-referenced molality
                molecules NRTL;        // ion-free molecular backbone
            }
            //  composite mixed-solvent electrolyte v1: a COMPOSITE with
            //  proven limits, not an integrated Gibbs surface.  The
            //  mixed-solvent transfer term is a NAMED gap
            //  (docs/design/standard-state-transfer-adr.md).
        }

        organic
        {
            type          liquid;
            solvent       benzene;
            members       ( benzene  ethanol );
            activityModel NRTL;

            approximation
            {
                excludes ( water  CO2  NH3  H2S  aceticAcid );
                reason
                    "pedagogical benzene-ethanol organic phase: real benzene
                     holds ~0.2 mol% water and partitions acetic acid.  The
                     exclusion is DECLARED, announced at every run, and
                     refused for anything not listed here.";
            }
        }

        calcite
        {
            type          solid;
            component     CaCO3;
            standardState pureSolid;      // a_solid = 1, declared not implied
        }

        ammoniumBicarbonate
        {
            type          solid;
            component     NH4HCO3;
            standardState pureSolid;
        }
    }
}

