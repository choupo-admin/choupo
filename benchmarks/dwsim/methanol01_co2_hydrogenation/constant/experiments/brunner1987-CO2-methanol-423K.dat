/*--------------------------------------------------------------------------*\
  BINARY BUBBLE-POINT EVIDENCE (ISOTHERMAL): CO2 + methanol at 423.15 K.

  SOURCE: E. Brunner, W. Hultenschmidt, G. Schlichtharle, "Fluid mixtures
  at high pressures. IV. Isothermal phase equilibria in binary mixtures
  consisting of (methanol + hydrogen or nitrogen or methane or carbon
  monoxide or carbon dioxide)", J. Chem. Thermodynamics 19 (1987) 273-291;
  Table 1, p. 283 (PDF p. 11).  DOI not printed in the article; the PII on the PDF is
  0021-9614(87)90135-2.  The liquid-branch rows (bubble points, the
  authors' synthetic method in an optical cell): x is the GAS's liquid mole
  fraction, p the bubble pressure, as printed (p in MPa, kept).

  THE WINDOW (rule W2; rows outside it are set aside under `selection`, each
  with its reason, never deleted): T <= 0.9 Tc(methanol) = 461.4 K; the
  methanol-rich branch x_gas <= 0.5 (the plant's liquids carry <= 1.2 % of
  any gas); p <= 0.75 x the isotherm's measured mixture critical pressure
  where the authors print one; p <= 20.0 MPa.  W2 REVISES the first
  window (p <= 20 MPa alone) AFTER a first run, on a STRUCTURAL fact and not
  on a residual: near methanol's critical temperature and near a mixture's
  critical point PR78 with a near-zero kij has no bubble pressure at all, and
  the fit's flat penalty for "no bubble point" froze the regression there
  (kijFits/system/propsDict records the first run's results).

  TRANSCRIPTION: read from the page image at 400 dpi and checked by an
  independent reader at 500-600 dpi (2026-10-21): all 301 rows of Table 1
  agreed, hence `reviewStatus checked`.  The private transcription is in
  data/local/curation/c123/ (gitignored); the article is not redistributed.

  STATED UNCERTAINTY (pp. 276, 278): pressure < 0.2 % (strain-gauge
  transducers against a free-piston gauge); composition <= 0.02 x_gas or
  0.02 (1 - x), whichever is less; temperature <= 0.2 K below 373 K, 0.3 K
  to 473 K, 0.5 K above.
\*--------------------------------------------------------------------------*/

property     binaryVLE.P_bubble;
system       ( CO2 methanol );
T            423.15 K;      // the held constant of this isotherm

provenance
{
    source       measured;
    reviewStatus checked;
    citation     "Brunner, E.; Hultenschmidt, W.; Schlichtharle, G. (1987). Fluid mixtures at high pressures. IV. Isothermal phase equilibria in binary mixtures consisting of (methanol + hydrogen or nitrogen or methane or carbon monoxide or carbon dioxide). J. Chem. Thermodynamics 19, 273-291. Table 1, p. 283 (PDF p. 11)";
    pii          "0021-9614(87)90135-2";
}

selection
{
    //  Bubble points outside window W2, set aside (not deleted).
    outsideWindowW2
    (
        { x 0.2748; p 12.8 MPa; reason "above 0.75 of the measured mixture critical pressure 16.13 MPa"; }
        { x 0.3529; p 14.8 MPa; reason "above 0.75 of the measured mixture critical pressure 16.13 MPa"; }
        { x 0.3753; p 15.13 MPa; reason "above 0.75 of the measured mixture critical pressure 16.13 MPa"; }
        { x 0.4353; p 15.97 MPa; reason "above 0.75 of the measured mixture critical pressure 16.13 MPa"; }
        { x 0.475; p 16.08 MPa; reason "above 0.75 of the measured mixture critical pressure 16.13 MPa"; }
    );
}

columns
(
    { name x[CO2];  unit -;  }
    { name p;  unit MPa;  }
);

data
(
    0.046      3.67    
    0.0942     5.89    
    0.1192     6.95    
    0.2033     10.45   
    0.2386     11.62   
);
