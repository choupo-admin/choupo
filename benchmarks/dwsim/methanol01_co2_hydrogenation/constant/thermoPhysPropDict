/*---------------------------------------------------------------------------*\
  Benchmark D -- the thermophysical system: phi-phi PR78 (Choupo's
  `PengRobinson`, the 1978 two-branch slope -- methanol, omega 0.565, IS on
  the 1978 branch here and the run says so) over the sample's eight
  components, with:

    * the GAS PAIRS (H2, CO2, CO, water, N2, Ar: 15 pairs) from E-PPR78,
      Xu, Lasala, Privat & Jaubert (2017), evaluated ONCE at 510.15 K --
      the one temperature any unit of this plant DECLARES (the reactor's)
      -- by the `ppr78Kij` op in kijTables/ and written as a kij SET record
      (route P, DEV.md 4c C123).  STATED DEFAULT: every unit reads this
      set; no other unit declares a temperature (the separators, exchangers
      and compressors inherit theirs).  Eleven of the fifteen pairs are
      EXTRAPOLATED in T from the data their parameters were fitted on (the
      set record names each window; the run repeats it) -- only the four
      water pairs with H2, CO2, N2 and Ar were fitted up to ~700 K;
    * the METHANOL PAIRS with H2, CO and CO2 from Choupo's OWN regression
      to Brunner, Hultenschmidt & Schlichtharle (1987) in kijFits/ -- one
      isotherm held out per gas, the band declared before the fit, the
      verdict in each record and announced on the run.  PPR78 has no
      methanol group;
    * METHANOL-WATER from Choupo's own regression too, to two measured
      isobaric series the corpus carries (curate04's, partitioned as it
      partitions them) -- added after the plant's first run, at kij = 0,
      found the first column infeasible (R_min 5.22 against the sample's
      reflux 1.5): PR78 at kij = 0 bends the methanol-water bubble curve
      through a minimum at 1 atm (kijFits/system/propsDict has the numbers);
    * EVERY OTHER PAIR AT kij = 0, announced by the builder as undeclared:
      methanol-N2, methanol-Ar, methanol-O2 and the six O2 pairs.  No
      primary source for them was read (Brunner 1987's N2 isotherms were not
      transcribed; the 2017 table's O2 pairs were outside the
      transcription's scope).  O2 and N2 are each <= 1e-4 of either feed.

  The reference sample runs its own Peng-Robinson package with the pair
  parameters it embeds; none is read.
\*---------------------------------------------------------------------------*/

recordType    thermophysicalPropertySystem;
schemaVersion 2;

components ( methanol water H2 CO2 CO N2 O2 Ar );

equilibrium
{
    formulation phiPhi;

    equationOfState
    {
        model      PengRobinson;
        mixingRule vanDerWaalsOneFluid;
        binaryInteractions
        {
            eppr78       { source "constant/parameters/PengRobinson/eppr78_510.15K.dat"; }
            H2-methanol  { source "constant/parameters/PengRobinson/H2-methanol.dat"; }
            CO-methanol  { source "constant/parameters/PengRobinson/CO-methanol.dat"; }
            CO2-methanol { source "constant/parameters/PengRobinson/CO2-methanol.dat"; }
            methanol-water { source "constant/parameters/PengRobinson/methanol-water.dat"; }
        }
    }

    liquid { fugacityRoute equationOfState; root liquid; }
    vapour { fugacityRoute equationOfState; root vapour; }
}

caloric
{
    energyBasis elementsDatum;
    liquid { departureRoute equilibriumEquationOfState; root liquid; }
    vapour { departureRoute equilibriumEquationOfState; root vapour; }
}
