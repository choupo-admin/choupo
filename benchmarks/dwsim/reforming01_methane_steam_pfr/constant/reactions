        rateConstant { name k2;  unit kmol/kg/h; }

        validity
        {
            T  { min 773 K;  max 848 K;  outside announce;  unit K;   }
            P  { min 3 bar;  max 15 bar; outside announce;  unit bar; }
        }
    }
}

