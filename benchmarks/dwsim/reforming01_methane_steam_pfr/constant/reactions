    kinetics
    {
        type     expression;
        source   "Xu & Froment, AIChE J. 35 (1989) 88-96: Eq. 3 (p. 92) r2 and DEN; A from Table 6, E2 and dH from Table 5; K2 from Choupo's formation data";
        basis    catalystMass;
        rateOf   extent;

        parameters
        {
            A_k2     1.955e6   kmol/kg/h;   // Table 6 (kmol / (kg h bar); bar absorbed below)
            E2       67.13     kJ/mol;      // Table 5
            A_KCO    8.23e-5   -;
            dH_CO    -70.65    kJ/mol;
            A_KH2    6.12e-9   -;
            dH_H2    -82.90    kJ/mol;
            A_KCH4   6.65e-4   -;
            dH_CH4   -38.28    kJ/mol;
            A_KH2O   1.77e5    -;
            dH_H2O   88.68     kJ/mol;
            R_XF     8.314     J/mol/K;
            bar      1         bar;
        }

        tables
        {
            lnK
            {
                x      ( LNK_T_ROWS );   xUnit K;
                lnK2   ( LNK2_ROWS );
                yUnit  -;
            }
        }

        definitions
        {
            pCH4   "p[CH4] / bar";
            pH2O   "p[water] / bar";
            pCO    "p[CO] / bar";
            pCO2   "p[CO2] / bar";
            pH2    "p[H2] / bar";
            k2     "A_k2 * exp(-E2 / (R_XF * T))";
