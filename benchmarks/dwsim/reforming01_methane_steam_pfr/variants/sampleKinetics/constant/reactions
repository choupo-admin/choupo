/*---------------------------------------------------------------------------*\
  reactions -- VARIANT sampleKinetics: the SAME three rate laws the
  reference sample stores, written here as Choupo expressions, so the two
  programs integrate the same equations (the C&CE article's "same models"
  exercise, paper/cace/main.tex; DEV.md 4c C126).

  WHAT IS TAKEN FROM THE SAMPLE: the three rate expressions as its
  `reactions` block stores them (../../reference, written by read_sample.py
  from the sample at commit 1abf72d1b; every number below is a number of
  those strings, nothing else of the sample is read):
    * partial pressures in ATM (`concUnit atm`), rates in kmol/(kg h)
      (`velUnit kmol/[kg.h]`);
    * its rounded pre-exponentials (4.22e15, 1.96e6, 1.02e15);
    * its own equilibrium correlations, K1 = exp(30.42 - 27106/T) atm^2,
      K2 = exp(-3.798 + 4160/T), K3 = exp(34.218 - 31266/T) atm^2;
    * its denominators AS STORED: the shift's carries no K_CH4 p_CH4 term
      and the overall reforming's no K_CO p_CO term.
  The labels R1, R2 (reactants) and P1, P2 (products) of the stored strings
  are resolved by the order of each reaction's stoichiometry list in the
  sample; that order is also the only one under which each numerator is
  the article's rate (Xu & Froment 1989, Eq. 3), so the resolution is
  checked twice:
      steam reforming   R1 CH4, R2 H2O, P1 H2, P2 CO
      water-gas shift   R1 H2O, R2 CO,  P1 H2, P2 CO2
      overall           R1 CH4, R2 H2O, P1 H2, P2 CO2
  R = 8.314 J/(mol K) as the strings write it.

  WHAT STAYS CHOUPO'S: the reactor integration, the stream thermodynamics
  (PR78 + E-PPR78 at 1000 K and 1 atm, measured to move the outlet in no
  printed digit -- README), the formation data that price the duty, and
  the inlet pressure along the bed (the sample's Ergun drop of 584 Pa is
  not reproduced; README).

  THIS IS A COMPARISON DEVICE, NOT A MODEL CHOUPO RECOMMENDS: the main
  case writes Xu & Froment as the article prints them; this variant writes
  the sample's departures from it on purpose, so that a difference left
  between the two programs cannot be blamed on the rate laws.
\*---------------------------------------------------------------------------*/

steamReforming      // reaction I, the sample's "Steam Reforming"
{
    stoichiometry
    (
        { component CH4;    nu -1; }
        { component water;  nu -1; }
        { component CO;     nu  1; }
        { component H2;     nu  3; }
    );

    kinetics
    {
        type     expression;
        source   "the reference sample's stored rate expression for 'Steam Reforming' (benchmarks/dwsim/reforming01_methane_steam_pfr/reference): atm, its rounded A and its own K1 correlation";
        basis    catalystMass;
        rateOf   extent;

        parameters
        {
            A_k1     4.22e15   kmol/kg/h;   // the stored string
            E1       240100    J/mol;
            A_KCO    8.23e-5   -;
            dH_CO    -70650    J/mol;
            A_KH2    6.12e-9   -;
            dH_H2    -82900    J/mol;
            A_KCH4   6.65e-4   -;
            dH_CH4   -38280    J/mol;
            A_KH2O   1.77e5    -;
            dH_H2O   88680     J/mol;
            R_S      [1 2 -2 -1 -1] 8.314;  // J/(mol K), as the string writes it
            a1       30.42     -;           // K1 = exp(a1 - b1/T), atm^2
            b1       27106     K;
            atm      1         atm;
        }

        definitions
        {
            pCH4   "p[CH4] / atm";
            pH2O   "p[water] / atm";
            pCO    "p[CO] / atm";
            pH2    "p[H2] / atm";
            k1     "A_k1 * exp(-E1 / (R_S * T))";
            KCO    "A_KCO * exp(-dH_CO / (R_S * T))";
            KH2    "A_KH2 * exp(-dH_H2 / (R_S * T))";
            KCH4   "A_KCH4 * exp(-dH_CH4 / (R_S * T))";
            KH2O   "A_KH2O * exp(-dH_H2O / (R_S * T))";
            DEN    "1 + KCO * pCO + KCH4 * pCH4 + KH2O * pH2O / pH2 + KH2 * pH2";
            K1     "exp(a1 - b1 / T)";
        }

        rate  "k1 / pH2^2.5 * (pCH4 * pH2O - pH2^3 * pCO / K1) / DEN^2";

        rateConstant { name k1;  unit kmol/kg/h; }
    }
}

waterGasShift       // reaction II, the sample's "Water Gas Shift"
{
    stoichiometry
    (
        { component CO;     nu -1; }
        { component water;  nu -1; }
        { component CO2;    nu  1; }
        { component H2;     nu  1; }
    );

    kinetics
    {
        type     expression;
        source   "the reference sample's stored rate expression for 'Water Gas Shift': atm, its rounded A, its own K2 correlation, and its denominator WITHOUT the K_CH4 p_CH4 term";
        basis    catalystMass;
        rateOf   extent;

        parameters
        {
            A_k2     1.96e6    kmol/kg/h;
            E2       67130     J/mol;
            A_KCO    8.23e-5   -;
            dH_CO    -70650    J/mol;
            A_KH2    6.12e-9   -;
            dH_H2    -82900    J/mol;
            A_KH2O   1.77e5    -;
            dH_H2O   88680     J/mol;
            R_S      [1 2 -2 -1 -1] 8.314;
            a2       -3.798    -;           // K2 = exp(a2 + b2/T)
            b2       4160      K;
            atm      1         atm;
        }

        definitions
        {
            pH2O   "p[water] / atm";
            pCO    "p[CO] / atm";
            pCO2   "p[CO2] / atm";
            pH2    "p[H2] / atm";
            k2     "A_k2 * exp(-E2 / (R_S * T))";
            KCO    "A_KCO * exp(-dH_CO / (R_S * T))";
            KH2    "A_KH2 * exp(-dH_H2 / (R_S * T))";
            KH2O   "A_KH2O * exp(-dH_H2O / (R_S * T))";
            DEN    "1 + KH2O * pH2O / pH2 + KH2 * pH2 + KCO * pCO";
            K2     "exp(a2 + b2 / T)";
        }

        rate  "k2 / pH2 * (pH2O * pCO - pH2 * pCO2 / K2) / DEN^2";

        rateConstant { name k2;  unit kmol/kg/h; }
    }
}

overallReforming    // reaction III, the sample's "Overall Reaction"
{
    stoichiometry
    (
        { component CH4;    nu -1; }
        { component water;  nu -2; }
        { component CO2;    nu  1; }
        { component H2;     nu  4; }
    );

    kinetics
    {
        type     expression;
        source   "the reference sample's stored rate expression for 'Overall Reaction': atm, its rounded A, its own K3 correlation, and its denominator WITHOUT the K_CO p_CO term";
        basis    catalystMass;
        rateOf   extent;

        parameters
        {
            A_k3     1.02e15   kmol/kg/h;
            E3       243900    J/mol;
            A_KH2    6.12e-9   -;
            dH_H2    -82900    J/mol;
            A_KCH4   6.65e-4   -;
            dH_CH4   -38280    J/mol;
            A_KH2O   1.77e5    -;
            dH_H2O   88680     J/mol;
            R_S      [1 2 -2 -1 -1] 8.314;
            a3       34.218    -;           // K3 = exp(a3 - b3/T), atm^2
            b3       31266     K;
            atm      1         atm;
        }

        definitions
        {
            pCH4   "p[CH4] / atm";
            pH2O   "p[water] / atm";
            pCO2   "p[CO2] / atm";
            pH2    "p[H2] / atm";
            k3     "A_k3 * exp(-E3 / (R_S * T))";
            KH2    "A_KH2 * exp(-dH_H2 / (R_S * T))";
            KCH4   "A_KCH4 * exp(-dH_CH4 / (R_S * T))";
            KH2O   "A_KH2O * exp(-dH_H2O / (R_S * T))";
            DEN    "1 + KCH4 * pCH4 + KH2O * pH2O / pH2 + KH2 * pH2";
            K3     "exp(a3 - b3 / T)";
        }

        rate  "k3 / pH2^3.5 * (pCH4 * pH2O^2 - pH2^4 * pCO2 / K3) / DEN^2";

        rateConstant { name k3;  unit kmol/kg/h; }
    }
}
