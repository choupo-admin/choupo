/*---------------------------------------------------------------------------*\
  The same components as the case, phi-phi PR78 with NO kij declared: this
  system exists so `ppr78Kij` can run before the sets it writes exist (the
  op reads Tc, Pc, omega through the package; the kij = 0 announcement this
  system raises is about THIS folder's package, which solves nothing).
\*---------------------------------------------------------------------------*/

recordType    thermophysicalPropertySystem;
schemaVersion 2;

components ( N2 CO2 H2S CH4 ethane propane isoButane nButane
             isopentane nPentane nHexane nHeptane nOctane nNonane nDecane );

equilibrium
{
    formulation phiPhi;
    equationOfState { model PengRobinson;  mixingRule vanDerWaalsOneFluid; }
    liquid { fugacityRoute equationOfState; root liquid; }
    vapour { fugacityRoute equationOfState; root vapour; }
}

caloric
{
    energyBasis elementsDatum;
    liquid { departureRoute equilibriumEquationOfState; root liquid; }
    vapour { departureRoute equilibriumEquationOfState; root vapour; }
}
